+	"brand:status", "brand:set",
+	// NearToken 页面插件（@fish-under-sea/magpie-neartoken）：设备授权、
+	// 钱包、用量、充值。同样必须列在这里——只在 package.json 里写
+	// magpie.calls 的话，callsKeeping 会把这些名字丢干净，页面只会看到
+	//「NearToken doesn't ask for neartoken:state」。
+	"neartoken:state", "neartoken:connect", "neartoken:cancel", "neartoken:open",
+	"neartoken:disconnect", "neartoken:refresh", "neartoken:usage", "neartoken:topup",
+	// FISH Dock 的插件页在 sandbox="allow-scripts" 的帧里（没有 allow-popups、
