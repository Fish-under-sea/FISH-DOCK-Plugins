+package gui
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// pack 搭一个最小的插件目录：package.json 里写 magpie.icon，按需放一张图。
+func pack(t *testing.T, icon string, files map[string][]byte) string {
+	t.Helper()
+	dir := t.TempDir()
+	body := `{"name":"page-checkin","magpie":{"icon":` + quote(icon) + `}}`
+	if err := os.WriteFile(filepath.Join(dir, "package.json"), []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for name, b := range files {
+		p := filepath.Join(dir, filepath.FromSlash(name))
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, b, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+func quote(s string) string {
+	out := strings.ReplaceAll(s, `\`, `\\`)
+	out = strings.ReplaceAll(out, `"`, `\"`)
+	return `"` + out + `"`
+}
+
+// 包内的图（magpie.icon: "page/icon.png"）plugin.InstalledIcon 不认，
+// 列表里就退回书页图标——这里把它读出来存成一张普通图标，颜色照原样。
+func TestLocalIconReadsAPictureInsideThePackage(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(home, ".cache"))
+	t.Cleanup(func() { _ = provider.SetBrand(false) })
+
+	png := []byte("\x89PNG\r\n\x1a\n\x00\x00\x00\rIHDR")
+	dir := pack(t, "page/icon.png", map[string][]byte{"page/icon.png": png})
+
+	ic := LocalIcon(dir)
+	if !strings.HasPrefix(ic, "file:") {
+		t.Fatalf("LocalIcon = %q，应当是 file: 图标", ic)
+	}
+	name := strings.TrimPrefix(ic, "file:")
+	got, err := os.ReadFile(provider.IconFile(name))
+	if err != nil {
+		t.Fatalf("存下来的图读不出来：%v", err)
+	}
+	if string(got) != string(png) {
+		t.Error("存下来的不是那张图")
+	}
+	// 文件没变就不再读一遍
+	if again := LocalIcon(dir); again != ic {
+		t.Errorf("第二次 = %q，第一次 = %q", again, ic)
+	}
+}
+
+// 只收包内的相对路径：越界的不读，https 与 data: 交给 InstalledIcon。
+func TestLocalIconRefusesWhatIsNotAFIleInsideIt(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	t.Cleanup(func() { _ = provider.SetBrand(false) })
+
+	png := []byte("\x89PNG\r\n\x1a\n\x00\x00\x00\rIHDR")
+	for _, icon := range []string{
+		"../escape.png",
+		"page/../../escape.png",
+		"/etc/passwd",
+		"https://example.com/icon.png",
+		"data:image/png;base64,AAAA",
+		"",
+	} {
+		dir := pack(t, icon, map[string][]byte{"page/icon.png": png})
+		if ic := LocalIcon(dir); ic != "" {
+			t.Errorf("magpie.icon = %q 拿到了 %q", icon, ic)
+		}
+	}
+	// 写的是包内的名字，但文件不在
+	if ic := LocalIcon(pack(t, "page/none.png", nil)); ic != "" {
+		t.Errorf("文件不存在却拿到了 %q", ic)
+	}
+}
