diff --git a/internal/gui/plugin_icon_local.go b/internal/gui/plugin_icon_local.go
new file mode 100644
index 00000000..21ebfdfa
--- /dev/null
+++ b/internal/gui/plugin_icon_local.go
@@ -0,0 +1,93 @@
+package gui
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// 插件自己的图写成包内的相对路径时（package.json 的 magpie.icon:
+// "page/icon.png"），plugin.InstalledIcon 是不认的——它只收 https 与 data:
+// 这两种页面自己加载得了的形式。窗口这边能直接读文件，所以在这里补上：
+// 按内容存成一张普通图标（file:<name>），列表里画出来就是原色。
+//
+// 这样既不必动 upstream 那个判断，也不用把一百多 KB 的 base64 写进
+// package.json。顺序是：品牌图标 > 包内文件 > 包给的 https/data 图 >
+// 前端按 kind 画的那个兜底图标。
+
+// localIcons 记住「文件没变就不用再读一遍」，key 是插件 spec。
+var localIcons struct {
+	sync.Mutex
+	kept map[string]localIcon
+}
+
+type localIcon struct {
+	at   int64 // 文件的修改时间
+	size int64
+	icon string
+}
+
+// LocalIcon 是插件 spec 的 magpie.icon 指向包内某个文件时的图标值，"" 表示
+// 它写的不是包内文件（https、data: 或者空的），或者那个文件读不出来。
+func LocalIcon(spec string) string {
+	root := plugin.Target(spec)
+	name := packageIconField(root)
+	if name == "" {
+		return ""
+	}
+	rel := filepath.Clean(filepath.FromSlash(name))
+	if rel == "." || filepath.IsAbs(rel) || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return ""
+	}
+	file := filepath.Join(root, rel)
+	st, err := os.Stat(file)
+	if err != nil || !st.Mode().IsRegular() {
+		return ""
+	}
+	localIcons.Lock()
+	defer localIcons.Unlock()
+	if got, ok := localIcons.kept[spec]; ok && got.at == st.ModTime().UnixNano() && got.size == st.Size() {
+		return got.icon
+	}
+	b, err := os.ReadFile(file)
+	if err != nil {
+		return ""
+	}
+	ic, err := provider.StoreIcon(b)
+	if err != nil {
+		return ""
+	}
+	if localIcons.kept == nil {
+		localIcons.kept = map[string]localIcon{}
+	}
+	localIcons.kept[spec] = localIcon{at: st.ModTime().UnixNano(), size: st.Size(), icon: ic}
+	return ic
+}
+
+// packageIconField 是 package.json 里 magpie.icon 的原值，只留包内的相对
+// 路径：https 与 data: 交给 plugin.InstalledIcon，这里不重复处理。
+func packageIconField(root string) string {
+	b, err := os.ReadFile(filepath.Join(root, "package.json"))
+	if err != nil {
+		return ""
+	}
+	var p struct {
+		Magpie struct {
+			Icon string `json:"icon"`
+		} `json:"magpie"`
+	}
+	if json.Unmarshal(b, &p) != nil {
+		return ""
+	}
+	said := strings.TrimSpace(p.Magpie.Icon)
+	l := strings.ToLower(said)
+	if said == "" || strings.HasPrefix(l, "https://") || strings.HasPrefix(l, "data:") {
+		return ""
+	}
+	return said
+}
