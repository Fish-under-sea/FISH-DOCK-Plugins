diff --git a/internal/catalog/chat_test.go b/internal/catalog/chat_test.go
new file mode 100644
index 00000000..6ee14c91
--- /dev/null
+++ b/internal/catalog/chat_test.go
@@ -0,0 +1,18 @@
+package catalog
+
+import "testing"
+
+// #24：图像 / 视频 / 语音 / 向量都不算「拿来聊天的」，Chat 只留对话模型。
+func TestChatKeepsOnlyModelsToTalkTo(t *testing.T) {
+	ms := []Model{
+		{ID: "gpt-6"},
+		{ID: "gpt-image-2", Draws: true},
+		{ID: "veo-3.1", Films: true},
+		{ID: "suno_sound", Audio: true},
+		{ID: "text-embedding-3-large", Embedding: true},
+	}
+	got := Chat(ms)
+	if len(got) != 1 || got[0].ID != "gpt-6" {
+		t.Fatalf("Chat = %+v, want only gpt-6", got)
+	}
+}
