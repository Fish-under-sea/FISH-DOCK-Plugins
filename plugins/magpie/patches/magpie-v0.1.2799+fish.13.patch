+// callName is what a call's name is: namespace:verb, lower-case.
+var callName = regexp.MustCompile(`^[a-z][a-z0-9]*:[a-z][a-z0-9-]*$`)
+
+// callsKeeping keeps the calls a page may ask for: only names magpie has
+// (PageCalls), each once, in the order asked, at most maxCalls. Anything
+// else is dropped rather than refused: a package written for a newer
+// magpie still runs here with the calls this one has.
+func callsKeeping(asked []string) []string {
+	var out []string
