diff --git a/internal/neartoken/catalog.go b/internal/neartoken/catalog.go
new file mode 100644
index 00000000..e5df8c3a
--- /dev/null
+++ b/internal/neartoken/catalog.go
@@ -0,0 +1,145 @@
+package neartoken
+
+import (
+	"context"
+	"encoding/json"
+	"slices"
+	"sort"
+	"strings"
+)
+
+// Catalog 是站点目录里 magpie 能用的那部分：可聊的模型、它们所在的分组，
+// 以及分组到路由 ref 的映射（#<id>，跨分组路由要用）。
+type Catalog struct {
+	// Models 是可聊的模型名，站点顺序，去重。
+	Models []string `json:"models"`
+	// Groups 是这些模型出现在过的分组名，站点顺序，去重。
+	Groups []string `json:"groups"`
+	// Refs 是分组名到 #<id> 的映射；没有 ref 的分组不在里面。
+	Refs map[string]string `json:"refs"`
+	// GroupList 是页面画「分组墙」要的那一份：站点原文组名、倍率、这一组的模型数、ref。
+	// 组名照抄 enable_groups 原文（含 emoji 与备注），不翻译也不改写。
+	GroupList []GroupInfo `json:"groupList"`
+}
+
+// GroupInfo 是分组墙上的一格。ratio 没给就不写（0 与缺省在页面看来都是「没有倍率」）。
+type GroupInfo struct {
+	Name   string  `json:"name"`
+	Ratio  float64 `json:"ratio,omitempty"`
+	Models int     `json:"models"`
+	Ref    string  `json:"ref,omitempty"`
+}
+
+// 站点把生图、语音、向量、视频也挂在 openai / gemini 这个 surface 下，
+// 所以端点类型分不出"能聊的"和"共用该 surface 的媒体模型"；名字约定是
+// 目前唯一可用的判据，也是 dsh-neartoken 一直在用的那条。
+var mediaHints = []string{
+	"image", "tts", "transcribe", "asr", "embedding", "lyria",
+	"midjourney", "nano-banana", "veo", "imagen", "dall-e", "sd",
+}
+
+// chatEndpoints 是能聊的端点类型。
+var chatEndpoints = []string{"openai", "openai-response", "anthropic", "gemini"}
+
+// chattable 说这个模型能不能拿来聊天。
+func chattable(name string, endpoints []string) bool {
+	lower := strings.ToLower(name)
+	if strings.HasSuffix(lower, "-c") {
+		return false
+	}
+	for _, hint := range mediaHints {
+		if strings.Contains(lower, hint) {
+			return false
+		}
+	}
+	if len(endpoints) == 0 {
+		// 站点没声明时按名字放行：宁可多列一个，也不能让整份目录消失。
+		return true
+	}
+	for _, e := range endpoints {
+		if slices.Contains(chatEndpoints, e) {
+			return true
+		}
+	}
+	return false
+}
+
+// readCatalog 读站点的模型目录。
+func (c *client) readCatalog(ctx context.Context) (*Catalog, *Error) {
+	env, err := c.call(ctx, "GET", pricingPath, nil, "")
+	if err != nil {
+		return nil, err
+	}
+	if !env.ok() {
+		return nil, env.refused("读取模型目录")
+	}
+	// /api/pricing 的 data 是一个数组，不是对象，所以这里自己解
+	var data []struct {
+		Name      string   `json:"model_name"`
+		Groups    []string `json:"enable_groups"`
+		Endpoints []string `json:"supported_endpoint_types"`
+	}
+	if err := json.Unmarshal(env.Data, &data); err != nil {
+		return nil, fail(CodeInvalidAnswer, "站点应答的 data 解不开：%v", err)
+	}
+	out := &Catalog{Models: []string{}, Groups: []string{}, Refs: map[string]string{}, GroupList: []GroupInfo{}}
+	seenModel := map[string]bool{}
+	seenGroup := map[string]bool{}
+	// 分组墙上「这一组有几个模型」：一个模型出现在多个组里就各算一次，与站点
+	// 自己的列表一致（它也是按组列模型）。
+	perGroup := map[string]map[string]bool{}
+	for _, m := range data {
+		name := strings.TrimSpace(m.Name)
+		if name == "" || !chattable(name, m.Endpoints) {
+			continue
+		}
+		if !seenModel[name] {
+			seenModel[name] = true
+			out.Models = append(out.Models, name)
+		}
+		for _, g := range m.Groups {
+			g = strings.TrimSpace(g)
+			if g == "" {
+				continue
+			}
+			if !seenGroup[g] {
+				seenGroup[g] = true
+				out.Groups = append(out.Groups, g)
+			}
+			if perGroup[g] == nil {
+				perGroup[g] = map[string]bool{}
+			}
+			perGroup[g][name] = true
+		}
+	}
+	for name, ref := range env.GroupRefs {
+		if strings.HasPrefix(ref, "#") {
+			out.Refs[name] = ref
+		}
+	}
+	out.Refs = sortedRefs(out.Refs)
+	// 分组墙按分组首次出现的顺序排：页面要的是站点的原样，不是按倍率或数量重排。
+	for _, g := range out.Groups {
+		out.GroupList = append(out.GroupList, GroupInfo{
+			Name:   g,
+			Ratio:  env.GroupRatio[g],
+			Models: len(perGroup[g]),
+			Ref:    out.Refs[g],
+		})
+	}
+	return out, nil
+}
+
+// sortedRefs 让 map 的顺序稳定：JSON 不保证，但测试与日志会看。
+func sortedRefs(refs map[string]string) map[string]string {
+	keys := make([]string, 0, len(refs))
+	for k := range refs {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	out := make(map[string]string, len(keys))
+	for _, k := range keys {
+		out[k] = refs[k]
+	}
+	return out
+}
diff --git a/internal/neartoken/device.go b/internal/neartoken/device.go
new file mode 100644
index 00000000..8d9c9277
--- /dev/null
+++ b/internal/neartoken/device.go
@@ -0,0 +1,162 @@
+package neartoken
+
+import (
+	"context"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// 站点的设备授权端点（RFC 8628 形状，字段名已冻结）。
+const (
+	authorizePath = "/api/dsh/device/authorize"
+	tokenPath     = "/api/dsh/device/token"
+	revokePath    = "/api/dsh/device/revoke"
+)
+
+// Authorization 是一次进行中的授权。DeviceCode 从不给页面看。
+type Authorization struct {
+	DeviceCode              string
+	UserCode                string
+	VerificationURI         string
+	VerificationURIComplete string
+	ExpiresAt               time.Time
+	Interval                time.Duration
+}
+
+// PollOutcome 是一次轮询的结果；除了 Unknown，其余都不是错误。
+type PollOutcome int
+
+const (
+	PollPending PollOutcome = iota
+	PollSlowDown
+	PollDenied
+	PollExpired
+	PollGranted
+)
+
+// Grant 是站点签下来的密钥与它给的身份。
+type Grant struct {
+	AccessToken string
+	TokenName   string
+	User        map[string]any
+}
+
+// affiliateCode 只接受 [A-Za-z0-9_-]{1,64}；别的整条丢掉，连接照常发起。
+var affiliateCode = regexp.MustCompile(`^[A-Za-z0-9_-]{1,64}$`)
+
+// withAffiliate 把邀请码拼到确认页地址上（站点前端会把它存进 localStorage）。
+func withAffiliate(raw, code string) string {
+	code = strings.TrimSpace(code)
+	if !affiliateCode.MatchString(code) {
+		return raw
+	}
+	u, err := url.Parse(raw)
+	if err != nil {
+		return raw
+	}
+	q := u.Query()
+	q.Set("aff", code)
+	u.RawQuery = q.Encode()
+	return u.String()
+}
+
+// authorize 向站点要一个新的授权码。
+//
+// 请求体除 client_name 外还带 token_name：站点按它命名时，令牌就是 Magpie；
+// 站点忽略它也没有副作用——令牌名最终以站点回的 token_name 为准。
+func (c *client) authorize(ctx context.Context, clientName, aff string) (*Authorization, *Error) {
+	body := map[string]any{"client_name": clientName, "token_name": TokenName}
+	env, err := c.call(ctx, "POST", authorizePath, body, "")
+	if err != nil {
+		return nil, err
+	}
+	if !env.ok() {
+		return nil, env.refused("发起设备授权")
+	}
+	var data struct {
+		DeviceCode              string `json:"device_code"`
+		UserCode                string `json:"user_code"`
+		VerificationURI         string `json:"verification_uri"`
+		VerificationURIComplete string `json:"verification_uri_complete"`
+		ExpiresIn               int    `json:"expires_in"`
+		Interval                int    `json:"interval"`
+	}
+	if err := env.decode(&data); err != nil {
+		return nil, err
+	}
+	if data.DeviceCode == "" || data.UserCode == "" || data.VerificationURI == "" {
+		return nil, fail(CodeInvalidAnswer, "设备授权应答缺少 device_code / user_code / verification_uri")
+	}
+	if data.ExpiresIn <= 0 {
+		data.ExpiresIn = 600
+	}
+	if data.Interval <= 0 {
+		data.Interval = 5
+	}
+	complete := data.VerificationURIComplete
+	if complete == "" {
+		complete = data.VerificationURI
+	}
+	// 两个地址都带邀请码：卡片打开的是完整的那个，复制走的也不该丢邀请人。
+	return &Authorization{
+		DeviceCode:              data.DeviceCode,
+		UserCode:                data.UserCode,
+		VerificationURI:         withAffiliate(data.VerificationURI, aff),
+		VerificationURIComplete: withAffiliate(complete, aff),
+		ExpiresAt:               time.Now().Add(time.Duration(data.ExpiresIn) * time.Second),
+		Interval:                time.Duration(data.Interval) * time.Second,
+	}, nil
+}
+
+// poll 问站点人决定了没有。非授权的四种状态按站点给的字符串判定，不看状态码。
+func (c *client) poll(ctx context.Context, deviceCode string) (PollOutcome, *Grant, *Error) {
+	env, err := c.call(ctx, "POST", tokenPath, map[string]any{"device_code": deviceCode}, "")
+	if err != nil {
+		return 0, nil, err
+	}
+	if env.ok() {
+		var data struct {
+			AccessToken string         `json:"access_token"`
+			TokenName   string         `json:"token_name"`
+			User        map[string]any `json:"user"`
+		}
+		if derr := env.decode(&data); derr != nil {
+			return 0, nil, derr
+		}
+		if data.AccessToken == "" {
+			return 0, nil, fail(CodeInvalidAnswer, "设备授权应答缺少 access_token")
+		}
+		if data.TokenName == "" {
+			data.TokenName = TokenName
+		}
+		return PollGranted, &Grant{AccessToken: data.AccessToken, TokenName: data.TokenName, User: data.User}, nil
+	}
+	switch env.said() {
+	case "authorization_pending":
+		return PollPending, nil, nil
+	case "slow_down":
+		return PollSlowDown, nil, nil
+	case "access_denied":
+		return PollDenied, nil, nil
+	case "expired_token":
+		return PollExpired, nil, nil
+	}
+	if said := env.said(); said != "" {
+		return 0, nil, fail(CodeRefused, "设备授权轮询返回了未知状态：%s", said)
+	}
+	return 0, nil, fail(CodeRefused, "设备授权轮询被站点拒绝了")
+}
+
+// revoke 撤销一把插件签下的密钥；站点幂等，已经不存在也算成功。
+func (c *client) revoke(ctx context.Context, key string) *Error {
+	env, err := c.call(ctx, "POST", revokePath, nil, key)
+	if err != nil {
+		return err
+	}
+	if !env.ok() {
+		return env.refused("撤销令牌")
+	}
+	return nil
+}
diff --git a/internal/neartoken/handoff.go b/internal/neartoken/handoff.go
new file mode 100644
index 00000000..e196175f
--- /dev/null
+++ b/internal/neartoken/handoff.go
@@ -0,0 +1,174 @@
+package neartoken
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/yetone/magpie/internal/catalog"
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// 插件从 0.1.7 起自己就是 magpie 的 provider 插件：设备授权（auth.methods）、
+// 模型表（provider.models，按分组 × 模型展开、带倍率、生图视频标好）、余额
+// （auth.usage）与图标（auth.icon）都由它给。宿主侧那份 key+URL 供应商还挂在
+// 同一个 id 上，就成了「盖住插件的那一条」：模型表是旧的、供应商卡是灰立方体、
+// 点「重新获取模型」还会去问站点 /v1/models（那个端点按令牌分组过滤，很多账号
+// 回空）。所以插件在场时，宿主让出供应商（issue #22）：
+//
+//   - 不再 provider.Save 一条 key+URL 供应商，也不再 catalog.SaveLive 写模型表；
+//   - 页面那八条 neartoken:* 从插件自己的 auth 里读令牌；
+//   - 断开时撤令牌 + 删插件凭据，宿主侧那条（老版本留下的）一并删掉。
+//
+// 插件不在场时（老版本页面插件、或者只装了页面那半边）保留原来的做法：一条
+// key+URL 供应商，页面照旧能用。
+
+// pluginOwnsProvider 说装着的插件里有没有一条 provider id 就是 neartoken。
+//
+// 一个包可以登记好几家（trae-cn 与 trae-global），这里只认同名的那一条。
+// Listed 读的是上一次列出来的那份（plugin-providers.json），不为这一问去起
+// 插件 host；还没列过时退回 Cached，它同样不启动 host。
+func pluginOwnsProvider() bool {
+	if ps, ok := plugin.Listed(); ok {
+		for _, p := range ps {
+			if p.ID == ProviderID {
+				return true
+			}
+		}
+	}
+	for _, p := range plugin.Cached() {
+		if p.ID == ProviderID {
+			return true
+		}
+	}
+	return false
+}
+
+// pluginAuth 是插件自己记着的那把钥匙：oauth 型写 access，apiKey 型写 key。
+// refresh 不是拿来做 Bearer 的，不认它。
+func pluginAuth() (string, bool) {
+	for _, a := range plugin.Auths(ProviderID) {
+		for _, field := range []string{"access", "key"} {
+			if s, ok := a[field].(string); ok && strings.TrimSpace(s) != "" {
+				return strings.TrimSpace(s), true
+			}
+		}
+	}
+	return "", false
+}
+
+// savePluginAuth 与 forgetPluginAuth 是写、删插件凭据的两个出口：真实现要
+// 起插件 host，测试把它们换掉。
+var (
+	savePluginAuth = func(ctx context.Context, auth map[string]any) error {
+		_, err := plugin.Import(ctx, ProviderID, auth)
+		return err
+	}
+	forgetPluginAuth = func(ctx context.Context) error {
+		return plugin.SignOut(ctx, ProviderID, "")
+	}
+)
+
+// keepWithPlugin 把授权拿到的钥匙存进插件自己的 auth：插件读它给 magpie 出
+// 请求，页面那八条也从这里读。形状照插件自己的 auth.methods 回的那份写，
+// 令牌名一起存——页面「令牌名」那一栏就是从这里读的。
+func keepWithPlugin(ctx context.Context, token, tokenName string) error {
+	auth := map[string]any{"type": "oauth", "access": token, "refresh": token}
+	if name := strings.TrimSpace(tokenName); name != "" {
+		auth["tokenName"] = name
+	}
+	return savePluginAuth(ctx, auth)
+}
+
+// pluginTokenName 是插件凭据里记着的令牌名（站点给这把钥匙起的名字）。
+// 页面通过 neartoken:state 的 tokenName 显示它；没有就是空串，别编一个。
+func pluginTokenName() string {
+	for _, a := range plugin.Auths(ProviderID) {
+		for _, field := range []string{"tokenName", "token_name"} {
+			if s, ok := a[field].(string); ok && strings.TrimSpace(s) != "" {
+				return strings.TrimSpace(s)
+			}
+		}
+	}
+	return ""
+}
+
+// keepGrant 把刚拿到的钥匙放到它该在的地方：插件提供同 id 供应商时交给插件
+// 的 auth，否则仍旧挂宿主侧那条 key+URL 供应商。
+func (m *Manager) keepGrant(ctx context.Context, baseURL string, grant *Grant, cat *Catalog) error {
+	if pluginOwnsProvider() {
+		if err := keepWithPlugin(ctx, grant.AccessToken, grant.TokenName); err != nil {
+			return fmt.Errorf("没能存进 NearToken 插件的登录凭据：%v", err)
+		}
+		m.dropHostProvider()
+		return nil
+	}
+	if err := attach(baseURL, grant.AccessToken, cat); err != nil {
+		return fmt.Errorf("没能挂上 magpie 的供应商：%v", err)
+	}
+	m.saveCatalog(ctx, baseURL, cat)
+	return nil
+}
+
+// dropHostProvider 删掉宿主侧那条 key+URL 供应商，连同它写下的模型表。
+// 删不动只记录：插件那条已经在页面上，用户至少能用了。
+func (m *Manager) dropHostProvider() {
+	if p, err := provider.Find(ProviderID); err != nil || p == nil {
+		return
+	}
+	if err := provider.Delete(ProviderID); err != nil {
+		m.logf("removing the host's provider entry: %v", err)
+		return
+	}
+	if err := catalog.SaveLive(ProviderID, "", nil); err != nil {
+		m.logf("forgetting the site's models: %v", err)
+	}
+}
+
+// handOver 是插件接手那一刻的一次性迁移：宿主侧那条的钥匙先搬进插件 auth，
+// 搬成功才删那一条。搬不动（插件 host 起不来）就留在原地——用户的钥匙还在，
+// 页面照样读得到，下一次 state 再试。
+func (m *Manager) handOver() {
+	p, err := provider.Find(ProviderID)
+	if err != nil || p == nil {
+		return
+	}
+	if key := strings.TrimSpace(p.Key); key != "" {
+		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+		defer cancel()
+		if err := keepWithPlugin(ctx, key, ""); err != nil {
+			m.logf("handing the key over to the plugin: %v", err)
+			return
+		}
+	}
+	m.dropHostProvider()
+}
+
+// settle 在插件接手后把宿主侧那条清掉。只在真有那么一条时才做事，所以页面
+// 每次读状态都可以顺手叫一次。迁移跑在后台：起插件 host 可能要几秒，别让
+// 一次 state 等它。
+func (m *Manager) settle() {
+	if !pluginOwnsProvider() {
+		return
+	}
+	if p, err := provider.Find(ProviderID); err != nil || p == nil {
+		return
+	}
+	m.mu.Lock()
+	busy := m.handingOver
+	m.handingOver = true
+	m.mu.Unlock()
+	if busy {
+		return
+	}
+	go func() {
+		defer func() {
+			m.mu.Lock()
+			m.handingOver = false
+			m.mu.Unlock()
+		}()
+		m.handOver()
+	}()
+}
diff --git a/internal/neartoken/handoff_test.go b/internal/neartoken/handoff_test.go
new file mode 100644
index 00000000..2ae611be
--- /dev/null
+++ b/internal/neartoken/handoff_test.go
@@ -0,0 +1,174 @@
+package neartoken
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// withPluginProvider 装作装了一个把 provider id 写成 neartoken 的插件：
+// 列表落在 plugin-providers.json（plugin.Listed 读的就是它）。用例结束时写回
+// 一个空列表，而不是删掉文件——同一个包里别的用例看到它就会以为用户装了插件。
+func withPluginProvider(t *testing.T) {
+	t.Helper()
+	writeSettings(t, "plugin-providers.json", []map[string]any{{
+		"id":   ProviderID,
+		"spec": "@fish-under-sea/magpie-neartoken",
+		"name": "NearToken",
+	}}, []map[string]any{})
+}
+
+// withPluginAuth 写插件自己的凭据，形状照 auth.methods 回的那份。
+func withPluginAuth(t *testing.T, access string) {
+	t.Helper()
+	writeSettings(t, "plugin-auth.json", map[string]any{
+		ProviderID: map[string]any{"type": "oauth", "access": access, "refresh": access},
+	}, map[string]any{})
+}
+
+// writeSettings 写一份 magpie 的数据文件，用例结束时换回 after。
+func writeSettings(t *testing.T, name string, v, after any) {
+	t.Helper()
+	path := filepath.Join(settings.Dir(), name)
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	put := func(v any) {
+		b, err := json.MarshalIndent(v, "", "  ")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, append(b, '\n'), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	put(v)
+	t.Cleanup(func() { put(after) })
+}
+
+// dropHostEntry 清掉宿主侧那条，别把一条供应商留给同一包里的下一条用例。
+func dropHostEntry(t *testing.T) {
+	t.Helper()
+	t.Cleanup(func() { _ = provider.Delete(ProviderID) })
+}
+
+// stubPluginAuth 换掉写、删插件凭据的两个出口：真实现要起插件 host，测试不碰它。
+func stubPluginAuth(t *testing.T) (saved *map[string]any, forgot *int) {
+	t.Helper()
+	saved, forgot = new(map[string]any), new(int)
+	restoreSave, restoreForget := savePluginAuth, forgetPluginAuth
+	savePluginAuth = func(_ context.Context, auth map[string]any) error {
+		*saved = auth
+		return nil
+	}
+	forgetPluginAuth = func(context.Context) error {
+		*forgot++
+		return nil
+	}
+	t.Cleanup(func() { savePluginAuth, forgetPluginAuth = restoreSave, restoreForget })
+	return saved, forgot
+}
+
+func TestPluginProviderOwnsTheKey(t *testing.T) {
+	withPluginProvider(t)
+	withPluginAuth(t, "sk-plugin")
+	dropHostEntry(t)
+
+	if key, ok := storedKey(); !ok || key != "sk-plugin" {
+		t.Fatalf("storedKey = %q, %v; want the plugin's sk-plugin", key, ok)
+	}
+}
+
+// 老用户升级上来：providers.json 里还有一条宿主建的，钥匙得先认，页面才不会
+// 一下子显示成未连接；插件接手之后那条该消失。
+func TestHandOverMovesTheOldKeyToThePlugin(t *testing.T) {
+	withPluginProvider(t)
+	dropHostEntry(t)
+	if err := attach(DefaultBaseURL, "sk-old", nil); err != nil {
+		t.Fatalf("attach: %v", err)
+	}
+	saved, _ := stubPluginAuth(t)
+
+	// 迁移之前，页面靠 providers.json 里那一把还连着
+	if key, ok := storedKey(); !ok || key != "sk-old" {
+		t.Fatalf("storedKey before hand-over = %q, %v", key, ok)
+	}
+
+	New(t.TempDir()).handOver()
+
+	if (*saved)["access"] != "sk-old" {
+		t.Fatalf("the plugin was given %v; want the old key", *saved)
+	}
+	if p, _ := provider.Find(ProviderID); p != nil {
+		t.Fatalf("the host's provider entry is still there: %+v", p)
+	}
+}
+
+// 插件在场时，从页面连上的钥匙存进插件 auth，不再建宿主侧那条。
+func TestPluginOwnedGrantIsNotSavedAsAProvider(t *testing.T) {
+	withPluginProvider(t)
+	dropHostEntry(t)
+	saved, _ := stubPluginAuth(t)
+
+	m := New(t.TempDir())
+	grant := &Grant{AccessToken: "sk-new", TokenName: "Magpie"}
+	if err := m.keepGrant(context.Background(), DefaultBaseURL, grant, nil); err != nil {
+		t.Fatalf("keepGrant: %v", err)
+	}
+	if (*saved)["access"] != "sk-new" || (*saved)["type"] != "oauth" {
+		t.Fatalf("the plugin was given %v", *saved)
+	}
+	if p, _ := provider.Find(ProviderID); p != nil {
+		t.Fatalf("a key+URL provider was saved under a plugin's id: %+v", p)
+	}
+}
+
+// 插件不在场时保持老做法：一条 key+URL 供应商。
+func TestGrantWithoutAPluginStillSavesTheProvider(t *testing.T) {
+	dropHostEntry(t)
+	saved, _ := stubPluginAuth(t)
+
+	m := New(t.TempDir())
+	grant := &Grant{AccessToken: "sk-plain"}
+	if err := m.keepGrant(context.Background(), DefaultBaseURL, grant, nil); err != nil {
+		t.Fatalf("keepGrant: %v", err)
+	}
+	if *saved != nil {
+		t.Fatalf("a plugin that isn't there was given %v", *saved)
+	}
+	p, err := provider.Find(ProviderID)
+	if err != nil || p == nil || p.Key != "sk-plain" {
+		t.Fatalf("provider = %+v, %v", p, err)
+	}
+}
+
+// 断开时插件凭据与宿主侧那条都不留。
+func TestDisconnectForgetsThePluginAndTheProvider(t *testing.T) {
+	site := newFakeSite(t)
+	withPluginProvider(t)
+	dropHostEntry(t)
+	if err := attach(DefaultBaseURL, "sk-old", nil); err != nil {
+		t.Fatalf("attach: %v", err)
+	}
+	_, forgot := stubPluginAuth(t)
+
+	m := New(t.TempDir())
+	m.client = newClient(site.srv.URL)
+	if _, err := m.disconnect(context.Background()); err != nil {
+		t.Fatalf("disconnect: %v", err)
+	}
+	if *forgot != 1 {
+		t.Errorf("the plugin's sign-in was forgotten %d times, want 1", *forgot)
+	}
+	if p, _ := provider.Find(ProviderID); p != nil {
+		t.Fatalf("the host's provider entry survived a disconnect: %+v", p)
+	}
+	if site.revoked == nil || len(site.revoked) != 1 || site.revoked[0] != "sk-old" {
+		t.Errorf("revoked = %v, want the old key", site.revoked)
+	}
+}
diff --git a/internal/neartoken/manager.go b/internal/neartoken/manager.go
new file mode 100644
index 00000000..87260986
--- /dev/null
+++ b/internal/neartoken/manager.go
@@ -0,0 +1,515 @@
+package neartoken
+
+import (
+	"cmp"
+	"context"
+	"log"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/proc"
+)
+
+// walletTTL 是钱包数字在页面上算"新鲜"的时长：超过这个时间的一次 state 会
+// 顺手在后台重读，读回来之前页面看到的仍是上一份。
+const walletTTL = 5 * time.Minute
+
+// currencyTTL 是站点汇率在内存里复用的时长。
+const currencyTTL = 10 * time.Minute
+
+// Manager 是这只进程里唯一的一份 NearToken 状态：进行中的授权、钱包快照、
+// 站点汇率，以及页面能问的那些动作。
+type Manager struct {
+	mu         sync.Mutex
+	snap       snapshot
+	pending    *Authorization
+	polling    bool
+	cancel     context.CancelFunc
+	refreshing bool
+
+	path    string
+	baseURL string
+	client  *client
+	now     func() time.Time
+	// handingOver 说一次「把钥匙与供应商让给插件」的迁移正在跑。
+	handingOver bool
+}
+
+// New 造一只 Manager；dir 为空时用 magpie 的数据目录。
+func New(dir string) *Manager {
+	path := StatePath()
+	if strings.TrimSpace(dir) != "" {
+		path = filepath.Join(dir, "neartoken.json")
+	}
+	m := &Manager{path: path, baseURL: DefaultBaseURL, client: newClient(DefaultBaseURL)}
+	m.snap = loadSnapshot(path)
+	if m.snap.BaseURL != "" {
+		m.baseURL = m.snap.BaseURL
+		m.client = newClient(m.baseURL)
+	}
+	return m
+}
+
+// shared 是进程里的那一只，第一次用到时才建。
+var shared = sync.OnceValue(func() *Manager { return New("") })
+
+// Call 是页面请求的唯一入口：name 来自它 package.json 的 magpie.calls，
+// params 是页面给的。每个动作都回一份页面画得出来的数据。
+func Call(ctx context.Context, name string, params map[string]any) (any, error) {
+	return shared().call(ctx, name, params)
+}
+
+func (m *Manager) call(ctx context.Context, name string, params map[string]any) (any, error) {
+	switch name {
+	case "neartoken:state":
+		return m.state(ctx), nil
+	case "neartoken:connect":
+		return m.connect(params)
+	case "neartoken:cancel":
+		m.cancelPending()
+		return m.state(ctx), nil
+	case "neartoken:open":
+		return m.open()
+	case "neartoken:disconnect":
+		return m.disconnect(ctx)
+	case "neartoken:refresh":
+		return m.refresh(ctx)
+	case "neartoken:usage":
+		return m.usage(ctx, params)
+	case "neartoken:topup":
+		return m.topup(ctx, params)
+	}
+	return nil, fail(CodeBadParam, "没有这个调用：%s", name)
+}
+
+// View 是页面的状态：连接与否、账户、未完成的授权、汇率与目录规模。
+type View struct {
+	Configured bool     `json:"configured"`
+	BaseURL    string   `json:"baseURL"`
+	TokenName  string   `json:"tokenName,omitempty"`
+	Currency   Currency `json:"currency"`
+	Account    *Account `json:"account,omitempty"`
+	Pending    *pending `json:"pending,omitempty"`
+	Error      string   `json:"error,omitempty"`
+	Models     int      `json:"models"`
+	Groups     int      `json:"groups"`
+	// GroupList 是页面画「分组墙」的那一份：站点原文组名、倍率、这一组的模型数、ref。
+	// 永远是数组（没读过目录就是空数组），页面不必判空指针。
+	GroupList   []GroupInfo `json:"groupList"`
+	ProviderID  string      `json:"providerId"`
+	RefreshedAt int64       `json:"refreshedAt,omitempty"`
+}
+
+// state 组装一份状态；钱包过期时顺手在后台重读一次，本身不等。
+func (m *Manager) state(ctx context.Context) *View {
+	// 插件在场时把宿主侧那条老供应商让出去（一次性，跑在后台）
+	m.settle()
+
+	key, connected := storedKey()
+	_ = key
+
+	m.mu.Lock()
+	snap := m.snap
+	m.mu.Unlock()
+
+	view := &View{
+		Configured:  connected,
+		BaseURL:     m.baseURL,
+		TokenName:   cmp.Or(snap.TokenName, pluginTokenName()),
+		ProviderID:  ProviderID,
+		Account:     snap.Account,
+		Error:       snap.Error,
+		Models:      snap.Models,
+		Groups:      snap.Groups,
+		GroupList:   append([]GroupInfo{}, snap.GroupList...),
+		RefreshedAt: snap.WalletAt,
+	}
+	if snap.Currency != nil {
+		view.Currency = *snap.Currency
+	} else {
+		view.Currency = Currency{Name: "NearToken", PerUnit: 1, Rate: 1}
+	}
+	if p, ok := m.livePending(); ok {
+		view.Pending = p.pendingView()
+	}
+	if connected {
+		m.refreshWalletSoon()
+	}
+	return view
+}
+
+// livePending 是还在有效期内的那一次授权，过期的不再显示。
+func (m *Manager) livePending() (*Authorization, bool) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.pending == nil {
+		return nil, false
+	}
+	if m.clock().After(m.pending.ExpiresAt) {
+		return nil, false
+	}
+	return m.pending, true
+}
+
+// pendingView 是给页面看的那几个字段（device_code 除外）。
+func (a *Authorization) pendingView() *pending {
+	return &pending{
+		UserCode:                a.UserCode,
+		VerificationURI:         a.VerificationURI,
+		VerificationURIComplete: a.VerificationURIComplete,
+		ExpiresAt:               a.ExpiresAt.UnixMilli(),
+	}
+}
+
+// connect 发起一次授权；已经有一次在等就不重启它。
+func (m *Manager) connect(params map[string]any) (any, error) {
+	if _, ok := m.livePending(); ok {
+		return m.state(context.Background()), nil
+	}
+	aff, _ := params["affCode"].(string)
+	auth, err := m.client.authorize(context.Background(), ClientName, aff)
+	if err != nil {
+		return nil, err
+	}
+	m.mu.Lock()
+	m.pending = auth
+	m.snap.Pending = auth.pendingView()
+	m.snap.Error = ""
+	m.mu.Unlock()
+	m.save()
+	m.startPolling(auth)
+	return m.state(context.Background()), nil
+}
+
+// startPolling 在后台按站点给的间隔问结果；页面只读状态，不参与轮询。
+func (m *Manager) startPolling(auth *Authorization) {
+	m.mu.Lock()
+	if m.polling {
+		m.mu.Unlock()
+		return
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	m.cancel = cancel
+	m.polling = true
+	m.mu.Unlock()
+
+	go func() {
+		defer func() {
+			m.mu.Lock()
+			m.polling = false
+			m.cancel = nil
+			m.mu.Unlock()
+		}()
+		interval := auth.Interval
+		if interval <= 0 {
+			interval = 5 * time.Second
+		}
+		timer := time.NewTimer(interval)
+		defer timer.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-timer.C:
+			}
+			if m.clock().After(auth.ExpiresAt) {
+				m.finishAuth("授权已过期，请重新连接。")
+				return
+			}
+			outcome, grant, err := m.client.poll(ctx, auth.DeviceCode)
+			if err != nil {
+				if ctx.Err() != nil {
+					return
+				}
+				// 一次网络抖动不算失败：下一轮再问
+				timer.Reset(interval)
+				continue
+			}
+			switch outcome {
+			case PollGranted:
+				m.completeAuth(grant)
+				return
+			case PollDenied:
+				m.finishAuth("站点上拒绝了这次授权。")
+				return
+			case PollExpired:
+				m.finishAuth("授权已过期，请重新连接。")
+				return
+			case PollSlowDown:
+				interval += 2 * time.Second
+				timer.Reset(interval)
+			default:
+				timer.Reset(interval)
+			}
+		}
+	}()
+}
+
+// completeAuth 拿到密钥：交给插件或挂上供应商、拉目录、读钱包，全都落地后才清 pending。
+func (m *Manager) completeAuth(grant *Grant) {
+	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Second)
+	defer cancel()
+
+	cur := m.currency(ctx)
+	cat, _ := m.client.readCatalog(ctx)
+	if err := m.keepGrant(ctx, m.baseURL, grant, cat); err != nil {
+		m.finishAuth("密钥已拿到，但" + err.Error())
+		return
+	}
+
+	m.mu.Lock()
+	m.pending = nil
+	m.snap.Pending = nil
+	m.snap.TokenName = grant.TokenName
+	m.snap.GrantedAt = m.clock().UnixMilli()
+	m.snap.Error = ""
+	m.snap.Currency = &cur
+	if cat != nil {
+		m.snap.Models = len(cat.Models)
+		m.snap.Groups = len(cat.Groups)
+		m.snap.GroupList = cat.GroupList
+		m.snap.CatalogAt = m.clock().UnixMilli()
+	}
+	if acc := summarize(grant.User, cur); acc != nil {
+		m.snap.Account = acc
+	}
+	m.mu.Unlock()
+	m.save()
+	m.refreshWalletNow(context.Background())
+}
+
+// finishAuth 结束一次授权并记下原因。
+func (m *Manager) finishAuth(reason string) {
+	m.mu.Lock()
+	m.pending = nil
+	m.snap.Pending = nil
+	m.snap.Error = reason
+	cancel := m.cancel
+	m.mu.Unlock()
+	m.save()
+	if cancel != nil {
+		cancel()
+	}
+}
+
+// cancelPending 放弃进行中的授权（站点那边的码自然过期）。
+func (m *Manager) cancelPending() {
+	m.mu.Lock()
+	m.pending = nil
+	m.snap.Pending = nil
+	cancel := m.cancel
+	m.mu.Unlock()
+	m.save()
+	if cancel != nil {
+		cancel()
+	}
+}
+
+// open 让系统浏览器打开正在等的那一页确认页。地址只取 Manager 自己记着的
+// 那个，页面没法让宿主打开任意 URL。
+func (m *Manager) open() (any, error) {
+	auth, ok := m.livePending()
+	if !ok {
+		return nil, fail(CodeBadParam, "没有等待确认的授权")
+	}
+	if err := proc.OpenBrowser(auth.VerificationURIComplete); err != nil {
+		return map[string]any{
+			"opened": false,
+			"url":    auth.VerificationURIComplete,
+			"error":  "没能打开浏览器，请手动打开这个地址：" + err.Error(),
+		}, nil
+	}
+	return map[string]any{"opened": true, "url": auth.VerificationURIComplete}, nil
+}
+
+// disconnect 撤销站点上的密钥、删掉插件凭据与 magpie 里这一条、清掉本地的数字。
+func (m *Manager) disconnect(ctx context.Context) (any, error) {
+	key, _ := storedKey()
+	if key != "" {
+		if warn := m.client.revoke(ctx, key); warn != nil {
+			// 站点不认这把钥匙也要断开：本地那份必须走
+			m.logf("revoking the key: %v", warn)
+		}
+	}
+	m.detach(ctx)
+	m.mu.Lock()
+	m.snap = snapshot{BaseURL: m.baseURL}
+	m.pending = nil
+	cancel := m.cancel
+	m.mu.Unlock()
+	m.save()
+	if cancel != nil {
+		cancel()
+	}
+	return m.state(ctx), nil
+}
+
+// refresh 现在就读一遍钱包与目录，然后回状态。
+func (m *Manager) refresh(ctx context.Context) (any, error) {
+	key, ok := storedKey()
+	if !ok {
+		return nil, fail(CodeNotConnected, "还没有连接 NearToken")
+	}
+	if err := m.readWallet(ctx, key); err != nil {
+		return nil, err
+	}
+	if cat, cerr := m.client.readCatalog(ctx); cerr == nil && cat != nil {
+		// 插件在场时模型表由插件自己的 provider.models 给，宿主不再写一份
+		if !pluginOwnsProvider() {
+			m.saveCatalog(ctx, m.baseURL, cat)
+		}
+		m.mu.Lock()
+		m.snap.Models = len(cat.Models)
+		m.snap.Groups = len(cat.Groups)
+		m.snap.GroupList = cat.GroupList
+		m.snap.CatalogAt = m.clock().UnixMilli()
+		m.mu.Unlock()
+		m.save()
+	}
+	return m.state(ctx), nil
+}
+
+// refreshWalletSoon 在后台重读一次钱包，同一时间只有一次。
+func (m *Manager) refreshWalletSoon() {
+	m.mu.Lock()
+	stale := m.clock().UnixMilli()-m.snap.WalletAt > walletTTL.Milliseconds()
+	if !stale || m.refreshing {
+		m.mu.Unlock()
+		return
+	}
+	m.refreshing = true
+	m.mu.Unlock()
+	go func() {
+		defer func() {
+			m.mu.Lock()
+			m.refreshing = false
+			m.mu.Unlock()
+		}()
+		key, ok := storedKey()
+		if !ok {
+			return
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
+		defer cancel()
+		if err := m.readWallet(ctx, key); err != nil {
+			m.logf("reading the wallet: %v", err)
+		}
+	}()
+}
+
+// refreshWalletNow 是同步版：一次连接完成后立刻要看到数字。
+func (m *Manager) refreshWalletNow(ctx context.Context) {
+	key, ok := storedKey()
+	if !ok {
+		return
+	}
+	if err := m.readWallet(ctx, key); err != nil {
+		m.logf("reading the wallet: %v", err)
+	}
+}
+
+// readWallet 读一次钱包并把它并进快照；失败保留旧数字，不清空。
+func (m *Manager) readWallet(ctx context.Context, key string) *Error {
+	cur := m.currency(ctx)
+	quota, used, vouchers, err := m.client.wallet(ctx, key, cur)
+	if err != nil {
+		return err
+	}
+	m.mu.Lock()
+	acc := &Account{Vouchers: vouchers}
+	if m.snap.Account != nil {
+		*acc = *m.snap.Account
+		acc.Vouchers = vouchers
+	}
+	acc.Balance = cur.text(quota)
+	acc.Used = cur.text(used)
+	m.snap.Account = acc
+	m.snap.WalletAt = m.clock().UnixMilli()
+	m.snap.Currency = &cur
+	m.mu.Unlock()
+	m.save()
+	return nil
+}
+
+// currency 是站点汇率，10 分钟内复用上一次的结果。
+func (m *Manager) currency(ctx context.Context) Currency {
+	m.mu.Lock()
+	cached := m.snap.Currency
+	at := m.snap.CurrencyAt
+	m.mu.Unlock()
+	if cached != nil && cached.PerUnit > 0 && m.clock().UnixMilli()-at < currencyTTL.Milliseconds() {
+		return *cached
+	}
+	cur := m.client.readStatus(ctx)
+	m.mu.Lock()
+	m.snap.Currency = &cur
+	m.snap.CurrencyAt = m.clock().UnixMilli()
+	m.mu.Unlock()
+	return cur
+}
+
+// usage 读看板的一个窗口。
+func (m *Manager) usage(ctx context.Context, params map[string]any) (any, error) {
+	key, ok := storedKey()
+	if !ok {
+		return nil, fail(CodeNotConnected, "还没有连接 NearToken")
+	}
+	span, _ := params["range"].(string)
+	if span == "" {
+		span = "day"
+	}
+	m.mu.Lock()
+	balance := ""
+	if m.snap.Account != nil {
+		balance = m.snap.Account.Balance
+	}
+	m.mu.Unlock()
+	cur := m.currency(ctx)
+	win, err := m.client.readUsage(ctx, key, balance, span, cur)
+	if err != nil {
+		return nil, err
+	}
+	return win, nil
+}
+
+// topup 不带 amount 时读充值档位；带了就下单并把支付页交给系统浏览器。
+func (m *Manager) topup(ctx context.Context, params map[string]any) (any, error) {
+	key, ok := storedKey()
+	if !ok {
+		return nil, fail(CodeNotConnected, "还没有连接 NearToken")
+	}
+	cur := m.currency(ctx)
+	amount, hasAmount := paramNumber(params, "amount")
+	if !hasAmount {
+		return m.client.topupInfo(ctx, key, cur), nil
+	}
+	method, _ := params["paymentMethod"].(string)
+	order, err := m.client.topup(ctx, key, amount, method)
+	if err != nil {
+		return nil, err
+	}
+	opened := proc.OpenBrowser(order.URL) == nil
+	// 付完几分钟内余额自己再读一次，不必回页面点刷新
+	time.AfterFunc(20*time.Second, m.refreshWalletSoon)
+	return map[string]any{"order": order, "opened": opened, "url": order.URL}, nil
+}
+
+// paramNumber 从页面给的 params 里取一个数（JSON 解出来是 float64）。
+func paramNumber(params map[string]any, name string) (float64, bool) {
+	switch v := params[name].(type) {
+	case float64:
+		return v, true
+	case int:
+		return float64(v), true
+	case int64:
+		return float64(v), true
+	}
+	return 0, false
+}
+
+// logf 是这只表的日志：前缀让它从 magpie 别的日志里认得出来。
+func (m *Manager) logf(format string, args ...any) {
+	log.Printf("neartoken: "+format, args...)
+}
