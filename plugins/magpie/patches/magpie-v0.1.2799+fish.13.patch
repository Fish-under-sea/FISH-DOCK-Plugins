+	site.topupOff = true
+	off := c.topupInfo(t.Context(), "sk-abc", cur)
+	if !strings.Contains(off.Unavailable, "重新连接") {
+		t.Errorf("a key the site doesn't sell top-ups to: %q", off.Unavailable)
+	}
+}
+
+func TestCatalogKeepsChatModelsOnly(t *testing.T) {
+	site := newFakeSite(t)
+	cat, err := newClient(site.srv.URL).readCatalog(t.Context())
+	if err != nil {
+		t.Fatalf("catalog: %v", err)
+	}
+	got := strings.Join(cat.Models, ",")
+	want := "gpt-5,claude-5,gemini-3-pro"
+	if got != want {
+		t.Fatalf("models = %s, want %s", got, want)
+	}
+	if len(cat.Groups) != 3 {
+		t.Errorf("groups = %v", cat.Groups)
+	}
+	if cat.Refs["[满血] GPT"] != "#3" {
+		t.Errorf("refs = %v", cat.Refs)
+	}
+	// 分组墙（2.1.8 契约）：站点的组名原样、倍率、这一组的模型数、ref。
+	if len(cat.GroupList) != 3 {
+		t.Fatalf("groupList = %+v", cat.GroupList)
+	}
+	first := cat.GroupList[0]
+	// 只数能聊的：gpt-5-c（站点给的 -c 变体）与 gpt-image-2（生图）都不算进组里。
+	if first.Name != "[满血] GPT" || first.Ratio != 0.5 || first.Models != 1 || first.Ref != "#3" {
+		t.Errorf("groupList[0] = %+v", first)
+	}
+	// 站点没给 ratio 的组留 0，页面据此不画倍率。
+	if claude := cat.GroupList[1]; claude.Name != "[满血] Claude" || claude.Ratio != 1 || claude.Models != 1 {
+		t.Errorf("groupList[1] = %+v", claude)
+	}
+	if gemini := cat.GroupList[2]; gemini.Name != "[满血] Gemini" || gemini.Ratio != 0 {
+		t.Errorf("groupList[2] = %+v", gemini)
+	}
+}
+
+// state 把分组墙与「令牌名」一起交给页面：两类数据都从插件凭据 / 目录快照里来。
+func TestStateCarriesTheGroupWallAndThePluginTokenName(t *testing.T) {
+	withPluginProvider(t)
+	writeSettings(t, "plugin-auth.json", map[string]any{
+		ProviderID: map[string]any{"type": "oauth", "access": "sk-plugin", "refresh": "sk-plugin", "tokenName": "Magpie"},
+	}, map[string]any{})
+	dropHostEntry(t)
+
+	m := New(t.TempDir())
+	m.mu.Lock()
+	m.snap.GroupList = []GroupInfo{
+		{Name: "[低价] Grok", Ratio: 0.1, Models: 12, Ref: "#37"},
+		{Name: "[满血] GPT", Ratio: 1, Models: 5},
+	}
+	m.mu.Unlock()
+
+	view := m.state(t.Context())
+	if len(view.GroupList) != 2 {
+		t.Fatalf("groupList = %+v", view.GroupList)
+	}
+	got := view.GroupList[0]
+	if got.Name != "[低价] Grok" || got.Ratio != 0.1 || got.Models != 12 || got.Ref != "#37" {
+		t.Errorf("groupList[0] = %+v", got)
+	}
+	if view.TokenName != "Magpie" {
+		t.Errorf("tokenName = %q, want the one the plugin kept", view.TokenName)
+	}
+}
+
+// 没读过目录时 groupList 也得是空数组而不是 null：页面直接遍历。
+func TestStateGroupListIsAnEmptyArrayWithoutACatalog(t *testing.T) {
+	dropHostEntry(t)
+	view := New(t.TempDir()).state(t.Context())
+	if view.GroupList == nil || len(view.GroupList) != 0 {
+		t.Fatalf("groupList = %#v", view.GroupList)
+	}
+}
+
+func TestManagerStateWithoutAConnection(t *testing.T) {
+	m := New(t.TempDir())
+	view := m.state(t.Context())
+	if view.Configured || view.Pending != nil || view.ProviderID != ProviderID {
+		t.Fatalf("view = %+v", view)
+	}
+	if view.Currency.PerUnit != 1 {
+		t.Errorf("a site not read yet should default to raw quota, got %+v", view.Currency)
+	}
+}
+
+func TestRevokeSendsTheKey(t *testing.T) {
+	site := newFakeSite(t)
+	if err := newClient(site.srv.URL).revoke(t.Context(), "sk-abc"); err != nil {
+		t.Fatalf("revoke: %v", err)
+	}
+	if len(site.revoked) != 1 || site.revoked[0] != "sk-abc" {
+		t.Fatalf("revoked = %v", site.revoked)
+	}
+}
+
+// 保持 io 被用到（编不过就说明测试夹具改坏了）
+var _ = io.Discard
diff --git a/internal/neartoken/provider.go b/internal/neartoken/provider.go
new file mode 100644
index 00000000..37daaa60
--- /dev/null
+++ b/internal/neartoken/provider.go
@@ -0,0 +1,106 @@
+package neartoken
+
+import (
+	"context"
+	"strings"
+
+	"github.com/yetone/magpie/internal/catalog"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// 站点上四种协议的入口。Chat 与 Responses 的基址以 /v1 结尾，Anthropic 的
+// 基址是根（和 ANTHROPIC_BASE_URL 一样），Gemini 的基址到 /v1beta。
+func chatBase(baseURL string) string      { return strings.TrimRight(baseURL, "/") + "/v1" }
+func anthropicBase(baseURL string) string { return strings.TrimRight(baseURL, "/") }
+func geminiBase(baseURL string) string    { return strings.TrimRight(baseURL, "/") + "/v1beta" }
+
+// storedKey 是现在能用的那把钥匙；没有就是没连。
+//
+// 插件在场时它读插件自己的 auth——插件才是这条供应商的主人（handoff.go）。
+// 插件刚接手、老钥匙还没搬过去的那一小会儿，退回 providers.json 里那条，
+// 页面不至于一下子显示成未连接。
+func storedKey() (string, bool) {
+	if pluginOwnsProvider() {
+		if key, ok := pluginAuth(); ok {
+			return key, true
+		}
+	}
+	p, err := provider.Find(ProviderID)
+	if err != nil || p == nil {
+		return "", false
+	}
+	key := strings.TrimSpace(p.Key)
+	return key, key != ""
+}
+
+// attach 把站点挂成 magpie 的一个供应商：一个 id、一把钥匙、四个入口。
+//
+// 只在不装 provider 插件的那一路用（见 handoff.go）：插件在场时钥匙归插件，
+// 宿主不建这一条，否则就盖住了插件给的模型表、图标与余额。
+//
+// 已有的那一条只改钥匙与基址，其余（用户改过的路由、模型选择、请求头）
+// 一律不动 —— 重新登录不该把用户设好的东西清掉。第一次连接才建这一条。
+func attach(baseURL, key string, cat *Catalog) error {
+	p, err := provider.Find(ProviderID)
+	if err != nil || p == nil {
+		p = &provider.Provider{
+			ID:   ProviderID,
+			Name: "NearToken",
+			// 站点自己那张图；编辑器与供应商列表都用它
+			Icon: siteIconURL(baseURL),
+		}
+	}
+	p.Key = key
+	p.Chat = chatBase(baseURL)
+	p.Anthropic = anthropicBase(baseURL)
+	p.Gemini = geminiBase(baseURL)
+	// 站点把 Responses 也开在 /v1 下（New API 的 openai-response）
+	p.Responses = chatBase(baseURL)
+	p.BaseAPI = "chat"
+	if cat != nil && len(cat.Models) > 0 {
+		p.Models = append([]string(nil), cat.Models...)
+	}
+	if err := provider.Save(*p); err != nil {
+		return err
+	}
+	return nil
+}
+
+// saveCatalog 把站点目录写成 magpie 认得的那份列表，模型选择器随之更新。
+// 一次抓取失败不该让连接失败：没有列表时 magpie 会退回它自己知道的那份。
+func (m *Manager) saveCatalog(ctx context.Context, baseURL string, cat *Catalog) {
+	if cat == nil || len(cat.Models) == 0 {
+		return
+	}
+	models := make([]catalog.Model, 0, len(cat.Models))
+	for _, name := range cat.Models {
+		models = append(models, catalog.Model{ID: name, Name: name})
+	}
+	if err := catalog.SaveLive(ProviderID, chatBase(baseURL), models); err != nil {
+		m.logf("saving the site's models: %v", err)
+	}
+}
+
+// detach 把这条供应商从 magpie 里清干净：插件那条凭据、宿主侧那条老的
+// key+URL 供应商、以及它写下的模型表。清不动只记录：页面仍会显示未连接，
+// 因为密钥已经先撤销了。
+func (m *Manager) detach(ctx context.Context) {
+	if err := forgetPluginAuth(ctx); err != nil {
+		m.logf("forgetting the plugin's sign-in: %v", err)
+	}
+	if err := provider.Delete(ProviderID); err != nil {
+		m.logf("removing the provider: %v", err)
+	}
+	if err := catalog.SaveLive(ProviderID, "", nil); err != nil {
+		m.logf("forgetting the site's models: %v", err)
+	}
+}
+
+// siteIconURL 是站点那张图；页面与供应商卡都用同一个地址。
+func siteIconURL(baseURL string) string {
+	base := strings.TrimRight(baseURL, "/")
+	if base == "" {
+		base = DefaultBaseURL
+	}
+	return base + "/logo.png"
+}
diff --git a/internal/neartoken/site.go b/internal/neartoken/site.go
new file mode 100644
index 00000000..4c07697b
--- /dev/null
+++ b/internal/neartoken/site.go
@@ -0,0 +1,194 @@
+// Package neartoken 把 NearToken（https://neartoken.cc，一个 New API 部署）
+// 接进 magpie：设备授权登录、余额与代金券、用量看板、在线充值，以及把站点
+// 作为 magpie 自己的一个供应商挂上（模型与路由仍由 magpie 原生负责）。
+//
+// 站点只在一个地方被说起：baseURL。所有请求都从这里出，所有错误都带一个
+// 稳定的码，页面对着码给一句人话，而不是把上游的英文原样铺开。
+package neartoken
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// DefaultBaseURL 是站点根地址，不带尾斜杠。
+const DefaultBaseURL = "https://neartoken.cc"
+
+// ProviderID 是这个插件在 magpie 里挂的供应商 id：一个就好，不支持多账号。
+const ProviderID = "neartoken"
+
+// ClientName 是站点确认页上显示的这头设备的称呼。
+//
+// 它故意不是 dsh-neartoken 的「DSH 插件」：那位作者的令牌、日志与授权记录
+// 都靠 DSH 这个标识认人，我们的连接混进同一串标识里，他排查时就分不清哪一条
+// 是自己的用户。这里写 Magpie。
+const ClientName = "Magpie"
+
+// TokenName 是请求站点给这把密钥起的名字。
+//
+// 站点按 client_name 命名时它就是令牌名；站点另有实现时会忽略它——带上不会
+// 出错，但**令牌名最终由站点决定**。所以插件不把它当事实：页面显示的是站点
+// 回的 token_name，回什么显示什么。
+const TokenName = "Magpie"
+
+// UserAgent 让站点的访问日志与 New API 的请求记录分得出来源。不是标准要求，
+// 但排查时省一次猜。
+const UserAgent = "magpie-neartoken"
+
+// 页面对着这些码分支；字符串是页面与 Go 共同的语言，不要随手改。
+const (
+	CodeUnreachable   = "SITE_UNREACHABLE"
+	CodeInvalidAnswer = "SITE_RESPONSE_INVALID"
+	CodeRefused       = "SITE_REFUSED"
+	CodeNotConnected  = "NOT_CONNECTED"
+	// CodeTokenRequired 是站点为「只有 DSH 设备授权签发的令牌才能充值」写的码，
+	// 名字里的 DSH 是站点自己的历史，不是本插件的标识；这里只按它分支，对外
+	// 一律说「这把密钥不是本插件登录签发的」。
+	CodeTokenRequired  = "DSH_TOKEN_REQUIRED"
+	CodeTopupOff       = "TOPUP_UNAVAILABLE"
+	CodeNoUsage        = "NO_USAGE"
+	CodeBadParam       = "INVALID_PARAM"
+	CodeAuthExpired    = "AUTH_EXPIRED"
+	CodeProvider       = "PROVIDER_FAILED"
+	CodeAuthInProgress = "AUTH_IN_PROGRESS"
+)
+
+// Error 是一个带码的失败：页面按码分支，Message 是给人看的那句。
+// 字段叫 Kind 而不是 Code，因为 Code() 是 internal/gui 认的那个接口。
+type Error struct {
+	Kind    string
+	Message string
+}
+
+func (e *Error) Error() string { return e.Message }
+
+// Code 让页面拿到稳定的分支码（internal/gui 的错误编码靠这个接口）。
+func (e *Error) Code() string { return e.Kind }
+
+func fail(code, format string, args ...any) *Error {
+	return &Error{Kind: code, Message: fmt.Sprintf(format, args...)}
+}
+
+// envelope 是站点所有 JSON 应答的外壳：{success, message, code, data}。
+// 设备授权的轮询把「还没决定」也放在 success:false 里，所以这里只解形状，
+// 判断留给调用者。
+type envelope struct {
+	Success *bool           `json:"success"`
+	Message string          `json:"message"`
+	Code    string          `json:"code"`
+	Data    json.RawMessage `json:"data"`
+	// GroupRefs 只在 /api/pricing 上出现：分组名 → 路由用的 #<id>。
+	GroupRefs map[string]string `json:"group_refs"`
+	// GroupRatio 也在 /api/pricing 上：分组名 → 站点给这一组算的倍率。
+	GroupRatio map[string]float64 `json:"group_ratio"`
+}
+
+// client 是本站的一次调用：地址、超时、以及给测试换掉的 http.Client。
+type client struct {
+	baseURL string
+	http    *http.Client
+}
+
+func newClient(baseURL string) *client {
+	if strings.TrimSpace(baseURL) == "" {
+		baseURL = DefaultBaseURL
+	}
+	return &client{
+		baseURL: strings.TrimRight(baseURL, "/"),
+		http:    &http.Client{Timeout: 25 * time.Second},
+	}
+}
+
+// call 发一次请求并解外面的信封。auth 为空表示匿名调用（发起授权、轮询）。
+// 只有「连不上」与「回的不是 JSON」在这里算错，站点自己的拒绝原样交回去。
+func (c *client) call(ctx context.Context, method, path string, body any, auth string) (*envelope, *Error) {
+	var reader io.Reader
+	if body != nil {
+		raw, err := json.Marshal(body)
+		if err != nil {
+			return nil, fail(CodeBadParam, "请求体序列化失败：%v", err)
+		}
+		reader = bytes.NewReader(raw)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, reader)
+	if err != nil {
+		return nil, fail(CodeBadParam, "请求地址无效：%v", err)
+	}
+	req.Header.Set("accept", "application/json")
+	// 站点日志里认得出是哪一个客户端在问，不靠猜
+	req.Header.Set("user-agent", UserAgent)
+	if body != nil {
+		req.Header.Set("content-type", "application/json")
+	}
+	if auth != "" {
+		req.Header.Set("authorization", "Bearer "+auth)
+	}
+	res, err := c.http.Do(req)
+	if err != nil {
+		if ctx.Err() != nil {
+			// 一次调用自己超时了，不是站点的问题，但页面看到的仍是"没答"。
+			return nil, fail(CodeUnreachable, "站点没有在时限内应答")
+		}
+		return nil, fail(CodeUnreachable, "连不上 %s：%v", c.baseURL, err)
+	}
+	defer res.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(res.Body, 4<<20))
+	if err != nil {
+		return nil, fail(CodeUnreachable, "读取站点应答失败：%v", err)
+	}
+	env := &envelope{}
+	if err := json.Unmarshal(raw, env); err != nil {
+		return nil, fail(CodeInvalidAnswer, "站点应答不是 JSON（HTTP %d）", res.StatusCode)
+	}
+	return env, nil
+}
+
+// ok 是 success 明确为 true。
+func (e *envelope) ok() bool { return e.Success != nil && *e.Success }
+
+// said 是站点自己给的那句话，挑一个说得出话的字段。
+func (e *envelope) said() string {
+	if strings.TrimSpace(e.Message) != "" {
+		return strings.TrimSpace(e.Message)
+	}
+	return ""
+}
+
+// refused 把一次被拒的信封翻成带码的错误：充值端点用 403 + code 说明
+// "这把 Key 不是本插件签发的"，其余按站点原话。
+func (e *envelope) refused(action string) *Error {
+	if e.Code == CodeTokenRequired {
+		return fail(CodeTokenRequired, "这把密钥不是本插件登录签发的，请重新连接")
+	}
+	if said := e.said(); said != "" {
+		return fail(CodeRefused, "%s：%s", action, said)
+	}
+	return fail(CodeRefused, "%s被站点拒绝了", action)
+}
+
+// decode 把 data 解成 v。
+func (e *envelope) decode(v any) *Error {
+	if len(e.Data) == 0 || string(e.Data) == "null" {
+		return fail(CodeInvalidAnswer, "站点应答缺少 data")
+	}
+	if err := json.Unmarshal(e.Data, v); err != nil {
+		return fail(CodeInvalidAnswer, "站点应答的 data 解不开：%v", err)
+	}
+	return nil
+}
+
+// asError 让 errors.As 找到装在包装里的 *Error。
+func asError(err error) *Error {
+	var e *Error
+	if errors.As(err, &e) {
+		return e
+	}
+	return fail(CodeRefused, "%v", err)
+}
diff --git a/internal/neartoken/state.go b/internal/neartoken/state.go
new file mode 100644
index 00000000..a6de47e1
--- /dev/null
+++ b/internal/neartoken/state.go
@@ -0,0 +1,103 @@
+package neartoken
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+)
+
+// snapshot 是磁盘上留着的那一份状态：密钥在 providers.json 里，这里只放
+// 重启后还想显示的账户数字与未完成的授权。读不出来就当作没有，绝不拿一份
+// 坏文件覆盖上一次的好数字。
+type snapshot struct {
+	BaseURL    string    `json:"baseURL,omitempty"`
+	TokenName  string    `json:"tokenName,omitempty"`
+	Account    *Account  `json:"account,omitempty"`
+	Pending    *pending  `json:"pending,omitempty"`
+	Error      string    `json:"error,omitempty"`
+	GrantedAt  int64     `json:"grantedAt,omitempty"`
+	WalletAt   int64     `json:"walletAt,omitempty"`
+	Currency   *Currency `json:"currency,omitempty"`
+	CurrencyAt int64     `json:"currencyAt,omitempty"`
+	CatalogAt  int64     `json:"catalogAt,omitempty"`
+	Models     int       `json:"models,omitempty"`
+	Groups     int       `json:"groups,omitempty"`
+	// GroupList 是分组墙的那份快照：读一次目录就留一份，插件重载后页面不用等重新抓。
+	GroupList []GroupInfo `json:"groupList,omitempty"`
+}
+
+// pending 是一次进行中的授权里能给人看的部分；device_code 从不落盘。
+type pending struct {
+	UserCode                string `json:"userCode"`
+	VerificationURI         string `json:"verificationUri"`
+	VerificationURIComplete string `json:"verificationUriComplete"`
+	ExpiresAt               int64  `json:"expiresAt"`
+}
+
+// StatePath 是这份快照的位置，与 providers.json 同目录。
+func StatePath() string { return filepath.Join(appdir.Config(), "neartoken.json") }
+
+// loadSnapshot 读回上一次的状态；文件不存在或解不开都是空状态。
+func loadSnapshot(path string) snapshot {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return snapshot{}
+	}
+	var s snapshot
+	if err := json.Unmarshal(b, &s); err != nil {
+		return snapshot{}
+	}
+	return s
+}
+
+// storeSnapshot 原子地写：临时文件、落盘、改名，并留一份 .bak。
+func storeSnapshot(path string, s snapshot) error {
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	b, err := json.MarshalIndent(s, "", "  ")
+	if err != nil {
+		return err
+	}
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, b, 0o644); err != nil {
+		return err
+	}
+	if old, err := os.ReadFile(path); err == nil {
+		_ = os.WriteFile(path+".bak", old, 0o644)
+	}
+	if err := os.Rename(tmp, path); err != nil {
+		return err
+	}
+	return nil
+}
+
+// saveMu 让两次保存不会互相盖掉：一次调用的写与后台刷新撞上时，最后写完的
+// 那份仍是内存里最新的状态。
+var saveMu sync.Mutex
+
+// save 把当前状态写到 disk。错误只在日志里说：写不进去不该让一次连接失败。
+func (m *Manager) save() {
+	m.mu.Lock()
+	s := m.snap
+	m.mu.Unlock()
+	saveMu.Lock()
+	defer saveMu.Unlock()
+	if err := storeSnapshot(m.path, s); err != nil && !errors.Is(err, os.ErrNotExist) {
+		m.logf("saving %s: %v", m.path, err)
+	}
+}
+
+// now 是这只表用的时钟；测试会换掉它。
+func (m *Manager) clock() time.Time {
+	if m.now != nil {
+		return m.now()
+	}
+	return time.Now()
+}
diff --git a/internal/neartoken/status.go b/internal/neartoken/status.go
new file mode 100644
index 00000000..df4cda22
--- /dev/null
+++ b/internal/neartoken/status.go
@@ -0,0 +1,103 @@
+package neartoken
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// 站点的公开状态与定价端点。
+const (
+	statusPath  = "/api/status"
+	pricingPath = "/api/pricing"
+)
+
+// Currency 是站点印钱的方式：一个原始 quota 值折算成它显示的那笔钱。
+//
+// 站点回的额度全是 quota 单位，钱包、用量、代金券都按这同一份汇率折算，
+// 三处数字才不会互相打架。
+type Currency struct {
+	// Symbol 是金额前面的符号（￥ 或 $）。
+	Symbol string `json:"symbol"`
+	// PerUnit 是一个显示单位值多少 quota。
+	PerUnit float64 `json:"perUnit"`
+	// Rate 是显示货币对美元的比价，站点要求按货币显示时才会乘。
+	Rate float64 `json:"rate"`
+	// Display 是站点是否要按它自己的货币显示金额。
+	Display bool `json:"display"`
+	// Name 是站点名（近令牌站点的 system_name）。
+	Name string `json:"name"`
+}
+
+// money 把 quota 折成站点显示的那笔钱，未取整。
+func (c Currency) money(quota float64) float64 {
+	perUnit := c.PerUnit
+	if perUnit <= 0 {
+		perUnit = 1
+	}
+	value := quota / perUnit
+	if c.Display && c.Rate > 0 {
+		value *= c.Rate
+	}
+	return value
+}
+
+// text 是一位金额：带符号、两位小数，和站点自己的面板一致。
+func (c Currency) text(quota float64) string {
+	return fmt.Sprintf("%s%.2f", c.symbol(), c.money(quota))
+}
+
+func (c Currency) symbol() string {
+	if c.Symbol != "" {
+		return c.Symbol
+	}
+	if c.Display {
+		return "￥"
+	}
+	return "$"
+}
+
+// readStatus 读站点的公开状态。/api/status 匿名可读，所以连接之前页面也
+// 拿得到站点名；读不到就退回默认口径，不因此让整张卡报错。
+func (c *client) readStatus(ctx context.Context) Currency {
+	cur := Currency{Symbol: "", PerUnit: 1, Rate: 1, Display: false, Name: "NearToken"}
+	env, err := c.call(ctx, "GET", statusPath, nil, "")
+	if err != nil || !env.ok() {
+		return cur
+	}
+	var data struct {
+		SystemName        string   `json:"system_name"`
+		QuotaPerUnit      float64  `json:"quota_per_unit"`
+		USDExchangeRate   *float64 `json:"usd_exchange_rate"`
+		DisplayInCurrency bool     `json:"display_in_currency"`
+		// 站点可选地覆盖货币符号（"¥"、"€"），有就用它
+		CustomSymbol string `json:"custom_currency_symbol"`
+	}
+	if derr := env.decode(&data); derr != nil {
+		return cur
+	}
+	if strings.TrimSpace(data.SystemName) != "" {
+		cur.Name = strings.TrimSpace(data.SystemName)
+	}
+	if data.QuotaPerUnit > 0 {
+		cur.PerUnit = data.QuotaPerUnit
+	}
+	if data.USDExchangeRate != nil && *data.USDExchangeRate > 0 {
+		cur.Rate = *data.USDExchangeRate
+	}
+	cur.Display = data.DisplayInCurrency
+	cur.Symbol = strings.TrimSpace(data.CustomSymbol)
+	return cur
+}
+
+// currencyClock 记着这份汇率读到的时间，免得每次调用都问一遍站点。
+type currencyClock struct {
+	cur Currency
+	at  time.Time
+}
+
+// fresh 是这份汇率还能用（10 分钟内）。
+func (c currencyClock) fresh(now time.Time) bool {
+	return !c.at.IsZero() && now.Sub(c.at) < 10*time.Minute
+}
diff --git a/internal/neartoken/topup.go b/internal/neartoken/topup.go
new file mode 100644
index 00000000..63d3d75b
--- /dev/null
+++ b/internal/neartoken/topup.go
@@ -0,0 +1,123 @@
+package neartoken
+
+import (
+	"context"
+	"strings"
+)
+
+// 充值面：站点只给"本插件签发的密钥"下单，别的一律 403 DSH_TOKEN_REQUIRED。
+const (
+	topupInfoPath = "/api/dsh/device/topup/info"
+	topupPath     = "/api/dsh/device/topup"
+)
+
+// TopupMethod 是站点开着的收款方式之一。
+type TopupMethod struct {
+	Type string `json:"type"`
+	Name string `json:"name"`
+}
+
+// TopupInfo 是充值卡能画出来的东西。Unavailable 非空时整块收起，页面只留
+// 那一句原因，不摆一个点不动的按钮。
+type TopupInfo struct {
+	Enabled     bool          `json:"enabled"`
+	Unavailable string        `json:"unavailable,omitempty"`
+	Min         float64       `json:"min"`
+	Options     []float64     `json:"options"`
+	Methods     []TopupMethod `json:"methods"`
+	Currency    string        `json:"currency"`
+}
+
+// TopupOrder 是一次下单的结果：站点的订单号与要打开的支付页。
+type TopupOrder struct {
+	TradeNo string `json:"tradeNo"`
+	URL     string `json:"url"`
+}
+
+// topupInfo 读站点的充值档位与渠道。
+func (c *client) topupInfo(ctx context.Context, key string, cur Currency) *TopupInfo {
+	out := &TopupInfo{Options: []float64{}, Methods: []TopupMethod{}, Currency: cur.symbol()}
+	env, err := c.call(ctx, "GET", topupInfoPath, nil, key)
+	if err != nil {
+		out.Unavailable = "连不上站点，充值暂时不可用。"
+		return out
+	}
+	if !env.ok() {
+		switch env.Code {
+		case CodeTokenRequired:
+			out.Unavailable = "当前密钥不是本插件登录签发的，重新连接后即可充值。"
+		default:
+			// 老站点根本没有这个端点：不摆充值区
+			if env.said() == "" {
+				out.Unavailable = "站点未提供在线充值。"
+			} else {
+				out.Unavailable = env.said()
+			}
+		}
+		return out
+	}
+	var data struct {
+		Enable    bool      `json:"enable_online_topup"`
+		Min       float64   `json:"min_topup"`
+		Options   []float64 `json:"amount_options"`
+		PayMethod []struct {
+			Name string `json:"name"`
+			Type string `json:"type"`
+		} `json:"pay_methods"`
+	}
+	if derr := env.decode(&data); derr != nil {
+		out.Unavailable = "站点的充值信息读不出来。"
+		return out
+	}
+	out.Enabled = data.Enable
+	out.Min = data.Min
+	if data.Options != nil {
+		out.Options = data.Options
+	}
+	for _, m := range data.PayMethod {
+		if m.Type == "" || m.Name == "" {
+			continue
+		}
+		out.Methods = append(out.Methods, TopupMethod{Type: m.Type, Name: m.Name})
+	}
+	if !out.Enabled {
+		out.Unavailable = "站点当前关闭了在线充值。"
+	}
+	if out.Enabled && len(out.Methods) == 0 {
+		out.Unavailable = "站点没有开着的收款方式。"
+	}
+	return out
+}
+
+// topup 下一单，返回要交给系统浏览器打开的地址。真实校验收在站点侧，这里
+// 只挡掉明显不合法的金额。
+func (c *client) topup(ctx context.Context, key string, amount float64, method string) (*TopupOrder, *Error) {
+	if amount <= 0 || amount != float64(int64(amount)) {
+		return nil, fail(CodeBadParam, "充值金额必须是正整数")
+	}
+	if strings.TrimSpace(method) == "" {
+		return nil, fail(CodeBadParam, "请先选一个收款方式")
+	}
+	env, err := c.call(ctx, "POST", topupPath, map[string]any{"amount": amount, "payment_method": method}, key)
+	if err != nil {
+		return nil, err
+	}
+	if !env.ok() {
+		return nil, env.refused("发起充值")
+	}
+	var data struct {
+		TradeNo string `json:"trade_no"`
+		PayURL  string `json:"pay_url"`
+	}
+	if derr := env.decode(&data); derr != nil {
+		return nil, derr
+	}
+	if data.PayURL == "" {
+		return nil, fail(CodeInvalidAnswer, "站点没有给出支付地址")
+	}
+	pay := data.PayURL
+	if strings.HasPrefix(pay, "/") {
+		pay = c.baseURL + pay
+	}
+	return &TopupOrder{TradeNo: data.TradeNo, URL: pay}, nil
+}
diff --git a/internal/neartoken/usage.go b/internal/neartoken/usage.go
new file mode 100644
index 00000000..b96e8cea
--- /dev/null
+++ b/internal/neartoken/usage.go
@@ -0,0 +1,131 @@
+package neartoken
+
+import (
+	"context"
+	"fmt"
+	"slices"
+)
+
+// usagePath 是插件的密钥能读的用量端点，range 取 day / week / month。
+const usagePath = "/api/dsh/device/usage"
+
+// UsageRanges 是看板能切的三个窗口。
+var UsageRanges = []string{"day", "week", "month"}
+
+// UsageModel 是一个模型在一格或整个窗口里的用量。
+type UsageModel struct {
+	Model    string  `json:"model"`
+	Tokens   float64 `json:"tokens"`
+	Cost     float64 `json:"cost"`
+	CostText string  `json:"costText"`
+}
+
+// UsageBucket 是堆叠图上的一列。
+type UsageBucket struct {
+	Timestamp int64        `json:"timestamp"`
+	Models    []UsageModel `json:"models"`
+}
+
+// UsageWindow 是一个窗口的全部数字。Available 为 false 时，Reason 说明是
+// 站点没有这个端点（unsupported）还是这一轮读不到（unreachable）——两种说法
+// 在页面上是两句不同的话，不合并。
+type UsageWindow struct {
+	Available     bool          `json:"available"`
+	Reason        string        `json:"reason,omitempty"`
+	Range         string        `json:"range"`
+	Start         int64         `json:"start"`
+	End           int64         `json:"end"`
+	BucketSeconds int           `json:"bucketSeconds"`
+	Currency      string        `json:"currency"`
+	Spent         string        `json:"spent"`
+	Balance       string        `json:"balance"`
+	Tokens        float64       `json:"tokens"`
+	Models        []UsageModel  `json:"models"`
+	Buckets       []UsageBucket `json:"buckets"`
+}
+
+// readUsage 读一个窗口。调用方给的 balance 是钱包卡片上那个数：端点只说花
+// 了多少，余额是钱包的事，不在第二个地方再问一遍。
+func (c *client) readUsage(ctx context.Context, key, balance, span string, cur Currency) (*UsageWindow, *Error) {
+	if !slices.Contains(UsageRanges, span) {
+		return nil, fail(CodeBadParam, "没有这个窗口：%s（day / week / month）", span)
+	}
+	env, cerr := c.call(ctx, "GET", usagePath+"?range="+span, nil, key)
+	if cerr != nil {
+		return &UsageWindow{Available: false, Reason: "unreachable", Range: span, Balance: balance}, nil
+	}
+	if !env.ok() {
+		// 老站点把这条路径当未知路由，回的是 JSON 但没有窗口：这是部署事实，
+		// 不是密钥坏了。
+		return &UsageWindow{Available: false, Reason: "unsupported", Range: span, Balance: balance}, nil
+	}
+	var data struct {
+		Start         float64 `json:"start_timestamp"`
+		End           float64 `json:"end_timestamp"`
+		BucketSeconds float64 `json:"bucket_seconds"`
+		Quota         float64 `json:"quota"`
+		Tokens        float64 `json:"tokens"`
+		Models        []struct {
+			Model  string  `json:"model"`
+			Quota  float64 `json:"quota"`
+			Tokens float64 `json:"tokens"`
+		} `json:"models"`
+		Buckets []struct {
+			Timestamp float64 `json:"timestamp"`
+			Models    []struct {
+				Model  string  `json:"model"`
+				Quota  float64 `json:"quota"`
+				Tokens float64 `json:"tokens"`
+			} `json:"models"`
+		} `json:"buckets"`
+	}
+	if derr := env.decode(&data); derr != nil || data.BucketSeconds <= 0 {
+		return &UsageWindow{Available: false, Reason: "unsupported", Range: span, Balance: balance}, nil
+	}
+	row := func(model string, quota, tokens float64) UsageModel {
+		return UsageModel{Model: model, Tokens: tokens, Cost: cur.money(quota), CostText: cur.text(quota)}
+	}
+	out := &UsageWindow{
+		Available:     true,
+		Range:         span,
+		Start:         int64(data.Start),
+		End:           int64(data.End),
+		BucketSeconds: int(data.BucketSeconds),
+		Currency:      cur.symbol(),
+		Spent:         cur.text(data.Quota),
+		Balance:       balance,
+		Tokens:        data.Tokens,
+		Models:        []UsageModel{},
+		Buckets:       []UsageBucket{},
+	}
+	for _, m := range data.Models {
+		if m.Model == "" {
+			continue
+		}
+		out.Models = append(out.Models, row(m.Model, m.Quota, m.Tokens))
+	}
+	for _, b := range data.Buckets {
+		bucket := UsageBucket{Timestamp: int64(b.Timestamp), Models: []UsageModel{}}
+		for _, m := range b.Models {
+			if m.Model == "" {
+				continue
+			}
+			bucket.Models = append(bucket.Models, row(m.Model, m.Quota, m.Tokens))
+		}
+		out.Buckets = append(out.Buckets, bucket)
+	}
+	return out, nil
+}
+
+// rangeLabel 是窗口在页面上的名字，错误消息里用。
+func rangeLabel(span string) string {
+	switch span {
+	case "day":
+		return "日"
+	case "week":
+		return "周"
+	case "month":
+		return "月"
+	}
+	return fmt.Sprint(span)
+}
diff --git a/internal/neartoken/wallet.go b/internal/neartoken/wallet.go
new file mode 100644
index 00000000..085804ac
--- /dev/null
+++ b/internal/neartoken/wallet.go
@@ -0,0 +1,89 @@
+package neartoken
+
+import "context"
+
+// walletPath 用插件的密钥读用户维度的额度与分组代金券。
+const walletPath = "/api/dsh/device/wallet"
+
+// Voucher 是一张分组代金券：只能付它自己那一组，金额按站点货币印。
+type Voucher struct {
+	Group   string `json:"group"`
+	GroupID int    `json:"groupId"`
+	Amount  string `json:"amount"`
+}
+
+// Account 是账户卡要的几件事。
+type Account struct {
+	Username    string    `json:"username"`
+	DisplayName string    `json:"displayName"`
+	Group       string    `json:"group"`
+	Balance     string    `json:"balance"`
+	Used        string    `json:"used"`
+	Vouchers    []Voucher `json:"vouchers"`
+}
+
+// wallet 读余额、已用与分组代金券，金额按站点货币折成文字。端点不存在
+// （老站点）、读不到、令牌被停用，都只表示"这一轮没读到"，调用者保留上一次
+// 的数字，不清空。
+func (c *client) wallet(ctx context.Context, key string, cur Currency) (quota, used float64, vouchers []Voucher, err *Error) {
+	env, cerr := c.call(ctx, "GET", walletPath, nil, key)
+	if cerr != nil {
+		return 0, 0, nil, cerr
+	}
+	if !env.ok() {
+		return 0, 0, nil, env.refused("读取余额")
+	}
+	var data struct {
+		Quota     float64 `json:"quota"`
+		UsedQuota float64 `json:"used_quota"`
+		Credits   []struct {
+			Group   string  `json:"group"`
+			GroupID int     `json:"group_id"`
+			Amount  float64 `json:"amount"`
+		} `json:"group_credits"`
+	}
+	if derr := env.decode(&data); derr != nil {
+		return 0, 0, nil, derr
+	}
+	out := make([]Voucher, 0, len(data.Credits))
+	for _, g := range data.Credits {
+		// 只留还有钱的那些；站点已经滤过一遍，这里再守一次
+		if g.Amount <= 0 {
+			continue
+		}
+		out = append(out, Voucher{Group: g.Group, GroupID: g.GroupID, Amount: cur.text(g.Amount)})
+	}
+	return data.Quota, data.UsedQuota, out, nil
+}
+
+// summarize 把 grant 里那份 user 摊成账户卡。
+func summarize(user map[string]any, cur Currency) *Account {
+	if user == nil {
+		return nil
+	}
+	text := func(key string) string {
+		if v, ok := user[key].(string); ok {
+			return v
+		}
+		return ""
+	}
+	num := func(key string) float64 {
+		if v, ok := user[key].(float64); ok {
+			return v
+		}
+		return 0
+	}
+	name := text("username")
+	display := text("display_name")
+	if display == "" {
+		display = name
+	}
+	return &Account{
+		Username:    name,
+		DisplayName: display,
+		Group:       text("group"),
+		Balance:     cur.text(num("quota")),
+		Used:        cur.text(num("used_quota")),
+		Vouchers:    []Voucher{},
+	}
+}
diff --git a/internal/plugin/calls_test.go b/internal/plugin/calls_test.go
new file mode 100644
index 00000000..18e5f633
--- /dev/null
+++ b/internal/plugin/calls_test.go
@@ -0,0 +1,115 @@
+package plugin
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+// magpie.calls 是页面能问 magpie 做的事的声明。这里钉住四条：只留 magpie
+// 真有的名字、格式不对的丢弃、重复的去重、超过上限截断。
+
+func TestCallsKeepingKeepsOnlyWhatMagpieHas(t *testing.T) {
+	got := callsKeeping([]string{"relay:view", "relay:start", "nope:thing", "usage:summary"})
+	want := []string{"relay:view", "relay:start"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("callsKeeping = %v, want %v", got, want)
+	}
+}
+
+func TestCallsKeepingDropsMalformedNames(t *testing.T) {
+	bad := []string{"Relay:View", "relay", "relay:", ":relay", "relay:view:extra", "relay view", "", strings40()}
+	if got := callsKeeping(bad); len(got) != 0 {
+		t.Fatalf("非法名字被留下了: %v", got)
+	}
+}
+
+func TestCallsKeepingDeduplicatesAndCaps(t *testing.T) {
+	// 超过 maxCalls 的部分截断，且顺序按声明
+	many := make([]string, 0, 40)
+	for i := 0; i < 40; i++ {
+		many = append(many, "relay:view")
+	}
+	// 同一个名字只留一次
+	if got := callsKeeping(many); len(got) != 1 {
+		t.Fatalf("重复名字没去重: %v", got)
+	}
+	// PageCalls 只有 10 条，去重后不足 16；钉住"不超过 16"这个上界
+	if len(callsKeeping(PageCalls)) > maxCalls {
+		t.Fatalf("超过 maxCalls: %d", len(callsKeeping(PageCalls)))
+	}
+	if len(PageCalls) < 5 {
+		t.Fatalf("PageCalls 太少: %v", PageCalls)
+	}
+}
+
+func TestCallsKeepingEmptyIsEmpty(t *testing.T) {
+	if got := callsKeeping(nil); len(got) != 0 {
+		t.Fatalf("nil 应当没有 calls: %v", got)
+	}
+}
+
+// 预装插件美化那两颗要在 PageCalls 里。不在的话 callsKeeping 会把它们静默
+// 丢掉——页面那边只会看到「调用失败」，签到页这一整块就自己隐藏了，线上表现
+// 是"开关根本没出现"，查起来极费劲。
+func TestPageCallsCarryTheBrandSwitch(t *testing.T) {
+	kept := callsKeeping([]string{"brand:status", "brand:set"})
+	want := []string{"brand:status", "brand:set"}
+	if !slices.Equal(kept, want) {
+		t.Fatalf("brand:* 被丢掉了：%v", kept)
+	}
+}
+
+// Window() 从 package.json 读 magpie.calls：有 page 才有效，且只留合法的。
+func TestWindowReadsMagpieCalls(t *testing.T) {
+	dir := t.TempDir()
+	write := func(name, body string) {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("index.html", "<!doctype html><title>relay</title>")
+	write("package.json", `{
+  "name": "page-relay-probe",
+  "magpie": {
+    "page": {"title": "Relay probe", "file": "index.html"},
+    "calls": ["relay:view", "relay:start", "relay:view", "tampered:call"]
+  }
+}`)
+	window, only := Window(dir)
+	if window == nil || window.Page == nil {
+		t.Fatal("没有读到页面")
+	}
+	if !only {
+		t.Fatal("只有页面的插件应当是 only")
+	}
+	want := []string{"relay:view", "relay:start"}
+	if !slices.Equal(window.Calls, want) {
+		t.Fatalf("Calls = %v, want %v", window.Calls, want)
+	}
+}
+
+// 没有页面也没有面板的插件，没有 calls 可声明。
+func TestWindowWithoutPageHasNoCalls(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "package.json"), []byte(`{
+  "main": "index.js",
+  "magpie": {"calls": ["relay:view"]}
+}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if window, _ := Window(dir); window != nil {
+		t.Fatalf("没有页面却拿到了 WindowSpec: %+v", window)
+	}
+}
+
+// strings40 是一个格式合法的超长名字（用于验证 "relay:view:extra" 之外的
+// 长度/字符规则不靠猜）。
+func strings40() string {
+	out := "relay:"
+	for i := 0; i < 40; i++ {
+		out += "a"
+	}
+	return out
+}
