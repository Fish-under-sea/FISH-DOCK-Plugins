diff --git a/internal/gui/openext.go b/internal/gui/openext.go
new file mode 100644
index 00000000..53bbfc9d
--- /dev/null
+++ b/internal/gui/openext.go
@@ -0,0 +1,49 @@
+package gui
+
+import (
+	"errors"
+	"net/url"
+	"os/exec"
+	"runtime"
+	"strings"
+)
+
+// openExternalCall 用系统默认浏览器打开页面给的链接。
+//
+// 为什么需要它：插件的页面帧是 sandbox="allow-scripts"，既没有
+// allow-popups 也没有 allow-top-navigation，所以页面里任何 <a href>
+// 点了都不会有反应（不是 magpie 拦的，是宿主帧的沙箱决定的）。
+// 页面改为把链接交给这条调用，由 magpie 本体在系统浏览器里打开。
+//
+// 只认 http/https：file://、javascript:、data: 一律拒绝，
+// 避免页面借这条通道做本地文件或脚本执行。
+func openExternalCall(params map[string]any) (any, error) {
+	raw, _ := params["url"].(string)
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return nil, errors.New("OPEN_EXTERNAL_EMPTY")
+	}
+	if len(raw) > 4096 {
+		return nil, errors.New("OPEN_EXTERNAL_TOO_LONG")
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Host == "" {
+		return nil, errors.New("OPEN_EXTERNAL_INVALID")
+	}
+	if u.Scheme != "http" && u.Scheme != "https" {
+		return nil, errors.New("OPEN_EXTERNAL_SCHEME")
+	}
+	var cmd *exec.Cmd
+	switch runtime.GOOS {
+	case "windows":
+		cmd = exec.Command("rundll32", "url.dll,FileProtocolHandler", u.String())
+	case "darwin":
+		cmd = exec.Command("open", u.String())
+	default:
+		cmd = exec.Command("xdg-open", u.String())
+	}
+	if err := cmd.Start(); err != nil {
+		return nil, errors.New("OPEN_EXTERNAL_FAILED")
+	}
+	return map[string]any{"opened": true, "url": u.String()}, nil
+}
