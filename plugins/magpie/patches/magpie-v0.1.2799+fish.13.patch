diff --git a/internal/gui/preinstall_pending_test.go b/internal/gui/preinstall_pending_test.go
new file mode 100644
index 00000000..e0e52c6b
--- /dev/null
+++ b/internal/gui/preinstall_pending_test.go
@@ -0,0 +1,125 @@
+package gui
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// preinstallHome 把数据目录挪到临时目录，并返回它：状态文件、plugins.json 与
+// 装好的包都跟着走，不碰真机。
+func preinstallHome(t *testing.T) string {
+	t.Helper()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(home, ".cache"))
+	t.Setenv("MAGPIE_PLUGIN_MARKET", "off")
+	return filepath.Dir(provider.Path())
+}
+
+// writeState 写下宿主首启登记的那份状态（Node 侧 preinstall.mjs 的格式）。
+func writeState(t *testing.T, data string, registered []string) {
+	t.Helper()
+	dir := filepath.Join(data, "config")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	body := map[string]any{"schema": 1, "status": "registered", "registeredAt": "2026-11-02T08:00:00Z", "registered": registered, "added": registered}
+	b, err := json.Marshal(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "preinstall-state.json"), b, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// installPlugin 把一家供应商插件「装上」：目录与 package.json 的 version 都要在，
+// 因为 pending 是照着真实安装算的，不是照着状态文件自己记的数字。
+func installPlugin(t *testing.T, spec string) {
+	t.Helper()
+	dir := plugin.Target(spec)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "package.json"), []byte(`{"name":"x","version":"1.0.0"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// 首启登记了、还没装上：brand:status 报「还差几个」，装完归零（#16 / #18 B4）。
+func TestBrandStateReportsPendingPlugins(t *testing.T) {
+	data := preinstallHome(t)
+
+	// 还没有状态文件（老数据、首启还没落盘）：这个键根本不出现，页面不显示那一行。
+	value, err := pluginCall(context.Background(), "", "brand:status", nil)
+	if err != nil {
+		t.Fatalf("brand:status: %v", err)
+	}
+	if state, _ := value.(map[string]any); state != nil {
+		if _, ok := state["pendingPlugins"]; ok {
+			t.Fatalf("没有状态文件时不该报 pendingPlugins：%v", state["pendingPlugins"])
+		}
+	} else {
+		t.Fatalf("brand:status 返回 %T", value)
+	}
+	if n, ok := preinstallPending(); ok || n != 0 {
+		t.Fatalf("没有状态文件时 preinstallPending = %d,%v", n, ok)
+	}
+
+	registered := []string{
+		"@magpie-community/opencode-raccoon-auth@latest",
+		"@magpie-community/opencode-cline-auth@latest",
+		"@magpie-community/opencode-kiro-auth@latest",
+	}
+	writeState(t, data, registered)
+	if n, ok := preinstallPending(); !ok || n != 3 {
+		t.Fatalf("一家都没装时 preinstallPending = %d,%v，应当是 3,true", n, ok)
+	}
+	value, err = pluginCall(context.Background(), "", "brand:status", nil)
+	if err != nil {
+		t.Fatalf("brand:status: %v", err)
+	}
+	state, _ := value.(map[string]any)
+	if n, _ := state["pendingPlugins"].(int); n != 3 {
+		t.Fatalf("brand:status 的 pendingPlugins = %v，应当是 3", state["pendingPlugins"])
+	}
+
+	// 装上一家：数字跟着真实安装走。
+	installPlugin(t, registered[0])
+	if n, _ := preinstallPending(); n != 2 {
+		t.Fatalf("装上一家之后 pending = %d，应当是 2", n)
+	}
+
+	// 装完：报 0，页面据此把那行收起来（而不是一直挂着「正在准备」）。
+	for _, spec := range registered[1:] {
+		installPlugin(t, spec)
+	}
+	if n, ok := preinstallPending(); !ok || n != 0 {
+		t.Fatalf("装完之后 preinstallPending = %d,%v，应当是 0,true", n, ok)
+	}
+}
+
+// 状态文件坏掉/空着都按「读不到」处理：不报错，也不编数字。
+func TestPreinstallPendingIgnoresBrokenState(t *testing.T) {
+	data := preinstallHome(t)
+	dir := filepath.Join(data, "config")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for _, body := range []string{"", "{", `{"registered":[]}`, `{"schema":1}`} {
+		if err := os.WriteFile(filepath.Join(dir, "preinstall-state.json"), []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if n, ok := preinstallPending(); ok || n != 0 {
+			t.Errorf("状态文件 %q 时 preinstallPending = %d,%v，应当当作读不到", body, n, ok)
+		}
+	}
+}
