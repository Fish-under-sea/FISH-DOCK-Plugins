diff --git a/internal/provider/brand_icon.go b/internal/provider/brand_icon.go
new file mode 100644
index 00000000..0e876df9
--- /dev/null
+++ b/internal/provider/brand_icon.go
@@ -0,0 +1,195 @@
+package provider
+
+import (
+	"embed"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+)
+
+// FISH Dock 的品牌图标：预装插件在插件页、供应商页、侧边栏和用量卡片上的
+// 样子由这套素材决定，插件市场给的名字、插件自带的 data URI 都不再是画面上
+// 的东西。PluginIcon 先问这里，没有才走原来的路。
+//
+// 素材编进 exe，不放在插件包里：用户更新社区插件、甚至卸了重装，图标都不
+// 会掉。开关只是 <data>/icons/brand 下一个标记文件，关掉就把画面让回原版，
+// 不删任何用户数据。
+//
+// 每份素材是一张 SVG，深浅两套画在同一个文件里（.l / .d 两个组，用
+// prefers-color-scheme 切换）。窗口本来就跟着系统配色走——magpie 自己的
+// app.js 问的就是这个媒体查询——所以一个文件在两种界面下都对，服务端不必
+// 去猜当前主题，也就不存在「切主题时要重发一遍图标」。
+//
+//go:embed brandicons
+var brandIconFS embed.FS
+
+// brandSource 是内嵌素材的目录，ReadDir 一次就够。
+const brandSource = "brandicons"
+
+// brandMarkName 是开关标记的文件名。
+const brandMarkName = "on"
+
+// BrandDir 是开关标记所在的目录，与用户自己挑的图标同一个 icons 目录下。
+func BrandDir() string { return filepath.Join(IconDir(), "brand") }
+
+func brandMarkPath() string { return filepath.Join(BrandDir(), brandMarkName) }
+
+// BrandOn 报「启用预装插件美化」现在是开是关。
+func BrandOn() bool {
+	_, err := os.Stat(brandMarkPath())
+	return err == nil
+}
+
+// SetBrand 打开或关掉这层美化。打开只写一个标记——素材来自 exe，不落盘；
+// 关掉就把整个 brand 目录删了，下一次 PluginIcon 立刻回到原版。
+func SetBrand(on bool) error {
+	if !on {
+		if err := os.RemoveAll(BrandDir()); err != nil && !os.IsNotExist(err) {
+			return err
+		}
+		brandCache.Lock()
+		brandCache.kept = nil
+		brandCache.Unlock()
+		return nil
+	}
+	if err := os.MkdirAll(BrandDir(), 0o755); err != nil {
+		return err
+	}
+	return os.WriteFile(brandMarkPath(), []byte("1\n"), 0o644)
+}
+
+// brandFiles 是内嵌素材的索引：provider id → 内嵌路径。文件名就是 provider
+// id，与插件注册的那个 id 一致（trae-cn、mimo-app、qwenwork 这类各有一份，
+// 内容相同也各存一份，省得再维护一张别名表）。
+var brandFiles = sync.OnceValue(func() map[string]string {
+	out := map[string]string{}
+	ents, err := brandIconFS.ReadDir(brandSource)
+	if err != nil {
+		return out
+	}
+	for _, e := range ents {
+		if e.IsDir() {
+			continue
+		}
+		name := e.Name()
+		id := strings.TrimSuffix(name, filepath.Ext(name))
+		if id == "" {
+			continue
+		}
+		out[id] = brandSource + "/" + name
+	}
+	return out
+})
+
+// BrandVendors 是这套素材覆盖的 provider id，按字典序。页面用它告诉用户
+// 「美化的是哪几家」，测试用它核对清单没有走样。
+func BrandVendors() []string {
+	files := brandFiles()
+	out := make([]string, 0, len(files))
+	for id := range files {
+		out = append(out, id)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// brandCache 记住每个 id 落成哪个 file: 名，省掉每次列表都读一遍内嵌素材。
+var brandCache struct {
+	sync.Mutex
+	kept map[string]string
+}
+
+// BrandIcon 是这家厂商的品牌图标（Icon 值，形如 file:<name>），"" 表示开关
+// 关着，或者这家不在这套素材里。
+//
+// 插件页与供应商页走 PluginIcon，它本身就用了这里；已安装列表另有一处也要问
+// 一遍——那一行显示的是「包」，一个包可能注册好几家（trae-cn 与 trae-global），
+// 取其中第一个命中素材的就够。
+func BrandIcon(id string) string { return brandIcon(id) }
+
+// brandIcon 是这个 provider 的品牌图标，"" 表示没有可用的（开关关着、或者
+// 这家不在这套素材里）。返回的是 Icon 值（file:<name>），前端照用户自己挑
+// 的图片那条路画，不需要任何前端改动。
+//
+// StoreIcon 按内容哈希命名，同一份素材存几次都是同一个文件；缓存只是省掉
+// 重复写盘，文件被清掉了会重新写。
+func brandIcon(id string) string {
+	if id == "" || !BrandOn() {
+		return ""
+	}
+	src, ok := brandFiles()[id]
+	if !ok {
+		return ""
+	}
+	brandCache.Lock()
+	defer brandCache.Unlock()
+	if ic := brandCache.kept[id]; ic != "" {
+		if f := IconFile(strings.TrimPrefix(ic, iconPrefix)); f != "" {
+			if _, err := os.Stat(f); err == nil {
+				return ic
+			}
+		}
+	}
+	b, err := brandIconFS.ReadFile(src)
+	if err != nil {
+		return ""
+	}
+	ic, err := StoreIcon(b)
+	if err != nil {
+		return ""
+	}
+	if brandCache.kept == nil {
+		brandCache.kept = map[string]string{}
+	}
+	brandCache.kept[id] = ic
+	return ic
+}
+
+// brandIconNames 是这层美化「可能已经落盘」的图标文件名，pruneIcons 要留它们。
+//
+// 只读 brandCache.kept 是不够的（#16）：缓存只在进程里，进程刚起、还没人问过
+// 图标时它是空的，于是一次 pruneIcons 就把上一轮落盘的品牌图标当成没人用删掉，
+// 下一问再写一遍——首启那几次冷启看起来就是图标在抖。素材编在 exe 里，文件名
+// 是内容的哈希，所以这里直接从内嵌素材算出名字来，不依赖缓存，也不依赖那次
+// 写盘到底发生过没有。
+func brandIconNames() []string {
+	if !BrandOn() {
+		return nil
+	}
+	names := brandStoredNames()
+	out := make([]string, 0, len(names))
+	for _, name := range names {
+		out = append(out, name)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// brandStoredNames 是每份内嵌素材落盘时的文件名：与 StoreIcon 用同一条规则
+// （内容哈希前 8 字节 + 按内容认出的扩展名），所以同一份素材永远是同一个名字。
+// 内嵌素材不会变，算一次就够。
+var brandStoredNames = sync.OnceValue(func() map[string]string {
+	out := map[string]string{}
+	for id, src := range brandFiles() {
+		b, err := brandIconFS.ReadFile(src)
+		if err != nil {
+			continue
+		}
+		// 与 StoreIcon 同一处规则（iconStoredName）：算出来的名字必须就是写盘
+		// 那个名字，否则 pruneIcons 的 keep 集合会跟盘上对不上。
+		if name, ok := iconStoredName(b); ok {
+			out[id] = name
+		}
+	}
+	return out
+})
+
+// brandLocked 让调用方在品牌图标这把锁里做一件与落盘互斥的事：pruneIcons 数
+// 「谁还在用」与 brandIcon 写盘不能交错，否则刚写下去的图会被当成没人用。
+func brandLocked(f func()) {
+	brandCache.Lock()
+	defer brandCache.Unlock()
+	f()
+}
diff --git a/internal/provider/brand_icon_prune_test.go b/internal/provider/brand_icon_prune_test.go
new file mode 100644
index 00000000..74e2fb51
--- /dev/null
+++ b/internal/provider/brand_icon_prune_test.go
@@ -0,0 +1,122 @@
+package provider
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+)
+
+// coldStartBrand 模拟进程刚起：没人问过任何图标，brandCache 还是空的。
+func coldStartBrand(t *testing.T) {
+	t.Helper()
+	brandCache.Lock()
+	brandCache.kept = nil
+	brandCache.Unlock()
+}
+
+// 冷启时也要说得出「哪些名字是我们这层美化落下的」：名字从内嵌素材算得出来，
+// 不靠进程内缓存（#16 的图标抖动就是只读缓存造成的）。
+func TestBrandIconNamesSurviveAColdStart(t *testing.T) {
+	brandHome(t)
+	if err := SetBrand(true); err != nil {
+		t.Fatalf("打开：%v", err)
+	}
+	coldStartBrand(t)
+	names := brandIconNames()
+	if len(names) != len(brandFiles()) {
+		t.Fatalf("冷启时算出 %d 个名字，内嵌素材有 %d 份", len(names), len(brandFiles()))
+	}
+	if !slices.IsSorted(names) {
+		t.Errorf("名字不是字典序：%v", names)
+	}
+	for _, name := range names {
+		if IconFile(name) == "" {
+			t.Errorf("算出来的名字 %q 不是合法的图标文件名", name)
+		}
+	}
+	// 真的写下去的那张图，名字必须就在这份清单里——pruneIcons 才留得住它。
+	ic := brandIcon("kiro")
+	name, ok := strings.CutPrefix(ic, iconPrefix)
+	if !ok {
+		t.Fatalf("kiro 的图标 %q 不是 file: 值", ic)
+	}
+	if !slices.Contains(names, name) {
+		t.Errorf("清单里没有刚落下的 %q：%v", name, names)
+	}
+}
+
+// pruneIcons 一次冷启的清理不许把品牌图标当没人用删掉；没人用的旧图仍然要删。
+func TestPruneIconsKeepsBrandIconsFromAColdStart(t *testing.T) {
+	brandHome(t)
+	if err := SetBrand(true); err != nil {
+		t.Fatalf("打开：%v", err)
+	}
+	ic := brandIcon("kiro")
+	name, ok := strings.CutPrefix(ic, iconPrefix)
+	if !ok {
+		t.Fatalf("kiro 的图标 %q 不是 file: 值", ic)
+	}
+	brandFile := IconFile(name)
+	old := time.Now().Add(-2 * time.Hour)
+	if err := os.Chtimes(brandFile, old, old); err != nil {
+		t.Fatalf("把品牌图标改成旧文件：%v", err)
+	}
+	coldStartBrand(t)
+
+	unused := filepath.Join(IconDir(), "dead00beef00cafe.png")
+	if err := os.WriteFile(unused, []byte("\x89PNG\r\n\x1a\nnot-a-brand-icon"), 0o644); err != nil {
+		t.Fatalf("放一张没人用的图：%v", err)
+	}
+	if err := os.Chtimes(unused, old, old); err != nil {
+		t.Fatalf("把没人用的图改成旧文件：%v", err)
+	}
+
+	pruneIcons(file{})
+
+	if _, err := os.Stat(brandFile); err != nil {
+		t.Errorf("冷启的一次 pruneIcons 把品牌图标删了（%s）：%v", brandFile, err)
+	}
+	if _, err := os.Stat(unused); !os.IsNotExist(err) {
+		t.Errorf("没人用的旧图应当删掉，实际还在：%v", err)
+	}
+}
+
+// 关掉这一层之后照样不许留下：清单随开关走，pruneIcons 会把这些图当没人用。
+func TestBrandIconNamesEmptyWhenOff(t *testing.T) {
+	brandHome(t)
+	coldStartBrand(t)
+	if names := brandIconNames(); len(names) != 0 {
+		t.Errorf("关着时不该有名字：%v", names)
+	}
+}
+
+// 内嵌素材算名与 StoreIcon 写盘算名必须同源：同一份字节 → 同一个文件名。
+// 这两边一旦各写一遍规则，改了一边就会让 pruneIcons 的 keep 集合跟盘上对不上，
+// 把刚写下去的图当没人用删掉——那正是 #16 里图标抖动的成因。
+func TestBrandIconNamesMatchWhatStoreIconWrites(t *testing.T) {
+	brandHome(t)
+	if err := SetBrand(true); err != nil {
+		t.Fatalf("打开：%v", err)
+	}
+	names := brandStoredNames()
+	for id, src := range brandFiles() {
+		b, err := brandIconFS.ReadFile(src)
+		if err != nil {
+			t.Fatalf("%s：读内嵌素材：%v", id, err)
+		}
+		ic, err := StoreIcon(b)
+		if err != nil {
+			t.Fatalf("%s：StoreIcon：%v", id, err)
+		}
+		name, ok := strings.CutPrefix(ic, iconPrefix)
+		if !ok {
+			t.Fatalf("%s：%q 不是 file: 值", id, ic)
+		}
+		if got := names[id]; got != name {
+			t.Fatalf("%s：内嵌素材算出 %q，StoreIcon 写下的是 %q（两处规则必须同源）", id, got, name)
+		}
+	}
+}
diff --git a/internal/provider/brand_icon_test.go b/internal/provider/brand_icon_test.go
new file mode 100644
index 00000000..1307c923
--- /dev/null
+++ b/internal/provider/brand_icon_test.go
@@ -0,0 +1,156 @@
+package provider
+
+import (
+	"encoding/base64"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/plugin"
+)
+
+// brandHome 把数据目录挪到临时目录下：品牌图标的开关和落盘的图标都跟着走，
+// 测试之间不会互相踩，也不会碰到真机上的 ~/.config/magpie。
+func brandHome(t *testing.T) {
+	t.Helper()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(home, ".cache"))
+	t.Setenv("MAGPIE_PLUGIN_MARKET", "off")
+	t.Cleanup(func() { _ = SetBrand(false) })
+}
+
+// strOf 读一个 file: 图标的字节，读不到就失败。
+func strOf(t *testing.T, icon string) string {
+	t.Helper()
+	name, ok := strings.CutPrefix(icon, iconPrefix)
+	if !ok {
+		t.Fatalf("%q 不是 file: 图标", icon)
+	}
+	f := IconFile(name)
+	if f == "" {
+		t.Fatalf("%q 不是存下来的图标", icon)
+	}
+	b, err := os.ReadFile(f)
+	if err != nil {
+		t.Fatalf("读 %s：%v", f, err)
+	}
+	return string(b)
+}
+
+// 默认是开的这件事由插件页的开关负责，provider 这层默认什么都不做：
+// 没有标记文件时 PluginIcon 必须与原版一模一样。
+func TestBrandIconOffByDefault(t *testing.T) {
+	brandHome(t)
+	if BrandOn() {
+		t.Fatal("新目录下就是开着的")
+	}
+	if ic := brandIcon("cline"); ic != "" {
+		t.Errorf("关着时 brandIcon = %q，应当没有", ic)
+	}
+	if ic := PluginIcon(plugin.Provider{ID: "google", Spec: "lemon-plugin"}); ic != "gemini-color" {
+		t.Errorf("关着时 PluginIcon = %q，应当是市场给的那个", ic)
+	}
+}
+
+// 打开以后，插件页/供应商页拿到的就是这个 provider 的品牌图标，
+// 而且它排在插件自己给的 data URI 前面——这层美化就是要接管画面。
+func TestBrandIconOnTakesOver(t *testing.T) {
+	brandHome(t)
+	if err := SetBrand(true); err != nil {
+		t.Fatalf("打开：%v", err)
+	}
+	if !BrandOn() {
+		t.Fatal("打开后 BrandOn 还是 false")
+	}
+	ic := brandIcon("cline")
+	if ic == "" {
+		t.Fatal("cline 没有品牌图标")
+	}
+	body := strOf(t, ic)
+	if !strings.Contains(body, "<svg") {
+		t.Errorf("cline 的品牌图标不是 SVG：%.40q", body)
+	}
+	// 深浅两套都在同一个文件里：一个跟着系统配色走的图标，才不用服务端猜主题
+	for _, want := range []string{`class="l"`, `class="d"`, "prefers-color-scheme"} {
+		if !strings.Contains(body, want) {
+			t.Errorf("cline 的品牌图标里没有 %s", want)
+		}
+	}
+
+	png := []byte("\x89PNG\r\n\x1a\n\x00\x00\x00\rIHDR")
+	own := "data:image/png;base64," + base64.StdEncoding.EncodeToString(png)
+	got := PluginIcon(plugin.Provider{ID: "cline", Spec: "cline-plugin", Icon: own})
+	if got != ic {
+		t.Errorf("PluginIcon = %q，应当先给品牌图标 %q", got, ic)
+	}
+	// 不在这套素材里的 id 仍然按原路走
+	if got := PluginIcon(plugin.Provider{ID: "lemon", Spec: "lemon-plugin", Icon: own}); got == ic {
+		t.Errorf("lemon 不该拿到 cline 的图标")
+	}
+}
+
+// 关掉就把这一层让回原版，连落盘的图标也不再被 pruneIcons 当成"有人用"。
+func TestBrandIconOffGivesItBack(t *testing.T) {
+	brandHome(t)
+	if err := SetBrand(true); err != nil {
+		t.Fatalf("打开：%v", err)
+	}
+	if _, err := os.Stat(BrandDir()); err != nil {
+		t.Fatalf("打开后没有 %s：%v", BrandDir(), err)
+	}
+	if ic := brandIcon("kiro"); ic == "" {
+		t.Fatal("kiro 没有品牌图标")
+	}
+	if err := SetBrand(false); err != nil {
+		t.Fatalf("关闭：%v", err)
+	}
+	if BrandOn() {
+		t.Error("关掉之后 BrandOn 还是 true")
+	}
+	if _, err := os.Stat(BrandDir()); !os.IsNotExist(err) {
+		t.Errorf("关掉之后 %s 还在：%v", BrandDir(), err)
+	}
+	if ic := brandIcon("kiro"); ic != "" {
+		t.Errorf("关掉之后 brandIcon = %q", ic)
+	}
+	if names := brandIconNames(); len(names) != 0 {
+		t.Errorf("关掉之后还留了 %d 个图标名给 pruneIcons：%v", len(names), names)
+	}
+}
+
+// 素材清单要盖住预装的 13 家（含同一插件注册的多个 provider id）。
+// `opencode-zen-free` 必须留着：2.1.4 把它移出的是**预装登记**，不是美化——
+// 已装用户仍有这个 provider，而且 brandIconNames 从内嵌素材算名字，素材留着
+// 它才在 pruneIcons 的 keep 集合里，删了反而会被当没人用清掉。
+// `meoo-agent` 是本版新增的内置（Meoo 秒悟 · 建站 Agent，git spec 安装），
+// 它在「扩展 → 插件 → 已安装」那一行靠 brandIconsBySpec（见 gui 的
+// TestBrandIconsBySpecTakesTheFirstVendorOfAPackage 里那条 git spec 用例）。
+func TestBrandVendorsCoverPreinstalled(t *testing.T) {
+	brandHome(t)
+	want := []string{
+		"autoclaw", "autoclaw-cn", "cline", "codearts", "kiro", "loomy", "loomy-plugin",
+		"meoo-agent", "mimo-app", "minimax-code", "minimax-code-global", "opencode-zen-free",
+		"qoder", "qoder-cn", "qwenwork", "qwenwork-enterprise", "raccoon",
+		"trae-cn", "trae-global", "workbuddy", "workbuddy-ai", "zcode",
+	}
+	got := BrandVendors()
+	for _, id := range want {
+		if !slices.Contains(got, id) {
+			t.Errorf("素材里没有 %q", id)
+		}
+	}
+	if !slices.IsSorted(got) {
+		t.Errorf("BrandVendors 不是字典序：%v", got)
+	}
+	// 每一份都要真的能读出来：清单里有一份对不上的文件，线上就是一个空图标
+	for _, id := range got {
+		if !strings.HasSuffix(brandFiles()[id], ".svg") && !strings.HasSuffix(brandFiles()[id], ".png") {
+			t.Errorf("%q 的素材不是 svg/png：%q", id, brandFiles()[id])
+		}
+	}
+}
