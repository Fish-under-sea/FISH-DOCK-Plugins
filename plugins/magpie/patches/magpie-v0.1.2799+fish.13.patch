diff --git a/internal/provider/checkin_view.go b/internal/provider/checkin_view.go
new file mode 100644
index 00000000..983744ea
--- /dev/null
+++ b/internal/provider/checkin_view.go
@@ -0,0 +1,199 @@
+package provider
+
+import (
+	"strings"
+	"time"
+
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// CheckinProviderState 是签到页上的一家厂商：开关与显示名。插件页只读这类
+// 聚合信息，拿不到任何密钥。
+type CheckinProviderState struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	On   bool   `json:"on"`
+	// Collector 说这家厂商今日的数据从哪来：magpie 自己的台账（ledger）、
+	// 插件替它采（plugin），还是根本采不到（none）。空着是给旧页面的旧口径。
+	Collector string `json:"collector,omitempty"`
+}
+
+// CheckinAccountState 是一个账号：oday 的签到结果按它的 Key 查。By 是它所属
+// 厂商的 id（与 Key 里 "厂商|登录" 的前缀一致），页面据此分组。
+type CheckinAccountState struct {
+	Key  string `json:"key"`
+	User string `json:"user"`
+	On   bool   `json:"on"`
+	By   string `json:"by"`
+}
+
+// CheckinViewState 是插件页「自动签到」一次读到的全部内容：厂商、账号、今天
+// 每个账号的结果（Today 按账号 Key）、实得积分（Credits），以及厂商额度面板
+// 反推的估计（CreditEstimate，按账号 Key）。没有秘密。
+//
+// 另有两层「这次读到的是什么」：DailyCredits 是今日额度的原值（插件自己报的
+// 多少就是多少，没报就没有这个键），RefreshedAt 与 Source 说这份数据是什么
+// 时候、从哪读的（本函数只读已落盘的台账，所以 Source 是 ledger）。页面据此
+// 显示「数据截至 HH:MM · 台账」，读不到就整行不显示，不编一个时间。
+type CheckinViewState struct {
+	Providers      []CheckinProviderState      `json:"providers"`
+	Accounts       []CheckinAccountState       `json:"accounts"`
+	Today          map[string]WorkBuddyCheckin `json:"today"`
+	Credits        map[string]float64          `json:"credits,omitempty"`
+	DailyCredits   map[string]float64          `json:"dailyCredits,omitempty"`
+	CreditEstimate map[string]float64          `json:"creditEstimate,omitempty"`
+	RefreshedAt    time.Time                   `json:"refreshedAt,omitzero"`
+	Source         string                      `json:"source,omitempty"`
+}
+
+// checkinVendorNames 是内置签到厂商的显示名（插件厂商的名字来自 PluginCheckins）。
+// 键是账号 Key "厂商|登录" 里的厂商前缀。
+var checkinVendorNames = map[string]string{
+	wbCN.id:             wbCN.name, // workbuddy
+	TraeCNID:            "Trae CN", // trae-cn
+	MiniMaxCodeID:       "MiniMax Code",
+	MiniMaxCodeGlobalID: "MiniMax Code (Global)",
+	"qoder":             "Qoder",
+	QoderCNID:           "Qoder CN",
+}
+
+// CheckinViewStateNow 是 CheckinViewState 的当前读法。
+func CheckinViewStateNow() CheckinViewState { return CheckinViewStateAt(time.Now()) }
+
+// CheckinViewStateAt 汇出签到页要的东西：账号与开关来自 CheckinAccounts，
+// 今天的签到结果来自各厂商已经落盘的签到文件，估计来自额度面板的日间回落。
+// 只读，不发起任何签到。
+func CheckinViewStateAt(now time.Time) CheckinViewState {
+	s := settings.Load()
+	// 插件厂商的名字与开关；能自己采的（插件替它签、替它读）另记一份，
+	// Collector 靠它分 ledger / plugin。
+	names := map[string]string{}
+	on := map[string]bool{}
+	pressedByPlugin := map[string]bool{}
+	for _, pc := range PluginCheckins() {
+		names[pc.ID] = pc.Name
+		on[pc.ID] = PluginCheckinOn(s, pc.ID)
+		pressedByPlugin[pc.ID] = true
+	}
+	// 内置厂商（若还有账号）：名字固定，开关在设置里
+	builtinOn := map[string]bool{
+		wbCN.id:             s.WorkBuddyCheckin,
+		TraeCNID:            s.TraeCheckin,
+		MiniMaxCodeID:       s.MiniMaxCheckin,
+		MiniMaxCodeGlobalID: s.MiniMaxCheckin,
+		"qoder":             s.QoderCheckin,
+		QoderCNID:           s.QoderCheckin,
+	}
+	for id, name := range checkinVendorNames {
+		if _, ok := names[id]; !ok {
+			names[id] = name
+		}
+		if _, ok := on[id]; !ok {
+			on[id] = builtinOn[id]
+		}
+	}
+
+	accounts := CheckinAccounts()
+	today := checkinTodayEntries(now)
+
+	out := CheckinViewState{
+		Providers:    []CheckinProviderState{},
+		Accounts:     []CheckinAccountState{},
+		Today:        map[string]WorkBuddyCheckin{},
+		Credits:      map[string]float64{},
+		DailyCredits: map[string]float64{},
+		RefreshedAt:  now,
+		Source:       "ledger", // 这个函数只读已落盘的台账；将来有实时采集再置 live
+	}
+	seenVendor := map[string]bool{}
+	counts := map[string]int{}
+	for _, a := range accounts {
+		vendor := checkinVendorOf(a.Key)
+		if vendor == "" {
+			continue
+		}
+		counts[vendor]++
+	}
+	for _, a := range accounts {
+		vendor := checkinVendorOf(a.Key)
+		if vendor == "" {
+			continue
+		}
+		out.Accounts = append(out.Accounts, CheckinAccountState{Key: a.Key, User: a.User, On: a.On, By: vendor})
+		if !seenVendor[vendor] {
+			seenVendor[vendor] = true
+			name := names[vendor]
+			if name == "" {
+				name = vendor
+			}
+			out.Providers = append(out.Providers, CheckinProviderState{ID: vendor, Name: name, On: on[vendor], Collector: checkinCollectorOf(vendor, pressedByPlugin[vendor])})
+		}
+		if r, ok := today[a.Key]; ok {
+			// 原值透传：插件报了多少就是多少，没报就还是 0（JSON 里省略），
+			// 页面因此显示「未告知」而不是一个凭白加上去的数。
+			out.Today[a.Key] = r
+			if r.Credit > 0 {
+				out.Credits[a.Key] = r.Credit
+				out.DailyCredits[a.Key] = r.Credit
+			}
+		}
+	}
+	if estimate := CreditEstimates(now); len(estimate) > 0 {
+		by := creditEstimateByAccount(estimate, out.Accounts, counts)
+		if len(by) > 0 {
+			out.CreditEstimate = by
+		}
+	}
+	return out
+}
+
+// checkinCollectorOf 说一家厂商今日的数据从哪来：插件替它签、替它读就是
+// plugin；magpie 自己的台账里有它就是 ledger；都不是就是 none——页面因此
+// 说「不支持自动采集」，而不是把没采过的厂商说成「今日尚未签到」。
+func checkinCollectorOf(vendor string, pressedByPlugin bool) string {
+	if pressedByPlugin {
+		return "plugin"
+	}
+	if _, ok := checkinVendorNames[vendor]; ok {
+		return "ledger"
+	}
+	return "none"
+}
+
+// checkinVendorOf 是账号 Key "厂商|登录" 的厂商；没有分隔符时算不清，返回空。
+func checkinVendorOf(key string) string {
+	if i := strings.Index(key, "|"); i > 0 {
+		return key[:i]
+	}
+	return ""
+}
+
+// checkinTodayEntries 是今天（北京日）每个账号的签到结果：五份签到文件里
+// 属于今天的那一条，按账号 Key 归并。
+func checkinTodayEntries(now time.Time) map[string]WorkBuddyCheckin {
+	day := CheckinDay(now)
+	out := map[string]WorkBuddyCheckin{}
+	for _, path := range []string{wbCheckinPath(), traeCheckinPath(), miniMaxCheckinPath(), qoderCheckinPath(), pluginCheckinPath()} {
+		for key, r := range shownCheckins(path) {
+			if r.Day == day {
+				out[key] = r
+			}
+		}
+	}
+	return out
+}
+
+// creditEstimateByAccount 是厂商级估计摊到账号上：只有该厂商恰好一个账号时
+// 才能确定是它到账的，否则不摊（乱传会把别家账号的额度算到它头上）。
+func creditEstimateByAccount(perVendor map[string]float64, accounts []CheckinAccountState, counts map[string]int) map[string]float64 {
+	out := map[string]float64{}
+	for _, a := range accounts {
+		if counts[a.By] != 1 {
+			continue
+		}
+		if v, ok := perVendor[a.By]; ok && v > 0 {
+			out[a.Key] = v
+		}
+	}
+	return out
+}
diff --git a/internal/provider/checkin_view_test.go b/internal/provider/checkin_view_test.go
new file mode 100644
index 00000000..9072ffc7
--- /dev/null
+++ b/internal/provider/checkin_view_test.go
@@ -0,0 +1,148 @@
+package provider
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestCheckinVendorOf(t *testing.T) {
+	for key, want := range map[string]string{
+		"workbuddy|u1": "workbuddy",
+		"plugin-x|ann": "plugin-x",
+		"qoder-cn|a@b": "qoder-cn",
+		"nopipe":       "",
+		"|leading":     "",
+	} {
+		if got := checkinVendorOf(key); got != want {
+			t.Errorf("checkinVendorOf(%q) = %q, want %q", key, got, want)
+		}
+	}
+}
+
+// 厂商级估计只在它恰好一个账号时摊到那个账号上；两个账号的厂商不摊，以免把
+// 别家账号的额度算到它头上。
+func TestCreditEstimateByAccount(t *testing.T) {
+	perVendor := map[string]float64{"workbuddy": 50, "qoder": 30}
+	accounts := []CheckinAccountState{
+		{Key: "workbuddy|a", By: "workbuddy"},
+		{Key: "qoder|a", By: "qoder"},
+		{Key: "qoder|b", By: "qoder"},
+	}
+	counts := map[string]int{"workbuddy": 1, "qoder": 2}
+	got := creditEstimateByAccount(perVendor, accounts, counts)
+	if got["workbuddy|a"] != 50 {
+		t.Errorf("single-account vendor estimate = %v, want 50", got["workbuddy|a"])
+	}
+	if _, ok := got["qoder|a"]; ok {
+		t.Errorf("two-account vendor must not attribute the estimate, got %v", got)
+	}
+	if _, ok := got["qoder|b"]; ok {
+		t.Errorf("two-account vendor must not attribute the estimate, got %v", got)
+	}
+}
+
+// checkinHome 把数据目录挪到临时目录：settings / 台账 / 插件登录都读不到真机
+// 上的东西，断言也就只反映代码本身。
+func checkinHome(t *testing.T) {
+	t.Helper()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(home, ".cache"))
+	t.Setenv("MAGPIE_PLUGIN_MARKET", "off")
+	if _, err := os.Stat(filepath.Join(home, ".config", "magpie")); err == nil {
+		t.Fatalf("临时目录里已经有真机数据：%v", err)
+	}
+}
+
+// Collector 只有三种答法：插件替它采、magpie 自己的台账、采不到（#18 B3）。
+func TestCheckinCollectorOf(t *testing.T) {
+	for _, c := range []struct {
+		vendor  string
+		plugin  bool
+		collect string
+	}{
+		{"workbuddy", false, "ledger"},
+		{"trae-cn", false, "ledger"},
+		{"qoder-cn", false, "ledger"},
+		{"loomy", true, "plugin"},
+		{"cline", true, "plugin"}, // 插件能采就是 plugin，哪怕台账里也有它
+		{"cline", false, "none"},
+		{"kiro", false, "none"},
+		{"", false, "none"},
+	} {
+		if got := checkinCollectorOf(c.vendor, c.plugin); got != c.collect {
+			t.Errorf("checkinCollectorOf(%q, %v) = %q, want %q", c.vendor, c.plugin, got, c.collect)
+		}
+	}
+}
+
+// 一次读到的状态要交代「什么时候、从哪读的」：RefreshedAt 是读取时刻，
+// Source 是 ledger（这个函数只读台账）。空着不许编（#18 B2）。
+func TestCheckinViewStateSaysWhenAndWhere(t *testing.T) {
+	checkinHome(t)
+	now := time.Date(2026, 11, 2, 21, 30, 0, 0, time.Local)
+	state := CheckinViewStateAt(now)
+	if !state.RefreshedAt.Equal(now) {
+		t.Errorf("RefreshedAt = %v, want %v", state.RefreshedAt, now)
+	}
+	if state.Source != "ledger" {
+		t.Errorf("Source = %q, want ledger", state.Source)
+	}
+	if state.Credits == nil || state.DailyCredits == nil {
+		t.Errorf("两颗积分表都要初始化成空表，实际 %v / %v", state.Credits, state.DailyCredits)
+	}
+	// 页面读的是 JSON 里的名字：refreshedAt 要在，没数据时也不许出现编出来的数。
+	b, err := json.Marshal(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got map[string]any
+	if err := json.Unmarshal(b, &got); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := got["refreshedAt"]; !ok {
+		t.Errorf("JSON 里没有 refreshedAt：%s", b)
+	}
+	if got["source"] != "ledger" {
+		t.Errorf("JSON source = %v, want ledger", got["source"])
+	}
+	if _, ok := got["credits"]; ok {
+		t.Errorf("没有积分时不该有 credits：%s", b)
+	}
+	if _, ok := got["dailyCredits"]; ok {
+		t.Errorf("没有积分时不该有 dailyCredits：%s", b)
+	}
+	// 零值不该被写成 0001-01-01：旧页面按「有没有这个键」决定显不显示那一行。
+	b, err = json.Marshal(CheckinViewState{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), "refreshedAt") {
+		t.Errorf("零值的 refreshedAt 不该出现：%s", b)
+	}
+}
+
+// Collector 的 JSON 名字与页面一致：空着省略，none 照写（页面据此说
+// 「不支持自动采集」）。
+func TestCheckinProviderStateJSON(t *testing.T) {
+	b, err := json.Marshal(CheckinProviderState{ID: "kiro", Name: "Kiro", On: true, Collector: "none"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(b), `"collector":"none"`) {
+		t.Errorf("collector 没写进 JSON：%s", b)
+	}
+	b, err = json.Marshal(CheckinProviderState{ID: "kiro"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), "collector") {
+		t.Errorf("空着的 collector 不该出现：%s", b)
+	}
+}
diff --git a/internal/provider/credits_estimate.go b/internal/provider/credits_estimate.go
new file mode 100644
index 00000000..5d695abb
--- /dev/null
+++ b/internal/provider/credits_estimate.go
@@ -0,0 +1,63 @@
+package provider
+
+import (
+	"os"
+	"strings"
+	"time"
+)
+
+// CreditEstimates 是"今天大概到账了多少额度"的估计，按厂商聚合。
+//
+// 口径只有一条：用 credits-daily.json 里昨日与今日的用量差。用量回落
+// （今日 < 昨日）说明额度在今天补过，差额就是补进来的量；用量没回落就没有
+// 证据，那个厂商直接不出现——页面按"有则显示 ≈+N、无则不显示"来处理。
+//
+// 这不是账单，也不是承诺：它只是把已经落盘的两次读数摊开讲清楚。
+func CreditEstimates(now time.Time) map[string]float64 {
+	raw, err := os.ReadFile(creditsPath())
+	if err != nil {
+		return nil
+	}
+	accts, err := parseCredits(raw)
+	if err != nil || len(accts) == 0 {
+		return nil
+	}
+	return estimateRefills(accts, now)
+}
+
+// estimateRefills 是估算的纯逻辑部分：测试直接喂 accts，不碰磁盘。
+func estimateRefills(accts map[string]*creditsAccount, now time.Time) map[string]float64 {
+	today := now.Local().Format("2006-01-02")
+	yesterday := now.Local().AddDate(0, 0, -1).Format("2006-01-02")
+	out := map[string]float64{}
+	for key, acct := range accts {
+		if acct == nil || acct.Days == nil {
+			continue
+		}
+		usedToday, okToday := acct.Days[today]
+		usedBefore, okBefore := acct.Days[yesterday]
+		if !okToday || !okBefore {
+			continue
+		}
+		refill := usedBefore - usedToday
+		if refill <= 0 {
+			continue
+		}
+		if acct.Since != "" && acct.Since > yesterday {
+			// 只知道从 Since 起的用量：之前的"昨日"不是读数，是空白。
+			continue
+		}
+		providerID := key
+		if i := strings.Index(key, "|"); i > 0 {
+			providerID = key[:i]
+		}
+		if providerID == "" {
+			continue
+		}
+		out[providerID] += refill
+	}
+	if len(out) == 0 {
+		return nil
+	}
+	return out
+}
