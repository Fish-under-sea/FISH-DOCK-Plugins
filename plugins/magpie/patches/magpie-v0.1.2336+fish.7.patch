@@ -0,0 +1,138 @@
+package gui
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// 插件页的 magpie.call 是它唯一的出口（CSP connect-src 'none'）。这里钉住
+// 校验顺序与分派：没声明的名字一律拒，声明了的真的到得了执行处。
+
+func TestCallAllowedRefusesWhatThePackageDidNotDeclare(t *testing.T) {
+	if callAllowed(nil, "relay:view") {
+		t.Fatal("没有 magpie.calls 的插件被放过了")
+	}
+	if callAllowed([]string{"relay:view"}, "relay:start") {
+		t.Fatal("没声明的名字被放过了")
+	}
+	if callAllowed([]string{"relay:view"}, "") {
+		t.Fatal("空名字被放过了")
+	}
+	if !callAllowed([]string{"relay:view", "checkin:state"}, "checkin:state") {
+		t.Fatal("声明过的名字被拒了")
+	}
+}
+
+// spec 不是开着的插件页：请求被拒，且不透露有哪些插件。
+func TestPluginCallRouteRefusesUnknownSpec(t *testing.T) {
+	mux := http.NewServeMux()
+	pluginCallRoutes(mux)
+	body := `{"spec":"nope.plugin","name":"relay:view"}`
+	req := httptest.NewRequest(http.MethodPost, "/api/plugin-pages/call", strings.NewReader(body))
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, req)
+	if rec.Code == http.StatusOK {
+		t.Fatalf("未知插件被放过了: %d %s", rec.Code, rec.Body.String())
+	}
+	if strings.Contains(strings.ToLower(rec.Body.String()), "relay:view") {
+		t.Fatalf("响应泄漏了方法名: %s", rec.Body.String())
+	}
+}
+
+// 分派：relay:view 回配置与状态，Key 只有打码；checkin:state 回签到开关与厂商。
+func TestPluginCallDispatchesRelayAndCheckin(t *testing.T) {
+	value, err := pluginCall(context.Background(), "", "relay:view", nil)
+	if err != nil {
+		t.Fatalf("relay:view: %v", err)
+	}
+	view, ok := value.(map[string]any)
+	if !ok {
+		t.Fatalf("relay:view 返回 %T", value)
+	}
+	config, ok := view["config"].(map[string]any)
+	if !ok {
+		t.Fatal("relay:view 没有 config")
+	}
+	if _, ok := config["hasKey"]; !ok {
+		t.Fatal("relay:view 没有 hasKey")
+	}
+	encoded, _ := json.Marshal(view)
+	for key := range config {
+		if key == "apiKey" || key == "key" {
+			t.Fatal("relay:view 回显了 Key 字段")
+		}
+	}
+	if strings.Contains(string(encoded), "\"sealedKey\"") {
+		t.Fatal("relay:view 回显了密文 Key")
+	}
+
+	// checkin:state 回的是 provider.CheckinViewState 这个结构（插件页要的聚合
+	// 值：厂商、账号、今天的结果、积分），不是一层 map：页面按字段名读，宿主按
+	// 类型给，中间不再转换一次。
+	checkin, err := pluginCall(context.Background(), "", "checkin:state", nil)
+	if err != nil {
+		t.Fatalf("checkin:state: %v", err)
+	}
+	state, ok := checkin.(provider.CheckinViewState)
+	if !ok {
+		t.Fatalf("checkin:state 返回 %T", checkin)
+	}
+	encoded, err = json.Marshal(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, field := range []string{"providers", "accounts", "today"} {
+		if !strings.Contains(string(encoded), "\""+field+"\"") {
+			t.Fatalf("checkin:state 没有 %s: %s", field, encoded)
+		}
+	}
+}
+
+// 未知名字在分派处也拒绝（不只是 HTTP 层）。
+func TestPluginCallRefusesUnknownName(t *testing.T) {
+	if _, err := pluginCall(context.Background(), "", "relay:delete-everything", nil); err == nil {
+		t.Fatal("未知 relay 命令被接受了")
+	}
+	if _, err := pluginCall(context.Background(), "", "anything:else", nil); err == nil {
+		t.Fatal("未知命名空间被接受了")
+	}
+}
+
+// 签到开关分两层：厂商级是 settings.PluginCheckins，账号级是 settings.CheckinOff。
+// 账号级这条以前被这里拒成 ACCOUNT_LEVEL_UNSUPPORTED，可设置页一直有它
+// （/api/settings/checkin-account），插件页那个开关因此点不动。
+func TestPluginCallSetsAccountLevelCheckin(t *testing.T) {
+	t.Setenv("MAGPIE_CONFIG", t.TempDir())
+	if _, err := pluginCall(context.Background(), "", "checkin:set-account", map[string]any{"key": "workbuddy|u1", "on": false}); err != nil {
+		t.Fatalf("关掉账号: %v", err)
+	}
+	if !slices.Contains(settings.Load().CheckinOff, "workbuddy|u1") {
+		t.Fatal("关掉的账号没有记进 CheckinOff")
+	}
+	if _, err := pluginCall(context.Background(), "", "checkin:set-account", map[string]any{"key": "workbuddy|u1", "on": true}); err != nil {
+		t.Fatalf("重新打开: %v", err)
+	}
+	if slices.Contains(settings.Load().CheckinOff, "workbuddy|u1") {
+		t.Fatal("重新打开后仍留在 CheckinOff 里")
+	}
+}
+
+func TestPluginCallRefusesAccountLevelCheckinWithoutKey(t *testing.T) {
+	t.Setenv("MAGPIE_CONFIG", t.TempDir())
+	_, err := pluginCall(context.Background(), "", "checkin:set-account", map[string]any{"on": true})
+	if err == nil {
+		t.Fatal("缺少账号 key 被接受了")
+	}
+	coded, ok := err.(interface{ Code() string })
+	if !ok || coded.Code() != "NO_ACCOUNT" {
+		t.Fatalf("error = %v, want NO_ACCOUNT", err)
+	}
+}
