+// 出站规矩：请求头里只有声明的认证方式，且用户代理固定；不跟重定向。
+func TestClientSendsOnlyTheDeclaredHeaders(t *testing.T) {
+	upstream := nativeUpstream()
+	client := NewClient(baseConfig(), upstream)
+	client.Messages(context.Background(), map[string]any{"model": "m"})
+	seen := upstream.seen()
+	if len(seen) == 0 {
+		t.Fatal("没有发出请求")
+	}
+	header := seen[0].Header
+	if header.Get("user-agent") != userAgent {
+		t.Errorf("user-agent = %q", header.Get("user-agent"))
+	}
+	if header.Get("anthropic-version") != DefaultAPIVersion {
+		t.Errorf("anthropic-version = %q", header.Get("anthropic-version"))
+	}
+	if header.Get("x-api-key") == "" && header.Get("authorization") == "" {
+		t.Error("没有任何认证头")
+	}
+}
+
+func TestClientRefusesRedirects(t *testing.T) {
+	redirector := &http.Client{CheckRedirect: func(*http.Request, []*http.Request) error {
+		return http.ErrUseLastResponse
+	}}
+	if redirector.CheckRedirect == nil {
+		t.Fatal("没有装重定向策略")
+	}
+	// 真的走一次：服务端回 302，客户端必须原样带回 302 而不是跟过去。
+	upstream := &fakeUpstream{respond: func(recordedRequest) *http.Response {
+		return &http.Response{
+			StatusCode: 302,
+			Header:     http.Header{"Location": []string{"https://evil.example.com/v1/messages"}},
+			Body:       io.NopCloser(strings.NewReader("")),
+		}
+	}}
+	client := NewClient(baseConfig(), upstream)
+	result := client.Messages(context.Background(), map[string]any{"model": "m"})
+	if result.Status != 302 {
+		t.Fatalf("status = %d, want 302（没有跟随重定向）", result.Status)
+	}
+}
+
+// 响应超过 2 MiB 直接判失败，不读到内存里。
+func TestOversizedResponseIsRefused(t *testing.T) {
+	upstream := &fakeUpstream{respond: func(recordedRequest) *http.Response {
+		return &http.Response{
+			StatusCode: 200,
+			Header:     http.Header{},
+			Body:       io.NopCloser(bytes.NewReader(bytes.Repeat([]byte("a"), MaxResponseBytes+10))),
+		}
+	}}
+	client := NewClient(baseConfig(), upstream)
+	result := client.Messages(context.Background(), map[string]any{"model": "m"})
+	if result.OK {
+		t.Fatal("超大响应被判成功了")
+	}
+	if !strings.Contains(result.Message, "2 MiB") {
+		t.Fatalf("message = %q", result.Message)
+	}
+}
+
+// 报告上限：塞满细节的 B1 被压到 256 KiB 以内，结论必须还在。
+func TestReportIsCompressedUnderTheLimit(t *testing.T) {
+	b1 := map[string]any{
+		"id": "B1", "status": "tamper_accepted", "message": strings.Repeat("长", 400000),
+		"contentTypes": []any{strings.Repeat("x", 50000)},
+	}
+	report := Report{
+		Schema: 1, B1: b1,
+		C1:      map[string]any{"id": "C1", "status": "mismatch"},
+		C2:      map[string]any{"id": "C2", "status": "identical"},
+		Verdict: BuildVerdict(b1, map[string]any{"status": "mismatch"}, map[string]any{"status": "identical"}),
+	}
+	limited := limitReport(report)
+	encoded, _ := json.Marshal(limited)
+	if len(encoded) > MaxReportBytes {
+		t.Fatalf("报告 %d 字节, 上限 %d", len(encoded), MaxReportBytes)
+	}
+	if !limited.ReportTruncated {
+		t.Fatal("没有标记被压缩")
+	}
+	if limited.Verdict.Code == "" {
+		t.Fatal("结论被压掉了")
+	}
+}
+
+// 判定门槛不许放宽：只有 B1 的篡改信号、没有 C1 独立异常时，不能判"极大概率"。
+func TestVerdictNeedsBothB1AndC1ForLikelyForged(t *testing.T) {
+	b1 := map[string]any{"id": "B1", "status": "tamper_accepted"}
+	c1 := map[string]any{"id": "C1", "status": "match", "counted": 88, "used": 88, "diff": 0, "percent": 0}
+	c2 := map[string]any{"id": "C2", "status": "differ_expected", "primary": map[string]any{"count": 88}, "ratio": 1.2}
+	verdict := BuildVerdict(b1, c1, c2)
+	if verdict.Code == "likely_forged" {
+		t.Fatalf("只凭 B1 就判了 likely_forged: %+v", verdict)
+	}
+	if verdict.Code != "suspicious" {
+		t.Fatalf("verdict = %s, want suspicious", verdict.Code)
+	}
+}
+
+// "与原生一致"三项缺一不可。
+func TestVerdictNeedsAllThreeForNativeConsistent(t *testing.T) {
+	b1 := map[string]any{"id": "B1", "status": "native_signal"}
+	c1 := map[string]any{"id": "C1", "status": "near_match", "counted": 88, "used": 89, "diff": 1, "percent": 0.011}
+	c2 := map[string]any{"id": "C2", "status": "differ_expected"}
+	if got := BuildVerdict(b1, c1, c2).Code; got != "inconclusive" {
+		t.Fatalf("verdict = %s, want inconclusive", got)
+	}
+	c1["status"] = "match"
+	c2["status"] = "identical"
+	if got := BuildVerdict(b1, c1, c2).Code; got == "native_consistent" {
+		t.Fatal("C2 有明显伪造信号时仍判了 native_consistent")
+	}
+}
+
+func TestThinkingFamilyAndCandidates(t *testing.T) {
+	cases := map[string]string{
+		"claude-3-5-sonnet-20241022": "none",
+		"claude-3-7-sonnet-20250219": "enabled",
+		"claude-sonnet-4-5":          "enabled",
+		"claude-sonnet-4-6":          "adaptive",
+		"claude-sonnet-5-5":          "adaptive",
+		"some-other-model":           "unknown",
+	}
+	for model, want := range cases {
+		if got := thinkingFamily(model); got != want {
+			t.Errorf("%s => %s, want %s", model, got, want)
+		}
+	}
+	if got := thinkingCandidates("claude-3-5-sonnet-20241022"); len(got) != 1 || got[0] != nil {
+		t.Errorf("3.5 的候选 = %v, want [nil]", got)
+	}
+}
+
+// 同代 tokenizer 的计数相同是预期，不能算伪造证据。
+func TestTokenizerFamilyGroupsByGeneration(t *testing.T) {
+	if tokenizerFamily("claude-sonnet-4-6") == tokenizerFamily("claude-sonnet-5-5") {
+		t.Fatal("4.6 与 5.5 被当成了同代")
+	}
+	if tokenizerFamily("claude-sonnet-4-7") != tokenizerFamily("claude-opus-5-0") {
+		t.Fatal("4.7 与 5.x 应当同代")
+	}
+}
+
+// Key 的落盘与回显：密文不含明文，hint 只留头尾。
+func TestKeySealRoundTripAndHint(t *testing.T) {
+	hint := Hint("sk-live-SECRETVALUE123456")
+	if strings.Contains(hint, "SECRET") {
+		t.Fatalf("hint = %q，泄漏了中间字符", hint)
+	}
+	if Hint("short") != "••••" {
+		t.Fatal("太短的 Key 不该留任何字符")
+	}
+}
diff --git a/internal/relay/report.go b/internal/relay/report.go
new file mode 100644
index 0000000..391124a
--- /dev/null
+++ b/internal/relay/report.go
@@ -0,0 +1,110 @@
+package relay
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+)
+
+// Report 是一轮探测的全部结果。字段名与 Dock 插件的 probe.mjs 报告逐字
+// 相同，页面与本地存储都按这套读。
+type Report struct {
+	Schema         int            `json:"schema"`
+	GeneratedAt    time.Time      `json:"generatedAt"`
+	Target         Target         `json:"target"`
+	B1             map[string]any `json:"b1"`
+	C1             map[string]any `json:"c1"`
+	C2             map[string]any `json:"c2"`
+	Verdict        Verdict        `json:"verdict"`
+	ReportTruncated bool          `json:"reportTruncated,omitempty"`
+}
+
+// Target 是这次探测打的地址与参数（地址已脱敏，Key 从不出现）。
+type Target struct {
+	BaseURL         string `json:"baseUrl"`
+	Model           string `json:"model"`
+	ComparisonModel string `json:"comparisonModel"`
+	APIVersion      string `json:"apiVersion"`
+	AuthMode        string `json:"authMode"`
+}
+
+// skipped 表示这组探针没跑：B1 都没建立会话时，后面的对比没有意义。
+func skipped(id, reason string) map[string]any {
+	return map[string]any{"id": id, "status": "skipped", "reason": reason}
+}
+
+// Probe 跑一轮完整探测。doer 只给测试用，生产传 nil。
+func Probe(ctx context.Context, cfg Config, doer HTTPDoer, now time.Time) (Report, error) {
+	normalized, err := NormalizeConfig(cfg)
+	if err != nil {
+		return Report{}, err
+	}
+	client := NewClient(normalized, doer)
+	b1 := probeB1(ctx, client, normalized)
+	var c1, c2 map[string]any
+	switch statusOf(b1) {
+	case "unsupported_surface", "auth_error", "endpoint_not_found", "network_error", "aborted":
+		c1 = skipped("C1", "B1 未建立可用的 Anthropic 会话")
+		c2 = skipped("C2", "B1 未建立可用的 Anthropic 会话")
+	default:
+		c1 = probeC1(ctx, client, normalized)
+		c2 = probeC2(ctx, client, normalized)
+	}
+	report := Report{
+		Schema:      1,
+		GeneratedAt: now,
+		Target: Target{
+			BaseURL:         Redact(PublicBaseURL(normalized.BaseURL), normalized.APIKey),
+			Model:           normalized.Model,
+			ComparisonModel: normalized.ComparisonModel,
+			APIVersion:      client.Version(),
+			AuthMode:        client.AuthMode(),
+		},
+		B1:      b1,
+		C1:      c1,
+		C2:      c2,
+		Verdict: BuildVerdict(b1, c1, c2),
+	}
+	return limitReport(report), nil
+}
+
+// limitReport 把报告压进 MaxReportBytes：先丢可再生的细节（contentTypes、
+// 长消息），保住结论与三组 status。报告会被 view/status/存储各带一份，
+// 撑爆宿主通道连状态都读不到。
+func limitReport(report Report) Report {
+	encoded, err := json.Marshal(report)
+	if err == nil && len(encoded) <= MaxReportBytes {
+		return report
+	}
+	report.ReportTruncated = true
+	if b1 := report.B1; b1 != nil {
+		delete(b1, "contentTypes")
+		b1["truncated"] = true
+		if message, ok := b1["message"].(string); ok && len(message) > 600 {
+			b1["message"] = message[:600]
+		}
+		for _, key := range []string{"validReplay", "tamperedReplay"} {
+			replay, ok := b1[key].(map[string]any)
+			if !ok {
+				continue
+			}
+			if message, ok := replay["message"].(string); ok && len(message) > 200 {
+				replay["message"] = message[:200]
+			}
+		}
+	}
+	encoded, err = json.Marshal(report)
+	if err == nil && len(encoded) <= MaxReportBytes {
+		return report
+	}
+	// 还大就把三组探针的 message 也剪掉：结论与 score 必须留下。
+	for _, probe := range []map[string]any{report.B1, report.C1, report.C2} {
+		if message, ok := probe["message"].(string); ok && len(message) > 200 {
+			probe["message"] = message[:200]
+		}
+	}
+	for _, signal := range report.Verdict.Signals {
+		_ = signal
+	}
+	return report
+}
diff --git a/internal/relay/seal_other.go b/internal/relay/seal_other.go
new file mode 100644
index 0000000..88ae55e
--- /dev/null
+++ b/internal/relay/seal_other.go
@@ -0,0 +1,77 @@
+//go:build !windows
+
+package relay
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"errors"
+	"os"
+	"path/filepath"
+)
+
+// 非 Windows 没有 DPAPI：用一个本地密钥文件（0600）配 AES-GCM。它挡不住
+// 能读用户目录的人，但挡得住备份、日志、同步盘这类顺手泄漏。
+
+func localKey() ([]byte, error) {
+	path := filepath.Join(configDir(), "relay.key")
+	raw, err := os.ReadFile(path)
+	if err == nil && len(raw) == 32 {
+		return raw, nil
+	}
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	key := make([]byte, 32)
+	if _, err := rand.Read(key); err != nil {
+		return nil, err
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return nil, err
+	}
+	if err := os.WriteFile(path, key, 0o600); err != nil {
+		return nil, err
+	}
+	return key, nil
+}
+
+func sealSecret(plain []byte) ([]byte, error) {
+	key, err := localKey()
+	if err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+	nonce := make([]byte, aead.NonceSize())
+	if _, err := rand.Read(nonce); err != nil {
+		return nil, err
+	}
+	return aead.Seal(nonce, nonce, plain, nil), nil
+}
+
+func openSecret(sealed []byte) ([]byte, error) {
+	key, err := localKey()
+	if err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+	if len(sealed) < aead.NonceSize() {
+		return nil, errors.New("relay: 密文过短")
+	}
+	nonce, payload := sealed[:aead.NonceSize()], sealed[aead.NonceSize():]
+	return aead.Open(nil, nonce, payload, nil)
+}
diff --git a/internal/relay/seal_windows.go b/internal/relay/seal_windows.go
new file mode 100644
index 0000000..612e706
--- /dev/null
+++ b/internal/relay/seal_windows.go
@@ -0,0 +1,84 @@
+//go:build windows
+
+package relay
+
+import (
+	"errors"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Windows 上用 DPAPI：密文只能由同一个 Windows 用户解开。中转站的 Key 值得
+// 这一层——它一旦被复制走，就是把用户的钱包复制走。
+
+var (
+	crypt32            = windows.NewLazySystemDLL("crypt32.dll")
+	procCryptProtect   = crypt32.NewProc("CryptProtectData")
+	procCryptUnprotect = crypt32.NewProc("CryptUnprotectData")
+)
+
+// dataBlob 是 CRYPTOAPI_BLOB。
+type dataBlob struct {
+	size uint32
+	data *byte
+}
+
+func newBlob(payload []byte) (*dataBlob, *byte) {
+	if len(payload) == 0 {
+		return &dataBlob{}, nil
+	}
+	buffer := make([]byte, len(payload))
+	copy(buffer, payload)
+	return &dataBlob{size: uint32(len(buffer)), data: &buffer[0]}, &buffer[0]
+}
+
+func (b *dataBlob) bytes() []byte {
+	if b.data == nil || b.size == 0 {
+		return nil
+	}
+	out := make([]byte, b.size)
+	copy(out, unsafe.Slice(b.data, b.size))
+	return out
+}
+
+// sealSecret 用当前用户的 DPAPI 加密。
+func sealSecret(plain []byte) ([]byte, error) {
+	in, _ := newBlob(plain)
+	var out dataBlob
+	ok, _, err := procCryptProtect.Call(
+		uintptr(unsafe.Pointer(in)),
+		0, // description
+		0, // entropy
+		0, // reserved
+		0, // prompt
+		0, // flags: 当前用户
+		uintptr(unsafe.Pointer(&out)),
+	)
+	if ok == 0 {
+		return nil, err
+	}
+	defer windows.LocalFree(windows.Handle(unsafe.Pointer(out.data)))
+	return out.bytes(), nil
+}
+
+// openSecret 用当前用户的 DPAPI 解密。换用户、换机器都会失败——那时应当
+// 报错让用户重新填 Key，而不是悄悄用旧的。
+func openSecret(sealed []byte) ([]byte, error) {
+	in, _ := newBlob(sealed)
+	var out dataBlob
+	ok, _, err := procCryptUnprotect.Call(
+		uintptr(unsafe.Pointer(in)),
+		0, 0, 0, 0, 0,
+		uintptr(unsafe.Pointer(&out)),
+	)
+	if ok == 0 {
+		return nil, err
+	}
+	defer windows.LocalFree(windows.Handle(unsafe.Pointer(out.data)))
+	plain := out.bytes()
+	if plain == nil {
+		return nil, errors.New("relay: 解出的 Key 为空")
+	}
+	return plain, nil
+}
diff --git a/internal/relay/store.go b/internal/relay/store.go
new file mode 100644
index 0000000..6c2709a
--- /dev/null
+++ b/internal/relay/store.go
@@ -0,0 +1,126 @@
+package relay
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// Stored 是落盘的配置。Key 本身只以密文出现（sealedKey），回显用 keyHint：
+// 页面、日志、备份拿到的永远不是明文。
+type Stored struct {
+	BaseURL         string    `json:"baseUrl"`
+	Model           string    `json:"model"`
+	ComparisonModel string    `json:"comparisonModel"`
+	AuthMode        string    `json:"authMode"`
+	APIVersion      string    `json:"apiVersion"`
+	TimeoutMs       int       `json:"timeoutMs"`
+	SealedKey       string    `json:"sealedKey,omitempty"`
+	KeyHint         string    `json:"keyHint,omitempty"`
+	UpdatedAt       time.Time `json:"updatedAt,omitempty"`
+}
+
+// Path 是 relay 配置的位置：与 providers.json 同一个配置目录。
+func Path() string { return filepath.Join(configDir(), "relay.json") }
+
+// Load 读配置；不存在时给一份空配置（不是错误：第一次打开页面就该看到表单）。
+func Load(path string) (Stored, error) {
+	raw, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return Stored{AuthMode: "auto", Model: DefaultModel, ComparisonModel: ComparisonModel, APIVersion: DefaultAPIVersion, TimeoutMs: int(DefaultTimeout / time.Millisecond)}, nil
+	}
+	if err != nil {
+		return Stored{}, err
+	}
+	var stored Stored
+	if err := json.Unmarshal(raw, &stored); err != nil {
+		return Stored{}, err
+	}
+	if stored.AuthMode == "" {
+		stored.AuthMode = "auto"
+	}
+	return stored, nil
+}
+
+// Save 写配置：先写临时文件、fsync、再 rename，掉电不会留下半个 JSON。
+// 目录和文件都是 0600，因为里面即使只有密文，也不该让别人读到 hint。
+func Save(path string, stored Stored) error {
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return err
+	}
+	stored.UpdatedAt = time.Now()
+	encoded, err := json.MarshalIndent(stored, "", "  ")
+	if err != nil {
+		return err
+	}
+	temporary := path + ".tmp"
+	handle, err := os.OpenFile(temporary, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0o600)
+	if err != nil {
+		return err
+	}
+	if _, err := handle.Write(append(encoded, '\n')); err != nil {
+		handle.Close()
+		return err
+	}
+	if err := handle.Sync(); err != nil {
+		handle.Close()
+		return err
+	}
+	if err := handle.Close(); err != nil {
+		return err
+	}
+	return os.Rename(temporary, path)
+}
+
+// SealKey 把明文 Key 加密成可以落盘的字符串（Windows 是 DPAPI，按当前用户）。
+func SealKey(plain string) (string, error) {
+	if plain == "" {
+		return "", nil
+	}
+	sealed, err := sealSecret([]byte(plain))
+	if err != nil {
+		return "", err
+	}
+	return base64.StdEncoding.EncodeToString(sealed), nil
+}
+
+// OpenKey 解回明文 Key；密文损坏或被换用户读时返回错误，绝不猜。
+func OpenKey(encoded string) (string, error) {
+	if strings.TrimSpace(encoded) == "" {
+		return "", nil
+	}
+	raw, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return "", err
+	}
+	plain, err := openSecret(raw)
+	if err != nil {
+		return "", err
+	}
+	return string(plain), nil
+}
+
+// Hint 是 Key 的回显：只留头尾各 4 个字符。太短的 Key 一个字符都不留。
+func Hint(key string) string {
+	key = strings.TrimSpace(key)
+	if len(key) < 12 {
+		return "••••"
+	}
+	return key[:4] + "…" + key[len(key)-4:]
+}
+
+// Masked 是页面上显示的 Key 状态，永远不含明文。
+func Masked(stored Stored) string {
+	if stored.SealedKey == "" {
+		return ""
+	}
+	if stored.KeyHint == "" {
+		return "••••"
+	}
+	return stored.KeyHint
+}
diff --git a/internal/relay/verdict.go b/internal/relay/verdict.go
new file mode 100644
index 0000000..3b884bc
--- /dev/null
+++ b/internal/relay/verdict.go
@@ -0,0 +1,183 @@
+package relay
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Signal 是一条证据：哪组探针、支持伪造还是支持原生、权重、给人看的话。
+type Signal struct {
+	ID     string  `json:"id"`
+	Kind   string  `json:"kind"` // forged / native / info
+	Weight float64 `json:"weight"`
+	Detail string  `json:"detail"`
+}
+
+// Verdict 是最后那句话。门槛与 Dock 插件逐字相同，一条都没有放宽：
+//
+//   - "极大概率伪造"要求 B1 强伪造信号（篡改签名仍被接受）加 C1 独立强异常，
+//     并且 forgedScore 至少比 nativeScore 高 2；
+//   - "与原生一致"要求 B1 验签通过、C1 精确一致、C2 符合预期，三项缺一不可；
+//   - 其余一律"证据不足"，因为单个信号可以被高质量中转层伪造。
+type Verdict struct {
+	Code        string   `json:"code"`
+	Label       string   `json:"label"`
+	Confidence  string   `json:"confidence"`
+	ForgedScore float64  `json:"forgedScore"`
+	NativeScore float64  `json:"nativeScore"`
+	Signals     []Signal `json:"signals"`
+	Caveat      string   `json:"caveat"`
+}
+
+const verdictCaveat = "行为指纹不是身份证明；高质量中转层可以伪造单个信号，结论应结合多项证据。"
+
+// BuildVerdict 把三组探针的结果折成一句结论。
+func BuildVerdict(b1, c1, c2 map[string]any) Verdict {
+	signals := make([]Signal, 0, 8)
+	add := func(id, kind string, weight float64, detail string) {
+		signals = append(signals, Signal{ID: id, Kind: kind, Weight: weight, Detail: detail})
+	}
+	b1Status := statusOf(b1)
+	c1Status := statusOf(c1)
+	c2Status := statusOf(c2)
+	b1Message := messageOf(b1)
+
+	switch b1Status {
+	case "tamper_accepted":
+		add("B1", "forged", 4, "篡改 thinking 签名后仍返回成功")
+	case "signature_missing", "signature_short":
+		detail := b1Message
+		if detail == "" {
+			detail = "thinking 签名不可用"
+		}
+		add("B1", "forged", 2, detail)
+	case "no_thinking":
+		// adaptive thinking 可能选择不思考，不能把"没有块"本身当成伪造证据。
+		add("B1", "info", 0, nonEmpty(b1Message, "响应没有 thinking 块，无法验签"))
+	case "block_dropped":
+		add("B1", "info", 0, nonEmpty(b1Message, "thinking 块疑似被中转层丢弃，无法验签"))
+	case "thinking_unsupported":
+		add("B1", "info", 0, nonEmpty(b1Message, "目标拒绝 thinking 配置，无法验签"))
+	case "native_signal":
+		add("B1", "native", 4, "有效签名重放成功，篡改签名被拒绝")
+	}
+
+	switch c1Status {
+	case "mismatch":
+		add("C1", "forged", 3, fmt.Sprintf("count_tokens=%s，usage.input_tokens=%s，差 %s（%s%%）",
+			formatNumber(c1["counted"]), formatNumber(c1["used"]), formatNumber(c1["diff"]), percentOf(c1)))
+	case "match":
+		add("C1", "native", 1, "count_tokens 与 usage.input_tokens 一致（"+formatNumber(c1["counted"])+"）")
+	}
+
+	switch c2Status {
+	case "identical":
+		add("C2", "forged", 2, "两个不同代模型的 token 计数完全相同（"+formatNumber(primaryCount(c2))+"）")
+	case "near_identical":
+		add("C2", "forged", 1, "两个不同代模型的 token 计数仅差 "+ratioPercent(c2))
+	case "same_tokenizer":
+		add("C2", "info", 0, "两个模型属于同代 tokenizer，计数相同是预期行为（"+formatNumber(primaryCount(c2))+"）")
+	case "identical_unknown", "near_identical_unknown":
+		add("C2", "info", 0, "模型世代未知，计数相同不足以作为伪造证据")
+	}
+
+	var forgedScore, nativeScore float64
+	forgedCount := 0
+	for _, signal := range signals {
+		switch signal.Kind {
+		case "forged":
+			forgedScore += signal.Weight
+			forgedCount++
+		case "native":
+			nativeScore += signal.Weight
+		}
+	}
+
+	verdict := func(code, label, confidence string) Verdict {
+		return Verdict{
+			Code: code, Label: label, Confidence: confidence,
+			ForgedScore: forgedScore, NativeScore: nativeScore,
+			Signals: signals, Caveat: verdictCaveat,
+		}
+	}
+
+	switch b1Status {
+	case "auth_error":
+		return verdict("auth_error", "检测失败：认证被拒绝", "low")
+	case "endpoint_not_found":
+		return verdict("endpoint_not_found", "检测失败：接口路径或模型不存在", "low")
+	case "network_error", "aborted":
+		return verdict("network_error", "检测失败：网络不可达或已中止", "low")
+	case "unsupported_surface":
+		return verdict("unsupported_surface", "无法检测：目标不是 Anthropic Messages API", "low")
+	}
+
+	if b1Status == "tamper_accepted" && c1Status == "mismatch" &&
+		forgedScore >= 7 && forgedCount >= 2 && forgedScore >= nativeScore+2 {
+		confidence := "medium"
+		if forgedScore >= 9 {
+			confidence = "high"
+		}
+		return verdict("likely_forged", "该中转站极大概率伪造了模型", confidence)
+	}
+	if forgedScore >= 3 && forgedScore > nativeScore {
+		return verdict("suspicious", "该中转站疑似非原生或翻译层，但是否伪造模型证据不足", "medium")
+	}
+	if b1Status == "native_signal" && c1Status == "match" &&
+		(c2Status == "differ_expected" || c2Status == "same_tokenizer" || c2Status == "skipped") &&
+		forgedScore == 0 {
+		return verdict("native_consistent", "未发现伪造证据：行为与原生 Claude 一致", "medium")
+	}
+	return verdict("inconclusive", "证据不足，无法判断", "low")
+}
+
+func statusOf(probe map[string]any) string {
+	if probe == nil {
+		return ""
+	}
+	status, _ := probe["status"].(string)
+	return status
+}
+
+func messageOf(probe map[string]any) string {
+	if probe == nil {
+		return ""
+	}
+	message, _ := probe["message"].(string)
+	return message
+}
+
+func nonEmpty(value, fallback string) string {
+	if strings.TrimSpace(value) == "" {
+		return fallback
+	}
+	return value
+}
+
+func primaryCount(c2 map[string]any) any {
+	primary, ok := c2["primary"].(map[string]any)
+	if !ok {
+		return nil
+	}
+	return primary["count"]
+}
+
+func percentOf(c1 map[string]any) string {
+	ratio := numberOrNil(c1["percent"])
+	if ratio == nil {
+		return "0.0"
+	}
+	return fmt.Sprintf("%.1f", *ratio*100)
+}
+
+func ratioPercent(c2 map[string]any) string {
+	ratio := numberOrNil(c2["ratio"])
+	if ratio == nil {
+		return "0.0%"
+	}
+	delta := *ratio - 1
+	if delta < 0 {
+		delta = -delta
+	}
+	return fmt.Sprintf("%.1f%%", delta*100)
+}
