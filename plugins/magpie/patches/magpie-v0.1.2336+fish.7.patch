@@ -0,0 +1,61 @@
+package provider
+
+import "testing"
+
+// 讯飞的签到口径（维护者 2026-10-31 定）：**每个账号都签**，每个账号一次按 400
+// 积分记。别把它做成「只签一个号」——账号列表与签到都要全量，只有积分是固定值。
+func TestLoomyCheckinKeepsEveryAccount(t *testing.T) {
+	accounts := []pluginCheckinAcct{
+		{User: "131****0162", On: true, key: pluginCheckinKey("loomy", "a")},
+		{User: "180****4126", On: true, key: pluginCheckinKey("loomy", "b")},
+		{User: "185****7424", On: true, key: pluginCheckinKey("loomy", "c")},
+		{User: "185****8924", On: true, key: pluginCheckinKey("loomy", "d")},
+	}
+	p := pluginCheckinProvider{ID: "loomy", accounts: accounts}
+	if got := len(p.accounts); got != len(accounts) {
+		t.Fatalf("账号一个都不许裁，实际剩 %d 个", got)
+	}
+	// 签到页读的是 checkiner 的 accounts：也必须全量，用户要看得见自己登了几个号。
+	listed := p.checkiner(nil).accounts()
+	if len(listed) != len(accounts) {
+		t.Fatalf("签到页应列出全部 %d 个账号，实际 %d 个", len(accounts), len(listed))
+	}
+	for i, a := range listed {
+		if a.User != accounts[i].User {
+			t.Fatalf("第 %d 个账号错了：%s != %s", i, a.User, accounts[i].User)
+		}
+	}
+}
+
+func TestLoomyCheckinCreditIsFixedAt400(t *testing.T) {
+	for _, id := range []string{"loomy", "loomy-plugin"} {
+		for _, said := range []float64{0, -1} {
+			if got := loomyCredit(id, said); got != loomyCheckinCredit {
+				t.Fatalf("%s: 插件报 %v 时应记 %d，实际 %v", id, said, loomyCheckinCredit, got)
+			}
+		}
+		// 插件自己报了正数就用插件的。
+		if got := loomyCredit(id, 250); got != 250 {
+			t.Fatalf("%s: 插件报了 250 就该是 250，实际 %v", id, got)
+		}
+	}
+	// 别的厂商不动：没报就是 0，不能凭白加 400。
+	for _, id := range []string{"qoder", "zcode", "autoclaw"} {
+		if got := loomyCredit(id, 0); got != 0 {
+			t.Fatalf("%s: 不该补积分，实际 %v", id, got)
+		}
+	}
+}
+
+func TestLoomyCheckinIDMatching(t *testing.T) {
+	for _, id := range []string{"loomy", "loomy-plugin"} {
+		if !loomyCheckin(id) {
+			t.Fatalf("%s 应被认成讯飞", id)
+		}
+	}
+	for _, id := range []string{"qoder", "zcode", "autoclaw", "workbuddy", "loom"} {
+		if loomyCheckin(id) {
+			t.Fatalf("%s 不该被认成讯飞", id)
+		}
+	}
+}
