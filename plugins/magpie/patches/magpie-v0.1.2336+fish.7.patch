+package relay
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// 这些测试全部用合成的 HTTP 响应：一个字节都不发出去。中转站的真伪检测
+// 本身就是"对不可信响应做判断"，用合成响应测判定门槛，正是要测的东西。
+
+// fakeUpstream 按请求体决定回什么，记录收到的请求，供断言出站规矩。
+type fakeUpstream struct {
+	mu       sync.Mutex
+	requests []recordedRequest
+	respond  func(recordedRequest) *http.Response
+}
+
+type recordedRequest struct {
+	URL    string
+	Header http.Header
+	Body   map[string]any
+}
+
+func (f *fakeUpstream) Do(req *http.Request) (*http.Response, error) {
+	body, _ := io.ReadAll(req.Body)
+	parsed := map[string]any{}
+	if len(body) > 0 {
+		_ = json.Unmarshal(body, &parsed)
+	}
+	record := recordedRequest{URL: req.URL.String(), Header: req.Header.Clone(), Body: parsed}
+	f.mu.Lock()
+	f.requests = append(f.requests, record)
+	f.mu.Unlock()
+	return f.respond(record), nil
+}
+
+func (f *fakeUpstream) seen() []recordedRequest {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]recordedRequest{}, f.requests...)
+}
+
+// jsonResponse 造一个状态码 + JSON 体的响应。
+func jsonResponse(status int, body any) *http.Response {
+	encoded, _ := json.Marshal(body)
+	return &http.Response{
+		StatusCode: status,
+		Header:     http.Header{"Content-Type": []string{"application/json"}},
+		Body:       io.NopCloser(bytes.NewReader(encoded)),
+	}
+}
+
+// claudeAnswer 是一条"原生"的 Messages 回答：带一个 thinking 块与签名。
+func claudeAnswer(signature string) map[string]any {
+	return map[string]any{
+		"type": "message",
+		"role": "assistant",
+		"content": []any{
+			map[string]any{"type": "thinking", "thinking": "…", "signature": signature},
+			map[string]any{"type": "text", "text": "FINAL=0.05"},
+		},
+		"usage": map[string]any{"input_tokens": 120, "output_tokens": 40},
+	}
+}
+
+// nativeUpstreamResponder 是"原生"上游的行为：篡改签名会被拒，count_tokens
+// 与生成时的 usage 一致。
+func nativeUpstreamResponder(req recordedRequest) *http.Response {
+	if strings.HasSuffix(req.URL, "/count_tokens") {
+		return jsonResponse(200, map[string]any{"input_tokens": 88})
+	}
+	messages, _ := req.Body["messages"].([]any)
+	last := ""
+	if len(messages) > 0 {
+		if row, ok := messages[len(messages)-1].(map[string]any); ok {
+			last, _ = row["content"].(string)
+		}
+	}
+	if strings.Contains(last, "Repeat the final line") {
+		// 重放：看 assistant 块里的签名是不是原样
+		if len(messages) < 2 {
+			return jsonResponse(200, claudeAnswer("sig-ctrl"))
+		}
+		assistant, _ := messages[1].(map[string]any)
+		blocks, _ := assistant["content"].([]any)
+		if len(blocks) == 0 {
+			return jsonResponse(200, claudeAnswer("sig-ctrl"))
+		}
+		block, _ := blocks[0].(map[string]any)
+		signature, _ := block["signature"].(string)
+		if signature != "abcdefghijklmnopqrstuvwxyz012345" {
+			return jsonResponse(400, map[string]any{"error": map[string]string{"message": "thinking block signature is invalid"}})
+		}
+		return jsonResponse(200, claudeAnswer(signature))
+	}
+	if len(messages) == 1 && strings.TrimSpace(last) == TokenText {
+		return jsonResponse(200, map[string]any{
+			"type": "message", "content": []any{map[string]any{"type": "text", "text": "OK"}},
+			"usage": map[string]any{"input_tokens": 88},
+		})
+	}
+	return jsonResponse(200, claudeAnswer("abcdefghijklmnopqrstuvwxyz012345"))
+}
+
+// nativeUpstream 行为完全原生。
+func nativeUpstream() *fakeUpstream {
+	return &fakeUpstream{respond: nativeUpstreamResponder}
+}
+
+func baseConfig() Config {
+	return Config{
+		BaseURL:         "https://relay.example.com",
+		APIKey:          "sk-live-SECRETVALUE123456",
+		Model:           "claude-sonnet-5-5",
+		ComparisonModel: "claude-sonnet-4-6",
+		AuthMode:        "auto",
+		APIVersion:      DefaultAPIVersion,
+		Timeout:         5 * time.Second,
+	}
+}
+
+func TestNormalizeBaseURLRefusesWhatTheRulesRefuse(t *testing.T) {
+	cases := []struct {
+		name string
+		in   string
+		code string
+	}{
+		{"内嵌凭据", "https://user:pass@relay.example.com", "BASE_URL_CREDENTIALS"},
+		{"查询串", "https://relay.example.com/api?key=1", "BASE_URL_QUERY"},
+		{"片段", "https://relay.example.com/api#x", "BASE_URL_HASH"},
+		{"非回环 http", "http://relay.example.com", "BASE_URL_INSECURE"},
+		{"别的协议", "ftp://relay.example.com", "BASE_URL_SCHEME"},
+		{"空", "   ", "BASE_URL_REQUIRED"},
+		{"不是 URL", "://nope", "BASE_URL_INVALID"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			_, err := NormalizeBaseURL(c.in)
+			if err == nil {
+				t.Fatalf("%q 被接受了", c.in)
+			}
+			typed, ok := err.(*Error)
+			if !ok || typed.Code != c.code {
+				t.Fatalf("error = %v, want code %s", err, c.code)
+			}
+		})
+	}
+}
