diff --git a/internal/gui/brand_call_test.go b/internal/gui/brand_call_test.go
new file mode 100644
index 0000000..44dc72e
--- /dev/null
+++ b/internal/gui/brand_call_test.go
@@ -0,0 +1,89 @@
+package gui
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// 「预装插件美化」那两颗按钮走的就是 magpie.call：页面在 CSP 沙箱里发不出
+// 请求，开关只能由宿主翻。这里钉住它翻得动、状态读得回来、参数不对时明确报错，
+// 以及没有在 package.json 里声明的名字仍然被拒。
+func TestBrandCallTogglesAndReports(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", home+"/.config")
+	t.Setenv("XDG_CACHE_HOME", home+"/.cache")
+	t.Cleanup(func() { _ = provider.SetBrand(false) })
+
+	// 起点是关的：插件装上一个开关，默认值由插件页给（打开），宿主本身不假设
+	value, err := pluginCall(context.Background(), "", "brand:status", nil)
+	if err != nil {
+		t.Fatalf("brand:status: %v", err)
+	}
+	state, ok := value.(map[string]any)
+	if !ok {
+		t.Fatalf("brand:status 返回 %T", value)
+	}
+	if on, _ := state["on"].(bool); on {
+		t.Fatal("新目录里就是开着的")
+	}
+	if n, _ := state["count"].(int); n == 0 {
+		t.Fatal("brand:status 没报覆盖了几家")
+	}
+	vendors, _ := state["vendors"].([]string)
+	if len(vendors) == 0 || vendors[0] != "autoclaw" {
+		t.Fatalf("vendors = %v", vendors)
+	}
+
+	// 打开：返回的就是新状态，页面不必再问一次
+	value, err = pluginCall(context.Background(), "", "brand:set", map[string]any{"on": true})
+	if err != nil {
+		t.Fatalf("brand:set on: %v", err)
+	}
+	state, _ = value.(map[string]any)
+	if on, _ := state["on"].(bool); !on {
+		t.Fatal("brand:set on 之后还是关着")
+	}
+	if !provider.BrandOn() {
+		t.Fatal("宿主侧并没有真的打开")
+	}
+
+	// 关掉：同样立刻反映
+	if _, err := pluginCall(context.Background(), "", "brand:set", map[string]any{"on": false}); err != nil {
+		t.Fatalf("brand:set off: %v", err)
+	}
+	if provider.BrandOn() {
+		t.Fatal("宿主侧并没有真的关掉")
+	}
+}
+
+// 参数不对要说清楚，不能当成「关掉」——那样用户点一下就把美化关了还不知道。
+func TestBrandSetWantsABoolean(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", home+"/.config")
+	t.Cleanup(func() { _ = provider.SetBrand(false) })
+
+	_, err := pluginCall(context.Background(), "", "brand:set", map[string]any{"on": "yes"})
+	if err == nil {
+		t.Fatal("字符串被当成布尔值了")
+	}
+	if !strings.Contains(err.Error(), "on") {
+		t.Errorf("错误没说清是哪一项：%v", err)
+	}
+	if provider.BrandOn() {
+		t.Error("失败的一次调用把美化打开了")
+	}
+}
+
+// 不认识的 brand: 名字一律拒：分派表就是白名单。
+func TestBrandCallRefusesUnknownName(t *testing.T) {
+	if _, err := pluginCall(context.Background(), "", "brand:delete-everything", nil); err == nil {
+		t.Fatal("不认识的名字被放过了")
+	}
+}
\ No newline at end of file
diff --git a/internal/gui/checkin_call_targets_test.go b/internal/gui/checkin_call_targets_test.go
new file mode 100644
index 0000000..7b5a089
--- /dev/null
+++ b/internal/gui/checkin_call_targets_test.go
@@ -0,0 +1,65 @@
+package gui
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// 页面顶部的「立即签到」不带 provider（issue #9）。以前 checkinRun 把空的
+// provider 判成「缺少厂商 id」，那颗按钮点下去只有一条报错；现在空 = 每家。
+func TestCheckinTargetsTreatsNoProviderAsEveryVendor(t *testing.T) {
+	cases := []struct {
+		name   string
+		params map[string]any
+		want   []string
+	}{
+		{"no params at all", nil, nil},
+		{"empty params", map[string]any{}, nil},
+		{"provider left blank", map[string]any{"provider": "   "}, nil},
+		{"provider not a string", map[string]any{"provider": 3}, nil},
+		{"one vendor", map[string]any{"provider": "codearts"}, []string{"codearts"}},
+		{"one vendor, padded", map[string]any{"provider": " codearts "}, []string{"codearts"}},
+	}
+	for _, c := range cases {
+		if got := checkinTargets(c.params); !slices.Equal(got, c.want) {
+			t.Errorf("%s: checkinTargets = %q, want %q", c.name, got, c.want)
+		}
+	}
+}
+
+// 刷新额度以前和签到走同一个分支，「刷新今日积分」于是又签了一次到。现在它
+// 只重读页面上的厂商，页面点的时候不带 provider 就是每家都读。
+func TestCheckinRefreshTargetsReadsEveryShownVendor(t *testing.T) {
+	shown := []provider.CheckinProviderState{
+		{ID: "codearts", Name: "CodeArts"},
+		{ID: "raccoon", Name: "商汤小浣熊"},
+		{ID: "  ", Name: "空 id 不该带出去"},
+	}
+	cases := []struct {
+		name   string
+		params map[string]any
+		want   []string
+	}{
+		{"page names none", map[string]any{}, []string{"codearts", "raccoon"}},
+		{"page names one", map[string]any{"provider": "raccoon"}, []string{"raccoon"}},
+	}
+	for _, c := range cases {
+		if got := checkinRefreshTargets(shown, c.params); !slices.Equal(got, c.want) {
+			t.Errorf("%s: checkinRefreshTargets = %q, want %q", c.name, got, c.want)
+		}
+	}
+	if got := checkinRefreshTargets(nil, map[string]any{}); len(got) != 0 {
+		t.Errorf("nothing shown should read nothing, got %q", got)
+	}
+}
+
+// 两个动词各走各的：签到回签到记录，刷新回整页状态。它们曾经共用一个分支。
+func TestCheckinCallsKeepRunAndRefreshApart(t *testing.T) {
+	if got, err := checkinCall(t.Context(), "checkin:state", nil); err != nil {
+		t.Fatalf("checkin:state: %v", err)
+	} else if _, ok := got.(provider.CheckinViewState); !ok {
+		t.Errorf("checkin:state = %T, want provider.CheckinViewState", got)
+	}
+}
diff --git a/internal/gui/checkin_state_read_test.go b/internal/gui/checkin_state_read_test.go
new file mode 100644
index 0000000..2624f1a
--- /dev/null
+++ b/internal/gui/checkin_state_read_test.go
@@ -0,0 +1,41 @@
+package gui
+
+import (
+	"encoding/json"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/yetone/magpie/internal/plugin"
+)
+
+// checkin:state 是插件页「自动签到」的读：它必须在 PageReads 里，且 pageRead
+// 能给出页面要的几栏，而不是被当成未知的读拒掉。
+func TestCheckinStateIsADeclaredRead(t *testing.T) {
+	if !slices.Contains(plugin.PageReads, "checkin:state") {
+		t.Fatal("plugin.PageReads has no checkin:state")
+	}
+	h := t.TempDir()
+	t.Setenv("HOME", h)
+	t.Setenv("USERPROFILE", h)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(h, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(h, ".cache"))
+	t.Setenv("XDG_DATA_HOME", filepath.Join(h, ".local", "share"))
+	v, err := pageRead("checkin:state", nil)
+	if err != nil {
+		t.Fatalf("pageRead(checkin:state): %v", err)
+	}
+	b, err := json.Marshal(v)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	var m map[string]any
+	if err := json.Unmarshal(b, &m); err != nil {
+		t.Fatalf("checkin:state is not a JSON object: %s", b)
+	}
+	for _, k := range []string{"providers", "accounts", "today"} {
+		if _, ok := m[k]; !ok {
+			t.Errorf("checkin:state has no %q: %s", k, b)
+		}
+	}
+}
