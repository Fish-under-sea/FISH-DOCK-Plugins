 		return ic
 	}
diff --git a/internal/relay/client.go b/internal/relay/client.go
new file mode 100644
index 0000000..9458c27
--- /dev/null
+++ b/internal/relay/client.go
@@ -0,0 +1,278 @@
+package relay
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// Result 是一次上游调用被摊平后的样子：页面与判定只看这些字段，不再看
+// *http.Response。
+type Result struct {
+	OK        bool
+	Status    int
+	JSON      map[string]any
+	Message   string
+	RequestID string
+	// Kind 只在请求层面失败时填：network 表示连不上/超时，aborted 表示
+	// 用户主动停止。
+	Kind string
+}
+
+// Client 发探测请求。测试把它换成一个只会回合成响应的实现。
+type Client struct {
+	cfg      Config
+	doer     HTTPDoer
+	messages string
+	counts   string
+
+	preferred  string
+	version    string
+	versionStopped bool
+}
+
+// HTTPDoer 是 *http.Client 的最小交集。
+type HTTPDoer interface {
+	Do(req *http.Request) (*http.Response, error)
+}
+
+// NewClient 造一个探测客户端。doer 为 nil 时用默认的 http.Client：
+// 它拒绝任何重定向（中转站把 /v1/messages 302 到别处就是行为异常，
+// 跟着走等于把 Key 交出去）。
+func NewClient(cfg Config, doer HTTPDoer) *Client {
+	if doer == nil {
+		doer = &http.Client{
+			Timeout: cfg.Timeout,
+			CheckRedirect: func(*http.Request, []*http.Request) error {
+				return http.ErrUseLastResponse
+			},
+			Transport: defaultTransport(),
+		}
+	}
+	preferred := cfg.AuthMode
+	if preferred == "auto" {
+		preferred = "x-api-key"
+	}
+	messages, counts := endpoints(cfg.BaseURL)
+	return &Client{
+		cfg:        cfg,
+		doer:       doer,
+		messages:   messages,
+		counts:     counts,
+		preferred:  preferred,
+		version:    cfg.APIVersion,
+	}
+}
+
+// Version 是这一轮最终采用的 anthropic-version。
+func (c *Client) Version() string { return c.version }
+
+// AuthMode 是这一轮最终跑通的认证方式。
+func (c *Client) AuthMode() string { return c.preferred }
+
+func headersFor(mode, key, version string) map[string]string {
+	headers := map[string]string{
+		"content-type":      "application/json",
+		"accept":            "application/json",
+		"anthropic-version": version,
+		"user-agent":        userAgent,
+	}
+	if mode == "x-api-key" || mode == "both" {
+		headers["x-api-key"] = key
+	}
+	if mode == "bearer" || mode == "both" {
+		headers["authorization"] = "Bearer " + key
+	}
+	return headers
+}
+
+// Send 发一次请求，并在 401/403 时按 auto 模式换一种认证头重试。
+func (c *Client) Send(ctx context.Context, url string, body any, timeout time.Duration) Result {
+	modes := []string{c.cfg.AuthMode}
+	if c.cfg.AuthMode == "auto" {
+		other := "bearer"
+		if c.preferred == "bearer" {
+			other = "x-api-key"
+		}
+		modes = []string{c.preferred}
+		if other != c.preferred {
+			modes = append(modes, other)
+		}
+	}
+	var last *Result
+	for index, mode := range modes {
+		result := c.roundTrip(ctx, url, body, mode, timeout)
+		if (result.Status == 401 || result.Status == 403) && index < len(modes)-1 {
+			copied := result
+			last = &copied
+			continue
+		}
+		if result.OK {
+			c.preferred = mode
+		}
+		return result
+	}
+	if last != nil {
+		return *last
+	}
+	return Result{Message: "认证失败"}
+}
+
+// Call 在 Send 之上处理 API 版本回退：只有错误措辞指向版本头时才降级，
+// 模型不存在一类错误不能把整轮探针切到旧版本。
+func (c *Client) Call(ctx context.Context, url string, body any) Result {
+	result := c.Send(ctx, url, body, c.cfg.Timeout)
+	if !result.OK && result.Status == 400 && c.version == DefaultAPIVersion && !c.versionStopped &&
+		versionHintRe.MatchString(result.Message) {
+		c.versionStopped = true
+		previous := c.version
+		c.version = LegacyAPIVersion
+		retried := c.Send(ctx, url, body, c.cfg.Timeout)
+		if !retried.OK {
+			c.version = previous
+		}
+		return retried
+	}
+	return result
+}
+
+// Messages 发一次 /v1/messages。
+func (c *Client) Messages(ctx context.Context, body map[string]any) Result {
+	return c.Call(ctx, c.messages, body)
+}
+
+// CountTokens 发一次 /v1/messages/count_tokens。
+func (c *Client) CountTokens(ctx context.Context, body map[string]any) Result {
+	return c.Call(ctx, c.counts, body)
+}
+
+func (c *Client) roundTrip(ctx context.Context, url string, body any, mode string, timeout time.Duration) Result {
+	payload, err := json.Marshal(body)
+	if err != nil {
+		return Result{Message: "请求体无法序列化", Kind: "network"}
+	}
+	attemptCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(attemptCtx, http.MethodPost, url, bytes.NewReader(payload))
+	if err != nil {
+		return Result{Message: Redact(err.Error(), c.cfg.APIKey), Kind: "network"}
+	}
+	for name, value := range headersFor(mode, c.cfg.APIKey, c.version) {
+		req.Header.Set(name, value)
+	}
+	resp, err := c.doer.Do(req)
+	if err != nil {
+		kind := "network"
+		if errors.Is(err, context.Canceled) {
+			kind = "aborted"
+		}
+		message := err.Error()
+		// CheckRedirect 拒绝跟随：这不是"连不上"，而是上游行为不对。
+		if errors.Is(err, http.ErrUseLastResponse) {
+			message = "目标返回了重定向，探测不跟随"
+		}
+		return Result{Message: Redact(message, c.cfg.APIKey), Kind: kind}
+	}
+	defer resp.Body.Close()
+	return parseResponse(resp, c.cfg.APIKey)
+}
+
+// parseResponse 读入响应并摊平。超过 MaxResponseBytes 直接判失败：中转层
+// 拿一个几百 MB 的页面糊弄探测时，不读到内存里。
+func parseResponse(resp *http.Response, secret string) Result {
+	limited := io.LimitReader(resp.Body, MaxResponseBytes+1)
+	raw, err := io.ReadAll(limited)
+	if err != nil {
+		return Result{Status: resp.StatusCode, Message: Redact("读取响应失败："+err.Error(), secret)}
+	}
+	if len(raw) > MaxResponseBytes {
+		return Result{Status: resp.StatusCode, Message: "响应超过 2 MiB 上限"}
+	}
+	text := string(raw)
+	var parsed map[string]any
+	if strings.TrimSpace(text) != "" {
+		_ = json.Unmarshal(raw, &parsed)
+	}
+	ok := resp.StatusCode >= 200 && resp.StatusCode < 300
+	message := ""
+	if !ok {
+		message = Redact(errorMessage(parsed, text), secret)
+		if len(message) > 600 {
+			message = message[:600]
+		}
+		if message == "" {
+			message = "上游返回空响应"
+		}
+	}
+	requestID := ""
+	if parsed != nil {
+		if id, ok := parsed["request_id"].(string); ok {
+			requestID = id
+		}
+	}
+	return Result{OK: ok, Status: resp.StatusCode, JSON: parsed, Message: message, RequestID: requestID}
+}
+
+// errorMessage 从错误体里挑一句人话：Anthropic 用 {"error":{"message"}}，
+// 有些网关只给 {"message"}，还有直接回 HTML 的。
+func errorMessage(parsed map[string]any, text string) string {
+	if parsed != nil {
+		if e, ok := parsed["error"].(map[string]any); ok {
+			if m, ok := e["message"].(string); ok && strings.TrimSpace(m) != "" {
+				return m
+			}
+		}
+		if m, ok := parsed["message"].(string); ok && strings.TrimSpace(m) != "" {
+			return m
+		}
+	}
+	return strings.TrimSpace(text)
+}
+
+// defaultTransport 给探测一份收敛过的传输：不跟重定向由 Client 管，这里
+// 只管连接复用与整体上限。
+func defaultTransport() *http.Transport {
+	transport := http.DefaultTransport.(*http.Transport).Clone()
+	transport.MaxIdleConns = 8
+	transport.MaxIdleConnsPerHost = 2
+	transport.TLSHandshakeTimeout = 15 * time.Second
+	return transport
+}
+
+func numberOrNil(value any) *float64 {
+	switch v := value.(type) {
+	case float64:
+		out := v
+		return &out
+	case json.Number:
+		if f, err := v.Float64(); err == nil {
+			out := f
+			return &out
+		}
+	}
+	return nil
+}
+
+func intOrNil(value any) *int {
+	number := numberOrNil(value)
+	if number == nil {
+		return nil
+	}
+	out := int(*number)
+	return &out
+}
+
+func stringOrEmpty(value any) string {
+	if s, ok := value.(string); ok {
+		return s
+	}
+	return ""
+}
+
+func fmtStatus(status int) string { return fmt.Sprintf("http_%d", status) }
diff --git a/internal/relay/config.go b/internal/relay/config.go
new file mode 100644
index 0000000..9aba97a
--- /dev/null
+++ b/internal/relay/config.go
@@ -0,0 +1,289 @@
+// Package relay 把中转站真伪检测内化进 magpie：页面只发信号，出站请求
+// 一律由 magpie 本体发出（page plugin 的 CSP 是 connect-src 'none'）。
+//
+// 这份实现移植自 Dock 插件 plugins/relay-probe/probe.mjs，判定门槛一字
+// 未改：B1 篡改签名重放、C1 count_tokens 与 usage.input_tokens 对账、
+// C2 跨代 tokenizer 计数对比。任何"更宽松"的改动都会让伪造的中转站拿到
+// 假绿，所以这里只允许等价移植。
+package relay
+
+import (
+	"fmt"
+	"net"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// 探针的默认参数，与 Dock 插件里的常量逐字相同。
+const (
+	DefaultModel      = "claude-sonnet-5-5"
+	ComparisonModel   = "claude-sonnet-4-6"
+	DefaultAPIVersion = "2026-10-21"
+	LegacyAPIVersion  = "2023-06-01"
+
+	// MaxResponseBytes 是单个上游响应读入的上限；中转层返回一个巨大的
+	// 错误页时，不读到内存里。
+	MaxResponseBytes = 2 << 20
+
+	// MaxReportBytes 是报告序列化后的上限：报告会被 view/status/存储各带
+	// 一份，撑爆宿主通道就连状态都读不到。
+	MaxReportBytes = 256 << 10
+
+	DefaultTimeout = 45 * time.Second
+	MaxTimeout     = 120 * time.Second
+
+	userAgent = "FISH-Dock-Relay-Probe/1.0"
+
+	// B1Prompt 是一道需要推理的题：thinking 块只有在模型真的思考时才会
+	// 带签名，用于后续的篡改重放。
+	B1Prompt = "Work through this problem carefully before answering. " +
+		"A bat and a ball cost $1.10 total. The bat costs $1.00 more than the ball. " +
+		"How much does the ball cost? Show the steps, and end with exactly one line: FINAL=<number>"
+
+	// TokenText 是中英混排 + 代码 + JSON 的样本，用来让两个 tokenizer 家族
+	// 产生可比较的计数差。
+	TokenText = "Tokenizer probe. 请只回复 OK。\n" +
+		"下面是一段混合中英文、代码和 JSON 的样本：\n" +
+		"函数 f(x) 返回 x 的平方；当 x=17 时结果为 289。\n" +
+		"```js\n" +
+		"const rows = [{\"id\":1,\"name\":\"鲸鱼\",\"ok\":true},{\"id\":2,\"name\":\"猫娘\",\"ok\":false}];\n" +
+		"console.log(rows.filter(row => row.ok).map(row => row.name).join(\",\"));\n" +
+		"```\n" +
+		"JSON: {\"temperature\":0.2,\"tokens\":[\"中文\",\"English\",\"emoji: 🐟\"]}\n" +
+		"不要解释，只回复 OK。"
+)
+
+// AuthModes 是配置可以接受的认证方式。
+var AuthModes = []string{"auto", "x-api-key", "bearer", "both"}
+
+// Error 是探测的输入/配置错误，带一个稳定的 code 供页面分支。
+type Error struct {
+	Code    string
+	Message string
+}
+
+func (e *Error) Error() string { return e.Message }
+
+func newError(code, message string) *Error { return &Error{Code: code, Message: message} }
+
+var (
+	modelPattern   = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$`)
+	versionPattern = regexp.MustCompile(`^\d{4}-\d{2}-\d{2}$`)
+	schemePattern  = regexp.MustCompile(`(?i)^(https?):$`)
+)
+
+// Config 是一次探测的完整参数。
+type Config struct {
+	BaseURL         string
+	APIKey          string
+	Model           string
+	ComparisonModel string
+	AuthMode        string
+	APIVersion      string
+	Timeout         time.Duration
+}
+
+// NormalizeBaseURL 把用户填的地址收成"协议 + 主机 + 路径"，并拒绝一切
+// 会把凭据或参数带出去的写法。
+//
+// 规矩（与 Dock 插件同一套）：只认 http/https；http 只允许本机回环；
+// 不允许内嵌用户名密码、查询串、# 片段；顺手剥掉用户可能粘进来的
+// /v1/messages、/v1/messages/count_tokens 和结尾的 /v1。
+func NormalizeBaseURL(raw string) (string, error) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return "", newError("BASE_URL_REQUIRED", "请填写 Base URL")
+	}
+	u, err := url.Parse(raw)
+	if err != nil {
+		return "", newError("BASE_URL_INVALID", "Base URL 不是有效 URL")
+	}
+	scheme := strings.ToLower(u.Scheme)
+	if scheme != "http" && scheme != "https" {
+		return "", newError("BASE_URL_SCHEME", "Base URL 只支持 HTTPS（本机回环可用 HTTP）")
+	}
+	if u.User != nil {
+		return "", newError("BASE_URL_CREDENTIALS", "Base URL 不能包含用户名或密码")
+	}
+	if u.RawQuery != "" || u.ForceQuery {
+		return "", newError("BASE_URL_QUERY", "Base URL 不能包含查询参数，请只填写协议、主机和路径")
+	}
+	if u.Fragment != "" || strings.Contains(raw, "#") {
+		return "", newError("BASE_URL_HASH", "Base URL 不能包含 # 片段")
+	}
+	host := u.Hostname()
+	if host == "" {
+		return "", newError("BASE_URL_INVALID", "Base URL 缺少主机名")
+	}
+	if scheme == "http" && !loopback(host) {
+		return "", newError("BASE_URL_INSECURE", "非本机地址必须使用 HTTPS")
+	}
+	path := strings.TrimRight(u.EscapedPath(), "/")
+	for _, suffix := range []string{"/v1/messages/count_tokens", "/v1/messages"} {
+		if strings.HasSuffix(path, suffix) {
+			path = strings.TrimSuffix(path, suffix)
+			break
+		}
+	}
+	path = strings.TrimSuffix(path, "/v1")
+	out := scheme + "://" + u.Host + path
+	if strings.HasSuffix(out, "/") {
+		out = strings.TrimSuffix(out, "/")
+	}
+	return out, nil
+}
+
+// loopback 判断主机是否本机回环：只有它们允许明文 http。
+func loopback(host string) bool {
+	switch strings.ToLower(host) {
+	case "localhost", "::1":
+		return true
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		return ip.IsLoopback()
+	}
+	return false
+}
+
+// PublicBaseURL 是报告与页面里显示的地址：失败时给 <invalid>，绝不回显
+// 用户填坏的原文。
+func PublicBaseURL(raw string) string {
+	normalized, err := NormalizeBaseURL(raw)
+	if err != nil {
+		return "<invalid>"
+	}
+	u, err := url.Parse(normalized)
+	if err != nil {
+		return "<invalid>"
+	}
+	if u.Path == "" || u.Path == "/" {
+		return u.Scheme + "://" + u.Host
+	}
+	return u.Scheme + "://" + u.Host + u.Path
+}
+
+// ValidateModel 校验模型 ID：中转站会把模型名原样拼进上游请求，非法字符
+// 只会换来一个看不懂的 400。
+func ValidateModel(value, fallback string) (string, error) {
+	model := strings.TrimSpace(value)
+	if model == "" {
+		model = fallback
+	}
+	if !modelPattern.MatchString(model) {
+		return "", newError("MODEL_INVALID", "模型 ID 格式无效")
+	}
+	return model, nil
+}
+
+// ValidateAPIVersion 只接受 YYYY-MM-DD。
+func ValidateAPIVersion(value string) (string, error) {
+	version := strings.TrimSpace(value)
+	if version == "" {
+		version = DefaultAPIVersion
+	}
+	if !versionPattern.MatchString(version) {
+		return "", newError("API_VERSION_INVALID", "API 版本格式应为 YYYY-MM-DD")
+	}
+	return version, nil
+}
+
+// ValidateAuthMode 只接受 AuthModes 里的值。
+func ValidateAuthMode(mode string) (string, error) {
+	mode = strings.TrimSpace(mode)
+	if mode == "" {
+		return "auto", nil
+	}
+	for _, known := range AuthModes {
+		if mode == known {
+			return mode, nil
+		}
+	}
+	return "", newError("AUTH_MODE_INVALID", "认证方式必须是 auto、x-api-key、bearer 或 both")
+}
+
+// NormalizeTimeout 把毫秒收进 5s–120s：太快测不出 B1 的推理，太慢会让
+// 页面等成僵尸。
+func NormalizeTimeout(ms int) (time.Duration, error) {
+	if ms == 0 {
+		return DefaultTimeout, nil
+	}
+	timeout := time.Duration(ms) * time.Millisecond
+	if timeout < 5*time.Second || timeout > MaxTimeout {
+		return 0, newError("TIMEOUT_INVALID", fmt.Sprintf("超时应在 %d–%d 毫秒之间", 5000, MaxTimeout.Milliseconds()))
+	}
+	return timeout, nil
+}
+
+// NormalizeConfig 校验并补齐一次探测的参数（Key 必填）。
+func NormalizeConfig(in Config) (Config, error) {
+	base, err := NormalizeBaseURL(in.BaseURL)
+	if err != nil {
+		return Config{}, err
+	}
+	key := strings.TrimSpace(in.APIKey)
+	if key == "" {
+		return Config{}, newError("KEY_REQUIRED", "请填写 API Key")
+	}
+	if len(key) > 8192 || strings.ContainsAny(key, "\r\n\x00") {
+		return Config{}, newError("KEY_INVALID", "API Key 格式无效")
+	}
+	model, err := ValidateModel(in.Model, DefaultModel)
+	if err != nil {
+		return Config{}, err
+	}
+	comparison, err := ValidateModel(in.ComparisonModel, ComparisonModel)
+	if err != nil {
+		return Config{}, err
+	}
+	mode, err := ValidateAuthMode(in.AuthMode)
+	if err != nil {
+		return Config{}, err
+	}
+	version, err := ValidateAPIVersion(in.APIVersion)
+	if err != nil {
+		return Config{}, err
+	}
+	timeout := in.Timeout
+	if timeout == 0 {
+		timeout = DefaultTimeout
+	}
+	if timeout < 5*time.Second || timeout > MaxTimeout {
+		return Config{}, newError("TIMEOUT_INVALID", fmt.Sprintf("超时应在 %d–%d 毫秒之间", 5000, MaxTimeout.Milliseconds()))
+	}
+	return Config{
+		BaseURL:         base,
+		APIKey:          key,
+		Model:           model,
+		ComparisonModel: comparison,
+		AuthMode:        mode,
+		APIVersion:      version,
+		Timeout:         timeout,
+	}, nil
+}
+
+// endpoints 是探测用到的两条路径。
+func endpoints(baseURL string) (messages, countTokens string) {
+	return baseURL + "/v1/messages", baseURL + "/v1/messages/count_tokens"
+}
+
+var (
+	keyPattern      = regexp.MustCompile(`\b(sk-[A-Za-z0-9_-]{6,})\b`)
+	bearerPattern   = regexp.MustCompile(`(?i)\b(Bearer\s+)[A-Za-z0-9._~+/=-]{8,}`)
+	versionHintRe   = regexp.MustCompile(`(?i)anthropic-version|api[\s_-]?version|unsupported[\s_-]?version|version[\s_-]header`)
+	signatureHintRe = regexp.MustCompile(`(?i)signature|thinking|verif|tamper|modified`)
+	thinkingErrRe   = regexp.MustCompile(`(?i)thinking|display|budget_tokens`)
+)
+
+// Redact 抹掉文本里的 Key 与 Bearer 头：上游可控的字段（错误信息、content
+// type）会被中转层拿来回显 Key，报告随后进页面、进本地存储。
+func Redact(value, secret string) string {
+	text := value
+	if secret != "" {
+		text = strings.ReplaceAll(text, secret, "<REDACTED>")
+	}
+	text = keyPattern.ReplaceAllString(text, "<REDACTED>")
+	text = bearerPattern.ReplaceAllString(text, "${1}<REDACTED>")
+	return text
+}
diff --git a/internal/relay/manager.go b/internal/relay/manager.go
new file mode 100644
index 0000000..e483590
--- /dev/null
+++ b/internal/relay/manager.go
@@ -0,0 +1,146 @@
+package relay
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+)
+
+// Manager 是一份进程内的探测状态：一次只跑一轮（中转站会按并发计费，
+// 两个页面同时点开始不该各自打一遍），并保留最后一次的状态供页面轮询。
+type Manager struct {
+	mu       sync.Mutex
+	running  bool
+	cancelled bool
+	state    State
+	cancel   context.CancelFunc
+	// probe 可在测试里换成不打网络的实现。
+	probe func(ctx context.Context, cfg Config) (Report, error)
+	now   func() time.Time
+}
+
+// NewManager 造一个空闲的管理器；probe 为 nil 时用真实探测。
+func NewManager() *Manager {
+	return &Manager{
+		state: State{Status: "idle"},
+		probe: func(ctx context.Context, cfg Config) (Report, error) {
+			return Probe(ctx, cfg, nil, time.Now())
+		},
+		now: time.Now,
+	}
+}
+
+// SetProbe 只给测试用：换掉真正发请求的那一步。
+func (m *Manager) SetProbe(fn func(ctx context.Context, cfg Config) (Report, error)) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.probe = fn
+}
+
+// State 是页面轮询看到的全部状态。Key 永远只有打码后的 hint。
+type State struct {
+	Status    string `json:"status"` // idle / running / done / error / stopped
+	BaseURL   string `json:"baseUrl"`
+	Model     string `json:"model"`
+	KeyHint   string `json:"keyHint"`
+	HasKey    bool   `json:"hasKey"`
+	StartedAt string `json:"startedAt,omitempty"`
+	EndedAt   string `json:"endedAt,omitempty"`
+	Error     string `json:"error,omitempty"`
+	ErrorCode string `json:"errorCode,omitempty"`
+	Report    *Report `json:"report,omitempty"`
+}
+
+// Snapshot 给一份当前状态（拷贝，调用方改不动内部）。
+func (m *Manager) Snapshot() State {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	state := m.state
+	if state.Report != nil {
+		report := *state.Report
+		state.Report = &report
+	}
+	return state
+}
+
+// Start 起一轮探测。已经在跑时返回 already_running，不排队——用户再点一次
+// 想要的不是第二轮。
+func (m *Manager) Start(cfg Config) error {
+	m.mu.Lock()
+	if m.running {
+		m.mu.Unlock()
+		return newError("ALREADY_RUNNING", "上一轮探测还没结束")
+	}
+	normalized, err := NormalizeConfig(cfg)
+	if err != nil {
+		m.mu.Unlock()
+		return err
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	m.running = true
+	m.cancelled = false
+	m.cancel = cancel
+	started := m.now()
+	m.state = State{
+		Status:    "running",
+		BaseURL:   PublicBaseURL(normalized.BaseURL),
+		Model:     normalized.Model,
+		KeyHint:   Hint(normalized.APIKey),
+		HasKey:    true,
+		StartedAt: started.Format(time.RFC3339),
+	}
+	probe := m.probe
+	now := m.now
+	m.mu.Unlock()
+
+	go func() {
+		report, err := probe(ctx, normalized)
+		cancel()
+		ended := now().Format(time.RFC3339)
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		m.running = false
+		m.cancel = nil
+		state := m.state
+		state.EndedAt = ended
+		switch {
+		case m.cancelled:
+			state.Status = "stopped"
+		case err != nil:
+			state.Status = "error"
+			state.Error = err.Error()
+			var typed *Error
+			if errors.As(err, &typed) {
+				state.ErrorCode = typed.Code
+			}
+		default:
+			state.Status = "done"
+			state.Report = &report
+		}
+		m.state = state
+	}()
+	return nil
+}
+
+// Stop 取消这一轮。它把状态定成 stopped 之后，本轮迟到的结果不会再回写。
+func (m *Manager) Stop() State {
+	m.mu.Lock()
+	if m.running && m.cancel != nil {
+		m.cancelled = true
+		m.cancel()
+	}
+	state := m.state
+	m.mu.Unlock()
+	return state
+}
+
+// Reset 清掉上一轮的报告，回到 idle（页面换地址时用）。
+func (m *Manager) Reset() {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.running {
+		return
+	}
+	m.state = State{Status: "idle", BaseURL: m.state.BaseURL, Model: m.state.Model, KeyHint: m.state.KeyHint, HasKey: m.state.HasKey}
+}
