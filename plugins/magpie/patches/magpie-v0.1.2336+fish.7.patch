@@ -0,0 +1,28 @@
+package gui
+
+import "slices"
+
+// callAllowed is whether a page that declared calls may ask for name. A
+// plugin that declared no calls may ask for nothing: the empty answer is
+// the safe one.
+func callAllowed(calls []string, name string) bool {
+	return name != "" && slices.Contains(calls, name)
+}
+
+// windowCalls are the call names a plugin's page or panel may ask for
+// (plugin.WindowSpec.Calls), or false when spec has no page and no panel
+// of its own: a plugin that adds nothing to the window has nothing to ask.
+func windowCalls(spec string) ([]string, bool) {
+	pages, panels := windowParts()
+	for _, p := range pages {
+		if p.Spec == spec {
+			return p.Calls, true
+		}
+	}
+	for _, p := range panels {
+		if p.Spec == spec {
+			return p.Calls, true
+		}
+	}
+	return nil, false
+}
