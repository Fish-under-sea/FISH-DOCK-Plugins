diff --git a/internal/provider/checkin_view.go b/internal/provider/checkin_view.go
new file mode 100644
index 0000000..99ab359
--- /dev/null
+++ b/internal/provider/checkin_view.go
@@ -0,0 +1,169 @@
+package provider
+
+import (
+	"strings"
+	"time"
+
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// CheckinProviderState 是签到页上的一家厂商：开关与显示名。插件页只读这类
+// 聚合信息，拿不到任何密钥。
+type CheckinProviderState struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	On   bool   `json:"on"`
+}
+
+// CheckinAccountState 是一个账号：oday 的签到结果按它的 Key 查。By 是它所属
+// 厂商的 id（与 Key 里 "厂商|登录" 的前缀一致），页面据此分组。
+type CheckinAccountState struct {
+	Key  string `json:"key"`
+	User string `json:"user"`
+	On   bool   `json:"on"`
+	By   string `json:"by"`
+}
+
+// CheckinViewState 是插件页「自动签到」一次读到的全部内容：厂商、账号、今天
+// 每个账号的结果（Today 按账号 Key）、实得积分（Credits），以及厂商额度面板
+// 反推的估计（CreditEstimate，按账号 Key）。没有秘密。
+type CheckinViewState struct {
+	Providers      []CheckinProviderState      `json:"providers"`
+	Accounts       []CheckinAccountState       `json:"accounts"`
+	Today          map[string]WorkBuddyCheckin `json:"today"`
+	Credits        map[string]float64          `json:"credits,omitempty"`
+	CreditEstimate map[string]float64          `json:"creditEstimate,omitempty"`
+}
+
+// checkinVendorNames 是内置签到厂商的显示名（插件厂商的名字来自 PluginCheckins）。
+// 键是账号 Key "厂商|登录" 里的厂商前缀。
+var checkinVendorNames = map[string]string{
+	wbCN.id:             wbCN.name, // workbuddy
+	TraeCNID:            "Trae CN", // trae-cn
+	MiniMaxCodeID:       "MiniMax Code",
+	MiniMaxCodeGlobalID: "MiniMax Code (Global)",
+	"qoder":             "Qoder",
+	QoderCNID:           "Qoder CN",
+}
+
+// CheckinViewStateNow 是 CheckinViewState 的当前读法。
+func CheckinViewStateNow() CheckinViewState { return CheckinViewStateAt(time.Now()) }
+
+// CheckinViewStateAt 汇出签到页要的东西：账号与开关来自 CheckinAccounts，
+// 今天的签到结果来自各厂商已经落盘的签到文件，估计来自额度面板的日间回落。
+// 只读，不发起任何签到。
+func CheckinViewStateAt(now time.Time) CheckinViewState {
+	s := settings.Load()
+	// 插件厂商的名字与开关
+	names := map[string]string{}
+	on := map[string]bool{}
+	for _, pc := range PluginCheckins() {
+		names[pc.ID] = pc.Name
+		on[pc.ID] = PluginCheckinOn(s, pc.ID)
+	}
+	// 内置厂商（若还有账号）：名字固定，开关在设置里
+	builtinOn := map[string]bool{
+		wbCN.id:             s.WorkBuddyCheckin,
+		TraeCNID:            s.TraeCheckin,
+		MiniMaxCodeID:       s.MiniMaxCheckin,
+		MiniMaxCodeGlobalID: s.MiniMaxCheckin,
+		"qoder":             s.QoderCheckin,
+		QoderCNID:           s.QoderCheckin,
+	}
+	for id, name := range checkinVendorNames {
+		if _, ok := names[id]; !ok {
+			names[id] = name
+		}
+		if _, ok := on[id]; !ok {
+			on[id] = builtinOn[id]
+		}
+	}
+
+	accounts := CheckinAccounts()
+	today := checkinTodayEntries(now)
+
+	out := CheckinViewState{
+		Providers: []CheckinProviderState{},
+		Accounts:  []CheckinAccountState{},
+		Today:     map[string]WorkBuddyCheckin{},
+		Credits:   map[string]float64{},
+	}
+	seenVendor := map[string]bool{}
+	counts := map[string]int{}
+	for _, a := range accounts {
+		vendor := checkinVendorOf(a.Key)
+		if vendor == "" {
+			continue
+		}
+		counts[vendor]++
+	}
+	for _, a := range accounts {
+		vendor := checkinVendorOf(a.Key)
+		if vendor == "" {
+			continue
+		}
+		out.Accounts = append(out.Accounts, CheckinAccountState{Key: a.Key, User: a.User, On: a.On, By: vendor})
+		if !seenVendor[vendor] {
+			seenVendor[vendor] = true
+			name := names[vendor]
+			if name == "" {
+				name = vendor
+			}
+			out.Providers = append(out.Providers, CheckinProviderState{ID: vendor, Name: name, On: on[vendor]})
+		}
+		if r, ok := today[a.Key]; ok {
+			// 讯飞的历史记录里 Credit 是插件当年没报的 0：读出来时按厂商口径补成
+			// 400，否则页面上永远是「1/1 · 0 今日」，只有新签的那次才对。
+			r.Credit = loomyCredit(vendor, r.Credit)
+			out.Today[a.Key] = r
+			if r.Credit > 0 {
+				out.Credits[a.Key] = r.Credit
+			}
+		}
+	}
+	if estimate := CreditEstimates(now); len(estimate) > 0 {
+		by := creditEstimateByAccount(estimate, out.Accounts, counts)
+		if len(by) > 0 {
+			out.CreditEstimate = by
+		}
+	}
+	return out
+}
+
+// checkinVendorOf 是账号 Key "厂商|登录" 的厂商；没有分隔符时算不清，返回空。
+func checkinVendorOf(key string) string {
+	if i := strings.Index(key, "|"); i > 0 {
+		return key[:i]
+	}
+	return ""
+}
+
+// checkinTodayEntries 是今天（北京日）每个账号的签到结果：五份签到文件里
+// 属于今天的那一条，按账号 Key 归并。
+func checkinTodayEntries(now time.Time) map[string]WorkBuddyCheckin {
+	day := CheckinDay(now)
+	out := map[string]WorkBuddyCheckin{}
+	for _, path := range []string{wbCheckinPath(), traeCheckinPath(), miniMaxCheckinPath(), qoderCheckinPath(), pluginCheckinPath()} {
+		for key, r := range shownCheckins(path) {
+			if r.Day == day {
+				out[key] = r
+			}
+		}
+	}
+	return out
+}
+
+// creditEstimateByAccount 是厂商级估计摊到账号上：只有该厂商恰好一个账号时
+// 才能确定是它到账的，否则不摊（乱传会把别家账号的额度算到它头上）。
+func creditEstimateByAccount(perVendor map[string]float64, accounts []CheckinAccountState, counts map[string]int) map[string]float64 {
+	out := map[string]float64{}
+	for _, a := range accounts {
+		if counts[a.By] != 1 {
+			continue
+		}
+		if v, ok := perVendor[a.By]; ok && v > 0 {
+			out[a.Key] = v
+		}
+	}
+	return out
+}
