+// 原生行为：篡改签名被拒 + 计数一致 + 跨代比例正常 => 与原生一致。
+func TestProbeNativeUpstreamIsConsistent(t *testing.T) {
+	upstream := nativeUpstream()
+	// 跨代 tokenizer：对照模型计数应当明显不同（比例落在 1.1–1.6）。
+	upstream.respond = func(req recordedRequest) *http.Response {
+		if strings.HasSuffix(req.URL, "/count_tokens") {
+			model, _ := req.Body["model"].(string)
+			if model == ComparisonModel {
+				return jsonResponse(200, map[string]any{"input_tokens": 60})
+			}
+			return jsonResponse(200, map[string]any{"input_tokens": 88})
+		}
+		return nativeUpstreamResponder(req)
+	}
+	report, err := Probe(context.Background(), baseConfig(), upstream, time.Unix(0, 0))
+	if err != nil {
+		t.Fatalf("Probe: %v", err)
+	}
+	if got := report.B1["status"]; got != "native_signal" {
+		t.Fatalf("B1 = %v, want native_signal (%v)", got, report.B1["message"])
+	}
+	if got := report.C1["status"]; got != "match" {
+		t.Fatalf("C1 = %v, want match", got)
+	}
+	if got := report.C2["status"]; got != "differ_expected" {
+		t.Fatalf("C2 = %v, want differ_expected", got)
+	}
+	if report.Verdict.Code != "native_consistent" {
+		t.Fatalf("verdict = %s (%s)", report.Verdict.Code, report.Verdict.Label)
+	}
+	// Key 绝不能出现在报告里。
+	encoded, _ := json.Marshal(report)
+	if strings.Contains(string(encoded), "SECRETVALUE") {
+		t.Fatal("报告里出现了明文 Key")
+	}
+}
