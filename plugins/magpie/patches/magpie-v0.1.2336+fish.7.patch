+// auto 模式：x-api-key 被拒后换 bearer 再试，成功后记住 bearer。
+func TestClientFallsBackToBearerOn401(t *testing.T) {
+	upstream := &fakeUpstream{respond: func(req recordedRequest) *http.Response {
+		if req.Header.Get("x-api-key") != "" {
+			return jsonResponse(401, map[string]any{"error": map[string]string{"message": "no x-api-key here"}})
+		}
+		if req.Header.Get("authorization") != "" {
+			return jsonResponse(200, map[string]any{"type": "message", "content": []any{}})
+		}
+		return jsonResponse(400, map[string]any{"error": map[string]string{"message": "no auth"}})
+	}}
+	client := NewClient(baseConfig(), upstream)
+	result := client.Messages(context.Background(), map[string]any{"model": "m"})
+	if !result.OK {
