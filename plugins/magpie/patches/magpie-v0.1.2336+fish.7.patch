@@ -0,0 +1,39 @@
+package provider
+
+import "testing"
+
+func TestCheckinVendorOf(t *testing.T) {
+	for key, want := range map[string]string{
+		"workbuddy|u1": "workbuddy",
+		"plugin-x|ann": "plugin-x",
+		"qoder-cn|a@b": "qoder-cn",
+		"nopipe":       "",
+		"|leading":     "",
+	} {
+		if got := checkinVendorOf(key); got != want {
+			t.Errorf("checkinVendorOf(%q) = %q, want %q", key, got, want)
+		}
+	}
+}
+
+// 厂商级估计只在它恰好一个账号时摊到那个账号上；两个账号的厂商不摊，以免把
+// 别家账号的额度算到它头上。
+func TestCreditEstimateByAccount(t *testing.T) {
+	perVendor := map[string]float64{"workbuddy": 50, "qoder": 30}
+	accounts := []CheckinAccountState{
+		{Key: "workbuddy|a", By: "workbuddy"},
+		{Key: "qoder|a", By: "qoder"},
+		{Key: "qoder|b", By: "qoder"},
+	}
+	counts := map[string]int{"workbuddy": 1, "qoder": 2}
+	got := creditEstimateByAccount(perVendor, accounts, counts)
+	if got["workbuddy|a"] != 50 {
+		t.Errorf("single-account vendor estimate = %v, want 50", got["workbuddy|a"])
+	}
+	if _, ok := got["qoder|a"]; ok {
+		t.Errorf("two-account vendor must not attribute the estimate, got %v", got)
+	}
+	if _, ok := got["qoder|b"]; ok {
+		t.Errorf("two-account vendor must not attribute the estimate, got %v", got)
+	}
+}
diff --git a/internal/provider/credits_estimate.go b/internal/provider/credits_estimate.go
new file mode 100644
index 0000000..5d695ab
--- /dev/null
+++ b/internal/provider/credits_estimate.go
@@ -0,0 +1,63 @@
+package provider
+
+import (
+	"os"
+	"strings"
+	"time"
+)
+
+// CreditEstimates 是"今天大概到账了多少额度"的估计，按厂商聚合。
+//
+// 口径只有一条：用 credits-daily.json 里昨日与今日的用量差。用量回落
+// （今日 < 昨日）说明额度在今天补过，差额就是补进来的量；用量没回落就没有
+// 证据，那个厂商直接不出现——页面按"有则显示 ≈+N、无则不显示"来处理。
+//
+// 这不是账单，也不是承诺：它只是把已经落盘的两次读数摊开讲清楚。
+func CreditEstimates(now time.Time) map[string]float64 {
+	raw, err := os.ReadFile(creditsPath())
+	if err != nil {
+		return nil
+	}
+	accts, err := parseCredits(raw)
+	if err != nil || len(accts) == 0 {
+		return nil
+	}
+	return estimateRefills(accts, now)
+}
+
+// estimateRefills 是估算的纯逻辑部分：测试直接喂 accts，不碰磁盘。
+func estimateRefills(accts map[string]*creditsAccount, now time.Time) map[string]float64 {
+	today := now.Local().Format("2006-01-02")
+	yesterday := now.Local().AddDate(0, 0, -1).Format("2006-01-02")
+	out := map[string]float64{}
+	for key, acct := range accts {
+		if acct == nil || acct.Days == nil {
+			continue
+		}
+		usedToday, okToday := acct.Days[today]
+		usedBefore, okBefore := acct.Days[yesterday]
+		if !okToday || !okBefore {
+			continue
+		}
+		refill := usedBefore - usedToday
+		if refill <= 0 {
+			continue
+		}
+		if acct.Since != "" && acct.Since > yesterday {
+			// 只知道从 Since 起的用量：之前的"昨日"不是读数，是空白。
+			continue
+		}
+		providerID := key
+		if i := strings.Index(key, "|"); i > 0 {
+			providerID = key[:i]
+		}
+		if providerID == "" {
+			continue
+		}
+		out[providerID] += refill
+	}
+	if len(out) == 0 {
+		return nil
+	}
+	return out
+}
