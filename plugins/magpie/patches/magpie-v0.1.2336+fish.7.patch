+package relay
+
+import "github.com/yetone/magpie/internal/appdir"
+
+// configDir 是 relay.json 与按平台密钥材料的落点，与 providers.json 同一个
+// 配置目录（$MAGPIE_CONFIG 优先，便携模式下是程序旁的数据目录）。
+func configDir() string { return appdir.Config() }
diff --git a/internal/relay/probe.go b/internal/relay/probe.go
new file mode 100644
index 0000000..84b7e84
--- /dev/null
+++ b/internal/relay/probe.go
@@ -0,0 +1,619 @@
+package relay
+
+import (
+	"context"
+	"encoding/json"
+	"math"
+	"regexp"
+	"strings"
+)
+
+// 三组探针各返回一个 map：字段随 status 变化，摊平成 map 与 Dock 插件的
+// 报告结构一一对应（页面、存储、CLI 都按这套字段读）。
+
+// thinkingFamily 按模型 ID 猜 thinking 参数世代。Claude 3.0/3.5 不支持
+// thinking；3.7/4.0/4.1/4.5 只接受 enabled；4.6 与 5.x 用 adaptive。
+func thinkingFamily(model string) string {
+	id := strings.ToLower(model)
+	switch {
+	case strings.Contains(id, "claude-3-7"):
+		return "enabled"
+	case regexp.MustCompile(`claude-3-5|claude-3-(?:opus|haiku|sonnet)|claude-3(?:\.0)?(?:-|$)`).MatchString(id):
+		return "none"
+	case regexp.MustCompile(`claude-(?:sonnet|opus|haiku)-4-(?:0|1|5)(?:-|$)`).MatchString(id):
+		return "enabled"
+	case strings.Contains(id, "claude-sonnet-4-2025"), strings.Contains(id, "claude-opus-4-2025"), strings.Contains(id, "claude-haiku-4-2025"):
+		return "enabled"
+	case regexp.MustCompile(`claude-(?:sonnet|opus|haiku)-4-6`).MatchString(id):
+		return "adaptive"
+	case regexp.MustCompile(`claude-(?:sonnet|opus|haiku|fable)-5(?:-|$)`).MatchString(id):
+		return "adaptive"
+	}
+	return "unknown"
+}
+
+// thinkingCandidates 是这一轮依次尝试的 thinking 配置：先按世代猜，失败
+// 再逐级回退，避免把日期后缀的 4.x 误发成 adaptive 直接 400。
+func thinkingCandidates(model string) []map[string]any {
+	switch thinkingFamily(model) {
+	case "none":
+		return []map[string]any{nil}
+	case "enabled":
+		return []map[string]any{
+			{"type": "enabled", "budget_tokens": 1024},
+			{"type": "adaptive"},
+		}
+	}
+	return []map[string]any{
+		{"type": "adaptive", "display": "summarized"},
+		{"type": "adaptive"},
+		{"type": "enabled", "budget_tokens": 1024},
+	}
+}
+
+// detectSurface 判断上游实际返回的是 Anthropic Messages 还是 OpenAI
+// 兼容形状：形状不对时，后面的计数对比没有意义。
+func detectSurface(result Result) string {
+	if result.JSON == nil {
+		return "unknown"
+	}
+	if result.JSON["type"] == "message" {
+		if _, ok := result.JSON["content"].([]any); ok {
+			return "anthropic"
+		}
+	}
+	if result.JSON["object"] == "chat.completion" {
+		return "openai"
+	}
+	if _, ok := result.JSON["choices"].([]any); ok {
+		return "openai"
+	}
+	return "unknown"
+}
+
+func classifyFirstError(result Result) string {
+	switch {
+	case result.Kind == "network":
+		return "network_error"
+	case result.Kind == "aborted":
+		return "aborted"
+	case result.Status == 401 || result.Status == 403:
+		return "auth_error"
+	case result.Status == 404:
+		return "endpoint_not_found"
+	case result.Status == 429 || result.Status >= 500:
+		return "transient_error"
+	}
+	return fmtStatus(result.Status)
+}
+
+// classifyReplay 判断一次"重放"的结果。注意 2xx 不等于签名被接受：
+// 空响应、网关 HTML、200 包着的 error JSON 都是 invalid_response。
+func classifyReplay(result Result) string {
+	if result.OK {
+		if detectSurface(result) == "anthropic" {
+			return "accepted"
+		}
+		return "invalid_response"
+	}
+	switch {
+	case result.Kind == "network":
+		return "network_error"
+	case result.Kind == "aborted":
+		return "aborted"
+	case result.Status == 401 || result.Status == 403:
+		return "auth_error"
+	case result.Status == 429 || result.Status >= 500:
+		return "transient_error"
+	case result.Status == 400 || result.Status == 422:
+		// 只有错误明确指向签名/thinking 校验才算"篡改被校验"；
+		// 泛泛的 invalid request 只能是 rejected_other。
+		if signatureHintRe.MatchString(result.Message) {
+			return "rejected"
+		}
+		return "rejected_other"
+	}
+	return fmtStatus(result.Status)
+}
+
+// thinkingDropNote 识别新版 API 的 input_transformations：中转层改写请求
+// 时会告诉我们它把 thinking 丢了。
+func thinkingDropNote(result Result) string {
+	if result.JSON == nil {
+		return ""
+	}
+	raw, ok := result.JSON["input_transformations"].([]any)
+	if !ok {
+		return ""
+	}
+	for _, item := range raw {
+		encoded, err := json.Marshal(item)
+		if err != nil {
+			continue
+		}
+		text := string(encoded)
+		if regexp.MustCompile(`(?i)thinking`).MatchString(text) &&
+			regexp.MustCompile(`(?i)drop|remov|discard`).MatchString(text) {
+			if len(text) > 300 {
+				text = text[:300]
+			}
+			return text
+		}
+	}
+	return ""
+}
+
+// replay 用同一段 thinking 块重放一次；tamper 为真时把签名中间一位改掉。
+func replay(ctx context.Context, client *Client, model string, blocks []any, index int, tamper bool, thinking map[string]any) map[string]any {
+	content := deepCopyBlocks(blocks)
+	if tamper && index >= 0 && index < len(content) {
+		if block, ok := content[index].(map[string]any); ok {
+			field := "signature"
+			if block["type"] == "redacted_thinking" {
+				field = "data"
+			}
+			signature := stringOrEmpty(block[field])
+			if signature != "" {
+				position := len(signature) / 2
+				replacement := "A"
+				if signature[position:position+1] == "A" {
+					replacement = "B"
+				}
+				block[field] = signature[:position] + replacement + signature[position+1:]
+			}
+		}
+	}
+	body := map[string]any{
+		"model":      model,
+		"max_tokens": 2048,
+		"messages": []any{
+			map[string]any{"role": "user", "content": B1Prompt},
+			map[string]any{"role": "assistant", "content": content},
+			map[string]any{"role": "user", "content": "Repeat the final line exactly, with no extra text."},
+		},
+	}
+	if thinking != nil {
+		body["thinking"] = thinking
+	}
+	result := client.Messages(ctx, body)
+	out := map[string]any{
+		"status":     classifyReplay(result),
+		"httpStatus": result.Status,
+		"message":    result.Message,
+	}
+	if usage := usageInputTokens(result); usage != nil {
+		out["usage"] = *usage
+	}
+	if note := thinkingDropNote(result); note != "" {
+		out["dropped"] = note
+	}
+	return out
+}
+
+// replayWithoutThinking 是控制组：整块删掉 thinking 再重放。如果两条"成功"
+// 重放的 usage 与控制组完全相同，说明 thinking 块根本没被计费。
+func replayWithoutThinking(ctx context.Context, client *Client, model string, blocks []any, thinking map[string]any) map[string]any {
+	content := make([]any, 0, len(blocks))
+	for _, block := range blocks {
+		if m, ok := block.(map[string]any); ok {
+			if m["type"] == "thinking" || m["type"] == "redacted_thinking" {
+				continue
+			}
+		}
+		content = append(content, block)
+	}
+	if len(content) == 0 {
+		return nil
+	}
+	body := map[string]any{
+		"model":      model,
+		"max_tokens": 2048,
+		"messages": []any{
+			map[string]any{"role": "user", "content": B1Prompt},
+			map[string]any{"role": "assistant", "content": content},
+			map[string]any{"role": "user", "content": "Repeat the final line exactly, with no extra text."},
+		},
+	}
+	if thinking != nil {
+		body["thinking"] = thinking
+	}
+	result := client.Messages(ctx, body)
+	out := map[string]any{
+		"status":     classifyReplay(result),
+		"httpStatus": result.Status,
+		"message":    result.Message,
+	}
+	if usage := usageInputTokens(result); usage != nil {
+		out["usage"] = *usage
+	}
+	return out
+}
+
+// probeB1 是签名探针：先让模型带 thinking 回答一道题，再把同一段 thinking
+// 块原样重放、篡改签名重放，看第一次成功第二次被拒（原生行为）还是两次
+// 都成功（签名没被校验）。
+func probeB1(ctx context.Context, client *Client, cfg Config) map[string]any {
+	candidates := thinkingCandidates(cfg.Model)
+	var thinking map[string]any
+	var first Result
+	thinkingRejected := false
+	for _, candidate := range candidates {
+		body := map[string]any{
+			"model":      cfg.Model,
+			"max_tokens": 2048,
+			"messages":   []any{map[string]any{"role": "user", "content": B1Prompt}},
+		}
+		if candidate != nil {
+			body["thinking"] = candidate
+		}
+		first = client.Messages(ctx, body)
+		if first.OK {
+			thinking = candidate
+			break
+		}
+		thinkingRejected = first.Status == 400 && thinkingErrRe.MatchString(first.Message)
+		if !thinkingRejected {
+			break
+		}
+	}
+	if !first.OK {
+		message := first.Message
+		if message == "" {
+			message = "首个请求失败"
+		}
+		status := classifyFirstError(first)
+		if thinkingRejected {
+			status = "thinking_unsupported"
+			message = "目标拒绝所有 thinking 配置，无法进行签名重放"
+		}
+		return map[string]any{"id": "B1", "status": status, "surface": "unknown", "httpStatus": first.Status, "message": message}
+	}
+	surface := detectSurface(first)
+	if surface != "anthropic" {
+		message := "目标响应不是 Anthropic Messages 形状"
+		if surface == "openai" {
+			message = "目标返回 OpenAI 兼容形状，不是 Anthropic Messages API"
+		}
+		return map[string]any{"id": "B1", "status": "unsupported_surface", "surface": surface, "httpStatus": first.Status, "message": message}
+	}
+	blocks := contentBlocks(first)
+	index := -1
+	for i, block := range blocks {
+		if m, ok := block.(map[string]any); ok {
+			if m["type"] == "thinking" || m["type"] == "redacted_thinking" {
+				index = i
+				break
+			}
+		}
+	}
+	// 上游可控的 type 必须限长并抹掉 Key：恶意中转站可以把 Key 塞进 type。
+	contentTypes := make([]any, 0, 16)
+	for i, block := range blocks {
+		if i == 16 {
+			break
+		}
+		if m, ok := block.(map[string]any); ok {
+			value := Redact(stringOrEmpty(m["type"]), cfg.APIKey)
+			if len(value) > 64 {
+				value = value[:64]
+			}
+			if value != "" {
+				contentTypes = append(contentTypes, value)
+			}
+		}
+	}
+	if index < 0 {
+		return map[string]any{
+			"id": "B1", "status": "no_thinking", "surface": surface, "httpStatus": first.Status,
+			"contentTypes": contentTypes,
+			"message":      "响应没有 thinking 块；可能是请求未触发，也可能是中转层剥离",
+		}
+	}
+	block, _ := blocks[index].(map[string]any)
+	signatureField := "signature"
+	if block["type"] == "redacted_thinking" {
+		signatureField = "data"
+	}
+	signature := stringOrEmpty(block[signatureField])
+	if signature == "" {
+		return map[string]any{
+			"id": "B1", "status": "signature_missing", "surface": surface, "httpStatus": first.Status,
+			"contentTypes": contentTypes, "signatureLength": 0, "message": "thinking 块没有签名",
+		}
+	}
+	if len(signature) < 16 {
+		return map[string]any{
+			"id": "B1", "status": "signature_short", "surface": surface, "httpStatus": first.Status,
+			"contentTypes": contentTypes, "signatureLength": len(signature), "message": "thinking 签名短于正常长度",
+		}
+	}
+	validReplay := replay(ctx, client, cfg.Model, blocks, index, false, thinking)
+	tamperedReplay := replay(ctx, client, cfg.Model, blocks, index, true, thinking)
+	validStatus, _ := validReplay["status"].(string)
+	tamperedStatus, _ := tamperedReplay["status"].(string)
+	status := "unknown"
+	droppedNote := ""
+	switch {
+	case validStatus == "accepted" && tamperedStatus == "rejected":
+		status = "native_signal"
+	case validStatus == "accepted" && tamperedStatus == "accepted":
+		droppedNote = Redact(pickString(validReplay, "dropped", tamperedReplay), cfg.APIKey)
+		if len(droppedNote) > 300 {
+			droppedNote = droppedNote[:300]
+		}
+		if droppedNote == "" {
+			control := replayWithoutThinking(ctx, client, cfg.Model, blocks, thinking)
+			if control != nil {
+				if usage, ok := control["usage"]; ok && control["status"] == "accepted" {
+					valid, validOK := validReplay["usage"]
+					tampered, tamperedOK := tamperedReplay["usage"]
+					if validOK && tamperedOK && sameNumber(valid, usage) && sameNumber(tampered, usage) {
+						droppedNote = "重放 usage=" + formatNumber(usage) + " 与去掉 thinking 的控制组相同"
+					}
+				}
+			}
+		}
+		if droppedNote != "" {
+			status = "block_dropped"
+		} else {
+			status = "tamper_accepted"
+		}
+	case validStatus == "accepted" && tamperedStatus == "rejected_other":
+		status = "tamper_rejected_unclear"
+	case validStatus != "accepted":
+		status = "replay_" + validStatus
+	}
+	out := map[string]any{
+		"id": "B1", "status": status, "surface": surface, "httpStatus": first.Status,
+		"contentTypes": contentTypes, "signatureLength": len(signature),
+		"validReplay": validReplay, "tamperedReplay": tamperedReplay,
+	}
+	if droppedNote != "" {
+		out["droppedNote"] = droppedNote
+	}
+	switch status {
+	case "native_signal":
+		out["message"] = "有效重放成功，篡改签名后被拒绝"
+	case "tamper_accepted":
+		out["message"] = "篡改 thinking 签名后请求仍然成功"
+	case "block_dropped":
+		message := "重放成功但 thinking 块疑似被丢弃，不能算篡改被接受"
+		if droppedNote != "" {
+			message += "（" + droppedNote + "）"
+		}
+		out["message"] = message
+	case "tamper_rejected_unclear":
+		out["message"] = "篡改后被拒绝，但错误信息未指向签名校验"
+	default:
+		out["message"] = "无法完成有效的签名重放对照"
+	}
+	return out
+}
+
+// probeC1 对账：同一段文本，count_tokens 报一个数，真正生成时 usage 报另
+// 一个数。原生实现应当逐 token 相等（±1 容忍边界版本差异）。
+func probeC1(ctx context.Context, client *Client, cfg Config) map[string]any {
+	counted := countForModel(ctx, client, cfg.Model)
+	if !counted.ok {
+		status := "error"
+		if counted.status == 404 || counted.status == 405 {
+			status = "unsupported"
+		}
+		return map[string]any{"id": "C1", "status": status, "httpStatus": counted.status, "message": counted.message}
+	}
+	if counted.count == nil || *counted.count <= 0 {
+		return map[string]any{"id": "C1", "status": "invalid_count", "httpStatus": counted.status, "message": "count_tokens 没有返回有效计数"}
+	}
+	generated := client.Messages(ctx, map[string]any{
+		"model":      cfg.Model,
+		"max_tokens": 64,
+		"messages":   []any{map[string]any{"role": "user", "content": TokenText}},
+	})
+	if !generated.OK {
+		return map[string]any{
+			"id": "C1", "status": "generation_failed", "httpStatus": generated.Status,
+			"counted": *counted.count, "message": generated.Message,
+		}
+	}
+	used := usageInputTokens(generated)
+	if used == nil || *used <= 0 {
+		return map[string]any{
+			"id": "C1", "status": "usage_missing", "httpStatus": generated.Status,
+			"counted": *counted.count, "message": "生成响应没有可用的 usage.input_tokens",
+		}
+	}
+	diff := *used - *counted.count
+	status := "mismatch"
+	switch {
+	case diff == 0:
+		status = "match"
+	case diff >= -1 && diff <= 1:
+		status = "near_match"
+	}
+	out := map[string]any{
+		"id": "C1", "status": status, "httpStatus": generated.Status,
+		"counted": *counted.count, "used": *used, "diff": diff,
+	}
+	if *counted.count != 0 {
+		out["percent"] = float64(diff) / float64(*counted.count)
+	}
+	return out
+}
+
+// tokenizerFamily 把模型按 tokenizer 世代分组：4.7 及以后（含 5.x、Fable/
+// Mythos 5.x）共用新 tokenizer，4.6 及以前共用旧的。同代计数相同是预期，
+// 不能当伪造证据。
+func tokenizerFamily(model string) string {
+	id := strings.ToLower(model)
+	newFamily := regexp.MustCompile(`claude-(?:sonnet|opus|haiku)-5(?:-|$)`).MatchString(id) ||
+		regexp.MustCompile(`claude-(?:fable|mythos)-5(?:-|$)`).MatchString(id) ||
+		strings.Contains(id, "claude-mythos-preview") ||
+		regexp.MustCompile(`claude-(?:sonnet|opus|haiku)-4-(?:7|8)(?:-|$)`).MatchString(id)
+	if newFamily {
+		return "claude-47-plus"
+	}
+	if regexp.MustCompile(`claude-(?:3|4)(?:-|$)`).MatchString(id) ||
+		regexp.MustCompile(`claude-(?:sonnet|opus|haiku)-4(?:-|$)`).MatchString(id) {
+		return "claude-pre-47"
+	}
+	return "unknown"
+}
+
+// probeC2 比两个不同代模型的 token 计数：同代共用 tokenizer 时相同是正常
+// 的，跨代却完全相同才是可疑信号。
+func probeC2(ctx context.Context, client *Client, cfg Config) map[string]any {
+	if cfg.Model == cfg.ComparisonModel {
+		return map[string]any{"id": "C2", "status": "skipped", "reason": "主模型与对照模型相同"}
+	}
+	primary := countForModel(ctx, client, cfg.Model)
+	comparison := countForModel(ctx, client, cfg.ComparisonModel)
+	if !primary.ok || !comparison.ok {
+		status := "error"
+		if primary.ok {
+			status = "comparison_unavailable"
+		}
+		message := primary.message
+		if primary.ok {
+			message = comparison.message
+		}
+		return map[string]any{
+			"id": "C2", "status": status,
+			"primary":    map[string]any{"ok": primary.ok, "status": primary.status, "count": primary.count},
+			"comparison": map[string]any{"ok": comparison.ok, "status": comparison.status, "count": comparison.count},
+			"message":    message,
+		}
+	}
+	if primary.count == nil || comparison.count == nil || *primary.count <= 0 || *comparison.count <= 0 {
+		return map[string]any{
+			"id": "C2", "status": "invalid_count",
+			"primary":    map[string]any{"count": primary.count},
+			"comparison": map[string]any{"count": comparison.count},
+			"message":    "两个模型没有返回有效计数",
+		}
+	}
+	ratio := float64(*primary.count) / float64(*comparison.count)
+	primaryFamily := tokenizerFamily(cfg.Model)
+	comparisonFamily := tokenizerFamily(cfg.ComparisonModel)
+	sameFamily := primaryFamily != "unknown" && primaryFamily == comparisonFamily
+	bothKnown := primaryFamily != "unknown" && comparisonFamily != "unknown"
+	var status string
+	switch {
+	case sameFamily:
+		// 同代 tokenizer：相同/几乎相同是预期，比例明显异常才记 differ_other。
+		if math.Abs(ratio-1) <= 0.03 {
+			status = "same_tokenizer"
+		} else {
+			status = "differ_other"
+		}
+	case bothKnown:
+		switch {
+		case *primary.count == *comparison.count:
+			status = "identical"
+		case math.Abs(ratio-1) <= 0.03:
+			status = "near_identical"
+		case ratio >= 1.1 && ratio <= 1.6:
+			status = "differ_expected"
+		default:
+			status = "differ_other"
+		}
+	default:
+		// 世代未知时，相同计数也可能只是同代 tokenizer，不能单独下结论。
+		switch {
+		case *primary.count == *comparison.count:
+			status = "identical_unknown"
+		case math.Abs(ratio-1) <= 0.03:
+			status = "near_identical_unknown"
+		case ratio >= 1.1 && ratio <= 1.6:
+			status = "differ_expected"
+		default:
+			status = "differ_other"
+		}
+	}
+	return map[string]any{
+		"id": "C2", "status": status,
+		"primary":    map[string]any{"model": cfg.Model, "count": *primary.count, "family": primaryFamily},
+		"comparison": map[string]any{"model": cfg.ComparisonModel, "count": *comparison.count, "family": comparisonFamily},
+		"ratio":      ratio,
+	}
+}
+
+type counted struct {
+	ok      bool
+	status  int
+	message string
+	count   *int
+}
+
+func countForModel(ctx context.Context, client *Client, model string) counted {
+	result := client.CountTokens(ctx, map[string]any{
+		"model":    model,
+		"messages": []any{map[string]any{"role": "user", "content": TokenText}},
+	})
+	count := usageInputTokens(result)
+	return counted{ok: result.OK, status: result.Status, message: result.Message, count: count}
+}
+
+// usageInputTokens 从响应里取 usage.input_tokens。
+func usageInputTokens(result Result) *int {
+	if result.JSON == nil {
+		return nil
+	}
+	usage, ok := result.JSON["usage"].(map[string]any)
+	if !ok {
+		// count_tokens 的响应把计数放在顶层 input_tokens。
+		if input, ok := result.JSON["input_tokens"]; ok {
+			return intOrNil(input)
+		}
+		return nil
+	}
+	return intOrNil(usage["input_tokens"])
+}
+
+func contentBlocks(result Result) []any {
+	if result.JSON == nil {
+		return nil
+	}
+	blocks, _ := result.JSON["content"].([]any)
+	return blocks
+}
+
+// deepCopyBlocks 复制 content 数组：重放会改签名，不能把原响应当草稿纸。
+func deepCopyBlocks(blocks []any) []any {
+	encoded, err := json.Marshal(blocks)
+	if err != nil {
+		return append([]any{}, blocks...)
+	}
+	var out []any
+	if json.Unmarshal(encoded, &out) != nil {
+		return append([]any{}, blocks...)
+	}
+	return out
+}
+
+func pickString(primary map[string]any, key string, fallback map[string]any) string {
+	if value, ok := primary[key].(string); ok && value != "" {
+		return value
+	}
+	if value, ok := fallback[key].(string); ok {
+		return value
+	}
+	return ""
+}
+
+func sameNumber(a, b any) bool {
+	left, right := numberOrNil(a), numberOrNil(b)
+	return left != nil && right != nil && *left == *right
+}
+
+func formatNumber(value any) string {
+	number := numberOrNil(value)
+	if number == nil {
+		return "?"
+	}
+	return strings.TrimSuffix(strings.TrimSuffix(formatFloat(*number), "0"), ".")
+}
+
+func formatFloat(value float64) string {
+	encoded, _ := json.Marshal(value)
+	return string(encoded)
+}
