+// 伪造行为：篡改签名仍然成功 + 计数对不上 => 极大概率伪造。
+func TestProbeForgedUpstreamIsLikelyForged(t *testing.T) {
+	upstream := &fakeUpstream{respond: func(req recordedRequest) *http.Response {
+		if strings.HasSuffix(req.URL, "/count_tokens") {
+			model, _ := req.Body["model"].(string)
+			if model == ComparisonModel {
+				return jsonResponse(200, map[string]any{"input_tokens": 60})
+			}
+			return jsonResponse(200, map[string]any{"input_tokens": 88})
+		}
+		messages, _ := req.Body["messages"].([]any)
+		last := ""
+		if len(messages) > 0 {
+			if row, ok := messages[len(messages)-1].(map[string]any); ok {
+				last, _ = row["content"].(string)
+			}
+		}
+		if strings.Contains(last, "Repeat the final line") {
+			// 中转层不看签名：篡改过的也照样回一条 message。
+			return jsonResponse(200, claudeAnswer("whatever"))
+		}
+		if len(messages) == 2 && strings.TrimSpace(last) == TokenText {
+			// 生成时的 usage 与 count_tokens 完全对不上。
+			return jsonResponse(200, map[string]any{
+				"type": "message", "content": []any{map[string]any{"type": "text", "text": "OK"}},
+				"usage": map[string]any{"input_tokens": 77},
+			})
+		}
+		return jsonResponse(200, claudeAnswer("abcdefghijklmnopqrstuvwxyz012345"))
+	}}
+	report, err := Probe(context.Background(), baseConfig(), upstream, time.Unix(0, 0))
+	if err != nil {
+		t.Fatalf("Probe: %v", err)
+	}
+	if got := report.B1["status"]; got != "tamper_accepted" {
+		t.Fatalf("B1 = %v, want tamper_accepted", got)
+	}
+	if got := report.C1["status"]; got != "mismatch" {
+		t.Fatalf("C1 = %v, want mismatch", got)
+	}
+	if report.Verdict.Code != "likely_forged" {
+		t.Fatalf("verdict = %s, want likely_forged (%v)", report.Verdict.Code, report.Verdict.Signals)
+	}
+	if report.Verdict.ForgedScore < 7 {
+		t.Fatalf("forgedScore = %v, want >= 7", report.Verdict.ForgedScore)
+	}
+}
