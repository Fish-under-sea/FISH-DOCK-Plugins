+	if client.AuthMode() != "bearer" {
+		t.Fatalf("authMode = %s, want bearer", client.AuthMode())
+	}
+	seen := upstream.seen()
+	if len(seen) != 2 {
+		t.Fatalf("发了 %d 次请求, want 2", len(seen))
+	}
+}
