+/* 插件页图标是一张 <img> 的 SVG，图里用 currentColor 画线；<img> 不继承主题
+   色，于是它永远按 SVG 自己的黑画，深色模式下就成了一块看不见的黑。这里把
+   它钉到正文色上：浅色模式黑、深色模式白。内联 svg.nav-ic（内置页、无图插件）
+   本来就走 currentColor，不受这条影响。 */
+img.nav-ic { filter: brightness(0); }
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) img.nav-ic { filter: brightness(0) invert(1); }
+}
+:root[data-theme="dark"] img.nav-ic { filter: brightness(0) invert(1); }
