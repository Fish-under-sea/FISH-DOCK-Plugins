+++ b/internal/provider/credits_estimate_test.go
@@ -0,0 +1,62 @@
+package provider
+
+import (
+	"testing"
+	"time"
+)
+
+// creditEstimate 是"今日额度回补"的估计：只认日间用量回落这一个证据，
+// 没有证据的厂商不出现——页面按"有则显示 ≈+N、无则不显示"处理。
+
+func TestEstimateRefillsNeedsAFallInUsage(t *testing.T) {
+	now := time.Date(2026, 10, 28, 12, 0, 0, 0, time.Local)
+	today := now.Format("2006-01-02")
+	yesterday := now.AddDate(0, 0, -1).Format("2006-01-02")
+
+	accts := map[string]*creditsAccount{
+		// 回落：昨日用了 80，今日回到 20 => 回补 60
+		"claude|a@b|Credits": {Since: yesterday, Days: map[string]float64{yesterday: 80, today: 20}},
+		// 没回落：今日用得不比昨日少，没有到账证据
+		"codex|a@b|Credits": {Since: yesterday, Days: map[string]float64{yesterday: 10, today: 30}},
+		// 只有今天：没有昨日读数
+		"qoder|a@b|Credits": {Since: yesterday, Days: map[string]float64{today: 5}},
+		// 读数从今天才开始：昨日那个"0"不是读数
+		"zcode|a@b|Credits": {Since: today, Days: map[string]float64{yesterday: 40, today: 5}},
+	}
+	got := estimateRefills(accts, now)
+	if got["claude"] != 60 {
+		t.Fatalf("claude = %v, want 60 (%v)", got["claude"], got)
+	}
+	if _, ok := got["codex"]; ok {
+		t.Fatalf("codex 没有回落证据却被给了估计: %v", got["codex"])
+	}
+	if _, ok := got["qoder"]; ok {
+		t.Fatalf("qoder 缺昨日读数却给了估计: %v", got["qoder"])
+	}
+	if _, ok := got["zcode"]; ok {
+		t.Fatalf("zcode 的 Since 是今天，昨日的 0 是空白不是读数: %v", got["zcode"])
+	}
+}
+
+func TestEstimateRefillsSumsAcrossAccounts(t *testing.T) {
+	now := time.Date(2026, 10, 28, 12, 0, 0, 0, time.Local)
+	today := now.Format("2006-01-02")
+	yesterday := now.AddDate(0, 0, -1).Format("2006-01-02")
+	accts := map[string]*creditsAccount{
+		"claude|a@b|Credits": {Since: yesterday, Days: map[string]float64{yesterday: 50, today: 10}},
+		"claude|c@d|Credits": {Since: yesterday, Days: map[string]float64{yesterday: 30, today: 10}},
+	}
+	got := estimateRefills(accts, now)
+	if got["claude"] != 60 {
+		t.Fatalf("claude = %v, want 60（两个账号各自回补之和）", got["claude"])
+	}
+}
+
+func TestEstimateRefillsEmptyIsNil(t *testing.T) {
+	if got := estimateRefills(nil, time.Now()); got != nil {
+		t.Fatalf("空输入给了 %v", got)
+	}
+	if got := estimateRefills(map[string]*creditsAccount{"claude|a|C": nil}, time.Now()); got != nil {
+		t.Fatalf("nil 账号给了 %v", got)
+	}
+}
