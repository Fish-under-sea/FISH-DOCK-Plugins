diff --git a/internal/memagent/audit.go b/internal/memagent/audit.go
new file mode 100644
index 0000000..9a39cf1
--- /dev/null
+++ b/internal/memagent/audit.go
@@ -0,0 +1,285 @@
+package memagent
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/memory"
+)
+
+// What a memory agent did to memory, and what it couldn't: every change a
+// run makes is kept in an append-only log, one JSON object a line, so a
+// later look can say what was saved, forgotten, removed, promoted or set
+// aside, by which role and which agent, and whether it went through. A
+// conflict — a machine change to what the user wrote — is kept beside the
+// memories in the vault's logs folder, where the user reads it, and the
+// memory itself is left as they wrote it.
+
+// The actions an audit line names: what a machine change did to memory.
+const (
+	AuditSave    = "save"
+	AuditForget  = "forget"
+	AuditRemove  = "remove"
+	AuditPromote = "promote"
+	AuditStatus  = "status"
+)
+
+// AuditPath is the audit log, one JSON object a line; a variable for tests.
+// It is replaced whole by no one: a line is appended and flushed, and the
+// last good generation isn't kept (lastgood) — a line that made it to disk
+// stays, and a line that didn't is one no one claims.
+var AuditPath = func() string { return appdir.Join(appdir.Config(), "memory-audit.jsonl") }
+
+// ConflictsPath is where a conflict is written, inside the vault:
+// logs/memory-conflicts.md, a folder a run may write.
+const ConflictsPath = "logs/memory-conflicts.md"
+
+// MaxAuditLine is the longest line one entry may make: a memory's text is
+// never in it, so a line is short; one over this is cut rather than written
+// whole, and a run's log stays a log.
+const MaxAuditLine = 4 << 10
+
+// Audit is one machine change to memory, as memory-audit.jsonl keeps it.
+type Audit struct {
+	At     time.Time `json:"at"`
+	Action string    `json:"action"`
+	ID     string    `json:"id,omitempty"`
+	Role   string    `json:"role,omitempty"`
+	Agent  string    `json:"agent,omitempty"`
+	// Result is what happened: added, merged, changed, forgotten, removed,
+	// promoted, status, or refused (and then Error says why).
+	Result string `json:"result"`
+	// Scope and Kind are what the memory is, when the change made or
+	// changed one: enough to read the log without reading memory.
+	Scope string `json:"scope,omitempty"`
+	Kind  string `json:"kind,omitempty"`
+	Error string `json:"error,omitempty"`
+}
+
+// auditMu keeps one append at a time in this process, so two lines written
+// at once are two whole lines: a write is one call with the line's newline,
+// and POSIX and Windows both place it whole or not at all under it.
+var auditMu sync.Mutex
+
+// LogAudit appends one line to memory-audit.jsonl. A log that can't be
+// written is noted and otherwise passed over: audit never stops a change
+// the user asked for, and a run's result stands whatever the log says.
+func LogAudit(a Audit) {
+	if a.At.IsZero() {
+		a.At = now().UTC()
+	} else {
+		a.At = a.At.UTC()
+	}
+	if a.Agent == "" {
+		a.Agent = AgentID
+	}
+	b, err := json.Marshal(a)
+	if err != nil {
+		log.Printf("memory: audit: %v", err)
+		return
+	}
+	if len(b) > MaxAuditLine {
+		b = b[:MaxAuditLine]
+	}
+	b = append(b, '\n')
+	if err := appendLines(AuditPath(), b); err != nil {
+		log.Printf("memory: audit: %s: %v", AuditPath(), err)
+	}
+}
+
+// appendLines adds b to path, making the folder above it when it isn't
+// there, and one line a call: a line is appended whole or not at all.
+func appendLines(p string, b []byte) error {
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		return err
+	}
+	auditMu.Lock()
+	defer auditMu.Unlock()
+	f, err := os.OpenFile(p, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
+	if err != nil {
+		return err
+	}
+	_, werr := f.Write(b)
+	if werr == nil {
+		werr = f.Sync()
+	}
+	cerr := f.Close()
+	if werr != nil {
+		return werr
+	}
+	return cerr
+}
+
+// AuditSave records a memory_save: whether it added the memory, merged into
+// one already there, or changed one it named, and its scope and kind.
+func NewAuditSave(role string, m *memory.Memory, added bool, wasID string, err error) Audit {
+	act := Audit{Action: AuditSave, Role: role, Agent: AgentID}
+	if err != nil {
+		act.Result, act.Error = "refused", err.Error()
+		if wasID != "" {
+			act.ID = wasID
+		}
+		return act
+	}
+	act.ID, act.Scope, act.Kind = m.ID, m.Scope, m.Kind
+	switch {
+	case added:
+		act.Result = "added"
+	case wasID != "":
+		act.Result = "changed"
+	default:
+		act.Result = "merged"
+	}
+	return act
+}
+
+// AuditChange records a change to an existing memory: forgotten, removed,
+// promoted or given a status.
+func NewAuditChange(action, role, id, result string, err error) Audit {
+	act := Audit{Action: action, Role: role, ID: id, Agent: AgentID, Result: result}
+	if err != nil {
+		act.Result, act.Error = "refused", err.Error()
+	}
+	return act
+}
+
+// ConflictError is a machine change refused because the memory is the
+// user's: it says which memory, and what was tried.
+type ConflictError struct {
+	ID   string
+	What string
+	// User is what the memory says, when it was read.
+	User string
+}
+
+func (e *ConflictError) Error() string {
+	return fmt.Sprintf("memory %s is the user's own (%s); a machine change leaves it as they wrote it: %s", e.ID, e.What, e.User)
+}
+
+// IsConflict says whether err is a machine change refused because the
+// memory is the user's.
+func IsConflict(err error) bool {
+	var c *ConflictError
+	return errors.As(err, &c)
+}
+
+// refused reports whether a machine change to m is refused, and every way
+// the memory is the user's: one they wrote (origin=user) and one they
+// edited are often both true, and the note says both so the reader can
+// tell which record made it theirs.
+func refused(m *memory.Memory) (bool, string) {
+	if m == nil {
+		return false, ""
+	}
+	var why []string
+	if m.Origin == memory.FromUser {
+		why = append(why, "origin=user")
+	}
+	if !m.Edited.IsZero() {
+		why = append(why, "edited by the user")
+	}
+	return len(why) > 0, strings.Join(why, ", ")
+}
+
+// refusedChange is the conflict a change to m with in is refused for, or
+// nil when the change may go. A change that names nothing the user wrote —
+// setting the status of their own memory aside, or merging the same text —
+// is the machine's to make; what is refused is rewriting their words, the
+// pinned the machine would unpin, or the text it would replace.
+func refusedChange(m *memory.Memory, in memory.Input) *ConflictError {
+	if m == nil {
+		return nil
+	}
+	no, why := refused(m)
+	if !no {
+		return nil
+	}
+	// the user's own memory keeps its words: a machine change that only
+	// asks for a status leaves the text, kind, scope and why alone
+	rewrites := in.Text != nil || in.Kind != nil || in.Scope != nil || in.Why != nil
+	if m.Pinned && in.Pinned != nil && !*in.Pinned {
+		rewrites = true
+	}
+	if !rewrites {
+		return nil
+	}
+	return &ConflictError{ID: m.ID, What: why, User: oneLine(m.Text)}
+}
+
+// FindMemory is the memory with id, or nil when there is none.
+func FindMemory(id string) (*memory.Memory, error) {
+	m, err := memory.Get(id)
+	if errors.Is(err, memory.ErrNotFound) {
+		return nil, nil
+	}
+	return m, err
+}
+
+// LogConflict appends a conflict to the vault's logs/memory-conflicts.md,
+// through the run's sandbox: it is inside the folders a run may write, and
+// nothing outside them is ever reached. The memory itself isn't touched.
+// A conflict that can't be written is noted in the audit line and passed
+// over: the refusal still stands, and the memory is still the user's.
+func LogConflict(sb *Sandbox, role string, c *ConflictError, action string) error {
+	if sb == nil || c == nil {
+		return errors.New("no vault to write a conflict into")
+	}
+	var b strings.Builder
+	fmt.Fprintf(&b, "\n## %s\n\n", now().UTC().Format(time.RFC3339))
+	fmt.Fprintf(&b, "- action: %s\n", action)
+	fmt.Fprintf(&b, "- role: %s\n", role)
+	fmt.Fprintf(&b, "- memory: %s\n", mdEscape(c.ID))
+	fmt.Fprintf(&b, "- why refused: %s\n", c.What)
+	fmt.Fprintf(&b, "- the user's words: %s\n", mdEscape(redact(oneLine(c.User), 300)))
+	b.WriteString("- the memory was left as the user wrote it.\n")
+	return sb.Append(ConflictsPath, []byte(b.String()))
+}
+
+// mdEscape keeps a value on one line in the note, and out of the Markdown's
+// own syntax: a memory's words are text, never a heading or a list.
+func mdEscape(s string) string {
+	s = strings.NewReplacer("\r", " ", "\n", " ").Replace(s)
+	return strings.NewReplacer("`", "\\`", "*", "\\*", "_", "\\_", "[", "\\[", "]", "\\]", "<", "&lt;", ">", "&gt;").Replace(s)
+}
+
+// redact takes what looks like a secret out of text that goes into a file
+// the user reads and may share: a token or a key in a memory's words is
+// replaced, never copied into the log.
+func redact(s string, max int) string {
+	fields := strings.Fields(s)
+	for i, f := range fields {
+		if secretish(f) {
+			fields[i] = "[redacted]"
+		}
+	}
+	s = strings.Join(fields, " ")
+	if r := []rune(s); len(r) > max {
+		s = string(r[:max]) + "…"
+	}
+	return s
+}
+
+// secretish says whether a word is a secret's shape: a long unbroken run of
+// letters and digits, a key prefix, or a token with a separator and enough
+// after it to be one.
+func secretish(w string) bool {
+	w = strings.Trim(w, "`.,;:()\"'")
+	lower := strings.ToLower(w)
+	for _, p := range []string{"sk-", "ghp_", "gho_", "github_pat_", "xoxb-", "xoxp-", "ak-", "api_key=", "token=", "password=", "secret="} {
+		if strings.HasPrefix(lower, p) && len(w) > len(p)+8 {
+			return true
+		}
+	}
+	if strings.ContainsAny(w, "_") && len(w) > 40 && !strings.ContainsAny(w, " .:/") {
+		return true
+	}
+	return len(w) > 48 && !strings.ContainsAny(w, " .:/=\"'")
+}
