+++ b/internal/memagent/audit_conflict_test.go
@@ -0,0 +1,322 @@
+package memagent
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/yetone/magpie/internal/memory"
+)
+
+// conflictAt points the audit log at a file of the test's own, and gives
+// the tools the vault a conflict is written into.
+func conflictAt(t *testing.T) (string, *Sandbox) {
+	t.Helper()
+	auditAt(t)
+	sb, dir := openVault(t)
+	return dir, sb
+}
+
+// save runs memory_save as a run of role does, through the tool a model is
+// given rather than its handler, so what is wired is what is tested.
+func saveThrough(t *testing.T, sb *Sandbox, role string, args map[string]any) (string, error) {
+	t.Helper()
+	set, err := toolsFor(sb, nil, role, &runLog{}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tool, ok := set.Get(ToolMemorySave)
+	if !ok {
+		t.Fatal("no memory_save")
+	}
+	b, _ := json.Marshal(args)
+	return tool.Call(context.Background(), b)
+}
+
+func forgetThrough(t *testing.T, sb *Sandbox, role, id string) (string, error) {
+	t.Helper()
+	set, err := toolsFor(sb, nil, role, &runLog{}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tool, _ := set.Get(ToolMemoryForget)
+	b, _ := json.Marshal(map[string]any{"id": id})
+	return tool.Call(context.Background(), b)
+}
+
+// A memory the user wrote is theirs: a machine change is refused, the
+// refusal is written into the vault's logs/memory-conflicts.md, and the
+// memory itself is left exactly as they wrote it.
+func TestConflictWithTheUsersMemory(t *testing.T) {
+	dir, sb := conflictAt(t)
+	text, kind, scope := "I write in Chinese", memory.Preference, memory.Global
+	user, _, err := memory.Save(memory.Input{Text: &text, Kind: &kind, Scope: &scope}, memory.FromUser, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before, _ := json.Marshal(user)
+	t.Logf("conflict dir=%q", dir)
+
+	// the machine tries to rewrite their words
+	if _, err := saveThrough(t, sb, Learn, map[string]any{"id": user.ID, "text": "I write in English", "kind": "preference"}); !IsConflict(err) {
+		t.Fatalf("a rewrite of the user's memory: %v", err)
+	}
+	// and to set it aside
+	if _, err := forgetThrough(t, sb, Dream, user.ID); !IsConflict(err) {
+		t.Fatalf("forget of the user's memory: %v", err)
+	}
+
+	after, err := memory.Get(user.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := json.Marshal(after); string(b) != string(before) {
+		t.Fatalf("the user's memory changed:\n%+v\nwas\n%s", after, before)
+	}
+	// the conflict is written, inside the vault, only added to
+	b, err := os.ReadFile(filepath.Join(dir, filepath.FromSlash(ConflictsPath)))
+	if err != nil {
+		t.Fatalf("the conflict log: %v", err)
+	}
+	s := string(b)
+	for _, want := range []string{mdEscape(user.ID), "origin=user", "I write in Chinese", AuditSave, AuditForget, "left as the user wrote it"} {
+		if !strings.Contains(s, want) {
+			t.Errorf("the conflict log doesn't say %q:\n%s", want, s)
+		}
+	}
+	if strings.Count(s, mdEscape(user.ID)) < 2 {
+		t.Errorf("both refusals aren't there:\n%s", s)
+	}
+	// each refusal is audited as a conflict
+	got := lines(t, AuditPath())
+	var conflicts int
+	for _, a := range got {
+		if a.Result == "conflict" && a.ID == user.ID {
+			conflicts++
+		}
+	}
+	if conflicts != 2 {
+		t.Fatalf("%d conflicts audited: %+v", conflicts, got)
+	}
+}
+
+// A memory the user edited is theirs too, even when a machine saved it
+// first: the edit is what makes it theirs.
+func TestConflictWithAnEditedMemory(t *testing.T) {
+	dir, sb := conflictAt(t)
+	out, err := saveThrough(t, sb, Organize, map[string]any{"text": "Builds run on mote", "kind": "fact"})
+	if err != nil || !strings.Contains(out, "Remembered") {
+		t.Fatalf("%q %v", out, err)
+	}
+	all, _, err := memory.All()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var id string
+	for _, m := range all {
+		if m.Text == "Builds run on mote" {
+			id = m.ID
+		}
+	}
+	if id == "" {
+		t.Fatalf("the saved memory isn't there: %v", all)
+	}
+	// the user edits it
+	edited := "Builds run on the machine called mote"
+	if _, err := memory.Edit(id, memory.Input{Text: &edited}, true); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := saveThrough(t, sb, Learn, map[string]any{"id": id, "text": "something else", "kind": "fact"}); !IsConflict(err) {
+		t.Fatalf("a rewrite of an edited memory: %v", err)
+	}
+	m, _ := memory.Get(id)
+	if m.Text != edited {
+		t.Fatalf("the user's edit was rewritten: %q", m.Text)
+	}
+	b, err := os.ReadFile(filepath.Join(dir, filepath.FromSlash(ConflictsPath)))
+	if err != nil {
+		t.Fatalf("the conflict log: %v", err)
+	}
+	if !strings.Contains(string(b), "origin=user") || !strings.Contains(string(b), "edited by the user") {
+		t.Fatalf("the conflict doesn't say why:\n%s", b)
+	}
+}
+
+// A change that leaves the user's words alone is not a conflict: the run
+// may still save what is new, and forget what isn't theirs.
+func TestNoConflictWithoutRewriting(t *testing.T) {
+	_, sb := conflictAt(t)
+	text, kind, scope := "Deploys go out on Fridays", memory.Rule, memory.Global
+	if _, _, err := memory.Save(memory.Input{Text: &text, Kind: &kind, Scope: &scope}, memory.FromUser, nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	// a new memory, unrelated to theirs, goes through
+	if out, err := saveThrough(t, sb, Learn, map[string]any{"text": "Use bun for scripts", "kind": "procedure"}); err != nil || !strings.Contains(out, "Remembered") {
+		t.Fatalf("%q %v", out, err)
+	}
+	// one of the machine's own can be forgotten
+	out, err := saveThrough(t, sb, Learn, map[string]any{"text": "Tests run on the box", "kind": "fact"})
+	if err != nil || !strings.Contains(out, "Remembered") {
+		t.Fatalf("%q %v", out, err)
+	}
+	all, _, _ := memory.All()
+	var mine string
+	for _, m := range all {
+		if m.Text == "Tests run on the box" {
+			mine = m.ID
+		}
+	}
+	if _, err := forgetThrough(t, sb, Dream, mine); err != nil {
+		t.Fatalf("forget of the machine's own: %v", err)
+	}
+	if m, _ := memory.Get(mine); m.Status != memory.Archived {
+		t.Fatalf("the machine's memory wasn't set aside: %+v", m)
+	}
+}
+
+// What the tools are given is still the vault's allowlist: a conflict goes
+// into logs/, and a sandbox that refuses logs/ refuses the conflict rather
+// than writing elsewhere. Nothing outside the vault is ever reached.
+func TestConflictStaysInTheWhitelist(t *testing.T) {
+	auditAt(t)
+	// a sandbox whose writable folders leave logs out
+	dir := vault(t)
+	sb, err := OpenSandbox(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sb.Close()
+	old := Writable
+	Writable = []string{"dreams"}
+	t.Cleanup(func() { Writable = old })
+	text, kind, scope := "I write in Chinese", memory.Preference, memory.Global
+	user, _, err := memory.Save(memory.Input{Text: &text, Kind: &kind, Scope: &scope}, memory.FromUser, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := &ConflictError{ID: user.ID, What: "origin=user", User: "I write in Chinese"}
+	if err := LogConflict(sb, Learn, c, AuditSave); err == nil {
+		t.Fatal("a conflict was written into a folder the run may not use")
+	}
+	// and it wasn't written anywhere else in the vault
+	if _, err := os.Lstat(filepath.Join(dir, "logs", "memory-conflicts.md")); err == nil {
+		t.Fatal("the conflict was written into logs/, which the run may not use here")
+	}
+	// the refusal stands, and the audit says the conflict couldn't be written
+	if _, err := saveThrough(t, sb, Learn, map[string]any{"id": user.ID, "text": "x"}); !IsConflict(err) {
+		t.Fatalf("the refusal: %v", err)
+	}
+	var noted bool
+	for _, a := range lines(t, AuditPath()) {
+		if strings.Contains(a.Error, "conflict not written") {
+			noted = true
+		}
+	}
+	if !noted {
+		t.Fatal("the audit doesn't say the conflict couldn't be written")
+	}
+}
+
+// A memory's words that look like a secret are not copied into the
+// conflict log the user may share.
+func TestConflictRedactsSecrets(t *testing.T) {
+	dir, sb := conflictAt(t)
+	// a key's shape: a prefix and a long run after it. Built here, never
+	// written out, so no key-shaped literal sits in this source for a scanner
+	// to mistake for a live one.
+	secret := "sk-" + "proj-" + strings.Repeat("a1B2c3D4e5", 4)
+	text, scope := "the key is "+secret, memory.Global
+	user, _, err := memory.Save(memory.Input{Text: &text, Scope: &scope}, memory.FromUser, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := forgetThrough(t, sb, Learn, user.ID); !IsConflict(err) {
+		t.Fatalf("%v", err)
+	}
+	b, err := os.ReadFile(filepath.Join(dir, filepath.FromSlash(ConflictsPath)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(b), secret) {
+		t.Fatalf("a secret was copied into the conflict log:\n%s", b)
+	}
+	if !strings.Contains(string(b), "\\[redacted\\]") {
+		t.Fatalf("the secret wasn't marked as one:\n%s", b)
+	}
+	// a sentence's words aren't secrets: they stay
+	if !strings.Contains(string(b), "the key is") {
+		t.Fatalf("what isn't a secret was taken out:\n%s", b)
+	}
+}
+
+// The conflict log is added to, never rewritten: a second run's conflict
+// leaves the first's lines as they were.
+func TestConflictLogIsAppendOnly(t *testing.T) {
+	dir, sb := conflictAt(t)
+	first, second := "the deployer is named boatswain", "the staging host is named skiff"
+	var ids []string
+	for _, s := range []string{first, second} {
+		text, scope := s, memory.Global
+		m, _, err := memory.Save(memory.Input{Text: &text, Scope: &scope}, memory.FromUser, nil, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, m.ID)
+	}
+	for _, id := range ids {
+		if _, err := forgetThrough(t, sb, Learn, id); !IsConflict(err) {
+			t.Fatalf("forget %s: %v", id, err)
+		}
+	}
+	b, err := os.ReadFile(filepath.Join(dir, filepath.FromSlash(ConflictsPath)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(b), first) || !strings.Contains(string(b), second) {
+		t.Fatalf("one of the conflicts was lost:\n%s", b)
+	}
+	// the first block is still whole and first: nothing was rewritten
+	if i, j := strings.Index(string(b), first), strings.Index(string(b), second); i < 0 || j < 0 || i > j {
+		t.Fatalf("the order isn't the order they happened in:\n%s", b)
+	}
+}
+
+// Several runs refusing at once: the note is whole, never interleaved.
+func TestConflictLogConcurrentAppends(t *testing.T) {
+	dir, sb := conflictAt(t)
+	const n = 32
+	var wg sync.WaitGroup
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			c := &ConflictError{ID: pad(i), What: "origin=user", User: "the user's words"}
+			if err := LogConflict(sb, Learn, c, AuditSave); err != nil {
+				t.Errorf("conflict %d: %v", i, err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	b, err := os.ReadFile(filepath.Join(dir, filepath.FromSlash(ConflictsPath)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := strings.Count(string(b), "- action: save"); got != n {
+		t.Fatalf("%d conflicts written, want %d", got, n)
+	}
+	// every block is whole: each has its why line and its last line
+	if strings.Count(string(b), "- why refused: origin=user") != n ||
+		strings.Count(string(b), "left as the user wrote it") != n {
+		t.Fatalf("a block was cut:\n%s", b)
+	}
+	// each memory's block appears once, and with its own id
+	for i := 0; i < n; i++ {
+		if got := strings.Count(string(b), "- memory: "+pad(i)); got != 1 {
+			t.Fatalf("memory %s appears %d times", pad(i), got)
+		}
+	}
+}
diff --git a/internal/memagent/audit_test.go b/internal/memagent/audit_test.go
new file mode 100644
index 0000000..752bf3f
--- /dev/null
+++ b/internal/memagent/audit_test.go
@@ -0,0 +1,151 @@
+package memagent
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/yetone/magpie/internal/memory"
+)
+
+// auditAt points the audit log at a file of the test's own.
+func auditAt(t *testing.T) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "memory-audit.jsonl")
+	old := AuditPath
+	AuditPath = func() string { return p }
+	t.Cleanup(func() { AuditPath = old })
+	return p
+}
+
+// lines is the audit log's lines, each decoded.
+func lines(t *testing.T, p string) []Audit {
+	t.Helper()
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatalf("the audit log: %v", err)
+	}
+	var out []Audit
+	for _, line := range strings.Split(strings.TrimRight(string(b), "\n"), "\n") {
+		if line == "" {
+			continue
+		}
+		var a Audit
+		if err := json.Unmarshal([]byte(line), &a); err != nil {
+			t.Fatalf("a line that isn't an entry: %q: %v", line, err)
+		}
+		out = append(out, a)
+	}
+	return out
+}
+
+// One change is one line, with what it did: the action, the memory, the
+// role and the agent.
+func TestAuditRecordsOneLine(t *testing.T) {
+	p := auditAt(t)
+	text, kind, scope := "Releases go out on Tuesdays", "fact", "global"
+	LogAudit(NewAuditSave(Learn, &memory.Memory{ID: "m_1", Text: text, Kind: kind, Scope: scope}, true, "",
+		nil))
+	got := lines(t, p)
+	if len(got) != 1 {
+		t.Fatalf("%d lines", len(got))
+	}
+	a := got[0]
+	if a.Action != AuditSave || a.ID != "m_1" || a.Role != Learn || a.Agent != AgentID || a.Result != "added" || a.Kind != kind || a.Scope != scope {
+		t.Fatalf("%+v", a)
+	}
+	if a.At.IsZero() {
+		t.Fatal("no time")
+	}
+	// a second entry is a second line, and neither rewrote the other
+	LogAudit(NewAuditChange(AuditForget, Dream, "m_2", "forgotten", nil))
+	got = lines(t, p)
+	if len(got) != 2 || got[1].Action != AuditForget || got[1].Result != "forgotten" || got[0].ID != "m_1" {
+		t.Fatalf("%+v", got)
+	}
+}
+
+// A log that can't be written is passed over: no panic, no error to the
+// caller, and the change goes on. The audit is never what stops a run.
+func TestAuditFailureDoesNotStop(t *testing.T) {
+	dir := t.TempDir()
+	// a folder where the log's file would be: every append fails
+	p := filepath.Join(dir, "memory-audit.jsonl")
+	if err := os.MkdirAll(filepath.Join(p, "in-the-way"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	old := AuditPath
+	AuditPath = func() string { return p }
+	t.Cleanup(func() { AuditPath = old })
+	// the log line is dropped, and nothing is returned or thrown
+	LogAudit(NewAuditChange(AuditSave, Learn, "m_1", "added", nil))
+	LogAudit(NewAuditSave(Learn, &memory.Memory{ID: "m_2"}, true, "", nil))
+}
+
+// The log holds no memory's words: a line is what changed, not what it
+// said, so a secret in a memory never reaches the log.
+func TestAuditHoldsNoText(t *testing.T) {
+	p := auditAt(t)
+	secret := "sk-live-0123456789abcdefghijklmnop"
+	LogAudit(NewAuditSave(Learn, &memory.Memory{ID: "m_9", Kind: "fact", Scope: "global"}, true, "", nil))
+	if b, _ := os.ReadFile(p); strings.Contains(string(b), secret) || strings.Contains(string(b), "text") {
+		t.Fatalf("the log holds the memory's words: %s", b)
+	}
+	// and a refusal's error says what, not what the memory said
+	LogAudit(NewAuditChange(AuditSave, Learn, "m_9", "", errors.New("a refused change")))
+	got := lines(t, p)
+	if got[1].Result != "refused" || got[1].Error != "a refused change" {
+		t.Fatalf("%+v", got[1])
+	}
+}
+
+// Many changes at once are many whole lines: an append is one write of one
+// line, so a line is never cut into another.
+func TestAuditConcurrentAppends(t *testing.T) {
+	p := auditAt(t)
+	const n = 64
+	var wg sync.WaitGroup
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			LogAudit(NewAuditChange(AuditSave, Learn, pad(i), "added", nil))
+		}(i)
+	}
+	wg.Wait()
+	got := lines(t, p)
+	if len(got) != n {
+		t.Fatalf("%d lines, want %d", len(got), n)
+	}
+	seen := map[string]bool{}
+	for _, a := range got {
+		if a.Action != AuditSave || a.Result != "added" || a.ID == "" {
+			t.Fatalf("a line that was cut or crossed: %+v", a)
+		}
+		if seen[a.ID] {
+			t.Fatalf("%s kept twice", a.ID)
+		}
+		seen[a.ID] = true
+	}
+}
+
+// A line longer than the log allows is cut, not written whole: a log stays
+// lines, whatever a caller puts in one.
+func TestAuditLineIsBounded(t *testing.T) {
+	p := auditAt(t)
+	LogAudit(NewAuditChange(AuditSave, Learn, strings.Repeat("a", MaxAuditLine*2), "added", nil))
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(b) > MaxAuditLine+1 {
+		t.Fatalf("a line of %d bytes", len(b))
+	}
+	if strings.Count(string(b), "\n") != 1 {
+		t.Fatalf("the line spans more than one: %q", b)
+	}
+}
