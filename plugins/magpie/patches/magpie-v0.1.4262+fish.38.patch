@@ -0,0 +1,125 @@
+package memagent
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/memory"
+)
+
+// callTool runs one of a run's tools by name, as a model's call does.
+func callTool(t *testing.T, sb *Sandbox, role, name string, args map[string]any) (string, error) {
+	t.Helper()
+	set, err := toolsFor(sb, nil, role, &runLog{}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tool, ok := set.Get(name)
+	if !ok {
+		t.Fatalf("no %s", name)
+	}
+	b, _ := json.Marshal(args)
+	return tool.Call(context.Background(), b)
+}
+
+// The changes that aren't a run's own save are audited too: a removal, a
+// promotion and a status each leave their line.
+func TestAuditOfRemovePromoteStatus(t *testing.T) {
+	auditAt(t)
+	sb, _ := openVault(t)
+	// two of the machine's own, and one the user wrote
+	mine, _, err := memory.Save(memory.Input{Text: p("Tests run on the box"), Kind: p("fact"), Scope: p("global")}, memory.FromAgent, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	theirs, _, err := memory.Save(memory.Input{Text: p("I write in Chinese"), Kind: p("preference"), Scope: p("global")}, memory.FromUser, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	out, err := callTool(t, sb, Learn, ToolMemoryRemove, map[string]any{"ids": []string{mine.ID, theirs.ID}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out, "Removed: "+mine.ID) || !strings.Contains(out, "kept, they are the user's own: "+theirs.ID) {
+		t.Fatalf("%q", out)
+	}
+	// the user's is still there, and the refusal is in the conflict log
+	if _, err := memory.Get(theirs.ID); err != nil {
+		t.Fatalf("the user's memory was removed: %v", err)
+	}
+	if _, err := memory.Get(mine.ID); err == nil {
+		t.Fatal("the machine's memory wasn't removed")
+	}
+
+	// a candidate set aside, and a promotion
+	cand, _, err := memory.Save(memory.Input{Text: p("Nightly tidy runs at three"), Scope: p("agent:" + AgentID), Status: p(memory.Candidate)}, memory.FromAgent, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out, err := callTool(t, sb, Organize, ToolMemoryStatus, map[string]any{"status": memory.Archived, "ids": []string{cand.ID}}); err != nil || !strings.Contains(out, "archived") {
+		t.Fatalf("%q %v", out, err)
+	}
+	// the user's own isn't a machine's to take out of use
+	if _, err := callTool(t, sb, Organize, ToolMemoryStatus, map[string]any{"status": memory.Archived, "ids": []string{theirs.ID}}); err == nil {
+		t.Fatal("a machine set the user's memory aside")
+	}
+
+	got := lines(t, AuditPath())
+	seen := map[string]int{}
+	for _, a := range got {
+		seen[a.Action]++
+	}
+	for _, action := range []string{AuditRemove, AuditStatus} {
+		if seen[action] == 0 {
+			t.Errorf("no %s line: %+v", action, got)
