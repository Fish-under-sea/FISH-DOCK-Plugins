+package gui
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/memagent"
+)
+
+// fishAgentsAt points the registry at a folder of the test's own, so a route
+// never reads or writes the user's memory-agents.json.
+func fishAgentsAt(t *testing.T) {
+	t.Helper()
+	dir := t.TempDir()
+	old := memagent.Path
+	memagent.Path = func() string { return filepath.Join(dir, "memory-agents.json") }
+	t.Cleanup(func() { memagent.Path = old })
+}
+
+func fishVaultMux(t *testing.T) *http.ServeMux {
+	t.Helper()
+	mux := http.NewServeMux()
+	memoryRoutes(mux)
+	return mux
+}
+
+// fishCall is one request as the Obsidian plugin makes it: the pairing token,
+// no Origin, from this computer.
+func fishCall(t *testing.T, mux *http.ServeMux, method, path, body, token string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	req.RemoteAddr = "127.0.0.1:5"
+	req.Header.Set("X-Fish-Obsidian-Token", token)
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, req)
+	return rec
+}
+
+// The memory agents the Obsidian plugin lists are the registry's, by id and
+// name: the model a run is sent to is never offered, and an admin cookie
+// without the pairing token gets nothing.
+func TestFishVaultMemoryAgentsRoute(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	if _, err := memagent.Restore(); err != nil {
+		t.Fatal(err)
+	}
+	rec := fishCall(t, mux, "GET", "/api/fish-vault/memory/agents", "", token)
+	if rec.Code != 200 {
+		t.Fatalf("agents: %d %s", rec.Code, rec.Body)
+	}
+	var v struct {
+		Agents   []struct{ ID, Name string }
+		Defaults map[string]string
+		Roles    []string
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &v); err != nil {
+		t.Fatalf("agents: %s", rec.Body)
+	}
+	if len(v.Agents) != 2 {
+		t.Fatalf("agents: %+v", v.Agents)
+	}
+	for _, a := range v.Agents {
+		if a.ID == "" || a.Name == "" {
+			t.Fatalf("an agent without id or name: %+v", a)
+		}
+	}
+	// no model, no route: what the plugin shows is a name to pick
+	if strings.Contains(strings.ToLower(rec.Body.String()), "deepseek") {
+		t.Fatalf("a model route leaked to the plugin: %s", rec.Body)
+	}
+	if v.Defaults[memagent.Learn] != "memory-curator" || v.Defaults[memagent.Dream] != "dreamer" {
+		t.Fatalf("defaults: %+v", v.Defaults)
+	}
+	// by role: only learn's agents are listed (the defaults name every role,
+	// so the page can show what each runs as)
+	rec = fishCall(t, mux, "GET", "/api/fish-vault/memory/agents?role=learn", "", token)
+	if rec.Code != 200 {
+		t.Fatalf("role learn: %d %s", rec.Code, rec.Body)
+	}
+	var byRole struct {
+		Agents []struct{ ID, Name string }
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &byRole); err != nil {
+		t.Fatalf("role learn: %s", rec.Body)
+	}
+	if len(byRole.Agents) != 1 || byRole.Agents[0].ID != "memory-curator" {
+		t.Fatalf("role learn listed: %+v", byRole.Agents)
+	}
+	for _, a := range byRole.Agents {
+		if a.ID == "dreamer" {
+			t.Fatalf("a dream agent was offered for learn: %+v", byRole.Agents)
+		}
+	}
+	// a role memory doesn't have is refused
+	if rec := fishCall(t, mux, "GET", "/api/fish-vault/memory/agents?role=nope", "", token); rec.Code != 400 {
+		t.Fatalf("an unknown role: %d", rec.Code)
+	}
+}
+
+// The plugin's routes need the pairing token, as every other one on this
+// surface does: a cookie alone, a wrong token, another host or an Origin
+// gets 403.
+func TestFishVaultMemoryRoutesNeedThePairingToken(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	for _, tc := range []struct {
+		name, token, origin, remote string
+		want                        int
+	}{
+		{"no token", "", "", "127.0.0.1:5", 403},
+		{"wrong token", "wrong", "", "127.0.0.1:5", 403},
+		{"an origin", token, "null", "127.0.0.1:5", 403},
+		{"another host", token, "", "192.0.2.1:5", 403},
+		{"the token", token, "", "127.0.0.1:5", 200},
+	} {
+		for _, path := range []string{
+			"/api/fish-vault/memory/agents",
+			"/api/fish-vault/memory/agents/status?role=learn",
+		} {
+			req := httptest.NewRequest("GET", path, nil)
+			req.RemoteAddr = tc.remote
+			req.Header.Set("X-Fish-Obsidian-Token", tc.token)
+			if tc.origin != "" {
+				req.Header.Set("Origin", tc.origin)
+			}
+			rec := httptest.NewRecorder()
+			mux.ServeHTTP(rec, req)
+			if rec.Code != tc.want {
+				t.Fatalf("%s %s: %d %s", tc.name, path, rec.Code, rec.Body)
+			}
+		}
+	}
+}
+
+// Status says what a role is doing (or its last run), refused for a role
+// memory doesn't have; the plugin polls it while one goes.
+func TestFishVaultMemoryStatusRoute(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	rec := fishCall(t, mux, "GET", "/api/fish-vault/memory/agents/status?role=organize", "", token)
+	if rec.Code != 200 {
+		t.Fatalf("status: %d %s", rec.Code, rec.Body)
+	}
+	var st memagent.Status
+	if err := json.Unmarshal(rec.Body.Bytes(), &st); err != nil {
+		t.Fatalf("status: %s", rec.Body)
+	}
+	if st.Running {
+		t.Fatalf("nothing should be running: %+v", st)
+	}
+	if rec := fishCall(t, mux, "GET", "/api/fish-vault/memory/agents/status?role=nope", "", token); rec.Code != 400 {
+		t.Fatalf("an unknown role: %d", rec.Code)
+	}
+}
+
+// A run the plugin asks for with an agent that doesn't carry the role out is
+// refused, and nothing starts; stopping a role that isn't going isn't an
+// error.
+func TestFishVaultMemoryRunAndStop(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	if _, err := memagent.Restore(); err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct{ path, body string }{
+		{"/api/fish-vault/memory/agents/learn/run", `{"agent":"dreamer"}`},
+		{"/api/fish-vault/memory/agents/learn/run", `{"agent":"not-there"}`},
+		{"/api/fish-vault/memory/agents/nope/run", `{}`},
+		{"/api/fish-vault/memory/agents/nope/stop", `{}`},
+	} {
+		if rec := fishCall(t, mux, "POST", c.path, c.body, token); rec.Code != 400 {
+			t.Fatalf("%s %s: %d %s", c.path, c.body, rec.Code, rec.Body)
+		}
+	}
+	if memagent.Running() {
+		t.Fatal("a refused run started")
+	}
+	rec := fishCall(t, mux, "POST", "/api/fish-vault/memory/agents/dream/stop", `{}`, token)
+	if rec.Code != 200 {
+		t.Fatalf("stop: %d %s", rec.Code, rec.Body)
+	}
+}
+
+// The GUI's own run routes are not the plugin's: the plugin's paths live
+// under /api/fish-vault, and the GUI's are cookie-authenticated. A plugin
+// token on the GUI's path does not open it, and the reverse holds too.
+func TestFishVaultMemoryRoutesStayOffTheGuiPaths(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	// the GUI's status is not served to the plugin's surface at all
+	rec := fishCall(t, mux, "GET", "/api/memory/agents/status?role=learn", "", token)
+	if rec.Code != http.StatusNotFound {
+		t.Fatalf("the plugin reached the GUI's status: %d %s", rec.Code, rec.Body)
+	}
+}
