+			m, err := FindMemory(id)
+			if err != nil {
+				LogAudit(NewAuditChange(AuditStatus, role, id, "", err))
+				return "", err
+			}
+			if m == nil {
+				continue
+			}
+			if no, _ := refused(m); no && (status == memory.Active || status == memory.Archived) {
+				return "", fmt.Errorf("memory %s is the user's own: only they decide whether it stays in use", m.ID)
+			}
+			ours = append(ours, m.ID)
+		}
+		n, err := memory.SetStatus(status, ours...)
+		for _, id := range ours {
+			LogAudit(NewAuditChange(AuditStatus, role, id, status, err))
+		}
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d memories are now %s", n, status), nil
+	}
+}
+
+// cleanIDs are ids as a call gives them: trimmed, without blanks or
+// repeats, in the order given.
+func cleanIDs(ids []string) []string {
+	out := make([]string, 0, len(ids))
+	for _, id := range ids {
+		id = strings.TrimSpace(id)
+		if id != "" && !slices.Contains(out, id) {
