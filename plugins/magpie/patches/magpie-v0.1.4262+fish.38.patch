+// A save is audited whoever makes it, and what it did is what the line
+// says: added, merged, changed or refused.
+func TestAuditOfSaveResults(t *testing.T) {
+	auditAt(t)
+	sb, _ := openVault(t)
+	if out, err := callTool(t, sb, Learn, ToolMemorySave, map[string]any{"text": "Nightly tidy runs at three", "kind": "fact"}); err != nil || !strings.Contains(out, "Remembered") {
+		t.Fatalf("%q %v", out, err)
+	}
+	if out, err := callTool(t, sb, Learn, ToolMemorySave, map[string]any{"text": "Nightly tidy runs at three", "kind": "fact"}); err != nil || !strings.Contains(out, "Already remembered, merged") {
+		t.Fatalf("%q %v", out, err)
+	}
+	// a refused save is a line too, with its error
+	if _, err := callTool(t, sb, Learn, ToolMemorySave, map[string]any{}); err == nil {
+		t.Fatal("a save with no text went through")
+	}
+	got := lines(t, AuditPath())
+	if len(got) < 3 {
+		t.Fatalf("%d lines: %+v", len(got), got)
+	}
+	if got[0].Result != "added" || got[0].Action != AuditSave {
+		t.Fatalf("the first: %+v", got[0])
+	}
+	if got[1].Result != "merged" {
+		t.Fatalf("the second: %+v", got[1])
+	}
+	if got[len(got)-1].Result != "refused" || got[len(got)-1].Error == "" {
+		t.Fatalf("the refused one: %+v", got[len(got)-1])
+	}
+}
