diff --git a/internal/gui/memory_agents_run.go b/internal/gui/memory_agents_run.go
new file mode 100644
index 0000000..ea2fb70
--- /dev/null
+++ b/internal/gui/memory_agents_run.go
@@ -0,0 +1,262 @@
+package gui
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"slices"
+	"strings"
+
+	"github.com/yetone/magpie/internal/fishvault"
+	"github.com/yetone/magpie/internal/gateway"
+	"github.com/yetone/magpie/internal/memagent"
+	"github.com/yetone/magpie/internal/memdistill"
+)
+
+// Running a memory agent from the window, and watching it: a run reads
+// conversations (learn), tidies memory and inspirations (organize), or
+// dreams across the vault (dream), as the agent the registry names. The run
+// itself is memagent's: one at a time across magpies, cancellable, with its
+// progress and transcript kept in memory-agent status.
+//
+// The same handlers answer on two surfaces: the GUI's cookie-authenticated
+// routes (/api/memory/agents/...), and the Obsidian plugin's, behind the
+// private pairing token (fish_vault.go). Both start and stop the same runs,
+// read the same status, and offer the same agents: the actions are here, the
+// authentication is each surface's own.
+
+// memoryAgentsForView is the agents of role as a surface that may only offer
+// them lists: their ids and names, which role each carries out, and the one
+// each role runs as. The model a run is sent to is the entry's own route and
+// is never offered where a memory task is picked.
+type memoryAgentsForView struct {
+	Agents   []agentRef        `json:"agents"`
+	Defaults map[string]string `json:"defaults"`
+	Roles    []string          `json:"roles"`
+}
+
+// agentView is the agents of role as that view lists them: every one when
+// role is "", else those carrying it out.
+func agentView(role string) (*memoryAgentsForView, error) {
+	r, err := memagent.Load()
+	if err != nil {
+		return nil, err
+	}
+	v := &memoryAgentsForView{Agents: []agentRef{}, Defaults: map[string]string{}, Roles: memagent.Roles}
+	for _, a := range r.Agents {
+		if role != "" && !a.HasRole(role) {
+			continue
+		}
+		v.Agents = append(v.Agents, agentRef{ID: a.ID, Name: a.Name})
+	}
+	for k, id := range r.Defaults {
+		v.Defaults[k] = id
+	}
+	return v, nil
+}
+
+// roleParam is a role a request names, normalized as an entry's own is; ""
+// is every role, and a role memory doesn't have is an error.
+func roleParam(role string) (string, error) {
+	role = strings.ToLower(strings.TrimSpace(role))
+	if role != "" && !slices.Contains(memagent.Roles, role) {
+		return "", fmt.Errorf("role %q isn't one of %s", role, strings.Join(memagent.Roles, ", "))
+	}
+	return role, nil
+}
+
+// agentHandlers are the memory agents' actions, shared by every surface that
+// may offer them. Each writes its own answer; a surface only decides who may
+// ask (the GUI's cookie, the Obsidian plugin's pairing token).
+type agentHandlers struct{}
+
+// agents answers the agents of ?role= for a surface that lists them to pick
+// from: the ids and names only, with the roles and their defaults.
+func (agentHandlers) agents(rw http.ResponseWriter, r *http.Request) {
+	role, err := roleParam(r.URL.Query().Get("role"))
+	if err != nil {
+		fail(rw, err)
+		return
+	}
+	v, err := agentView(role)
+	if err != nil {
+		fail(rw, err)
+		return
+	}
+	writeJSON(rw, v)
+}
+
+// status answers the run going, when it is that role's, else the last one it
+// ran.
+func (agentHandlers) status(rw http.ResponseWriter, r *http.Request) {
+	role, err := roleParam(r.URL.Query().Get("role"))
+	if err != nil {
+		fail(rw, err)
+		return
+	}
+	writeJSON(rw, memagent.StatusOf(role))
+}
+
+// run starts a run of the role in the background: {agent?, model?, effort?}.
+// An agent that doesn't carry the role out is a 400 and nothing starts; a
+// run already going is a 409 with the status that says which.
+func (agentHandlers) run(rw http.ResponseWriter, r *http.Request) {
+	role, err := roleParam(r.PathValue("role"))
+	if err != nil {
+		fail(rw, err)
+		return
+	}
+	var in struct {
+		Agent  string `json:"agent"`
+		Model  string `json:"model"`
+		Effort string `json:"effort"`
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(rw, r.Body, 8192)).Decode(&in); err != nil && !errors.Is(err, io.EOF) {
+		fail(rw, err)
+		return
+	}
+	if in.Agent != "" {
+		if err := checkAgent(role, in.Agent); err != nil {
+			fail(rw, err)
+			return
+		}
+	}
+	if memagent.Running() {
+		rw.Header().Set("Content-Type", "application/json")
+		rw.WriteHeader(http.StatusConflict)
+		writeJSON(rw, memagent.StatusOf(role))
+		return
+	}
+	go runRole(role, in.Agent, in.Model, in.Effort)
+	st := memagent.StatusOf(role)
+	// the run's start is the goroutine's to record; the window polls until
+	// it says running
+	st.Role = role
+	writeJSON(rw, st)
+}
+
+// stop ends the run going: the request in flight is dropped and what it was
+// reading is read next time. One that isn't going is not an error.
+func (agentHandlers) stop(rw http.ResponseWriter, r *http.Request) {
+	role, err := roleParam(r.PathValue("role"))
+	if err != nil {
+		fail(rw, err)
+		return
+	}
+	memagent.Stop()
+	writeJSON(rw, memagent.StatusOf(role))
+}
+
+// memoryAgentRunRoutes are the memory agents' run on the GUI's surface: the
+// status a window polls, the run started and stopped. The agents themselves
+// and their CRUD are the Memory tab's (memory_agents.go); a surface that only
+// picks from them reads agentView.
+func memoryAgentRunRoutes(mux *http.ServeMux) {
+	h := agentHandlers{}
+	mux.HandleFunc("GET /api/memory/agents/status", h.status)
+	mux.HandleFunc("POST /api/memory/agents/{role}/run", h.run)
+	mux.HandleFunc("POST /api/memory/agents/{role}/stop", h.stop)
+}
+
+// dispatchInput is what memagent.Dispatch is given for a role, gathered
+// here: the conversations due (learn), the vault's notes within the sandbox
+// (dream and organize), the vault, and the gateway this process serves as
+// the model's turns.
+func dispatchInput(role, agent, model, effort string) (memagent.Input, error) {
+	role = strings.ToLower(strings.TrimSpace(role))
+	if !slices.Contains(memagent.Roles, role) {
+		return memagent.Input{}, fmt.Errorf("role %q isn't one of %s", role, strings.Join(memagent.Roles, ", "))
+	}
+	vault := fishvault.Root()
+	if vault == "" {
+		return memagent.Input{}, errors.New("no knowledge vault: the knowledge folder isn't set")
+	}
+	in := memagent.Input{
+		Role: role, Vault: vault, Agent: agent, Model: model, Effort: effort,
+		Ask: gatewayAsk(),
+	}
+	st, err := memdistill.Load()
+	if err != nil {
+		return memagent.Input{}, err
+	}
+	switch role {
+	case memagent.Learn:
+		// what is due by the range picked: quiet for 30 minutes, read once
+		cs, _, err := memagent.Conversations(memagent.ConversationQuery{
+			Limit: memagent.ReadLimit, Quiet: memagent.ReadQuiet, Since: st.Since,
+			Done: st.Done, SkipAgent: memagent.AgentID,
+		})
+		if err != nil {
+			return memagent.Input{}, err
+		}
+		in.Conversations = cs
+	case memagent.Dream, memagent.Organize:
+		sb, err := memagent.OpenSandbox(vault)
+		if err != nil {
+			return memagent.Input{}, err
+		}
+		defer sb.Close()
+		notes, err := memagent.Notes(sb, 0, 0)
+		if err != nil {
+			return memagent.Input{}, err
+		}
+		in.Notes = notes
+	}
+	// the scopes are the entry's, so a run works where its agent may keep
+	if r, err := memagent.Load(); err == nil {
+		if a, ok := agentEntry(r, role, agent); ok {
+			in.Scopes = memagent.ScopesFor(a)
+			if err := memagent.CheckScopes(in.Scopes); err != nil {
+				return memagent.Input{}, err
+			}
+		}
+	}
+	return in, nil
+}
+
+// agentEntry is the agent a run of role would take: the one named, else the
+// role's default.
+func agentEntry(r memagent.Registry, role, id string) (memagent.Agent, bool) {
+	if id = strings.TrimSpace(id); id != "" {
+		return r.Get(id)
+	}
+	return r.Default(role)
+}
+
+// gatewayAsk sends an agent's turns through the gateway this process
+// serves, as any agent's go: routed, masked and counted under the memory
+// agent's name. With no gateway served here it is the error a run shows.
+func gatewayAsk() memagent.Ask {
+	gw := served.Load()
+	if gw == nil {
+		return func(context.Context, memagent.Request) (memagent.Turn, error) {
+			return memagent.Turn{}, errors.New("the gateway isn't served by this magpie")
+		}
+	}
+	return memagent.GatewayAsk(gw.Handler(), gatewayBase())
+}
+
+// gatewayBase and gatewayToken are where this magpie's gateway listens and
+// the key a side job is sent with. Variables so a test need not start one.
+var (
+	gatewayBase  = func() string { return gateway.URL() }
+	gatewayToken = func(id string) string { return gateway.TokenFor(id) }
+)
+
+// runRole dispatches one role's run and keeps what stopped it from starting
+// for the row that shows the role.
+func runRole(role, agent, model, effort string) {
+	in, err := dispatchInput(role, agent, model, effort)
+	if err == nil {
+		_, err = memagent.Dispatch(backendCtx, in)
+	}
+	switch {
+	case err == nil, errors.Is(err, memagent.ErrRunning):
+		// ErrRunning: another run started first, and its status is its own
+	default:
+		noteRunError(role, err.Error())
+	}
+}
diff --git a/internal/gui/memory_agents_run_test.go b/internal/gui/memory_agents_run_test.go
new file mode 100644
index 0000000..d6c679c
--- /dev/null
+++ b/internal/gui/memory_agents_run_test.go
@@ -0,0 +1,336 @@
+package gui
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/memagent"
+	"github.com/yetone/magpie/internal/memdistill"
+)
+
+// timeNow is the clock the scheduler is asked about.
+func timeNow() time.Time { return time.Now() }
+
+// distillAt points both state files at a folder of the test's own: the
+// registry the agents come from and distill.json the switch and picks.
+func distillAt(t *testing.T) {
+	t.Helper()
+	dir := t.TempDir()
+	oldA, oldD := memagent.Path, memdistill.Path
+	memagent.Path = func() string { return filepath.Join(dir, "memory-agents.json") }
+	memdistill.Path = func() string { return filepath.Join(dir, "distill.json") }
+	t.Cleanup(func() { memagent.Path, memdistill.Path = oldA, oldD })
+}
+
+func distillMux(t *testing.T) *http.ServeMux {
+	t.Helper()
+	mux := http.NewServeMux()
+	memoryDistillRoutes(mux)
+	return mux
+}
+
+func distillGet(t *testing.T, mux *http.ServeMux, path string) (int, map[string]json.RawMessage) {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("GET", path, nil))
+	var v map[string]json.RawMessage
+	if rec.Code == 200 {
+		if err := json.Unmarshal(rec.Body.Bytes(), &v); err != nil {
+			t.Fatalf("%s: %s", path, rec.Body)
+		}
+	}
+	return rec.Code, v
+}
+
+func distillPost(t *testing.T, mux *http.ServeMux, path, body string) (int, map[string]json.RawMessage) {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("POST", path, strings.NewReader(body)))
+	var v map[string]json.RawMessage
+	if rec.Code == 200 {
+		if err := json.Unmarshal(rec.Body.Bytes(), &v); err != nil {
+			t.Fatalf("%s: %s", path, rec.Body)
+		}
+	}
+	return rec.Code, v
+}
+
+// The Memory tab's row offers agents, never models: the user picks who
+// reads the conversations, and the route that agent runs on is internal.
+func TestDistillOffersAgentsNotModels(t *testing.T) {
+	distillAt(t)
+	mux := distillMux(t)
+	code, v := distillGet(t, mux, "/api/memory/distill")
+	if code != 200 {
+		t.Fatalf("code %d", code)
+	}
+	if _, ok := v["models"]; ok {
+		t.Fatalf("the view still carries models: %v", v["models"])
+	}
+	var agents []agentRef
+	if err := json.Unmarshal(v["agents"], &agents); err != nil {
+		t.Fatalf("agents: %v %s", err, v["agents"])
+	}
+	if len(agents) != 1 || agents[0].ID != "memory-curator" || agents[0].Name != "记忆整理 Agent" {
+		t.Fatalf("agents: %+v", agents)
+	}
+	var auto string
+	_ = json.Unmarshal(v["auto"], &auto)
+	if auto != "memory-curator" {
+		t.Fatalf("auto: %q", auto)
+	}
+	// the tidy's row offers dream's agents
+	var dream []agentRef
+	if err := json.Unmarshal(v["dreamAgents"], &dream); err != nil {
+		t.Fatalf("dreamAgents: %v %s", err, v["dreamAgents"])
+	}
+	if len(dream) != 1 || dream[0].ID != "dreamer" {
+		t.Fatalf("dreamAgents: %+v", dream)
+	}
+	// nothing in the view names a model as a choice
+	if strings.Contains(string(v["agents"]), "group/deepseek") {
+		t.Fatalf("a model leaked into agents: %s", v["agents"])
+	}
+}
+
+// Picking an agent is kept, and the agents list follows the registry: one
+// that stops carrying learn out leaves the list.
+func TestDistillPicksAnAgent(t *testing.T) {
+	distillAt(t)
+	mux := distillMux(t)
+	if _, err := memagent.Restore(); err != nil {
+		t.Fatal(err)
+	}
+	code, v := distillPost(t, mux, "/api/memory/distill", `{"on":true,"agent":"memory-curator"}`)
+	if code != 200 {
+		t.Fatalf("pick: %d %v", code, v)
+	}
+	var agent string
+	_ = json.Unmarshal(v["agent"], &agent)
+	if agent != "memory-curator" {
+		t.Fatalf("agent: %q", agent)
+	}
+	st, err := memdistill.Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st.Model != "memory-curator" || !st.On {
+		t.Fatalf("state: %+v", st)
+	}
+}
+
+// An agent that doesn't carry the role out is a 400 and nothing is written:
+// a run is never pointed at an agent the user couldn't have picked.
+func TestDistillRefusesAnAgentOfAnotherRole(t *testing.T) {
+	distillAt(t)
+	mux := distillMux(t)
+	if _, err := memagent.Restore(); err != nil {
+		t.Fatal(err)
+	}
+	for _, body := range []string{
+		`{"on":true,"agent":"dreamer"}`,             // a dream agent, not learn's
+		`{"on":true,"agent":"not-there"}`,           // no such agent
+		`{"on":true,"dreamAgent":"memory-curator"}`, // learn's, not dream's
+	} {
+		if code, _ := distillPost(t, mux, "/api/memory/distill", body); code != 400 {
+			t.Fatalf("%s taken: %d", body, code)
+		}
+	}
+	st, err := memdistill.Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st.On || st.Model != "" || st.DreamAgent != "" {
