new file mode 100644
index 0000000..6995204
--- /dev/null
+++ b/internal/gui/tests/library-memory-agents.test.cjs
@@ -0,0 +1,85 @@
+// The Memory tab's static contract: no model is ever offered where an
+// agent is picked, and every request speaks the fields the routes read.
+//
+// This runs without a browser, so it holds whether or not Playwright is
+// installed: it reads the client's source rather than a rendered page. What
+// a rendered page does is the Playwright suite's business
+// (internal/gui/tests/library-memory.test.cjs).
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const src = fs.readFileSync(path.join(__dirname, "..", "assets", "plugins", "library", "client.js"), "utf8");
+
+// between is the source of one function, from its `function name(` to the
+// line that closes it at the same depth.
+function between(name) {
+  const at = src.indexOf("function " + name + "(");
+  assert.ok(at >= 0, name + " is in client.js");
+  const start = src.lastIndexOf("\n", at) + 1;
+  const end = src.indexOf("\n  }", at);
+  assert.ok(end > at, name + " ends");
+  return src.slice(start, end);
+}
+
+test("no model is offered in the memory rows", () => {
+  for (const fn of ["memAgentPick", "distillRow", "dreamRow"]) {
+    const body = between(fn);
+    assert.ok(!/\bmodels\b/.test(body), fn + " reads the models list");
+    assert.ok(!/\bmodelName\b/.test(body), fn + " names a model");
+    assert.ok(!/d\.model\b/.test(body), fn + " sends d.model");
+  }
+});
+
+test("the agent picker sends the agent, not a model", () => {
+  const body = between("distillRow");
+  assert.match(body, /memory\/distill", \{ on: d\.on, agent/, "the switch sends agent");
+  assert.match(body, /memory\/distill", \{ on: d\.on, agent: v \}/, "picking sends agent");
+  assert.ok(!/on: d\.on, model/.test(body), "nothing sends model");
+});
+
+test("the tidy sends its own agent", () => {
