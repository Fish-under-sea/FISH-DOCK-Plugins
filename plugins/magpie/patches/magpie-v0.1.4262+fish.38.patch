+// Append adds b to the end of name, a path inside the vault under one of
+// Writable, making the note and the folders above it when they aren't
+// there. A note that is only ever added to — the conflicts log — is added
+// to as it stands, never rewritten: the one who wrote it before is another
+// run, whose lines are not this run's to lay out again.
+func (s *Sandbox) Append(name string, b []byte) error {
+	if s == nil || s.root == nil {
+		return errors.New("no knowledge vault to write to")
+	}
+	rel, err := s.relName(name, Writable)
+	if err != nil {
+		return err
+	}
+	if len(b) > MaxWriteFile {
+		return fmt.Errorf("%q is %d bytes; a run writes at most %d", rel, len(b), MaxWriteFile)
+	}
+	if dir := path.Dir(rel); dir != "." && dir != "/" {
+		if err := s.root.MkdirAll(dir, 0o700); err != nil {
+			return err
+		}
+	}
+	// the note there now is weighed first: what is added is over the run's
+	// budget when the note as it would stand is
+	var held int64
+	if info, err := s.root.Lstat(rel); err == nil && info.Mode().IsRegular() {
+		held = info.Size()
+	}
+	if held+int64(len(b)) > MaxWriteFile {
+		return fmt.Errorf("%q would be %d bytes; a run writes at most %d", rel, held+int64(len(b)), MaxWriteFile)
+	}
+	if s.written+int64(len(b)) > MaxWritten {
+		return fmt.Errorf("this run has written %d bytes already; a run writes at most %d", s.written, MaxWritten)
+	}
+	f, err := s.root.OpenFile(rel, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
+	if err != nil {
+		return err
+	}
+	_, werr := f.Write(b)
+	if werr == nil {
+		werr = f.Sync()
+	}
+	cerr := f.Close()
+	if werr != nil {
+		return werr
+	}
+	if cerr != nil {
+		return cerr
+	}
+	s.written += int64(len(b))
+	return nil
+}
