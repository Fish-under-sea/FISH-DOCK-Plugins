diff --git a/.work/magpie-dev/internal/gui/assets/obsidianagent.js b/internal/gui/assets/obsidianagent.js
new file mode 100644
index 0000000000000000000000000000000000000000..c9602e136fb35c137b263718d58ed68e4aa52c1f
--- /dev/null
+++ b/internal/gui/assets/obsidianagent.js
@@ -0,0 +1,82 @@
+// Obsidian 知识库记忆 Agent 行状态与详情卡片（Usage › Agents 按需懒加载）。
+const obsText = (zh, en) => (/^zh/.test(locale || "") ? zh : en);
+
+function obsPairBtn(a) {
+  const b = el("button", "ag-quiet accent", obsText("重新配对检查", "Check pairing"));
+  b.type = "button";
+  b.onclick = async (e) => {
+    e.stopPropagation();
+    if (b.disabled) return;
+    b.disabled = true;
+    try {
+      state = await api("agents/obsidian-pair/" + a.id, {});
+      renderAgents();
+      const updated = (state.agents || []).find((x) => x.id === a.id);
+      const paired = !!updated?.obsidian?.paired;
+      status(
+        paired
+          ? obsText("Obsidian 配对正常，工作区已就绪", "Obsidian pairing verified")
+          : (updated?.obsidian?.pairError || obsText("尚未检测到有效 Obsidian 配对文件", "Obsidian pairing file missing")),
+        paired ? "ok" : "err"
+      );
+    } catch (err) {
+      status(t(err.message), "err");
+    } finally {
+      b.disabled = false;
+    }
+  };
+  return b;
+}
+
+function obsRunSummary(r) {
+  if (!r) return obsText("尚无运行记录", "No runs yet");
+  const parts = [r.role, r.phase].filter(Boolean);
+  if (r.steps) parts.push(r.steps + obsText(" 步", " steps"));
+  if (r.wrote || r.saved) {
+    parts.push(obsText(`写 ${r.wrote || 0} / 记 ${r.saved || 0}`, `wrote ${r.wrote || 0} · saved ${r.saved || 0}`));
+  }
+  if (r.error) parts.push(r.error);
+  return parts.join(" · ");
+}
+
+window.obsidianRowMeta = function (a) {
+  const meta = a.obsidian;
+  const wrap = el("div", "ag-obs-meta");
+  const st = el("span", "ag-st " + (meta.paired ? "on" : "wait"));
+  st.append(
+    el("span", "ag-dot"),
+    el("span", "", meta.paired ? obsText("Obsidian 已配对", "Obsidian paired") : obsText("Obsidian 未配对", "Obsidian unpaired"))
+  );
+  if (!meta.paired && meta.pairError) st.title = meta.pairError;
+  wrap.append(st);
+  if (!meta.paired) wrap.append(obsPairBtn(a));
+  if (meta.lastRun) {
+    const run = el("span", "ag-hint", obsRunSummary(meta.lastRun));
+    if (meta.lastRun.error) run.classList.add("err");
+    wrap.append(run);
+  }
+  return wrap;
+};
+
+window.obsidianDetail = function (a) {
+  const meta = a.obsidian;
+  const box = el("div", "ag-obs-detail");
+  const wsLine = el("div", "ag-vl");
+  wsLine.append(el("code", "", meta.workspace || ""));
+  box.append(wsLine);
+
+  const pairLine = el("div", "ag-vl " + (meta.paired ? "ag-st on" : "ag-warn"));
+  pairLine.append(
+    el("span", "ag-dot"),
+    el("span", "", meta.paired
+      ? obsText("已配对：", "Paired: ") + (meta.vault || "")
+      : obsText("未配对：", "Unpaired: ") + (meta.pairError || obsText("请在 Obsidian 插件中完成或重新配对", "Complete pairing in Obsidian")))
+  );
+  pairLine.append(obsPairBtn(a));
+  box.append(pairLine);
+
+  const runLine = el("div", "ag-vl");
+  runLine.append(el("span", "ag-hint", obsText("最近运行：", "Last run: ") + obsRunSummary(meta.lastRun)));
+  box.append(runLine);
+  return box;
+};
