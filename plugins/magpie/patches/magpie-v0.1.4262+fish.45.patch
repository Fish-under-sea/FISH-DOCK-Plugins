+func isolateVaultTestEnv(t *testing.T, vaultDir string) {
+	t.Helper()
+	cfg := t.TempDir()
+	t.Setenv("APPDATA", cfg)
+	t.Setenv("XDG_CONFIG_HOME", cfg)
+	t.Setenv("HOME", cfg)
+	oldPath := Path
+	oldAudit := AuditPath
+	oldRoots := VaultRoots
+	Path = func() string { return filepath.Join(cfg, "memory-agents.json") }
+	AuditPath = func() string { return filepath.Join(cfg, "memory-audit.jsonl") }
+	if vaultDir != "" {
+		VaultRoots = func() []string { return []string{vaultDir} }
+	} else {
+		VaultRoots = nil
+	}
+	t.Cleanup(func() {
+		Path = oldPath
+		AuditPath = oldAudit
+		VaultRoots = oldRoots
+	})
+}
+
+func TestEnsureObsidianWorkspacePreservesUserFiles(t *testing.T) {
+	vault := t.TempDir()
+	wsDir, err := EnsureObsidianWorkspace(vault)
+	if err != nil {
+		t.Fatalf("EnsureObsidianWorkspace: %v", err)
+	}
+	wantDir := filepath.Join(vault, ".obsidian", "magpie-agent")
+	if wsDir != wantDir {
+		t.Fatalf("dir = %q, want %q", wsDir, wantDir)
+	}
+	for _, rel := range []string{"agent.json", "AGENTS.md", "mcp.json", "skills"} {
+		if _, err := os.Stat(filepath.Join(wsDir, rel)); err != nil {
+			t.Fatalf("missing %s: %v", rel, err)
+		}
+	}
+
+	customPrompt := "# Custom Vault Rules\nAlways keep citations.\n"
+	if err := os.WriteFile(filepath.Join(wsDir, "AGENTS.md"), []byte(customPrompt), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := EnsureObsidianWorkspace(vault); err != nil {
+		t.Fatalf("second EnsureObsidianWorkspace: %v", err)
+	}
+	got, err := os.ReadFile(filepath.Join(wsDir, "AGENTS.md"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != customPrompt {
+		t.Fatalf("AGENTS.md overwritten: %q", string(got))
+	}
+}
+
+func TestObsidianWorkspaceDiscoveryAndRegistryDefaults(t *testing.T) {
+	vault := t.TempDir()
+	isolateVaultTestEnv(t, vault)
+
+	if _, err := EnsureObsidianWorkspace(vault); err != nil {
+		t.Fatal(err)
+	}
+	if err := SyncObsidianDefault(); err != nil {
+		t.Fatalf("SyncObsidianDefault: %v", err)
+	}
+	r, err := Load()
+	if err != nil {
+		t.Fatalf("Load: %v", err)
+	}
+	obs, ok := r.Get(ObsidianAgentID)
+	if !ok {
+		t.Fatalf("expected %s in registry: %+v", ObsidianAgentID, r.Agents)
+	}
+	if obs.Name != ObsidianAgentName {
+		t.Fatalf("name = %q", obs.Name)
+	}
+	for _, role := range Roles {
+		def, ok := r.Default(role)
+		if !ok || def.ID != ObsidianAgentID {
+			t.Fatalf("default(%s) = %+v (ok=%v)", role, def, ok)
+		}
+	}
+
+	// Secondary vault with duplicate id in agent.json gets a unique valid registry ID.
+	vault2 := t.TempDir()
+	if _, err := EnsureObsidianWorkspace(vault2); err != nil {
+		t.Fatal(err)
+	}
+	wss := DiscoverObsidianWorkspaces(vault2)
+	if len(wss) != 2 || wss[0].ID == wss[1].ID {
+		t.Fatalf("expected two distinct workspaces, got %+v", wss)
+	}
+	if !idPattern(wss[1].ID) {
+		t.Fatalf("secondary workspace id %q violates idPattern", wss[1].ID)
+	}
+}
+
+func TestObsidianDispatchUsesWorkspaceAndEnforcesSandbox(t *testing.T) {
