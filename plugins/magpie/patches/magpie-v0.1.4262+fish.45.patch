diff --git a/.work/magpie-dev/internal/agent/obsidian_memory.go b/internal/agent/obsidian_memory.go
new file mode 100644
index 0000000000000000000000000000000000000000..a21c2681e756f746d51f5565bb70e19c52abf6a7
--- /dev/null
+++ b/internal/agent/obsidian_memory.go
@@ -0,0 +1,116 @@
+package agent
+
+import (
+	"path/filepath"
+	"strings"
+
+	"github.com/yetone/magpie/internal/memagent"
+)
+
+// ExtraObsidianVaults returns additional vault folders for tests when needed.
+var ExtraObsidianVaults func() []string
+
+func obsidianVaultAgents(home, cfg string) []*Agent {
+	extra := obsidianVaults(obsidianDirs(home, cfg))
+	if ExtraObsidianVaults != nil {
+		extra = append(extra, ExtraObsidianVaults()...)
+	}
+	wss := memagent.DiscoverObsidianWorkspaces(extra...)
+	if len(wss) == 0 {
+		return nil
+	}
+	out := make([]*Agent, 0, len(wss))
+	for _, ws := range wss {
+		out = append(out, newObsidianVaultAgent(ws))
+	}
+	return out
+}
+
+func newObsidianVaultAgent(ws memagent.ObsidianWorkspace) *Agent {
+	wsDir := ws.Dir
+	cfgPath := filepath.Join(wsDir, memagent.ObsidianConfigName)
+	id := ws.ID
+	name := strings.TrimSpace(ws.Config.Name)
+	if name == "" {
+		name = memagent.ObsidianAgentName
+	}
+
+	readCfg := func() memagent.ObsidianConfig {
+		c, err := memagent.ReadObsidianConfig(wsDir)
+		if err != nil {
+			return ws.Config
+		}
+		return c
+	}
+	writeCfg := func(c memagent.ObsidianConfig) error {
+		return memagent.WriteObsidianConfig(wsDir, c)
+	}
+	pickDefaultRoute := func() string {
+		for _, o := range viaMagpieShared(id, "") {
+			if strings.TrimSpace(o.Value) != "" {
+				return o.Value
+			}
+		}
+		return memagent.DefaultObsidianConfig().Route
+	}
+
+	return &Agent{
+		ID:       id,
+		Name:     name,
+		Icon:     "obsidian",
+		Origin:   OriginObsidianVault,
+		VaultDir: ws.Vault,
+		Dir:      wsDir,
+		Path:     cfgPath,
+		detect:   func() bool { return isFile(cfgPath) },
+		Joined: func() bool {
+			c := readCfg()
+			return c.Enabled && strings.TrimSpace(c.Route) != ""
+		},
+		Routed: func() bool {
+			c := readCfg()
+			return c.Enabled && strings.TrimSpace(c.Route) != ""
+		},
+		Join: func() (bool, error) {
+			c := readCfg()
+			if strings.TrimSpace(c.Route) == "" {
+				if len(viaMagpieShared(id, "")) == 0 {
+					return false, nil
+				}
+				c.Route = pickDefaultRoute()
+			}
+			c.Enabled = true
+			return true, writeCfg(c)
+		},
+		Unwire: func() error {
+			c := readCfg()
+			c.Enabled = false
+			return writeCfg(c)
+		},
+		Fields: []Field{{
+			Key:   "model",
+			Label: "model",
+			Live:  true,
+			Get: func() string {
+				c := readCfg()
+				if !c.Enabled {
+					return ""
+				}
+				return c.Route
+			},
+			Set: func(v string) error {
+				v = strings.TrimSpace(v)
+				if v == "" {
+					return nil
+				}
+				c := readCfg()
+				c.Route = v
+				c.Enabled = true
+				return writeCfg(c)
+			},
+			Options: func(map[string]string) []Option {
+				return viaMagpieShared(id, "")
+			},
+		}},
+	}
+}
diff --git a/.work/magpie-dev/internal/agent/obsidian_memory_test.go b/internal/agent/obsidian_memory_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..979b3a0afc8deac1c181e82f34ef622bef5c0c10
--- /dev/null
+++ b/internal/agent/obsidian_memory_test.go
@@ -0,0 +1,131 @@
+package agent
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/yetone/magpie/internal/fishvault"
+	"github.com/yetone/magpie/internal/memagent"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func setupTestVault(t *testing.T, root string) {
+	t.Helper()
+	if err := os.MkdirAll(root, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, fishvault.Record), []byte(`{"schema":1,"imported":true,"files":[]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := memagent.EnsureObsidianWorkspace(root); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func findAgent(list []*Agent, id string) *Agent {
+	for _, a := range list {
+		if a.ID == id {
+			return a
+		}
+	}
+	return nil
+}
+
+func TestObsidianVaultAgentLifecycle(t *testing.T) {
+	syncHome(t)
+	if err := provider.Save(provider.Provider{
+		ID: "oa", Name: "OA", Key: "k", Chat: "http://127.0.0.1:1/v1",
+		Models: []string{"gpt-5.5", "gpt-5.4"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+
+	vault := fishvault.Root()
+	setupTestVault(t, vault)
+
+	// Secondary vault listed in obsidian.json is also discovered with a unique id.
+	vault2 := filepath.Join(t.TempDir(), "NotesVault")
+	setupTestVault(t, vault2)
+	_, cfg := homes()
+	for _, obsCfgDir := range obsidianDirs("", cfg) {
+		if err := os.MkdirAll(obsCfgDir, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		raw, _ := json.Marshal(map[string]any{
+			"vaults": map[string]any{
+				"v2": map[string]any{"path": vault2},
+			},
+		})
+		if err := os.WriteFile(filepath.Join(obsCfgDir, "obsidian.json"), raw, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	list := local()
+	obs := findAgent(list, memagent.ObsidianAgentID)
+	if obs == nil {
+		t.Fatalf("expected %s in local() agents", memagent.ObsidianAgentID)
+	}
+	if obs.Origin != OriginObsidianVault || obs.VaultDir != vault || obs.Icon != "obsidian" || !obs.Detected() || !obs.Wired() || !obs.Joined() {
+		t.Fatalf("unexpected agent metadata: %+v detected=%v wired=%v joined=%v", obs, obs.Detected(), obs.Wired(), obs.Joined())
+	}
+	second := findAgent(list, memagent.ObsidianAgentID+"-notesvault")
+	if second == nil || second.Origin != OriginObsidianVault || second.VaultDir != vault2 {
+		t.Fatalf("expected secondary obsidian vault agent, got %+v", second)
+	}
+
+	// Pick model updates <vault>/.obsidian/magpie-agent/agent.json and memagent.Load().
+	if err := obs.Pick("model", "oa/gpt-5.4"); err != nil {
+		t.Fatalf("Pick model: %v", err)
+	}
+	if !obs.Wired() || !obs.Joined() {
+		t.Fatalf("expected Wired && Joined after Pick, got wired=%v joined=%v", obs.Wired(), obs.Joined())
+	}
+	cfgDisk, err := memagent.ReadObsidianConfig(obs.Dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfgDisk.Route != "oa/gpt-5.4" || !cfgDisk.Enabled {
+		t.Fatalf("agent.json = %+v", cfgDisk)
+	}
+	reg, err := memagent.Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ma, ok := reg.Get(memagent.ObsidianAgentID); !ok || ma.Model != "oa/gpt-5.4" {
+		t.Fatalf("memagent registry entry = %+v ok=%v", ma, ok)
+	}
+
+	// Disconnect flips enabled=false while keeping Route intact.
+	if err := obs.Disconnect(); err != nil {
+		t.Fatalf("Disconnect: %v", err)
+	}
+	if obs.Wired() || obs.Joined() {
+		t.Fatalf("expected disconnected state, wired=%v joined=%v", obs.Wired(), obs.Joined())
+	}
+	cfgDisk, err = memagent.ReadObsidianConfig(obs.Dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfgDisk.Enabled || cfgDisk.Route != "oa/gpt-5.4" {
+		t.Fatalf("after Disconnect agent.json = %+v", cfgDisk)
+	}
+
+	// ConnectHow re-enables and preserves the route.
+	conn, err := obs.ConnectHow()
+	if err != nil {
+		t.Fatalf("ConnectHow: %v", err)
+	}
+	if conn.How == "" || !obs.Wired() || !obs.Joined() {
+		t.Fatalf("after ConnectHow conn=%+v wired=%v joined=%v", conn, obs.Wired(), obs.Joined())
+	}
+	cfgDisk, err = memagent.ReadObsidianConfig(obs.Dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !cfgDisk.Enabled || cfgDisk.Route != "oa/gpt-5.4" {
+		t.Fatalf("after ConnectHow agent.json = %+v", cfgDisk)
+	}
+}
