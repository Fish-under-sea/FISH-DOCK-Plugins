+	}
+	if err := json.Unmarshal([]byte(read(t, filepath.Join(wsDir, "mcp.json"))), &parsed); err != nil {
+		t.Fatal(err)
+	}
+	if parsed.MCPServers["notes-idx"]["command"] != "npx" || parsed.MCPServers["remote-kb"]["url"] != "https://kb.example/mcp" {
+		t.Fatalf("unexpected mcp.json: %+v", parsed.MCPServers)
+	}
+
+	loaded, err = memagent.LoadHomeAt(wsDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(loaded.Servers) != 2 {
+		t.Fatalf("memagent.LoadHomeAt servers = %+v", loaded.Servers)
+	}
+}
