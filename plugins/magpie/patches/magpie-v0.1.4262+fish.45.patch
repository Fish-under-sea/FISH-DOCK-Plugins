+// LogViolation appends a sandbox boundary violation to logs/memory-conflicts.md
+// and leaves an audit line in memory-audit.jsonl.
+func LogViolation(sb *Sandbox, role, agentName, op, target string, err error) error {
+	if strings.TrimSpace(agentName) == "" {
+		agentName = AgentID
+	}
+	msg := ""
+	if err != nil {
+		msg = err.Error()
+	}
+	LogAudit(Audit{
+		Action: "vault_" + op,
+		Role:   role,
+		Agent:  agentName,
+		Result: "refused",
+		Error:  redact(oneLine(target+": "+msg), 400),
+	})
+	if sb == nil {
+		return errors.New("no vault to write a violation into")
+	}
+	var b strings.Builder
+	fmt.Fprintf(&b, "\n## %s\n\n", now().UTC().Format(time.RFC3339))
+	fmt.Fprintf(&b, "- action: vault_%s\n", op)
+	fmt.Fprintf(&b, "- role: %s\n", role)
+	fmt.Fprintf(&b, "- agent: %s\n", mdEscape(agentName))
+	fmt.Fprintf(&b, "- target: %s\n", mdEscape(redact(oneLine(target), 300)))
+	fmt.Fprintf(&b, "- why refused: %s\n", mdEscape(redact(oneLine(msg), 300)))
+	return sb.AppendConflict(ConflictsPath, []byte(b.String()))
+}
