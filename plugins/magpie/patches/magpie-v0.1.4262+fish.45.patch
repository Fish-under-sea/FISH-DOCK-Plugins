+	// 2. Skills: installs skill into <vault>/.obsidian/magpie-agent/skills and loads via memagent.LoadHomeAt.
+	src := filepath.Join(h, "src", "skills")
+	skill(t, filepath.Join(src, "vault-lint"), "vault-lint", "Validate Obsidian frontmatter")
+	ok(t)(InstallSkills(src, []string{"vault-lint"}, []string{memagent.ObsidianAgentID}))
