+		t.Fatal(err)
+	}
+	if len(loaded.Skills) != 1 || loaded.Skills[0].Name != "vault-lint" {
+		t.Fatalf("memagent.LoadHomeAt skills = %+v", loaded.Skills)
+	}
+
+	// 3. MCP: writes stdio and http servers into <vault>/.obsidian/magpie-agent/mcp.json (mcpServers).
+	agents := []string{memagent.ObsidianAgentID}
+	stdio := Server{Name: "notes-idx", Transport: "stdio", Command: "npx", Args: []string{"-y", "@mcp/notes"}, Agents: agents}
+	httpSrv := Server{Name: "remote-kb", Transport: "http", URL: "https://kb.example/mcp", Agents: agents}
+	ok(t)(SaveServer("", stdio))
+	ok(t)(SaveServer("", httpSrv))
+
+	var parsed struct {
