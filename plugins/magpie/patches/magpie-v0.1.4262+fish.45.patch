+++ b/internal/memagent/obsidian.go
@@ -0,0 +1,416 @@
+package memagent
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/fishvault"
+	"github.com/yetone/magpie/internal/steady"
+)
+
+const (
+	// ObsidianAgentID is the built-in vault-resident memory agent id.
+	ObsidianAgentID = "obsidian-memory"
+	// ObsidianAgentName is its display name across Agents, Library and Obsidian.
+	ObsidianAgentName = "Obsidian 记忆 Agent"
+	// ObsidianRelDir is the workspace directory inside a vault's .obsidian folder.
+	ObsidianRelDir = ".obsidian/magpie-agent"
+	// ObsidianConfigName is the manifest inside the workspace folder.
+	ObsidianConfigName = "agent.json"
+)
+
+// DefaultObsidianInstructions seeds <vault>/.obsidian/magpie-agent/AGENTS.md on first setup.
+const DefaultObsidianInstructions = `# Obsidian 记忆 Agent
+
+你是驻留在 Obsidian 知识库中的记忆维护 Agent，负责三项工作：
+1. **学习对话（learn）**：提炼对话中值得长期保留的事实、偏好、规则与经验，调用记忆工具写入长期记忆。
+2. **整理记忆（organize）**：合并重复记忆与灵感，清理过时条目；按主题整理到白名单目录。
+3. **跨笔记做梦（dream）**：跨笔记与记忆寻找深层关联与未解问题，形成灵感卡片。
+
+## 纪律与边界
+- 仅在授权的白名单目录内读写，严禁触碰 .obsidian/、.git/、credentials/ 及库外任何路径。
+- 绝不覆盖或篡改用户手写（origin=user 或用户编辑过）的记忆；存在冲突时追加候选并在 logs/memory-conflicts.md 记录。
+`
+
+// ObsidianSandboxConfig declares the vault paths configured in agent.json.
+type ObsidianSandboxConfig struct {
+	Read  []string `json:"read"`
+	Write []string `json:"write"`
+	Deny  []string `json:"deny"`
+}
+
+// ObsidianBudgetConfig bounds steps, run duration and scratch cache.
+type ObsidianBudgetConfig struct {
+	MaxSteps          int `json:"maxSteps"`
+	RunTimeoutMinutes int `json:"runTimeoutMinutes"`
+	ScratchMB         int `json:"scratchMB"`
+}
+
+// ObsidianConfig matches <vault>/.obsidian/magpie-agent/agent.json.
+type ObsidianConfig struct {
+	Schema  int                   `json:"schema"`
+	ID      string                `json:"id"`
+	Name    string                `json:"name"`
+	Roles   []string              `json:"roles"`
+	Route   string                `json:"route"`
+	Enabled bool                  `json:"enabled"`
+	Sandbox ObsidianSandboxConfig `json:"sandbox"`
+	Budget  ObsidianBudgetConfig  `json:"budget"`
+}
+
+// ObsidianWorkspace is one discovered <vault>/.obsidian/magpie-agent workspace.
+type ObsidianWorkspace struct {
+	ID     string
+	Vault  string
+	Dir    string
+	Config ObsidianConfig
+}
+
+// VaultRoots returns extra Obsidian vault paths to scan alongside fishvault.Root().
+var VaultRoots func() []string
+
+// DefaultObsidianConfig returns the baseline configuration for agent.json.
+func DefaultObsidianConfig() ObsidianConfig {
+	return ObsidianConfig{
+		Schema:  1,
+		ID:      ObsidianAgentID,
+		Name:    ObsidianAgentName,
+		Roles:   []string{Learn, Organize, Dream},
+		Route:   "group/deepseek",
+		Enabled: true,
+		Sandbox: ObsidianSandboxConfig{
+			Read:  []string{"."},
+			Write: []string{"Magpie 对话/", "memories/", "inspirations/", "_digests/", "logs/"},
+			Deny:  []string{".obsidian/", ".git/", "credentials/"},
+		},
+		Budget: ObsidianBudgetConfig{
+			MaxSteps:          MaxSteps,
+			RunTimeoutMinutes: int(RunTimeout.Minutes()),
+			ScratchMB:         20,
+		},
+	}
+}
+
+// ObsidianWorkspaceDir returns <vault>/.obsidian/magpie-agent.
+func ObsidianWorkspaceDir(vaultRoot string) string {
+	return filepath.Join(vaultRoot, ".obsidian", "magpie-agent")
+}
+
+// HasRole checks if the workspace config allows running role.
+func (c ObsidianConfig) HasRole(role string) bool {
+	role = strings.ToLower(strings.TrimSpace(role))
+	for _, r := range c.Roles {
+		if strings.ToLower(strings.TrimSpace(r)) == role {
+			return true
+		}
+	}
+	return false
+}
+
+// SandboxPolicy converts ObsidianSandboxConfig to a normalized Sandbox Policy.
+func (c ObsidianConfig) SandboxPolicy() Policy {
+	def := DefaultObsidianConfig().Sandbox
+	read := slices.Clone(c.Sandbox.Read)
+	if len(read) == 0 {
+		read = def.Read
+	}
+	write := slices.Clone(c.Sandbox.Write)
+	if len(write) == 0 {
+		write = def.Write
+	}
+	deny := slices.Clone(c.Sandbox.Deny)
+	if len(deny) == 0 {
+		deny = def.Deny
+	}
+	return Policy{Read: read, Write: write, Deny: deny}
+}
+
+func (c ObsidianConfig) asRegistryAgent() Agent {
+	roles := make([]string, 0, len(c.Roles))
+	for _, r := range c.Roles {
+		r = strings.ToLower(strings.TrimSpace(r))
+		if slices.Contains(Roles, r) && !slices.Contains(roles, r) {
+			roles = append(roles, r)
+		}
+	}
+	if len(roles) == 0 {
+		roles = slices.Clone(Roles)
+	}
+	route := strings.TrimSpace(c.Route)
+	if route == "" {
+		route = "group/deepseek"
+	}
+	name := strings.TrimSpace(c.Name)
+	if name == "" {
+		name = ObsidianAgentName
+	}
+	id := strings.TrimSpace(c.ID)
+	if id == "" {
+		id = ObsidianAgentID
+	}
+	return Agent{
+		ID:       id,
+		Name:     name,
+		Agent:    id,
+		Role:     strings.Join(roles, "|"),
+		Model:    route,
+		Effort:   "high",
+		Schedule: "daily 22:00",
+		Scopes:   []string{"global", "project:*"},
+		Builtin:  true,
+	}
+}
+
+// EnsureObsidianWorkspace initializes <vault>/.obsidian/magpie-agent/{agent.json,AGENTS.md,mcp.json,skills}
+// without overwriting existing user-edited files.
+func EnsureObsidianWorkspace(vaultRoot string) (string, error) {
+	vaultRoot = strings.TrimSpace(vaultRoot)
+	if vaultRoot == "" {
+		return "", errors.New("obsidian agent workspace requires a vault root")
+	}
+	info, err := os.Lstat(vaultRoot)
+	if err != nil {
+		return "", err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return "", fmt.Errorf("%s is not an independent folder", vaultRoot)
+	}
+	dir := ObsidianWorkspaceDir(vaultRoot)
+	if err := os.MkdirAll(filepath.Join(dir, SkillsName), 0o700); err != nil {
+		return "", err
+	}
+	cfgPath := filepath.Join(dir, ObsidianConfigName)
+	if _, err := os.Lstat(cfgPath); errors.Is(err, os.ErrNotExist) {
+		if err := WriteObsidianConfig(dir, DefaultObsidianConfig()); err != nil {
+			return "", err
+		}
+	}
+	instrPath := filepath.Join(dir, InstructionsName)
+	if _, err := os.Lstat(instrPath); errors.Is(err, os.ErrNotExist) {
+		if err := steady.WriteFile(instrPath, []byte(DefaultObsidianInstructions), 0o600); err != nil {
+			return "", err
+		}
+	}
+	mcpPath := filepath.Join(dir, MCPName)
+	if _, err := os.Lstat(mcpPath); errors.Is(err, os.ErrNotExist) {
+		if err := steady.WriteFile(mcpPath, []byte("{\"mcpServers\":{}}\n"), 0o600); err != nil {
+			return "", err
+		}
+	}
+	return dir, nil
+}
+
+// ReadObsidianConfig parses <dir>/agent.json and fills default fields if omitted.
+func ReadObsidianConfig(dir string) (ObsidianConfig, error) {
+	b, err := os.ReadFile(filepath.Join(dir, ObsidianConfigName))
+	if err != nil {
+		return ObsidianConfig{}, err
+	}
+	cfg := DefaultObsidianConfig()
+	raw := map[string]any{}
+	trimmed := bytes.TrimPrefix(b, []byte("\xef\xbb\xbf"))
+	if err := json.Unmarshal(trimmed, &cfg); err != nil {
+		return ObsidianConfig{}, err
+	}
+	_ = json.Unmarshal(trimmed, &raw)
+	def := DefaultObsidianConfig()
+	if cfg.Schema == 0 {
+		cfg.Schema = def.Schema
+	}
+	if strings.TrimSpace(cfg.ID) == "" {
+		cfg.ID = def.ID
+	}
+	if strings.TrimSpace(cfg.Name) == "" {
+		cfg.Name = def.Name
+	}
+	if len(cfg.Roles) == 0 {
+		cfg.Roles = def.Roles
+	}
+	if strings.TrimSpace(cfg.Route) == "" {
+		cfg.Route = def.Route
+	}
+	if _, hasEnabled := raw["enabled"]; !hasEnabled {
+		cfg.Enabled = def.Enabled
+	}
+	if len(cfg.Sandbox.Read) == 0 {
+		cfg.Sandbox.Read = def.Sandbox.Read
+	}
+	if len(cfg.Sandbox.Write) == 0 {
+		cfg.Sandbox.Write = def.Sandbox.Write
+	}
+	if len(cfg.Sandbox.Deny) == 0 {
+		cfg.Sandbox.Deny = def.Sandbox.Deny
+	}
+	if cfg.Budget.MaxSteps <= 0 {
+		cfg.Budget.MaxSteps = def.Budget.MaxSteps
+	}
+	if cfg.Budget.RunTimeoutMinutes <= 0 {
+		cfg.Budget.RunTimeoutMinutes = def.Budget.RunTimeoutMinutes
+	}
+	if cfg.Budget.ScratchMB <= 0 {
+		cfg.Budget.ScratchMB = def.Budget.ScratchMB
+	}
+	return cfg, nil
+}
+
+// WriteObsidianConfig atomically writes agent.json into dir.
+func WriteObsidianConfig(dir string, cfg ObsidianConfig) error {
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return err
+	}
+	def := DefaultObsidianConfig()
+	if cfg.Schema == 0 {
+		cfg.Schema = def.Schema
+	}
+	if strings.TrimSpace(cfg.ID) == "" {
+		cfg.ID = def.ID
+	}
+	if strings.TrimSpace(cfg.Name) == "" {
+		cfg.Name = def.Name
+	}
+	if len(cfg.Roles) == 0 {
+		cfg.Roles = def.Roles
+	}
+	if strings.TrimSpace(cfg.Route) == "" {
+		cfg.Route = def.Route
+	}
+	if len(cfg.Sandbox.Read) == 0 {
+		cfg.Sandbox.Read = def.Sandbox.Read
+	}
+	if len(cfg.Sandbox.Write) == 0 {
+		cfg.Sandbox.Write = def.Sandbox.Write
+	}
+	if len(cfg.Sandbox.Deny) == 0 {
+		cfg.Sandbox.Deny = def.Sandbox.Deny
+	}
+	if cfg.Budget.MaxSteps <= 0 {
+		cfg.Budget.MaxSteps = def.Budget.MaxSteps
+	}
+	if cfg.Budget.RunTimeoutMinutes <= 0 {
+		cfg.Budget.RunTimeoutMinutes = def.Budget.RunTimeoutMinutes
+	}
+	if cfg.Budget.ScratchMB <= 0 {
+		cfg.Budget.ScratchMB = def.Budget.ScratchMB
+	}
+	b, err := json.MarshalIndent(cfg, "", "  ")
+	if err != nil {
+		return err
+	}
+	b = append(b, '\n')
+	return steady.WriteFile(filepath.Join(dir, ObsidianConfigName), b, 0o600)
+}
+
+// DiscoverObsidianWorkspaces finds initialized <vault>/.obsidian/magpie-agent folders.
+func DiscoverObsidianWorkspaces(extra ...string) []ObsidianWorkspace {
+	var candidates []string
+	data := appdir.Config()
+	if fishvault.Present(data) {
+		candidates = append(candidates, fishvault.RootAt(data))
+	}
+	if VaultRoots != nil {
+		candidates = append(candidates, VaultRoots()...)
+	}
+	candidates = append(candidates, extra...)
+
+	seen := map[string]bool{}
+	seenIDs := map[string]bool{}
+	var out []ObsidianWorkspace
+	for _, root := range candidates {
+		root = strings.TrimSpace(root)
+		if root == "" {
+			continue
+		}
+		clean := filepath.Clean(root)
+		key := strings.ToLower(clean)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		info, err := os.Lstat(clean)
+		if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			continue
+		}
+		wsDir := ObsidianWorkspaceDir(clean)
+		cfg, err := ReadObsidianConfig(wsDir)
+		if err != nil {
+			continue
+		}
+		id := cfg.ID
+		if seenIDs[id] {
+			slug := strings.Map(func(r rune) rune {
+				if r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-' || r == '_' {
+					return r
+				}
+				return '-'
+			}, strings.ToLower(filepath.Base(clean)))
+			slug = strings.Trim(slug, "-")
+			if slug == "" {
+				slug = fmt.Sprintf("%d", len(out)+1)
+			}
+			id = ObsidianAgentID + "-" + slug
+			if len(id) > 40 {
+				id = id[:40]
+			}
+		}
+		seenIDs[id] = true
+		out = append(out, ObsidianWorkspace{
+			ID:     id,
+			Vault:  clean,
+			Dir:    wsDir,
+			Config: cfg,
+		})
+	}
+	return out
+}
+
+// FindObsidianWorkspace looks up a discovered obsidian agent workspace by id.
+func FindObsidianWorkspace(id string, extra ...string) (ObsidianWorkspace, bool) {
+	id = strings.TrimSpace(id)
+	if id == "" {
+		return ObsidianWorkspace{}, false
+	}
+	for _, ws := range DiscoverObsidianWorkspaces(extra...) {
+		if ws.ID == id || ws.Config.ID == id {
+			return ws, true
+		}
+	}
+	return ObsidianWorkspace{}, false
+}
+
+// SyncObsidianDefault ensures an untouched built-in memory-agents.json points
+// default roles to obsidian-memory once the vault workspace is initialized.
+func SyncObsidianDefault(extra ...string) error {
+	wss := DiscoverObsidianWorkspaces(extra...)
+	if len(wss) == 0 {
+		return nil
+	}
+	primary := wss[0]
+	_, err := change(func(r *Registry) error {
+		onlyBuiltins := true
+		for _, a := range r.Agents {
+			if !a.Builtin {
+				onlyBuiltins = false
+				break
+			}
+		}
+		if onlyBuiltins && r.Defaults[Learn] == "memory-curator" && r.Defaults[Organize] == "memory-curator" && r.Defaults[Dream] == "dreamer" {
+			if r.Defaults == nil {
+				r.Defaults = map[string]string{}
+			}
+			for _, role := range Roles {
+				if primary.Config.HasRole(role) {
+					r.Defaults[role] = primary.ID
+				}
+			}
+		}
+		return nil
+	})
+	return err
+}
