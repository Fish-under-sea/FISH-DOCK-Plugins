+func TestNormalizeBaseURLRefusesWhatTheRulesRefuse(t *testing.T) {
+	cases := []struct {
+		name string
+		in   string
+		code string
+	}{
+		{"内嵌凭据", "https://user:pass@relay.example.com", "BASE_URL_CREDENTIALS"},
+		{"查询串", "https://relay.example.com/api?key=1", "BASE_URL_QUERY"},
+		{"片段", "https://relay.example.com/api#x", "BASE_URL_HASH"},
+		{"非回环 http", "http://relay.example.com", "BASE_URL_INSECURE"},
+		{"别的协议", "ftp://relay.example.com", "BASE_URL_SCHEME"},
+		{"空", "   ", "BASE_URL_REQUIRED"},
+		{"不是 URL", "://nope", "BASE_URL_INVALID"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			_, err := NormalizeBaseURL(c.in)
+			if err == nil {
+				t.Fatalf("%q 被接受了", c.in)
+			}
+			typed, ok := err.(*Error)
+			if !ok || typed.Code != c.code {
+				t.Fatalf("error = %v, want code %s", err, c.code)
+			}
+		})
+	}
+}
+
+func TestNormalizeBaseURLStripsWhatUsersPasteAndAllowsLoopbackHTTP(t *testing.T) {
+	cases := map[string]string{
+		"https://relay.example.com/":                          "https://relay.example.com",
+		"https://relay.example.com/v1":                        "https://relay.example.com",
+		"https://relay.example.com/v1/messages":               "https://relay.example.com",
+		"https://relay.example.com/v1/messages/count_tokens":  "https://relay.example.com",
+		"https://relay.example.com/api/v1/messages":           "https://relay.example.com/api",
+		"http://127.0.0.1:8080":                               "http://127.0.0.1:8080",
+		"http://localhost:3000/v1":                            "http://localhost:3000",
+		"  https://relay.example.com/proxy/  ":                "https://relay.example.com/proxy",
+	}
+	for in, want := range cases {
+		got, err := NormalizeBaseURL(in)
+		if err != nil {
+			t.Fatalf("%q: %v", in, err)
+		}
+		if got != want {
+			t.Errorf("%q => %q, want %q", in, got, want)
+		}
+	}
+}
