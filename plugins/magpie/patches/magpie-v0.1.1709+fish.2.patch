 			Panels      []part   `json:"panels"`
 			Actions     []part   `json:"actions"`
 			Permissions []string `json:"permissions"`
+			Calls       []string `json:"calls"`
 		} `json:"magpie"`
 	}
 	if json.Unmarshal(b, &pkg) != nil {
@@ -200,6 +241,11 @@ func Window(target string) (w *WindowSpec, only bool) {
 			w.Reads = append(w.Reads, r)
 		}
 	}
+	// a call is what the page may ask for, so a plugin with no page and no
