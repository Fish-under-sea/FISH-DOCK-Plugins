+	Calls []string
 }
 
 // PageSpec is a plugin's own page in magpie's window.
@@ -73,8 +76,45 @@ var actionID = regexp.MustCompile(`^[a-z0-9][a-z0-9-]{0,39}$`)
 const maxActions = 8
 
 // PageReads are the reads a plugin's page can be granted, each in
-// magpie.permissions. None of them carries a secret.
-var PageReads = []string{"usage:summary", "providers:list"}
+// magpie.permissions. None of them carries a secret: checkin:state is the
+// aggregated check-in picture (vendors, accounts, today's outcome, credits),
+// never a key or a sign-in.
+var PageReads = []string{"usage:summary", "providers:list", "checkin:state"}
+
+// PageCalls are the window actions a page may ask for, each declared in
+// magpie.calls: the naming reads as namespace:verb, so a page's request
+// says both what it acts on and what it does. A call is not a read: it
+// may spend a request or change a setting, so a page asks for it by name
+// and magpie checks it again where it runs it.
+var PageCalls = []string{
+	"checkin:state", "checkin:set-provider", "checkin:set-account", "checkin:run", "checkin:refresh",
+	"relay:view", "relay:save", "relay:start", "relay:status", "relay:stop",
+}
+
+// maxCalls is how many calls one plugin may declare, at most.
+const maxCalls = 16
+
+// callName is what a call's name is: namespace:verb, lower-case.
+var callName = regexp.MustCompile(`^[a-z][a-z0-9]*:[a-z][a-z0-9-]*$`)
+
+// callsKeeping keeps the calls a page may ask for: only names magpie has
+// (PageCalls), each once, in the order asked, at most maxCalls. Anything
+// else is dropped rather than refused: a package written for a newer
+// magpie still runs here with the calls this one has.
+func callsKeeping(asked []string) []string {
+	var out []string
+	for _, name := range asked {
+		name = strings.TrimSpace(name)
+		if !callName.MatchString(name) || !slices.Contains(PageCalls, name) || slices.Contains(out, name) {
+			continue
+		}
+		if len(out) == maxCalls {
+			break
+		}
+		out = append(out, name)
+	}
+	return out
+}
 
