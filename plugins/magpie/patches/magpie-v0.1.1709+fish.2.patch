index 0000000000000000000000000000000000000000..2825e3eb42ee9ed3f56f76abad673f877ff3f55c
--- /dev/null
+++ b/internal/gui/checkin_call_targets_test.go
@@ -0,0 +1,65 @@
+package gui
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// 页面顶部的「立即签到」不带 provider（issue #9）。以前 checkinRun 把空的
+// provider 判成「缺少厂商 id」，那颗按钮点下去只有一条报错；现在空 = 每家。
+func TestCheckinTargetsTreatsNoProviderAsEveryVendor(t *testing.T) {
+	cases := []struct {
+		name   string
+		params map[string]any
+		want   []string
+	}{
+		{"no params at all", nil, nil},
+		{"empty params", map[string]any{}, nil},
+		{"provider left blank", map[string]any{"provider": "   "}, nil},
+		{"provider not a string", map[string]any{"provider": 3}, nil},
+		{"one vendor", map[string]any{"provider": "codearts"}, []string{"codearts"}},
+		{"one vendor, padded", map[string]any{"provider": " codearts "}, []string{"codearts"}},
+	}
+	for _, c := range cases {
+		if got := checkinTargets(c.params); !slices.Equal(got, c.want) {
+			t.Errorf("%s: checkinTargets = %q, want %q", c.name, got, c.want)
+		}
+	}
+}
+
+// 刷新额度以前和签到走同一个分支，「刷新今日积分」于是又签了一次到。现在它
+// 只重读页面上的厂商，页面点的时候不带 provider 就是每家都读。
+func TestCheckinRefreshTargetsReadsEveryShownVendor(t *testing.T) {
+	shown := []provider.CheckinProviderState{
+		{ID: "codearts", Name: "CodeArts"},
+		{ID: "raccoon", Name: "商汤小浣熊"},
+		{ID: "  ", Name: "空 id 不该带出去"},
+	}
+	cases := []struct {
+		name   string
+		params map[string]any
+		want   []string
+	}{
+		{"page names none", map[string]any{}, []string{"codearts", "raccoon"}},
+		{"page names one", map[string]any{"provider": "raccoon"}, []string{"raccoon"}},
+	}
+	for _, c := range cases {
+		if got := checkinRefreshTargets(shown, c.params); !slices.Equal(got, c.want) {
+			t.Errorf("%s: checkinRefreshTargets = %q, want %q", c.name, got, c.want)
+		}
+	}
+	if got := checkinRefreshTargets(nil, map[string]any{}); len(got) != 0 {
+		t.Errorf("nothing shown should read nothing, got %q", got)
+	}
+}
+
+// 两个动词各走各的：签到回签到记录，刷新回整页状态。它们曾经共用一个分支。
+func TestCheckinCallsKeepRunAndRefreshApart(t *testing.T) {
+	if got, err := checkinCall(t.Context(), "checkin:state", nil); err != nil {
+		t.Fatalf("checkin:state: %v", err)
+	} else if _, ok := got.(provider.CheckinViewState); !ok {
+		t.Errorf("checkin:state = %T, want provider.CheckinViewState", got)
+	}
+}
