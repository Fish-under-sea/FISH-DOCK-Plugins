+func TestRedactTakesTheKeyOutOfEverythingItTouches(t *testing.T) {
+	secret := "sk-live-SECRETVALUE123456"
+	cases := []string{
+		"bad key " + secret + " rejected",
+		"Authorization: Bearer " + secret,
+		"sk-abcdef123456 leaked",
+	}
+	for _, text := range cases {
+		got := Redact(text, secret)
+		if strings.Contains(got, secret) || strings.Contains(got, "sk-abcdef123456") {
+			t.Errorf("%q 没被抹掉: %q", text, got)
+		}
+	}
+}
