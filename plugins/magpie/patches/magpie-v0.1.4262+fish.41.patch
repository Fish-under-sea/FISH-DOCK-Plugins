@@ -96,19 +96,14 @@ func lookCSS(s settings.Settings) string {
 		if fi, err := os.Stat(settings.WallpaperPath()); err == nil && fi.Mode().IsRegular() {
 			// the picture fills the window behind the pages, under a veil of
 			// the theme's own background (one colour, the top layer), so text
-			// on it reads as on the plain page; the cards over it stay opaque.
-			// While liquid glass is on the veil follows the content region's
-			// fill (veilGlass): an opaque card leaves only the margins showing
-			// the picture, a card at 0 % needs the veil to carry the reading.
-			veil := wallVeil
-			if s.FishGlass {
-				veil = veilGlass(s.FishGlassContent.Fill)
-				// the user's own veil wins over the computed one
-				if s.FishGlassVeil > 0 && s.FishGlassVeil <= 95 {
-					veil = "color-mix(in srgb,var(--bg) " + strconv.Itoa(s.FishGlassVeil) + "%,transparent)"
-				}
-			}
-			fmt.Fprintf(&b, "html:not(.omarchy) body:not(.panel){background:linear-gradient(%[1]s,%[1]s),url(\"/api/appearance/wallpaper?v=%[2]d\") center/cover no-repeat var(--bg)}\n", veil, s.Wallpaper)
+			// on it reads as on the plain page.
+			// The veil is --wall-veil, a variable: the slider that sets it (and
+			// the content region's opacity it follows) changes it on the page,
+			// live, without a new stylesheet. stylesheet-level values only
+			// landed when the accent or the picture changed, which is why
+			// 底图遮挡 used to do nothing at all.
+			veil := veilFor(s)
+			fmt.Fprintf(&b, "html:not(.omarchy) body:not(.panel){--wall-veil:%[1]s;background:linear-gradient(var(--wall-veil),var(--wall-veil)),url(\"/api/appearance/wallpaper?v=%[2]d\") center/cover no-repeat var(--bg)}\n", veil, s.Wallpaper)
 			b.WriteString("html:not(.omarchy) body:not(.panel) .sidebar{background:transparent}\n")
 		}
 	}
@@ -198,9 +193,36 @@ func veilGlass(fill int) string {
 		f = 100
 	}
 	pct := wallVeilGlassThick + (f*(wallVeilGlassThin-wallVeilGlassThick))/100
+	return veilPct(pct)
+}
+
+// veilPct is the veil colour at pct percent of the theme's background. It is
+// emitted as --wall-veil, a variable, so the page can thin or thicken it while
+// a slider moves without asking the server for a stylesheet again (the class
+// of bug that made 底图遮挡 do nothing).
+func veilPct(pct int) string {
+	if pct < 0 {
+		pct = 0
+	}
+	if pct > 96 {
+		pct = 96
+	}
 	return "color-mix(in srgb,var(--bg) " + strconv.Itoa(pct) + "%,transparent)"
 }
 
+// veilFor is the veil the wallpaper gets, as a colour: the reader's own number
+// when they set one, else the computed one while liquid glass is on, else the
+// plain 84 % veil.
+func veilFor(s settings.Settings) string {
+	if s.FishGlassVeil > 0 && s.FishGlassVeil <= 95 {
+		return veilPct(s.FishGlassVeil)
+	}
+	if s.FishGlass {
+		return veilGlass(s.FishGlassContent.Fill)
+	}
+	return wallVeil
+}
+
