+/* 2.4.5: 去黑框、去选中描边，选中一律用玻璃凸起 -----------------------------
+   玻璃底下，实色 1px 边框与强调色描边都会变成「一圈看不懂的黑/亮框」。
+   这里把边框改成透明（几何尺寸不变），选中态换成凸起高光。只动颜色类属性。 */
+:root[data-fish-glass] body :is(
+  .list, .card, .pop, .modal .dialog, .action-confirm, .sheet,
+  .pm-card, .pm-hero, .pm-rank, .lib-card, .stats, .kpi, .chart,
+  button, input, select, textarea, .segs, .field, .proto.pick, .sess-pick, .set-field
+) {
+  border-color: transparent;
+}
+/* 焦点环：不再是 3px 强调色圆圈，改成一层薄薄的玻璃光 */
+:root[data-fish-glass] body :is(input, textarea, select, .pm-find, .lib-find, .find, .set-q):focus-visible {
+  outline: none;
+  box-shadow:
+    inset 0 0 0 1px color-mix(in srgb, var(--accent) 46%, transparent),
+    0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent);
+}
+/* 选中/按下：一律是抬起来的玻璃，不再是一圈描边或一块灰 */
+:root[data-fish-glass] body :is(
+  [aria-selected="true"], [aria-pressed="true"], [aria-current="page"],
+  .row.sel, .row.on, .row.model.selected, .lib-card.sel, .pm-card.sel,
+  .segs .opt[aria-pressed="true"]
+) {
+  border-color: transparent;
+  background:
+    linear-gradient(180deg,
+      color-mix(in srgb, var(--mark-fill, var(--pill)) 84%, transparent) 0%,
+      color-mix(in srgb, var(--mark-fill, var(--pill)) 54%, transparent) 100%);
+  box-shadow:
+    inset 0 1px 0 color-mix(in srgb, var(--lg-rim-line, rgba(255,255,255,.34)) 100%, transparent),
+    inset 0 -1px 0 color-mix(in srgb, var(--lg-rim-shade, rgba(0,0,0,.26)) 100%, transparent),
+    0 2px 7px rgba(0,0,0,.18);
+  transition: background .18s var(--ease), box-shadow .18s var(--ease);
+}
+
+/* 2.4.5: 底条不绘制、图标不再带黑框 -----------------------------------------
+   1) 页脚与工具条（库的安装条、供应商页的「添加供应商」行）默认就不画底板，
+      只留上面的文字与按钮——用户明确要的是「底部不要那块」。
+   2) 图标方块（.lib-glyph 用 --pill 铺底）、小徽章与开关不再带实底/描边：
+      没点亮时就是一枚图标，不是黑框。 */
+:root[data-fish-glass] body :is(
+  .lib-install, .lib-safind, .use.add, .sheet .add-tools,
+  #addSheet > .row-head
+) {
+  background: none;
+  background-color: transparent;
+  box-shadow: none;
+  border-color: transparent;
+}
+:root[data-fish-glass] body :is(
+  .lib-glyph, .lib-switch, .lib-tag, .use, .gw-mark, .badge,
+  .disc, .snip-wrap > .copy, .text.action
+) {
+  background: none;
+  background-color: transparent;
+  border-color: transparent;
+  box-shadow: none;
+}
+/* 点亮时仍然给一层玻璃底，好分辨选中状态 */
+:root[data-fish-glass] body :is(.lib-glyph.on, .lib-switch.on, .gw-mark.on, .use.add:hover) {
+  background: color-mix(in srgb, var(--mark-fill, var(--pill)) 62%, transparent);
+}
