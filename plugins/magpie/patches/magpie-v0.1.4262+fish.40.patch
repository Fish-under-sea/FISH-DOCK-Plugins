+.fc-clear { flex: none; }
+/* 2.4.3: 玻璃覆盖补全 -------------------------------------------------
+   排查方式：把 app.css 里所有写死 `background: var(--card|--layer|--bg)` 的
+   选择器列出来逐个看归属。三类要分开处理：
+   1) 与 .list/.card 同级的“面”（表格、订阅卡、KPI、图表）：接内容区变量；
+   2) 套在 .list 里面的小块：父级已经在当玻璃，它就不要再盖一层实底，
+      否则玻璃永远透不下来（这是之前看着“缺玻璃”的主因）；
+   3) 设置页吸顶条、菜单、输入框：分别归 侧栏/浮层/控件。 */
+:root[data-fish-glass] body :is(.qt-wrap, .subscription-card, .kpi, .chart, .stats.empty, .ag-install-row) {
+  background: color-mix(in srgb, var(--card) var(--fish-glass-content-fill), transparent);
+}
+:root[data-fish-glass] body :is(.subscription-acct, .row.stat .us-more, .qt .qt-sub) {
+  background: color-mix(in srgb, var(--card) 45%, transparent);
+}
+/* 设置页吸顶的那条：它自己刷了一层 92% 的背景，会盖掉侧栏与页面的玻璃 */
+:root[data-fish-glass] body:not(.side-nav) #view-settings .set-head::before {
+  background: color-mix(in srgb, var(--bg) var(--fish-glass-content-fill), transparent);
+}
+/* 菜单：与浮层同一区 */
+:root[data-fish-glass] body :is(.row-menu, .us-more.open, .ag-more) {
+  background: color-mix(in srgb, var(--card) var(--fish-glass-overlay-fill), transparent);
+  -webkit-backdrop-filter: blur(var(--fish-glass-overlay-blur)) saturate(200%) brightness(1.14);
+  backdrop-filter: blur(var(--fish-glass-overlay-blur)) saturate(200%) brightness(1.14);
+}
