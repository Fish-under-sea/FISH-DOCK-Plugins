+test("glass colour stays independent from accent and saves cleanly", () => {
+  const { saves, ranges, context } = fixture();
+  const s = {
+    theme: "dark",
+    accent: "#0d9488",
+    fishGlassColor: "#000000",
+    fishGlassSidebar: { fill: 0, blur: 0 },
