@@ -0,0 +1,58 @@
+package memagent
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+// A tool that panics is a tool that failed: the model is told and the run
+// goes on. A run is started from magpie's own backend, so a panic left to
+// unwind would end every agent's gateway, not this run.
+func TestQAToolPanicDoesNotEndTheProcess(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	registryAt(t)
+	boom := Tool{
+		Name:        "boom",
+		Description: "panics",
+		Schema:      map[string]any{"type": "object"},
+		Call: func(context.Context, json.RawMessage) (string, error) {
+			panic("a tool's own bug")
+		},
+	}
+	a := &asker{replies: []Turn{
+		{Calls: []Call{call("c1", "boom", map[string]any{})}},
+		{Text: "done"},
+	}}
+	res, err := Run(t.Context(), Task{Role: Dream, Model: "m", Prompt: "p"},
+		Options{Ask: a.ask, Vault: dir, Home: &Home{Dir: home}, Tools: []Tool{boom}})
+	if err != nil {
+		t.Fatalf("a panicking tool ended the run: %v", err)
+	}
+	if res.Phase != PhaseDone {
+		t.Fatalf("%+v", res)
+	}
+	// the model was told, rather than left with nothing
+	results := a.asked[1].Messages[2]["content"].([]any)
+	block := results[0].(map[string]any)
+	said, _ := block["content"].(string)
+	if block["is_error"] != true || !strings.Contains(said, "boom") {
+		t.Fatalf("the model wasn't told: %+v", block)
+	}
+	// the transcript says so too, for the window
+	var told bool
+	for _, m := range StatusOf(Dream).Messages {
+		if m.Role == "error" && m.Tool == "boom" && strings.Contains(m.Text, "boom") {
+			told = true
+		}
+	}
+	if !told {
+		t.Fatalf("the run's transcript doesn't say the tool panicked: %+v", StatusOf(Dream).Messages)
+	}
+	// and the run's folder and lock are let go, so the next run goes
+	if Running() || RunningScratch() != "" {
+		t.Fatal("a run that met a panicking tool left the process busy")
+	}
+}
diff --git a/internal/memagent/qa_probe_sandbox_test.go b/internal/memagent/qa_probe_sandbox_test.go
new file mode 100644
index 0000000..2cd0e9a
--- /dev/null
+++ b/internal/memagent/qa_probe_sandbox_test.go
@@ -0,0 +1,222 @@
+package memagent
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// The sandbox's allowlist, exercised as a matrix: every shape of path a tool
+// could be given, against every folder the vault has. What is read and
+// written is exactly the allowlist and nothing beside it.
+func TestQASandboxPathMatrix(t *testing.T) {
+	sb, dir := openVault(t)
+	// one note in each folder the vault has, allowed and not
+	for _, d := range []string{"wiki", "inspirations", "memories", "_digests", "candidates", "dreams", "logs", "credentials", "tmp"} {
+		putFile(t, filepath.Join(dir, d, "note.md"), "x\n")
+	}
+	putFile(t, filepath.Join(dir, "root.md"), "x\n")
+	putFile(t, filepath.Join(dir, ".fish-import.json"), "{}\n")
+
+	readOK := []string{
+		"wiki/note.md", "inspirations/note.md", "memories/note.md",
+		`wiki\note.md`, "wiki//note.md", "./wiki/note.md", "wiki/./note.md",
+		" wiki/note.md ",
+	}
+	readNo := []string{
+		"_digests/note.md", "candidates/note.md", "dreams/note.md", "logs/note.md",
+		"credentials/note.md", "tmp/note.md", "root.md", ".fish-import.json",
+		// the allowlist is matched as written: on Windows "WIKI" is the same
+		// folder as "wiki", so letting a case variant through would let one
+		// of a folder a run may not read through too
+		"WIKI/note.md", "Wiki/note.md", "CREDENTIALS/note.md",
+		"", ".", "..", "../x.md", "../../x.md", "wiki/../../x.md",
+		"/etc/passwd", `/etc/passwd`, `C:\Windows\win.ini`, `\\server\share\x.md`,
+		"wiki", "wiki/", "wiki/..", "wiki/../credentials/note.md",
+		"wiki\x00/note.md", "wiki/note.md\x00",
+	}
+	writeOK := []string{
+		"inspirations/n.md", "_digests/n.md", "candidates/n.md", "dreams/n.md", "logs/n.md",
+		"dreams/a/b/c.md",
+	}
+	writeNo := []string{
+		"wiki/n.md", "memories/n.md", "credentials/n.md", "tmp/n.md",
+		"root.md", ".fish-import.json", "", "..", "../n.md",
+		"/n.md", `C:\n.md`, "logs/../../n.md",
+	}
+
+	for _, name := range readOK {
+		if _, err := sb.Read(name); err != nil {
+			t.Errorf("Read(%q): %v", name, err)
+		}
+	}
+	for _, name := range readNo {
+		if b, err := sb.Read(name); err == nil {
+			t.Errorf("Read(%q) was allowed: %q", name, b)
+		}
+	}
+	for _, name := range writeOK {
+		if err := sb.Write(name, []byte("n")); err != nil {
+			t.Errorf("Write(%q): %v", name, err)
+		}
+	}
+	for _, name := range writeNo {
+		if err := sb.Write(name, []byte("n")); err == nil {
+			t.Errorf("Write(%q) was allowed", name)
+		}
+	}
+	// nothing outside the allowlist was written, whatever was tried
+	for _, p := range []string{"credentials/n.md", "tmp/n.md"} {
+		if _, err := os.Lstat(filepath.Join(dir, filepath.FromSlash(p))); err == nil {
+			t.Errorf("%s was written", p)
+		}
+	}
+	// the vault's own record and the note at its root are untouched
+	if b, err := os.ReadFile(filepath.Join(dir, ".fish-import.json")); err != nil || string(b) != "{}\n" {
+		t.Fatalf("the vault's record: %q %v", b, err)
+	}
+	if b, err := os.ReadFile(filepath.Join(dir, "root.md")); err != nil || string(b) != "x\n" {
+		t.Fatalf("the note at the vault's root: %q %v", b, err)
+	}
+}
+
+// A listing gives what is under a folder a run may read, and never a note
+// outside them or a folder it may not use.
+func TestQASandboxListingMatrix(t *testing.T) {
+	sb, dir := openVault(t)
+	putFile(t, filepath.Join(dir, "wiki", "a.md"), "a\n")
+	putFile(t, filepath.Join(dir, "wiki", "sub", "b.md"), "b\n")
+	putFile(t, filepath.Join(dir, "credentials", "c.md"), "c\n")
+	entries, err := sb.List("")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, e := range entries {
+		names = append(names, e.Name)
+		if e.Name == "credentials" || e.Name == "tmp" {
+			t.Fatalf("a folder a run may not read was listed: %v", names)
+		}
+	}
+	for _, want := range []string{"wiki", "inspirations", "memories"} {
+		if !containsString(names, want) {
+			t.Errorf("%s isn't listed: %v", want, names)
+		}
+	}
+	for _, bad := range []string{"credentials", "tmp", "logs", "dreams"} {
+		if _, err := sb.List(bad); err == nil {
+			t.Errorf("List(%q) was allowed", bad)
+		}
+	}
+	// a folder of notes is listed with its folders first
+	entries, err = sb.List("wiki")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) < 2 || !entries[0].Dir || entries[0].Name != "sub" {
+		t.Fatalf("%+v", entries)
+	}
+	var listed []string
+	for _, e := range entries {
+		listed = append(listed, e.Name)
+	}
+	if !containsString(listed, "a.md") || !containsString(listed, "release.md") {
+		t.Fatalf("%v", listed)
+	}
+	// a note is not a folder, and a folder that isn't there says so
+	if _, err := sb.List("wiki/a.md"); err == nil {
+		t.Error("a note was listed as a folder")
+	}
+	if _, err := sb.List("wiki/nope"); err == nil {
+		t.Error("a folder that isn't there was listed")
+	}
+}
+
+// A name with a link anywhere in it is refused, even when the link stays
+// inside the vault, and even when it is above the folder the name starts
+// with.
+func TestQASandboxLinkMatrix(t *testing.T) {
+	sb, dir := openVault(t)
+	putFile(t, filepath.Join(dir, "credentials", "secret.md"), "SECRET\n")
+	// a Windows junction needs no privilege, so it is the link a test can
+	// make here
+	if out, err := mklink(filepath.Join(dir, "wiki", "creds"), filepath.Join(dir, "credentials")); err != nil {
+		t.Skipf("no junction here: %v %s", err, out)
+	}
+	if out, err := mklink(filepath.Join(dir, "wiki", "out"), t.TempDir()); err != nil {
+		t.Skipf("no junction here: %v %s", err, out)
+	}
+	for _, name := range []string{
+		"wiki/creds/secret.md", "wiki/out/x.md",
+		"wiki/creds", "wiki/out",
+	} {
+		if b, err := sb.Read(name); err == nil {
+			t.Errorf("Read(%q) was allowed through a junction: %q", name, b)
+		}
+	}
+	for _, name := range []string{"wiki/creds/n.md", "wiki/out/n.md"} {
+		if err := sb.Write(name, []byte("x")); err == nil {
+			t.Errorf("Write(%q) was allowed through a junction", name)
+		}
+	}
+	// and neither is listed as a folder a run may walk into
+	entries, err := sb.List("wiki")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, e := range entries {
+		if e.Name == "creds" || e.Name == "out" {
+			t.Fatalf("a junction was listed: %+v", e)
+		}
+	}
+}
+
+func containsString(ss []string, want string) bool {
+	for _, s := range ss {
+		if s == want {
+			return true
+		}
+	}
+	return false
+}
+
+// mklink makes a junction, the one kind of link Windows makes without a
+// privilege; on another OS it is a symbolic link.
+func mklink(link, target string) ([]byte, error) {
+	if err := os.Symlink(target, link); err == nil {
+		return nil, nil
+	}
+	return cmdMklink(link, target)
+}
+
+// The write budget is what one run may put in the vault, and it counts what
+// was written, not what was attempted: a refused write costs nothing.
+func TestQASandboxWriteBudget(t *testing.T) {
+	sb, _ := openVault(t)
+	chunk := make([]byte, MaxWriteFile)
+	var wrote int64
+	for i := 0; wrote+int64(len(chunk)) <= MaxWritten; i++ {
+		name := "logs/" + pad(i) + ".md"
+		if err := sb.Write(name, chunk); err != nil {
+			t.Fatalf("write %d: %v", i, err)
+		}
+		wrote += int64(len(chunk))
+	}
+	if sb.Written() != wrote {
+		t.Fatalf("written %d, want %d", sb.Written(), wrote)
+	}
+	// one byte more is refused, and the count doesn't move
+	if err := sb.Write("logs/over.md", []byte("x")); err == nil {
+		t.Fatal("a run wrote past its budget")
+	}
+	if sb.Written() != wrote {
+		t.Fatalf("a refused write counted: %d, want %d", sb.Written(), wrote)
+	}
+	// replacing a note counts what it is now, not what it was
+	small := make([]byte, 1024)
+	if err := sb.Write("logs/"+pad(0)+".md", small); err == nil {
+		t.Fatalf("a replacement was allowed with the budget spent: written %d", sb.Written())
+	}
+	_ = strings.TrimSpace("")
+}
diff --git a/internal/memagent/qa_probe_scratch_windows_test.go b/internal/memagent/qa_probe_scratch_windows_test.go
