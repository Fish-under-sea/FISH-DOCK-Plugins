diff --git a/internal/gui/qa_memory_agents_probe_test.go b/internal/gui/qa_memory_agents_probe_test.go
new file mode 100644
index 0000000..f423306
--- /dev/null
+++ b/internal/gui/qa_memory_agents_probe_test.go
@@ -0,0 +1,183 @@
+package gui
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/memagent"
+)
+
+// qaAgentsAt points the registry at a folder of this test's own.
+func qaAgentsAt(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	old := memagent.Path
+	memagent.Path = func() string { return filepath.Join(dir, "memory-agents.json") }
+	t.Cleanup(func() { memagent.Path = old })
+	return memagent.Path()
+}
+
+func qaMux(t *testing.T) *http.ServeMux {
+	t.Helper()
+	mux := http.NewServeMux()
+	memoryAgentRoutes(mux)
+	return mux
+}
+
+func qaPost(t *testing.T, mux *http.ServeMux, path, body string) (int, memoryAgentsView) {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("POST", path, strings.NewReader(body)))
+	var v memoryAgentsView
+	if rec.Code == 200 {
+		if err := json.Unmarshal(rec.Body.Bytes(), &v); err != nil {
+			t.Fatalf("%s: %s", path, rec.Body)
+		}
+	}
+	return rec.Code, v
+}
+
+func qaGet(t *testing.T, mux *http.ServeMux, path string) (int, memoryAgentsView) {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("GET", path, nil))
+	var v memoryAgentsView
+	if rec.Code == 200 {
+		if err := json.Unmarshal(rec.Body.Bytes(), &v); err != nil {
+			t.Fatalf("%s: %s", path, rec.Body)
+		}
+	}
+	return rec.Code, v
+}
+
+// ?role= takes the spellings a page sends, as the package's readers do: a
+// row asking for " Learn " gets learn's agents, not an empty list.
+func TestQARoleQueryCaseInsensitive(t *testing.T) {
+	qaAgentsAt(t)
+	mux := qaMux(t)
+	for _, spelling := range []string{"learn", "%20Learn%20", "LEARN"} {
+		code, v := qaGet(t, mux, "/api/memory/agents?role="+spelling)
+		if code != 200 {
+			t.Fatalf("role %q: %d", spelling, code)
+		}
+		if len(v.Agents) != 1 || !v.Agents[0].HasRole(memagent.Learn) {
+			t.Fatalf("role %q: %+v", spelling, v.Agents)
+		}
+	}
+}
+
+// The view's agents list is never null: a page that renders it as a list
+// gets an empty one, not a crash.
+func TestQAAgentsListIsNeverNull(t *testing.T) {
+	p := qaAgentsAt(t)
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte(`{"version":1,"agents":[]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	mux := qaMux(t)
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("GET", "/api/memory/agents", nil))
+	if rec.Code != 200 {
+		t.Fatalf("%d %s", rec.Code, rec.Body)
+	}
+	if !strings.Contains(rec.Body.String(), `"agents":[]`) {
+		t.Fatalf("agents isn't an empty list: %s", rec.Body)
+	}
+	// and the defaults map is an object, not null
+	if !strings.Contains(rec.Body.String(), `"defaults":{}`) {
+		t.Fatalf("defaults isn't an empty map: %s", rec.Body)
+	}
+}
+
+// A change the registry refuses is a 400 whose body says why, and the page
+// can show it: an error object, not an empty 200.
+func TestQAErrorsCarryAReason(t *testing.T) {
+	qaAgentsAt(t)
+	mux := qaMux(t)
+	for _, c := range []struct{ path, body string }{
+		{"/api/memory/agents", `{"id":"","name":"x","role":"learn","model":"m"}`},
+		{"/api/memory/agents", `{"id":"a","name":"x","role":"nope","model":"m"}`},
+		{"/api/memory/agents/update", `{"id":"gone","name":"x","role":"learn","model":"m"}`},
+		{"/api/memory/agents/remove", `{"id":"gone"}`},
+		{"/api/memory/agents/default", `{"role":"nope","id":"dreamer"}`},
+		{"/api/memory/agents/default", `{"role":"learn","id":"dreamer"}`},
+	} {
+		rec := httptest.NewRecorder()
+		mux.ServeHTTP(rec, httptest.NewRequest("POST", c.path, strings.NewReader(c.body)))
+		if rec.Code != 400 {
+			t.Fatalf("%s %s: %d", c.path, c.body, rec.Code)
+		}
+		var e struct {
+			Error string `json:"error"`
+		}
+		if err := json.Unmarshal(rec.Body.Bytes(), &e); err != nil || e.Error == "" {
+			t.Fatalf("%s %s: no reason in %s", c.path, c.body, rec.Body)
+		}
+	}
+}
+
+// Adding an agent through the route and reading it back through the route
+// gives what was sent: the two sides of the API agree.
+func TestQARouteRoundTrip(t *testing.T) {
+	qaAgentsAt(t)
+	mux := qaMux(t)
+	sent := `{"id":"round","name":"往返","role":"organize","model":"group/deepseek","effort":"high","schedule":"daily 22:00","scopes":["global","project:*"]}`
+	code, v := qaPost(t, mux, "/api/memory/agents", sent)
+	if code != 200 {
+		t.Fatalf("add: %d", code)
+	}
+	var got *memagent.Agent
+	for i := range v.Agents {
+		if v.Agents[i].ID == "round" {
+			got = &v.Agents[i]
+		}
+	}
+	if got == nil {
+		t.Fatalf("not in the view: %+v", v.Agents)
+	}
+	if got.Name != "往返" || got.Role != memagent.Organize || got.Model != "group/deepseek" ||
+		got.Effort != "high" || got.Schedule != "daily 22:00" || len(got.Scopes) != 2 {
+		t.Fatalf("round trip: %+v", got)
+	}
+	// the GET the page makes next says the same
+	_, again := qaGet(t, mux, "/api/memory/agents")
+	found := false
+	for _, a := range again.Agents {
+		if a.ID == "round" {
+			found = a.Name == "往返" && a.Role == memagent.Organize
+		}
+	}
+	if !found {
+		t.Fatalf("GET differs: %+v", again.Agents)
+	}
+}
+
+// A registry a user emptied through the route is restored by the route, and
+// the presets come back as first made.
+func TestQARestoreAfterEmptyingThroughRoutes(t *testing.T) {
+	qaAgentsAt(t)
+	mux := qaMux(t)
+	for _, id := range []string{"memory-curator", "dreamer"} {
+		if code, _ := qaPost(t, mux, "/api/memory/agents/remove", `{"id":"`+id+`"}`); code != 200 {
+			t.Fatalf("remove %s: %d", id, code)
+		}
+	}
+	code, v := qaGet(t, mux, "/api/memory/agents")
+	if code != 200 || len(v.Agents) != 0 {
+		t.Fatalf("emptied: %d %+v", code, v.Agents)
+	}
+	code, v = qaPost(t, mux, "/api/memory/agents/restore", `{}`)
+	if code != 200 || len(v.Agents) != 2 {
+		t.Fatalf("restore: %d %+v", code, v.Agents)
+	}
+	if v.Defaults[memagent.Learn] != "memory-curator" || v.Defaults[memagent.Dream] != "dreamer" {
+		t.Fatalf("defaults: %+v", v.Defaults)
+	}
+}
