+
+// A registry whose folder can't be made, or whose file can't be written, is
+// an error: a change isn't reported as made when nothing was written.
+func TestSaveErrors(t *testing.T) {
+	dir := t.TempDir()
+	blocked := filepath.Join(dir, "blocked")
+	if err := os.WriteFile(blocked, []byte("x"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	old := Path
+	// the file's own folder is a file: MkdirAll can't make it
+	Path = func() string { return filepath.Join(blocked, "memory-agents.json") }
+	t.Cleanup(func() { Path = old })
+	if err := save(Builtin()); err == nil {
