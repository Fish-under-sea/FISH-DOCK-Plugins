+// The Memory tab's static contract: no model is ever offered where an
+// agent is picked, and every request speaks the fields the routes read.
+//
+// This runs without a browser, so it holds whether or not Playwright is
+// installed: it reads the client's source rather than a rendered page. What
+// a rendered page does is the Playwright suite's business
+// (internal/gui/tests/library-memory.test.cjs).
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+
+const src = fs.readFileSync(path.join(__dirname, "..", "assets", "plugins", "library", "client.js"), "utf8");
+
+// between is the source of one function, from its `function name(` to the
+// line that closes it at the same depth.
+function between(name) {
+  const at = src.indexOf("function " + name + "(");
+  assert.ok(at >= 0, name + " is in client.js");
+  const start = src.lastIndexOf("\n", at) + 1;
+  const end = src.indexOf("\n  }", at);
+  assert.ok(end > at, name + " ends");
+  return src.slice(start, end);
+}
+
+test("no model is offered in the memory rows", () => {
+  for (const fn of ["memAgentPick", "distillRow", "dreamRow"]) {
+    const body = between(fn);
+    assert.ok(!/\bmodels\b/.test(body), fn + " reads the models list");
+    assert.ok(!/\bmodelName\b/.test(body), fn + " names a model");
+    assert.ok(!/d\.model\b/.test(body), fn + " sends d.model");
+  }
+});
+
+test("the agent picker sends the agent, not a model", () => {
+  const body = between("distillRow");
+  assert.match(body, /memory\/distill", \{ on: d\.on, agent/, "the switch sends agent");
+  assert.match(body, /memory\/distill", \{ on: d\.on, agent: v \}/, "picking sends agent");
+  assert.ok(!/on: d\.on, model/.test(body), "nothing sends model");
+});
+
+test("the tidy sends its own agent", () => {
+  const body = between("dreamRow");
+  assert.match(body, /dreamAgent: v/, "picking sends dreamAgent");
+  assert.match(body, /dreamAgents/, "it lists dream's agents");
+});
+
+test("the effort and range pickers speak agent too", () => {
+  for (const fn of ["memEffortPick", "memRangePick"]) {
+    const body = between(fn);
+    assert.match(body, /agent: d\.agent \|\| ""/, fn + " sends agent");
+    assert.ok(!/model:/.test(body), fn + " still sends model");
+  }
+});
+
+test("the panel reads the agent routes it writes", () => {
+  const body = between("agentAct");
+  assert.match(body, /api\(path, body\)/, "a change goes through api()");
+  const panel = between("memAgentPanel");
+  for (const route of ["memory/agents/default", "memory/agents/remove", "memory/agents/restore"]) {
+    assert.ok(panel.includes(route) || between("agentAct").includes("path"), route + " is reachable");
+  }
+  assert.match(panel, /memAgents\.agents/, "the list is the registry's");
+  assert.match(panel, /memAgents\.defaults/, "the defaults are the registry's");
+  assert.match(panel, /roleName/, "a role is named for the user");
+});
+
+test("the status poll reads the run going and names its role", () => {
+  const body = between("agentWatch");
+  assert.match(body, /memory\/agents\/status\?role=/, "the status route with the role");
+  assert.match(body, /memStatusView\?\.running|memStatusView\.running/, "it polls only while one goes");
+});
+
+test("a run and a stop go to the role's own routes", () => {
+  const run = between("agentRun");
+  assert.match(run, /memory\/agents\/" \+ role \+ "\/run"/, "the run route names the role");
+  const stop = between("agentStop");
+  assert.match(stop, /memory\/agents\/" \+ role \+ "\/stop"/, "the stop route names the role");
+});
+
+test("the page loads the agents and a status with the memory tab", () => {
+  const body = between("loadMemory");
+  assert.match(body, /api\("memory\/agents"\)/, "the agents are read");
+  assert.match(body, /api\("memory\/agents\/status"\)/, "the status is read");
+});
