+
+// The registry lives in magpie's own config folder, beside distill.json and
+// the memory folder, so a portable run and an installed one each read their
+// own.
+func TestPathIsInTheConfigFolder(t *testing.T) {
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	// the package's own Path, not a test's stand-in: what a real run reads
