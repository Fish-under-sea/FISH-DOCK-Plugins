+package catalog
+
+import "testing"
+
+// #24：图像 / 视频 / 语音 / 向量都不算「拿来聊天的」，Chat 只留对话模型。
+// 语音与向量走上游的 Serves（speech / transcription / embedding / rerank），
+// 图像与视频走 Draws / Films——一套字段，不另立布尔。
+func TestChatKeepsOnlyModelsToTalkTo(t *testing.T) {
+	ms := []Model{
+		{ID: "gpt-6"},
+		{ID: "gpt-image-2", Draws: true},
+		{ID: "veo-3.1", Films: true},
+		{ID: "suno_sound", Serves: ServesSpeech},
+		{ID: "whisper-1", Serves: ServesTranscription},
+		{ID: "text-embedding-3-large", Serves: ServesEmbedding},
+		{ID: "bge-reranker", Serves: ServesRerank},
+	}
+	got := Chat(ms)
+	if len(got) != 1 || got[0].ID != "gpt-6" {
+		t.Fatalf("Chat = %+v, want only gpt-6", got)
+	}
+}
