@@ -0,0 +1,419 @@
+package memagent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/filelock"
+	"github.com/yetone/magpie/internal/memory"
+)
+
+// runAt points everything a run writes at the test's own folders: the
+// vault, the memory store, the scratch space, the run's lock and its
+// last-run record.
+func runAt(t *testing.T) string {
+	t.Helper()
+	dir := vault(t)
+	oldVault := dir
+	_ = oldVault
+	oldScratch, oldLock, oldRuns := ScratchRoot, RunLockPath, RunsPath
+	oldMemory := memory.Path
+	scratch := filepath.Join(dir, "cache", "memory-agent", "work")
+	ScratchRoot = func() string { return scratch }
+	RunLockPath = func() string { return filepath.Join(dir, "memory-agent.run") }
+	RunsPath = func() string { return filepath.Join(dir, "memory-agent-runs.json") }
+	memory.Path = func() string { return filepath.Join(dir, "memories.json") }
+	t.Cleanup(func() {
+		ScratchRoot, RunLockPath, RunsPath = oldScratch, oldLock, oldRuns
+		memory.Path = oldMemory
+	})
+	return dir
+}
+
+// asker is a model that answers from a script: each turn it gives what the
+// script says, and records what it was asked.
+type asker struct {
+	mu      sync.Mutex
+	replies []Turn
+	asked   []Request
+}
+
+func (a *asker) ask(_ context.Context, req Request) (Turn, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.asked = append(a.asked, req)
+	if len(a.replies) == 0 {
+		return Turn{Text: "done"}, nil
+	}
+	t := a.replies[0]
+	a.replies = a.replies[1:]
+	return t, nil
+}
+
+// count is how many turns the model was asked, so far.
+func (a *asker) count() int {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return len(a.asked)
+}
+
+// call is one tool call as a model gives it.
+func call(id, name string, in map[string]any) Call {
+	b, _ := json.Marshal(in)
+	return Call{ID: id, Name: name, Input: b}
+}
+
+// A run asks the model, runs the tools it asks for, hands the results back
+// and ends at a turn with no calls; what it wrote is counted and said.
+func TestRunLoopsUntilTheModelStops(t *testing.T) {
+	dir := runAt(t)
+	a := &asker{replies: []Turn{
+		{Text: "Let me look at the notes.", Calls: []Call{call("c1", ToolVaultList, map[string]any{})}},
+		{Calls: []Call{
+			call("c2", ToolVaultRead, map[string]any{"path": "wiki/release.md"}),
+			call("c3", ToolVaultWrite, map[string]any{"path": "dreams/2026-11-16.md", "text": "# a dream\n"}),
+			call("c4", ToolMemorySave, map[string]any{"text": "Releases go out on Tuesdays", "kind": "fact"}),
+		}},
+		{Text: "Wrote one dream."},
+	}}
+	res, err := Run(context.Background(), Task{
+		Role: Dream, Agent: DefaultAgent, Model: "group/deepseek",
+		System: "you are the memory agent", Prompt: "dream across the notes",
+	}, Options{Ask: a.ask, Vault: dir})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Steps != 3 || res.Wrote != 1 || res.Saved != 1 || res.Text != "Wrote one dream." || res.Phase != PhaseDone {
+		t.Fatalf("%+v", res)
+	}
+	if b, err := os.ReadFile(filepath.Join(dir, "dreams", "2026-11-16.md")); err != nil || string(b) != "# a dream\n" {
+		t.Fatalf("the note: %q %v", b, err)
+	}
+	// the model was given the agent's instructions and the tools
+	if len(a.asked) != 3 || a.asked[0].System != "you are the memory agent" || a.asked[0].Model != "group/deepseek" {
+		t.Fatalf("asked: %+v", a.asked[0])
+	}
+	names := map[string]bool{}
+	for _, tl := range a.asked[0].Tools {
+		names[tl.Name] = true
+	}
+	for _, want := range []string{ToolMemorySearch, ToolMemorySave, ToolMemoryForget, ToolMemoryContext, ToolVaultList, ToolVaultRead, ToolVaultWrite, ToolScratchWrite, ToolScratchRead} {
+		if !names[want] {
+			t.Errorf("no tool %q in %v", want, names)
+		}
+	}
+	// the second turn was given the first turn's call and its result
+	msgs := a.asked[1].Messages
+	if len(msgs) != 3 || msgs[1]["role"] != "assistant" || msgs[2]["role"] != "user" {
+		t.Fatalf("the conversation: %+v", msgs)
+	}
+	results, ok := msgs[2]["content"].([]any)
+	if !ok || len(results) != 1 {
+		t.Fatalf("the results: %+v", msgs[2]["content"])
+	}
+	if block := results[0].(map[string]any); block["tool_use_id"] != "c1" || !strings.Contains(fmt.Sprint(block["content"]), "wiki/") {
+		t.Fatalf("the result block: %+v", block)
+	}
+	// the run is done, and its last one is kept for the window
+	st := StatusOf(Dream)
+	if st.Running || st.Phase != PhaseDone || st.Steps != 3 || st.Wrote != 1 || st.Saved != 1 || st.Error != "" {
+		t.Fatalf("status: %+v", st)
+	}
+	if len(st.Messages) == 0 {
+		t.Fatal("the transcript is empty")
+	}
+	// its scratch folder is gone
+	if _, err := os.Lstat(filepath.Join(dir, "cache", "memory-agent", "work", st.Role+"-"+st.Started.UTC().Format("20060102T150405"))); err == nil {
+		t.Fatal("the run's scratch folder is still there")
+	}
+	// and the next run of the role starts from a clean progress
+	st = StatusOf(Organize)
+	if st.Running || st.Phase != "" {
+		t.Fatalf("another role: %+v", st)
+	}
+}
+
+// A tool that fails says so to the model, which may try another; the run
+// goes on. A path outside the allowlist is one such failure.
+func TestRunGivesAToolErrorBackToTheModel(t *testing.T) {
+	dir := runAt(t)
+	a := &asker{replies: []Turn{
+		{Calls: []Call{
+			call("c1", ToolVaultRead, map[string]any{"path": "credentials/token.txt"}),
+			call("c2", "no_such_tool", map[string]any{}),
+		}},
+		{Text: "That isn't mine to read."},
+	}}
+	res, err := Run(context.Background(), Task{Role: Organize, Model: "m", Prompt: "p"}, Options{Ask: a.ask, Vault: dir})
+	if err != nil || res.Phase != PhaseDone || res.Steps != 2 {
+		t.Fatalf("%+v %v", res, err)
+	}
+	results := a.asked[1].Messages[2]["content"].([]any)
+	first := results[0].(map[string]any)
+	if first["is_error"] != true || !strings.Contains(fmt.Sprint(first["content"]), "outside") {
+		t.Fatalf("the refused read: %+v", first)
+	}
+	second := results[1].(map[string]any)
+	if second["is_error"] != true || !strings.Contains(fmt.Sprint(second["content"]), "no tool named") {
+		t.Fatalf("an unknown tool: %+v", second)
+	}
+}
+
+// A model that keeps calling tools is ended at MaxSteps rather than left
+// to spend, and the run says why.
+func TestRunEndsAtTheStepLimit(t *testing.T) {
+	dir := runAt(t)
+	loop := make([]Turn, 10)
+	for i := range loop {
+		loop[i] = Turn{Calls: []Call{call(fmt.Sprint("c", i), ToolVaultList, map[string]any{})}}
+	}
+	a := &asker{replies: loop}
+	_, err := Run(context.Background(), Task{Role: Learn, Model: "m", Prompt: "p"},
+		Options{Ask: a.ask, Vault: dir, MaxSteps: 3})
+	if err == nil || !strings.Contains(err.Error(), "3 turns") {
+		t.Fatalf("err: %v", err)
+	}
+	st := StatusOf(Learn)
+	if st.Running || st.Phase != PhaseFailed || !strings.Contains(st.Error, "3 turns") {
+		t.Fatalf("status: %+v", st)
+	}
+	if len(a.asked) != 3 {
+		t.Fatalf("asked %d turns", len(a.asked))
+	}
+}
+
+// Stop ends the run going: it isn't an error, its phase says stopped, and
+// what it wrote stands.
+func TestStopEndsTheRun(t *testing.T) {
+	dir := runAt(t)
+	var once sync.Once
+	a := &asker{}
+	a.replies = nil
+	ask := func(ctx context.Context, req Request) (Turn, error) {
+		a.mu.Lock()
+		n := len(a.asked)
+		a.asked = append(a.asked, req)
+		a.mu.Unlock()
+		switch n {
+		case 0:
+			return Turn{Calls: []Call{call("c1", ToolVaultWrite, map[string]any{"path": "logs/run.md", "text": "wrote\n"})}}, nil
+		case 1:
+			once.Do(Stop)
+			<-ctx.Done()
+			return Turn{}, ctx.Err()
+		}
+		return Turn{Text: "done"}, nil
+	}
+	res, err := Run(context.Background(), Task{Role: Organize, Model: "m", Prompt: "p"}, Options{Ask: ask, Vault: dir})
+	if err != nil {
+		t.Fatalf("a stopped run is not an error: %v", err)
+	}
+	if res.Phase != PhaseStopped {
+		t.Fatalf("%+v", res)
+	}
+	if b, err := os.ReadFile(filepath.Join(dir, "logs", "run.md")); err != nil || string(b) != "wrote\n" {
+		t.Fatalf("what it wrote went: %q %v", b, err)
+	}
+	if st := StatusOf(Organize); st.Running || st.Phase != PhaseStopped || st.Error != "" {
+		t.Fatalf("status: %+v", st)
+	}
+	// the next run goes again: Stop is the run going's, not the role's
+	a.replies = []Turn{{Text: "done"}}
+	if res, err := Run(context.Background(), Task{Role: Organize, Model: "m", Prompt: "p"}, Options{Ask: a.ask, Vault: dir}); err != nil || res.Phase != PhaseDone {
+		t.Fatalf("the run after a stop: %+v %v", res, err)
+	}
+}
+
+// One run at a time: a second asked for while one is going is refused, in
+// this process and across magpies (the .run lock).
+func TestOneRunAtATime(t *testing.T) {
+	dir := runAt(t)
+	going := make(chan struct{})
+	release := make(chan struct{})
+	ask := func(ctx context.Context, req Request) (Turn, error) {
+		select {
+		case <-going:
+		default:
+			close(going)
+		}
+		select {
+		case <-release:
+			return Turn{Text: "done"}, nil
+		case <-ctx.Done():
+			return Turn{}, ctx.Err()
+		}
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, err := Run(context.Background(), Task{Role: Dream, Model: "m", Prompt: "p"}, Options{Ask: ask, Vault: dir})
+		done <- err
+	}()
+	<-going
+	if _, err := Run(context.Background(), Task{Role: Dream, Model: "m", Prompt: "p"}, Options{Ask: ask, Vault: dir}); !errors.Is(err, ErrRunning) {
+		t.Fatalf("a second run in this process: %v", err)
+	}
+	// another magpie's run holds the .run file
+	if unlock, held := filelock.Lock(RunLockPath(), 0); held {
+		unlock()
+		t.Fatal("the run's lock was free while a run was going")
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	// and once it ended, the lock is free again
+	unlock, held := filelock.Lock(RunLockPath(), 0)
+	if !held {
+		t.Fatal("the run's lock is still held after it ended")
+	}
+	unlock()
+}
+
+// A run with no vault, an unknown role, or no model is refused before it
+// asks anything.
+func TestRunRefusesWhatItCantDo(t *testing.T) {
+	dir := runAt(t)
+	a := &asker{}
+	if _, err := Run(context.Background(), Task{Role: "nope", Model: "m", Prompt: "p"}, Options{Ask: a.ask, Vault: dir}); err == nil {
+		t.Fatal("an unknown role")
+	}
+	if _, err := Run(context.Background(), Task{Role: Dream, Model: "m", Prompt: "p"}, Options{Ask: a.ask}); !errors.Is(err, ErrNoVault) {
+		t.Fatalf("no vault: %v", err)
+	}
+	if _, err := Run(context.Background(), Task{Role: Dream, Model: "m", Prompt: "p"}, Options{Vault: dir}); err == nil {
+		t.Fatal("no model to ask")
+	}
+	if len(a.asked) != 0 {
+		t.Fatalf("the model was asked %d turns", len(a.asked))
+	}
+	if Running() {
+		t.Fatal("a refused run left the process busy")
+	}
+}
+
+// A model that fails ends the run, and the error is kept for the window:
+// what it wrote before stands, and nothing else is touched.
+func TestRunFailsWhenTheModelFails(t *testing.T) {
+	dir := runAt(t)
+	a := &asker{replies: []Turn{{Calls: []Call{call("c1", ToolVaultWrite, map[string]any{"path": "logs/a.md", "text": "x"})}}}}
+	ask := func(ctx context.Context, req Request) (Turn, error) {
+		if a.count() == 1 {
+			return Turn{}, errors.New("the gateway refused: no credit")
+		}
+		return a.ask(ctx, req)
+	}
+	_, err := Run(context.Background(), Task{Role: Learn, Model: "m", Prompt: "p"}, Options{Ask: ask, Vault: dir})
+	if err == nil || !strings.Contains(err.Error(), "no credit") {
+		t.Fatalf("err: %v", err)
+	}
+	if st := StatusOf(Learn); st.Phase != PhaseFailed || !strings.Contains(st.Error, "no credit") || st.Running {
+		t.Fatalf("status: %+v", st)
+	}
+	if b, err := os.ReadFile(filepath.Join(dir, "logs", "a.md")); err != nil || string(b) != "x" {
+		t.Fatalf("what it wrote went: %q %v", b, err)
+	}
+	// and the last run is kept across a restart: read again from disk
+	if last, err := loadRuns(); err != nil || last.Last[Learn] == nil || last.Last[Learn].Phase != PhaseFailed {
+		t.Fatalf("kept: %+v %v", last, err)
+	}
+}
+
+// The tools a run's mcp.json adds are given with the rest, and a name given
+// twice is refused rather than shown twice.
+func TestRunAddsToolsAndRefusesADuplicate(t *testing.T) {
+	dir := runAt(t)
+	var called bool
+	extra := Tool{
+		Name:        "extra_echo",
+		Description: "says what it is given",
+		Schema:      map[string]any{"type": "object", "properties": map[string]any{"q": map[string]any{"type": "string"}}},
+		Call: func(_ context.Context, in json.RawMessage) (string, error) {
+			called = true
+			return "echo: " + string(in), nil
+		},
+	}
+	a := &asker{replies: []Turn{{Calls: []Call{call("c1", "extra_echo", map[string]any{"q": "hi"})}}, {Text: "done"}}}
+	res, err := Run(context.Background(), Task{Role: Dream, Model: "m", Prompt: "p"},
+		Options{Ask: a.ask, Vault: dir, Tools: []Tool{extra}})
+	if err != nil || !called || res.Phase != PhaseDone {
+		t.Fatalf("%+v %v called=%v", res, err, called)
+	}
+	found := false
+	for _, tl := range a.asked[0].Tools {
+		if tl.Name == "extra_echo" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("the added tool wasn't given to the model")
+	}
+	dup := extra
+	dup.Name = ToolVaultRead
+	if _, err := Run(context.Background(), Task{Role: Dream, Model: "m", Prompt: "p"},
+		Options{Ask: a.ask, Vault: dir, Tools: []Tool{dup}}); err == nil || !strings.Contains(err.Error(), "two tools") {
+		t.Fatalf("a duplicate tool: %v", err)
+	}
+}
+
+// A run that takes too long is ended, and the run's own time limit is the
+// one that ends it.
+func TestRunEndsAtItsTimeout(t *testing.T) {
+	dir := runAt(t)
+	ask := func(ctx context.Context, _ Request) (Turn, error) {
+		<-ctx.Done()
+		return Turn{}, ctx.Err()
+	}
+	start := time.Now()
+	_, err := Run(context.Background(), Task{Role: Learn, Model: "m", Prompt: "p"},
+		Options{Ask: ask, Vault: dir, Timeout: 50 * time.Millisecond})
+	if err == nil {
+		t.Fatal("a run past its timeout ended without an error")
+	}
+	if time.Since(start) > 5*time.Second {
+		t.Fatalf("the run took %v", time.Since(start))
+	}
+	if st := StatusOf(Learn); st.Phase != PhaseFailed || st.Running {
+		t.Fatalf("status: %+v", st)
+	}
+}
+
+// What the window polls while a run goes: the phase and the step it is on,
+// and the transcript as it grows.
+func TestStatusWhileTheRunGoes(t *testing.T) {
+	dir := runAt(t)
+	var seen []Status
+	ask := func(ctx context.Context, req Request) (Turn, error) {
+		seen = append(seen, StatusOf(Dream))
+		if len(seen) == 1 {
+			return Turn{Text: "looking", Calls: []Call{call("c1", ToolVaultList, map[string]any{})}}, nil
+		}
+		return Turn{Text: "done"}, nil
+	}
+	if _, err := Run(context.Background(), Task{Role: Dream, Model: "m", Prompt: "p"}, Options{Ask: ask, Vault: dir}); err != nil {
+		t.Fatal(err)
+	}
+	if len(seen) != 2 {
+		t.Fatalf("seen %d", len(seen))
+	}
+	if !seen[0].Running || seen[0].Role != Dream || seen[0].Doing != 0 || seen[0].Of != MaxSteps {
+		t.Fatalf("the first turn: %+v", seen[0])
+	}
+	if !seen[1].Running || seen[1].Doing != 1 || seen[1].Steps != 2 {
+		t.Fatalf("the second turn: %+v", seen[1])
+	}
+	if len(seen[1].Messages) == 0 {
+		t.Fatal("the transcript was empty while the run went")
+	}
+	last := seen[1].Messages[len(seen[1].Messages)-1]
+	if last.Role != "tool" || last.Tool != ToolVaultList || !strings.Contains(last.Text, "wiki/") {
+		t.Fatalf("the last message: %+v", last)
+	}
+}
