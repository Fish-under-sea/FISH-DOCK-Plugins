diff --git a/internal/memagent/sandbox.go b/internal/memagent/sandbox.go
new file mode 100644
index 0000000..254db5a
--- /dev/null
+++ b/internal/memagent/sandbox.go
@@ -0,0 +1,473 @@
+package memagent
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+)
+
+// The vault folders a memory agent may read and write. A path a tool gives
+// has to start with one of them: the vault's own record, magpie's folders
+// beside it and everything outside the vault are never reached. Memories
+// are read here and written through the memory tools alone, which keep
+// their own lock and the origin rules.
+var (
+	// Readable are the vault's folders a run may read.
+	Readable = []string{"wiki", "inspirations", "memories"}
+	// Writable are the folders a run may write its own products into.
+	Writable = []string{"inspirations", "_digests", "candidates", "dreams", "logs"}
+)
+
+// What one run may read and write, so one note or a loop gone wrong can't
+// fill the vault or the window it is shown in.
+const (
+	// MaxReadFile is the largest note a run is shown.
+	MaxReadFile = 4 << 20
+	// MaxWriteFile is the largest file a run may write.
+	MaxWriteFile = 1 << 20
+	// MaxWritten is how much one run may write into the vault in all.
+	MaxWritten = 8 << 20
+	// MaxListed is the most entries one listing gives.
+	MaxListed = 2000
+)
+
+// ErrOutside is a path a run may not touch: outside the vault, outside the
+// folders it may read or write, or reached through a link.
+var ErrOutside = errors.New("outside the folders a memory agent may use")
+
+// Policy configures readable, writable and explicitly denied vault subpaths.
+type Policy struct {
+	Read  []string
+	Write []string
+	Deny  []string
+}
+
+func cleanPolicyList(in []string) ([]string, bool) {
+	var out []string
+	all := false
+	for _, raw := range in {
+		s := strings.TrimSpace(filepath.ToSlash(raw))
+		s = strings.TrimPrefix(s, "./")
+		s = strings.Trim(s, "/")
+		if s == "" {
+			continue
+		}
+		if s == "." {
+			all = true
+			continue
+		}
+		if !slices.Contains(out, s) {
+			out = append(out, s)
+		}
+	}
+	return out, all
+}
+
+// Sandbox confines one run's file access to a vault's allowlisted folders.
+// Every name goes through an os.Root opened on the vault, so one that
+// leaves it is refused by the kernel, and every component is checked for a
+// link first, so a link that stays inside the vault is refused too.
+type Sandbox struct {
+	root       *os.Root
+	dir        string
+	written    int64
+	readAllow  []string
+	readAll    bool
+	writeAllow []string
+	deny       []string
+}
+
+// OpenSandbox opens the knowledge vault at dir for one run.
+func OpenSandbox(dir string) (*Sandbox, error) {
+	return OpenSandboxWith(dir, Policy{})
+}
+
+// OpenSandboxWith opens the knowledge vault at dir constrained by policy.
+func OpenSandboxWith(dir string, policy Policy) (*Sandbox, error) {
+	if strings.TrimSpace(dir) == "" {
+		return nil, errors.New("no knowledge vault to work in")
+	}
+	info, err := os.Lstat(dir)
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return nil, fmt.Errorf("%s isn't an independent folder", dir)
+	}
+	root, err := os.OpenRoot(dir)
+	if err != nil {
+		return nil, err
+	}
+	readList, readAll := cleanPolicyList(policy.Read)
+	writeList, _ := cleanPolicyList(policy.Write)
+	denyList, _ := cleanPolicyList(policy.Deny)
+	return &Sandbox{
+		root:       root,
+		dir:        dir,
+		readAllow:  readList,
+		readAll:    readAll,
+		writeAllow: writeList,
+		deny:       denyList,
+	}, nil
+}
+
+// Dir is the vault the sandbox is opened on.
+func (s *Sandbox) Dir() string { return s.dir }
+
+// Close lets go of the vault's handle.
+func (s *Sandbox) Close() error {
+	if s == nil || s.root == nil {
+		return nil
+	}
+	return s.root.Close()
+}
+
+// Written is how much this run has written into the vault.
+func (s *Sandbox) Written() int64 { return s.written }
+
+// Entry is one name a listing gives: a folder or a note.
+type Entry struct {
+	Name string `json:"name"`
+	Dir  bool   `json:"dir,omitempty"`
+	Size int64  `json:"size,omitempty"`
+}
+
+// Read is the note at name, a path inside the vault under allowed read folders.
+func (s *Sandbox) Read(name string) ([]byte, error) {
+	if s == nil || s.root == nil {
+		return nil, errors.New("no knowledge vault to read from")
+	}
+	rel, err := s.relNameRead(name)
+	if err != nil {
+		return nil, err
+	}
+	info, err := s.root.Lstat(rel)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fmt.Errorf("%w: %q isn't a note", ErrOutside, rel)
+	}
+	if info.Size() > MaxReadFile {
+		return nil, fmt.Errorf("%q is %d bytes; a run reads at most %d", rel, info.Size(), MaxReadFile)
+	}
+	return s.root.ReadFile(rel)
+}
+
+// List is the names in a folder of the vault. An empty name lists the
+// folders a run may read.
+func (s *Sandbox) List(name string) ([]Entry, error) {
+	if s == nil || s.root == nil {
+		return nil, errors.New("no knowledge vault to read from")
+	}
+	name = strings.TrimSpace(name)
+	if name == "" || (s.readAll && (name == "." || name == "./")) {
+		if s.readAll {
+			return s.listRoot("")
+		}
+		allow := s.readAllow
+		if len(allow) == 0 {
+			allow = Readable
+		}
+		out := make([]Entry, 0, len(allow))
+		for _, d := range allow {
+			if s.isDenied(d) {
+				continue
+			}
+			if _, err := s.root.Lstat(d); err == nil {
+				out = append(out, Entry{Name: d, Dir: true})
+			}
+		}
+		return out, nil
+	}
+	rel, err := s.relNameRead(name)
+	if err != nil {
+		return nil, err
+	}
+	info, err := s.root.Lstat(rel)
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() {
+		return nil, fmt.Errorf("%w: %q isn't a folder", ErrOutside, rel)
+	}
+	return s.listRoot(rel)
+}
+
+func (s *Sandbox) listRoot(rel string) ([]Entry, error) {
+	target := rel
+	if target == "" {
+		target = "."
+	}
+	entries, err := fs.ReadDir(s.root.FS(), target)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Entry, 0, len(entries))
+	for _, e := range entries {
+		if len(out) >= MaxListed {
+			break
+		}
+		childRel := e.Name()
+		if rel != "" {
+			childRel = path.Join(rel, e.Name())
+		}
+		if s.isDenied(childRel) {
+			continue
+		}
+		fi, err := s.root.Lstat(childRel)
+		if err != nil || fi.Mode()&os.ModeSymlink != 0 {
+			continue // a link or denied entry is never shown: nothing here reads it
+		}
+		switch {
+		case fi.IsDir():
+			out = append(out, Entry{Name: e.Name(), Dir: true})
+		case fi.Mode().IsRegular():
+			out = append(out, Entry{Name: e.Name(), Size: fi.Size()})
+		}
+	}
+	slices.SortStableFunc(out, func(a, b Entry) int {
+		if a.Dir != b.Dir {
+			if a.Dir {
+				return -1
+			}
+			return 1
+		}
+		return strings.Compare(a.Name, b.Name)
+	})
+	return out, nil
+}
+
+// Write puts b at name, a path inside the vault under one of writeAllow. The
+// note is written beside itself and renamed over, so a run cut off halfway
+// leaves the note it had, never half of a new one.
+func (s *Sandbox) Write(name string, b []byte) error {
+	if s == nil || s.root == nil {
+		return errors.New("no knowledge vault to write to")
+	}
+	rel, err := s.relNameWrite(name)
+	if err != nil {
+		return err
+	}
+	if len(b) > MaxWriteFile {
+		return fmt.Errorf("%q is %d bytes; a run writes at most %d", rel, len(b), MaxWriteFile)
+	}
+	if s.written+int64(len(b)) > MaxWritten {
+		return fmt.Errorf("this run has written %d bytes already; a run writes at most %d", s.written, MaxWritten)
+	}
+	if dir := path.Dir(rel); dir != "." && dir != "/" {
+		if err := s.root.MkdirAll(dir, 0o700); err != nil {
+			return err
+		}
+	}
+	tmp := fmt.Sprintf("%s.tmp-%d-%d", rel, os.Getpid(), time.Now().UnixNano())
+	f, err := s.root.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	_, werr := f.Write(b)
+	if werr == nil {
+		werr = f.Sync()
+	}
+	cerr := f.Close()
+	if werr == nil {
+		werr = cerr
+	}
+	if werr != nil {
+		_ = s.root.Remove(tmp)
+		return werr
+	}
+	if err := s.root.Rename(tmp, rel); err != nil {
+		_ = s.root.Remove(tmp)
+		return err
+	}
+	s.written += int64(len(b))
+	return nil
+}
+
+// Append adds b to the end of name, a path inside the vault under one of
+// Writable, making the note and the folders above it when they aren't
+// there. A note that is only ever added to — the conflicts log — is added
+// to as it stands, never rewritten: the one who wrote it before is another
+// run, whose lines are not this run's to lay out again.
+func (s *Sandbox) Append(name string, b []byte) error {
+	if s == nil || s.root == nil {
+		return errors.New("no knowledge vault to write to")
+	}
+	rel, err := s.relNameWrite(name)
+	if err != nil {
+		return err
+	}
+	if len(b) > MaxWriteFile {
+		return fmt.Errorf("%q is %d bytes; a run writes at most %d", rel, len(b), MaxWriteFile)
+	}
+	if dir := path.Dir(rel); dir != "." && dir != "/" {
+		if err := s.root.MkdirAll(dir, 0o700); err != nil {
+			return err
+		}
+	}
+	// the note there now is weighed first: what is added is over the run's
+	// budget when the note as it would stand is
+	var held int64
+	if info, err := s.root.Lstat(rel); err == nil && info.Mode().IsRegular() {
+		held = info.Size()
+	}
+	if held+int64(len(b)) > MaxWriteFile {
+		return fmt.Errorf("%q would be %d bytes; a run writes at most %d", rel, held+int64(len(b)), MaxWriteFile)
+	}
+	if s.written+int64(len(b)) > MaxWritten {
+		return fmt.Errorf("this run has written %d bytes already; a run writes at most %d", s.written, MaxWritten)
+	}
+	f, err := s.root.OpenFile(rel, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
+	if err != nil {
+		return err
+	}
+	_, werr := f.Write(b)
+	if werr == nil {
+		werr = f.Sync()
+	}
+	cerr := f.Close()
+	if werr != nil {
+		return werr
+	}
+	if cerr != nil {
+		return cerr
+	}
+	s.written += int64(len(b))
+	return nil
+}
+
+// AppendConflict logs an immutable conflict/violation note when logs/ is writable.
+func (s *Sandbox) AppendConflict(name string, b []byte) error {
+	return s.Append(name, b)
+}
+
+func (s *Sandbox) isDenied(rel string) bool {
+	if len(s.deny) == 0 {
+		return false
+	}
+	low := strings.ToLower(rel)
+	for _, d := range s.deny {
+		dl := strings.ToLower(d)
+		if low == dl || strings.HasPrefix(low, dl+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *Sandbox) relNameRead(name string) (string, error) {
+	if s.readAll {
+		return s.relNameAll(name)
+	}
+	allow := s.readAllow
+	if len(allow) == 0 {
+		allow = Readable
+	}
+	return s.relName(name, allow)
+}
+
+func (s *Sandbox) relNameWrite(name string) (string, error) {
+	allow := s.writeAllow
+	if len(allow) == 0 {
+		allow = Writable
+	}
+	return s.relName(name, allow)
+}
+
+func (s *Sandbox) relNameAll(name string) (string, error) {
+	rel, parts, err := s.normalizeRel(name)
+	if err != nil {
+		return "", err
+	}
+	if s.isDenied(rel) {
+		return "", fmt.Errorf("%w: %q is denied by sandbox policy", ErrOutside, name)
+	}
+	if err := s.noLinks(parts); err != nil {
+		return "", err
+	}
+	return rel, nil
+}
+
+// relName checks a path a tool gave: relative, inside the vault, under one
+// of allow, not in deny, and with no link in any of its components.
+func (s *Sandbox) relName(name string, allow []string) (string, error) {
+	rel, parts, err := s.normalizeRel(name)
+	if err != nil {
+		return "", err
+	}
+	if s.isDenied(rel) {
+		return "", fmt.Errorf("%w: %q is denied by sandbox policy", ErrOutside, name)
+	}
+	if !prefixAllowed(rel, allow) {
+		return "", fmt.Errorf("%w: %q isn't under %s", ErrOutside, name, strings.Join(allow, ", "))
+	}
+	if err := s.noLinks(parts); err != nil {
+		return "", err
+	}
+	return rel, nil
+}
+
+func prefixAllowed(rel string, allow []string) bool {
+	for _, a := range allow {
+		a = strings.Trim(strings.TrimPrefix(filepath.ToSlash(strings.TrimSpace(a)), "./"), "/")
+		if a == "" {
+			continue
+		}
+		if rel == a || strings.HasPrefix(rel, a+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *Sandbox) normalizeRel(name string) (string, []string, error) {
+	name = strings.TrimSpace(name)
+	if name == "" {
+		return "", nil, fmt.Errorf("%w: a path is needed", ErrOutside)
+	}
+	if strings.ContainsRune(name, 0) {
+		return "", nil, fmt.Errorf("%w: %q", ErrOutside, name)
+	}
+	// an absolute path, or one a Windows drive names, is something else's
+	if filepath.IsAbs(name) || filepath.VolumeName(name) != "" ||
+		strings.HasPrefix(name, "/") || strings.HasPrefix(name, `\`) {
+		return "", nil, fmt.Errorf("%w: %q is an absolute path", ErrOutside, name)
+	}
+	rel := path.Clean(filepath.ToSlash(name))
+	if rel == "." || rel == ".." || strings.HasPrefix(rel, "../") || strings.Contains(rel, "/../") {
+		return "", nil, fmt.Errorf("%w: %q", ErrOutside, name)
+	}
+	parts := strings.Split(rel, "/")
+	for _, p := range parts {
+		if p == "" || p == "." || p == ".." {
+			return "", nil, fmt.Errorf("%w: %q", ErrOutside, name)
+		}
+	}
+	return rel, parts, nil
+}
+
+// noLinks refuses a name with a link anywhere in it: the vault's folders
+// are the user's, and a link is how a note would reach outside them.
+func (s *Sandbox) noLinks(parts []string) error {
+	for i := range parts {
+		name := strings.Join(parts[:i+1], "/")
+		info, err := s.root.Lstat(name)
+		if errors.Is(err, fs.ErrNotExist) {
+			return nil // the rest of the name is new, and made here
+		}
+		if err != nil {
+			return err
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("%w: %q is a link", ErrOutside, name)
+		}
+	}
+	return nil
+}
diff --git a/internal/memagent/sandbox_test.go b/internal/memagent/sandbox_test.go
new file mode 100644
index 0000000..d95c01e
--- /dev/null
+++ b/internal/memagent/sandbox_test.go
@@ -0,0 +1,245 @@
+package memagent
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+// vault is a knowledge vault of the test's own, with the folders a run may
+// read and write, and one of each thing it must not reach.
+func vault(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	for _, d := range []string{"wiki", "inspirations", "memories", "_digests", "candidates", "dreams", "logs", "credentials", "tmp"} {
+		if err := os.MkdirAll(filepath.Join(dir, d), 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	putFile(t, filepath.Join(dir, "wiki", "release.md"), "# Release notes\n\nReleases go out on Tuesdays.\n")
+	putFile(t, filepath.Join(dir, "memories", "m.md"), "a memory\n")
+	putFile(t, filepath.Join(dir, "credentials", "token.txt"), "secret\n")
+	putFile(t, filepath.Join(dir, ".fish-import.json"), `{"schema":1,"imported":true,"files":[]}`)
+	return dir
+}
+
+func putFile(t *testing.T, p, s string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte(s), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func openVault(t *testing.T) (*Sandbox, string) {
+	t.Helper()
+	dir := vault(t)
+	sb, err := OpenSandbox(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { sb.Close() })
+	return sb, dir
+}
+
+// A note under a folder a run may read is read.
+func TestSandboxReadsAllowed(t *testing.T) {
+	sb, _ := openVault(t)
+	b, err := sb.Read("wiki/release.md")
+	if err != nil || string(b) != "# Release notes\n\nReleases go out on Tuesdays.\n" {
+		t.Fatalf("%q %v", b, err)
+	}
+	if _, err := sb.Read("memories/m.md"); err != nil {
+		t.Fatalf("a memory's note: %v", err)
+	}
+	// a name with a backslash is the same note, as Windows writes it
+	if _, err := sb.Read(`wiki\release.md`); err != nil {
+		t.Fatalf("a Windows path: %v", err)
+	}
+}
+
+// Nothing outside the allowlist is read, listed or written, whatever shape
+// the path takes: the point of the sandbox.
+func TestSandboxRefusesOutside(t *testing.T) {
+	sb, _ := openVault(t)
+	refused := []string{
+		"../outside.md",
+		"../../outside.md",
+		"wiki/../../outside.md",
+		"credentials/token.txt",
+		".fish-import.json",
+		"tmp/x.md",
+		".",
+		"..",
+		"/etc/passwd",
+		`C:\Windows\win.ini`,
+		`\\server\share\x.md`,
+		"wiki/../credentials/token.txt",
+	}
+	for _, name := range refused {
+		if b, err := sb.Read(name); err == nil {
+			t.Errorf("Read(%q) gave %q", name, b)
+		}
+		if _, err := sb.List(name); err == nil {
+			t.Errorf("List(%q) was allowed", name)
+		}
+		if err := sb.Write(name, []byte("x")); err == nil {
+			t.Errorf("Write(%q) was allowed", name)
+		}
+	}
+	// no path at all lists the folders a run may read, and nothing else
+	entries, err := sb.List("")
+	if err != nil || len(entries) != len(Readable) {
+		t.Fatalf("the folders: %+v %v", entries, err)
+	}
+}
+
+// A link, even one that points inside the vault, is never followed: a note
+// that is a link is how a run would reach outside the folders it may use.
+func TestSandboxRefusesLinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("a link needs a privilege on Windows")
+	}
+	sb, dir := openVault(t)
+	putFile(t, filepath.Join(dir, "credentials", "token.txt"), "secret\n")
+	if err := os.Symlink(filepath.Join(dir, "credentials"), filepath.Join(dir, "wiki", "out")); err != nil {
+		t.Skip("links can't be made here:", err)
+	}
+	if _, err := sb.Read("wiki/out/token.txt"); !errors.Is(err, ErrOutside) {
+		t.Fatalf("a link outside: %v", err)
+	}
+	if err := os.Symlink(filepath.Join(dir, "wiki", "release.md"), filepath.Join(dir, "wiki", "inside.md")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := sb.Read("wiki/inside.md"); !errors.Is(err, ErrOutside) {
+		t.Fatalf("a link inside the vault: %v", err)
+	}
+	entries, err := sb.List("wiki")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, e := range entries {
+		if e.Name == "inside.md" || e.Name == "out" {
+			t.Fatalf("a link was listed: %+v", e)
+		}
+	}
+}
+
+// A note is written under a folder a run may write, beside itself and
+// renamed over, so a run cut off halfway leaves the note it had.
+func TestSandboxWritesAllowed(t *testing.T) {
+	sb, dir := openVault(t)
+	for _, name := range []string{"dreams/2026-11-16.md", "logs/run.md", "_digests/d.md", "candidates/c.md", "inspirations/i.md"} {
+		if err := sb.Write(name, []byte("# "+name+"\n")); err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		b, err := os.ReadFile(filepath.Join(dir, filepath.FromSlash(name)))
+		if err != nil || string(b) != "# "+name+"\n" {
+			t.Fatalf("%s: %q %v", name, b, err)
+		}
+	}
+	// a name already there is replaced, not appended to
+	if err := sb.Write("logs/run.md", []byte("second\n")); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := os.ReadFile(filepath.Join(dir, "logs", "run.md")); string(b) != "second\n" {
+		t.Fatalf("replaced: %q", b)
+	}
+	// no temp file is left beside it
+	entries, err := os.ReadDir(filepath.Join(dir, "logs"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 1 || entries[0].Name() != "run.md" {
+		t.Fatalf("left behind: %v", entries)
+	}
+	// a note read isn't a note written: wiki is read only
+	if err := sb.Write("wiki/x.md", []byte("x")); !errors.Is(err, ErrOutside) {
+		t.Fatalf("a write into wiki: %v", err)
+	}
+	// a folder under a writable one is made as it is written
+	if err := sb.Write("dreams/2026/11/16.md", []byte("x")); err != nil {
+		t.Fatalf("a nested note: %v", err)
+	}
+}
+
+// A note over the size a run may write, and a run over what it may write
+// in all, are refused: one run can't fill the vault.
+func TestSandboxWriteBounds(t *testing.T) {
+	sb, _ := openVault(t)
+	big := make([]byte, MaxWriteFile+1)
+	if err := sb.Write("logs/big.md", big); err == nil {
+		t.Fatal("a note over MaxWriteFile was written")
+	}
+	chunk := make([]byte, MaxWriteFile)
+	for i := 0; sb.Written()+int64(len(chunk)) <= MaxWritten; i++ {
+		if err := sb.Write("logs/"+string(rune('a'+i))+".md", chunk); err != nil {
+			t.Fatalf("write %d: %v", i, err)
+		}
+	}
+	if err := sb.Write("logs/last.md", chunk); err == nil {
+		t.Fatalf("a run wrote %d bytes in all", sb.Written())
+	}
+}
+
+// A note over MaxReadFile is refused rather than read into the window.
+func TestSandboxReadBounds(t *testing.T) {
+	sb, dir := openVault(t)
+	putFile(t, filepath.Join(dir, "wiki", "big.md"), string(make([]byte, MaxReadFile+1)))
+	if _, err := sb.Read("wiki/big.md"); err == nil {
+		t.Fatal("a note over MaxReadFile was read")
+	}
+}
+
+// A listing gives the folders a run may read, and inside one only the
+// notes, folders first.
+func TestSandboxLists(t *testing.T) {
+	sb, dir := openVault(t)
+	putFile(t, filepath.Join(dir, "wiki", "sub", "a.md"), "a\n")
+	entries, err := sb.List("")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, e := range entries {
+		names = append(names, e.Name)
+	}
+	if len(names) != len(Readable) {
+		t.Fatalf("the folders: %v", names)
+	}
+	entries, err = sb.List("wiki")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 2 || !entries[0].Dir || entries[0].Name != "sub" || entries[1].Name != "release.md" || entries[1].Size == 0 {
+		t.Fatalf("wiki: %+v", entries)
+	}
+	if _, err := sb.List("wiki/release.md"); err == nil {
+		t.Fatal("a note was listed as a folder")
+	}
+}
+
+// A vault that isn't there, or is a link, is refused: the sandbox is
+// opened on a folder of the user's, never on what a link points at.
+func TestOpenSandboxRefuses(t *testing.T) {
+	if _, err := OpenSandbox(""); err == nil {
+		t.Fatal("an empty vault")
+	}
+	if _, err := OpenSandbox(filepath.Join(t.TempDir(), "nope")); err == nil {
+		t.Fatal("a vault that isn't there")
+	}
+	if runtime.GOOS != "windows" {
+		dir := vault(t)
+		link := filepath.Join(t.TempDir(), "link")
+		if err := os.Symlink(dir, link); err != nil {
+			t.Skip("links can't be made here:", err)
+		}
+		if _, err := OpenSandbox(link); err == nil {
+			t.Fatal("a vault that is a link")
+		}
+	}
+}
diff --git a/internal/memagent/sandbox_windows_test.go b/internal/memagent/sandbox_windows_test.go
new file mode 100644
index 0000000..018b596
--- /dev/null
+++ b/internal/memagent/sandbox_windows_test.go
@@ -0,0 +1,50 @@
+//go:build windows
+
+package memagent
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+// Windows has junctions as well as links, and a junction needs no privilege:
+// one inside the vault is the way a note would reach a folder a run may not
+// use. os.Root refuses one that leaves the vault, and the sandbox refuses
+// one that stays inside it, as it refuses a link.
+func TestSandboxRefusesJunctions(t *testing.T) {
+	sb, dir := openVault(t)
+	outside := t.TempDir()
+	if err := os.WriteFile(filepath.Join(outside, "secret.md"), []byte("SECRET\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// out of the vault, and inside it onto a folder a run may not read
+	if out, err := exec.Command("cmd", "/c", "mklink", "/J", filepath.Join(dir, "wiki", "escape"), outside).CombinedOutput(); err != nil {
+		t.Skipf("no junction here: %v %s", err, out)
+	}
+	if out, err := exec.Command("cmd", "/c", "mklink", "/J", filepath.Join(dir, "wiki", "creds"), filepath.Join(dir, "credentials")).CombinedOutput(); err != nil {
+		t.Skipf("no junction here: %v %s", err, out)
+	}
+	for _, name := range []string{"wiki/escape/secret.md", "wiki/creds/token.txt"} {
+		if b, err := sb.Read(name); err == nil {
+			t.Errorf("Read(%q) gave %q through a junction", name, b)
+		}
+	}
+	// neither is listed, and neither is a way to write
+	entries, err := sb.List("wiki")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, e := range entries {
+		if e.Name == "escape" || e.Name == "creds" {
+			t.Fatalf("a junction was listed: %+v", e)
+		}
+	}
+	if err := sb.Write("wiki/escape/new.md", []byte("x")); err == nil {
+		t.Error("a write through a junction out of the vault was allowed")
+	}
+	if err := sb.Write("wiki/creds/new.md", []byte("x")); err == nil {
+		t.Error("a write through a junction inside the vault was allowed")
+	}
+}
diff --git a/internal/memagent/scratch.go b/internal/memagent/scratch.go
new file mode 100644
index 0000000..36009a0
--- /dev/null
+++ b/internal/memagent/scratch.go
@@ -0,0 +1,310 @@
+package memagent
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+)
+
+// A run's own folder, where it writes what it needs between steps and what
+// is too big for a message: one folder per run under the cache, never the
+// vault, never magpie's own files. The whole folder is dropped when the
+// run ends, and anything a run that ended badly left behind is dropped once
+// the cache outgrows Cap.
+const (
+	// Cap is how much the scratch space may hold, all runs together.
+	Cap = 20 << 20
+	// MaxScratchFile is the largest file a run may put in its folder.
+	MaxScratchFile = 8 << 20
+)
+
+// ScratchRoot is where runs keep their folders; a variable for tests.
+var ScratchRoot = func() string {
+	return filepath.Join(appdir.Cache(), "memory-agent", "work")
+}
+
+// Scratch is one run's folder under ScratchRoot.
+type Scratch struct {
+	dir  string
+	id   string
+	once sync.Once
+}
+
+// NewScratch makes the folder for the run named id. The id is checked: it
+// names one folder under ScratchRoot and nothing else. A folder already
+// there is taken only when it is a folder and no link: one that is a link
+// would put every file the run writes somewhere else.
+func NewScratch(id string) (*Scratch, error) {
+	if !runID(id) {
+		return nil, fmt.Errorf("%q isn't a run id (letters, digits, '-' and '_', up to 64)", id)
+	}
+	root := ScratchRoot()
+	if err := os.MkdirAll(root, 0o700); err != nil {
+		return nil, err
+	}
+	// the root itself is checked too: a link there would carry every run's
+	// folder with it
+	if err := realDir(root); err != nil {
+		return nil, err
+	}
+	dir := filepath.Join(root, id)
+	if !within(root, dir) || filepath.Clean(dir) == filepath.Clean(root) {
+		return nil, fmt.Errorf("%w: %q", ErrOutside, id)
+	}
+	if err := os.Mkdir(dir, 0o700); err != nil && !errors.Is(err, fs.ErrExist) {
+		return nil, err
+	}
+	if err := realDir(dir); err != nil {
+		return nil, err
+	}
+	return &Scratch{dir: dir, id: id}, nil
+}
+
+// realDir refuses a path that isn't a folder of its own: a link or a
+// junction, which Windows reports as neither a folder nor a link, is what a
+// run's folder must never be.
+func realDir(p string) error {
+	info, err := os.Lstat(p)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() {
+		return fmt.Errorf("%w: %q isn't a folder", ErrOutside, p)
+	}
+	if info.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("%w: %q is a link", ErrOutside, p)
+	}
+	// a junction is a folder by its name alone, so the path it names is
+	// compared with the path the system resolves it to: one that differs
+	// is a link of some kind
+	if real, err := filepath.EvalSymlinks(p); err == nil && !samePath(real, p) {
+		return fmt.Errorf("%w: %q is a link", ErrOutside, p)
+	}
+	return nil
+}
+
+// samePath says whether two paths name the same place, as the system spells
+// them: Windows keeps no case.
+func samePath(a, b string) bool {
+	return strings.EqualFold(filepath.Clean(a), filepath.Clean(b))
+}
+
+// runID says whether s may name a run's folder.
+func runID(s string) bool {
+	if s == "" || len(s) > 64 {
+		return false
+	}
+	for _, r := range s {
+		if !(r == '-' || r == '_' || r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9') {
+			return false
+		}
+	}
+	return true
+}
+
+// Dir is the run's folder.
+func (s *Scratch) Dir() string { return s.dir }
+
+// Path is name inside the run's folder, which must stay in it.
+func (s *Scratch) Path(name string) (string, error) {
+	if s == nil {
+		return "", errors.New("this run has no scratch folder")
+	}
+	name = strings.TrimSpace(name)
+	if name == "" || strings.ContainsRune(name, 0) ||
+		filepath.IsAbs(name) || filepath.VolumeName(name) != "" ||
+		strings.HasPrefix(name, "/") || strings.HasPrefix(name, `\`) {
+		return "", fmt.Errorf("%w: %q", ErrOutside, name)
+	}
+	rel := filepath.Clean(filepath.FromSlash(name))
+	if rel == "." || rel == ".." ||
+		strings.HasPrefix(rel, ".."+string(filepath.Separator)) || strings.HasPrefix(rel, string(filepath.Separator)) {
+		return "", fmt.Errorf("%w: %q", ErrOutside, name)
+	}
+	p := filepath.Join(s.dir, rel)
+	if !within(s.dir, p) || filepath.Clean(p) == filepath.Clean(s.dir) {
+		return "", fmt.Errorf("%w: %q", ErrOutside, name)
+	}
+	return p, nil
+}
+
+// Write puts b at name in the run's folder, making the folders above it.
+func (s *Scratch) Write(name string, b []byte) error {
+	if len(b) > MaxScratchFile {
+		return fmt.Errorf("%q is %d bytes; a run writes at most %d to its folder", name, len(b), MaxScratchFile)
+	}
+	p, err := s.Path(name)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		return err
+	}
+	return os.WriteFile(p, b, 0o600)
+}
+
+// Read is name in the run's folder.
+func (s *Scratch) Read(name string) ([]byte, error) {
+	p, err := s.Path(name)
+	if err != nil {
+		return nil, err
+	}
+	info, err := os.Lstat(p)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || info.Size() > MaxScratchFile {
+		return nil, fmt.Errorf("%q isn't a file a run may read", name)
+	}
+	return os.ReadFile(p)
+}
+
+// Size is how much the run's folder holds.
+func (s *Scratch) Size() int64 {
+	n, _ := dirSize(s.dir)
+	return n
+}
+
+// Close drops the run's folder and everything in it. It is safe to call
+// twice: a run that ends and a GC that sweeps it both may.
+func (s *Scratch) Close() error {
+	if s == nil {
+		return nil
+	}
+	var err error
+	s.once.Do(func() {
+		root := ScratchRoot()
+		if !within(root, s.dir) || filepath.Clean(s.dir) == filepath.Clean(root) {
+			err = fmt.Errorf("%w: %q", ErrOutside, s.dir)
+			return
+		}
+		err = os.RemoveAll(s.dir)
+	})
+	return err
+}
+
+// GC drops the oldest runs' folders until the scratch space holds at most
+// Cap. It touches nothing but ScratchRoot: not the vault, not memories, not
+// any other folder of magpie's, and it only ever drops a whole run's
+// folder, one whose name is a run id and which is a folder of its own.
+//
+// keep names the run going, which is never dropped: a run's folder is
+// "<role>-<time>", and the run's own id (Scratch.Dir) is what protects it.
+// A name that isn't a run id is passed over, so a caller that names a role
+// by mistake protects nothing rather than everything.
+func GC(keep string) (dropped int, freed int64) {
+	root := filepath.Clean(ScratchRoot())
+	if !scratchRoot(root) {
+		return 0, 0
+	}
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		return 0, 0
+	}
+	type run struct {
+		dir  string
+		size int64
+		at   time.Time
+	}
+	runs := make([]run, 0, len(entries))
+	var total int64
+	for _, e := range entries {
+		if !e.IsDir() || !runID(e.Name()) || e.Name() == keep {
+			continue
+		}
+		dir := filepath.Join(root, e.Name())
+		if !within(root, dir) || filepath.Clean(dir) == root {
+			continue
+		}
+		// a link or a junction is never followed: RemoveAll on one deletes
+		// what it points at, which may be any folder on the machine
+		if err := realDir(dir); err != nil {
+			continue
+		}
+		size, at := dirSize(dir)
+		if info, err := e.Info(); err == nil && at.IsZero() {
+			at = info.ModTime()
+		}
+		runs = append(runs, run{dir: dir, size: size, at: at})
+		total += size
+	}
+	if total <= Cap {
+		return 0, 0
+	}
+	// the oldest first: a run that failed and left its folder goes before
+	// one made a minute ago
+	slices.SortStableFunc(runs, func(a, b run) int { return a.at.Compare(b.at) })
+	for _, r := range runs {
+		if total <= Cap {
+			break
+		}
+		// checked again right before the drop: what a sweep took a while to
+		// decide about may have been replaced by a link since
+		if err := realDir(r.dir); err != nil {
+			continue
+		}
+		if err := os.RemoveAll(r.dir); err != nil {
+			continue
+		}
+		dropped++
+		freed += r.size
+		total -= r.size
+	}
+	return dropped, freed
+}
+
+// scratchRoot says whether root is the scratch space: under magpie's cache,
+// in a memory-agent/work folder. A test points it elsewhere and keeps the
+// last two names, so what GC drops is still checked.
+func scratchRoot(root string) bool {
+	root = filepath.Clean(root)
+	if root == "" || root == "." || root == string(filepath.Separator) {
+		return false
+	}
+	return filepath.Base(root) == "work" && filepath.Base(filepath.Dir(root)) == "memory-agent"
+}
+
+// dirSize is what dir holds, and the newest change in it. A link inside is
+// weighed as itself, never followed: WalkDir reports one as no folder, so
+// what it points at isn't walked, and its own size is nothing. What it
+// points at isn't this folder's to weigh, so a sweep never makes room by
+// counting bytes that aren't here.
+func dirSize(dir string) (int64, time.Time) {
+	var n int64
+	var at time.Time
+	_ = fs.WalkDir(os.DirFS(dir), ".", func(name string, e fs.DirEntry, err error) error {
+		if err != nil {
+			return nil
+		}
+		info, err := e.Info()
+		if err != nil {
+			return nil
+		}
+		if !e.IsDir() {
+			n += info.Size()
+		}
+		if info.ModTime().After(at) {
+			at = info.ModTime()
+		}
+		return nil
+	})
+	return n, at
+}
+
+// within says whether p is dir or under it, after cleaning both.
+func within(dir, p string) bool {
+	dir, p = filepath.Clean(dir), filepath.Clean(p)
+	if dir == p {
+		return true
+	}
+	sep := string(filepath.Separator)
+	return strings.HasPrefix(p, dir+sep)
+}
diff --git a/internal/memagent/scratch_test.go b/internal/memagent/scratch_test.go
new file mode 100644
index 0000000..4ed172e
--- /dev/null
+++ b/internal/memagent/scratch_test.go
@@ -0,0 +1,196 @@
+package memagent
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// scratchAt points the run's folders at a folder of the test's own, and
+// holds the clock.
+func scratchAt(t *testing.T) string {
+	t.Helper()
+	root := filepath.Join(t.TempDir(), "cache", "memory-agent", "work")
+	old := ScratchRoot
+	ScratchRoot = func() string { return root }
+	t.Cleanup(func() { ScratchRoot = old })
+	if err := os.MkdirAll(root, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	return root
+}
+
+// A run's folder is made under the scratch space, and a name can't leave
+// it.
+func TestScratchWritesInsideItsFolder(t *testing.T) {
+	root := scratchAt(t)
+	sc, err := NewScratch("dream-2026-11-16T210000")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !within(root, sc.Dir()) || filepath.Dir(sc.Dir()) != filepath.Clean(root) {
+		t.Fatalf("the folder: %s", sc.Dir())
+	}
+	if err := sc.Write("notes/a.md", []byte("x")); err != nil {
+		t.Fatal(err)
+	}
+	b, err := sc.Read("notes/a.md")
+	if err != nil || string(b) != "x" {
+		t.Fatalf("%q %v", b, err)
+	}
+	for _, name := range []string{"../x.md", "../../x.md", "notes/../../x.md", "/etc/passwd", `C:\x.md`, "..", "."} {
+		if err := sc.Write(name, []byte("x")); !errors.Is(err, ErrOutside) {
+			t.Errorf("Write(%q): %v", name, err)
+		}
+		if _, err := sc.Read(name); !errors.Is(err, ErrOutside) {
+			t.Errorf("Read(%q): %v", name, err)
+		}
+	}
+	// an id that would name another folder, or none, is refused
+	for _, id := range []string{"", "..", "a/b", `a\b`, strings.Repeat("a", 65)} {
+		if _, err := NewScratch(id); err == nil {
+			t.Errorf("NewScratch(%q) was allowed", id)
+		}
+	}
+}
+
+// The run's folder goes when it ends, and its size is what it holds.
+func TestScratchClose(t *testing.T) {
+	scratchAt(t)
+	sc, err := NewScratch("learn-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := sc.Write("a.md", make([]byte, 1024)); err != nil {
+		t.Fatal(err)
+	}
+	if n := sc.Size(); n != 1024 {
+		t.Fatalf("size %d", n)
+	}
+	if err := sc.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(sc.Dir()); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("the folder is still there: %v", err)
+	}
+	if err := sc.Close(); err != nil {
+		t.Fatalf("closing twice: %v", err)
+	}
+}
+
+// A file over MaxScratchFile is refused: the run's own folder is bounded
+// too.
+func TestScratchFileBounds(t *testing.T) {
+	scratchAt(t)
+	sc, err := NewScratch("learn-2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := sc.Write("big.md", make([]byte, MaxScratchFile+1)); err == nil {
+		t.Fatal("a file over MaxScratchFile was written")
+	}
+}
+
+// GC drops the oldest runs' folders until the scratch space holds at most
+// Cap, and nothing else: not the vault, not a folder beside it.
+func TestGCDropsTheOldestToTheCap(t *testing.T) {
+	root := scratchAt(t)
+	// three runs of 8 MB each: over Cap by 4 MB, so the oldest goes
+	var dirs []string
+	for i, age := range []time.Duration{3 * time.Hour, 2 * time.Hour, time.Minute} {
+		id := string(rune('a' + i))
+		dir := filepath.Join(root, id)
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "f.bin"), make([]byte, 8<<20), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		at := time.Now().Add(-age)
+		if err := os.Chtimes(filepath.Join(dir, "f.bin"), at, at); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chtimes(dir, at, at); err != nil {
+			t.Fatal(err)
+		}
+		dirs = append(dirs, dir)
+	}
+	// something beside the scratch space, which GC must not touch
+	beside := filepath.Join(filepath.Dir(filepath.Dir(root)), "keep.txt")
+	if err := os.WriteFile(beside, []byte("keep\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	dropped, freed := GC("")
+	if dropped != 1 || freed != 8<<20 {
+		t.Fatalf("dropped %d, freed %d", dropped, freed)
+	}
+	if _, err := os.Lstat(dirs[0]); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("the oldest run's folder is still there")
+	}
+	for _, d := range dirs[1:] {
+		if _, err := os.Lstat(d); err != nil {
+			t.Fatalf("a newer run's folder went: %v", err)
+		}
+	}
+	if _, err := os.Lstat(beside); err != nil {
+		t.Fatalf("GC touched a folder beside the scratch space: %v", err)
+	}
+	// a run going is never dropped, even when the space is over the cap
+	if dropped, _ := GC("a"); dropped != 0 {
+		t.Fatalf("GC dropped %d with the run going named", dropped)
+	}
+}
+
+// A run that ended badly and left its folder is dropped once the space is
+// over the cap, oldest first; under the cap nothing is touched.
+func TestGCKeepsWhatFits(t *testing.T) {
+	root := scratchAt(t)
+	dir := filepath.Join(root, "learn-old")
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "a.md"), []byte("x"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	at := time.Now().Add(-2 * 24 * time.Hour)
+	if err := os.Chtimes(filepath.Join(dir, "a.md"), at, at); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(dir, at, at); err != nil {
+		t.Fatal(err)
+	}
+	if dropped, _ := GC(""); dropped != 0 {
+		t.Fatalf("GC dropped %d while the space was under the cap", dropped)
+	}
+	if _, err := os.Lstat(dir); err != nil {
+		t.Fatalf("a folder under the cap went: %v", err)
+	}
+}
+
+// GC only ever works in the scratch space: a folder that isn't
+// memory-agent/work is left alone, whatever it holds.
+func TestGCLeavesOtherFoldersAlone(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "x.md"), make([]byte, 1<<20), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	old := ScratchRoot
+	ScratchRoot = func() string { return dir }
+	t.Cleanup(func() { ScratchRoot = old })
+	if dropped, _ := GC(""); dropped != 0 {
+		t.Fatalf("GC dropped %d in a folder that isn't the scratch space", dropped)
+	}
+	if _, err := os.Lstat(filepath.Join(dir, "x.md")); err != nil {
+		t.Fatalf("GC touched a file of someone else's: %v", err)
+	}
+	// and a root that is the whole drive, or nothing, is refused too
+	for _, bad := range []string{"/", string(filepath.Separator), ""} {
+		ScratchRoot = func() string { return bad }
+		if dropped, _ := GC(""); dropped != 0 {
+			t.Fatalf("GC dropped %d under %q", dropped, bad)
+		}
+	}
+}
diff --git a/internal/memagent/state.go b/internal/memagent/state.go
new file mode 100644
index 0000000..94186e0
--- /dev/null
+++ b/internal/memagent/state.go
@@ -0,0 +1,357 @@
+package memagent
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/filelock"
+	"github.com/yetone/magpie/internal/lastgood"
+)
+
+// What a run did, for the window and the Obsidian plugin to show while it
+// goes and after it ended: the phase it is in, how far through the work it
+// is, the turns it took and the messages it and its tools wrote. The
+// transcript is this process's; the last run of each role is kept in
+// memory-agent-runs.json, so a window opened after a run ended still says
+// what happened, and one that failed says why.
+
+// The phases a run goes through.
+const (
+	PhaseStarting = "starting" // opening the vault and the agent's files
+	PhaseThinking = "thinking" // waiting for the model's answer
+	PhaseTool     = "tool"     // running a tool the model asked for
+	PhaseDone     = "done"     // ended, its products written
+	PhaseStopped  = "stopped"  // the user ended it
+	PhaseFailed   = "failed"   // an error ended it
+)
+
+// maxMessages is how many messages a run keeps for the window: a long run
+// shows its last ones, never everything it ever said.
+const maxMessages = 200
+
+// Message is one line of a run's transcript.
+type Message struct {
+	At   time.Time `json:"at"`
+	Role string    `json:"role"` // agent, tool, error or note
+	Tool string    `json:"tool,omitempty"`
+	Text string    `json:"text"`
+}
+
+// LastRun is what one run of a role did, as it is kept.
+type LastRun struct {
+	Role    string    `json:"role"`
+	Agent   string    `json:"agent,omitempty"`
+	Model   string    `json:"model,omitempty"`
+	Started time.Time `json:"started"`
+	Ended   time.Time `json:"ended,omitzero"`
+	Phase   string    `json:"phase"`
+	Steps   int       `json:"steps,omitempty"`
+	// Wrote and Saved are what it wrote into the vault and remembered.
+	Wrote int    `json:"wrote,omitempty"`
+	Saved int    `json:"saved,omitempty"`
+	Error string `json:"error,omitempty"`
+}
+
+// RunsPath is memory-agent-runs.json; a variable for tests.
+var RunsPath = func() string { return appdir.Join(appdir.Config(), "memory-agent-runs.json") }
+
+// runs is what each role's last run did, by role.
+type runs struct {
+	Version int                 `json:"version"`
+	Last    map[string]*LastRun `json:"last"`
+}
+
+const runsVersion = 1
+
+// progress is the run going in this process, and what it has said; after
+// it ends, what it said stays for the window until the next run of the
+// role.
+type progress struct {
+	mu    sync.Mutex
+	run   *LastRun
+	doing int
+	of    int
+	msgs  []Message
+	// scratch is the name of the run going's folder: the sweep of the cache
+	// never drops it
+	scratch string
+	// ended is the transcript of the last run that ended, by role
+	ended map[string][]Message
+}
+
+var live progress
+
+// Status is the run going, or the last one of that role, as the window
+// shows it: {running, phase, doing, of, messages, error}.
+type Status struct {
+	Running  bool      `json:"running"`
+	Role     string    `json:"role,omitempty"`
+	Agent    string    `json:"agent,omitempty"`
+	Model    string    `json:"model,omitempty"`
+	Phase    string    `json:"phase,omitempty"`
+	Doing    int       `json:"doing,omitempty"`
+	Of       int       `json:"of,omitempty"`
+	Steps    int       `json:"steps,omitempty"`
+	Wrote    int       `json:"wrote,omitempty"`
+	Saved    int       `json:"saved,omitempty"`
+	Started  time.Time `json:"started,omitzero"`
+	Ended    time.Time `json:"ended,omitzero"`
+	Messages []Message `json:"messages,omitempty"`
+	Error    string    `json:"error,omitempty"`
+}
+
+// StatusOf is the run going, when it is role's, else the last one role
+// ran: the window polls one role at a time.
+func StatusOf(role string) Status {
+	live.mu.Lock()
+	run, msgs := live.run, slices.Clone(live.msgs)
+	doing, of := live.doing, live.of
+	var ended []Message
+	if run == nil && role != "" {
+		ended = slices.Clone(live.ended[role])
+	}
+	live.mu.Unlock()
+	if run != nil && (role == "" || run.Role == role) {
+		return Status{
+			Running: true, Role: run.Role, Agent: run.Agent, Model: run.Model,
+			Phase: run.Phase, Doing: doing, Of: of, Steps: run.Steps,
+			Wrote: run.Wrote, Saved: run.Saved, Started: run.Started,
+			Messages: msgs, Error: run.Error,
+		}
+	}
+	last, err := loadRuns()
+	if err != nil {
+		return Status{}
+	}
+	lr := last.Last[role]
+	if lr == nil && role == "" {
+		// no role asked: the run that ended last, whatever its role
+		for _, r := range last.Last {
+			if lr == nil || r.Ended.After(lr.Ended) {
+				lr = r
+			}
+		}
+	}
+	if lr == nil {
+		return Status{}
+	}
+	return Status{
+		Role: lr.Role, Agent: lr.Agent, Model: lr.Model, Phase: lr.Phase,
+		Steps: lr.Steps, Wrote: lr.Wrote, Saved: lr.Saved,
+		Started: lr.Started, Ended: lr.Ended, Messages: ended, Error: lr.Error,
+	}
+}
+
+// Running says a run is going in this process.
+func Running() bool {
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	return live.run != nil
+}
+
+// RunningRole is the role of the run going, "" when none is.
+func RunningRole() string {
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	if live.run == nil {
+		return ""
+	}
+	return live.run.Role
+}
+
+// RunningScratch is the name of the run going's scratch folder, "" when
+// none is: what a sweep of the cache must never drop. It is the folder's
+// own name ("<role>-<time>"), not the role, which names no folder.
+func RunningScratch() string {
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	return live.scratch
+}
+
+// setScratch records the folder of the run going, and a call with "" lets
+// it go.
+func setScratch(id string) {
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	live.scratch = id
+}
+
+// begin marks a run of role as going, and gives what ends it.
+func begin(role, agent, model string) *runLog {
+	live.mu.Lock()
+	live.run = &LastRun{Role: role, Agent: agent, Model: model, Started: now().UTC(), Phase: PhaseStarting}
+	live.doing, live.of, live.msgs = 0, 0, nil
+	live.mu.Unlock()
+	return &runLog{}
+}
+
+// end records how the run ended and keeps it for the role. What it said
+// stays for the window until the next run of the role.
+func end(phase string, err error) {
+	live.mu.Lock()
+	run := live.run
+	live.run = nil
+	live.scratch = ""
+	live.doing, live.of = 0, 0
+	if run != nil {
+		run.Phase, run.Ended = phase, now().UTC()
+		if err != nil {
+			run.Error = err.Error()
+		}
+		if live.ended == nil {
+			live.ended = map[string][]Message{}
+		}
+		live.ended[run.Role] = slices.Clone(live.msgs)
+	}
+	live.mu.Unlock()
+	if run == nil {
+		return
+	}
+	keepRun(*run)
+}
+
+// keepRun writes the run into memory-agent-runs.json, under its lock, so
+// the window still shows it after a restart.
+func keepRun(r LastRun) {
+	unlock, held := filelock.Lock(RunsPath()+".lock", 5*time.Second)
+	if !held {
+		return
+	}
+	defer unlock()
+	all, err := loadRuns()
+	if err != nil {
+		return
+	}
+	if all.Last == nil {
+		all.Last = map[string]*LastRun{}
+	}
+	all.Last[r.Role] = &r
+	if err := saveRuns(all); err != nil {
+		return
+	}
+}
+
+func loadRuns() (runs, error) {
+	var r runs
+	b, err := lastgood.Read(RunsPath(), lastgood.Into[runs])
+	if errors.Is(err, os.ErrNotExist) {
+		return runs{Version: runsVersion, Last: map[string]*LastRun{}}, nil
+	}
+	if err != nil {
+		return r, err
+	}
+	if err := json.Unmarshal(b, &r); err != nil {
+		return r, err
+	}
+	if r.Version == 0 {
+		r.Version = runsVersion
+	}
+	if r.Last == nil {
+		r.Last = map[string]*LastRun{}
+	}
+	return r, nil
+}
+
+func saveRuns(r runs) error {
+	b, err := json.MarshalIndent(r, "", "  ")
+	if err != nil {
+		return err
+	}
+	p := RunsPath()
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		return err
+	}
+	tmp := p + ".tmp"
+	if err := os.WriteFile(tmp, b, 0o600); err != nil {
+		return err
+	}
+	if err := os.Rename(tmp, p); err != nil {
+		return err
+	}
+	return lastgood.Keep(p, lastgood.Into[runs], 0o600)
+}
+
+// runLog is a run's progress: what it is doing and what it said. The
+// methods are safe to call from the loop and the tools it runs.
+type runLog struct{}
+
+// phase says what the run is doing now.
+func (l *runLog) phase(phase string) {
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	if live.run != nil {
+		live.run.Phase = phase
+	}
+}
+
+// progress sets how far through the run's work it is.
+func (l *runLog) progress(doing, of int) {
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	live.doing, live.of = doing, of
+}
+
+// step counts one turn of the loop.
+func (l *runLog) step() int {
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	if live.run == nil {
+		return 0
+	}
+	live.run.Steps++
+	return live.run.Steps
+}
+
+// said adds one line to the transcript, keeping the last maxMessages.
+func (l *runLog) said(role, tool, text string) {
+	text = strings.TrimSpace(text)
+	if text == "" {
+		return
+	}
+	if r := []rune(text); len(r) > 2000 {
+		text = string(r[:2000]) + "…"
+	}
+	m := Message{At: now().UTC(), Role: role, Tool: tool, Text: text}
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	live.msgs = append(live.msgs, m)
+	if len(live.msgs) > maxMessages {
+		live.msgs = live.msgs[len(live.msgs)-maxMessages:]
+	}
+}
+
+// counted adds what the run wrote and remembered, for the last-run record.
+func (l *runLog) wrote(n int) {
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	if live.run != nil {
+		live.run.Wrote += n
+	}
+}
+
+func (l *runLog) saved(n int) {
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	if live.run != nil {
+		live.run.Saved += n
+	}
+}
+
+// failed records why the run ended, for the window.
+func (l *runLog) failed(err error) {
+	if err == nil {
+		return
+	}
+	live.mu.Lock()
+	defer live.mu.Unlock()
+	if live.run != nil {
+		live.run.Error = err.Error()
+	}
+}
