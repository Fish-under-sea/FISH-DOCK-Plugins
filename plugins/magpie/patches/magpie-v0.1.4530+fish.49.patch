+// TDD UX 契约测试：覆盖记忆页图一(Agent 唯一收敛)、图二(menuButton 二次点击收起)、
+// 图三(去掉知识库搜索框+12px 间距)、图五(常驻 Obsidian 记忆 Agent 状态行+全汉化+立即整理按钮+启用开关)。
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const { test } = require("node:test");
+const vm = require("node:vm");
+const { strings } = require("./strings.cjs");
+
+const assets = path.resolve(__dirname, "../assets");
+
+function makeDom() {
+  class ClassList {
+    constructor(el) { this.el = el; this.set = new Set(); }
+    add(...names) { for (const n of names) if (n) for (const p of String(n).split(/\s+/)) if (p) this.set.add(p); }
+    remove(...names) { for (const n of names) if (n) this.set.delete(n); }
+    toggle(n, force) {
+      const on = force === undefined ? !this.set.has(n) : !!force;
+      if (on) this.set.add(n); else this.set.delete(n);
+      return on;
+    }
+    contains(n) { return this.set.has(n); }
+  }
+  const makeEl = (tag) => {
+    const el = {
+      tagName: tag.toUpperCase(),
+      nodeType: 1,
+      children: [],
+      parentNode: null,
+      style: {},
+      dataset: {},
+      attrs: {},
+      listeners: new Map(),
+      hidden: false,
+      disabled: false,
+      value: "",
+      _text: "",
+      scrollTop: 0,
+      offsetHeight: 160,
+      offsetWidth: 220,
+      set className(v) { this.classList = new ClassList(this); this.classList.add(v); },
+      get className() { return [...this.classList.set].join(" "); },
+      get firstChild() { return this.children[0] || null; },
+      get lastChild() { return this.children[this.children.length - 1] || null; },
+      set textContent(v) { this._text = v == null ? "" : String(v); this.children = []; },
+      get textContent() { return this._text + this.children.map((c) => c.textContent).join(""); },
+      setAttribute(k, v) { this.attrs[k] = String(v); if (k === "disabled") this.disabled = true; },
+      getAttribute(k) { return k in this.attrs ? this.attrs[k] : null; },
+      hasAttribute(k) { return k in this.attrs; },
+      removeAttribute(k) { delete this.attrs[k]; },
+      addEventListener(type, fn) {
+        if (!this.listeners.has(type)) this.listeners.set(type, []);
+        this.listeners.get(type).push(fn);
+      },
+      removeEventListener(type, fn) {
+        const list = this.listeners.get(type);
+        if (list) this.listeners.set(type, list.filter((x) => x !== fn));
+      },
+      append(...nodes) {
+        for (const n of nodes) {
+          if (n == null || n === false) continue;
+          const node = typeof n === "string" || typeof n === "number" ? { nodeType: 3, textContent: String(n), children: [], parentNode: this } : n;
+          node.parentNode = this;
+          this.children.push(node);
+        }
+      },
+      prepend(...nodes) {
+        for (const n of nodes.reverse()) {
+          if (!n) continue;
+          n.parentNode = this;
+          this.children.unshift(n);
+        }
+      },
+      replaceChildren(...nodes) { this.children = []; this._text = ""; this.append(...nodes); },
+      replaceWith(next) {
+        if (!this.parentNode) return;
+        const idx = this.parentNode.children.indexOf(this);
+        if (idx >= 0) { next.parentNode = this.parentNode; this.parentNode.children[idx] = next; }
+      },
+      remove() {
+        if (!this.parentNode) return;
+        this.parentNode.children = this.parentNode.children.filter((c) => c !== this);
+        this.parentNode = null;
+      },
+      contains(target) {
+        let cur = target;
+        while (cur) { if (cur === this) return true; cur = cur.parentNode; }
+        return false;
+      },
+      matches(sel) {
+        return sel.split(",").map((s) => s.trim()).some((part) => {
+          const classes = [...part.matchAll(/\.([A-Za-z0-9_-]+)/g)].map((m) => m[1]);
+          const attrMatches = [...part.matchAll(/\[([^=\]]+)=([^\]]+)\]/g)];
+          const tagMatch = /^([A-Za-z]+)/.exec(part)?.[1];
+          if (tagMatch && this.tagName !== tagMatch.toUpperCase()) return false;
+          for (const c of classes) if (!this.classList.contains(c)) return false;
+          for (const [, k, raw] of attrMatches) if (this.getAttribute(k) !== raw.replace(/^["']|["']$/g, "")) return false;
+          return classes.length > 0 || attrMatches.length > 0 || !!tagMatch;
+        });
+      },
+      querySelector(sel) { return this.querySelectorAll(sel)[0] || null; },
+      querySelectorAll(sel) {
+        const out = [];
+        const parts = sel.split(",").map((s) => s.trim());
+        const matchPart = (node, part) => {
+          const child = part.split(/\s*>\s*/);
+          if (child.length > 1) {
+            let cur = node;
+            for (let i = child.length - 1; i >= 0; i--) {
+              if (!cur || cur.nodeType !== 1 || !cur.matches(child[i])) return false;
+              cur = cur.parentNode;
+            }
+            return true;
+          }
+          const desc = part.split(/\s+/).filter(Boolean);
+          if (desc.length === 1) return node.matches(desc[0]);
+          if (!node.matches(desc[desc.length - 1])) return false;
+          let cur = node.parentNode;
+          for (let i = desc.length - 2; i >= 0; i--) {
+            while (cur && cur.nodeType === 1 && !cur.matches(desc[i])) cur = cur.parentNode;
+            if (!cur || cur.nodeType !== 1) return false;
+            cur = cur.parentNode;
+          }
+          return true;
+        };
+        const walk = (node) => {
+          for (const c of node.children || []) {
+            if (c.nodeType === 1) {
+              if (parts.some((p) => matchPart(c, p))) out.push(c);
+              walk(c);
+            }
+          }
+        };
+        walk(this);
+        return out;
+      },
+      closest(sel) {
+        let cur = this;
+        while (cur && cur.nodeType === 1) { if (cur.matches(sel)) return cur; cur = cur.parentNode; }
+        return null;
+      },
+      focus() {},
+      scrollIntoView() {},
+      scrollTo() {},
+      getBoundingClientRect() { return { left: 20, right: 240, top: 40, bottom: 72, width: 220, height: 32 }; },
+      click() {
+        const ev = { type: "click", target: this, stopPropagation() {}, preventDefault() {}, stopImmediatePropagation() {} };
+        if (this.onclick) this.onclick(ev);
+      },
+    };
+    el.className = "";
+    return el;
+  };
+  const body = makeEl("body");
+  const docListeners = new Map();
+  const document = {
+    body,
+    hidden: false,
+    activeElement: null,
+    createElement: (tag) => makeEl(tag),
+    createElementNS: (_ns, tag) => makeEl(tag),
+    addEventListener(type, fn) {
+      if (!docListeners.has(type)) docListeners.set(type, []);
+      docListeners.get(type).push(fn);
+    },
+    removeEventListener(type, fn) {
+      const list = docListeners.get(type);
+      if (list) docListeners.set(type, list.filter((x) => x !== fn));
+    },
+    querySelector: (sel) => body.querySelector(sel),
+    querySelectorAll: (sel) => body.querySelectorAll(sel),
+  };
+  return { document, body, makeEl };
+}
+
+async function mountMemoryTab({ agents, statusView, distillState, onApi } = {}) {
+  const { zh } = strings().I18N;
+  const { document, body, makeEl } = makeDom();
+  const modal = makeEl("div"); modal.id = "modal"; body.append(modal);
+  const page = makeEl("main"); page.id = "view-library"; body.append(page);
+
+  const t = (k, vars) => {
+    let s = zh[k] || k;
+    if (vars) for (const [vk, vv] of Object.entries(vars)) s = s.replaceAll("{" + vk + "}", String(vv));
+    return s;
+  };
+  const el = (tag, cls, text) => {
+    const d = document.createElement(tag);
+    if (cls) d.className = cls;
+    if (text != null) d.textContent = text;
+    return d;
+  };
+  const svg = () => el("svg");
+  const button = (text, cls, fn) => { const b = el("button", cls, text); b.type = "button"; b.onclick = fn; return b; };
+  const toggle = (on, label, fn) => {
+    const b = el("button", "lib-switch" + (on ? " on" : ""));
+    b.type = "button";
+    b.setAttribute("role", "switch");
+    b.setAttribute("aria-checked", on ? "true" : "false");
+    b.setAttribute("aria-label", label);
+    b.onclick = (e) => { e.stopPropagation(); fn(!on); };
+    return b;
+  };
+  const segs = (items, cur, fn) => {
+    const g = el("div", "segs");
+    for (const [v, label] of items) {
+      const b = button(label, "opt" + (v === cur ? " on" : ""), () => fn(v));
+      g.append(b);
+    }
+    return g;
+  };
+  const input = (val, ph) => { const i = el("input"); i.value = val || ""; if (ph) i.placeholder = ph; return i; };
+  const glyphs = new Proxy({}, { get: (_t, k) => String(k) });
+
+  const appSrc = fs.readFileSync(path.join(assets, "app.js"), "utf8").replace(/\r\n/g, "\n");
+  const menuStart = appSrc.indexOf("function holdMenu(");
+  const openMenuAt = appSrc.indexOf("function openProtoMenu(", menuStart);
+  const menuEnd = appSrc.indexOf("\n}\n", openMenuAt);
+  assert.ok(menuStart >= 0 && openMenuAt > menuStart && menuEnd > openMenuAt, "extract holdMenu/openProtoMenu block");
+  const menuSrc = appSrc.slice(menuStart, menuEnd + 2);
+
+  const calls = [];
+  let currentAgents = agents;
+  let currentStatus = statusView;
+  const store = new Map([["magpie.libTab", "memory"]]);
+  const api = async (p, bodyData) => {
+    calls.push({ path: p, body: bodyData });
+    if (onApi) {
+      const handled = await onApi(p, bodyData, { setAgents: (x) => { currentAgents = x; }, setStatus: (x) => { currentStatus = x; } });
+      if (handled !== undefined) return handled;
+    }
+    if (p === "library" || p === "library?glance=1") return { dir: "/lib", backups: "/bak", home: "/home", agents: [{ id: "claude", name: "Claude Code", instructions: "/home/.claude/CLAUDE.md" }], instructions: { shared: "", sets: [], agents: [] }, servers: [{ name: "magpie-memory" }], skills: [], hooks: [], env: [], subagents: [], commands: [], plugins: [], projects: [], foundServers: [], foundSkills: [] };
+    if (p === "memory") return { vault: { root: "D:/vault", url: "obsidian://open?vault=vault" }, memories: [], projects: {}, digest: true, agents: [] };
+    if (p === "memory/distill") return distillState;
+    if (p === "memory/semantic") return { on: false, size: 1e6, done: 0, read: 0, of: 0 };
+    if (p === "memory/agents") return currentAgents;
+    if (p.startsWith("memory/agents/status")) return currentStatus;
+    if (p === "memory/agents/obsidian/enabled") {
+      currentAgents = { ...currentAgents, obsidian: { ...currentAgents.obsidian, enabled: !!bodyData.enabled } };
+      return currentAgents;
+    }
+    if (p.endsWith("/run")) {
+      currentStatus = { running: true, role: "organize", agent: "obsidian-memory", phase: "starting", doing: 1, of: 10, messages: [] };
+      return currentStatus;
+    }
+    if (p.endsWith("/stop")) {
+      currentStatus = { running: false, role: "organize", phase: "stopped" };
+      return currentStatus;
+    }
+    return {};
+  };
+
+  let slot = null;
+  const ctx = vm.createContext({
+    document,
+    window: null,
+    navigator: { platform: "Win32" },
+    console,
+    setTimeout: () => 1,
+    clearTimeout: () => {},
+    requestAnimationFrame: () => 1,
+    cancelAnimationFrame: () => {},
+    performance: { now: () => 0 },
+    innerWidth: 1200,
+    innerHeight: 800,
+    localStorage: { getItem: (k) => store.get(k) || null, setItem: (k, v) => store.set(k, String(v)) },
+    addEventListener: () => {},
+    removeEventListener: () => {},
+    $: (sel) => (sel === "#modal" ? modal : document.querySelector(sel)),
+    el, svg, t, api, button, toggle, segs, input,
+    intro: (txt) => el("p", "lib-intro", txt),
+    skeleton: () => { const d = el("div"); d.append(el("div", "lib-skel"), el("div", "lib-skel")); return d; },
+    glyph: (name, cls) => el("span", cls || "", String(name)),
+    GLYPH: glyphs,
+    CHECK: "M0 0", CHEV: "M0 0", CHEV_R: "M0 0", NO_SCROLL: { preventScroll: true },
+    confirmationPending: false,
+    protoMenu: null,
+    purposeUntil: 0,
+    guardUntil: 0,
+    hoverFocus: () => {},
+    popTop: () => 8,
+    modalBackdrop: () => false,
+    closeModal: async () => {},
+    status: (msg, cls) => { if (cls === "err") console.error("TEST STATUS ERR:", msg); },
+    reveal: () => {},
+    agentless: () => false,
+    hasPi: () => false,
+    calm: () => true,
+    tilde: (x) => x,
+    ago: () => "刚刚",
+    state: { agents: [] },
+    nameOf: (x) => x,
+    memScopes: () => ["global"],
+    effortIcon: () => el("span"),
+    syncLists: () => {},
+    wireLists: () => {},
+    magpie: {
+      plugin(_id, init) {
+        init({ slots: { add(_type, def) { slot = def; } } });
+      },
+    },
+  });
