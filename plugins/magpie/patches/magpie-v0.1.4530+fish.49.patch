+// The scheduler asks for a role only when the Memory tab says so: reading
+// when the switch is on, the tidy when it is due.
+func TestKeepDue(t *testing.T) {
+	distillAt(t)
+	if keepDue(memagent.Learn, timeNow()) {
+		t.Fatal("reading is due while switched off")
+	}
+	if _, err := memdistill.Set(true, ""); err != nil {
+		t.Fatal(err)
+	}
+	if !keepDue(memagent.Learn, timeNow()) {
+		t.Fatal("reading isn't due while switched on")
+	}
+	if _, err := memdistill.Set(false, ""); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := memdistill.SetDreamAgent("dreamer"); err != nil {
+		t.Fatal(err)
+	}
+	if st, _ := memdistill.Load(); st.DreamAgent != "dreamer" {
+		t.Fatalf("dreamAgent: %q", st.DreamAgent)
+	}
+	if keepDue(memagent.Organize, timeNow()) {
+		t.Fatal("organize is asked for by a switch it has none")
+	}
+}
+
+// A run that can't start is kept for the row that shows the role: learn's
+// in the reading row's error, the tidy's in its own.
+func TestNoteRunError(t *testing.T) {
+	distillAt(t)
+	noteRunError(memagent.Learn, "the gateway isn't served by this magpie")
+	st, err := memdistill.Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(st.Error, "gateway") {
+		t.Fatalf("learn error: %q", st.Error)
+	}
+	noteRunError(memagent.Dream, "no knowledge vault")
+	st, _ = memdistill.Load()
+	if !strings.Contains(st.DreamError, "vault") {
+		t.Fatalf("dream error: %q", st.DreamError)
+	}
+	// a run that starts clears the one before it
+	noteRunError(memagent.Learn, "")
+	st, _ = memdistill.Load()
+	if st.Error != "" {
+		t.Fatalf("learn error left: %q", st.Error)
+	}
+}
+
+// The gateway an agent's turns go through is the one this process serves;
+// with none, a run is told so rather than failing obscurely.
+func TestGatewayAskWithoutAGateway(t *testing.T) {
+	prev := served.Swap(nil)
+	t.Cleanup(func() { served.Store(prev) })
+	ask := gatewayAsk()
+	if _, err := ask(nil, memagent.Request{}); err == nil || !strings.Contains(err.Error(), "isn't served") {
+		t.Fatalf("no gateway: %v", err)
+	}
+}
+
+func TestKeepDueRespectsObsidianEnabledToggle(t *testing.T) {
+	distillAt(t)
+	cfgDir := t.TempDir()
+	t.Setenv("APPDATA", cfgDir)
+	t.Setenv("XDG_CONFIG_HOME", cfgDir)
+	t.Setenv("HOME", cfgDir)
+	vault := t.TempDir()
+	oldRoots := memagent.VaultRoots
+	memagent.VaultRoots = func() []string { return []string{vault} }
+	t.Cleanup(func() { memagent.VaultRoots = oldRoots })
+
+	wsDir, err := memagent.EnsureObsidianWorkspace(vault)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := memagent.SyncObsidianDefault(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := memdistill.Set(true, ""); err != nil {
+		t.Fatal(err)
+	}
+	if !keepDue(memagent.Learn, timeNow()) {
+		t.Fatal("expected keepDue true when obsidian agent enabled")
+	}
+	cfg, _ := memagent.ReadObsidianConfig(wsDir)
+	cfg.Enabled = false
+	if err := memagent.WriteObsidianConfig(wsDir, cfg); err != nil {
+		t.Fatal(err)
+	}
+	if keepDue(memagent.Learn, timeNow()) {
+		t.Fatal("expected keepDue false when obsidian agent disabled")
+	}
+}
