+package plugin
+
+import (
+	"testing"
+)
+
+// #36 需求四：早年 NearToken 页面写进 options 的三个键只从那个包里清掉，
+// 别的插件的同名选项一个字都不动；清干净之后再调一次什么也不写。
+func TestDropLegacyOptionsTouchesOnlyNearToken(t *testing.T) {
+	storeSandbox(t)
+	writeList(t, `{"plugins":[
+	 {"spec":"@fish-under-sea/magpie-neartoken@1.1.1","options":{"disabledModels":["gpt-6-astra"],"enabledByGroup":{"x":["g"]},"disabledByGroup":{"gpt-6-sol":["低价"]},"collapsed":true}},
+	 {"spec":"@fish-under-sea/other@1.0.0","options":{"disabledModels":["keep-me"]}}
+	]}`)
+
+	dropped, err := DropLegacyOptions()
+	if err != nil {
+		t.Fatalf("DropLegacyOptions: %v", err)
+	}
+	if len(dropped) != 3 {
+		t.Fatalf("dropped %v, want the three keys older pages wrote", dropped)
+	}
+
+	l := Load()
+	if len(l.Plugins) != 2 {
+		t.Fatalf("plugins = %+v, want two", l.Plugins)
+	}
+	nte := l.Plugins[0].Options
+	for _, key := range legacyNTEKeys {
+		if _, ok := nte[key]; ok {
+			t.Fatalf("%s is still there: %v", key, nte)
+		}
+	}
+	if nte["collapsed"] != true {
+		t.Fatalf("a key that isn't older pages' went with them: %v", nte)
+	}
+	if got := l.Plugins[1].Options["disabledModels"]; got == nil {
+		t.Fatalf("another plugin's option was dropped: %v", l.Plugins[1].Options)
+	}
+
+	again, err := DropLegacyOptions()
+	if err != nil {
+		t.Fatalf("second DropLegacyOptions: %v", err)
+	}
+	if len(again) != 0 {
+		t.Fatalf("a second run dropped %v, want nothing", again)
+	}
+}
