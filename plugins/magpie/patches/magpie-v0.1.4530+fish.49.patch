+++ b/internal/gui/tests/embedded-open-api.test.cjs
@@ -0,0 +1,113 @@
+// 执行 app.js 的真实 api()，检查发送路径；不冒充真实 Dock 浏览器验收。
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const {test} = require('node:test');
+
+const source = fs.readFileSync(path.join(__dirname, '../assets/app.js'), 'utf8');
+const match = source.match(/async function api\(path, body, heads, signal\) \{[\s\S]*?\n\}/);
+assert.ok(match, 'actual api() must be present');
+const signIn = source.match(/function openSignInPage\(url\) \{[\s\S]*?\n\}/);
+const blocked = source.match(/^const openBlocked = .+;/m);
+assert.ok(signIn && blocked, 'actual sign-in opener must be present');
+
+function runtime({embedded, hostname, web = true, fail = false}) {
+  const requests = [], popups = [];
+  const window = {location: {hostname}, open: (...args) => {popups.push(args); return null;}};
+  window.parent = embedded ? {} : window;
+  const context = vm.createContext({
+    window, location: window.location, web, Response,
+    sameReads: new Map(), readsSame: () => false, readTags: new WeakMap(),
+    t: (s) => s,
+    fetch: async (url, options) => {
+      requests.push({url, ...options, parsed: options.body ? JSON.parse(options.body) : undefined});
+      return fail ? new Response(JSON.stringify({error: 'fixture opener failed'}), {status: 500}) : new Response(null, {status: 204});
+    },
+  });
+  vm.runInContext([match[0], blocked[0], signIn[0], 'globalThis.actualAPI = api; globalThis.actualSignIn = openSignInPage;'].join('\n'), context);
+  return {api: context.actualAPI, signIn: context.actualSignIn, requests, popups, run(code, values = {}) {
+    Object.assign(context, values);
+    return vm.runInContext(code, context);
+  }};
+}
+
+for (const hostname of ['127.0.0.1', 'localhost', '[::1]']) {
+  test('local embedded web opens through the system endpoint: ' + hostname, async () => {
+    const r = runtime({embedded: true, hostname});
+    const url = 'https://example.test/device?user_code=TEST-ONLY&aff=a%2Bb#approve';
+    await r.api('open', {url});
+    assert.equal(r.popups.length, 0, 'do not rely on a sandboxed popup');
+    assert.equal(r.requests.length, 1, 'exactly one open request');
+    assert.equal(r.requests[0].url, '/api/open');
+    assert.deepEqual(r.requests[0].parsed, {url, system: true});
+  });
+}
+
+test('standalone web and remote embedded web keep client-side opening', async () => {
+  for (const options of [{embedded: false, hostname: '127.0.0.1'}, {embedded: true, hostname: 'remote.example.test'}]) {
+    const r = runtime(options);
+    await r.api('open', {url: 'https://example.test/help'});
+    assert.equal(r.requests.length, 0);
+    assert.equal(r.popups.length, 1);
+  }
+});
+
+test('native window retains the existing native API contract', async () => {
+  const r = runtime({embedded: false, hostname: 'wails.localhost', web: false});
+  await r.api('open', {url: 'https://example.test/help'});
+  assert.equal(r.popups.length, 0);
+  assert.equal(r.requests.length, 1);
+  assert.deepEqual(r.requests[0].parsed, {url: 'https://example.test/help'});
+});
+
+test('embedded device sign-in uses the same system opening path', async () => {
+  const r = runtime({embedded: true, hostname: '127.0.0.1'});
+  const url = 'https://example.test/device?user_code=TEST-ONLY&aff=abc';
+  await r.signIn(url);
+  assert.equal(r.popups.length, 0);
+  assert.equal(r.requests.length, 1);
+  assert.deepEqual(r.requests[0].parsed, {url, system: true});
+});
+
+test('standalone sign-in keeps reporting a blocked browser popup', async () => {
+  const r = runtime({embedded: false, hostname: '127.0.0.1'});
+  await assert.rejects(r.signIn('https://example.test/device'), /blocked/);
+  assert.equal(r.requests.length, 0);
+  assert.equal(r.popups.length, 1);
+});
+
+// 执行三个真实点击回调，不把静态 window.open 次数当成点击验收。
+const badgeOpen = source.match(/b\.onclick = \(\) => \{\s*\/\/ what changed is shown first[\s\S]*?\n  \};/);
+const releaseOpen = source.match(/^\s+const open = \(\) => .*u\.url.*;$/m);
+const downloadOpen = source.match(/^\s+btn\(t\("Download"\), \(\) => .*;$/m);
+assert.ok(badgeOpen && releaseOpen && downloadOpen, 'actual update/download callbacks must exist');
+const linkCallbacks = [
+  ['update badge', badgeOpen[0] + '\nb.onclick()'],
+  ['release page', releaseOpen[0] + '\nopen()'],
+  ['download button', downloadOpen[0]],
+];
+for (const [name, code] of linkCallbacks) {
+  test('magpie ' + name + ' uses the controlled opener when embedded locally', async () => {
+    const r = runtime({embedded: true, hostname: '127.0.0.1'});
+    const url = 'https://example.test/release?from=magpie&version=2.2.1#download';
+    await r.run(code, {u: {url, state: 'available'}, b: {}, btn: (_label, click) => click()});
+    assert.equal(r.popups.length, 0);
+    assert.equal(r.requests.length, 1);
+    assert.equal(r.requests[0].url, '/api/open');
+    assert.deepEqual(r.requests[0].parsed, {url, system: true});
+  });
+  test('magpie ' + name + ' keeps standalone web opening on the client', async () => {
+    const r = runtime({embedded: false, hostname: '127.0.0.1'});
+    await r.run(code, {u: {url: 'https://example.test/release', state: 'available'}, b: {}, btn: (_label, click) => click()});
+    assert.equal(r.requests.length, 0);
+    assert.equal(r.popups.length, 1);
+  });
+}
+
+test('failed system open remains an error rather than a silent success', async () => {
+  const r = runtime({embedded: true, hostname: '127.0.0.1', fail: true});
+  await assert.rejects(r.api('open', {url: 'https://example.test/wallet'}), /fixture opener failed/);
+  assert.equal(r.requests.length, 1);
+  assert.equal(r.popups.length, 0, 'no second attempt after an ambiguous failure');
+});
