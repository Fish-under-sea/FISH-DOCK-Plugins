+++ b/internal/provider/plugin_installed_test.go
@@ -0,0 +1,56 @@
+package provider
+
+import (
+	"testing"
+
+	"github.com/yetone/magpie/internal/plugin"
+)
+
+// #47: a plugin's provider that is hidden while its package is still on this
+// machine is a host restart, not a removal — the Add sheet must not offer back
+// what the user never removed.
+func stillInstalledFixture(t *testing.T, spec string) Provider {
+	t.Helper()
+	p := Provider{ID: "neartoken", Name: "NearToken"}
+	p.Account = &Account{Agent: "plugin", plugin: &plugin.Provider{Spec: spec}}
+	return p
+}
+
+func TestASpecComesFromThePluginsProvider(t *testing.T) {
+	p := stillInstalledFixture(t, "neartoken@1.0.0")
+	if got := p.pluginSpec(); got != "neartoken@1.0.0" {
+		t.Fatalf("pluginSpec = %q, want the package's spec", got)
+	}
+	if got := (Provider{}).pluginSpec(); got != "" {
+		t.Fatalf("a built-in's pluginSpec = %q, want empty", got)
+	}
+}
+
+func TestStillInstalledOnlyWhenTheStoreSaysSo(t *testing.T) {
+	p := stillInstalledFixture(t, "neartoken@1.0.0")
+	old := PluginStillInstalled
+	t.Cleanup(func() { PluginStillInstalled = old })
+
+	PluginStillInstalled = func(spec string) bool { return spec == "neartoken@1.0.0" }
+	if !stillInstalled(p) {
+		t.Fatal("a spec the store still has must count as installed")
+	}
+
+	PluginStillInstalled = func(string) bool { return false }
+	if stillInstalled(p) {
+		t.Fatal("a package the store no longer has must not")
+	}
+
+	// Unknown is never taken as installed: before the GUI wires the hook the
+	// behaviour is the old one (removed), not a claim nobody can back.
+	PluginStillInstalled = nil
+	if stillInstalled(p) {
+		t.Fatal("no hook: unknown must not read as installed")
+	}
+
+	// A built-in has no spec: the hook is not even asked.
+	PluginStillInstalled = func(string) bool { t.Fatal("no spec, no question"); return true }
+	if stillInstalled(Provider{ID: "codex"}) {
+		t.Fatal("a built-in has no plugin package")
+	}
+}
