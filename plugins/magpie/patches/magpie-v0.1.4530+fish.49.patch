diff --git a/internal/gui/embedded_open_test.go b/internal/gui/embedded_open_test.go
new file mode 100644
index 0000000..e737164
--- /dev/null
+++ b/internal/gui/embedded_open_test.go
@@ -0,0 +1,79 @@
+package gui
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+// 真路由与 webHost 仍参与测试，只有操作系统启动浏览器的末端被替代。
+func embeddedOpenRequest(t *testing.T, address, link string, system bool) *httptest.ResponseRecorder {
+	t.Helper()
+	body, err := json.Marshal(map[string]any{"url": link, "system": system})
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest(http.MethodPost, "/api/open", bytes.NewReader(body))
+	req.RemoteAddr = address
+	req.Header.Set("Content-Type", "application/json")
+	rec := httptest.NewRecorder()
+	webPageHandler(t, webHost{}, nil).ServeHTTP(rec, req)
+	return rec
+}
+
+func TestEmbeddedWebOpenUsesSystemBrowserOnce(t *testing.T) {
+	old := openExternalBrowser
+	t.Cleanup(func() { openExternalBrowser = old })
+	for _, address := range []string{"127.0.0.1:43210", "[::1]:43210"} {
+		t.Run(address, func(t *testing.T) {
+			var opened []string
+			openExternalBrowser = func(link string) error { opened = append(opened, link); return nil }
+			link := "https://example.test/device?user_code=TEST-ONLY&aff=a%2Bb#approve"
+			res := embeddedOpenRequest(t, address, link, true)
+			if res.Code != http.StatusNoContent || len(opened) != 1 || opened[0] != link {
+				t.Fatalf("status=%d opened=%v, want one unchanged URL", res.Code, opened)
+			}
+		})
+	}
+}
+
+func TestEmbeddedWebOpenKeepsProtocolAndLocalBoundaries(t *testing.T) {
+	old := openExternalBrowser
+	t.Cleanup(func() { openExternalBrowser = old })
+	for _, tc := range []struct {
+		name, remote, link string
+	}{
+		{"remote client", "203.0.113.7:1234", "https://example.test/wallet"},
+		{"file", "127.0.0.1:1234", "file:///C:/fixture.txt"},
+		{"script", "127.0.0.1:1234", "javascript:alert(1)"},
+		{"relative", "127.0.0.1:1234", "/wallet"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			called := false
+			openExternalBrowser = func(string) error { called = true; return nil }
+			res := embeddedOpenRequest(t, tc.remote, tc.link, true)
+			if res.Code < 400 || called {
+				t.Fatalf("unaccepted request: status=%d system opener called=%v", res.Code, called)
+			}
+		})
+	}
+}
+
+func TestEmbeddedWebOpenReportsLaunchFailureAndKeepsWebDefault(t *testing.T) {
+	old := openExternalBrowser
+	t.Cleanup(func() { openExternalBrowser = old })
+	calls := 0
+	openExternalBrowser = func(string) error { calls++; return errors.New("fixture launcher error") }
+	res := embeddedOpenRequest(t, "127.0.0.1:1234", "https://example.test/wallet", true)
+	if res.Code < 400 || calls != 1 {
+		t.Fatalf("launch error was hidden: status=%d calls=%d", res.Code, calls)
+	}
+	calls = 0
+	res = embeddedOpenRequest(t, "127.0.0.1:1234", "https://example.test/wallet", false)
+	if res.Code != http.StatusNoContent || calls != 0 {
+		t.Fatalf("ordinary web mode changed: status=%d calls=%d", res.Code, calls)
+	}
+}
diff --git a/internal/gui/fish_vault.go b/internal/gui/fish_vault.go
new file mode 100644
index 0000000..f529306
--- /dev/null
+++ b/internal/gui/fish_vault.go
@@ -0,0 +1,316 @@
+package gui
+
+import (
+	"crypto/subtle"
+	"encoding/json"
+	"errors"
+	"log"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/yetone/magpie/internal/agent"
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/fishvault"
+	"github.com/yetone/magpie/internal/gateway"
+	"github.com/yetone/magpie/internal/memagent"
+	"github.com/yetone/magpie/internal/memory"
+)
+
+type fishKnowledgeView struct {
+	Root string `json:"root"`
+	URL  string `json:"url"`
+}
+
+// Only links into this owned vault can launch Obsidian from the existing
+// /api/open route; never a new arbitrary application-scheme allowance.
+func fishVaultURL(raw string) bool {
+	if fishvault.Validate(appdir.Config()) != nil {
+		return false
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "obsidian" || u.Host != "open" || u.Path != "" || u.Fragment != "" || u.User != nil {
+		return false
+	}
+	q, err := url.ParseQuery(u.RawQuery)
+	if err != nil || len(q) != 1 || len(q["path"]) != 1 {
+		return false
+	}
+	target := q.Get("path")
+	if !filepath.IsAbs(target) {
+		return false
+	}
+	relative, err := filepath.Rel(fishvault.Root(), target)
+	if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) {
+		return false
+	}
+	if relative == "." {
+		return true
+	}
+	if !strings.EqualFold(filepath.Ext(relative), ".md") {
+		return false
+	}
+	root, err := os.OpenRoot(fishvault.Root())
+	if err != nil {
+		return false
+	}
+	defer root.Close()
+	info, err := root.Lstat(relative)
+	return err == nil && info.Mode().IsRegular()
+}
+
+func fishKnowledge() *fishKnowledgeView {
+	if !fishvault.Present(appdir.Config()) {
+		return nil
+	}
+	return &fishKnowledgeView{Root: fishvault.Root(), URL: fishvault.URI(fishvault.Root(), "")}
+}
+
+type fishPairingConfig struct {
+	Token string `json:"token"`
+	Vault string `json:"vault"`
+}
+
+func sameVaultPath(a, b string) bool {
+	ca, cb := filepath.Clean(strings.TrimSpace(a)), filepath.Clean(strings.TrimSpace(b))
+	if ca == "" || cb == "" {
+		return false
+	}
+	if runtime.GOOS == "windows" {
+		return strings.EqualFold(ca, cb)
+	}
+	return ca == cb
+}
+
+func readFishPairing(vaultDir string) (fishPairingConfig, string, string) {
+	cfgDir := appdir.Config()
+	file := filepath.Join(cfgDir, "fish-obsidian-connection.json")
+	targetVault := strings.TrimSpace(vaultDir)
+	if targetVault == "" {
+		if !fishvault.Present(cfgDir) {
+			return fishPairingConfig{}, file, "knowledge vault is not configured"
+		}
+		targetVault = fishvault.RootAt(cfgDir)
+	}
+	info, err := os.Lstat(file)
+	if err != nil {
+		return fishPairingConfig{}, file, "obsidian pairing file not found"
+	}
+	if !info.Mode().IsRegular() || info.Size() > 8192 {
+		return fishPairingConfig{}, file, "obsidian pairing file invalid"
+	}
+	b, err := os.ReadFile(file)
+	if err != nil {
+		return fishPairingConfig{}, file, "cannot read obsidian pairing file"
+	}
+	var cfg fishPairingConfig
+	if json.Unmarshal(b, &cfg) != nil || len(cfg.Token) != 64 {
+		return fishPairingConfig{}, file, "obsidian pairing token invalid"
+	}
+	if !sameVaultPath(cfg.Vault, targetVault) {
+		return fishPairingConfig{}, file, "pairing file points to another vault"
+	}
+	return cfg, file, ""
+}
+
+func ensureObsidianVaultWorkspace() {
+	cfgDir := appdir.Config()
+	if !fishvault.Present(cfgDir) || fishvault.Validate(cfgDir) != nil {
+		return
+	}
+	if _, err := memagent.EnsureObsidianWorkspace(fishvault.RootAt(cfgDir)); err != nil {
+		log.Println("obsidian workspace:", err)
+		return
+	}
+	if err := memagent.SyncObsidianDefault(); err != nil {
+		log.Println("obsidian default:", err)
+	}
+}
+
+func obsidianAgentMeta(a *agent.Agent) *obsidianMetaJSON {
+	if a == nil || a.Origin != agent.OriginObsidianVault {
+		return nil
+	}
+	_, pairPath, pairErr := readFishPairing(a.VaultDir)
+	meta := &obsidianMetaJSON{
+		Vault:     tilde(a.VaultDir),
+		Workspace: tilde(a.Dir),
+		Paired:    pairErr == "",
+		PairError: pairErr,
+		PairPath:  tilde(pairPath),
+	}
+	if cfg, err := memagent.ReadObsidianConfig(a.Dir); err == nil {
+		meta.Enabled = cfg.Enabled
+		meta.Route = cfg.Route
+	}
+	st := memagent.StatusOf("")
+	if (st.Phase != "" || st.Running) && (st.Agent == a.ID || (st.Agent == memagent.DefaultAgent && a.ID == memagent.ObsidianAgentID)) {
+		ended := ""
+		if !st.Ended.IsZero() {
+			ended = st.Ended.UTC().Format(time.RFC3339)
+		}
+		meta.LastRun = &obsidianRunJSON{
+			Role:  st.Role,
+			Phase: st.Phase,
+			Steps: st.Steps,
+			Wrote: st.Wrote,
+			Saved: st.Saved,
+			Ended: ended,
+			Error: st.Error,
+		}
+	}
+	return meta
+}
+
+func obsidianPairRoute(mux *http.ServeMux) {
+	mux.HandleFunc("POST /api/agents/obsidian-pair/{id}", func(rw http.ResponseWriter, r *http.Request) {
+		a, err := agent.Find(r.PathValue("id"))
+		if err != nil {
+			fail(rw, err)
+			return
+		}
+		if a.Origin != agent.OriginObsidianVault || strings.TrimSpace(a.VaultDir) == "" {
+			fail(rw, errors.New("agent is not an obsidian vault workspace"))
+			return
+		}
+		if _, err := memagent.EnsureObsidianWorkspace(a.VaultDir); err != nil {
+			fail(rw, err)
+			return
+		}
+		_ = memagent.SyncObsidianDefault()
+		writeJSON(rw, state())
+	})
+}
+
+// These narrow desktop routes need the private pairing token in addition to
+// the GUI's normal cookie. Dock's cookie-injecting embed proxy cannot grant it.
+func fishBridgeAllowed(r *http.Request) bool {
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil || host != "127.0.0.1" || r.Header.Get("Origin") != "" {
+		return false
+	}
+	cfg, _, pairErr := readFishPairing("")
+	if pairErr != "" {
+		return false
+	}
+	token := r.Header.Get("X-Fish-Obsidian-Token")
+	return len(token) == len(cfg.Token) && subtle.ConstantTimeCompare([]byte(token), []byte(cfg.Token)) == 1
+}
+func fishVaultRoutes(mux *http.ServeMux) {
+	guard := func(fn http.HandlerFunc) http.HandlerFunc {
+		return func(w http.ResponseWriter, r *http.Request) {
+			if !fishBridgeAllowed(r) {
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(http.StatusForbidden)
+				_ = json.NewEncoder(w).Encode(map[string]any{
+					"error":  "private desktop pairing required",
+					"paired": false,
+				})
+				return
+			}
+			if err := fishvault.Validate(appdir.Config()); err != nil {
+				fail(w, err)
+				return
+			}
+			fn(w, r)
+		}
+	}
+	mux.HandleFunc("GET /api/fish-vault/status", guard(func(w http.ResponseWriter, r *http.Request) {
+		writeJSON(w, map[string]any{
+			"connected": true,
+			"paired":    true,
+			"vault":     fishvault.Root(),
+		})
+	}))
+	mux.HandleFunc("GET /api/fish-vault/models", guard(func(w http.ResponseWriter, r *http.Request) { writeJSON(w, map[string]any{"models": servedModels()}) }))
+	mux.HandleFunc("POST /api/fish-vault/search", guard(func(w http.ResponseWriter, r *http.Request) {
+		var in struct {
+			Q string `json:"q"`
+		}
+		if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 8192)).Decode(&in); err != nil {
+			fail(w, err)
+			return
+		}
+		if len([]rune(in.Q)) > 2000 {
+			fail(w, errors.New("query is too long"))
+			return
+		}
+		notes, err := fishvault.Search(r.Context(), appdir.Config(), in.Q, 20)
+		if err != nil {
+			fail(w, err)
+			return
+		}
+		hits, err := memory.Search(memory.Query{Text: in.Q, Limit: 20})
+		if err != nil {
+			fail(w, err)
+			return
+		}
+		for _, h := range hits {
+			notes.Hits = append(notes.Hits, fishvault.Hit{Type: "memory", Title: h.Kind, Text: h.Text, Path: "memories/" + h.ID + ".md", URL: fishvault.URI(fishvault.Root(), "memories/"+h.ID+".md")})
+		}
+		writeJSON(w, notes)
+	}))
+	mux.HandleFunc("POST /api/fish-vault/chat", guard(func(w http.ResponseWriter, r *http.Request) {
+		var in struct {
+			Model    string `json:"model"`
+			Messages []struct {
+				Role    string `json:"role"`
+				Content string `json:"content"`
+			} `json:"messages"`
+		}
+		if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1<<20)).Decode(&in); err != nil {
+			fail(w, err)
+			return
+		}
+		if len(in.Messages) == 0 || len(in.Messages) > 200 || !slices.ContainsFunc(servedModels(), func(m modelRef) bool { return m.ID == in.Model }) {
+			fail(w, errors.New("choose a model served here"))
+			return
+		}
+		for _, m := range in.Messages {
+			if (m.Role != "user" && m.Role != "assistant") || len([]rune(m.Content)) > 60000 {
+				fail(w, errors.New("invalid conversation"))
+				return
+			}
+		}
+		gw := served.Load()
+		if gw == nil {
+			fail(w, errors.New("the gateway is not running"))
+			return
+		}
+		body, err := json.Marshal(map[string]any{"model": in.Model, "messages": in.Messages, "stream": true, "max_tokens": 16384})
+		if err != nil {
+			fail(w, err)
+			return
+		}
+		request, err := http.NewRequestWithContext(r.Context(), http.MethodPost, gateway.URL()+"/v1/chat/completions", strings.NewReader(string(body)))
+		if err != nil {
+			fail(w, err)
+			return
+		}
+		request.RemoteAddr = "127.0.0.1:0"
+		request.Header.Set("Content-Type", "application/json")
+		request.Header.Set("x-api-key", gateway.TokenFor("obsidian"))
+		// Handler takes canonical routes: /agent/ prefixes are normalized by the
+		// outer listener, not Handler itself. TokenFor preserves Obsidian identity.
+		// Routing, privacy, model restrictions, accounting and streaming stay native.
+		gw.Handler().ServeHTTP(w, request)
+	}))
+
+	// The memory agents as the Obsidian plugin offers them (M-E): the agents
+	// to pick from, the run going, and starting and stopping one. The same
+	// handlers the GUI's Memory tab calls (memory_agents_run.go), behind this
+	// surface's own pairing token rather than a cookie: the plugin picks an
+	// agent and watches it run without a browser, and never sends a model
+	// where a memory task is picked.
+	h := agentHandlers{}
+	mux.HandleFunc("GET /api/fish-vault/memory/agents", guard(h.agents))
+	mux.HandleFunc("GET /api/fish-vault/memory/agents/status", guard(h.status))
+	mux.HandleFunc("POST /api/fish-vault/memory/agents/{role}/run", guard(h.run))
+	mux.HandleFunc("POST /api/fish-vault/memory/agents/{role}/stop", guard(h.stop))
+}
diff --git a/internal/gui/fish_vault_memory_test.go b/internal/gui/fish_vault_memory_test.go
new file mode 100644
index 0000000..dad8cad
--- /dev/null
+++ b/internal/gui/fish_vault_memory_test.go
@@ -0,0 +1,205 @@
+package gui
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/memagent"
+)
+
+// fishAgentsAt points the registry at a folder of the test's own, so a route
+// never reads or writes the user's memory-agents.json.
+func fishAgentsAt(t *testing.T) {
+	t.Helper()
+	dir := t.TempDir()
+	old := memagent.Path
+	memagent.Path = func() string { return filepath.Join(dir, "memory-agents.json") }
+	t.Cleanup(func() { memagent.Path = old })
+}
+
+func fishVaultMux(t *testing.T) *http.ServeMux {
+	t.Helper()
+	mux := http.NewServeMux()
+	memoryRoutes(mux)
+	return mux
+}
+
+// fishCall is one request as the Obsidian plugin makes it: the pairing token,
+// no Origin, from this computer.
+func fishCall(t *testing.T, mux *http.ServeMux, method, path, body, token string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	req.RemoteAddr = "127.0.0.1:5"
+	req.Header.Set("X-Fish-Obsidian-Token", token)
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, req)
+	return rec
+}
+
+// The memory agents the Obsidian plugin lists are the registry's, by id and
+// name: the model a run is sent to is never offered, and an admin cookie
+// without the pairing token gets nothing.
+func TestFishVaultMemoryAgentsRoute(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	if _, err := memagent.Restore(); err != nil {
+		t.Fatal(err)
+	}
+	rec := fishCall(t, mux, "GET", "/api/fish-vault/memory/agents", "", token)
+	if rec.Code != 200 {
+		t.Fatalf("agents: %d %s", rec.Code, rec.Body)
+	}
+	var v struct {
+		Agents   []struct{ ID, Name string }
+		Defaults map[string]string
+		Roles    []string
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &v); err != nil {
+		t.Fatalf("agents: %s", rec.Body)
+	}
+	if len(v.Agents) != 2 {
+		t.Fatalf("agents: %+v", v.Agents)
+	}
+	for _, a := range v.Agents {
+		if a.ID == "" || a.Name == "" {
+			t.Fatalf("an agent without id or name: %+v", a)
+		}
+	}
+	// no model, no route: what the plugin shows is a name to pick
+	if strings.Contains(strings.ToLower(rec.Body.String()), "deepseek") {
+		t.Fatalf("a model route leaked to the plugin: %s", rec.Body)
+	}
+	if v.Defaults[memagent.Learn] != "memory-curator" || v.Defaults[memagent.Dream] != "dreamer" {
+		t.Fatalf("defaults: %+v", v.Defaults)
+	}
+	// by role: only learn's agents are listed (the defaults name every role,
+	// so the page can show what each runs as)
+	rec = fishCall(t, mux, "GET", "/api/fish-vault/memory/agents?role=learn", "", token)
+	if rec.Code != 200 {
+		t.Fatalf("role learn: %d %s", rec.Code, rec.Body)
+	}
+	var byRole struct {
+		Agents []struct{ ID, Name string }
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &byRole); err != nil {
+		t.Fatalf("role learn: %s", rec.Body)
+	}
+	if len(byRole.Agents) != 1 || byRole.Agents[0].ID != "memory-curator" {
+		t.Fatalf("role learn listed: %+v", byRole.Agents)
+	}
+	for _, a := range byRole.Agents {
+		if a.ID == "dreamer" {
+			t.Fatalf("a dream agent was offered for learn: %+v", byRole.Agents)
+		}
+	}
+	// a role memory doesn't have is refused
+	if rec := fishCall(t, mux, "GET", "/api/fish-vault/memory/agents?role=nope", "", token); rec.Code != 400 {
+		t.Fatalf("an unknown role: %d", rec.Code)
+	}
+}
+
+// The plugin's routes need the pairing token, as every other one on this
+// surface does: a cookie alone, a wrong token, another host or an Origin
+// gets 403.
+func TestFishVaultMemoryRoutesNeedThePairingToken(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	for _, tc := range []struct {
+		name, token, origin, remote string
+		want                        int
+	}{
+		{"no token", "", "", "127.0.0.1:5", 403},
+		{"wrong token", "wrong", "", "127.0.0.1:5", 403},
+		{"an origin", token, "null", "127.0.0.1:5", 403},
+		{"another host", token, "", "192.0.2.1:5", 403},
+		{"the token", token, "", "127.0.0.1:5", 200},
+	} {
+		for _, path := range []string{
+			"/api/fish-vault/memory/agents",
+			"/api/fish-vault/memory/agents/status?role=learn",
+		} {
+			req := httptest.NewRequest("GET", path, nil)
+			req.RemoteAddr = tc.remote
+			req.Header.Set("X-Fish-Obsidian-Token", tc.token)
+			if tc.origin != "" {
+				req.Header.Set("Origin", tc.origin)
+			}
+			rec := httptest.NewRecorder()
+			mux.ServeHTTP(rec, req)
+			if rec.Code != tc.want {
+				t.Fatalf("%s %s: %d %s", tc.name, path, rec.Code, rec.Body)
+			}
+		}
+	}
+}
+
+// Status says what a role is doing (or its last run), refused for a role
+// memory doesn't have; the plugin polls it while one goes.
+func TestFishVaultMemoryStatusRoute(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	rec := fishCall(t, mux, "GET", "/api/fish-vault/memory/agents/status?role=organize", "", token)
+	if rec.Code != 200 {
+		t.Fatalf("status: %d %s", rec.Code, rec.Body)
+	}
+	var st memagent.Status
+	if err := json.Unmarshal(rec.Body.Bytes(), &st); err != nil {
+		t.Fatalf("status: %s", rec.Body)
+	}
+	if st.Running {
+		t.Fatalf("nothing should be running: %+v", st)
+	}
+	if rec := fishCall(t, mux, "GET", "/api/fish-vault/memory/agents/status?role=nope", "", token); rec.Code != 400 {
+		t.Fatalf("an unknown role: %d", rec.Code)
+	}
+}
+
+// A run the plugin asks for with an agent that doesn't carry the role out is
+// refused, and nothing starts; stopping a role that isn't going isn't an
+// error.
+func TestFishVaultMemoryRunAndStop(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	if _, err := memagent.Restore(); err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct{ path, body string }{
+		{"/api/fish-vault/memory/agents/learn/run", `{"agent":"dreamer"}`},
+		{"/api/fish-vault/memory/agents/learn/run", `{"agent":"not-there"}`},
+		{"/api/fish-vault/memory/agents/nope/run", `{}`},
+		{"/api/fish-vault/memory/agents/nope/stop", `{}`},
+	} {
+		if rec := fishCall(t, mux, "POST", c.path, c.body, token); rec.Code != 400 {
+			t.Fatalf("%s %s: %d %s", c.path, c.body, rec.Code, rec.Body)
+		}
+	}
+	if memagent.Running() {
+		t.Fatal("a refused run started")
+	}
+	rec := fishCall(t, mux, "POST", "/api/fish-vault/memory/agents/dream/stop", `{}`, token)
+	if rec.Code != 200 {
+		t.Fatalf("stop: %d %s", rec.Code, rec.Body)
+	}
+}
+
+// The GUI's own run routes are not the plugin's: the plugin's paths live
+// under /api/fish-vault, and the GUI's are cookie-authenticated. A plugin
+// token on the GUI's path does not open it, and the reverse holds too.
+func TestFishVaultMemoryRoutesStayOffTheGuiPaths(t *testing.T) {
+	_, token := guiFishVault(t)
+	fishAgentsAt(t)
+	mux := fishVaultMux(t)
+	// the GUI's status is not served to the plugin's surface at all
+	rec := fishCall(t, mux, "GET", "/api/memory/agents/status?role=learn", "", token)
+	if rec.Code != http.StatusNotFound {
+		t.Fatalf("the plugin reached the GUI's status: %d %s", rec.Code, rec.Body)
+	}
+}
