+	// Verify sandbox read/write/deny and violation logging directly through toolsForAgent.
+	sb, err := OpenSandboxWith(vault, cfg.SandboxPolicy())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sb.Close()
+	set, err := toolsForAgent(sb, nil, Learn, ObsidianAgentID, &runLog{}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	runTool := func(name string, args map[string]any) (string, error) {
+		tool, ok := set.Get(name)
+		if !ok {
+			t.Fatalf("missing tool %s", name)
+		}
+		b, _ := json.Marshal(args)
+		return tool.Call(t.Context(), b)
+	}
+
+	if out, err := runTool(ToolVaultList, map[string]any{"path": "."}); err != nil {
+		t.Fatalf("vault_list root: %v", err)
+	} else {
+		if strings.Contains(out, ".obsidian") || strings.Contains(out, ".git") || strings.Contains(out, "credentials") {
+			t.Fatalf("denied dirs leaked into vault_list: %q", out)
+		}
+		if !strings.Contains(out, "Notes/") {
+			t.Fatalf("expected Notes/ in root listing: %q", out)
+		}
+	}
+	if out, err := runTool(ToolVaultRead, map[string]any{"path": "Notes/idea.md"}); err != nil || out != "Idea body" {
+		t.Fatalf("vault_read Notes/idea.md = (%q, %v)", out, err)
+	}
+	for _, forbidden := range []string{".obsidian/magpie-agent/agent.json", ".git/config", "credentials/secret.json", "../escape.md"} {
+		if _, err := runTool(ToolVaultRead, map[string]any{"path": forbidden}); !errors.Is(err, ErrOutside) {
+			t.Fatalf("expected ErrOutside reading %q, got %v", forbidden, err)
+		}
+	}
+	if _, err := runTool(ToolVaultWrite, map[string]any{"path": "Notes/unallowed.md", "text": "no"}); !errors.Is(err, ErrOutside) {
+		t.Fatalf("expected ErrOutside writing Notes/unallowed.md, got %v", err)
+	}
+	if _, err := runTool(ToolVaultWrite, map[string]any{"path": ".obsidian/evil.md", "text": "no"}); !errors.Is(err, ErrOutside) {
+		t.Fatalf("expected ErrOutside writing .obsidian/evil.md, got %v", err)
+	}
+	if out, err := runTool(ToolVaultWrite, map[string]any{"path": "Magpie 对话/2026-11-17.md", "text": "# Digest\n"}); err != nil || !strings.Contains(out, "Magpie 对话/2026-11-17.md") {
+		t.Fatalf("vault_write allowlisted dir: (%q, %v)", out, err)
+	}
+
+	conflicts, err := os.ReadFile(filepath.Join(vault, ConflictsPath))
+	if err != nil {
+		t.Fatalf("missing conflicts log: %v", err)
+	}
+	if !strings.Contains(string(conflicts), "credentials/secret.json") || !strings.Contains(string(conflicts), "Notes/unallowed.md") {
+		t.Fatalf("conflicts log missing violation records: %q", string(conflicts))
+	}
+	auditBytes, err := os.ReadFile(AuditPath())
+	if err != nil {
+		t.Fatalf("missing audit log: %v", err)
+	}
+	if !strings.Contains(string(auditBytes), `"result":"refused"`) || !strings.Contains(string(auditBytes), ObsidianAgentID) {
+		t.Fatalf("audit log missing refused violation trace: %q", string(auditBytes))
+	}
+}
+
+func TestObsidianSandboxForbidsMemoriesWriteAllowsDreamsAndUpgradesStockPrompt(t *testing.T) {
+	vault := runAt(t)
+	isolateVaultTestEnv(t, vault)
+
+	def := DefaultObsidianConfig()
+	for _, w := range def.Sandbox.Write {
+		if strings.Trim(strings.ToLower(w), "/") == "memories" {
+			t.Fatalf("DefaultObsidianConfig.Sandbox.Write must exclude memories/: %v", def.Sandbox.Write)
+		}
+	}
+	if !slicesContainsFolder(def.Sandbox.Write, "dreams") {
+		t.Fatalf("DefaultObsidianConfig.Sandbox.Write missing dreams/: %v", def.Sandbox.Write)
+	}
+
+	// Legacy agent.json listing memories/ without dreams/ must still deny disk writes under memories/
+	// and allow dreams/ under SandboxPolicy.
+	wsDir := ObsidianWorkspaceDir(vault)
+	if err := os.MkdirAll(wsDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	legacyCfg := ObsidianConfig{
+		Schema:  1,
+		ID:      ObsidianAgentID,
+		Name:    ObsidianAgentName,
+		Roles:   []string{Learn, Organize, Dream},
+		Route:   "group/deepseek",
+		Enabled: true,
+		Sandbox: ObsidianSandboxConfig{
+			Read:  []string{"."},
+			Write: []string{"Magpie 对话/", "memories/", "inspirations/", "_digests/", "logs/"},
+			Deny:  []string{".obsidian/", ".git/", "credentials/"},
+		},
+	}
+	if err := WriteObsidianConfig(wsDir, legacyCfg); err != nil {
+		t.Fatal(err)
+	}
+	// Seed legacy fish.45 stock AGENTS.md inside magpie managed block; EnsureObsidianWorkspace upgrades it.
+	legacyBlock := "<!-- magpie:begin · written by magpie from its Library -->\n" + legacyObsidianInstructionsV45 + "\n<!-- magpie:end -->\n"
+	if err := os.WriteFile(filepath.Join(wsDir, InstructionsName), []byte(legacyBlock), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := EnsureObsidianWorkspace(vault); err != nil {
+		t.Fatalf("EnsureObsidianWorkspace: %v", err)
+	}
+	upgraded, err := os.ReadFile(filepath.Join(wsDir, InstructionsName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(upgraded), "inspirations/") || !strings.Contains(string(upgraded), "dreams/YYYY-MM-DD-") || !strings.Contains(string(upgraded), "memory_save") {
+		t.Fatalf("legacy stock AGENTS.md was not upgraded to rewritten prompt:\n%s", string(upgraded))
+	}
+
+	readCfg, err := ReadObsidianConfig(wsDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sb, err := OpenSandboxWith(vault, readCfg.SandboxPolicy())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sb.Close()
+	if err := sb.Write("memories/m_bypass.md", []byte("bad")); !errors.Is(err, ErrOutside) {
+		t.Fatalf("memories/ must be read-only to vault_write even with legacy agent.json, got %v", err)
+	}
+	if err := sb.Write("dreams/2026-11-17-test.md", []byte("# ok\n")); err != nil {
+		t.Fatalf("dreams/ should be writable: %v", err)
+	}
+}
+
+func slicesContainsFolder(list []string, folder string) bool {
+	for _, s := range list {
+		if strings.Trim(strings.ToLower(strings.TrimSpace(s)), "/") == strings.ToLower(folder) {
+			return true
+		}
+	}
+	return false
+}
