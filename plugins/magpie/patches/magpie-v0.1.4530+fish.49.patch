@@ -0,0 +1,96 @@
+package fishvault
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func vaultFixture(t *testing.T) (string, string) {
+	t.Helper()
+	data := t.TempDir()
+	root := RootAt(data)
+	if err := os.MkdirAll(root, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, Record), []byte(`{"schema":1,"imported":true,"files":[]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return data, root
+}
+func note(t *testing.T, root, name, text string) {
+	t.Helper()
+	file := filepath.Join(root, name)
+	if err := os.MkdirAll(filepath.Dir(file), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(file, []byte(text), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestKnowledgeReadsRecursiveChineseNotesAndHandEdits(t *testing.T) {
+	data, root := vaultFixture(t)
+	note(t, root, "wiki/设计.md", "# 跨项目记忆\n模型整理知识库，保留来源。\n"+strings.Repeat("长笔记不截断。", 500))
+	r, err := Search(context.Background(), data, "知识库", 10)
+	if err != nil || len(r.Hits) != 1 {
+		t.Fatalf("%+v %v", r, err)
+	}
+	h := r.Hits[0]
+	if h.Path != "wiki/设计.md" || h.Title != "跨项目记忆" || !strings.HasPrefix(h.URL, "obsidian://open?path=") {
+		t.Fatalf("%+v", h)
+	}
+	note(t, root, "wiki/设计.md", "# 新内容\n新的关键词")
+	r, err = Search(context.Background(), data, "新的关键词", 10)
+	if err != nil || len(r.Hits) != 1 {
+		t.Fatalf("hand edit not read: %+v %v", r, err)
+	}
+}
+func TestKnowledgeExcludesPrivateFilesAndHistoricalCopies(t *testing.T) {
+	data, root := vaultFixture(t)
+	for _, p := range []string{".obsidian/secret.md", ".workflow/transactions/a.md", "memories/m_private.md", "credentials/key.md", ".git/config.md"} {
+		note(t, root, p, "needle")
+	}
+	note(t, root, "projects/record.md", "needle")
+	r, err := Search(context.Background(), data, "needle", 10)
+	if err != nil || len(r.Hits) != 1 || r.Hits[0].Path != "projects/record.md" {
+		t.Fatalf("%+v %v", r, err)
+	}
+}
+func TestKnowledgeBadMarkerFailsClosedAndMissingIsDisabled(t *testing.T) {
+	data, root := vaultFixture(t)
+	note(t, root, Record, "{")
+	if _, err := Search(context.Background(), data, "needle", 10); err == nil {
+		t.Fatal("bad marker accepted")
+	}
+	r, err := Search(context.Background(), t.TempDir(), "needle", 10)
+	if err != nil || len(r.Hits) != 0 {
+		t.Fatalf("%+v %v", r, err)
+	}
+}
+func TestKnowledgeCancellationAndOversizedNotesAreVisible(t *testing.T) {
+	data, root := vaultFixture(t)
+	note(t, root, "big.md", strings.Repeat("x", (4<<20)+1))
+	r, err := Search(context.Background(), data, "x", 10)
+	if err != nil || r.Skipped != 1 {
+		t.Fatalf("%+v %v", r, err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := Search(ctx, data, "x", 10); err == nil {
+		t.Fatal("cancel ignored")
+	}
+}
+func TestKnowledgeDoesNotFollowExternalSymlinks(t *testing.T) {
+	data, root := vaultFixture(t)
+	outside := t.TempDir()
+	note(t, outside, "secret.md", "outside secret")
+	if err := os.Symlink(filepath.Join(outside, "secret.md"), filepath.Join(root, "link.md")); err != nil {
+		t.Skipf("symlink unavailable: %v", err)
+	}
+	r, err := Search(context.Background(), data, "outside", 10)
+	if err != nil || len(r.Hits) != 0 {
+		t.Fatalf("external file read: %+v %v", r, err)
+	}
+}
diff --git a/internal/gateway/audio_mcp_fallback_test.go b/internal/gateway/audio_mcp_fallback_test.go
new file mode 100644
index 0000000..cb30452
--- /dev/null
+++ b/internal/gateway/audio_mcp_fallback_test.go
@@ -0,0 +1,157 @@
+package gateway
+
+import (
+	"encoding/base64"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// audioVendor is a site that serves a Gemini-native TTS model: the speech
+// path has no channel, the chat path refuses a media model, and only
+// generateContent (non-streaming) answers with audio. What each path was
+// sent is kept.
+type audioVendor struct {
+	mu         sync.Mutex
+	sent       map[string][]string
+	chatAudio  string
+	geminiCode int
+	geminiBody string
+}
+
+func (v *audioVendor) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	body, _ := io.ReadAll(r.Body)
+	v.mu.Lock()
+	if v.sent == nil {
+		v.sent = map[string][]string{}
+	}
+	v.sent[r.URL.Path] = append(v.sent[r.URL.Path], string(body))
+	v.mu.Unlock()
+	w.Header().Set("Content-Type", "application/json")
+	switch {
+	case strings.HasSuffix(r.URL.Path, "/audio/speech"):
+		w.WriteHeader(http.StatusInternalServerError)
+		io.WriteString(w, `{"error":{"message":"not implemented"}}`)
+	case strings.HasSuffix(r.URL.Path, "/chat/completions"):
+		if v.chatAudio != "" {
+			io.WriteString(w, `{"choices":[{"message":{"role":"assistant","audio":{"data":"`+v.chatAudio+`"}}}]}`)
+			return
+		}
+		w.WriteHeader(http.StatusBadRequest)
+		io.WriteString(w, `{"error":{"message":"NearToken: use non-streaming generateContent for this media model"}}`)
+	case strings.Contains(r.URL.Path, ":streamGenerateContent"):
+		w.WriteHeader(http.StatusBadRequest)
+		io.WriteString(w, `{"error":{"message":"a media model must not be streamed"}}`)
+	case strings.Contains(r.URL.Path, ":generateContent"):
+		if v.geminiCode != 0 {
+			w.WriteHeader(v.geminiCode)
+			io.WriteString(w, v.geminiBody)
+			return
+		}
+		audio := base64.StdEncoding.EncodeToString([]byte("ID3fake"))
+		io.WriteString(w, `{"candidates":[{"content":{"parts":[{"inlineData":{"mimeType":"audio/mpeg","data":"`+audio+`"}}]}}]}`)
+	default:
+		w.WriteHeader(http.StatusNotFound)
+	}
+}
+
+func (v *audioVendor) got(path string) []string {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	return append([]string(nil), v.sent[path]...)
+}
+
+func audioVendorServer(t *testing.T, v *audioVendor) *Server {
+	t.Helper()
+	fresh(t)
+	up := httptest.NewServer(v)
+	t.Cleanup(up.Close)
+	if err := provider.Save(provider.Provider{ID: "gem", Name: "Gem", Key: "key",
+		Chat: up.URL + "/v1", Gemini: up.URL + "/v1beta", Models: []string{"gemini-3.8-flash-tts"}}); err != nil {
+		t.Fatal(err)
+	}
+	return New()
+}
+
+// generate_audio on a Gemini-native TTS model must reach generateContent,
+// non-streamed, with the model stripped of its provider prefix by the
+// route; the speech and chat paths of such a site have no audio.
+func TestGenerateAudioFallsBackToGeminiNonStreaming(t *testing.T) {
+	v := &audioVendor{}
+	s := audioVendorServer(t, v)
+	h := lanGuard(s.Handler())
+	m := readImageReply(t, imagePost(h, "127.0.0.1:5000", imageToolCall(GenerateAudioTool, map[string]any{
+		"text": "おはよう、先生。", "model": "gem/gemini-3.8-flash-tts", "format": "mp3"})))
+	if m.Result.IsError {
+		t.Fatalf("generate_audio failed: %+v", m.Result.Content)
+	}
+	if len(m.Result.Content) != 1 || m.Result.Content[0].Type != "audio" || m.Result.Content[0].MimeType != "audio/mpeg" ||
+		m.Result.Content[0].Data != base64.StdEncoding.EncodeToString([]byte("ID3fake")) {
+		t.Fatalf("audio content: %+v", m.Result.Content)
+	}
+	if got := v.got("/v1beta/models/gemini-3.8-flash-tts:generateContent"); len(got) != 1 {
+		t.Fatalf("generateContent sent %v; paths %v", got, v.sent)
+	} else if !strings.Contains(got[0], `"responseModalities":["AUDIO"]`) {
+		t.Fatalf("generateContent body %s", got[0])
+	}
+	for path := range v.sent {
+		if strings.Contains(path, ":streamGenerateContent") {
+			t.Fatalf("a media model was streamed: %s", path)
+		}
+		if strings.Contains(path, "neartoken/") || strings.Contains(path, "gem/") {
+			t.Fatalf("provider prefix reached the native URL: %s", path)
+		}
+	}
+}
+
+// A failed fallback names every upstream answer it got, so the site's own
+// words (not a summary that hides which path failed) reach the agent.
+func TestGenerateAudioReportsEachUpstreamError(t *testing.T) {
+	v := &audioVendor{geminiCode: http.StatusBadRequest, geminiBody: `{"error":{"message":"gemini says no"}}`}
+	s := audioVendorServer(t, v)
+	h := lanGuard(s.Handler())
+	m := readImageReply(t, imagePost(h, "127.0.0.1:5000", imageToolCall(GenerateAudioTool, map[string]any{
+		"text": "hello", "model": "gem/gemini-3.8-flash-tts", "format": "mp3"})))
+	if !m.Result.IsError {
+		t.Fatalf("a refused fallback is not an error: %+v", m.Result.Content)
+	}
+	said := m.Result.Content[0].Text
+	for _, want := range []string{"not implemented", "use non-streaming generateContent", "gemini says no"} {
+		if !strings.Contains(said, want) {
+			t.Fatalf("error misses %q: %s", want, said)
+		}
+	}
+}
+
+// A music model whose provider serves chat alone keeps the chat fallback:
+// its audio comes back in message.audio.data, and no Gemini path is tried.
+func TestGenerateAudioChatOnlyModel(t *testing.T) {
+	fresh(t)
+	v := &audioVendor{chatAudio: base64.StdEncoding.EncodeToString([]byte("SUNO"))}
+	up := httptest.NewServer(v)
+	t.Cleanup(up.Close)
+	if err := provider.Save(provider.Provider{ID: "suno", Name: "Suno", Key: "key",
+		Chat: up.URL + "/v1", Models: []string{"suno_music"}}); err != nil {
+		t.Fatal(err)
+	}
+	s := New()
+	h := lanGuard(s.Handler())
+	m := readImageReply(t, imagePost(h, "127.0.0.1:5000", imageToolCall(GenerateAudioTool, map[string]any{
+		"text": "a song", "model": "suno/suno_music", "format": "mp3"})))
+	if m.Result.IsError || len(m.Result.Content) != 1 || m.Result.Content[0].Data != base64.StdEncoding.EncodeToString([]byte("SUNO")) {
+		t.Fatalf("chat fallback: %+v", m.Result.Content)
+	}
+	if got := v.got("/v1/chat/completions"); len(got) != 1 {
+		t.Fatalf("chat sent %v; paths %v", got, v.sent)
+	}
+	for path := range v.sent {
+		if strings.Contains(path, ":generateContent") {
+			t.Fatalf("a chat-only provider was asked Gemini: %s", path)
+		}
+	}
+}
