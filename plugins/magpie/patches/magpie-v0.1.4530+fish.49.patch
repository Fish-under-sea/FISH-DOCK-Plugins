+++ b/internal/memagent/mcp_stdio_test.go
@@ -0,0 +1,147 @@
+package memagent
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+)
+
+// A message goes to the server as one line, and the caller's bytes aren't
+// written into: the framing is the connection's.
+func TestStdioConnFramesOneLinePerMessage(t *testing.T) {
+	pr, pw := io.Pipe()
+	sc := bufio.NewScanner(pr)
+	lines := make(chan string, 4)
+	go func() {
+		for sc.Scan() {
+			lines <- sc.Text()
+		}
+		close(lines)
+	}()
+	c := &stdioConn{in: pw, lines: make(chan []byte), done: make(chan struct{})}
+	msg := []byte(`{"jsonrpc":"2.0","id":1,"method":"tools/list"}`)
+	keep := string(msg)
+	if err := c.Send(msg); err != nil {
+		t.Fatal(err)
+	}
+	if string(msg) != keep {
+		t.Fatal("Send wrote into the caller's bytes")
+	}
+	if got := <-lines; got != keep {
+		t.Fatalf("%q", got)
+	}
+	// a second message is a second line, not a continuation of the first
+	if err := c.Send([]byte(`{"jsonrpc":"2.0","method":"notifications/initialized"}`)); err != nil {
+		t.Fatal(err)
+	}
+	if got := <-lines; got != `{"jsonrpc":"2.0","method":"notifications/initialized"}` {
+		t.Fatalf("%q", got)
+	}
+	_ = pw.Close()
+}
+
+// The client's handshake and a call, over a connection of the test's: what
+// the protocol requires, in order.
+func TestMCPClientSpeaksTheProtocol(t *testing.T) {
+	f := newFakeServer(t,
+		mcpTool{Name: "say", Description: "says", InputSchema: map[string]any{"type": "object"}},
+		mcpTool{Name: "quiet"},
+	)
+	f.answer["say"] = "hello"
+	f.answer["quiet"] = ""
+	c, err := openMCP(Server{Name: "notes", Command: "x"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.close()
+	// the tools are named for the server, so two servers can't collide
+	tools := mcpTools(c)
+	if len(tools) != 2 || tools[0].Name != "notes__say" || tools[0].Description != "says" {
+		t.Fatalf("%+v", tools)
+	}
+	out, err := tools[0].Call(context.Background(), json.RawMessage(`{}`))
+	if err != nil || out != "hello" {
+		t.Fatalf("%q %v", out, err)
+	}
+	// a tool that answers nothing says so rather than giving an empty turn
+	out, err = tools[1].Call(context.Background(), nil)
+	if err != nil || out == "" {
+		t.Fatalf("%q %v", out, err)
+	}
+}
+
+// A server that ends during the handshake is an error naming it, not a run
+// that waits for a reply that will never come.
+func TestMCPClientGivesUpOnAnEndedServer(t *testing.T) {
+	c := &silentConn{lines: make(chan []byte)}
+	old := DialServer
+	DialServer = func(Server) (MCPConn, error) { return c, nil }
+	t.Cleanup(func() { DialServer = old })
+	go func() {
+		// one line, then the connection ends
+		c.lines <- []byte(`{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-06-18"}}`)
+		_ = c.Close()
+	}()
+	if _, err := openMCP(Server{Name: "brief", Command: "x"}); err == nil || !strings.Contains(err.Error(), "brief") {
+		t.Fatalf("err: %v", err)
+	}
+}
+
+// A server that says its tools in more than one page is read whole.
+func TestMCPClientReadsEveryPage(t *testing.T) {
+	paged := &pagedConn{lines: make(chan []byte, 8), pages: [][]mcpTool{
+		{{Name: "one"}, {Name: "two"}},
+		{{Name: "three"}},
+	}}
+	old := DialServer
+	DialServer = func(Server) (MCPConn, error) { return paged, nil }
+	t.Cleanup(func() { DialServer = old })
+	c, err := openMCP(Server{Name: "many", Command: "x"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.close()
+	if len(c.tools) != 3 || c.tools[2].Name != "three" {
+		t.Fatalf("%+v", c.tools)
+	}
+}
+
+// pagedConn is a server whose tools/list comes a page at a time.
+type pagedConn struct {
+	lines chan []byte
+	pages [][]mcpTool
+	page  int
+}
+
+func (c *pagedConn) Send(b []byte) error {
+	var m struct {
+		ID     json.RawMessage `json:"id"`
+		Method string          `json:"method"`
+	}
+	if err := json.Unmarshal(b, &m); err != nil || m.ID == nil {
+		return nil // a notification
+	}
+	switch m.Method {
+	case "initialize":
+		c.lines <- reply(m.ID, map[string]any{"protocolVersion": "2025-06-18"})
+	case "tools/list":
+		if c.page >= len(c.pages) {
+			c.lines <- reply(m.ID, map[string]any{"tools": []mcpTool{}})
+			return nil
+		}
+		res := map[string]any{"tools": c.pages[c.page]}
+		if c.page < len(c.pages)-1 {
+			res["nextCursor"] = "page-" + string(rune('1'+c.page))
+		}
+		c.page++
+		c.lines <- reply(m.ID, res)
+	}
+	return nil
+}
+
+func (c *pagedConn) Lines() <-chan []byte { return c.lines }
+func (c *pagedConn) Close() error         { return errors.New("closed") }
diff --git a/internal/memagent/mcp_test.go b/internal/memagent/mcp_test.go
new file mode 100644
index 0000000..8a6d0e7
--- /dev/null
+++ b/internal/memagent/mcp_test.go
@@ -0,0 +1,233 @@
+package memagent
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// fakeServer is an MCP server a test gives instead of starting a process:
+// it answers initialize, tools/list and tools/call as a real one does.
+type fakeServer struct {
+	mu     sync.Mutex
+	tools  []mcpTool
+	answer map[string]string
+	fail   map[string]bool
+	calls  []string
+	lines  chan []byte
+	in     chan []byte
+	closed bool
+}
+
+func newFakeServer(t *testing.T, tools ...mcpTool) *fakeServer {
+	t.Helper()
+	f := &fakeServer{
+		tools: tools, answer: map[string]string{}, fail: map[string]bool{},
+		lines: make(chan []byte, 16), in: make(chan []byte, 16),
+	}
+	old := DialServer
+	DialServer = func(Server) (MCPConn, error) { return f, nil }
+	t.Cleanup(func() {
+		DialServer = old
+		f.Close()
+	})
+	return f
+}
+
+func (f *fakeServer) Send(b []byte) error {
+	var m struct {
+		ID     json.RawMessage `json:"id"`
+		Method string          `json:"method"`
+		Params struct {
+			Name      string          `json:"name"`
+			Arguments json.RawMessage `json:"arguments"`
+		} `json:"params"`
+	}
+	if err := json.Unmarshal(b, &m); err != nil {
+		return err
+	}
+	switch m.Method {
+	case "initialize":
+		f.lines <- reply(m.ID, map[string]any{"protocolVersion": "2025-06-18", "capabilities": map[string]any{},
+			"serverInfo": map[string]any{"name": "fake", "version": "1"}})
+	case "tools/list":
+		f.lines <- reply(m.ID, map[string]any{"tools": f.tools})
+	case "tools/call":
+		f.mu.Lock()
+		f.calls = append(f.calls, m.Params.Name)
+		out, ok := f.answer[m.Params.Name]
+		bad := f.fail[m.Params.Name]
+		f.mu.Unlock()
+		if !ok {
+			f.lines <- rpcErr(m.ID, "no tool named "+m.Params.Name)
+			return nil
+		}
+		res := map[string]any{"content": []any{map[string]any{"type": "text", "text": out}}}
+		if bad {
+			res["isError"] = true
+		}
+		f.lines <- reply(m.ID, res)
+	}
+	return nil
+}
+
+func (f *fakeServer) Lines() <-chan []byte { return f.lines }
+
+func (f *fakeServer) Close() error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if !f.closed {
+		f.closed = true
+		close(f.lines)
+	}
+	return nil
+}
+
+func reply(id json.RawMessage, result any) []byte {
+	b, _ := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": id, "result": result})
+	return b
+}
+
+func rpcErr(id json.RawMessage, msg string) []byte {
+	b, _ := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": id, "error": map[string]any{"code": -32602, "message": msg}})
+	return b
+}
+
+// A server's tools are given to the model as `<server>__<tool>`, and a call
+// reaches the server with the arguments the model gave.
+func TestMCPToolsAreGivenAndCalled(t *testing.T) {
+	f := newFakeServer(t, mcpTool{
+		Name:        "list_notes",
+		Description: "lists the notes",
+		InputSchema: map[string]any{"type": "object", "properties": map[string]any{"dir": map[string]any{"type": "string"}}},
+	})
+	f.answer["list_notes"] = "wiki/a.md\nwiki/b.md"
+	dir := runAt(t)
+	home := homeAt(t)
+	if err := writeMCP(t, home, `{"mcpServers": {"notes": {"command": "x"}}}`); err != nil {
+		t.Fatal(err)
+	}
+	a := &asker{replies: []Turn{
+		{Calls: []Call{call("c1", "notes__list_notes", map[string]any{"dir": "wiki"})}},
+		{Text: "done"},
+	}}
+	res, err := Run(t.Context(), Task{Role: Dream, Model: "m", Prompt: "p"}, Options{Ask: a.ask, Vault: dir})
+	if err != nil || res.Phase != PhaseDone {
+		t.Fatalf("%+v %v", res, err)
+	}
+	var found bool
+	for _, tl := range a.asked[0].Tools {
+		if tl.Name == "notes__list_notes" && tl.Description == "lists the notes" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("the server's tool wasn't given: %v", a.asked[0].Tools)
+	}
+	f.mu.Lock()
+	calls := append([]string(nil), f.calls...)
+	f.mu.Unlock()
+	if len(calls) != 1 || calls[0] != "list_notes" {
+		t.Fatalf("the server was called %v", calls)
+	}
+	results := a.asked[1].Messages[2]["content"].([]any)
+	if got := results[0].(map[string]any)["content"]; !strings.Contains(got.(string), "wiki/a.md") {
+		t.Fatalf("the result: %v", got)
+	}
+}
+
+// A tool that fails, or a server that is down, is a tool error the model
+// sees: the run goes on with the tools it has.
+func TestMCPFailuresAreToolErrors(t *testing.T) {
+	f := newFakeServer(t, mcpTool{Name: "boom"})
+	f.fail["boom"] = true
+	f.answer["boom"] = "it broke"
+	dir := runAt(t)
+	home := homeAt(t)
+	// one server that can't be started, and one that can
+	if err := writeMCP(t, home, `{"mcpServers": {"down": {"command": "x"}, "notes": {"command": "y"}}}`); err != nil {
+		t.Fatal(err)
+	}
+	dial := DialServer
+	DialServer = func(s Server) (MCPConn, error) {
+		if s.Name == "down" {
+			return nil, errors.New("couldn't start x: not found")
+		}
+		return dial(s)
+	}
+	t.Cleanup(func() { DialServer = dial })
+	a := &asker{replies: []Turn{
+		{Calls: []Call{call("c1", "notes__boom", map[string]any{})}},
+		{Text: "the tool failed, going on"},
+	}}
+	res, err := Run(t.Context(), Task{Role: Learn, Model: "m", Prompt: "p"}, Options{Ask: a.ask, Vault: dir})
+	if err != nil || res.Phase != PhaseDone {
+		t.Fatalf("%+v %v", res, err)
+	}
+	results := a.asked[1].Messages[2]["content"].([]any)
+	if block := results[0].(map[string]any); block["is_error"] != true || !strings.Contains(fmt.Sprint(block["content"]), "it broke") {
+		t.Fatalf("the failed tool: %+v", block)
+	}
+	st := StatusOf(Learn)
+	var said bool
+	for _, m := range st.Messages {
+		if m.Role == "error" && m.Tool == "mcp" && strings.Contains(m.Text, "down") {
+			said = true
+		}
+	}
+	if !said {
+		t.Fatalf("the run didn't say which server was down: %+v", st.Messages)
+	}
+	// the tool that couldn't be opened isn't given to the model
+	for _, tl := range a.asked[0].Tools {
+		if strings.HasPrefix(tl.Name, "down__") {
+			t.Fatalf("a tool of a server that didn't start: %s", tl.Name)
+		}
+	}
+}
+
+// A server that doesn't answer is given up on within MCPTimeout, and the
+// run isn't left waiting on it.
+func TestMCPHandshakeGivesUp(t *testing.T) {
+	silent := &silentConn{lines: make(chan []byte)}
+	old := DialServer
+	DialServer = func(Server) (MCPConn, error) { return silent, nil }
+	t.Cleanup(func() { DialServer = old })
+	oldTimeout := mcpTimeout
+	mcpTimeout = 50 * time.Millisecond
+	t.Cleanup(func() { mcpTimeout = oldTimeout })
+	start := time.Now()
+	if _, err := openMCP(Server{Name: "quiet", Command: "x"}); err == nil {
+		t.Fatal("a server that didn't answer was taken")
+	}
+	if time.Since(start) > 5*time.Second {
+		t.Fatalf("the handshake took %v", time.Since(start))
+	}
+}
+
+// writeMCP writes the agent's mcp.json.
+func writeMCP(t *testing.T, home, body string) error {
+	t.Helper()
+	return os.WriteFile(filepath.Join(home, MCPName), []byte(body), 0o600)
+}
+
+// silentConn is a server that never answers.
+type silentConn struct {
+	lines chan []byte
+	once  sync.Once
+}
+
+func (c *silentConn) Send([]byte) error { return nil }
+func (c *silentConn) Lines() <-chan []byte {
+	return c.lines
+}
+func (c *silentConn) Close() error {
+	c.once.Do(func() { close(c.lines) })
+	return nil
+}
