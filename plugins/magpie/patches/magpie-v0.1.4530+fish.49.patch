+
+// Speakers are the models a provider speaks or hears with — TTS
+// (catalog.ServesSpeech) and transcription (catalog.ServesTranscription),
+// #24 — less the ones unticked in its editor (provider.HiddenAudios), and
+// the ones the user filed under speech or transcription that no fetched list
+// has at all (#42). The two Serves values are one section in the editor and
+// one kind in /v1/models, as the user thinks of them: audio.
+func Speakers(p provider.Provider) []catalog.Model {
+	return servingKinds(p, provider.KindSpeech, provider.KindTranscription, p.HiddenAudios)
+}
+
+// Embedders are the models a provider embeds and reranks with
+// (catalog.ServesEmbedding, catalog.ServesRerank, #24), less the ones
+// unticked in its editor (provider.HiddenEmbeddings), and the ones the user
+// filed under embedding or rerank that no fetched list has at all (#42).
+// Their two Serves values are one section and one kind, as for speech.
+func Embedders(p provider.Provider) []catalog.Model {
+	return servingKinds(p, provider.KindEmbedding, provider.KindRerank, p.HiddenEmbeddings)
+}
+
+// servingKinds are the models a provider serves under either of two Serves
+// values (speech and transcription, embedding and rerank), from its fetched
+// list and the ones the user said, less the ids unticked in its editor.
+func servingKinds(p provider.Provider, a, b string, hidden []string) []catalog.Model {
+	var out []catalog.Model
+	add := func(m catalog.Model, serves string) {
+		if slices.Contains(hidden, m.ID) || slices.ContainsFunc(out, func(o catalog.Model) bool { return o.ID == m.ID }) {
+			return
+		}
+		m.Provider, m.Serves = p.ID, serves
+		out = append(out, m)
+	}
+	for _, m := range servingOf(p) {
+		// the user's word first: one said to draw or make videos serves no
+		// such API, and one said to be a speech model is filed there even
+		// when its list or its id said nothing
+		if serves := provider.ServedAs(p, m); serves == a || serves == b {
+			add(m, serves)
+		}
+	}
+	for _, kind := range []string{a, b} {
+		for _, id := range p.KindModels(kind) {
+			add(kindModel(p, id), kind)
+		}
+	}
+	return out
+}
