diff --git a/internal/memory/fish_vault.go b/internal/memory/fish_vault.go
new file mode 100644
index 0000000..e8d516a
--- /dev/null
+++ b/internal/memory/fish_vault.go
@@ -0,0 +1,101 @@
+package memory
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+
+	"github.com/yetone/magpie/internal/fishvault"
+)
+
+// Called under the native process/file lock, before journal replay. Copy the
+// entire old store (including a pending journal), not just its visible memories.
+// Original files stay intact as a recovery copy. Legacy memory.json continues
+// through the existing migrate() path, retaining memory.json.migrated.
+func prepareFishMemory() error {
+	data := filepath.Dir(Path())
+	if !fishvault.Present(data) {
+		return nil
+	}
+	if err := fishvault.Validate(data); err != nil {
+		return err
+	}
+	destination := Dir()
+	if info, err := os.Lstat(destination); err == nil {
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return errors.New("memory vault directory is not independent")
+		}
+		marker, err := os.ReadFile(filepath.Join(destination, ".fish-memory-ready"))
+		if err != nil || string(marker) != "1\n" {
+			return errors.New("memory relocation is incomplete; original memory is kept")
+		}
+		return nil
+	} else if !errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
+	staging, err := os.MkdirTemp(filepath.Dir(destination), ".memories-")
+	if err != nil {
+		return err
+	}
+	defer os.RemoveAll(staging)
+	source := filepath.Join(data, "memory")
+	if info, err := os.Lstat(source); err == nil {
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return errors.New("old memory directory contains links")
+		}
+		root, err := os.OpenRoot(source)
+		if err != nil {
+			return err
+		}
+		defer root.Close()
+		err = fs.WalkDir(root.FS(), ".", func(name string, entry fs.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				return walkErr
+			}
+			if name == "." {
+				return nil
+			}
+			info, err := root.Lstat(name)
+			if err != nil {
+				return err
+			}
+			target := filepath.Join(staging, filepath.FromSlash(name))
+			if info.IsDir() {
+				return os.Mkdir(target, 0o700)
+			}
+			if !info.Mode().IsRegular() {
+				return fmt.Errorf("old memory has a non-regular file: %s", name)
+			}
+			input, err := root.Open(name)
+			if err != nil {
+				return err
+			}
+			defer input.Close()
+			output, err := os.OpenFile(target, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+			if err != nil {
+				return err
+			}
+			_, err = io.Copy(output, input)
+			if err == nil {
+				err = output.Sync()
+			}
+			closeErr := output.Close()
+			if err != nil {
+				return err
+			}
+			return closeErr
+		})
+		if err != nil {
+			return err
+		}
+	} else if !errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
+	if err = os.WriteFile(filepath.Join(staging, ".fish-memory-ready"), []byte("1\n"), 0o600); err != nil {
+		return err
+	}
+	return os.Rename(staging, destination)
+}
diff --git a/internal/memory/fish_vault_test.go b/internal/memory/fish_vault_test.go
new file mode 100644
index 0000000..cd338f1
--- /dev/null
+++ b/internal/memory/fish_vault_test.go
@@ -0,0 +1,75 @@
+package memory
+
+import (
+	"github.com/yetone/magpie/internal/fishvault"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func enableFishVault(t *testing.T) string {
+	t.Helper()
+	root := fishvault.RootAt(filepath.Dir(Path()))
+	if err := os.MkdirAll(root, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, fishvault.Record), []byte(`{"schema":1,"imported":true,"files":[]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return root
+}
+func TestFishVaultKeepsNativeMemoryAndOriginalCopy(t *testing.T) {
+	fresh(t)
+	m := save(t, "Uses a shared independent vault", Preference, Global, "vault")
+	oldDir := Dir()
+	before := readFile(t, filepath.Join(oldDir, m.ID+".md"))
+	root := enableFishVault(t)
+	back := get(t, m.ID)
+	if back.Text != m.Text || back.Scope != m.Scope || back.ID != m.ID {
+		t.Fatalf("lost native data: %+v", back)
+	}
+	if Dir() != filepath.Join(root, "memories") {
+		t.Fatalf("wrong root %s", Dir())
+	}
+	if got := readFile(t, filepath.Join(oldDir, m.ID+".md")); got != before {
+		t.Fatal("old copy changed")
+	}
+	handWrite(t, mdOf(m.ID), "User changed this in Obsidian\n")
+	if got := get(t, m.ID); got.Text != "User changed this in Obsidian" || got.Origin != FromUser {
+		t.Fatalf("edit not shared: %+v", got)
+	}
+	if got := readFile(t, filepath.Join(oldDir, m.ID+".md")); got != before {
+		t.Fatal("native write reached old copy")
+	}
+}
+func TestFishVaultPreservesLegacyJSONMigration(t *testing.T) {
+	fresh(t)
+	old := `{"version":1,"memories":[{"id":"m_old","text":"Legacy memory","kind":"fact","scope":"global","origin":"user","status":"active"}]}`
+	if err := os.WriteFile(Path(), []byte(old), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	enableFishVault(t)
+	ms, _, err := All()
+	if err != nil || len(ms) != 1 || ms[0].Text != "Legacy memory" {
+		t.Fatalf("%+v %v", ms, err)
+	}
+	if readFile(t, Path()+".migrated") != old {
+		t.Fatal("legacy backup lost")
+	}
+}
+func TestFishVaultBrokenTargetDoesNotFallBackToEmptyStore(t *testing.T) {
+	fresh(t)
+	m := save(t, "Preserve me", Fact, Global)
+	old := readFile(t, mdOf(m.ID))
+	root := enableFishVault(t)
+	if err := os.Mkdir(filepath.Join(root, "memories"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := All(); err == nil || !strings.Contains(err.Error(), "incomplete") {
+		t.Fatalf("bad target silently read: %v", err)
+	}
+	if readFile(t, filepath.Join(filepath.Dir(Path()), "memory", m.ID+".md")) != old {
+		t.Fatal("original touched")
+	}
+}
