+
+// Two magpies changing the registry at once make one change each, both
+// kept: each takes the lock, reads afresh and writes whole.
+func TestConcurrentAddsAreAllKept(t *testing.T) {
+	tempPath(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	old := lockWait
+	lockWait = 60 * time.Second
+	t.Cleanup(func() { lockWait = old })
+	const n = 6
+	var wg sync.WaitGroup
+	errs := make(chan error, n)
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			id := "a" + string(rune('0'+i))
+			_, err := Add(Agent{ID: id, Name: id, Role: Organize, Model: "group/deepseek"})
+			errs <- err
+		}(i)
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Fatalf("an add failed: %v", err)
+		}
+	}
+	r := mustLoad(t)
+	if len(r.Agents) != 2+n {
+		t.Fatalf("agents after %d adds: %d", n, len(r.Agents))
+	}
+	for i := 0; i < n; i++ {
+		if _, ok := r.Get("a" + string(rune('0'+i))); !ok {
+			t.Fatalf("a%d lost", i)
+		}
+	}
+}
+
+// A lock another magpie holds is not written through: a change that can't
+// have it is refused, and the file is left as it was.
+func TestChangeRefusedWithoutTheLock(t *testing.T) {
+	p := tempPath(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	unlock, held := filelock.Lock(p+".lock", time.Second)
+	if !held {
+		t.Skip("this file system has no file locks")
+	}
+	defer unlock()
+	old := lockWait
+	lockWait = 0
+	t.Cleanup(func() { lockWait = old })
+	if _, err := Add(Agent{ID: "later", Name: "x", Role: Learn, Model: "m"}); err == nil {
+		t.Fatal("a change was written without the lock")
+	}
+	if b, err := os.ReadFile(p); err != nil || string(b) != string(before) {
+		t.Fatalf("the file changed: %q %v", b, err)
+	}
+}
+
+// The registry is written whole through a temp file and renamed over: a
+// reader never sees half of it. It is written 0600, which Windows reports as
+// its own default; the mode is checked where the system keeps one.
+func TestSaveIsAtomicAndPrivate(t *testing.T) {
+	p := tempPath(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	if runtime.GOOS != "windows" {
+		fi, err := os.Stat(p)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if perm := fi.Mode().Perm(); perm&0o077 != 0 {
+			t.Fatalf("the registry is readable by others: %v", perm)
+		}
+	}
+	names, err := filepath.Glob(filepath.Join(filepath.Dir(p), ".*memory-agents.json*"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(names) != 0 {
+		t.Fatalf("temp files left: %v", names)
+	}
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var r Registry
+	if err := json.Unmarshal(b, &r); err != nil || len(r.Agents) != 2 {
+		t.Fatalf("on disk: %s %v", b, err)
+	}
+}
+
+// The file's own shape is what the design says it is, so a page or a script
+// reads it as the design shows.
+func TestOnDiskShape(t *testing.T) {
+	p := tempPath(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
