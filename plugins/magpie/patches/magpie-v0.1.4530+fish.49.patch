+		t.Fatalf("status: %s", rec.Body)
+	}
+	rec = httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("GET", "/api/memory/agents/status?role=nope", nil))
+	if rec.Code != 400 {
+		t.Fatalf("an unknown role: %d", rec.Code)
