@@ -0,0 +1,42 @@
+//go:build windows
+
+package memagent
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+// A junction needs no privilege on Windows, so it is how a folder that
+// looks like a run's own would carry every write somewhere else. The run's
+// folder is refused when it is one.
+func TestQAScratchFolderIsNotALink(t *testing.T) {
+	root := scratchAt(t)
+	outside := t.TempDir()
+	if out, err := exec.Command("cmd", "/c", "mklink", "/J",
+		filepath.Join(root, "learn-1"), outside).CombinedOutput(); err != nil {
+		t.Skipf("no junction here: %v %s", err, out)
+	}
+	if _, err := NewScratch("learn-1"); err == nil {
+		t.Fatal("NewScratch took a junction for the run's folder")
+	}
+	if _, err := os.Lstat(filepath.Join(outside, "escape.md")); err == nil {
+		t.Fatal("a file was written outside the scratch folder")
+	}
+	// the root itself is checked too: a junction there carries every run
+	linked := filepath.Join(t.TempDir(), "cache", "memory-agent", "work")
+	old := ScratchRoot
+	ScratchRoot = func() string { return linked }
+	t.Cleanup(func() { ScratchRoot = old })
+	if err := os.MkdirAll(filepath.Dir(linked), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if out, err := exec.Command("cmd", "/c", "mklink", "/J", linked, outside).CombinedOutput(); err != nil {
+		t.Skipf("no junction here: %v %s", err, out)
+	}
+	if _, err := NewScratch("learn-2"); err == nil {
+		t.Fatal("a scratch root that is a junction was taken")
+	}
+}
diff --git a/internal/memagent/qa_probe_state_test.go b/internal/memagent/qa_probe_state_test.go
new file mode 100644
index 0000000..b4c66d8
--- /dev/null
+++ b/internal/memagent/qa_probe_state_test.go
@@ -0,0 +1,72 @@
+package memagent
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+// The run going's folder is named in the state the sweep reads, and let go
+// when the run ends, however it ends. A run that leaves the name behind
+// would make every later sweep protect a folder that isn't there.
+func TestQARunningScratchIsLetGoOnEveryEnding(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	cases := []struct {
+		name string
+		ask  func(context.Context, Request) (Turn, error)
+	}{
+		{"done", func(context.Context, Request) (Turn, error) { return Turn{Text: "done"}, nil }},
+		{"failed", func(context.Context, Request) (Turn, error) { return Turn{}, errFake }},
+		{"stopped", func(c context.Context, req Request) (Turn, error) {
+			Stop()
+			<-c.Done()
+			return Turn{}, c.Err()
+		}},
+	}
+	for _, c := range cases {
+		if _, err := Run(t.Context(), Task{Role: Dream, Model: "m", Prompt: "p"},
+			Options{Ask: c.ask, Vault: dir, Home: &Home{Dir: home}, RunID: "dream-" + c.name}); err != nil && c.name != "failed" && c.name != "stopped" {
+			t.Fatalf("%s: %v", c.name, err)
+		}
+		if now := RunningScratch(); now != "" {
+			t.Fatalf("%s: the run's folder is still named: %q", c.name, now)
+		}
+		// and the folder itself is gone
+		if _, err := os.Lstat(filepath.Join(ScratchRoot(), "dream-"+c.name)); err == nil {
+			t.Fatalf("%s: the run's folder is still there", c.name)
+		}
+	}
+}
+
+// Two runs of different roles in a row: the second's folder is the one the
+// sweep protects, not the first's.
+func TestQARunningScratchFollowsTheRunGoing(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	var seen []string
+	var mu sync.Mutex
+	ask := func(c context.Context, req Request) (Turn, error) {
+		mu.Lock()
+		seen = append(seen, RunningScratch())
+		mu.Unlock()
+		return Turn{Text: "done"}, nil
+	}
+	for _, role := range []string{Learn, Dream} {
+		if _, err := Run(t.Context(), Task{Role: role, Model: "m", Prompt: "p"},
+			Options{Ask: ask, Vault: dir, Home: &Home{Dir: home}, RunID: role + "-fixed"}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(seen) != 2 || seen[0] != "learn-fixed" || seen[1] != "dream-fixed" {
+		t.Fatalf("%v", seen)
+	}
+}
+
+var errFake = &fakeErr{}
+
+type fakeErr struct{}
+
+func (*fakeErr) Error() string { return "a fake failure" }
diff --git a/internal/memagent/qa_probe_stop_test.go b/internal/memagent/qa_probe_stop_test.go
new file mode 100644
index 0000000..eaa3583
--- /dev/null
+++ b/internal/memagent/qa_probe_stop_test.go
@@ -0,0 +1,39 @@
+package memagent
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+// Stop ends the run going. A run that starts after a stop must not read the
+// previous run's stop as its own: registerStop clears the flag when it binds
+// a new run, so the next run's cancellation is its own.
+func TestQAStopIsNotCarriedToTheNextRun(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	// a run stopped by the user
+	stopAt := func(c context.Context, req Request) (Turn, error) {
+		Stop()
+		<-c.Done()
+		return Turn{}, c.Err()
+	}
+	if _, err := Run(t.Context(), Task{Role: Dream, Model: "m", Prompt: "p"},
+		Options{Ask: stopAt, Vault: dir, Home: &Home{Dir: home}}); err != nil {
+		t.Fatalf("a stopped run: %v", err)
+	}
+	// the next run is ended by its own context running out, not by that
+	// stop: it must be a failure, not a stop
+	ask := func(c context.Context, req Request) (Turn, error) {
+		<-c.Done()
+		return Turn{}, c.Err()
+	}
+	_, err := Run(t.Context(), Task{Role: Dream, Model: "m", Prompt: "p"},
+		Options{Ask: ask, Vault: dir, Home: &Home{Dir: home}, Timeout: 50 * time.Millisecond})
+	if err == nil {
+		t.Fatal("a run whose time ran out ended without an error")
+	}
+	if st := StatusOf(Dream); st.Phase != PhaseFailed {
+		t.Fatalf("a run that timed out was recorded as %q", st.Phase)
+	}
+}
diff --git a/internal/memagent/qa_registry_probe2_test.go b/internal/memagent/qa_registry_probe2_test.go
new file mode 100644
index 0000000..3215e09
--- /dev/null
+++ b/internal/memagent/qa_registry_probe2_test.go
@@ -0,0 +1,246 @@
+package memagent
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// A field magpie doesn't know is not this magpie's to keep: the registry is
+// read and written as a struct, as distill.json is, so a later magpie's field
+// is dropped by an older one that saves. What must hold is the reverse: a
+// file carrying such a field still reads, and the change goes through, so a
+// downgrade doesn't refuse the file outright.
+func TestQAUnknownFieldsReadAndChangeGoes(t *testing.T) {
+	p := qaTemp(t)
+	qaWrite(t, p, `{"version":1,"futureTop":"keep me","agents":[{"id":"a","name":"x","role":"learn","model":"m","futureField":42}],"defaults":{"learn":"a"}}`)
+	r, err := Load()
+	if err != nil {
+		t.Fatalf("a file with a field magpie doesn't know was refused: %v", err)
+	}
+	if _, ok := r.Get("a"); !ok {
+		t.Fatalf("the entry didn't read: %+v", r.Agents)
+	}
+	if _, err := Add(Agent{ID: "b", Name: "y", Role: Dream, Model: "m"}); err != nil {
+		t.Fatalf("a change on a file with a field magpie doesn't know was refused: %v", err)
+	}
+	// the known entries are all there after the change
+	got, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got.Agents) != 2 {
+		t.Fatalf("agents after the change: %+v", got.Agents)
+	}
+}
+
+// A registry with no defaults at all still names an agent for every role
+// that has one, so a file written by hand works without the map.
+func TestQANoDefaultsStillRuns(t *testing.T) {
+	p := qaTemp(t)
+	qaWrite(t, p, `{"version":1,"agents":[{"id":"a","name":"x","role":"learn","model":"m"}]}`)
+	r, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a, ok := r.Default(Learn); !ok || a.ID != "a" {
+		t.Fatalf("learn: %+v ok=%v", a, ok)
+	}
+	if _, ok := r.Default(Dream); ok {
+		t.Fatal("a role with no agent had one")
+	}
+}
+
+// A change that names what is already there still writes the file: the
+// registry has no dirty check, and a write is a rename over it, so a page
+// that saves the same thing twice is two writes rather than one. This is
+// recorded, not required: magpie's other state files (distill.json) do the
+// same, and the cost is a rename.
+func TestQANoChurnOnAnUnchangedWrite(t *testing.T) {
+	p := qaTemp(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.Stat(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := SetDefault(Learn, "memory-curator"); err != nil {
+		t.Fatal(err)
+	}
+	after, err := os.Stat(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !after.ModTime().Equal(before.ModTime()) {
+		t.Logf("a change naming what is already there rewrote the file (%v then %v); distill.json writes the same way",
+			before.ModTime(), after.ModTime())
+	}
+	// what matters: the file still reads, and it says the same thing
+	r, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Defaults[Learn] != "memory-curator" {
+		t.Fatalf("learn: %q", r.Defaults[Learn])
+	}
+}
+
+// An entry's id may not be a path or a shell word: the id names a file in
+// some later code, so it is held to letters, digits, '-' and '_'.
+func TestQAIdIsSafeForAPath(t *testing.T) {
+	qaTemp(t)
+	for _, bad := range []string{"../x", "a/b", "a\\b", "a:b", "a b", "..", ".", "a\x00b"} {
+		if _, err := Add(Agent{ID: bad, Name: "x", Role: Learn, Model: "m"}); err == nil {
+			t.Errorf("id %q taken", bad)
+		}
+	}
+}
+
+// A model route with spaces around it is trimmed, and one that is only
+// spaces is refused: a page that sends a blank field doesn't save an agent
+// that can't run.
+func TestQAModelRoute(t *testing.T) {
+	qaTemp(t)
+	if _, err := Add(Agent{ID: "a", Name: "x", Role: Learn, Model: "   "}); err == nil {
+		t.Fatal("a blank model route was taken")
+	}
+	r, err := Add(Agent{ID: "b", Name: "y", Role: Learn, Model: " group/deepseek "})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a, _ := r.Get("b"); a.Model != "group/deepseek" {
+		t.Fatalf("model: %q", a.Model)
+	}
+}
+
+// A very large file is read, not cut: the registry is small, but a page that
+// saved many agents must read back whole.
+func TestQAManyAgents(t *testing.T) {
+	qaTemp(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	const n = 200
+	for i := 0; i < n; i++ {
+		id := "agent-" + strings.Repeat("x", 3) + "-" + string(rune('a'+i%26)) + "-" + string(rune('0'+i/26))
+		if _, err := Add(Agent{ID: id, Name: id, Role: Organize, Model: "m"}); err != nil {
+			t.Fatalf("%d: %v", i, err)
+		}
+	}
+	r, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(r.Agents) != 2+n {
+		t.Fatalf("agents: %d", len(r.Agents))
+	}
+}
+
+// The version on disk is this magpie's: a file written by a later magpie
+// keeps its own version, and a change doesn't quietly rewrite it down.
+func TestQAVersionNotRewritten(t *testing.T) {
+	p := qaTemp(t)
+	qaWrite(t, p, `{"version":9,"agents":[{"id":"a","name":"x","role":"learn","model":"m"}]}`)
+	if _, err := Add(Agent{ID: "b", Name: "y", Role: Dream, Model: "m"}); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got struct {
+		Version int `json:"version"`
+	}
+	if err := json.Unmarshal(b, &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.Version != 9 {
+		t.Fatalf("a later version was rewritten to %d: %s", got.Version, b)
+	}
+}
+
+// The lock file is beside the registry, not inside it: a stray entry named
+// like the lock is the user's, and the lock never appears as an agent.
+func TestQALockIsBesideNotInside(t *testing.T) {
+	p := qaTemp(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(p + ".lock"); err != nil {
+		t.Fatalf("no lock file: %v", err)
+	}
+	r, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, a := range r.Agents {
+		if strings.Contains(a.ID, ".lock") {
+			t.Fatalf("the lock is an agent: %+v", a)
+		}
+	}
+}
+
+// An agent's home (its AGENTS.md, mcp.json, skills) is the magpie agent it
+// names; an entry naming one that isn't there is still a registry, since the
+// agent list is another magpie's to know (internal/agent is not read here).
+func TestQAAgentNameIsNotCheckedHere(t *testing.T) {
+	qaTemp(t)
+	r, err := Add(Agent{ID: "a", Name: "x", Role: Learn, Model: "m", Agent: "a-agent-that-is-not-installed"})
+	if err != nil {
+		t.Fatalf("an entry naming an agent this magpie doesn't have was refused: %v", err)
+	}
+	if a, _ := r.Get("a"); a.Agent != "a-agent-that-is-not-installed" {
+		t.Fatalf("agent: %q", a.Agent)
+	}
+}
+
+// A file whose agents list is null is not a registry: it says nothing about
+// what to run, and reading it as empty would let the next change write the
+// presets over what the user meant.
+func TestQANullAgentsList(t *testing.T) {
+	p := qaTemp(t)
+	qaWrite(t, p, `{"version":1,"agents":null}`)
+	if _, err := Load(); err == nil {
+		t.Fatal("a null agents list read as a registry")
+	}
+}
+
+// The backup written before a change is the file as it was, byte for byte:
+// a reader that falls back to it gets what the user had, not a re-marshal.
+func TestQABackupIsByteForByte(t *testing.T) {
+	p := qaTemp(t)
+	hand := `{"version":1,"agents":[{"id":"a","name":"x","role":"learn","model":"m"}]}`
+	qaWrite(t, p, hand)
+	if _, err := Add(Agent{ID: "b", Name: "y", Role: Dream, Model: "m"}); err != nil {
+		t.Fatal(err)
+	}
+	bak, err := os.ReadFile(p + ".bak")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(bak) != hand {
+		t.Fatalf(".bak isn't the file as it was:\n got %s\nwant %s", bak, hand)
+	}
+}
+
+// A directory where the registry goes is unreadable, and a change over it
+// says so rather than writing into the folder.
+func TestQADirectoryInTheWay(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "memory-agents.json")
+	if err := os.MkdirAll(p, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	old := Path
+	Path = func() string { return p }
+	t.Cleanup(func() { Path = old })
+	if _, err := Load(); err == nil {
+		t.Fatal("a folder read as a registry")
+	}
+	if _, err := Add(Agent{ID: "a", Name: "x", Role: Learn, Model: "m"}); err == nil {
+		t.Fatal("a change was written into a folder")
+	}
+}
diff --git a/internal/memagent/qa_registry_probe3_test.go b/internal/memagent/qa_registry_probe3_test.go
new file mode 100644
index 0000000..bd18a19
--- /dev/null
+++ b/internal/memagent/qa_registry_probe3_test.go
@@ -0,0 +1,45 @@
+package memagent
+
+import (
+	"testing"
+)
+
+// The role-taking readers (HasRole, ForRole, Default) and the role-taking
+// writers (rolesOf, SetDefault) must agree on what a role is: a page that
+// sends "Learn" to one and "learn" to the other is the same role, or one of
+// them silently does nothing.
+func TestQARoleReadersAgreeWithWriters(t *testing.T) {
+	// rolesOf lower-cases and trims; these readers take the same spellings
+	norm, err := rolesOf(" Learn ")
+	if err != nil || norm != Learn {
+		t.Fatalf("rolesOf: %q %v", norm, err)
+	}
+	a := Agent{Role: Learn + "|" + Organize}
+	for _, spelling := range []string{"learn", " Learn ", "LEARN"} {
+		if !a.HasRole(spelling) {
+			t.Errorf("HasRole(%q) = false, but rolesOf takes that spelling", spelling)
+		}
+	}
+	r := Builtin()
+	for _, spelling := range []string{"learn", " Learn ", "LEARN"} {
+		if len(r.ForRole(spelling)) == 0 {
+			t.Errorf("ForRole(%q) = none, but rolesOf takes that spelling", spelling)
+		}
+		if _, ok := r.Default(spelling); !ok {
+			t.Errorf("Default(%q) = none, but rolesOf takes that spelling", spelling)
+		}
+	}
+}
+
+// A run's role is lower-cased by the caller (dispatch.go does it), so a
+// registry entry's role is the lower-case form: the readers are not the
+// place that decides case.
+func TestQARegistryRolesAreLowerCase(t *testing.T) {
+	for _, a := range Builtin().Agents {
+		for _, r := range a.RoleSet() {
+			if r != Learn && r != Organize && r != Dream {
+				t.Fatalf("%q has %q", a.ID, r)
+			}
+		}
+	}
+}
diff --git a/internal/memagent/qa_registry_probe4_test.go b/internal/memagent/qa_registry_probe4_test.go
new file mode 100644
index 0000000..038205d
--- /dev/null
+++ b/internal/memagent/qa_registry_probe4_test.go
@@ -0,0 +1,24 @@
+package memagent
+
+import (
+	"testing"
+)
+
+// An agent with no role carries nothing out: a hand-built Agent (a page's
+// half-filled form, a test fixture) must not claim the empty role.
+func TestQAEmptyRoleCarriesNothing(t *testing.T) {
+	var a Agent
+	if a.HasRole("") {
+		t.Fatal("an agent with no role carries out the empty role")
+	}
+	if got := a.RoleSet(); len(got) != 0 {
+		t.Fatalf("RoleSet: %q", got)
+	}
+	r := Registry{Agents: []Agent{{ID: "x"}, {ID: "y", Role: Learn}}}
+	if got := r.ForRole(""); len(got) != 0 {
+		t.Fatalf("ForRole(\"\") = %+v", got)
+	}
+	if _, ok := r.Default(""); ok {
+		t.Fatal("Default(\"\") named an agent")
+	}
+}
diff --git a/internal/memagent/qa_registry_probe_test.go b/internal/memagent/qa_registry_probe_test.go
new file mode 100644
index 0000000..f9eeefc
--- /dev/null
+++ b/internal/memagent/qa_registry_probe_test.go
@@ -0,0 +1,310 @@
+package memagent
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// qaTemp points the registry at a folder of this test's own.
+func qaTemp(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	old := Path
+	Path = func() string { return filepath.Join(dir, "memory-agents.json") }
+	t.Cleanup(func() { Path = old })
+	return Path()
+}
+
+func qaWrite(t *testing.T, p, b string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte(b), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// A file edited in a Windows editor may carry a UTF-8 BOM. magpie's other
+// readers strip it before parsing (settings.go, lastgood.JSON); the registry
+// must read such a file rather than call it unreadable.
+func TestQAByteOrderMarkIsRead(t *testing.T) {
+	p := qaTemp(t)
+	qaWrite(t, p, "\xef\xbb\xbf"+`{"version":1,"agents":[{"id":"a","name":"x","role":"learn","model":"m"}]}`)
+	r, err := Load()
+	if err != nil {
+		t.Fatalf("a file with a BOM didn't read: %v", err)
+	}
+	if _, ok := r.Get("a"); !ok {
+		t.Fatalf("agents: %+v", r.Agents)
+	}
+}
+
+// The registry is written by magpie alone, but a change must not lose a
+// hand-written file that is valid: it is kept as the last good generation
+// before the change is written.
+func TestQAKeepOfValidFile(t *testing.T) {
+	p := qaTemp(t)
+	qaWrite(t, p, `{"version":1,"agents":[{"id":"mine","name":"我的","role":"dream","model":"m"}]}`)
+	if _, err := Add(Agent{ID: "b", Name: "y", Role: Learn, Model: "m"}); err != nil {
+		t.Fatal(err)
+	}
+	bak, err := os.ReadFile(p + ".bak")
+	if err != nil {
+		t.Fatalf("no last good generation: %v", err)
+	}
+	if !strings.Contains(string(bak), "mine") || strings.Contains(string(bak), `"id": "b"`) {
+		t.Fatalf(".bak isn't what was there: %s", bak)
+	}
+}
+
+// A reader that never took the lock sees either the old file or the new one,
+// never half of one: the write is a rename over it.
+func TestQAReaderNeverSeesHalf(t *testing.T) {
+	p := qaTemp(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	old := lockWait
+	lockWait = 30 * time.Second
+	t.Cleanup(func() { lockWait = old })
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	bad := make(chan string, 8)
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			b, err := os.ReadFile(p)
+			if err != nil {
+				continue
+			}
+			var r Registry
+			if err := json.Unmarshal(b, &r); err != nil {
+				select {
+				case bad <- string(b):
+				default:
+				}
+				return
+			}
+		}
+	}()
+	for i := 0; i < 40; i++ {
+		if _, err := Add(Agent{ID: "a" + string(rune('a'+i%26)) + string(rune('0'+i/26)), Name: "x", Role: Organize, Model: "m"}); err != nil {
+			close(stop)
+			wg.Wait()
+			t.Fatalf("add %d: %v", i, err)
+		}
+	}
+	close(stop)
+	wg.Wait()
+	select {
+	case b := <-bad:
+		t.Fatalf("a reader saw half a file: %s", b)
+	default:
+	}
+}
+
+// Two changes at once both land: each takes the lock, reads afresh, writes
+// whole. The registry is never left with one change overwriting the other.
+func TestQAParallelChangesBothLand(t *testing.T) {
+	p := qaTemp(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	old := lockWait
+	lockWait = 30 * time.Second
+	t.Cleanup(func() { lockWait = old })
+	var wg sync.WaitGroup
+	errs := make(chan error, 4)
+	wg.Add(4)
+	go func() {
+		defer wg.Done()
+		_, err := Add(Agent{ID: "one", Name: "一", Role: Organize, Model: "m"})
+		errs <- err
+	}()
+	go func() {
+		defer wg.Done()
+		_, err := Add(Agent{ID: "two", Name: "二", Role: Organize, Model: "m"})
+		errs <- err
+	}()
+	go func() {
+		defer wg.Done()
+		_, err := SetDefault(Dream, "dreamer")
+		errs <- err
+	}()
+	go func() {
+		defer wg.Done()
+		_, err := Update(Agent{ID: "dreamer", Name: "做梦 Agent", Role: Dream, Model: "group/qwen-mp"})
+		errs <- err
+	}()
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Fatalf("a change failed: %v", err)
+		}
+	}
+	r, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := r.Get("one"); !ok {
+		t.Fatalf("one lost: %+v", r.Agents)
+	}
+	if _, ok := r.Get("two"); !ok {
+		t.Fatalf("two lost: %+v", r.Agents)
+	}
+	if a, _ := r.Get("dreamer"); a.Model != "group/qwen-mp" {
+		t.Fatalf("the update lost: %+v", a)
+	}
+	if r.Defaults[Dream] != "dreamer" {
+		t.Fatalf("dream default: %q", r.Defaults[Dream])
+	}
+	_ = p
+}
+
+// A change on a file that can't be read is refused and leaves the file and
+// any .bak alone: nothing is written over what magpie couldn't understand.
+func TestQAChangeOverBadFileWritesNothing(t *testing.T) {
+	p := qaTemp(t)
+	qaWrite(t, p, `{"version":1,"agents":[{"id":"a","name":"x","role":"nope","model":"m"}]}`)
+	before, _ := os.ReadFile(p)
+	if _, err := Add(Agent{ID: "b", Name: "y", Role: Learn, Model: "m"}); err == nil {
+		t.Fatal("a change was made over an unreadable file")
+	}
+	after, _ := os.ReadFile(p)
+	if string(before) != string(after) {
+		t.Fatalf("the file changed: %s", after)
+	}
+	if _, err := os.Stat(p + ".bak"); !os.IsNotExist(err) {
+		t.Fatalf("a .bak was written: %v", err)
+	}
+	if kept, _ := filepath.Glob(p + ".bad-*"); len(kept) != 0 {
+		t.Fatalf("the file was copied aside for a change that didn't happen: %v", kept)
+	}
+}
+
+// An agent id is what a page and a script name an entry by: two entries
+// whose ids differ only in case are two entries, and each is reachable.
+func TestQAIdsDifferingInCaseAreDistinct(t *testing.T) {
+	qaTemp(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Add(Agent{ID: "Night", Name: "夜", Role: Organize, Model: "m"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Add(Agent{ID: "night", Name: "夜 2", Role: Organize, Model: "m"}); err != nil {
+		t.Fatal(err)
+	}
+	r, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a, ok := r.Get("Night"); !ok || a.Name != "夜" {
+		t.Fatalf("Night: %+v ok=%v", a, ok)
+	}
+	if a, ok := r.Get("night"); !ok || a.Name != "夜 2" {
+		t.Fatalf("night: %+v ok=%v", a, ok)
+	}
+}
+
+// An entry whose scopes are all blanks keeps none, and one with a good scope
+// beside a blank keeps the good one: a page sending a half-filled form works.
+func TestQAScopesBlankTolerant(t *testing.T) {
+	qaTemp(t)
+	r, err := Add(Agent{ID: "a", Name: "x", Role: Learn, Model: "m", Scopes: []string{"", "  ", "global", " ", "project:k"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, _ := r.Get("a")
+	if len(a.Scopes) != 2 || a.Scopes[0] != "global" || a.Scopes[1] != "project:k" {
+		t.Fatalf("scopes: %q", a.Scopes)
+	}
+	r, err = Add(Agent{ID: "b", Name: "y", Role: Learn, Model: "m", Scopes: []string{"", " "}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, _ := r.Get("b")
+	if len(b.Scopes) != 0 {
+		t.Fatalf("blanks kept: %q", b.Scopes)
+	}
+}
+
+// An agent's own schedule and effort are kept as typed, trimmed; a schedule
+// the design doesn't use yet is kept rather than refused, so a page can save
+// one before the scheduler reads it.
+func TestQAScheduleKept(t *testing.T) {
+	qaTemp(t)
+	r, err := Add(Agent{ID: "a", Name: "x", Role: Learn, Model: "m", Schedule: "  weekly 周一 09:00 ", Effort: " XHIGH "})
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, _ := r.Get("a")
+	if a.Schedule != "weekly 周一 09:00" {
+		t.Fatalf("schedule: %q", a.Schedule)
+	}
+	if a.Effort != "xhigh" {
+		t.Fatalf("effort: %q", a.Effort)
+	}
+}
+
+// A role's name in another case is the same role: a page that sends "Learn"
+// binds learn, not a role memory doesn't have.
+func TestQARoleCaseInsensitive(t *testing.T) {
+	qaTemp(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	r, err := SetDefault(" LEARN ", "memory-curator")
+	if err != nil {
+		t.Fatalf("a role in another case was refused: %v", err)
+	}
+	if r.Defaults[Learn] != "memory-curator" {
+		t.Fatalf("learn: %q", r.Defaults[Learn])
+	}
+	if _, err := Add(Agent{ID: "b", Name: "y", Role: "DREAM", Model: "m"}); err != nil {
+		t.Fatalf("an upper-case role was refused: %v", err)
+	}
+}
+
+// The file magpie writes reads back as itself: what a page sends is what the
+// next read gives, with nothing dropped or reordered.
+func TestQARoundTrip(t *testing.T) {
+	p := qaTemp(t)
+	in := Agent{ID: "round", Name: "往返", Agent: "memory-agent", Role: Organize, Model: "group/deepseek",
+		Effort: "high", Schedule: "daily 22:00", Scopes: []string{"global", "project:*"}}
+	if _, err := Add(in); err != nil {
+		t.Fatal(err)
+	}
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var r Registry
+	if err := json.Unmarshal(b, &r); err != nil {
+		t.Fatal(err)
+	}
+	got, ok := r.Get("round")
+	if !ok {
+		t.Fatalf("missing: %s", b)
+	}
+	if got.Name != in.Name || got.Role != in.Role || got.Model != in.Model || got.Effort != in.Effort ||
+		got.Schedule != in.Schedule || len(got.Scopes) != 2 || got.Scopes[0] != "global" {
+		t.Fatalf("round trip: %+v", got)
+	}
+	if got.Builtin {
+		t.Fatalf("an added agent is a preset: %+v", got)
+	}
+}
diff --git a/internal/memagent/registry.go b/internal/memagent/registry.go
new file mode 100644
index 0000000..d97bf4c
--- /dev/null
+++ b/internal/memagent/registry.go
@@ -0,0 +1,612 @@
+// Package memagent is the memory-maintenance agent: the roles that read
+// conversations into memory (learn), tidy memory and inspirations each
+// night (organize) and dream across them (dream), and the registry saying
+// which magpie agent, model route and schedule carry out each.
+//
+// A registry entry names a magpie agent (internal/agent): that agent's
+// AGENTS.md is the prompt the built-in executor runs with, and its mcp.json
+// and skills are the tools it may use. The model is an internal route and is
+// never shown in the learn/organize dropdown (the user picks an agent, not
+// a model).
+package memagent
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/filelock"
+	"github.com/yetone/magpie/internal/lastgood"
+	"github.com/yetone/magpie/internal/steady"
+)
+
+// The roles a memory agent carries out.
+const (
+	Learn    = "learn"    // read finished conversations into candidate memories
+	Organize = "organize" // tidy memory and inspirations each night
+	Dream    = "dream"    // cross-domain associations into dreams
+)
+
+// Roles are the roles, in the order a registry lists them.
+var Roles = []string{Learn, Organize, Dream}
+
+// DefaultAgent is the magpie agent (internal/agent) a role's memory agent
+// runs as when the entry names none: its AGENTS.md, mcp.json and skills.
+const DefaultAgent = "memory-agent"
+
+// Version is the registry's schema version.
+const Version = 1
+
+// Agent is one role's binding to a magpie agent, a model route and a schedule.
+type Agent struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	// Agent is the magpie agent this runs as (its AGENTS.md is the prompt,
+	// its mcp.json and skills the tools). "" means DefaultAgent.
+	Agent string `json:"agent,omitempty"`
+	// Role is what it does: one of Roles, or several separated by "|"
+	// ("learn|organize"), as the design keeps one agent for both.
+	Role string `json:"role"`
+	// Model is the internal route (a routing group such as group/deepseek or
+	// a model id). It is never shown in the learn/organize dropdown.
+	Model    string   `json:"model"`
+	Effort   string   `json:"effort,omitempty"`
+	Schedule string   `json:"schedule,omitempty"`
+	Scopes   []string `json:"scopes,omitempty"`
+	Builtin  bool     `json:"builtin,omitempty"`
+}
+
+// RoleSet is the roles an agent carries out, in Roles' order: "learn" is one,
+// "learn|organize" two. An empty or unknown role gives none.
+func (a Agent) RoleSet() []string {
+	var out []string
+	for _, role := range Roles {
+		if a.HasRole(role) {
+			out = append(out, role)
+		}
+	}
+	return out
+}
+
+// HasRole reports whether the agent carries out role, in the spellings a
+// page and a run use: a role's own case and spaces are ignored, as rolesOf
+// normalizes them when an entry is saved (a page sending " Learn " binds
+// learn, not a role memory doesn't have). The empty role is no role.
+func (a Agent) HasRole(role string) bool {
+	role = strings.ToLower(strings.TrimSpace(role))
+	if role == "" {
+		return false
+	}
+	for _, r := range strings.Split(a.Role, "|") {
+		if strings.TrimSpace(r) == role {
+			return true
+		}
+	}
+	return false
+}
+
+// rolesOf normalizes a role field: lower-case, trimmed, each one of Roles,
+// repeats dropped, joined with "|" in Roles' order.
+func rolesOf(s string) (string, error) {
+	var got []string
+	for _, r := range strings.Split(s, "|") {
+		r = strings.ToLower(strings.TrimSpace(r))
+		if r == "" {
+			continue
+		}
+		if !slices.Contains(Roles, r) {
+			return "", fmt.Errorf("role %q isn't one of %s", r, strings.Join(Roles, ", "))
+		}
+		if !slices.Contains(got, r) {
+			got = append(got, r)
+		}
+	}
+	if len(got) == 0 {
+		return "", fmt.Errorf("it needs a role, one of %s", strings.Join(Roles, ", "))
+	}
+	slices.SortFunc(got, func(a, b string) int { return slices.Index(Roles, a) - slices.Index(Roles, b) })
+	return strings.Join(got, "|"), nil
+}
+
+// Registry is memory-agents.json.
+type Registry struct {
+	Version  int               `json:"version"`
+	Agents   []Agent           `json:"agents"`
+	Defaults map[string]string `json:"defaults,omitempty"`
+}
+
+// Path is memory-agents.json; a variable for tests.
+var Path = func() string { return appdir.Join(appdir.Config(), "memory-agents.json") }
+
+// lockWait is how long a change waits for another magpie to let go of the
+// registry before it gives up; a variable so a test needn't wait it out.
+var lockWait = 10 * time.Second
+
+// Builtin returns the two presets a new registry starts with: one agent for
+// learn and organize, one for dream, both on the built-in memory-agent. The
+// design's shape: memory-curator carries both, dreamer the third.
+func Builtin() Registry {
+	return Registry{
+		Version: Version,
+		Agents: []Agent{
+			{
+				ID: "memory-curator", Name: "记忆整理 Agent", Agent: DefaultAgent,
+				Role: Learn + "|" + Organize, Model: "group/deepseek", Effort: "high",
+				Schedule: "daily 22:00", Scopes: []string{"global", "project:*"}, Builtin: true,
+			},
+			{
+				ID: "dreamer", Name: "做梦 Agent", Agent: DefaultAgent,
+				Role: Dream, Model: "group/deepseek", Effort: "high",
+				Schedule: "daily 03:00", Scopes: []string{"global", "project:*"}, Builtin: true,
+			},
+		},
+		Defaults: map[string]string{
+			Learn: "memory-curator", Organize: "memory-curator", Dream: "dreamer",
+		},
+	}
+}
+
+// parse reads memory-agents.json's bytes: JSON holding an agents list whose
+// every entry is one magpie can run. A file that isn't one is never read as
+// the presets, never written over before a copy of it is kept, and reads back
+// from its last good generation when there is one.
+//
+// A UTF-8 byte order mark is stripped first: an editor on Windows writes one,
+// and magpie's other readers take it the same way (settings.go, lastgood.JSON),
+// so a file the user edited by hand isn't called unreadable for it.
+func parse(b []byte) (Registry, error) {
+	var r Registry
+	if err := json.Unmarshal(bytes.TrimPrefix(b, []byte("\xef\xbb\xbf")), &r); err != nil {
+		return r, err
+	}
+	if err := validate(&r); err != nil {
+		return r, err
+	}
+	return r, nil
+}
+
+// valid is lastgood's test of memory-agents.json.
+func valid(b []byte) bool {
+	_, err := parse(b)
+	return err == nil
+}
+
+// Load reads memory-agents.json and merges dynamically discovered Obsidian
+// vault agent workspaces (.obsidian/magpie-agent/agent.json).
+func Load() (Registry, error) {
+	return LoadFor()
+}
+
+// LoadFor reads memory-agents.json and overlays Obsidian vault agent workspaces
+// discovered from the active vault plus extraVaults.
+func LoadFor(extraVaults ...string) (Registry, error) {
+	r, err := loadDisk()
+	if err != nil {
+		return Registry{}, err
+	}
+	return overlayObsidianWorkspaces(r, extraVaults...), nil
+}
+
+func loadDisk() (Registry, error) {
+	p := Path()
+	b, err := lastgood.Read(p, valid)
+	if errors.Is(err, os.ErrNotExist) {
+		return Builtin(), nil
+	}
+	if err != nil {
+		return Registry{}, err
+	}
+	r, err := parse(b)
+	if err != nil {
+		return Registry{}, fmt.Errorf("%s: %w", p, err)
+	}
+	return r, nil
+}
+
+func overlayObsidianWorkspaces(r Registry, extraVaults ...string) Registry {
+	wss := DiscoverObsidianWorkspaces(extraVaults...)
+	if len(wss) == 0 {
+		return r
+	}
+	byID := make(map[string]int, len(r.Agents))
+	for i := range r.Agents {
+		byID[r.Agents[i].ID] = i
+	}
+	var prepend []Agent
+	for _, ws := range wss {
+		entry := ws.Config.asRegistryAgent()
+		entry.ID = ws.ID
+		entry.Agent = ws.ID
+		if idx, ok := byID[ws.ID]; ok {
+			existing := r.Agents[idx]
+			existing.Name = entry.Name
+			existing.Role = entry.Role
+			existing.Model = entry.Model
+			existing.Agent = entry.Agent
+			r.Agents[idx] = existing
+			continue
+		}
+		prepend = append(prepend, entry)
+	}
+	if len(prepend) > 0 {
+		r.Agents = append(prepend, r.Agents...)
+	}
+	return r
+}
+
+// Ensure writes the built-in presets when memory-agents.json isn't there yet,
+// so the GUI and CLI start from two agents. An existing (even unreadable)
+// file is left as it is.
+func Ensure() error {
+	// a file there (readable or not) is the user's: neither the presets nor a
+	// change is written over it
+	_, err := os.Lstat(Path())
+	if err == nil || !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	// made under the lock: two magpies starting together make one file, and
+	// the one that comes second keeps what the first wrote
+	_, err = change(func(*Registry) error { return nil })
+	return err
+}
+
+// validate checks a registry read from disk, filling in what an entry may
+// leave out (the schema version, the magpie agent). No agents list at all,
+// two entries with one id, a role memory doesn't have, or an entry without
+// the id, name or model route it needs is an error: what the file says can't
+// be run, so it is unknown rather than emptied. An empty list is a registry
+// the user emptied, and reads.
+func validate(r *Registry) error {
+	if r.Version == 0 {
+		r.Version = Version
+	}
+	if r.Agents == nil {
+		return errors.New("it holds no agents list")
+	}
+	seen := make(map[string]bool, len(r.Agents))
+	for i := range r.Agents {
+		a := &r.Agents[i]
+		if err := clean(a); err != nil {
+			return err
+		}
+		if seen[a.ID] {
+			return fmt.Errorf("two memory agents have the id %q", a.ID)
+		}
+		seen[a.ID] = true
+	}
+	// a default naming a role this magpie doesn't know is left as it is: it
+	// is a hint for a role a later magpie may have, and ignoring it runs
+	// every role this one knows. An agent of an unknown role is an error
+	// above, since what it would do here is unknown too.
+	return nil
+}
+
+// Restore adds back the built-in presets that are gone, leaving every agent
+// the user kept or changed as it is, and fills a role's default when nothing
+// names one.
+func Restore() (Registry, error) {
+	return change(func(r *Registry) error {
+		for _, b := range Builtin().Agents {
+			if _, ok := r.Get(b.ID); ok {
+				continue
+			}
+			r.Agents = append(r.Agents, b)
+		}
+		fillDefaults(r)
+		return nil
+	})
+}
+
+// save writes the registry whole: the file there now is kept as the last good
+// generation first (or copied aside when it doesn't read), then the new one is
+// written through a temp file, flushed and renamed over it.
+func save(r Registry) error {
+	b, err := json.MarshalIndent(r, "", "  ")
+	if err != nil {
+		return err
+	}
+	p := Path()
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		return err
+	}
+	if err := lastgood.Keep(p, valid, 0o600); err != nil {
+		return err
+	}
+	return steady.WriteFile(p, b, 0o600)
+}
+
+// change applies fn to memory-agents.json under its lock and writes it.
+func change(fn func(*Registry) error) (Registry, error) {
+	unlock, held := filelock.Lock(Path()+".lock", lockWait)
+	if !held {
+		return Registry{}, errors.New("memory-agents.json is held by another magpie")
+	}
+	defer unlock()
+	r, err := loadDisk()
+	if err != nil {
+		return r, err
+	}
+	if err := fn(&r); err != nil {
+		return r, err
+	}
+	return r, save(r)
+}
+
+// clean checks one entry and fills in what it may leave out.
+func clean(a *Agent) error {
+	a.ID = strings.TrimSpace(a.ID)
+	a.Name = strings.TrimSpace(a.Name)
+	a.Agent = strings.TrimSpace(a.Agent)
+	a.Model = strings.TrimSpace(a.Model)
+	a.Effort = strings.ToLower(strings.TrimSpace(a.Effort))
+	a.Schedule = strings.TrimSpace(a.Schedule)
+	role, err := rolesOf(a.Role)
+	if err != nil {
+		return fmt.Errorf("memory agent %q: %w", a.ID, err)
+	}
+	a.Role = role
+	switch {
+	case a.ID == "":
+		return errors.New("a memory agent needs an id")
+	case !idPattern(a.ID):
+		return fmt.Errorf("id %q isn't letters, digits, '-' or '_' (up to 40)", a.ID)
+	case a.Name == "":
+		return fmt.Errorf("memory agent %q needs a name", a.ID)
+	case a.Model == "":
+		return fmt.Errorf("memory agent %q needs a model route", a.ID)
+	}
+	if a.Agent == "" {
+		a.Agent = DefaultAgent
+	}
+	scopes, err := cleanScopes(a.Scopes)
+	if err != nil {
+		return fmt.Errorf("memory agent %q: %w", a.ID, err)
+	}
+	a.Scopes = scopes
+	return nil
+}
+
+// cleanScopes trims the scopes, drops repeats and refuses one memory has no
+// place for: global, project:<key> (or project:*, every project) and
+// agent:<id>.
+func cleanScopes(in []string) ([]string, error) {
+	var out []string
+	for _, s := range in {
+		s = strings.TrimSpace(s)
+		if s == "" {
+			continue
+		}
+		if !scopeOK(s) {
+			return nil, fmt.Errorf("scope %q isn't global, project:<key> or agent:<id>", s)
+		}
+		if !slices.Contains(out, s) {
+			out = append(out, s)
+		}
+	}
+	return out, nil
+}
+
+// scopeOK reports whether s is a scope memory keeps a memory under.
+func scopeOK(s string) bool {
+	if s == "global" {
+		return true
+	}
+	for _, prefix := range []string{"project:", "agent:"} {
+		if rest, ok := strings.CutPrefix(s, prefix); ok {
+			return rest != ""
+		}
+	}
+	return false
+}
+
+// idPattern reports whether s is a usable memory agent id.
+func idPattern(s string) bool {
+	if len(s) == 0 || len(s) > 40 {
+		return false
+	}
+	for _, r := range s {
+		if !(r == '-' || r == '_' || r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9') {
+			return false
+		}
+	}
+	return true
+}
+
+// ForRole returns the agents that carry out one role, in the order they are
+// kept: an agent doing learn and organize is in both lists.
+func (r Registry) ForRole(role string) []Agent {
+	var out []Agent
+	for _, a := range r.Agents {
+		if a.HasRole(role) {
+			out = append(out, a)
+		}
+	}
+	return out
+}
+
+// Get is the agent with id.
+func (r Registry) Get(id string) (Agent, bool) {
+	for _, a := range r.Agents {
+		if a.ID == id {
+			return a, true
+		}
+	}
+	return Agent{}, false
+}
+
+// Default is the agent a role runs as: the one its defaults name, else the
+// first that carries the role out, else none. ok is false when the role has
+// no agent.
+func (r Registry) Default(role string) (Agent, bool) {
+	if id := r.Defaults[role]; id != "" {
+		if a, ok := r.Get(id); ok && a.HasRole(role) {
+			return a, true
+		}
+	}
+	if cs := r.ForRole(role); len(cs) > 0 {
+		return cs[0], true
+	}
+	return Agent{}, false
+}
+
+// fillDefaults names a default for every role that has an agent and none
+// named, the role's first one; a default that names no agent carrying its
+// role out is moved to one, or dropped when the role has none.
+func fillDefaults(r *Registry) {
+	if r.Defaults == nil {
+		r.Defaults = map[string]string{}
+	}
+	for role, id := range r.Defaults {
+		if !slices.Contains(Roles, role) {
+			continue // a role a later magpie may have: left as it is
+		}
+		if a, ok := r.Get(id); !ok || !a.HasRole(role) {
+			dropDefault(r, role, id)
+		}
+	}
+	for _, role := range Roles {
+		if r.Defaults[role] == "" {
+			if cs := r.ForRole(role); len(cs) > 0 {
+				r.Defaults[role] = cs[0].ID
+			}
+		}
+	}
+}
+
+// dropDefault takes id out of a role's default: another agent carrying that
+// role out takes its place, or the role has no default.
+func dropDefault(r *Registry, role, id string) {
+	if r.Defaults[role] != id {
+		return
+	}
+	if alt, ok := firstOther(r, role, id); ok {
+		r.Defaults[role] = alt
+		return
+	}
+	delete(r.Defaults, role)
+}
+
+// Add appends a new agent; an id already there is an error.
+func Add(a Agent) (Registry, error) {
+	if err := clean(&a); err != nil {
+		return Registry{}, err
+	}
+	a.Builtin = false // the presets' mark is the presets'
+	return change(func(r *Registry) error {
+		if _, ok := r.Get(a.ID); ok {
+			return fmt.Errorf("a memory agent with id %q is already there", a.ID)
+		}
+		r.Agents = append(r.Agents, a)
+		if r.Defaults == nil {
+			r.Defaults = map[string]string{}
+		}
+		for _, role := range a.RoleSet() {
+			if r.Defaults[role] == "" {
+				r.Defaults[role] = a.ID
+			}
+		}
+		return nil
+	})
+}
+
+// Update replaces the agent with a.ID; an id not there is an error. A preset
+// stays a preset, and a role the agent no longer carries out names another
+// that does, or none.
+func Update(a Agent) (Registry, error) {
+	if err := clean(&a); err != nil {
+		return Registry{}, err
+	}
+	return change(func(r *Registry) error {
+		for i := range r.Agents {
+			if r.Agents[i].ID != a.ID {
+				continue
+			}
+			old := r.Agents[i]
+			a.Builtin = old.Builtin
+			r.Agents[i] = a
+			for _, role := range old.RoleSet() {
+				if !a.HasRole(role) {
+					dropDefault(r, role, a.ID)
+				}
+			}
+			if r.Defaults == nil {
+				r.Defaults = map[string]string{}
+			}
+			for _, role := range a.RoleSet() {
+				if r.Defaults[role] == "" {
+					r.Defaults[role] = a.ID
+				}
+			}
+			return nil
+		}
+		return fmt.Errorf("no memory agent with id %q", a.ID)
+	})
+}
+
+// Remove deletes the agent with id, unless a role's default names it; a
+// built-in preset may be removed too, since the user's own choice stands
+// (Restore brings the presets back).
+func Remove(id string) (Registry, error) {
+	return change(func(r *Registry) error {
+		a, ok := r.Get(id)
+		if !ok {
+			return fmt.Errorf("no memory agent with id %q", id)
+		}
+		for _, role := range a.RoleSet() {
+			dropDefault(r, role, id)
+		}
+		r.Agents = slices.DeleteFunc(r.Agents, func(a Agent) bool { return a.ID == id })
+		return nil
+	})
+}
+
+// firstOther is the id of an agent carrying role out other than skip, if
+// there is one.
+func firstOther(r *Registry, role, skip string) (string, bool) {
+	for _, a := range r.Agents {
+		if a.ID != skip && a.HasRole(role) {
+			return a.ID, true
+		}
+	}
+	return "", false
+}
+
+// SetDefault binds a role to an agent that carries it out.
+func SetDefault(role, id string) (Registry, error) {
+	role = strings.ToLower(strings.TrimSpace(role))
+	if !slices.Contains(Roles, role) {
+		return Registry{}, fmt.Errorf("role %q isn't one of %s", role, strings.Join(Roles, ", "))
+	}
+	r, err := change(func(r *Registry) error {
+		a, ok := r.Get(id)
+		if !ok {
+			if ws, found := FindObsidianWorkspace(id); found {
+				a = ws.Config.asRegistryAgent()
+				a.ID = ws.ID
+				ok = true
+			}
+		}
+		if !ok {
+			return fmt.Errorf("no memory agent with id %q", id)
+		}
+		if !a.HasRole(role) {
+			return fmt.Errorf("memory agent %q does %s, not %s", id, a.Role, role)
+		}
+		if r.Defaults == nil {
+			r.Defaults = map[string]string{}
+		}
+		r.Defaults[role] = id
+		return nil
+	})
+	if err != nil {
+		return r, err
+	}
+	return overlayObsidianWorkspaces(r), nil
+}
