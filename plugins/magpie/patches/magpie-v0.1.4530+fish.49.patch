@@ -0,0 +1,125 @@
+package memagent
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/memory"
+)
+
+// callTool runs one of a run's tools by name, as a model's call does.
+func callTool(t *testing.T, sb *Sandbox, role, name string, args map[string]any) (string, error) {
+	t.Helper()
+	set, err := toolsFor(sb, nil, role, &runLog{}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tool, ok := set.Get(name)
+	if !ok {
+		t.Fatalf("no %s", name)
+	}
+	b, _ := json.Marshal(args)
+	return tool.Call(context.Background(), b)
+}
+
+// The changes that aren't a run's own save are audited too: a removal, a
+// promotion and a status each leave their line.
+func TestAuditOfRemovePromoteStatus(t *testing.T) {
+	auditAt(t)
+	sb, _ := openVault(t)
+	// two of the machine's own, and one the user wrote
+	mine, _, err := memory.Save(memory.Input{Text: p("Tests run on the box"), Kind: p("fact"), Scope: p("global")}, memory.FromAgent, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	theirs, _, err := memory.Save(memory.Input{Text: p("I write in Chinese"), Kind: p("preference"), Scope: p("global")}, memory.FromUser, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	out, err := callTool(t, sb, Learn, ToolMemoryRemove, map[string]any{"ids": []string{mine.ID, theirs.ID}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out, "Removed: "+mine.ID) || !strings.Contains(out, "kept, they are the user's own: "+theirs.ID) {
+		t.Fatalf("%q", out)
+	}
+	// the user's is still there, and the refusal is in the conflict log
+	if _, err := memory.Get(theirs.ID); err != nil {
+		t.Fatalf("the user's memory was removed: %v", err)
+	}
+	if _, err := memory.Get(mine.ID); err == nil {
+		t.Fatal("the machine's memory wasn't removed")
+	}
+
+	// a candidate set aside, and a promotion
+	cand, _, err := memory.Save(memory.Input{Text: p("Nightly tidy runs at three"), Scope: p("agent:" + AgentID), Status: p(memory.Candidate)}, memory.FromAgent, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out, err := callTool(t, sb, Organize, ToolMemoryStatus, map[string]any{"status": memory.Archived, "ids": []string{cand.ID}}); err != nil || !strings.Contains(out, "archived") {
+		t.Fatalf("%q %v", out, err)
+	}
+	// the user's own isn't a machine's to take out of use
+	if _, err := callTool(t, sb, Organize, ToolMemoryStatus, map[string]any{"status": memory.Archived, "ids": []string{theirs.ID}}); err == nil {
+		t.Fatal("a machine set the user's memory aside")
+	}
+
+	got := lines(t, AuditPath())
+	seen := map[string]int{}
+	for _, a := range got {
+		seen[a.Action]++
+	}
+	for _, action := range []string{AuditRemove, AuditStatus} {
+		if seen[action] == 0 {
+			t.Errorf("no %s line: %+v", action, got)
+		}
+	}
+	// the refusal names the memory, and the removal names what went
+	var refused, removed bool
+	for _, a := range got {
+		if a.Action == AuditRemove && a.ID == theirs.ID && a.Result == "conflict" {
+			refused = true
+		}
+		if a.Action == AuditRemove && a.ID == mine.ID && a.Result == "removed" {
+			removed = true
+		}
+	}
+	if !refused || !removed {
+		t.Fatalf("the removals aren't both written: %+v", got)
+	}
+}
+
+// A save is audited whoever makes it, and what it did is what the line
+// says: added, merged, changed or refused.
+func TestAuditOfSaveResults(t *testing.T) {
+	auditAt(t)
+	sb, _ := openVault(t)
+	if out, err := callTool(t, sb, Learn, ToolMemorySave, map[string]any{"text": "Nightly tidy runs at three", "kind": "fact"}); err != nil || !strings.Contains(out, "Remembered") {
+		t.Fatalf("%q %v", out, err)
+	}
+	if out, err := callTool(t, sb, Learn, ToolMemorySave, map[string]any{"text": "Nightly tidy runs at three", "kind": "fact"}); err != nil || !strings.Contains(out, "Already remembered, merged") {
+		t.Fatalf("%q %v", out, err)
+	}
+	// a refused save is a line too, with its error
+	if _, err := callTool(t, sb, Learn, ToolMemorySave, map[string]any{}); err == nil {
+		t.Fatal("a save with no text went through")
+	}
+	got := lines(t, AuditPath())
+	if len(got) < 3 {
+		t.Fatalf("%d lines: %+v", len(got), got)
+	}
+	if got[0].Result != "added" || got[0].Action != AuditSave {
+		t.Fatalf("the first: %+v", got[0])
+	}
+	if got[1].Result != "merged" {
+		t.Fatalf("the second: %+v", got[1])
+	}
+	if got[len(got)-1].Result != "refused" || got[len(got)-1].Error == "" {
+		t.Fatalf("the refused one: %+v", got[len(got)-1])
+	}
+}
+
+func p(s string) *string { return &s }
diff --git a/internal/memagent/collect.go b/internal/memagent/collect.go
new file mode 100644
index 0000000..f5aff3f
--- /dev/null
+++ b/internal/memagent/collect.go
@@ -0,0 +1,258 @@
+package memagent
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"path"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/yetone/magpie/internal/memory"
+	"github.com/yetone/magpie/internal/sessions"
+)
+
+// What a run is given to read. Nothing here writes anything: a run's input
+// is gathered, the run decides what to keep, and the marks of what was read
+// are the caller's to keep, so gathering twice reads nothing twice.
+
+// ConversationQuery is which finished conversations a learn run reads.
+type ConversationQuery struct {
+	// Limit is the most conversations read in one run.
+	Limit int
+	// Quiet is how long a conversation has had no turn before it is read.
+	Quiet time.Duration
+	// Since is the oldest its last turn may be; zero reads any age.
+	Since time.Time
+	// Done marks the conversations read before, by agent/id, with their
+	// last turn when they were read. One that hasn't gone on since is
+	// passed over.
+	Done map[string]time.Time
+	// Now is the clock; zero takes time.Now.
+	Now time.Time
+	// SkipAgent is the agent whose sessions are never read: the memory
+	// agent's own.
+	SkipAgent string
+}
+
+// ConversationMarks are the marks a gather makes: the conversations read,
+// by key, with their last turn.
+type ConversationMarks map[string]time.Time
+
+// Defaults for a gather.
+const (
+	// ReadLimit is the most conversations one learn run reads.
+	ReadLimit = 30
+	// ReadQuiet is how long a conversation has had no turn before it is
+	// read.
+	ReadQuiet = 30 * time.Minute
+	// MinTurns is the fewest things the user said for a conversation to be
+	// worth reading.
+	MinTurns = 2
+	// ConversationBudget is how many characters of one conversation a run
+	// is shown.
+	ConversationBudget = 24_000
+)
+
+// sessionsList and sessionsRead are the sessions a gather reads, variables
+// so a test gives its own rather than the machine's real conversations.
+var (
+	sessionsList = func(limit int) []sessions.Session { return sessions.List(limit) }
+	sessionsRead = sessions.TranscriptOf
+)
+
+// Conversations gathers the conversations a learn run reads, the latest
+// first: what was said (no tools, no reasoning), cut to ConversationBudget.
+// A conversation already read and not gone on since is passed over, and one
+// that can't be read now is marked as read so a broken file isn't tried
+// every hour.
+func Conversations(q ConversationQuery) ([]Conversation, ConversationMarks, error) {
+	if q.Limit <= 0 {
+		q.Limit = ReadLimit
+	}
+	if q.Quiet <= 0 {
+		q.Quiet = ReadQuiet
+	}
+	at := q.Now
+	if at.IsZero() {
+		at = now()
+	}
+	skip := q.SkipAgent
+	if skip == "" {
+		skip = AgentID
+	}
+	out := []Conversation{}
+	marks := ConversationMarks{}
+	// the listing is kept and shared: sorting it in place would reorder
+	// what every other reader sees, so this works on its own copy
+	listed := slices.Clone(sessionsList(0))
+	slices.SortStableFunc(listed, func(a, b sessions.Session) int { return b.Last.Compare(a.Last) })
+	for _, s := range listed {
+		if len(out) >= q.Limit {
+			break
+		}
+		switch {
+		case s.Agent == skip, s.Gateway, s.ReadOnly, !s.Transcript, s.ParentSession != "":
+			continue
+		case at.Sub(s.Last) < q.Quiet:
+			continue
+		case !q.Since.IsZero() && s.Last.Before(q.Since):
+			continue
+		}
+		key := s.Agent + "/" + s.ID
+		if was, ok := q.Done[key]; ok && !s.Last.After(was) {
+			continue
+		}
+		tr, err := sessionsRead(s)
+		if err != nil {
+			// one that can't be read now isn't read every hour: it is
+			// marked, and read again when it changes
+			marks[key] = s.Last
+			continue
+		}
+		text, turns := said(tr)
+		if turns < MinTurns {
+			marks[key] = s.Last
+			continue
+		}
+		out = append(out, Conversation{Agent: s.Agent, Session: s.ID, Cwd: s.Cwd, Title: s.Title, Text: text})
+		marks[key] = s.Last
+	}
+	return out, marks, nil
+}
+
+// said is what the user and the assistant wrote, each turn named, within
+// ConversationBudget, and how many turns the user took. A thinking block, a
+// tool call and its result stay out: a model reading a conversation needs
+// what was said, not how it was worked out.
+func said(t sessions.Transcript) (string, int) {
+	var lines []string
+	turns := 0
+	for _, p := range t.Parts {
+		if p.Kind != "text" || p.Role != "user" && p.Role != "assistant" {
+			continue
+		}
+		who, max := "User", 4000
+		if p.Role == "assistant" {
+			who, max = "Assistant", 1200
+		} else {
+			turns++
+		}
+		lines = append(lines, who+": "+cutRunes(p.Text, max))
+	}
+	s := strings.Join(lines, "\n\n")
+	if len([]rune(s)) > ConversationBudget {
+		s = cutText(s, ConversationBudget)
+	}
+	return s, turns
+}
+
+// cutRunes keeps s to max characters, saying so when it cuts.
+func cutRunes(s string, max int) string {
+	r := []rune(s)
+	if len(r) <= max {
+		return s
+	}
+	return string(r[:max]) + "…"
+}
+
+// NotesLimit is the most notes one dream or organize run is given.
+const NotesLimit = 60
+
+// Notes reads the vault's notes a dream or organize run dreams across: the
+// notes under the folders a run may read, newest first, within limit notes
+// and budget bytes. A folder that isn't there is passed over: a vault need
+// not have every one.
+func Notes(sb *Sandbox, limit, budget int) ([]Note, error) {
+	if sb == nil {
+		return nil, errors.New("no knowledge vault to read from")
+	}
+	if limit <= 0 {
+		limit = NotesLimit
+	}
+	if budget <= 0 {
+		budget = MaxPrompt
+	}
+	type found struct {
+		path string
+		size int64
+	}
+	var files []found
+	var walk func(rel string, depth int) error
+	walk = func(rel string, depth int) error {
+		if depth > 8 {
+			return nil
+		}
+		entries, err := sb.List(rel)
+		if err != nil {
+			if errors.Is(err, fs.ErrNotExist) {
+				return nil
+			}
+			return err
+		}
+		for _, e := range entries {
+			p := path.Join(rel, e.Name)
+			if e.Dir {
+				if err := walk(p, depth+1); err != nil {
+					return err
+				}
+				continue
+			}
+			if !strings.EqualFold(path.Ext(e.Name), ".md") {
+				continue
+			}
+			files = append(files, found{path: p, size: e.Size})
+		}
+		return nil
+	}
+	for _, dir := range Readable {
+		if err := walk(dir, 0); err != nil {
+			return nil, err
+		}
+	}
+	// by path, so a run reads the same notes in the same order every time
+	slices.SortStableFunc(files, func(a, b found) int { return strings.Compare(a.path, b.path) })
+	out := []Note{}
+	var total int
+	for _, f := range files {
+		if len(out) >= limit || total >= budget {
+			break
+		}
+		b, err := sb.Read(f.path)
+		if err != nil {
+			continue // a note that can't be read now isn't a reason to dream nothing
+		}
+		text := cutText(string(b), min(budget-total, 8000))
+		out = append(out, Note{Path: f.path, Text: text})
+		total += len([]rune(text))
+	}
+	return out, nil
+}
+
+// ScopesFor is the memory scopes a role's run works in: its entry's, or
+// everyone's and the memory agent's own when it names none.
+func ScopesFor(a Agent) []string {
+	if len(a.Scopes) > 0 {
+		return slices.Clone(a.Scopes)
+	}
+	return []string{memory.Global, "agent:" + AgentID}
+}
+
+// CheckScopes refuses a scope memory has no place for, so a run is never
+// asked to work somewhere nothing can be kept.
+func CheckScopes(scopes []string) error {
+	for _, s := range scopes {
+		if s == memory.Global {
+			continue
+		}
+		if rest, ok := strings.CutPrefix(s, "project:"); ok && (rest == "*" || strings.TrimSpace(rest) != "") {
+			continue
+		}
+		if rest, ok := strings.CutPrefix(s, "agent:"); ok && strings.TrimSpace(rest) != "" {
+			continue
+		}
+		return fmt.Errorf("scope %q isn't global, project:<key> or agent:<id>", s)
+	}
+	return nil
+}
diff --git a/internal/memagent/collect_test.go b/internal/memagent/collect_test.go
new file mode 100644
index 0000000..b27ced0
--- /dev/null
+++ b/internal/memagent/collect_test.go
@@ -0,0 +1,262 @@
+package memagent
+
+import (
+	"errors"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/sessions"
+)
+
+// The vault's notes a run is given: the Markdown under the folders it may
+// read, and nothing else.
+func TestNotesReadsTheAllowlistedFolders(t *testing.T) {
+	sb, dir := openVault(t)
+	putFile(t, filepath.Join(dir, "wiki", "release.md"), "# Release\n\nReleases go out on Tuesdays.\n")
+	putFile(t, filepath.Join(dir, "inspirations", "idea.md"), "an idea\n")
+	putFile(t, filepath.Join(dir, "memories", "m.md"), "a memory note\n")
+	// these are not notes a run is given
+	putFile(t, filepath.Join(dir, "credentials", "token.md"), "secret\n")
+	putFile(t, filepath.Join(dir, "logs", "run.md"), "a log\n")
+	putFile(t, filepath.Join(dir, ".fish-import.json"), "{}")
+	putFile(t, filepath.Join(dir, "wiki", "image.png"), "not markdown")
+	notes, err := Notes(sb, 0, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]string{}
+	for _, n := range notes {
+		got[n.Path] = n.Text
+	}
+	if len(got) != 3 {
+		t.Fatalf("%v", got)
+	}
+	for _, want := range []string{"wiki/release.md", "inspirations/idea.md", "memories/m.md"} {
+		if _, ok := got[want]; !ok {
+			t.Errorf("%s wasn't read: %v", want, got)
+		}
+	}
+	if _, ok := got["credentials/token.md"]; ok {
+		t.Fatal("a note outside the allowlist was read")
+	}
+	// a vault with none of those folders is empty, not an error
+	empty := t.TempDir()
+	sb2, err := OpenSandbox(empty)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sb2.Close()
+	if notes, err := Notes(sb2, 0, 0); err != nil || len(notes) != 0 {
+		t.Fatalf("%v %v", notes, err)
+	}
+}
+
+// A run is given at most NotesLimit notes and at most its budget of
+// characters, so a big vault can't fill one prompt.
+func TestNotesAreBounded(t *testing.T) {
+	sb, dir := openVault(t)
+	for i := 0; i < NotesLimit+5; i++ {
+		putFile(t, filepath.Join(dir, "wiki", "n"+string(rune('a'+i%26))+string(rune('a'+i/26))+".md"), strings.Repeat("x", 5000))
+	}
+	notes, err := Notes(sb, 0, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(notes) > NotesLimit {
+		t.Fatalf("%d notes", len(notes))
+	}
+	var total int
+	for _, n := range notes {
+		total += len([]rune(n.Text))
+	}
+	if total > MaxPrompt {
+		t.Fatalf("%d characters", total)
+	}
+	// a smaller budget is kept to
+	notes, err = Notes(sb, 3, 2000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(notes) == 0 || len(notes) > 3 {
+		t.Fatalf("%d notes", len(notes))
+	}
+	total = 0
+	for _, n := range notes {
+		total += len([]rune(n.Text))
+	}
+	if total > 2000 {
+		t.Fatalf("%d characters with a 2000 budget", total)
+	}
+}
+
+// What a conversation a run reads holds: what was said, with no thinking
+// and no tool calls, and a long one cut keeping its start and its end.
+func TestSaidIsWhatWasSaid(t *testing.T) {
+	tr := sessions.Transcript{Parts: []sessions.Part{
+		{Role: "user", Kind: "text", Text: "releases go out on Tuesdays"},
+		{Role: "assistant", Kind: "thinking", Text: "SECRET THOUGHTS"},
+		{Role: "assistant", Kind: "tool_use", Name: "shell", Text: "rm -rf build"},
+		{Role: "tool", Kind: "tool_result", Text: "TOOL OUTPUT"},
+		{Role: "assistant", Kind: "text", Text: "Noted."},
+	}}
+	text, turns := said(tr)
+	if turns != 1 {
+		t.Fatalf("%d turns", turns)
+	}
+	for _, want := range []string{"User: releases go out on Tuesdays", "Assistant: Noted."} {
+		if !strings.Contains(text, want) {
+			t.Errorf("the conversation doesn't say %q:\n%s", want, text)
+		}
+	}
+	for _, no := range []string{"SECRET THOUGHTS", "rm -rf build", "TOOL OUTPUT"} {
+		if strings.Contains(text, no) {
+			t.Errorf("the conversation holds %q:\n%s", no, text)
+		}
+	}
+	// one huge turn is cut at its own end, and the whole within the budget
+	long := sessions.Transcript{Parts: []sessions.Part{
+		{Role: "user", Kind: "text", Text: "START " + strings.Repeat("a", ConversationBudget)},
+	}}
+	text, turns = said(long)
+	if turns != 1 || len([]rune(text)) > ConversationBudget+32 {
+		t.Fatalf("%d characters", len([]rune(text)))
+	}
+	if !strings.Contains(text, "START") {
+		t.Fatal("the start of a long turn went")
+	}
+	// many turns are cut keeping the start and the end of the conversation
+	var parts []sessions.Part
+	parts = append(parts, sessions.Part{Role: "user", Kind: "text", Text: "FIRST"})
+	for i := 0; i < 60; i++ {
+		parts = append(parts, sessions.Part{Role: "assistant", Kind: "text", Text: strings.Repeat("b", 800)})
+	}
+	parts = append(parts, sessions.Part{Role: "user", Kind: "text", Text: "LAST"})
+	text, turns = said(sessions.Transcript{Parts: parts})
+	if turns != 2 || len([]rune(text)) > ConversationBudget+32 {
+		t.Fatalf("%d characters, %d turns", len([]rune(text)), turns)
+	}
+	if !strings.Contains(text, "FIRST") || !strings.Contains(text, "LAST") {
+		t.Fatal("the start or the end of a long conversation went")
+	}
+}
+
+// The listing a gather reads is kept and shared: what it gives back is the
+// same whatever order it was listed in, and the listing isn't reordered.
+func TestConversationsLeavesTheListingAlone(t *testing.T) {
+	at := time.Date(2026, 11, 16, 12, 0, 0, 0, time.UTC)
+	oldList, oldRead := sessionsList, sessionsRead
+	t.Cleanup(func() { sessionsList, sessionsRead = oldList, oldRead })
+	shared := []sessions.Session{
+		{Agent: "codex", ID: "older", Last: at.Add(-3 * time.Hour), Transcript: true},
+		{Agent: "codex", ID: "newer", Last: at.Add(-time.Hour), Transcript: true},
+	}
+	sessionsList = func(int) []sessions.Session { return shared }
+	sessionsRead = func(sessions.Session) (sessions.Transcript, error) {
+		return sessions.Transcript{Parts: []sessions.Part{
+			{Role: "user", Kind: "text", Text: "a"}, {Role: "user", Kind: "text", Text: "b"},
+		}}, nil
+	}
+	got, _, err := Conversations(ConversationQuery{Now: at})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0].Session != "newer" || got[1].Session != "older" {
+		t.Fatalf("%+v", got)
+	}
+	if shared[0].ID != "older" || shared[1].ID != "newer" {
+		t.Fatalf("the listing was reordered: %v", shared)
+	}
+}
+
+// The memory agent's own sessions are never read, nor a subagent's, nor one
+// still going, nor one before Since; and one read already and not gone on
+// since is passed over.
+func TestConversationsSkipsWhatItShould(t *testing.T) {
+	at := time.Date(2026, 11, 16, 12, 0, 0, 0, time.UTC)
+	oldList, oldRead := sessionsList, sessionsRead
+	t.Cleanup(func() { sessionsList, sessionsRead = oldList, oldRead })
+	good := sessions.Session{Agent: "codex", ID: "s1", Last: at.Add(-time.Hour), Transcript: true, Title: "Releases"}
+	tooNew := sessions.Session{Agent: "codex", ID: "s2", Last: at.Add(-time.Minute), Transcript: true}
+	ours := sessions.Session{Agent: AgentID, ID: "s3", Last: at.Add(-time.Hour), Transcript: true}
+	sub := sessions.Session{Agent: "claude", ID: "s4", Last: at.Add(-time.Hour), Transcript: true, ParentSession: "p"}
+	old := sessions.Session{Agent: "claude", ID: "s5", Last: at.Add(-90 * 24 * time.Hour), Transcript: true}
+	read := sessions.Session{Agent: "codex", ID: "s6", Last: at.Add(-time.Hour), Transcript: true}
+	sessionsList = func(int) []sessions.Session { return []sessions.Session{good, tooNew, ours, sub, old, read} }
+	sessionsRead = func(s sessions.Session) (sessions.Transcript, error) {
+		switch s.ID {
+		case "s6":
+			return sessions.Transcript{Parts: []sessions.Part{{Role: "user", Kind: "text", Text: "x"}, {Role: "user", Kind: "text", Text: "y"}}}, nil
+		case "broken":
+			return sessions.Transcript{}, errors.New("unreadable")
+		}
+		return sessions.Transcript{Parts: []sessions.Part{
+			{Role: "user", Kind: "text", Text: "a"}, {Role: "user", Kind: "text", Text: "b"},
+		}}, nil
+	}
+	got, marks, err := Conversations(ConversationQuery{
+		Now: at, Since: at.Add(-30 * 24 * time.Hour),
+		// s6 was read after its last turn, so it hasn't gone on since
+		Done: map[string]time.Time{"codex/s6": at},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].Session != "s1" || got[0].Title != "Releases" {
+		t.Fatalf("%+v", got)
+	}
+	if len(marks) != 1 || !marks["codex/s1"].Equal(good.Last) {
+		t.Fatalf("%v", marks)
+	}
+	// a conversation that can't be read is marked, so it isn't tried every
+	// hour; one that isn't worth reading is too
+	sessionsList = func(int) []sessions.Session {
+		return []sessions.Session{
+			{Agent: "codex", ID: "broken", Last: at.Add(-time.Hour), Transcript: true},
+			{Agent: "codex", ID: "thin", Last: at.Add(-time.Hour), Transcript: true},
+		}
+	}
+	sessionsRead = func(s sessions.Session) (sessions.Transcript, error) {
+		if s.ID == "broken" {
+			return sessions.Transcript{}, errors.New("unreadable")
+		}
+		return sessions.Transcript{Parts: []sessions.Part{{Role: "user", Kind: "text", Text: "only one turn"}}}, nil
+	}
+	got, marks, err = Conversations(ConversationQuery{Now: at})
+	if err != nil || len(got) != 0 {
+		t.Fatalf("%+v %v", got, err)
+	}
+	if len(marks) != 2 {
+		t.Fatalf("%v", marks)
+	}
+	// a limit is kept to
+	if _, _, err := Conversations(ConversationQuery{Now: at, Limit: 1}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// The scopes a run works in are its entry's, else everyone's and its own;
+// one memory has no place for is refused.
+func TestScopesForAndCheck(t *testing.T) {
+	if got := ScopesFor(Agent{ID: "a", Scopes: []string{"global", "project:*"}}); len(got) != 2 || got[1] != "project:*" {
+		t.Fatalf("%v", got)
+	}
+	if got := ScopesFor(Agent{ID: "a"}); len(got) != 2 || got[0] != "global" || got[1] != "agent:"+AgentID {
+		t.Fatalf("%v", got)
+	}
+	for _, ok := range [][]string{{"global"}, {"project:github.com/o/r"}, {"project:*"}, {"agent:codex"}, nil} {
+		if err := CheckScopes(ok); err != nil {
+			t.Errorf("%v: %v", ok, err)
+		}
+	}
+	for _, bad := range [][]string{{"everywhere"}, {"project:"}, {"agent:"}, {""}} {
+		if err := CheckScopes(bad); err == nil {
+			t.Errorf("%v was taken", bad)
+		}
+	}
+	// what ScopesFor gives is always what CheckScopes takes
+	if err := CheckScopes(ScopesFor(Agent{})); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/memagent/dispatch.go b/internal/memagent/dispatch.go
new file mode 100644
index 0000000..97eb806
--- /dev/null
+++ b/internal/memagent/dispatch.go
@@ -0,0 +1,286 @@
+package memagent
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+)
+
+// Dispatching a run: which memory agent carries out a role, with which
+// route, and what it is asked. A role's agent is the one the registry's
+// defaults name, else the first of that role (Registry.Default); its model
+// and reasoning level are the entry's, never a dropdown's. The prompt is
+// built here from what the run is given, in neutral words: it goes to the
+// model's vendor as written.
+
+// Conversation is one finished conversation a learn run reads: what the
+// user and the assistant said, already cut to what a model should see (no
+// tool calls, no reasoning).
+type Conversation struct {
+	Agent   string `json:"agent"`
+	Session string `json:"session"`
+	Cwd     string `json:"cwd,omitempty"`
+	Title   string `json:"title,omitempty"`
+	Text    string `json:"text"`
+}
+
+// Note is one note a dream run is given to dream across: its path in the
+// vault and its text.
+type Note struct {
+	Path string `json:"path"`
+	Text string `json:"text"`
+}
+
+// Input is what one dispatched run is given.
+type Input struct {
+	// Role is learn, organize or dream.
+	Role string
+	// Vault is the knowledge vault; required.
+	Vault string
+	// Agent names the memory agent to run as; "" takes the role's default.
+	Agent string
+	// Model and Effort override the entry's route and level; "" keeps
+	// them.
+	Model  string
+	Effort string
+	// Conversations are what a learn run reads, Notes what a dream run
+	// dreams across.
+	Conversations []Conversation
+	Notes         []Note
+	// Scopes are the memory scopes the run works in.
+	Scopes []string
+	// Home is the agent's home; nil reads the one on this computer.
+	Home *Home
+	// Ask sends the model's turns; required.
+	Ask Ask
+	// RunID names the run's scratch folder; "" makes one.
+	RunID string
+	// MaxSteps, Timeout and TurnTimeout bound the run; 0 takes the
+	// package's.
+	MaxSteps    int
+	Timeout     time.Duration
+	TurnTimeout time.Duration
+	// SandboxPolicy restricts vault read/write paths; nil uses Default.
+	SandboxPolicy *Policy
+}
+
+// Dispatch picks the agent a role runs as, builds its task and runs it. A
+// role with no agent, or an agent named that isn't there, is an error: a
+// run is never made up from defaults the user didn't choose.
+func Dispatch(ctx context.Context, in Input) (Result, error) {
+	role := strings.ToLower(strings.TrimSpace(in.Role))
+	if !slices.Contains(Roles, role) {
+		return Result{}, fmt.Errorf("role %q isn't one of %s", in.Role, strings.Join(Roles, ", "))
+	}
+	r, err := LoadFor(in.Vault)
+	if err != nil {
+		return Result{}, err
+	}
+	a, ok := agentFor(r, role, in.Agent)
+	if !ok {
+		if id := strings.TrimSpace(in.Agent); id != "" {
+			return Result{}, fmt.Errorf("no memory agent with id %q", id)
+		}
+		return Result{}, fmt.Errorf("no memory agent carries out %s: add one, or set the role's default", role)
+	}
+	if !a.HasRole(role) {
+		return Result{}, fmt.Errorf("memory agent %q is %s, not %s", a.ID, a.Role, role)
+	}
+	home := in.Home
+	policy := in.SandboxPolicy
+	maxSteps := in.MaxSteps
+	timeout := in.Timeout
+	if ws, isObsidian := FindObsidianWorkspace(a.ID, in.Vault); isObsidian {
+		if !ws.Config.Enabled {
+			return Result{}, fmt.Errorf("memory agent %q is disabled in %s", ws.Config.Name, ws.Dir)
+		}
+		if !ws.Config.HasRole(role) {
+			return Result{}, fmt.Errorf("memory agent %q does %s, not %s", ws.ID, strings.Join(ws.Config.Roles, "|"), role)
+		}
+		if strings.TrimSpace(in.Model) == "" && strings.TrimSpace(ws.Config.Route) != "" {
+			a.Model = ws.Config.Route
+		}
+		if home == nil {
+			h, err := LoadHomeAt(ws.Dir)
+			if err != nil {
+				return Result{}, err
+			}
+			home = &h
+		}
+		if policy == nil {
+			p := ws.Config.SandboxPolicy()
+			policy = &p
+		}
+		if maxSteps == 0 && ws.Config.Budget.MaxSteps > 0 {
+			maxSteps = ws.Config.Budget.MaxSteps
+		}
+		if timeout == 0 && ws.Config.Budget.RunTimeoutMinutes > 0 {
+			timeout = time.Duration(ws.Config.Budget.RunTimeoutMinutes) * time.Minute
+		}
+	}
+	model := strings.TrimSpace(in.Model)
+	if model == "" {
+		model = a.Model
+	}
+	effort := strings.TrimSpace(in.Effort)
+	if effort == "" {
+		effort = a.Effort
+	}
+	prompt, err := promptFor(role, in)
+	if err != nil {
+		return Result{}, err
+	}
+	return Run(ctx, Task{
+		Role: role, Agent: agentID(a), Model: model, Effort: effort, Prompt: prompt,
+	}, Options{
+		Ask: in.Ask, Vault: in.Vault, RunID: in.RunID, Home: home,
+		MaxSteps: maxSteps, Timeout: timeout, TurnTimeout: in.TurnTimeout,
+		SandboxPolicy: policy,
+	})
+}
+
+// agentFor is the agent a run of role is dispatched to: the one named,
+// else the registry's default for the role.
+func agentFor(r Registry, role, id string) (Agent, bool) {
+	if id = strings.TrimSpace(id); id != "" {
+		return r.Get(id)
+	}
+	return r.Default(role)
+}
+
+// agentID is the magpie agent an entry runs as: its own, else the built-in
+// memory agent.
+func agentID(a Agent) string {
+	if s := strings.TrimSpace(a.Agent); s != "" {
+		return s
+	}
+	return DefaultAgent
+}
+
+// MaxPrompt is the longest prompt one run is asked with: what is read is
+// cut to fit, keeping the start and the end of a long conversation.
+const MaxPrompt = 48_000
+
+// promptFor is what a run of role is asked, in words that name neither
+// magpie nor any vendor.
+func promptFor(role string, in Input) (string, error) {
+	var b strings.Builder
+	switch role {
+	case Learn:
+		if len(in.Conversations) == 0 {
+			return "", errors.New("a learn run needs conversations to read")
+		}
+		b.WriteString(learnPrompt)
+		b.WriteString("\n\nConversations:\n")
+		for i, c := range in.Conversations {
+			fmt.Fprintf(&b, "\n--- %d. %s (%s, session %s) ---\n", i+1, titleOf(c), c.Agent, c.Session)
+			b.WriteString(cutText(c.Text, MaxPrompt/2))
+			b.WriteString("\n")
+		}
+	case Organize:
+		b.WriteString(organizePrompt)
+		b.WriteString("\n\nWhat to look at:\n")
+		if len(in.Notes) > 0 {
+			for _, n := range in.Notes {
+				fmt.Fprintf(&b, "\n--- %s ---\n%s\n", n.Path, cutText(n.Text, MaxPrompt/4))
+			}
+		} else {
+			b.WriteString("Read the vault's notes with the vault tools, and the memories with memory_search.\n")
+		}
+	case Dream:
+		b.WriteString(dreamPrompt)
+		b.WriteString("\n\nNotes to dream across:\n")
+		if len(in.Notes) > 0 {
+			for _, n := range in.Notes {
+				fmt.Fprintf(&b, "\n--- %s ---\n%s\n", n.Path, cutText(n.Text, MaxPrompt/4))
+			}
+		} else {
+			b.WriteString("Read the vault's notes with the vault tools, and the memories with memory_search.\n")
+		}
+	default:
+		return "", fmt.Errorf("role %q isn't one of %s", role, strings.Join(Roles, ", "))
+	}
+	if len(in.Scopes) > 0 {
+		fmt.Fprintf(&b, "\nScopes this run works in: %s.\n", strings.Join(in.Scopes, ", "))
+	}
+	return cutText(b.String(), MaxPrompt), nil
+}
+
+func titleOf(c Conversation) string {
+	if t := strings.TrimSpace(c.Title); t != "" {
+		return t
+	}
+	return c.Session
+}
+
+// cutText keeps s within max characters, its start and its end when it is
+// longer.
+func cutText(s string, max int) string {
+	if max <= 0 {
+		return ""
+	}
+	r := []rune(s)
+	if len(r) <= max {
+		return s
+	}
+	// a short max has no room for both ends and the mark between them: it
+	// keeps the start alone
+	if max < 16 {
+		return string(r[:max])
+	}
+	head := max * 2 / 3
+	tail := max - head - 8
+	return string(r[:head]) + "\n\n[…]\n\n" + string(r[len(r)-tail:])
+}
+
+// The roles' prompts: neutral words, no vendor named, each saying what to
+// write and where, so a run's products are the same whoever serves it.
+const (
+	learnPrompt = `You read finished conversations between a user and a coding assistant, and extract only durable cross-session facts that a later assistant could not learn from the repository: user preferences, rules learned from corrections (with exact why), project decisions, and verified workflows.
+
+Quote words the user wrote as the reason (why); omit assistant speculation, transient task progress, code already visible in the repo, and secrets. Save each atomic fact with memory_save (kind: profile/preference/rule/reference/fact/procedure/episode, appropriate scope: global/project/agent, tags). Never write directly to memories/*.md on disk. When nothing durable is worth keeping, save nothing and say so.`
+
+	organizePrompt = `You tidy long-term memories and the knowledge vault into a clean, consistent state without inventing facts or altering user-written records.
+
+1. Memories (MCP-only — memories/ on disk is read-only; never write memories/*.md or memories/candidates/):
+   - First inspect existing entries with memory_search.
+   - Merge or refine duplicate/overlapping machine memories via memory_save(id=...) or archive superseded duplicates with memory_forget, promote cross-project repeats with memory_promote, and set aside disproven machine entries with memory_forget.
+   - Never modify or archive user-written/edited memories (origin=user); write any conflict to logs/memory-conflicts.md instead.
+2. Vault workspace (write only under inspirations/, _digests/, dreams/, logs/; keep wiki/, memories/, projects/, indexes/, router/ read-only):
+   - Tidy inspirations/ notes cleanly in Markdown with complete frontmatter (title, created, category, tags, status, priority), summarize digested items under inspirations/_digests/, and flag any legacy misplaced notes (such as inspirations/dreams/) in logs/.
+   - Append a clear summary of merged, archived, and untouched items to logs/YYYY-MM-DD-memory-tidy.md. When unsure, leave records intact.`
+
+	dreamPrompt = `You dream across long-term memories (via memory_search), wiki/, inspirations/, and project notes to discover non-obvious cross-domain links, hidden tensions, and open questions written at different times.
+
+Write one Markdown note per insight directly under dreams/YYYY-MM-DD-<topic>.md (NEVER under inspirations/dreams/), including frontmatter (created, from-memories, links, confidence) and verification steps, citing exact source paths. Only call memory_save when a dream proves a durable cross-session fact; never restate a single existing note.`
+)
+
+// Keep dispatches runs as they fall due: first after first, then every
+// interval, for each role due at that moment, one at a time. A run that
+// fails is logged by the caller, and the next tick tries again; the hourly
+// tick also sweeps the scratch space (GC).
+func Keep(ctx context.Context, first, interval time.Duration, due func(role string, t time.Time) bool, run func(role string) error) {
+	t := time.NewTimer(first)
+	defer t.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-t.C:
+		}
+		t.Reset(interval)
+		GC(RunningScratch())
+		for _, role := range Roles {
+			if ctx.Err() != nil {
+				return
+			}
+			if due != nil && !due(role, now()) {
+				continue
+			}
+			_ = run(role)
+		}
+	}
+}
diff --git a/internal/memagent/dispatch_test.go b/internal/memagent/dispatch_test.go
new file mode 100644
index 0000000..ba3f6f2
--- /dev/null
+++ b/internal/memagent/dispatch_test.go
@@ -0,0 +1,291 @@
+package memagent
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// registryAt points the registry at the test's own file.
+func registryAt(t *testing.T) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "memory-agents.json")
+	old := Path
+	Path = func() string { return p }
+	t.Cleanup(func() { Path = old })
+	return p
+}
+
+// A dispatched run runs as the role's default agent, with that entry's
+// route and level, and the prompt says what it was given.
+func TestDispatchUsesTheRolesAgent(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	registryAt(t)
+	a := &asker{replies: []Turn{{Text: "read them"}}}
+	res, err := Dispatch(t.Context(), Input{
+		Role: Learn, Vault: dir, Ask: a.ask, Home: &Home{Dir: home},
+		Conversations: []Conversation{
+			{Agent: "codex", Session: "s1", Title: "Releases", Text: "User: releases go out on Tuesdays"},
+			{Agent: "claude", Session: "s2", Text: "User: I write in Chinese"},
+		},
+	})
+	if err != nil || res.Phase != PhaseDone || res.Role != Learn {
+		t.Fatalf("%+v %v", res, err)
+	}
+	req := a.asked[0]
+	if req.Model != "group/deepseek" || req.Effort != "high" {
+		t.Fatalf("the route: %q %q", req.Model, req.Effort)
+	}
+	for _, want := range []string{"Releases", "releases go out on Tuesdays", "I write in Chinese", "session s2"} {
+		if !strings.Contains(req.Messages[0]["content"].([]any)[0].(map[string]any)["text"].(string), want) {
+			t.Errorf("the prompt doesn't say %q", want)
+		}
+	}
+	// the run's agent is the registry's, and the status says so
+	if st := StatusOf(Learn); st.Agent != DefaultAgent || st.Model != "group/deepseek" {
+		t.Fatalf("status: %+v", st)
+	}
+}
+
+// A run named another agent runs as it; one that isn't there, or is another
+// role's, is refused.
+func TestDispatchNamesAnAgent(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	registryAt(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Add(Agent{ID: "night-owl", Name: "夜间整理", Role: Organize, Model: "group/x", Effort: "low"}); err != nil {
+		t.Fatal(err)
+	}
+	a := &asker{replies: []Turn{{Text: "done"}}}
+	res, err := Dispatch(t.Context(), Input{Role: Organize, Agent: "night-owl", Vault: dir, Ask: a.ask, Home: &Home{Dir: home}})
+	if err != nil || res.Phase != PhaseDone {
+		t.Fatalf("%+v %v", res, err)
+	}
+	if req := a.asked[0]; req.Model != "group/x" || req.Effort != "low" {
+		t.Fatalf("the route: %q %q", req.Model, req.Effort)
+	}
+	if _, err := Dispatch(t.Context(), Input{Role: Organize, Agent: "nope", Vault: dir, Ask: a.ask, Home: &Home{Dir: home}}); err == nil {
+		t.Fatal("an agent that isn't there")
+	}
+	// a model and a level named over the entry's are the ones used
+	a.asked = nil
+	if _, err := Dispatch(t.Context(), Input{Role: Organize, Agent: "night-owl", Model: "group/y", Effort: "max",
+		Vault: dir, Ask: a.ask, Home: &Home{Dir: home}}); err != nil {
+		t.Fatal(err)
+	}
+	if req := a.asked[0]; req.Model != "group/y" || req.Effort != "max" {
+		t.Fatalf("the route: %q %q", req.Model, req.Effort)
+	}
+}
+
+// A role with no agent is refused rather than run as something the user
+// didn't choose.
+func TestDispatchRefusesAnEmptyRole(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	p := registryAt(t)
+	if err := os.WriteFile(p, []byte(`{"version":1,"agents":[]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	a := &asker{}
+	if _, err := Dispatch(t.Context(), Input{Role: Learn, Vault: dir, Ask: a.ask, Home: &Home{Dir: home},
+		Conversations: []Conversation{{Session: "s", Text: "x"}}}); err == nil || !strings.Contains(err.Error(), "no memory agent") {
+		t.Fatalf("err: %v", err)
+	}
+	if a.count() != 0 {
+		t.Fatal("the model was asked for a role with no agent")
+	}
+	// and a learn run with nothing to read is refused before it starts
+	registryAt(t)
+	if _, err := Dispatch(t.Context(), Input{Role: Learn, Vault: dir, Ask: a.ask}); err == nil {
+		t.Fatal("a learn run with no conversations")
+	}
+	if _, err := Dispatch(t.Context(), Input{Role: "nope", Vault: dir, Ask: a.ask}); err == nil {
+		t.Fatal("an unknown role")
+	}
+}
+
+// The prompts name neither the app nor a vendor: they go to the model's
+// vendor as written.
+func TestPromptsAreNeutral(t *testing.T) {
+	for _, role := range Roles {
+		in := Input{Role: role, Conversations: []Conversation{{Session: "s", Text: "x"}}, Notes: []Note{{Path: "wiki/a.md", Text: "x"}}}
+		p, err := promptFor(role, in)
+		if err != nil {
+			t.Fatalf("%s: %v", role, err)
+		}
+		lower := strings.ToLower(p)
+		for _, word := range []string{"magpie", "anthropic", "openai", "deepseek", "claude", "codex", "gemini"} {
+			if strings.Contains(lower, word) {
+				t.Errorf("the %s prompt names %q:\n%s", role, word, p)
+			}
+		}
+	}
+}
+
+// A long conversation is cut, keeping its start and its end, so one huge
+// session can't spend a run's whole prompt.
+func TestLongPromptIsCut(t *testing.T) {
+	long := strings.Repeat("a", MaxPrompt) + "MIDDLE" + strings.Repeat("z", MaxPrompt) + "TAIL"
+	in := Input{Role: Learn, Conversations: []Conversation{{Session: "s", Text: long}}}
+	p, err := promptFor(Learn, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len([]rune(p)) > MaxPrompt {
+		t.Fatalf("the prompt is %d characters", len([]rune(p)))
+	}
+	if !strings.Contains(p, "aaaa") || !strings.Contains(p, "TAIL") {
+		t.Fatal("the prompt lost the start or the end of the conversation")
+	}
+}
+
+// Keep dispatches the roles that are due, one at a time, and stops when
+// the context ends.
+func TestKeepDispatchesDueRoles(t *testing.T) {
+	registryAt(t)
+	runAt(t)
+	homeAt(t)
+	var ran []string
+	ctx, cancel := context.WithCancel(t.Context())
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		Keep(ctx, 5*time.Millisecond, 5*time.Millisecond,
+			func(role string, _ time.Time) bool { return role != Dream },
+			func(role string) error {
+				ran = append(ran, role)
+				if len(ran) == 4 {
+					cancel()
+				}
+				return nil
+			})
+	}()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		cancel()
+		t.Fatal("Keep didn't stop")
+	}
+	if len(ran) < 2 || ran[0] != Learn || ran[1] != Organize {
+		t.Fatalf("ran: %v", ran)
+	}
+	for _, role := range ran {
+		if role == Dream {
+			t.Fatalf("a role that wasn't due ran: %v", ran)
+		}
+	}
+	// a run that fails doesn't stop the loop
+	ctx2, cancel2 := context.WithCancel(t.Context())
+	done2 := make(chan struct{})
+	n := 0
+	go func() {
+		defer close(done2)
+		Keep(ctx2, time.Millisecond, time.Millisecond, func(string, time.Time) bool { return true }, func(string) error {
+			n++
+			if n == 6 {
+				cancel2()
+			}
+			return errors.New("failed")
+		})
+	}()
+	select {
+	case <-done2:
+	case <-time.After(10 * time.Second):
+		cancel2()
+		t.Fatal("a failing run stopped the loop")
+	}
+	if n < 6 {
+		t.Fatalf("ran %d roles", n)
+	}
+}
+
+// The last run of each role is kept in memory-agent-runs.json, so a window
+// opened after a restart still says what happened.
+func TestRunsAreKeptAcrossARestart(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	registryAt(t)
+	a := &asker{replies: []Turn{{Text: "done"}}}
+	if _, err := Dispatch(t.Context(), Input{Role: Dream, Vault: dir, Ask: a.ask, Home: &Home{Dir: home}}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(filepath.Join(dir, "memory-agent-runs.json")); err != nil {
+		t.Fatalf("the record wasn't written: %v", err)
+	}
+	// what a new process reads: no run going, the last one's phase
+	live.mu.Lock()
+	live.run = nil
+	live.ended = nil
+	live.mu.Unlock()
+	st := StatusOf(Dream)
+	if st.Running || st.Phase != PhaseDone || st.Model != "group/deepseek" || st.Started.IsZero() || st.Ended.IsZero() {
+		t.Fatalf("status: %+v", st)
+	}
+	// a broken record reads as none, never as a run that failed. Its last
+	// good copy is what lastgood keeps, so the file and that copy both go.
+	if err := os.WriteFile(filepath.Join(dir, "memory-agent-runs.json"), []byte("{not json"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(filepath.Join(dir, "memory-agent-runs.json.bak")); err != nil {
+		t.Fatal(err)
+	}
+	if st := StatusOf(Dream); st.Phase != "" {
+		t.Fatalf("a broken record: %+v", st)
+	}
+}
+
+// A broken record with a good copy beside it reads as the copy: what a run
+// did is never lost to a half-written file.
+func TestRunsReadTheirLastGoodCopy(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	registryAt(t)
+	a := &asker{replies: []Turn{{Text: "done"}}}
+	if _, err := Dispatch(t.Context(), Input{Role: Dream, Vault: dir, Ask: a.ask, Home: &Home{Dir: home}}); err != nil {
+		t.Fatal(err)
+	}
+	live.mu.Lock()
+	live.run, live.ended = nil, nil
+	live.mu.Unlock()
+	// a second run writes the file again, keeping the first as the last good
+	if _, err := Dispatch(t.Context(), Input{Role: Dream, Vault: dir, Ask: a.ask, Home: &Home{Dir: home}}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(filepath.Join(dir, "memory-agent-runs.json.bak")); err != nil {
+		t.Fatalf("no last good copy: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "memory-agent-runs.json"), []byte("{not json"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if st := StatusOf(Dream); st.Phase != PhaseDone {
+		t.Fatalf("a broken record with a good copy: %+v", st)
+	}
+}
+
+func TestPromptsAlignTidalDashboardAndReadOnlyMemories(t *testing.T) {
+	org, err := promptFor(Organize, Input{Role: Organize})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{"memories/", "inspirations/", "_digests/", "logs/", "memory_save", "memory_forget"} {
+		if !strings.Contains(org, want) {
+			t.Errorf("organize prompt missing %q:\n%s", want, org)
+		}
+	}
+	drm, err := promptFor(Dream, Input{Role: Dream})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(drm, "dreams/") || !strings.Contains(drm, "inspirations/dreams") {
+		t.Errorf("dream prompt should specify dreams/ and forbid inspirations/dreams:\n%s", drm)
+	}
+}
diff --git a/internal/memagent/gateway.go b/internal/memagent/gateway.go
new file mode 100644
index 0000000..eb857c5
--- /dev/null
+++ b/internal/memagent/gateway.go
@@ -0,0 +1,193 @@
+package memagent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+
+	"github.com/yetone/magpie/internal/gateway"
+)
+
+// A run's turns go through magpie's own gateway, as any agent's request
+// does: routed, masked and counted, under the memory agent's name, so a run
+// costs what it costs and is seen in Usage beside the agents. The window
+// hands the handler and the gateway's address in; nothing here reaches a
+// vendor itself.
+
+// MaxReply is the most of a reply that is kept: a model answering with a
+// novel is cut rather than held whole.
+const MaxReply = 1 << 20
+
+// MaxTokens is the room one reply is given: enough for a note or a list of
+// calls, not for a document.
+const MaxTokens = 8192
+
+// GatewayAsk is an Ask that posts each turn to the gateway handler as an
+// Anthropic Messages request, x-api-key naming the memory agent, and reads
+// the reply's text and tool_use blocks. effort is fitted to the model's own
+// levels and sent with room for it (gateway.WithSideEffort), as the
+// distiller's and Vision's requests are.
+func GatewayAsk(h http.Handler, baseURL string) Ask {
+	return func(ctx context.Context, req Request) (Turn, error) {
+		if h == nil {
+			return Turn{}, errors.New("the gateway isn't served by this magpie")
+		}
+		if strings.TrimSpace(req.Model) == "" {
+			return Turn{}, errors.New("no model to ask: pick one for the memory agent")
+		}
+		body, err := json.Marshal(messagesBody(req))
+		if err != nil {
+			return Turn{}, err
+		}
+		body = gateway.WithSideEffort(body, req.Model, req.Effort)
+		httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost,
+			strings.TrimRight(baseURL, "/")+"/v1/messages", strings.NewReader(string(body)))
+		if err != nil {
+			return Turn{}, err
+		}
+		// the gateway answers this computer alone: a loopback address is
+		// what an agent's request carries
+		httpReq.RemoteAddr = "127.0.0.1:0"
+		httpReq.Header.Set("Content-Type", "application/json")
+		httpReq.Header.Set("anthropic-version", "2023-06-01")
+		httpReq.Header.Set("x-api-key", gateway.TokenFor(AgentID))
+		rec := newRecorder()
+		h.ServeHTTP(rec, httpReq)
+		if rec.code != http.StatusOK {
+			return Turn{}, fmt.Errorf("%d: %s", rec.code, gatewayError(rec.body))
+		}
+		// a reply cut short isn't a reply: it is said, never read as one
+		if rec.over {
+			return Turn{}, fmt.Errorf("the reply is over %d bytes: %s", MaxReply, gatewayError(rec.body))
+		}
+		return parseReply(rec.body)
+	}
+}
+
+// messagesBody is one turn as the Messages API takes it.
+func messagesBody(req Request) map[string]any {
+	body := map[string]any{
+		"model":      req.Model,
+		"max_tokens": MaxTokens,
+		"messages":   req.Messages,
+	}
+	if s := strings.TrimSpace(req.System); s != "" {
+		body["system"] = s
+	}
+	if len(req.Tools) > 0 {
+		tools := make([]any, 0, len(req.Tools))
+		for _, t := range req.Tools {
+			schema := t.Schema
+			if schema == nil {
+				schema = map[string]any{"type": "object", "properties": map[string]any{}}
+			}
+			tools = append(tools, map[string]any{
+				"name":         t.Name,
+				"description":  t.Description,
+				"input_schema": schema,
+			})
+		}
+		body["tools"] = tools
+	}
+	return body
+}
+
+// parseReply reads an Anthropic message: its text, and one call for each
+// tool_use block. A reply that isn't a message is an error, never an empty
+// turn that would end the run as if it had finished.
+func parseReply(b []byte) (Turn, error) {
+	var msg struct {
+		Content []struct {
+			Type  string          `json:"type"`
+			Text  string          `json:"text"`
+			ID    string          `json:"id"`
+			Name  string          `json:"name"`
+			Input json.RawMessage `json:"input"`
+		} `json:"content"`
+	}
+	if err := json.Unmarshal(b, &msg); err != nil {
+		return Turn{}, fmt.Errorf("a reply that isn't a message: %w", err)
+	}
+	var t Turn
+	for _, c := range msg.Content {
+		switch c.Type {
+		case "text":
+			t.Text += c.Text
+		case "tool_use":
+			if c.Name == "" {
+				continue // a call that names nothing can't be run
+			}
+			in := c.Input
+			if len(strings.TrimSpace(string(in))) == 0 {
+				in = json.RawMessage("{}")
+			}
+			t.Calls = append(t.Calls, Call{ID: c.ID, Name: c.Name, Input: in})
+		}
+	}
+	if strings.TrimSpace(t.Text) == "" && len(t.Calls) == 0 {
+		return Turn{}, errors.New("the reply held neither text nor a tool call")
+	}
+	return t, nil
+}
+
+// gatewayError is what a failed reply says, cut short: an agent reads it in
+// the window.
+func gatewayError(b []byte) string {
+	var e struct {
+		Error struct {
+			Message string `json:"message"`
+		} `json:"error"`
+	}
+	msg := ""
+	if json.Unmarshal(b, &e) == nil && e.Error.Message != "" {
+		msg = e.Error.Message
+	}
+	if msg == "" {
+		msg = strings.TrimSpace(string(b))
+	}
+	if r := []rune(msg); len(r) > 300 {
+		msg = string(r[:300]) + "…"
+	}
+	if msg == "" {
+		msg = "(no reason given)"
+	}
+	return msg
+}
+
+// recorder is a ResponseWriter that keeps the reply: a gateway handler
+// answers into it as into a connection.
+type recorder struct {
+	header http.Header
+	code   int
+	body   []byte
+	// over is set when the reply was longer than MaxReply: what is kept is
+	// then not the whole of it
+	over bool
+}
+
+func newRecorder() *recorder { return &recorder{header: http.Header{}, code: http.StatusOK} }
+
+func (r *recorder) Header() http.Header { return r.header }
+
+func (r *recorder) WriteHeader(code int) { r.code = code }
+
+func (r *recorder) Write(b []byte) (int, error) {
+	if room := MaxReply - len(r.body); room > 0 {
+		if room > len(b) {
+			room = len(b)
+		}
+		r.body = append(r.body, b[:room]...)
+		if room < len(b) {
+			r.over = true
+		}
+	} else {
+		r.over = true
+	}
+	return len(b), nil
+}
+
+// Flush lets a streaming handler answer as it does.
+func (r *recorder) Flush() {}
diff --git a/internal/memagent/gateway_test.go b/internal/memagent/gateway_test.go
new file mode 100644
index 0000000..26fafac
--- /dev/null
+++ b/internal/memagent/gateway_test.go
@@ -0,0 +1,168 @@
+package memagent
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// A turn goes to the gateway as an agent's request does: the memory agent's
+// token, the agent's instructions as the system text, the tools, and the
+// model's route; and the reply's text and tool calls come back.
+func TestGatewayAskSendsAndReads(t *testing.T) {
+	var got struct {
+		model   string
+		key     string
+		remote  string
+		system  string
+		msgs    []map[string]any
+		tools   []map[string]any
+		version string
+	}
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Model    string           `json:"model"`
+			System   string           `json:"system"`
+			Messages []map[string]any `json:"messages"`
+			Tools    []map[string]any `json:"tools"`
+		}
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		got.model, got.key, got.remote = body.Model, r.Header.Get("x-api-key"), r.RemoteAddr
+		got.system, got.msgs, got.tools = body.System, body.Messages, body.Tools
+		got.version = r.Header.Get("anthropic-version")
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"id":"msg_1","type":"message","role":"assistant","model":"m","content":[
+			{"type":"thinking","thinking":"hmm","signature":"s"},
+			{"type":"text","text":"Reading the notes."},
+			{"type":"tool_use","id":"toolu_1","name":"vault_list","input":{"path":"wiki"}}],
+			"stop_reason":"tool_use","usage":{"input_tokens":10,"output_tokens":5}}`))
+	})
+	ask := GatewayAsk(h, "http://127.0.0.1:1/")
+	turn, err := ask(context.Background(), Request{
+		Model: "group/deepseek", System: "you tidy notes",
+		Messages: []map[string]any{{"role": "user", "content": "go"}},
+		Tools:    []Tool{{Name: ToolVaultList, Description: "lists", Schema: map[string]any{"type": "object"}}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if turn.Text != "Reading the notes." || len(turn.Calls) != 1 {
+		t.Fatalf("%+v", turn)
+	}
+	if c := turn.Calls[0]; c.ID != "toolu_1" || c.Name != ToolVaultList || string(c.Input) != `{"path":"wiki"}` {
+		t.Fatalf("the call: %+v", c)
+	}
+	if got.model != "group/deepseek" || got.key != "magpie-memory" || got.remote != "127.0.0.1:0" {
+		t.Fatalf("what the gateway saw: %+v", got)
+	}
+	if got.system != "you tidy notes" || len(got.msgs) != 1 || len(got.tools) != 1 || got.tools[0]["name"] != ToolVaultList || got.version == "" {
+		t.Fatalf("the request: %+v", got)
+	}
+	if _, ok := got.tools[0]["input_schema"]; !ok {
+		t.Fatalf("the tool has no input_schema: %+v", got.tools[0])
+	}
+}
+
+// A reply the gateway refuses is an error that says why, and one that isn't
+// a message is an error too: a run never ends as if it had finished.
+func TestGatewayAskRefusals(t *testing.T) {
+	cases := []struct {
+		name string
+		code int
+		body string
+		want string
+	}{
+		{"refused", http.StatusBadGateway, `{"error":{"message":"no account can serve group/deepseek"}}`, "no account can serve"},
+		{"not a message", http.StatusOK, `{"ok":true}`, "neither text nor a tool call"},
+		{"not json", http.StatusOK, `<html>`, "isn't a message"},
+	}
+	for _, c := range cases {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(c.code)
+			_, _ = w.Write([]byte(c.body))
+		})
+		_, err := GatewayAsk(h, "http://127.0.0.1:1")(context.Background(), Request{Model: "m"})
+		if err == nil || !strings.Contains(err.Error(), c.want) {
+			t.Errorf("%s: %v", c.name, err)
+		}
+	}
+	// no handler, and no model, are refused before a request goes
+	if _, err := GatewayAsk(nil, "")(context.Background(), Request{Model: "m"}); err == nil {
+		t.Error("no gateway")
+	}
+	if _, err := GatewayAsk(http.NotFoundHandler(), "")(context.Background(), Request{}); err == nil {
+		t.Error("no model")
+	}
+}
+
+// A reply over MaxReply is refused rather than read as a cut one: half a
+// message is not a message, and a run must not end as if it had finished.
+func TestGatewayAskBounds(t *testing.T) {
+	big := strings.Repeat("a", MaxReply+1024)
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte(`{"content":[{"type":"text","text":"` + big + `"}]}`))
+	})
+	if _, err := GatewayAsk(h, "")(context.Background(), Request{Model: "m"}); err == nil || !strings.Contains(err.Error(), "over") {
+		t.Fatalf("a reply over MaxReply: %v", err)
+	}
+	// a tool_use with no input is a call with none, and a call naming
+	// nothing isn't run
+	ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte(`{"content":[{"type":"tool_use","id":"t","name":"x"},{"type":"tool_use","id":"u"}]}`))
+	})
+	turn, err := GatewayAsk(ok, "")(context.Background(), Request{Model: "m"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(turn.Calls) != 1 || string(turn.Calls[0].Input) != "{}" || turn.Calls[0].ID != "t" {
+		t.Fatalf("%+v", turn.Calls)
+	}
+}
+
+// The request's own timeout ends a turn, and the run says so.
+func TestGatewayAskHonoursItsContext(t *testing.T) {
+	blocked := make(chan struct{})
+	defer close(blocked)
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case <-r.Context().Done():
+		case <-blocked:
+		}
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := GatewayAsk(h, "")(ctx, Request{Model: "m"}); err == nil {
+		t.Fatal("a cancelled turn answered")
+	}
+}
+
+// A whole run over a gateway handler: the model asks for a note to be
+// written, the note is written into the vault, and the run ends when the
+// model stops asking.
+func TestRunThroughTheGateway(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	registryAt(t)
+	var turns int
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		turns++
+		if turns == 1 {
+			_, _ = w.Write([]byte(`{"content":[{"type":"tool_use","id":"t1","name":"vault_write","input":{"path":"dreams/2026-11-16.md","text":"# dream\n"}}]}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"content":[{"type":"text","text":"Dreamt one thing."}]}`))
+	})
+	res, err := Dispatch(t.Context(), Input{
+		Role: Dream, Vault: dir, Ask: GatewayAsk(h, "http://127.0.0.1:1"), Home: &Home{Dir: home},
+	})
+	if err != nil || res.Phase != PhaseDone || res.Wrote != 1 || turns != 2 {
+		t.Fatalf("%+v %v turns=%d", res, err, turns)
+	}
+	if b, err := os.ReadFile(filepath.Join(dir, "dreams", "2026-11-16.md")); err != nil || string(b) != "# dream\n" {
+		t.Fatalf("the note: %q %v", b, err)
+	}
+}
diff --git a/internal/memagent/home.go b/internal/memagent/home.go
new file mode 100644
index 0000000..f7eab25
--- /dev/null
+++ b/internal/memagent/home.go
@@ -0,0 +1,309 @@
+package memagent
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+
+	"github.com/yetone/magpie/internal/appdir"
+)
+
+// A memory agent's home: the folder its own files are kept in, so it can
+// be given instructions, MCP servers and skills as an agent is.
+//
+//	<config>/memory-agent/AGENTS.md   its instructions: the run's system text
+//	<config>/memory-agent/mcp.json    further MCP servers, whose tools it may use
+//	<config>/memory-agent/skills/     skills, each a folder with a SKILL.md
+//
+// AGENTS.md is the one the Library's digest is appended to; mcp.json is the
+// same shape an agent's is (`{"mcpServers": {...}}`), so a server added
+// there is given to a run as it would be to an agent.
+const (
+	// HomeName is the folder under magpie's config.
+	HomeName = "memory-agent"
+	// InstructionsName is the run's system text.
+	InstructionsName = "AGENTS.md"
+	// MCPName is the servers it may use.
+	MCPName = "mcp.json"
+	// SkillsName is the folder of its skills.
+	SkillsName = "skills"
+	// MaxInstructions is the longest instructions a run is given.
+	MaxInstructions = 200_000
+)
+
+// Home is a memory agent's home, read for one run.
+type Home struct {
+	Dir string
+	// Instructions is AGENTS.md; "" when it isn't there.
+	Instructions string
+	// Servers are the MCP servers mcp.json names, in the order it does.
+	Servers []Server
+	// Skills are the skills it has, each a name and what its SKILL.md says
+	// of itself.
+	Skills []Skill
+}
+
+// HomeDir is the folder a memory agent keeps its files in; a variable for
+// tests.
+var HomeDir = func() string { return appdir.Join(appdir.Config(), HomeName) }
+
+// LoadHome reads the memory agent's home. A folder that isn't there is an
+// empty home, not an error: a run has the memory tools and the vault all
+// the same. A file that is there and can't be read is an error: a run is
+// never given other instructions than the ones written.
+func LoadHome() (Home, error) {
+	return LoadHomeAt(HomeDir())
+}
+
+// LoadHomeAt reads an agent workspace at dir (AGENTS.md, mcp.json, skills/).
+func LoadHomeAt(dir string) (Home, error) {
+	h := Home{Dir: dir}
+	b, err := os.ReadFile(filepath.Join(h.Dir, InstructionsName))
+	switch {
+	case err == nil:
+		if len(b) > MaxInstructions {
+			return h, fmt.Errorf("%s is %d bytes; instructions are at most %d", InstructionsName, len(b), MaxInstructions)
+		}
+		h.Instructions = string(b)
+	case !errors.Is(err, os.ErrNotExist):
+		return h, err
+	}
+	if h.Servers, err = loadServers(filepath.Join(h.Dir, MCPName)); err != nil {
+		return h, err
+	}
+	if h.Skills, err = loadSkills(filepath.Join(h.Dir, SkillsName)); err != nil {
+		return h, err
+	}
+	return h, nil
+}
+
+// Server is one MCP server a run may use, as mcp.json names it: a command
+// and its arguments (stdio), or a streamable http URL.
+type Server struct {
+	Name      string            `json:"name"`
+	Command   string            `json:"command,omitempty"`
+	Args      []string          `json:"args,omitempty"`
+	Env       map[string]string `json:"env,omitempty"`
+	URL       string            `json:"url,omitempty"`
+	Transport string            `json:"transport,omitempty"`
+}
+
+// loadServers reads mcp.json: `{"mcpServers": {"<name>": {command, args,
+// env}}}`. A server with no command and no URL is refused, and one named
+// in a way a tool's name can't carry is refused too: the tools it gives are
+// named `<server>__<tool>`.
+func loadServers(path string) ([]Server, error) {
+	b, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var file struct {
+		MCPServers map[string]struct {
+			Command   string            `json:"command"`
+			Args      []string          `json:"args"`
+			Env       map[string]string `json:"env"`
+			URL       string            `json:"url"`
+			Type      string            `json:"type"`
+			Transport string            `json:"transport"`
+			Disabled  bool              `json:"disabled"`
+		} `json:"mcpServers"`
+	}
+	if err := json.Unmarshal(b, &file); err != nil {
+		return nil, fmt.Errorf("%s can't be read: %v", path, err)
+	}
+	names := make([]string, 0, len(file.MCPServers))
+	for name := range file.MCPServers {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+	out := make([]Server, 0, len(names))
+	for _, name := range names {
+		s := file.MCPServers[name]
+		if s.Disabled {
+			continue
+		}
+		if !serverName(name) {
+			return nil, fmt.Errorf("%s names a server %q: letters, digits, '-' and '_', up to 40", path, name)
+		}
+		switch {
+		case s.Command != "":
+			out = append(out, Server{Name: name, Command: s.Command, Args: s.Args, Env: s.Env, Transport: "stdio"})
+		case s.URL != "":
+			t := s.Transport
+			if t == "" {
+				t = s.Type
+			}
+			switch t {
+			case "", "http", "streamable-http":
+				t = "http"
+			case "sse":
+				return nil, fmt.Errorf("%s: %q is an sse server, which a run can't speak: give its streamable http url", path, name)
+			default:
+				return nil, fmt.Errorf("%s: %q is a transport this run can't use (%s)", path, t, name)
+			}
+			out = append(out, Server{Name: name, URL: s.URL, Transport: t})
+		default:
+			return nil, fmt.Errorf("%s: %q has no command and no url", path, name)
+		}
+	}
+	return out, nil
+}
+
+// serverName says whether name may name an MCP server a run uses.
+func serverName(s string) bool {
+	if s == "" || len(s) > 40 {
+		return false
+	}
+	for _, r := range s {
+		if !(r == '-' || r == '_' || r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9') {
+			return false
+		}
+	}
+	return true
+}
+
+// Skill is one of the agent's skills: its name and what its SKILL.md says
+// of itself.
+type Skill struct {
+	Name        string `json:"name"`
+	Description string `json:"description,omitempty"`
+	Path        string `json:"path"`
+}
+
+// maxSkillDesc is how much of a skill's description a run is shown.
+const maxSkillDesc = 1024
+
+// loadSkills reads the skill folders under dir: each a folder with a
+// SKILL.md whose front matter names it and describes it. A folder without
+// one isn't a skill and is passed over.
+func loadSkills(dir string) ([]Skill, error) {
+	entries, err := os.ReadDir(dir)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	out := []Skill{}
+	for _, e := range entries {
+		if !e.IsDir() {
+			fi, err := os.Stat(filepath.Join(dir, e.Name()))
+			if err != nil || !fi.IsDir() {
+				continue
+			}
+		}
+		file := filepath.Join(dir, e.Name(), "SKILL.md")
+		b, err := os.ReadFile(file)
+		if err != nil {
+			continue
+		}
+		name, desc := skillMeta(string(b))
+		if name == "" {
+			name = e.Name()
+		}
+		if r := []rune(desc); len(r) > maxSkillDesc {
+			desc = string(r[:maxSkillDesc])
+		}
+		out = append(out, Skill{Name: name, Description: desc, Path: file})
+	}
+	return out, nil
+}
+
+// skillMeta reads a SKILL.md's front matter: the name and the description
+// it gives itself. A file without front matter is described by its first
+// line of text.
+func skillMeta(s string) (name, desc string) {
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	if rest, ok := strings.CutPrefix(strings.TrimLeft(s, "\n "), "---\n"); ok {
+		front, body, found := strings.Cut(rest, "\n---")
+		if found {
+			for _, line := range strings.Split(front, "\n") {
+				k, v, ok := strings.Cut(line, ":")
+				if !ok {
+					continue
+				}
+				switch strings.ToLower(strings.TrimSpace(k)) {
+				case "name":
+					name = unquote(strings.TrimSpace(v))
+				case "description":
+					desc = unquote(strings.TrimSpace(v))
+				}
+			}
+			if desc != "" {
+				return name, desc
+			}
+			s = body
+		}
+	}
+	for _, line := range strings.Split(s, "\n") {
+		if line = strings.TrimSpace(line); line != "" && line != "---" {
+			return name, line
+		}
+	}
+	return name, ""
+}
+
+// unquote takes the quotes a YAML value may be written in off.
+func unquote(s string) string {
+	if len(s) >= 2 {
+		if (s[0] == '"' && s[len(s)-1] == '"') || (s[0] == '\'' && s[len(s)-1] == '\'') {
+			return s[1 : len(s)-1]
+		}
+	}
+	return s
+}
+
+// System is the text a run is given as its instructions: the agent's
+// AGENTS.md, then what it may read and write and the skills it has. The
+// tools are given to the model as tools, so the text says what they are for
+// rather than repeating their schemas.
+func (h Home) System() string {
+	return h.SystemWith(nil)
+}
+
+// SystemWith builds system instructions describing the active vault sandbox bounds.
+func (h Home) SystemWith(sb *Sandbox) string {
+	var b strings.Builder
+	if s := strings.TrimSpace(h.Instructions); s != "" {
+		b.WriteString(s)
+		b.WriteString("\n\n")
+	}
+	b.WriteString("## What this run may use\n\n")
+	fmt.Fprintf(&b, "- The memory tools: %s, %s, %s, %s.\n", ToolMemorySearch, ToolMemorySave, ToolMemoryForget, ToolMemoryContext)
+	readDesc := strings.Join(Readable, ", ")
+	writeDesc := strings.Join(Writable, ", ")
+	if sb != nil {
+		if sb.readAll {
+			readDesc = "the vault (excluding " + strings.Join(sb.deny, ", ") + ")"
+		} else if len(sb.readAllow) > 0 {
+			readDesc = strings.Join(sb.readAllow, ", ")
+		}
+		if len(sb.writeAllow) > 0 {
+			writeDesc = strings.Join(sb.writeAllow, ", ")
+		}
+	}
+	fmt.Fprintf(&b, "- The knowledge vault: %s and %s read under %s; %s writes under %s. Nothing else in it, and nothing outside it, is reachable.\n",
+		ToolVaultList, ToolVaultRead, readDesc, ToolVaultWrite, writeDesc)
+	fmt.Fprintf(&b, "- A scratch folder of this run's own (%s, %s), dropped when the run ends.\n", ToolScratchWrite, ToolScratchRead)
+	if len(h.Servers) > 0 {
+		var names []string
+		for _, s := range h.Servers {
+			names = append(names, s.Name)
+		}
+		fmt.Fprintf(&b, "- Tools of the MCP servers %s.\n", strings.Join(names, ", "))
+	}
+	if len(h.Skills) > 0 {
+		b.WriteString("\n## Skills\n\nEach is a folder with a SKILL.md; read the one a task fits before doing it.\n\n")
+		for _, s := range h.Skills {
+			fmt.Fprintf(&b, "- %s: %s (%s)\n", s.Name, oneLine(s.Description), s.Path)
+		}
+	}
+	return strings.TrimRight(b.String(), "\n")
+}
diff --git a/internal/memagent/home_test.go b/internal/memagent/home_test.go
new file mode 100644
index 0000000..766548f
--- /dev/null
+++ b/internal/memagent/home_test.go
@@ -0,0 +1,190 @@
+package memagent
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// homeAt points the agent's home at a folder of the test's own.
+func homeAt(t *testing.T) string {
+	t.Helper()
+	dir := filepath.Join(t.TempDir(), "memory-agent")
+	old := HomeDir
+	HomeDir = func() string { return dir }
+	t.Cleanup(func() { HomeDir = old })
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	return dir
+}
+
+// A home that isn't there is empty, not an error: a run still has the
+// memory tools and the vault.
+func TestLoadHomeMissing(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "nope")
+	old := HomeDir
+	HomeDir = func() string { return dir }
+	t.Cleanup(func() { HomeDir = old })
+	h, err := LoadHome()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if h.Instructions != "" || len(h.Servers) != 0 || len(h.Skills) != 0 {
+		t.Fatalf("%+v", h)
+	}
+	sys := h.System()
+	for _, want := range []string{ToolMemorySearch, ToolVaultWrite, strings.Join(Writable, ", ")} {
+		if !strings.Contains(sys, want) {
+			t.Errorf("the system text doesn't say %q:\n%s", want, sys)
+		}
+	}
+}
+
+// AGENTS.md is the run's instructions, and the system text adds what the
+// run may use without repeating the tools' schemas.
+func TestLoadHomeInstructions(t *testing.T) {
+	dir := homeAt(t)
+	if err := os.WriteFile(filepath.Join(dir, InstructionsName), []byte("# 记忆体系维护 Agent\n\n整理记忆。\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	h, err := LoadHome()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sys := h.System()
+	if !strings.HasPrefix(sys, "# 记忆体系维护 Agent\n\n整理记忆。") {
+		t.Fatalf("the instructions aren't the run's:\n%s", sys)
+	}
+	if !strings.Contains(sys, "What this run may use") {
+		t.Fatalf("the system text:\n%s", sys)
+	}
+}
+
+// mcp.json is read as an agent's is: a server with a command, or a URL, and
+// a disabled one is left out. A server that can't be used is an error, not
+// a run without it.
+func TestLoadHomeServers(t *testing.T) {
+	dir := homeAt(t)
+	body := `{"mcpServers": {
+		"magpie-memory": {"command": "magpie", "args": ["mcp", "memory"]},
+		"notes": {"url": "http://127.0.0.1:9/mcp"},
+		"off": {"command": "x", "disabled": true}
+	}}`
+	if err := os.WriteFile(filepath.Join(dir, MCPName), []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	h, err := LoadHome()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(h.Servers) != 2 || h.Servers[0].Name != "magpie-memory" || h.Servers[0].Transport != "stdio" ||
+		len(h.Servers[0].Args) != 2 || h.Servers[1].Name != "notes" || h.Servers[1].Transport != "http" {
+		t.Fatalf("%+v", h.Servers)
+	}
+	if sys := h.System(); !strings.Contains(sys, "magpie-memory") || !strings.Contains(sys, "notes") {
+		t.Fatalf("the system text doesn't name the servers:\n%s", sys)
+	}
+	bad := []string{
+		`{"mcpServers": {"x": {}}}`,
+		`{"mcpServers": {"bad name": {"command": "x"}}}`,
+		`{"mcpServers": {"x": {"url": "http://h/", "transport": "sse"}}}`,
+		`{not json`,
+	}
+	for _, b := range bad {
+		if err := os.WriteFile(filepath.Join(dir, MCPName), []byte(b), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := LoadHome(); err == nil {
+			t.Errorf("mcp.json %s was read", b)
+		}
+	}
+}
+
+// A skill is a folder with a SKILL.md; its front matter names it and
+// describes it, and one without is named by its folder and described by its
+// first line.
+func TestLoadHomeSkills(t *testing.T) {
+	dir := homeAt(t)
+	skills := filepath.Join(dir, SkillsName)
+	for name, body := range map[string]string{
+		"tidy":  "---\nname: tidy-memory\ndescription: \"Merges notes that say the same\"\n---\n\n# Tidy\n",
+		"plain": "# A skill with no front matter\n\nbody\n",
+		"empty": "",
+	} {
+		if err := os.MkdirAll(filepath.Join(skills, name), 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if body != "" {
+			if err := os.WriteFile(filepath.Join(skills, name, "SKILL.md"), []byte(body), 0o600); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	// a folder without a SKILL.md isn't a skill
+	if err := os.MkdirAll(filepath.Join(skills, "notaskill"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	h, err := LoadHome()
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := map[string]Skill{}
+	for _, s := range h.Skills {
+		got[s.Name] = s
+	}
+	if len(got) != 2 {
+		t.Fatalf("%+v", h.Skills)
+	}
+	if s := got["tidy-memory"]; s.Description != "Merges notes that say the same" || !strings.HasSuffix(filepath.ToSlash(s.Path), "/tidy/SKILL.md") {
+		t.Fatalf("%+v", s)
+	}
+	if s := got["plain"]; s.Description != "# A skill with no front matter" {
+		t.Fatalf("%+v", s)
+	}
+	if sys := h.System(); !strings.Contains(sys, "tidy-memory: Merges notes that say the same") {
+		t.Fatalf("the system text doesn't list the skills:\n%s", sys)
+	}
+}
+
+// A home file that is there and can't be read ends the run before it asks
+// the model: a run is never given other instructions than the ones written.
+func TestRunRefusesAnUnreadableHome(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	if err := os.WriteFile(filepath.Join(home, InstructionsName), []byte("x"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// a folder where the file is makes every read of it fail
+	if err := os.Remove(filepath.Join(home, InstructionsName)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(filepath.Join(home, InstructionsName), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	a := &asker{}
+	if _, err := Run(t.Context(), Task{Role: Dream, Model: "m", Prompt: "p"}, Options{Ask: a.ask, Vault: dir}); err == nil {
+		t.Fatal("a run with unreadable instructions went ahead")
+	}
+	if a.count() != 0 {
+		t.Fatal("the model was asked with instructions magpie couldn't read")
+	}
+}
+
+// The instructions the run was given are the agent's, and its servers'
+// tools are given beside the run's own.
+func TestRunUsesTheHome(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	if err := os.WriteFile(filepath.Join(home, InstructionsName), []byte("You tidy the user's notes.\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	a := &asker{replies: []Turn{{Text: "done"}}}
+	if _, err := Run(t.Context(), Task{Role: Organize, Model: "m", Prompt: "p"}, Options{Ask: a.ask, Vault: dir}); err != nil {
+		t.Fatal(err)
+	}
+	if len(a.asked) != 1 || !strings.HasPrefix(a.asked[0].System, "You tidy the user's notes.") {
+		t.Fatalf("the system text: %q", a.asked[0].System)
+	}
+}
diff --git a/internal/memagent/loop.go b/internal/memagent/loop.go
new file mode 100644
index 0000000..6fd3bac
--- /dev/null
+++ b/internal/memagent/loop.go
@@ -0,0 +1,417 @@
+package memagent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/filelock"
+)
+
+// One run of a memory agent: the task its role names, the agent whose
+// instructions it follows, and the tools it may use. The loop asks the
+// model, runs the tools it asks for, hands their results back, and stops at
+// a final answer or at a limit. A run holds a lock: one at a time in this
+// process and across magpies, so two windows can't tidy memory at once.
+const (
+	// MaxSteps is how many turns one run may take before it is ended: a
+	// model that keeps calling tools is stopped, not left to spend.
+	MaxSteps = 40
+	// RunTimeout ends a run that takes too long, whatever it is doing.
+	RunTimeout = 20 * time.Minute
+	// TurnTimeout is how long one request to the model may take.
+	TurnTimeout = 5 * time.Minute
+	// AgentID is the agent the run's requests are counted as in Usage.
+	AgentID = "memory"
+)
+
+// now is the clock; a variable for tests.
+var now = time.Now
+
+// ErrRunning is a run asked for while another is going.
+var ErrRunning = errors.New("a memory agent is already running")
+
+// ErrNoVault is a run with no knowledge vault to work in.
+var ErrNoVault = errors.New("no knowledge vault: the knowledge folder isn't there")
+
+// Call is one tool the model asked for.
+type Call struct {
+	ID    string          `json:"id"`
+	Name  string          `json:"name"`
+	Input json.RawMessage `json:"input"`
+}
+
+// Turn is one answer of the model: what it said and the tools it asked
+// for. A turn with no calls ends the run.
+type Turn struct {
+	Text  string
+	Calls []Call
+}
+
+// Request is one turn asked of the model, as the gateway's Messages API
+// takes it: the system text, the conversation so far, and the tools.
+type Request struct {
+	Model    string
+	Effort   string
+	System   string
+	Messages []map[string]any
+	Tools    []Tool
+}
+
+// Ask sends one turn and gives the model's answer. The GUI wires it to the
+// gateway this process serves, as the distiller's requests go (routed,
+// masked and counted under AgentID).
+type Ask func(ctx context.Context, req Request) (Turn, error)
+
+// Task is what one run is asked to do.
+type Task struct {
+	// Role is learn, organize or dream.
+	Role string
+	// Agent is the magpie agent it runs as; its AGENTS.md is the prompt.
+	Agent string
+	// Model is the internal route; never shown in a dropdown.
+	Model string
+	// Effort is the reasoning level asked of the model, "" for its own.
+	Effort string
+	// System is the agent's instructions (its AGENTS.md).
+	System string
+	// Prompt is what this run is asked for: the conversations to read,
+	// the memories to tidy, the notes to dream across.
+	Prompt string
+}
+
+// Options are a run's own settings: what it asks and where it writes.
+type Options struct {
+	// Ask sends the model's turns; required.
+	Ask Ask
+	// Vault is the knowledge vault's folder. A run with none is refused.
+	Vault string
+	// RunID names its scratch folder; "" is made from the role and the
+	// time.
+	RunID string
+	// Home is the agent's home (its AGENTS.md, mcp.json and skills); nil
+	// reads the one on this computer (LoadHome).
+	Home *Home
+	// Tools are further tools the run is given beside its own and the
+	// agent's servers'.
+	Tools []Tool
+	// MaxSteps, Timeout and TurnTimeout are the limits; 0 takes the
+	// package's.
+	MaxSteps    int
+	Timeout     time.Duration
+	TurnTimeout time.Duration
+	// SandboxPolicy limits readable/writable vault paths; nil uses default.
+	SandboxPolicy *Policy
+}
+
+// Result is what a run did.
+type Result struct {
+	Role  string
+	Steps int
+	// Text is the model's last answer.
+	Text string
+	// Wrote is how many files it wrote into the vault, Saved how many
+	// memories it kept.
+	Wrote int
+	Saved int
+	// Phase is how it ended: done, stopped or failed.
+	Phase string
+}
+
+// running is held through a run in this process; the .run file is held
+// across magpies.
+var running = make(chan struct{}, 1)
+
+// stopState is the cancel of the run going, and its role.
+var stopState struct {
+	mu     sync.Mutex
+	role   string
+	cancel context.CancelFunc
+	asked  bool
+}
+
+// RunLockPath is the lock a run holds across magpies; a variable for tests.
+var RunLockPath = func() string {
+	return appdir.Join(appdir.Config(), "memory-agent.run")
+}
+
+// Run carries out t with the tools a memory agent has: the memory tools,
+// the vault's allowlisted folders, the run's scratch folder and whatever
+// opts.Tools adds.
+func Run(ctx context.Context, t Task, opts Options) (Result, error) {
+	role := strings.ToLower(strings.TrimSpace(t.Role))
+	if !slices.Contains(Roles, role) {
+		return Result{}, fmt.Errorf("role %q isn't one of %s", t.Role, strings.Join(Roles, ", "))
+	}
+	t.Role = role
+	if opts.Ask == nil {
+		return Result{}, errors.New("no model to ask: a memory agent runs through the gateway")
+	}
+	select {
+	case running <- struct{}{}:
+		defer func() { <-running }()
+	default:
+		return Result{}, ErrRunning
+	}
+	unlock, held := filelock.Lock(RunLockPath(), 0)
+	if !held {
+		return Result{}, ErrRunning
+	}
+	defer unlock()
+	vault := strings.TrimSpace(opts.Vault)
+	if vault == "" {
+		return Result{}, ErrNoVault
+	}
+	var (
+		sb  *Sandbox
+		err error
+	)
+	if opts.SandboxPolicy != nil {
+		sb, err = OpenSandboxWith(vault, *opts.SandboxPolicy)
+	} else {
+		sb, err = OpenSandbox(vault)
+	}
+	if err != nil {
+		return Result{}, err
+	}
+	defer sb.Close()
+	runID := strings.TrimSpace(opts.RunID)
+	if runID == "" {
+		runID = role + "-" + now().UTC().Format("20060102T150405")
+	}
+	sc, err := NewScratch(runID)
+	if err != nil {
+		return Result{}, err
+	}
+	// the sweep of the cache is told the folder of the run going, so it is
+	// never dropped while the run writes into it. It is cleared before the
+	// run's folder goes, so the sweep after it can tidy what it left.
+	setScratch(sc.id)
+	// the run's folder goes whatever happens, and the cache is swept, so a
+	// run that fails can't fill it
+	defer func() {
+		setScratch("")
+		_ = sc.Close()
+		GC("")
+	}()
+	lim := limitsOf(opts)
+	ctx, cancel := context.WithTimeout(ctx, lim.timeout)
+	defer cancel()
+	registerStop(t.Role, cancel)
+	defer registerStop("", nil)
+
+	log := begin(t.Role, t.Agent, t.Model)
+	// the agent's own files: its instructions, and the servers it was
+	// equipped with. A home that can't be read ends the run before the
+	// model is asked: a run is never given other instructions than the
+	// ones written.
+	home := opts.Home
+	if home == nil {
+		h, err := LoadHome()
+		if err != nil {
+			log.failed(err)
+			end(PhaseFailed, err)
+			return Result{Phase: PhaseFailed}, err
+		}
+		home = &h
+	}
+	if strings.TrimSpace(t.System) == "" {
+		t.System = home.SystemWith(sb)
+	}
+	extra := slices.Clone(opts.Tools)
+	if len(home.Servers) > 0 {
+		mcpTools, closeAll := mcpToolsFor(home.Servers, log)
+		defer closeAll()
+		extra = append(mcpTools, extra...)
+	}
+	set, err := toolsForAgent(sb, sc, t.Role, t.Agent, log, extra)
+	if err != nil {
+		log.failed(err)
+		end(PhaseFailed, err)
+		return Result{Phase: PhaseFailed}, err
+	}
+	res, err := loop(ctx, t, set, opts.Ask, log, lim)
+	switch {
+	case err == nil:
+		end(PhaseDone, nil)
+		res.Phase = PhaseDone
+	case errors.Is(err, context.Canceled) && stopAsked():
+		// the user ended it: not an error, and its products stand
+		end(PhaseStopped, nil)
+		res.Phase = PhaseStopped
+		err = nil
+	default:
+		log.failed(err)
+		end(PhaseFailed, err)
+		res.Phase = PhaseFailed
+	}
+	return res, err
+}
+
+// limits are a run's own bounds.
+type limits struct {
+	steps       int
+	timeout     time.Duration
+	turnTimeout time.Duration
+}
+
+func limitsOf(o Options) limits {
+	l := limits{steps: MaxSteps, timeout: RunTimeout, turnTimeout: TurnTimeout}
+	if o.MaxSteps > 0 {
+		l.steps = o.MaxSteps
+	}
+	if o.Timeout > 0 {
+		l.timeout = o.Timeout
+	}
+	if o.TurnTimeout > 0 {
+		l.turnTimeout = o.TurnTimeout
+	}
+	return l
+}
+
+// loop asks the model, runs the tools it asks for and hands their results
+// back, until it answers without asking for one or a limit ends it.
+func loop(ctx context.Context, t Task, set *Toolset, ask Ask, log *runLog, lim limits) (Result, error) {
+	res := Result{Role: t.Role}
+	msgs := []map[string]any{{"role": "user", "content": []any{map[string]any{"type": "text", "text": t.Prompt}}}}
+	log.said("note", "", "Starting: "+t.Role)
+	for step := 0; ; step++ {
+		if err := ctx.Err(); err != nil {
+			return res, err
+		}
+		if step >= lim.steps {
+			return res, fmt.Errorf("the run took %d turns without finishing", lim.steps)
+		}
+		log.step()
+		log.phase(PhaseThinking)
+		log.progress(step, lim.steps)
+		turnCtx, cancel := context.WithTimeout(ctx, lim.turnTimeout)
+		turn, err := ask(turnCtx, Request{
+			Model: t.Model, Effort: t.Effort, System: t.System,
+			Messages: msgs, Tools: set.Tools(),
+		})
+		cancel()
+		if err != nil {
+			if ctx.Err() != nil {
+				return res, ctx.Err()
+			}
+			return res, err
+		}
+		res.Steps = step + 1
+		if said := strings.TrimSpace(turn.Text); said != "" {
+			log.said("agent", "", said)
+			res.Text = said
+		}
+		if len(turn.Calls) == 0 {
+			return res, nil
+		}
+		msgs = append(msgs, assistantMessage(turn))
+		results := make([]any, 0, len(turn.Calls))
+		for _, c := range turn.Calls {
+			if err := ctx.Err(); err != nil {
+				return res, err
+			}
+			log.phase(PhaseTool)
+			out, failed := runCall(ctx, set, log, c)
+			if !failed {
+				switch c.Name {
+				case ToolVaultWrite:
+					res.Wrote++
+					log.wrote(1)
+				case ToolMemorySave:
+					res.Saved++
+					log.saved(1)
+				}
+			}
+			block := map[string]any{"type": "tool_result", "tool_use_id": c.ID, "content": out}
+			if failed {
+				block["is_error"] = true
+			}
+			results = append(results, block)
+		}
+		msgs = append(msgs, map[string]any{"role": "user", "content": results})
+	}
+}
+
+// assistantMessage is one answer of the model as the conversation keeps
+// it: its text, then a tool_use block for each call.
+func assistantMessage(turn Turn) map[string]any {
+	content := []any{}
+	if said := strings.TrimSpace(turn.Text); said != "" {
+		content = append(content, map[string]any{"type": "text", "text": said})
+	}
+	for _, c := range turn.Calls {
+		var obj any
+		if err := json.Unmarshal(c.Input, &obj); err != nil || obj == nil {
+			obj = map[string]any{}
+		}
+		content = append(content, map[string]any{"type": "tool_use", "id": c.ID, "name": c.Name, "input": obj})
+	}
+	return map[string]any{"role": "assistant", "content": content}
+}
+
+// runCall runs one call and gives what it said, and whether it failed. A
+// tool that fails says so to the model rather than ending the run: a model
+// given a refused path can try another, as one given a bad argument can. A
+// tool that panics is one such failure: a run is started from magpie's own
+// backend, so a panic left to unwind would end every agent's gateway, not
+// this run.
+func runCall(ctx context.Context, set *Toolset, log *runLog, c Call) (out string, failed bool) {
+	if c.Name == "" {
+		return "error: a tool call with no name", true
+	}
+	tool, ok := set.Get(c.Name)
+	if !ok {
+		return fmt.Sprintf("error: there is no tool named %q; the tools are %s", c.Name, strings.Join(set.Names(), ", ")), true
+	}
+	log.said("tool", c.Name, brief(c.Input))
+	defer func() {
+		if r := recover(); r != nil {
+			err := fmt.Errorf("%s failed: %v", c.Name, r)
+			log.said("error", c.Name, err.Error())
+			out, failed = "error: "+err.Error(), true
+		}
+	}()
+	out, err := tool.Call(ctx, c.Input)
+	if err != nil {
+		log.said("error", c.Name, err.Error())
+		return "error: " + err.Error(), true
+	}
+	log.said("tool", c.Name, out)
+	return out, false
+}
+
+// registerStop binds the cancel of the run going to its role; a call with
+// "" lets it go.
+func registerStop(role string, cancel context.CancelFunc) {
+	stopState.mu.Lock()
+	defer stopState.mu.Unlock()
+	stopState.role, stopState.cancel = role, cancel
+	if cancel != nil {
+		stopState.asked = false
+	}
+}
+
+// Stop ends the run going in this process, if any. Its products stand and
+// what it didn't do is done by the next run.
+func Stop() {
+	stopState.mu.Lock()
+	defer stopState.mu.Unlock()
+	if stopState.cancel != nil {
+		stopState.asked = true
+		stopState.cancel()
+	}
+}
+
+// stopAsked says whether Stop ended the run going.
+func stopAsked() bool {
+	stopState.mu.Lock()
+	defer stopState.mu.Unlock()
+	return stopState.asked
+}
diff --git a/internal/memagent/loop_test.go b/internal/memagent/loop_test.go
