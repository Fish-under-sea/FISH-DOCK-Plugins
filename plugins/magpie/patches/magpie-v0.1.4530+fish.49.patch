+// The presets are both on the built-in magpie agent, and neither picks a
+// model: the model is an internal route, not a choice the page offers.
+func TestBuiltinPresets(t *testing.T) {
+	b := Builtin()
+	if b.Version != Version || len(b.Agents) != 2 {
+		t.Fatalf("presets: %+v", b)
+	}
+	for _, a := range b.Agents {
+		if !a.Builtin || a.Agent != DefaultAgent || a.Model == "" {
+			t.Fatalf("preset %q: %+v", a.ID, a)
+		}
+	}
+	// the design's two presets: one for learn and organize, one for dream
+	curator, ok := b.Get("memory-curator")
+	if !ok || curator.Role != Learn+"|"+Organize {
+		t.Fatalf("curator: %+v ok=%v", curator, ok)
+	}
+	dreamer, ok := b.Get("dreamer")
+	if !ok || dreamer.Role != Dream {
+		t.Fatalf("dreamer: %+v ok=%v", dreamer, ok)
+	}
+	if b.Defaults[Learn] != "memory-curator" || b.Defaults[Organize] != "memory-curator" || b.Defaults[Dream] != "dreamer" {
+		t.Fatalf("defaults: %+v", b.Defaults)
+	}
+	// the presets a caller gets are its own: a change to them doesn't reach
+	// the next caller
+	b.Agents[0].Name = "changed"
+	if again := Builtin(); again.Agents[0].Name == "changed" {
+		t.Fatal("Builtin handed out a shared agents list")
+	}
+	if again := Builtin(); len(again.Agents[0].Scopes) > 0 {
+		again.Agents[0].Scopes[0] = "changed"
+		if third := Builtin(); third.Agents[0].Scopes[0] == "changed" {
+			t.Fatal("Builtin handed out a shared scopes list")
+		}
+	}
+	if again := Builtin(); again.Defaults != nil {
+		again.Defaults[Learn] = "changed"
+		if third := Builtin(); third.Defaults[Learn] == "changed" {
+			t.Fatal("Builtin handed out a shared defaults map")
+		}
+	}
+}
