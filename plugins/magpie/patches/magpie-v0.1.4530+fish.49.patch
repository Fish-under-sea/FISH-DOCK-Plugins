+
+// Tool is one tool a run may call: its name, what it does and its
+// arguments' schema, as an agent's tools are given to a model.
+type Tool struct {
+	Name        string                                                        `json:"name"`
+	Description string                                                        `json:"description"`
+	Schema      map[string]any                                                `json:"schema"`
+	Call        func(ctx context.Context, in json.RawMessage) (string, error) `json:"-"`
+}
+
+// The tools' names: the memory server's four, then the vault's and the
+// run's own folder's.
+const (
+	ToolMemorySearch  = "memory_search"
+	ToolMemorySave    = "memory_save"
+	ToolMemoryForget  = "memory_forget"
+	ToolMemoryContext = "memory_context"
+	ToolVaultList     = "vault_list"
+	ToolVaultRead     = "vault_read"
+	ToolVaultWrite    = "vault_write"
+	ToolScratchWrite  = "scratch_write"
+	ToolScratchRead   = "scratch_read"
+	// the changes the user's own memory is never given by a machine, but
+	// the proposal's flow asks for: kept, to review, set aside, replaced
+	ToolMemoryRemove  = "memory_remove"
+	ToolMemoryPromote = "memory_promote"
+	ToolMemoryStatus  = "memory_status"
+)
+
+// Toolset is the tools one run may use, by name.
+type Toolset struct {
+	tools []Tool
+	by    map[string]Tool
+}
+
+// Tools is the toolset as the model is given them.
+func (s *Toolset) Tools() []Tool { return s.tools }
+
+// Get is the tool named name.
+func (s *Toolset) Get(name string) (Tool, bool) {
+	t, ok := s.by[name]
+	return t, ok
+}
+
+// Names are the tools' names, in the order they are given.
+func (s *Toolset) Names() []string {
+	out := make([]string, 0, len(s.tools))
+	for _, t := range s.tools {
+		out = append(out, t.Name)
+	}
+	return out
+}
+
+// toolsFor is the tools a run has: the memory tools, the vault's and the
+// run's own folder's, then the ones the agent's mcp.json adds. A name given
+// twice is refused: a model can't be shown two tools under one name.
+func toolsFor(sb *Sandbox, sc *Scratch, role string, log *runLog, extra []Tool) (*Toolset, error) {
+	return toolsForAgent(sb, sc, role, AgentID, log, extra)
+}
+
+func toolsForAgent(sb *Sandbox, sc *Scratch, role, agent string, log *runLog, extra []Tool) (*Toolset, error) {
+	set := &Toolset{by: map[string]Tool{}}
+	add := func(ts ...Tool) error {
+		for _, t := range ts {
+			if t.Name == "" || t.Call == nil {
+				return fmt.Errorf("a tool needs a name and a call: %q", t.Name)
+			}
+			if _, ok := set.by[t.Name]; ok {
+				return fmt.Errorf("two tools are named %q", t.Name)
+			}
+			set.by[t.Name] = t
+			set.tools = append(set.tools, t)
+		}
+		return nil
+	}
+	if err := add(memoryTools(sb, role, log)...); err != nil {
+		return nil, err
+	}
+	if err := add(vaultToolsFor(sb, role, agent, log)...); err != nil {
+		return nil, err
+	}
+	if err := add(scratchTools(sc)...); err != nil {
+		return nil, err
+	}
+	if err := add(extra...); err != nil {
+		return nil, err
+	}
+	return set, nil
+}
+
+// memoryTools are the memory server's four tools, as a run uses them: the
+// same names, arguments and answers an agent sees through MCP, so the
+// memory agent's instructions read the same here as in an agent.
+func memoryTools(sb *Sandbox, role string, log *runLog) []Tool {
+	return []Tool{
+		{
+			Name:        ToolMemorySearch,
+			Description: "Searches what is remembered from earlier conversations with the user, in any agent: their preferences, rules, facts about them and their projects, how things are done. Search before asking the user something they may have told you before.",
+			Schema: map[string]any{
+				"type": "object",
+				"properties": map[string]any{
+					"query": map[string]any{"type": "string", "description": "What to look for, in a few words"},
+					"scope": map[string]any{"type": "string", "enum": []string{"all", "project", "global"}, "description": "project: this project's memories; global: those for every project; all (default): both, and yours"},
+					"kind":  map[string]any{"type": "string", "enum": memory.Kinds, "description": "Only memories of this kind"},
+					"tags":  map[string]any{"type": "array", "items": map[string]any{"type": "string"}, "description": "Only memories with every one of these tags"},
+					"limit": map[string]any{"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
+				},
+			},
+			Call: memorySearchCall,
+		},
+		{
+			Name:        ToolMemorySave,
+			Description: "Remembers one thing for later conversations, in every agent: a preference or rule the user stated, a correction they made, a fact about them or the project that will still hold next time. One fact per memory, written so it reads on its own. Saving what is already remembered merges into it.",
+			Schema: map[string]any{
+				"type": "object",
+				"properties": map[string]any{
+					"text":  map[string]any{"type": "string", "description": "The memory, one self-contained fact or instruction"},
+					"kind":  map[string]any{"type": "string", "enum": memory.Kinds, "description": "profile, preference, rule, reference, fact, procedure or episode"},
+					"scope": map[string]any{"type": "string", "enum": []string{"project", "global", "agent"}, "description": "project: holds only in this project; global: holds everywhere; agent: only for the memory agent"},
+					"tags":  map[string]any{"type": "array", "items": map[string]any{"type": "string"}, "description": "A few words to find it by"},
+					"why":   map[string]any{"type": "string", "description": "Why it holds, when the user said, so it can be judged later"},
+					"id":    map[string]any{"type": "string", "description": "A memory's id, to change that memory rather than save a new one"},
+				},
+				"required": []string{"text"},
+			},
+			Call: memorySaveCall(sb, role, log),
+		},
+		{
+			Name:        ToolMemoryForget,
+			Description: "Sets a memory aside when the user says it is wrong or no longer holds. It is kept for the user to look at, but no longer searched or given to agents.",
+			Schema: map[string]any{
+				"type":       "object",
+				"properties": map[string]any{"id": map[string]any{"type": "string", "description": "The memory's id, from memory_search"}},
+				"required":   []string{"id"},
+			},
+			Call: memoryForgetCall(sb, role, log),
+		},
+		{
+			Name:        ToolMemoryRemove,
+			Description: "Deletes memories for good, when the user asks for one to be gone rather than set aside. Only what a machine saved; a memory the user wrote or edited is kept and the conflict written down.",
+			Schema: map[string]any{
+				"type": "object",
+				"properties": map[string]any{
+					"ids": map[string]any{"type": "array", "items": map[string]any{"type": "string"}, "description": "The memories' ids, from memory_search"},
+				},
+				"required": []string{"ids"},
+			},
+			Call: memoryRemoveCall(sb, role, log),
+		},
+		{
+			Name:        ToolMemoryPromote,
+			Description: "Promotes memories that say the same in two or more projects into one everyone has. What the user wrote is the one kept whenever it is among them.",
+			Schema: map[string]any{
+				"type": "object",
+				"properties": map[string]any{
+					"ids": map[string]any{"type": "array", "items": map[string]any{"type": "string"}, "description": "The memories' ids, from memory_search"},
+				},
+				"required": []string{"ids"},
+			},
+			Call: memoryPromoteCall(role, log),
+		},
+		{
+			Name:        ToolMemoryStatus,
+			Description: "Gives a memory one of the states the user picks from what was proposed: active (kept), candidate (to review), archived (set aside) or superseded.",
+			Schema: map[string]any{
+				"type": "object",
+				"properties": map[string]any{
+					"status": map[string]any{"type": "string", "enum": []string{memory.Active, memory.Candidate, memory.Archived, memory.Superseded}, "description": "The state to give it"},
+					"ids":    map[string]any{"type": "array", "items": map[string]any{"type": "string"}, "description": "The memories' ids, from memory_search"},
+				},
+				"required": []string{"status", "ids"},
+			},
+			Call: memoryStatusCall(role, log),
+		},
+		{
+			Name:        ToolMemoryContext,
+			Description: "Says who the memory server takes you for and where a search looks: the agent and the scopes.",
+			Schema:      map[string]any{"type": "object", "properties": map[string]any{}},
+			Call: func(context.Context, json.RawMessage) (string, error) {
+				return "Agent: " + AgentID + " (the memory agent, by its id).\nScopes: " + memory.Global + ", project:<key>, agent:" + AgentID + ".\n", nil
+			},
+		},
+	}
+}
+
+// vaultTools are the vault's tools: a listing, a note read, and a note
+// written into a folder a run may write.
+func vaultTools(sb *Sandbox, log *runLog) []Tool {
+	return vaultToolsFor(sb, "", AgentID, log)
+}
+
+func vaultToolsFor(sb *Sandbox, role, agent string, log *runLog) []Tool {
+	readDesc := strings.Join(Readable, ", ")
+	writeDesc := strings.Join(Writable, ", ")
+	if sb != nil {
+		if sb.readAll {
+			readDesc = "the vault (excluding " + strings.Join(sb.deny, ", ") + ")"
+		} else if len(sb.readAllow) > 0 {
+			readDesc = strings.Join(sb.readAllow, ", ")
+		}
+		if len(sb.writeAllow) > 0 {
+			writeDesc = strings.Join(sb.writeAllow, ", ")
+		}
+	}
+	return []Tool{
+		{
+			Name:        ToolVaultList,
+			Description: "Lists a folder of the knowledge vault: " + readDesc + ". With no path, lists those folders.",
+			Schema: map[string]any{
+				"type":       "object",
+				"properties": map[string]any{"path": map[string]any{"type": "string", "description": "A folder such as wiki or inspirations"}},
+			},
+			Call: func(_ context.Context, in json.RawMessage) (string, error) {
+				return vaultListCall(sb, role, agent, log, in)
+			},
+		},
+		{
+			Name:        ToolVaultRead,
+			Description: "Reads a note of the knowledge vault, under " + readDesc + ". The path is relative to the vault.",
+			Schema: map[string]any{
+				"type":       "object",
+				"properties": map[string]any{"path": map[string]any{"type": "string", "description": "The note's path, such as wiki/release-notes.md"}},
+				"required":   []string{"path"},
+			},
+			Call: func(_ context.Context, in json.RawMessage) (string, error) {
+				return vaultReadCall(sb, role, agent, log, in)
+			},
+		},
+		{
+			Name:        ToolVaultWrite,
+			Description: "Writes a note into the knowledge vault, under " + writeDesc + ". It replaces a note of that name; nothing else in the vault is touched.",
+			Schema: map[string]any{
+				"type": "object",
+				"properties": map[string]any{
+					"path": map[string]any{"type": "string", "description": "The note's path, such as dreams/2026-11-16.md"},
+					"text": map[string]any{"type": "string", "description": "The note, in Markdown"},
+				},
+				"required": []string{"path", "text"},
+			},
+			Call: func(_ context.Context, in json.RawMessage) (string, error) {
+				return vaultWriteCall(sb, role, agent, log, in)
+			},
+		},
+	}
+}
+
+// scratchTools are the run's own folder: for what is too big to keep in
+// the conversation. It goes when the run ends.
+func scratchTools(sc *Scratch) []Tool {
+	return []Tool{
+		{
+			Name:        ToolScratchWrite,
+			Description: "Writes a file into this run's own folder, for notes too big to keep in the conversation. The folder is dropped when the run ends.",
+			Schema: map[string]any{
+				"type": "object",
+				"properties": map[string]any{
+					"path": map[string]any{"type": "string", "description": "A file name, such as notes.md"},
+					"text": map[string]any{"type": "string", "description": "What to write"},
+				},
+				"required": []string{"path", "text"},
+			},
+			Call: func(_ context.Context, in json.RawMessage) (string, error) {
+				var a struct {
+					Path string `json:"path"`
+					Text string `json:"text"`
+				}
+				if err := decode(in, &a); err != nil {
+					return "", err
+				}
+				if err := sc.Write(a.Path, []byte(a.Text)); err != nil {
+					return "", err
+				}
+				return "wrote " + a.Path + " in this run's folder", nil
+			},
+		},
+		{
+			Name:        ToolScratchRead,
+			Description: "Reads a file this run wrote into its own folder.",
+			Schema: map[string]any{
+				"type":       "object",
+				"properties": map[string]any{"path": map[string]any{"type": "string", "description": "The file's name"}},
+				"required":   []string{"path"},
+			},
+			Call: func(_ context.Context, in json.RawMessage) (string, error) {
+				var a struct {
+					Path string `json:"path"`
+				}
+				if err := decode(in, &a); err != nil {
+					return "", err
+				}
+				b, err := sc.Read(a.Path)
+				if err != nil {
+					return "", err
+				}
+				return string(b), nil
+			},
+		},
+	}
+}
+
+// decode reads a call's arguments; none is the tool's own defaults.
+func decode(in json.RawMessage, v any) error {
+	if len(strings.TrimSpace(string(in))) == 0 {
+		return nil
+	}
+	if err := json.Unmarshal(in, v); err != nil {
+		return fmt.Errorf("the arguments aren't an object: %v", err)
+	}
+	return nil
+}
+
+// brief is a call's arguments as one short line of the transcript.
+func brief(in json.RawMessage) string {
+	s := strings.Join(strings.Fields(string(in)), " ")
+	if r := []rune(s); len(r) > 300 {
+		return string(r[:300]) + "…"
+	}
+	return s
+}
+
+// memorySearchCall answers memory_search as the MCP server does.
+func memorySearchCall(_ context.Context, in json.RawMessage) (string, error) {
+	var a struct {
+		Query string   `json:"query"`
+		Scope string   `json:"scope"`
+		Kind  string   `json:"kind"`
+		Tags  []string `json:"tags"`
+		Limit int      `json:"limit"`
+	}
+	if err := decode(in, &a); err != nil {
+		return "", err
+	}
+	scopes, err := scopesFor(a.Scope)
+	if err != nil {
+		return "", err
+	}
+	q := memory.Query{Text: a.Query, Scopes: scopes, Tags: a.Tags, Limit: min(max(a.Limit, 0), 50)}
+	if q.Limit == 0 {
+		q.Limit = 10
+	}
+	if k := strings.ToLower(strings.TrimSpace(a.Kind)); k != "" {
+		if !slices.Contains(memory.Kinds, k) {
+			return "", fmt.Errorf("kind %q isn't one of %s", a.Kind, strings.Join(memory.Kinds, ", "))
+		}
+		q.Kinds = []string{k}
+	}
+	hits, err := memory.Search(q)
+	if err != nil {
+		return "", fmt.Errorf("memory can't be read now: %v", err)
+	}
+	where := "(looked in: " + strings.Join(scopes, ", ") + ")"
+	if len(hits) == 0 {
+		if strings.TrimSpace(a.Query) == "" {
+			return "Nothing is remembered here yet. " + where, nil
+		}
+		return "Nothing remembered matches " + quoted(a.Query) + ". " + where, nil
+	}
+	var b strings.Builder
+	for _, h := range hits {
+		b.WriteString(memoryLine(h.Memory))
+		b.WriteString("\n")
+	}
+	b.WriteString(where)
+	return b.String(), nil
+}
+
+// scopesFor is the scopes a search with which looks in. A run has no
+// project: its caller names one, or the scope is everyone's and its own.
+func scopesFor(which string) ([]string, error) {
+	switch strings.ToLower(strings.TrimSpace(which)) {
+	case "", "all":
+		return []string{memory.Global, "agent:" + AgentID}, nil
+	case "global":
+		return []string{memory.Global}, nil
+	case "project":
+		return nil, errors.New("no project is named for this run: use scope global or all")
+	}
+	return nil, fmt.Errorf("scope %q isn't all, project or global", which)
+}
+
+// memoryLine is one memory as the model reads it: its id, kind, where it
+// holds, tags, text and why.
+func memoryLine(m *memory.Memory) string {
+	where := "everywhere"
+	switch {
+	case strings.HasPrefix(m.Scope, "agent:"):
+		where = "only for you (" + strings.TrimPrefix(m.Scope, "agent:") + ")"
+	case strings.HasPrefix(m.Scope, "project:"):
+		where = "project " + strings.TrimPrefix(m.Scope, "project:")
+	}
+	l := fmt.Sprintf("[%s] %s, %s", m.ID, m.Kind, where)
+	if len(m.Tags) > 0 {
+		l += ", #" + strings.Join(m.Tags, " #")
+	}
+	if m.Pinned {
+		l += ", pinned"
+	}
+	l += ", " + m.Updated.In(time.Local).Format("2006-01-02T15:04Z07:00") + ": " + oneLine(m.Text)
+	if m.Why != "" {
+		l += " (why: " + oneLine(m.Why) + ")"
+	}
+	return l
+}
+
+func oneLine(s string) string { return strings.Join(strings.Fields(s), " ") }
+
+func quoted(s string) string {
+	b, _ := json.Marshal(strings.TrimSpace(s))
+	return string(b)
+}
+
+// memorySaveCall answers memory_save as the MCP server does, kept as an
+// agent's save: a text the user wrote is never changed by it. Every attempt
+// is audited, and one refused because the memory is the user's is written
+// into the vault's conflict log, with the memory left as it was.
+func memorySaveCall(sb *Sandbox, role string, log *runLog) func(context.Context, json.RawMessage) (string, error) {
+	return func(_ context.Context, in json.RawMessage) (string, error) {
+		var a struct {
+			Text  string   `json:"text"`
+			Kind  string   `json:"kind"`
+			Scope string   `json:"scope"`
+			Tags  []string `json:"tags"`
+			Why   string   `json:"why"`
+			ID    string   `json:"id"`
+		}
+		if err := decode(in, &a); err != nil {
+			LogAudit(NewAuditChange(AuditSave, role, "", "", err))
+			return "", err
+		}
+		mi := memory.Input{}
+		text := strings.TrimSpace(a.Text)
+		if text == "" && strings.TrimSpace(a.ID) == "" {
+			err := errors.New("memory_save needs the text to remember")
+			LogAudit(NewAuditChange(AuditSave, role, "", "", err))
+			return "", err
+		}
+		if text != "" {
+			mi.Text = &text
+		}
+		if k := strings.ToLower(strings.TrimSpace(a.Kind)); k != "" {
+			mi.Kind = &k
+		}
+		if a.Tags != nil {
+			tags := a.Tags
+			mi.Tags = &tags
+		}
+		if w := strings.TrimSpace(a.Why); w != "" {
+			mi.Why = &w
+		}
+		switch which := strings.ToLower(strings.TrimSpace(a.Scope)); which {
+		case "":
+		case "global":
+			scope := memory.Global
+			mi.Scope = &scope
+		case "agent":
+			scope := "agent:" + AgentID
+			mi.Scope = &scope
+		case "project":
+			err := errors.New("no project is named for this run: use scope global or agent")
+			LogAudit(NewAuditChange(AuditSave, role, "", "", err))
+			return "", err
+		default:
+			err := fmt.Errorf("scope %q isn't project, global or agent", a.Scope)
+			LogAudit(NewAuditChange(AuditSave, role, "", "", err))
+			return "", err
+		}
+		if id := strings.TrimSpace(a.ID); id != "" {
+			// what is there now decides: a memory the user wrote or edited
+			// is theirs, and a machine change leaves its words alone
+			was, err := FindMemory(id)
+			if err != nil {
+				LogAudit(NewAuditChange(AuditSave, role, id, "", err))
+				return "", err
+			}
+			if c := refusedChange(was, mi); c != nil {
+				noteConflict(sb, role, c, AuditSave, log)
+				return "", c
+			}
+			m, err := memory.Edit(id, mi, false)
+			LogAudit(NewAuditSave(role, m, false, id, err))
+			if err != nil {
+				return "", err
+			}
+			return "Changed: " + memoryLine(m), nil
+		}
+		if mi.Kind == nil {
+			k := memory.Fact
+			mi.Kind = &k
+		}
+		m, added, err := memory.Save(mi, memory.FromAgent, &memory.Source{Agent: AgentID}, nil)
+		if err == nil && !added && m != nil {
+			// merged into a memory already there: if that one is the user's,
+			// the merge has changed their why, kind or tags
+			if no, why := refused(m); no && (mi.Why != nil || mi.Kind != nil || mi.Tags != nil) {
+				c := &ConflictError{ID: m.ID, What: why, User: oneLine(m.Text)}
+				noteConflict(sb, role, c, AuditSave, log)
+				LogAudit(Audit{Action: AuditSave, Role: role, Agent: AgentID, ID: m.ID, Result: "refused", Error: c.Error()})
+				return "Already remembered, and it is the user's own: it was left as they wrote it: " + memoryLine(m), nil
+			}
+		}
+		LogAudit(NewAuditSave(role, m, added, "", err))
+		if err != nil {
+			return "", err
+		}
+		if !added {
+			return "Already remembered, merged: " + memoryLine(m), nil
+		}
+		// the loop counts what the run saved, from the call alone: a save
+		// that merged changed nothing to count here
+		return "Remembered: " + memoryLine(m), nil
+	}
+}
+
+// noteConflict writes a refused change into the vault's conflict log and
+// says it in the run's transcript. A conflict that can't be written is
+// noted in the audit line and passed over: the refusal stands either way.
+func noteConflict(sb *Sandbox, role string, c *ConflictError, action string, log *runLog) {
+	LogAudit(Audit{Action: action, Role: role, Agent: AgentID, ID: c.ID, Result: "conflict", Error: c.Error()})
+	if err := LogConflict(sb, role, c, action); err != nil {
+		LogAudit(Audit{Action: action, Role: role, Agent: AgentID, ID: c.ID, Result: "conflict", Error: "conflict not written: " + err.Error()})
+		log.said("error", action, "the conflict with the user's memory wasn't written into "+ConflictsPath+": "+err.Error())
+		return
+	}
+	log.said("note", "", "refused a change to the user's memory "+c.ID+"; it is in "+ConflictsPath)
+}
+
+// memoryForgetCall answers memory_forget: the memory is set aside, not
+// deleted. A memory the user wrote or edited is never set aside by a
+// machine: that is a conflict, and it is written down.
+func memoryForgetCall(sb *Sandbox, role string, log *runLog) func(context.Context, json.RawMessage) (string, error) {
+	return func(_ context.Context, in json.RawMessage) (string, error) {
+		var a struct {
+			ID string `json:"id"`
+		}
+		if err := decode(in, &a); err != nil {
+			LogAudit(NewAuditChange(AuditForget, role, "", "", err))
+			return "", err
+		}
+		id := strings.TrimSpace(a.ID)
+		if id == "" {
+			err := errors.New("memory_forget needs the memory's id, from memory_search")
+			LogAudit(NewAuditChange(AuditForget, role, "", "", err))
+			return "", err
+		}
+		was, err := FindMemory(id)
+		if err != nil {
+			LogAudit(NewAuditChange(AuditForget, role, id, "", err))
+			return "", err
+		}
+		if was != nil {
+			if no, why := refused(was); no {
+				c := &ConflictError{ID: was.ID, What: why, User: oneLine(was.Text)}
+				noteConflict(sb, role, c, AuditForget, log)
+				return "", c
+			}
+		}
+		m, err := memory.Forget(id)
+		LogAudit(NewAuditChange(AuditForget, role, id, "forgotten", err))
+		if err != nil {
+			return "", err
+		}
+		return "Forgotten: [" + m.ID + "] " + oneLine(m.Text), nil
+	}
+}
+
+// memoryRemoveCall answers memory_remove: the memories are deleted for
+// good. One the user wrote or edited is kept, and the refusal is written
+// down: a machine never disposes of what they wrote.
+func memoryRemoveCall(sb *Sandbox, role string, log *runLog) func(context.Context, json.RawMessage) (string, error) {
+	return func(_ context.Context, in json.RawMessage) (string, error) {
+		var a struct {
+			IDs []string `json:"ids"`
+		}
+		if err := decode(in, &a); err != nil {
+			LogAudit(NewAuditChange(AuditRemove, role, "", "", err))
+			return "", err
+		}
+		ids := cleanIDs(a.IDs)
+		if len(ids) == 0 {
+			err := errors.New("memory_remove needs the ids to delete")
+			LogAudit(NewAuditChange(AuditRemove, role, "", "", err))
+			return "", err
+		}
+		var keep, gone []string
+		for _, id := range ids {
+			m, err := FindMemory(id)
+			if err != nil {
+				LogAudit(NewAuditChange(AuditRemove, role, id, "", err))
+				return "", err
+			}
+			if m == nil {
+				continue // no longer there: nothing to delete
+			}
+			if no, why := refused(m); no {
+				c := &ConflictError{ID: m.ID, What: why, User: oneLine(m.Text)}
+				noteConflict(sb, role, c, AuditRemove, log)
+				keep = append(keep, m.ID)
+				continue
+			}
+			gone = append(gone, m.ID)
+		}
+		if len(gone) == 0 {
+			return "kept, they are the user's own: " + strings.Join(keep, ", "), nil
+		}
+		err := memory.Remove(gone...)
+		for _, id := range gone {
+			LogAudit(NewAuditChange(AuditRemove, role, id, "removed", err))
+		}
+		if err != nil {
+			return "", err
+		}
+		out := "Removed: " + strings.Join(gone, ", ")
+		if len(keep) > 0 {
+			out += "; kept, they are the user's own: " + strings.Join(keep, ", ")
+		}
+		return out, nil
+	}
+}
+
+// memoryPromoteCall answers memory_promote: memories saying the same in two
+// projects become one everyone has. memory's own rule keeps the user's
+// among them ("TestPromoteKeepsTheUsersOwn"), so nothing is refused here;
+// what it did is written down.
+func memoryPromoteCall(role string, log *runLog) func(context.Context, json.RawMessage) (string, error) {
+	return func(_ context.Context, in json.RawMessage) (string, error) {
+		var a struct {
+			IDs []string `json:"ids"`
+		}
+		if err := decode(in, &a); err != nil {
+			LogAudit(NewAuditChange(AuditPromote, role, "", "", err))
+			return "", err
+		}
+		ids := cleanIDs(a.IDs)
+		m, err := memory.Promote(ids)
+		id := ""
+		if m != nil {
+			id = m.ID
+		}
+		LogAudit(NewAuditChange(AuditPromote, role, id, "promoted", err))
+		if err != nil {
+			return "", err
+		}
+		return "Promoted: " + memoryLine(m), nil
+	}
+}
+
+// memoryStatusCall answers memory_status: it gives memories one of the
+// states the user picks from. It is the machine's to propose — a candidate
+// to review, or one it proposed set aside — but taking the user's own
+// memory out of use is theirs, and refused here.
+func memoryStatusCall(role string, log *runLog) func(context.Context, json.RawMessage) (string, error) {
+	return func(_ context.Context, in json.RawMessage) (string, error) {
+		var a struct {
+			Status string   `json:"status"`
+			IDs    []string `json:"ids"`
+		}
+		if err := decode(in, &a); err != nil {
+			LogAudit(NewAuditChange(AuditStatus, role, "", "", err))
+			return "", err
+		}
+		status := strings.ToLower(strings.TrimSpace(a.Status))
+		ids := cleanIDs(a.IDs)
+		if len(ids) == 0 {
+			err := errors.New("memory_status needs the ids to change")
+			LogAudit(NewAuditChange(AuditStatus, role, "", "", err))
+			return "", err
+		}
+		// the user's own memory: a candidate of theirs kept, or one of
+		// theirs marked failed, is their call, not a run's
+		var ours []string
+		for _, id := range ids {
+			m, err := FindMemory(id)
+			if err != nil {
+				LogAudit(NewAuditChange(AuditStatus, role, id, "", err))
+				return "", err
+			}
+			if m == nil {
+				continue
+			}
+			if no, _ := refused(m); no && (status == memory.Active || status == memory.Archived) {
+				return "", fmt.Errorf("memory %s is the user's own: only they decide whether it stays in use", m.ID)
+			}
+			ours = append(ours, m.ID)
+		}
+		n, err := memory.SetStatus(status, ours...)
+		for _, id := range ours {
+			LogAudit(NewAuditChange(AuditStatus, role, id, status, err))
+		}
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d memories are now %s", n, status), nil
+	}
+}
+
+// cleanIDs are ids as a call gives them: trimmed, without blanks or
+// repeats, in the order given.
+func cleanIDs(ids []string) []string {
+	out := make([]string, 0, len(ids))
+	for _, id := range ids {
+		id = strings.TrimSpace(id)
+		if id != "" && !slices.Contains(out, id) {
+			out = append(out, id)
+		}
+	}
+	return out
+}
+
+// vaultListCall answers vault_list.
+func vaultListCall(sb *Sandbox, role, agent string, log *runLog, in json.RawMessage) (string, error) {
+	var a struct {
+		Path string `json:"path"`
+	}
+	if err := decode(in, &a); err != nil {
+		return "", err
+	}
+	entries, err := sb.List(a.Path)
+	if err != nil {
+		recordSandboxViolation(sb, role, agent, "list", ToolVaultList, a.Path, log, err)
+		return "", err
+	}
+	if len(entries) == 0 {
+		return "(nothing here)", nil
+	}
+	var b strings.Builder
+	for _, e := range entries {
+		if e.Dir {
+			b.WriteString(e.Name + "/\n")
+			continue
+		}
+		fmt.Fprintf(&b, "%s (%d bytes)\n", e.Name, e.Size)
+	}
+	return strings.TrimRight(b.String(), "\n"), nil
+}
+
+// vaultReadCall answers vault_read.
+func vaultReadCall(sb *Sandbox, role, agent string, log *runLog, in json.RawMessage) (string, error) {
+	var a struct {
+		Path string `json:"path"`
+	}
+	if err := decode(in, &a); err != nil {
+		return "", err
+	}
+	b, err := sb.Read(a.Path)
+	if err != nil {
+		recordSandboxViolation(sb, role, agent, "read", ToolVaultRead, a.Path, log, err)
+		return "", err
+	}
+	return string(b), nil
+}
+
+// vaultWriteCall answers vault_write: the note is written under a folder a
+// run may write, and nowhere else.
+func vaultWriteCall(sb *Sandbox, role, agent string, log *runLog, in json.RawMessage) (string, error) {
+	var a struct {
+		Path string `json:"path"`
+		Text string `json:"text"`
+	}
+	if err := decode(in, &a); err != nil {
+		return "", err
+	}
+	if err := sb.Write(a.Path, []byte(a.Text)); err != nil {
+		recordSandboxViolation(sb, role, agent, "write", ToolVaultWrite, a.Path, log, err)
+		return "", err
+	}
+	log.said("note", "", "wrote "+a.Path+" into the vault")
+	return "wrote " + a.Path, nil
+}
+
+func recordSandboxViolation(sb *Sandbox, role, agent, op, tool, target string, log *runLog, err error) {
+	if errors.Is(err, ErrOutside) {
+		_ = LogViolation(sb, role, agent, op, target, err)
+	}
+	if log != nil {
+		log.said("error", tool, err.Error())
+	}
+}
