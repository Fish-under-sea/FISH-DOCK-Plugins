+// TestDisabledModelsFollowThePage is the whole cycle, through the route the
+// page uses.
+func TestDisabledModelsFollowThePage(t *testing.T) {
+	modelSandbox(t)
+	spec := addFixture(t, writeModelFixture(t))
+	ids, ok := listedModels(t)
+	if !ok || join(ids) != allFive {
+		t.Fatalf("at start the list is %v (listed %v)", ids, ok)
+	}
+	time.Sleep(1100 * time.Millisecond) // a page sets its options once a second at most
