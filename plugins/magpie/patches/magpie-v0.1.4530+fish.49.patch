+// A plugin whose provider went missing asks the host to put it back (#41):
+// what was set aside comes back without the user pressing Add it back, and
+// asking again restores nothing.
+func TestRestorePluginProvidersPutsThemBack(t *testing.T) {
+	claudeHome(t)
+	foo, _ := leftPlugins(t)
+	writeProviders(t, []Provider{{ID: "foo", Models: []string{"foo-1"}}, {ID: "zap", Models: []string{"zap-1"}}})
+	if err := RemovePlugin(context.Background(), foo); err != nil {
+		t.Fatal(err)
+	}
+	if got := storedIDs(t); len(got) != 0 {
+		t.Fatalf("before restoring, providers.json = %v, want none", got)
+	}
+	n, err := RestorePluginProviders(foo)
+	if err != nil || n != 2 {
+		t.Fatalf("RestorePluginProviders = %d, %v; want 2, nil", n, err)
