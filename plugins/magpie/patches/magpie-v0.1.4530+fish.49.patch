@@ -0,0 +1,115 @@
+package plugin
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+// magpie.calls 是页面能问 magpie 做的事的声明。这里钉住四条：只留 magpie
+// 真有的名字、格式不对的丢弃、重复的去重、超过上限截断。
+
+func TestCallsKeepingKeepsOnlyWhatMagpieHas(t *testing.T) {
+	got := callsKeeping([]string{"relay:view", "relay:start", "nope:thing", "usage:summary"})
+	want := []string{"relay:view", "relay:start"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("callsKeeping = %v, want %v", got, want)
+	}
+}
+
+func TestCallsKeepingDropsMalformedNames(t *testing.T) {
+	bad := []string{"Relay:View", "relay", "relay:", ":relay", "relay:view:extra", "relay view", "", strings40()}
+	if got := callsKeeping(bad); len(got) != 0 {
+		t.Fatalf("非法名字被留下了: %v", got)
+	}
+}
+
+func TestCallsKeepingDeduplicatesAndCaps(t *testing.T) {
+	// 超过 maxCalls 的部分截断，且顺序按声明
+	many := make([]string, 0, 40)
+	for i := 0; i < 40; i++ {
+		many = append(many, "relay:view")
+	}
+	// 同一个名字只留一次
+	if got := callsKeeping(many); len(got) != 1 {
+		t.Fatalf("重复名字没去重: %v", got)
+	}
+	// PageCalls 只有 10 条，去重后不足 16；钉住"不超过 16"这个上界
+	if len(callsKeeping(PageCalls)) > maxCalls {
+		t.Fatalf("超过 maxCalls: %d", len(callsKeeping(PageCalls)))
+	}
+	if len(PageCalls) < 5 {
+		t.Fatalf("PageCalls 太少: %v", PageCalls)
+	}
+}
+
+func TestCallsKeepingEmptyIsEmpty(t *testing.T) {
+	if got := callsKeeping(nil); len(got) != 0 {
+		t.Fatalf("nil 应当没有 calls: %v", got)
+	}
+}
+
+// 预装插件美化那两颗要在 PageCalls 里。不在的话 callsKeeping 会把它们静默
+// 丢掉——页面那边只会看到「调用失败」，签到页这一整块就自己隐藏了，线上表现
+// 是"开关根本没出现"，查起来极费劲。
+func TestPageCallsCarryTheBrandSwitch(t *testing.T) {
+	kept := callsKeeping([]string{"brand:status", "brand:set"})
+	want := []string{"brand:status", "brand:set"}
+	if !slices.Equal(kept, want) {
+		t.Fatalf("brand:* 被丢掉了：%v", kept)
+	}
+}
+
+// Window() 从 package.json 读 magpie.calls：有 page 才有效，且只留合法的。
+func TestWindowReadsMagpieCalls(t *testing.T) {
+	dir := t.TempDir()
+	write := func(name, body string) {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("index.html", "<!doctype html><title>relay</title>")
+	write("package.json", `{
+  "name": "page-relay-probe",
+  "magpie": {
+    "page": {"title": "Relay probe", "file": "index.html"},
+    "calls": ["relay:view", "relay:start", "relay:view", "tampered:call"]
+  }
+}`)
+	window, only := Window(dir)
+	if window == nil || window.Page == nil {
+		t.Fatal("没有读到页面")
+	}
+	if !only {
+		t.Fatal("只有页面的插件应当是 only")
+	}
+	want := []string{"relay:view", "relay:start"}
+	if !slices.Equal(window.Calls, want) {
+		t.Fatalf("Calls = %v, want %v", window.Calls, want)
+	}
+}
+
+// 没有页面也没有面板的插件，没有 calls 可声明。
+func TestWindowWithoutPageHasNoCalls(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "package.json"), []byte(`{
+  "main": "index.js",
+  "magpie": {"calls": ["relay:view"]}
+}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if window, _ := Window(dir); window != nil {
+		t.Fatalf("没有页面却拿到了 WindowSpec: %+v", window)
+	}
+}
+
+// strings40 是一个格式合法的超长名字（用于验证 "relay:view:extra" 之外的
+// 长度/字符规则不靠猜）。
+func strings40() string {
+	out := "relay:"
+	for i := 0; i < 40; i++ {
+		out += "a"
+	}
+	return out
+}
diff --git a/internal/plugin/install_errors.go b/internal/plugin/install_errors.go
new file mode 100644
index 0000000..d18bd62
--- /dev/null
+++ b/internal/plugin/install_errors.go
@@ -0,0 +1,92 @@
+package plugin
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// installError is where a plugin's last install failure is kept, by spec:
+// the page says why a plugin the user added is missing rather than only
+// "no such plugin" at every start (#41). Cleared when the package is there
+// again.
+type installError struct {
+	Error string    `json:"error"`
+	At    time.Time `json:"at"`
+}
+
+var installErrorsMu sync.Mutex
+
+func installErrorsPath() string {
+	return filepath.Join(settings.Dir(), "plugin-install-errors.json")
+}
+
+// InstallErrors is the last install failure of each spec, by spec: empty
+// when nothing failed.
+func InstallErrors() map[string]string {
+	installErrorsMu.Lock()
+	defer installErrorsMu.Unlock()
+	all := readInstallErrors()
+	out := make(map[string]string, len(all))
+	for spec, e := range all {
+		out[spec] = e.Error
+	}
+	return out
+}
+
+func readInstallErrors() map[string]installError {
+	b, err := os.ReadFile(installErrorsPath())
+	if err != nil {
+		return map[string]installError{}
+	}
+	var all map[string]installError
+	if json.Unmarshal(b, &all) != nil || all == nil {
+		return map[string]installError{}
+	}
+	return all
+}
+
+func writeInstallErrors(all map[string]installError) {
+	if len(all) == 0 {
+		_ = os.Remove(installErrorsPath())
+		return
+	}
+	b, err := json.MarshalIndent(all, "", "  ")
+	if err != nil {
+		return
+	}
+	_ = writeWhole(installErrorsPath(), append(b, '\n'))
+}
+
+// recordInstallError keeps why spec couldn't be installed, for the page.
+func recordInstallError(spec string, cause error) {
+	if cause == nil {
+		return
+	}
+	installErrorsMu.Lock()
+	defer installErrorsMu.Unlock()
+	all := readInstallErrors()
+	msg := cause.Error()
+	// bun 的失败信息可能很长（整段安装输出）：留一段够定位的就行，别把文件撑大
+	if r := []rune(msg); len(r) > 2000 {
+		msg = string(r[:2000]) + "…"
+	}
+	all[spec] = installError{Error: msg, At: time.Now().UTC()}
+	writeInstallErrors(all)
+}
+
+// clearInstallError forgets spec's failure: its package is there now.
+func clearInstallError(spec string) {
+	installErrorsMu.Lock()
+	defer installErrorsMu.Unlock()
+	all := readInstallErrors()
+	if _, ok := all[spec]; !ok {
+		return
+	}
+	delete(all, spec)
+	writeInstallErrors(all)
+}
diff --git a/internal/plugin/install_errors_test.go b/internal/plugin/install_errors_test.go
new file mode 100644
index 0000000..84cd7b4
--- /dev/null
+++ b/internal/plugin/install_errors_test.go
@@ -0,0 +1,30 @@
+package plugin
+
+import (
+	"errors"
+	"testing"
+)
+
+// A failed install is kept for the page and forgotten once the package is
+// there again (#41): the report was "no such plugin" at every start with no
+// word on why.
+func TestInstallErrorsRecordedAndCleared(t *testing.T) {
+	offSandbox(t)
+	recordInstallError("a@1.0.0", errors.New("连接超时"))
+	recordInstallError("b@1.0.0", errors.New("404 not found"))
+	got := InstallErrors()
+	if got["a@1.0.0"] != "连接超时" || got["b@1.0.0"] != "404 not found" {
+		t.Fatalf("InstallErrors = %v", got)
+	}
+	clearInstallError("a@1.0.0")
+	if _, ok := InstallErrors()["a@1.0.0"]; ok {
+		t.Error("a's failure is still kept after it installed")
+	}
+	if InstallErrors()["b@1.0.0"] == "" {
+		t.Error("b's failure went with a's")
+	}
+	clearInstallError("b@1.0.0")
+	if len(InstallErrors()) != 0 {
+		t.Fatalf("after clearing both = %v", InstallErrors())
+	}
+}
