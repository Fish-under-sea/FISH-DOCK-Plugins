@@ -0,0 +1,30 @@
+package provider
+
+import (
+	"testing"
+
+	"github.com/yetone/magpie/internal/plugin"
+)
+
+// A model its plugin files under "audio" or "embedding" leaves the chat list
+// even when its outputs also say text (#42): NearToken gives a TTS
+// {"audio": true, "text": true}, which reads as a model to talk with by its
+// outputs alone. The kind is what the model is for; the outputs say what it
+// can do.
+func TestPluginKindLeavesTheChatList(t *testing.T) {
+	pp := plugin.Provider{ID: "neartoken", Models: []plugin.Model{
+		{ID: "suno_music", Name: "Suno Music", Kind: "audio", Outputs: []string{"audio", "text"}, OutputsSaid: true},
+		{ID: "gemini-embedding-2", Name: "Gemini Embedding 2", Kind: "embedding", Outputs: []string{"embedding", "text"}, OutputsSaid: true},
+		{ID: "gpt-5", Name: "GPT-5", Outputs: []string{"text"}, OutputsSaid: true},
+	}}
+	got := map[string]bool{}
+	for _, m := range pluginCatalog(pp) {
+		got[m.ID] = true
+	}
+	if got["suno_music"] || got["gemini-embedding-2"] {
+		t.Errorf("a model of another API is in the chat list: %v", got)
+	}
+	if !got["gpt-5"] {
+		t.Error("the chat model was lost")
+	}
+}
