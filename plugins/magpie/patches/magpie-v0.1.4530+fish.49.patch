+		t.Fatalf("after the page's switch, the list is %v, want chat-a alone: the host did not restart the plugin with the new options", ids)
+	}
+	time.Sleep(1100 * time.Millisecond)
+	if code := pagePost(t, spec, fmt.Sprintf(`{"spec":%q,"options":{%s}}`, spec, allOn)); code != http.StatusOK {
+		t.Fatalf("the page's second POST answered %d", code)
+	}
+	ids, ok = listedModels(t)
+	if !ok || join(ids) != allFive {
+		t.Fatalf("after the switch off, the list is %v (listed %v)", ids, ok)
+	}
+	time.Sleep(1100 * time.Millisecond)
+	if code := pagePost(t, spec, fmt.Sprintf(`{"spec":%q,"options":{%s}}`, spec, oneLeft)); code != http.StatusOK {
+		t.Fatal("the page's third POST failed")
+	}
+	plugin.Settle()
+	ids, ok = listedModels(t)
+	if !ok {
+		t.Fatal("after a restart the provider is gone")
+	}
+	if join(ids) != "chat-a" {
+		t.Fatalf("after a restart the list is %v, want chat-a alone: the saved options were not read at start", ids)
