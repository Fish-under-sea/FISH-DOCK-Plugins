+// Stop on a role that isn't going is not an error: the window's Stop is
+// pressed once, whatever the run did meanwhile.
+func TestAgentStopWhenNothingGoes(t *testing.T) {
+	distillAt(t)
+	mux := http.NewServeMux()
+	memoryAgentRunRoutes(mux)
+	rec := httptest.NewRecorder()
