+// agentsAt points the registry at a folder of the test's own, so a route
+// never reads or writes the user's memory-agents.json.
+func agentsAt(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	old := memagent.Path
+	memagent.Path = func() string { return filepath.Join(dir, "memory-agents.json") }
+	t.Cleanup(func() { memagent.Path = old })
+	return memagent.Path()
+}
+
+// agentRoutes is the mux with the memory agents' routes on it.
+func agentRoutes(t *testing.T) *http.ServeMux {
+	t.Helper()
+	mux := http.NewServeMux()
+	memoryAgentRoutes(mux)
+	return mux
+}
+
+// get and post are the two calls the page makes, decoding a view or nothing.
+func get(t *testing.T, mux *http.ServeMux, path string) (int, memoryAgentsView) {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("GET", path, nil))
+	var v memoryAgentsView
+	if rec.Code == 200 {
+		if err := json.Unmarshal(rec.Body.Bytes(), &v); err != nil {
+			t.Fatalf("%s: %s", path, rec.Body)
+		}
+	}
+	return rec.Code, v
+}
+
+func postAgents(t *testing.T, mux *http.ServeMux, path, body string) (int, memoryAgentsView) {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("POST", path, strings.NewReader(body)))
+	var v memoryAgentsView
+	if rec.Code == 200 {
+		if err := json.Unmarshal(rec.Body.Bytes(), &v); err != nil {
+			t.Fatalf("%s: %s", path, rec.Body)
+		}
+	}
+	return rec.Code, v
+}
+
+// The Memory tab's agent list: the two presets a new registry starts with,
+// the agent each role runs as, the roles themselves, and the presets' ids so
+// the page can offer to bring a removed one back.
+func TestMemoryAgentsRouteListsPresets(t *testing.T) {
+	agentsAt(t)
+	mux := agentRoutes(t)
+	code, v := get(t, mux, "/api/memory/agents")
+	if code != 200 {
+		t.Fatalf("code %d", code)
+	}
+	if len(v.Agents) != 2 || v.Version != memagent.Version {
+		t.Fatalf("view: %+v", v)
+	}
+	if v.Defaults[memagent.Learn] != "memory-curator" || v.Defaults[memagent.Organize] != "memory-curator" || v.Defaults[memagent.Dream] != "dreamer" {
+		t.Fatalf("defaults: %+v", v.Defaults)
+	}
+	if len(v.Roles) != 3 || v.Roles[0] != memagent.Learn || v.Roles[2] != memagent.Dream {
+		t.Fatalf("roles: %q", v.Roles)
+	}
+	if len(v.Presets) != 2 || v.Presets[0] != "memory-curator" || v.Presets[1] != "dreamer" {
+		t.Fatalf("presets: %q", v.Presets)
+	}
+	// the route reads, it doesn't write: a page that only looks leaves no file
+	if _, err := os.Stat(memagent.Path()); !os.IsNotExist(err) {
+		t.Fatalf("a read wrote the registry: %v", err)
+	}
+}
