+)
+
+// prefsHome 把 config 目录指到临时目录，好让偏好的读写看得见。
+func prefsHome(t *testing.T) {
+	t.Helper()
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+}
+
+// #33：set 之后 get 回同一份，落盘在 config 层，UpdatedAt 有值。
+func TestPrefsSetThenGet(t *testing.T) {
+	prefsHome(t)
+	m := New("")
+
+	got, err := m.prefs(context.Background(), map[string]any{"op": "set",
+		"disabled":     []any{"tts-1", "whisper-1"},
+		"hiddenGroups": []any{"神明"},
+		"pinned":       []any{"glm-5.3"},
+	})
+	if err != nil {
+		t.Fatalf("set: %v", err)
+	}
+	if v := prefsList(got, "disabled"); len(v) != 2 || v[0] != "tts-1" {
+		t.Fatalf("set 回来的 disabled = %v", v)
+	}
+
+	// 落盘的位置就是 config 层，与 neartoken.json 同目录
+	if want := filepath.Join(settings.Dir(), "neartoken-prefs.json"); PrefsPath() != want {
+		t.Fatalf("PrefsPath = %q，want %q", PrefsPath(), want)
+	}
+	if _, serr := os.Stat(PrefsPath()); serr != nil {
+		t.Fatalf("没写盘：%v", serr)
+	}
+
+	p := LoadPrefs()
+	if len(p.Disabled) != 2 || p.Disabled[0].Model != "tts-1" || p.HiddenGroups[0] != "神明" || p.Pinned[0] != "glm-5.3" {
+		t.Fatalf("读回来 = %+v", p)
+	}
+	if p.UpdatedAt == 0 {
+		t.Fatal("UpdatedAt 没写")
+	}
+
+	got, err = m.prefs(context.Background(), map[string]any{"op": "get"})
+	if err != nil {
+		t.Fatalf("get: %v", err)
+	}
+	if v := prefsList(got, "pinned"); len(v) != 1 || v[0] != "glm-5.3" {
+		t.Fatalf("get 回来的 pinned = %v", v)
+	}
+}
+
+// #33：写偏好不碰 providers.json——供应商不进不出，这就是「不掉供应商」。
+func TestPrefsLeaveProvidersAlone(t *testing.T) {
+	prefsHome(t)
+	path := filepath.Join(settings.Dir(), "providers.json")
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	before := []byte(`{"providers":[{"id":"meoo","name":"Meoo 秒悟"}]}` + "\n")
+	if err := os.WriteFile(path, before, 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	m := New("")
+	if _, err := m.prefs(context.Background(), map[string]any{"op": "set", "disabled": []any{"tts-1"}}); err != nil {
+		t.Fatalf("set: %v", err)
+	}
+
+	after, rerr := os.ReadFile(path)
+	if rerr != nil {
+		t.Fatal(rerr)
+	}
+	if string(after) != string(before) {
+		t.Fatalf("providers.json 被改了：%s", after)
+	}
+}
+
+// #33：clear 清空；参数形状不对要报 INVALID_PARAM；不认识的动作也要报错。
+func TestPrefsClearAndRejectBadShapes(t *testing.T) {
+	prefsHome(t)
+	m := New("")
+	ctx := context.Background()
+
+	if _, err := m.prefs(ctx, map[string]any{"op": "set", "disabled": []any{"a"}}); err != nil {
+		t.Fatalf("set: %v", err)
+	}
+	got, err := m.prefs(ctx, map[string]any{"op": "clear"})
+	if err != nil {
+		t.Fatalf("clear: %v", err)
+	}
+	if v := prefsList(got, "disabled"); len(v) != 0 {
+		t.Fatalf("clear 后还有 %v", v)
+	}
+
+	if _, err := m.prefs(ctx, map[string]any{"op": "set", "disabled": "tts-1"}); err == nil {
+		t.Fatal("字符串当数组收了")
+	} else if e, ok := err.(*Error); !ok || e.Kind != CodeBadParam {
+		t.Fatalf("错误码 = %v，want %s", err, CodeBadParam)
+	}
+	if _, err := m.prefs(ctx, map[string]any{"op": "no-such"}); err == nil {
+		t.Fatal("不认识的动作没报错")
+	}
+}
+
+// #33：站点有逐条日志时按契约解出来，金额跟着站点货币走。
+func TestUsageRows(t *testing.T) {
+	prefsHome(t)
+	cur := Currency{Symbol: "$", PerUnit: 1, Rate: 1, Display: true}
+
+	c := usageClient(t, `{"success":true,"data":{"start_timestamp":1,"end_timestamp":2,
+		"bucket_seconds":3600,"quota":0.25,"tokens":120,"models":[],
+		"rows":[
+			{"timestamp":1762400000,"time":"11-06 17:00","kind":"chat","token_name":"fish","group":"神明",
+			 "model":"glm-5.3","up_model":"glm-5.3-up","resp_model":"glm-5.3-resp","effort":"high","tps":42.5,
+			 "input":1000,"output":200,"cache":27520,"is_stream":true,"quota":0.2,
+			 "ttft":0.4,"duration":3.2,"detail":"ok"},
+			{"timestamp":1762400060,"model":"tts-1","quota":0.05,"bytes":2048,"detail":"speech"}
+		]}}`)
+
+	w, err := c.readUsage(context.Background(), "k", "$3", "day", cur)
+	if err != nil {
+		t.Fatalf("readUsage: %v", err)
+	}
+	if !w.Available {
+		t.Fatalf("应当是 available：%+v", w)
+	}
+	if len(w.Rows) != 2 {
+		t.Fatalf("rows = %d，want 2", len(w.Rows))
+	}
+	r := w.Rows[0]
+	if r.Time != "11-06 17:00" || r.Kind != "chat" || r.TokenName != "fish" || r.Group != "神明" ||
+		r.Model != "glm-5.3" || r.Effort != "high" || r.TPS != 42.5 || r.Input != 1000 || r.Output != 200 ||
+		r.TTFT != 0.4 || r.Dur != 3.2 || r.Detail != "ok" ||
+		r.UpModel != "glm-5.3-up" || r.RespModel != "glm-5.3-resp" || r.Cache != 27520 || !r.IsStream {
+		t.Fatalf("第一行解错：%+v", r)
+	}
+	if r.CostText == "" {
+		t.Fatal("CostText 空着")
+	}
+	if w.Rows[1].Bytes != 2048 {
+		t.Fatalf("第二行 bytes = %v", w.Rows[1].Bytes)
+	}
+}
+
+// 站点只有汇总、没有逐条：Rows 是空数组而不是 nil，Available 仍为 true。
+func TestUsageWithoutRowsIsEmptyNotNil(t *testing.T) {
+	prefsHome(t)
+	c := usageClient(t, `{"success":true,"data":{"start_timestamp":1,"end_timestamp":2,
+		"bucket_seconds":3600,"quota":0.25,"tokens":120,"models":[]}}`)
+
+	w, err := c.readUsage(context.Background(), "k", "", "day", Currency{Symbol: "$", PerUnit: 1})
+	if err != nil {
+		t.Fatalf("readUsage: %v", err)
+	}
+	if !w.Available {
+		t.Fatalf("应当是 available：%+v", w)
+	}
+	if w.Rows == nil {
+		t.Fatal("Rows 是 nil，页面会当成没这个字段")
+	}
+	if len(w.Rows) != 0 {
+		t.Fatalf("rows = %v", w.Rows)
+	}
+}
+
+// usageClient 起一个只回这份 JSON 的站点，返回打到它上面的 client。
+func usageClient(t *testing.T, body string) *client {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("content-type", "application/json")
+		_, _ = w.Write([]byte(body))
+	}))
+	t.Cleanup(srv.Close)
+	return newClient(srv.URL)
+}
+
+// prefsList 读回 prefsView 里的一个列表。
+func prefsList(v any, key string) []string {
+	m, ok := v.(map[string]any)
+	if !ok {
+		return nil
+	}
+	switch t := m[key].(type) {
+	case []string:
+		return t
+	case []PrefModel:
+		out := make([]string, 0, len(t))
+		for _, d := range t {
+			out = append(out, d.Model)
+		}
+		return out
+	case []any:
+		out := make([]string, 0, len(t))
+		for _, e := range t {
+			if s, ok := e.(string); ok {
+				out = append(out, s)
+			}
+		}
+		return out
+	}
+	return nil
+}
+
+// #33：设置界面停用的模型通过 provider 的注册钩子说出去——只认 neartoken
+// 自己的 id，别的供应商一律 nil（不然会把别人的模型也剔掉）。
+func TestHiddenModelsSpeaksForNeartokenOnly(t *testing.T) {
+	prefsHome(t)
+	if err := SavePrefs(Prefs{Disabled: []PrefModel{{Model: "tts-1"}, {Model: "whisper-1"}}}); err != nil {
+		t.Fatalf("SavePrefs: %v", err)
+	}
+	if got := HiddenModels(ProviderID); len(got) != 2 || got[0] != "tts-1" {
+		t.Fatalf("HiddenModels(%q) = %v", ProviderID, got)
+	}
+	if got := HiddenModels("cline"); got != nil {
+		t.Fatalf("别的供应商被带累了：%v", got)
+	}
+}
+
+// #36 需求三：Groups 在宿主侧没有对应维度（插件给的模型表按模型去重、不分
+// 组），所以这条口径钉在插件的契约上——插件只在「这个模型所有分组都停用」时
+// 才把条目交上来（hostPayload），因此宿主见到 model 就整模型隐藏；条目里的
+// groups 只给页面与以后按组过滤用，不参与这一判断。
+func TestModelIDsHidesTheModelWhateverGroupsSay(t *testing.T) {
+	prefsHome(t)
+	if err := SavePrefs(Prefs{Disabled: []PrefModel{{Model: "gpt-6-astra", Groups: []string{"低价"}}}}); err != nil {
+		t.Fatalf("SavePrefs: %v", err)
+	}
+	if got := HiddenModels(ProviderID); len(got) != 1 || got[0] != "gpt-6-astra" {
+		t.Fatalf("HiddenModels = %v，want 整模型隐藏的那一条", got)
+	}
+}
+
+// 没写过偏好时一个都不藏。
+func TestHiddenModelsEmptyWhenNothingSaved(t *testing.T) {
+	prefsHome(t)
+	if got := HiddenModels(ProviderID); len(got) != 0 {
+		t.Fatalf("= %v，want 空", got)
+	}
+}
+
+// #33：插件现在发的是 [{model, groups}]，早期是纯字符串——两种都要收；读回来的
+// disabled 一律是对象形状，另带一份扁平的 models 给页面快速判断。
+func TestPrefsAcceptsBothPayloadShapes(t *testing.T) {
+	prefsHome(t)
+	m := New("")
+	ctx := context.Background()
+
+	got, err := m.prefs(ctx, map[string]any{"op": "set", "disabled": []any{
+		map[string]any{"model": "deepseek-flash", "groups": []any{"[低价] DeepSeek"}},
+		map[string]any{"model": "glm-5.3"},
+	}})
+	if err != nil {
+		t.Fatalf("对象形状 set: %v", err)
+	}
+	p := LoadPrefs()
+	if len(p.Disabled) != 2 || p.Disabled[0].Model != "deepseek-flash" || p.Disabled[0].Groups[0] != "[低价] DeepSeek" {
+		t.Fatalf("对象形状没存对：%+v", p.Disabled)
+	}
+	if v := prefsList(got, "models"); len(v) != 2 || v[0] != "deepseek-flash" {
+		t.Fatalf("扁平 models = %v", v)
+	}
+
+	// 纯字符串照旧收，并折算成对象
+	if _, err := m.prefs(ctx, map[string]any{"op": "set", "disabled": []any{"tts-1"}}); err != nil {
+		t.Fatalf("字符串形状 set: %v", err)
+	}
+	if p := LoadPrefs(); len(p.Disabled) != 1 || p.Disabled[0].Model != "tts-1" || len(p.Disabled[0].Groups) != 0 {
+		t.Fatalf("字符串形状没折算对：%+v", p.Disabled)
+	}
+
+	// 形状不对仍然报参数错
+	if _, err := m.prefs(ctx, map[string]any{"op": "set", "disabled": []any{map[string]any{"groups": []any{"g"}}}}); err == nil {
+		t.Fatal("缺 model 也收了")
+	}
+}
+
+// #33：偏好写完后镜像进插件的 page 目录（页面开机就能读），写不进去也不报错。
+func TestPrefsMirroredIntoThePageDir(t *testing.T) {
+	prefsHome(t)
+	dir := t.TempDir()
+	prev := pluginPageDir
+	pluginPageDir = func() string { return dir }
+	t.Cleanup(func() { pluginPageDir = prev })
+
+	m := New("")
+	if _, err := m.prefs(context.Background(), map[string]any{"op": "set",
+		"disabled": []any{map[string]any{"model": "deepseek-flash", "groups": []any{"[低价] DeepSeek"}}},
+	}); err != nil {
+		t.Fatalf("set: %v", err)
+	}
+
+	b, err := os.ReadFile(filepath.Join(dir, pagePrefsName))
+	if err != nil {
+		t.Fatalf("没镜像进 page 目录：%v", err)
+	}
+	var got Prefs
+	if json.Unmarshal(b, &got) != nil {
+		t.Fatalf("镜像的 JSON 解不开：%s", b)
+	}
+	if len(got.Disabled) != 1 || got.Disabled[0].Model != "deepseek-flash" || got.Disabled[0].Groups[0] != "[低价] DeepSeek" {
+		t.Fatalf("镜像内容不对：%+v", got.Disabled)
+	}
+
+	// 目录不存在时不报错（写失败静默）
+	pluginPageDir = func() string { return filepath.Join(dir, "nope") }
+	if _, err := m.prefs(context.Background(), map[string]any{"op": "set", "disabled": []any{"x"}}); err != nil {
+		t.Fatalf("镜像失败不该让 set 失败：%v", err)
+	}
+}
diff --git a/internal/neartoken/provider.go b/internal/neartoken/provider.go
new file mode 100644
index 0000000..37daaa6
--- /dev/null
+++ b/internal/neartoken/provider.go
@@ -0,0 +1,106 @@
+package neartoken
+
+import (
+	"context"
+	"strings"
+
+	"github.com/yetone/magpie/internal/catalog"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// 站点上四种协议的入口。Chat 与 Responses 的基址以 /v1 结尾，Anthropic 的
+// 基址是根（和 ANTHROPIC_BASE_URL 一样），Gemini 的基址到 /v1beta。
+func chatBase(baseURL string) string      { return strings.TrimRight(baseURL, "/") + "/v1" }
+func anthropicBase(baseURL string) string { return strings.TrimRight(baseURL, "/") }
+func geminiBase(baseURL string) string    { return strings.TrimRight(baseURL, "/") + "/v1beta" }
+
+// storedKey 是现在能用的那把钥匙；没有就是没连。
+//
+// 插件在场时它读插件自己的 auth——插件才是这条供应商的主人（handoff.go）。
+// 插件刚接手、老钥匙还没搬过去的那一小会儿，退回 providers.json 里那条，
+// 页面不至于一下子显示成未连接。
+func storedKey() (string, bool) {
+	if pluginOwnsProvider() {
+		if key, ok := pluginAuth(); ok {
+			return key, true
+		}
+	}
+	p, err := provider.Find(ProviderID)
+	if err != nil || p == nil {
+		return "", false
+	}
+	key := strings.TrimSpace(p.Key)
+	return key, key != ""
+}
+
+// attach 把站点挂成 magpie 的一个供应商：一个 id、一把钥匙、四个入口。
+//
+// 只在不装 provider 插件的那一路用（见 handoff.go）：插件在场时钥匙归插件，
+// 宿主不建这一条，否则就盖住了插件给的模型表、图标与余额。
+//
+// 已有的那一条只改钥匙与基址，其余（用户改过的路由、模型选择、请求头）
+// 一律不动 —— 重新登录不该把用户设好的东西清掉。第一次连接才建这一条。
+func attach(baseURL, key string, cat *Catalog) error {
+	p, err := provider.Find(ProviderID)
+	if err != nil || p == nil {
+		p = &provider.Provider{
+			ID:   ProviderID,
+			Name: "NearToken",
+			// 站点自己那张图；编辑器与供应商列表都用它
+			Icon: siteIconURL(baseURL),
+		}
+	}
+	p.Key = key
+	p.Chat = chatBase(baseURL)
+	p.Anthropic = anthropicBase(baseURL)
+	p.Gemini = geminiBase(baseURL)
+	// 站点把 Responses 也开在 /v1 下（New API 的 openai-response）
+	p.Responses = chatBase(baseURL)
+	p.BaseAPI = "chat"
+	if cat != nil && len(cat.Models) > 0 {
+		p.Models = append([]string(nil), cat.Models...)
+	}
+	if err := provider.Save(*p); err != nil {
+		return err
+	}
+	return nil
+}
+
+// saveCatalog 把站点目录写成 magpie 认得的那份列表，模型选择器随之更新。
+// 一次抓取失败不该让连接失败：没有列表时 magpie 会退回它自己知道的那份。
+func (m *Manager) saveCatalog(ctx context.Context, baseURL string, cat *Catalog) {
+	if cat == nil || len(cat.Models) == 0 {
+		return
+	}
+	models := make([]catalog.Model, 0, len(cat.Models))
+	for _, name := range cat.Models {
+		models = append(models, catalog.Model{ID: name, Name: name})
+	}
+	if err := catalog.SaveLive(ProviderID, chatBase(baseURL), models); err != nil {
+		m.logf("saving the site's models: %v", err)
+	}
+}
+
+// detach 把这条供应商从 magpie 里清干净：插件那条凭据、宿主侧那条老的
+// key+URL 供应商、以及它写下的模型表。清不动只记录：页面仍会显示未连接，
+// 因为密钥已经先撤销了。
+func (m *Manager) detach(ctx context.Context) {
+	if err := forgetPluginAuth(ctx); err != nil {
+		m.logf("forgetting the plugin's sign-in: %v", err)
+	}
+	if err := provider.Delete(ProviderID); err != nil {
+		m.logf("removing the provider: %v", err)
+	}
+	if err := catalog.SaveLive(ProviderID, "", nil); err != nil {
+		m.logf("forgetting the site's models: %v", err)
+	}
+}
+
+// siteIconURL 是站点那张图；页面与供应商卡都用同一个地址。
+func siteIconURL(baseURL string) string {
+	base := strings.TrimRight(baseURL, "/")
+	if base == "" {
+		base = DefaultBaseURL
+	}
+	return base + "/logo.png"
+}
diff --git a/internal/neartoken/referral.go b/internal/neartoken/referral.go
new file mode 100644
index 0000000..c774587
--- /dev/null
+++ b/internal/neartoken/referral.go
@@ -0,0 +1,55 @@
+package neartoken
+
+import (
+	"math"
+	"strings"
+)
+
+// Referral 是授权资料中的推荐数据。quota 保留站点原始单位，
+// 当前可用额与历史额分开；nil 表示未知，显式零值不会被省略。
+type Referral struct {
+	AccountID         *int64   `json:"accountId,omitempty"`
+	AffCode           *string  `json:"affCode,omitempty"`
+	Invites           *int64   `json:"invites,omitempty"`
+	AffQuota          *float64 `json:"affQuota,omitempty"`
+	AffHistoryQuota   *float64 `json:"affHistoryQuota,omitempty"`
+	InviterID         *int64   `json:"inviterId,omitempty"`
+	ReferralSource    string   `json:"referralSource,omitempty"`
+	ReferralUpdatedAt int64    `json:"referralUpdatedAt,omitempty"`
+}
+
+// referralFromUser 只接收 grant 已解码的 JSON 字段，不从钱包缺省值推算邀请资料。
+func referralFromUser(user map[string]any) Referral {
+	r := Referral{
+		AccountID:       referralInteger(user["id"]),
+		Invites:         referralInteger(user["aff_count"]),
+		AffQuota:        referralNumber(user["aff_quota"]),
+		AffHistoryQuota: referralNumber(user["aff_history_quota"]),
+		InviterID:       referralInteger(user["inviter_id"]),
+	}
+	if code, ok := user["aff_code"].(string); ok && strings.TrimSpace(code) != "" {
+		r.AffCode = &code
+	}
+	if r.AffCode != nil || r.Invites != nil || r.AffQuota != nil || r.AffHistoryQuota != nil || r.InviterID != nil {
+		r.ReferralSource = "authorization_user"
+	}
+	return r
+}
+
+func referralNumber(value any) *float64 {
+	n, ok := value.(float64)
+	if !ok || math.IsNaN(n) || math.IsInf(n, 0) {
+		return nil
+	}
+	return &n
+}
+
+func referralInteger(value any) *int64 {
+	n := referralNumber(value)
+	// grant 的 map 使用 JSON float64；越过精确整数范围的身份或计数不猜测。
+	if n == nil || *n < 0 || *n >= 1<<53 || math.Trunc(*n) != *n {
+		return nil
+	}
+	i := int64(*n)
+	return &i
+}
diff --git a/internal/neartoken/referral_authorization_test.go b/internal/neartoken/referral_authorization_test.go
new file mode 100644
index 0000000..40a2987
--- /dev/null
+++ b/internal/neartoken/referral_authorization_test.go
@@ -0,0 +1,56 @@
+package neartoken
+
+import (
+	"testing"
+	"time"
+)
+
+func referralGrantManager(t *testing.T) *Manager {
+	t.Helper()
+	withPluginProvider(t)
+	withPluginAuth(t, "fixture-only")
+	dropHostEntry(t)
+	stubPluginAuth(t)
+	site := newFakeSite(t)
+	m := New(t.TempDir())
+	m.baseURL = site.srv.URL
+	m.client = newClient(site.srv.URL)
+	return m
+}
+
+func TestGrantReferralTimeComesFromAuthorizationNotWalletRefresh(t *testing.T) {
+	m := referralGrantManager(t)
+	clock := time.Now()
+	m.now = func() time.Time { return clock }
+	authorizedAt := clock.UnixMilli()
+	m.completeAuth(&Grant{AccessToken: "fixture-only", User: referralUserJSON(t, `{"id":42,"username":"fixture","aff_code":"personal","aff_count":0,"aff_quota":12,"aff_history_quota":34,"inviter_id":7}`)})
+	got := referralJSON(t, m.state(t.Context()))
+	if got["referralUpdatedAt"] != float64(authorizedAt) {
+		t.Errorf("authorization timestamp = %#v, want %d", got["referralUpdatedAt"], authorizedAt)
+	}
+	clock = clock.Add(time.Hour)
+	if err := m.readWallet(t.Context(), "fixture-only"); err != nil {
+		t.Fatal(err)
+	}
+	got = referralJSON(t, m.state(t.Context()))
+	for key, want := range map[string]any{"accountId": float64(42), "affCode": "personal", "invites": float64(0), "affQuota": float64(12), "affHistoryQuota": float64(34), "inviterId": float64(7), "referralSource": "authorization_user", "referralUpdatedAt": float64(authorizedAt)} {
+		if got[key] != want {
+			t.Errorf("wallet-only refresh changed %s to %#v, want %#v", key, got[key], want)
+		}
+	}
+}
+
+func TestGrantReferralNewAuthorizationWithoutUserDropsOldOwner(t *testing.T) {
+	m := referralGrantManager(t)
+	m.snap.Account = summarize(referralUserJSON(t, `{"id":1,"username":"old-owner","aff_code":"old-code","aff_count":9,"aff_quota":99,"aff_history_quota":999,"inviter_id":8}`), Currency{PerUnit: 1})
+	m.completeAuth(&Grant{AccessToken: "fixture-only", User: nil})
+	got := referralJSON(t, m.state(t.Context()))
+	for _, key := range []string{"accountId", "affCode", "invites", "affQuota", "affHistoryQuota", "inviterId", "referralSource", "referralUpdatedAt"} {
+		if _, exists := got[key]; exists {
+			t.Errorf("new authorization retained old %s", key)
+		}
+	}
+	if m.snap.Account != nil && m.snap.Account.Username != "" {
+		t.Errorf("old username retained after new authorization: %q", m.snap.Account.Username)
+	}
+}
diff --git a/internal/neartoken/referral_grant_test.go b/internal/neartoken/referral_grant_test.go
new file mode 100644
index 0000000..79a43a6
--- /dev/null
+++ b/internal/neartoken/referral_grant_test.go
@@ -0,0 +1,108 @@
+package neartoken
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+)
+
+// 以更新交接给出的授权 user 字段为夹具，不把它冒充线上账户响应。
+func referralUserJSON(t *testing.T, raw string) map[string]any {
+	t.Helper()
+	var user map[string]any
+	if err := json.Unmarshal([]byte(raw), &user); err != nil {
+		t.Fatal(err)
+	}
+	return user
+}
+
+func referralJSON(t *testing.T, value any) map[string]any {
+	t.Helper()
+	b, err := json.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out map[string]any
+	if err := json.Unmarshal(b, &out); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func TestGrantReferralFieldsSurviveAccountConversion(t *testing.T) {
+	user := referralUserJSON(t, `{"id":42,"username":"fixture-account","aff_code":"personal-fixture","aff_count":3,"aff_quota":125000,"aff_history_quota":900000,"inviter_id":7}`)
+	got := referralJSON(t, summarize(user, Currency{PerUnit: 500000}))
+	for key, want := range map[string]any{
+		"accountId": float64(42), "affCode": "personal-fixture",
+		"invites": float64(3), "affQuota": float64(125000),
+		"affHistoryQuota": float64(900000), "inviterId": float64(7),
+		"referralSource": "authorization_user",
+	} {
+		if got[key] != want {
+			t.Errorf("account.%s = %#v, want %#v", key, got[key], want)
+		}
+	}
+}
+
+func TestGrantReferralUnknownIsNotZero(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		user string
+		zero bool
+	}{
+		{"missing", `{"username":"fixture"}`, false},
+		{"null", `{"username":"fixture","aff_count":null,"aff_quota":null,"aff_history_quota":null,"inviter_id":null}`, false},
+		{"wrong-type", `{"username":"fixture","aff_count":"3","aff_quota":false,"aff_history_quota":{},"inviter_id":"7"}`, false},
+		{"zero", `{"username":"fixture","aff_count":0,"aff_quota":0,"aff_history_quota":0,"inviter_id":0}`, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := referralJSON(t, summarize(referralUserJSON(t, tc.user), Currency{PerUnit: 1}))
+			for _, key := range []string{"invites", "affQuota", "affHistoryQuota", "inviterId"} {
+				v, exists := got[key]
+				if tc.zero {
+					if !exists || v != float64(0) {
+						t.Errorf("confirmed zero %s lost: %#v", key, v)
+					}
+				} else if exists {
+					t.Errorf("unknown %s became %#v", key, v)
+				}
+			}
+		})
+	}
+}
+
+func TestGrantReferralRejectsInvalidCountsWithoutDroppingValidFields(t *testing.T) {
+	user := referralUserJSON(t, `{"id":42,"username":"fixture","aff_code":"own-code","aff_count":1.5,"aff_quota":123.5,"aff_history_quota":456.5,"inviter_id":-1}`)
+	got := referralJSON(t, summarize(user, Currency{PerUnit: 1}))
+	for _, key := range []string{"invites", "inviterId"} {
+		if _, exists := got[key]; exists {
+			t.Errorf("invalid %s accepted", key)
+		}
+	}
+	if got["affCode"] != "own-code" || got["affQuota"] != 123.5 || got["affHistoryQuota"] != 456.5 {
+		t.Fatalf("valid independent fields were lost: %#v", got)
+	}
+}
+
+func TestGrantReferralStateAndSavedSnapshotKeepTheSameOwner(t *testing.T) {
+	withPluginProvider(t)
+	writeSettings(t, "plugin-auth.json", map[string]any{ProviderID: map[string]any{"type": "oauth", "access": "fixture-only", "refresh": "fixture-only"}}, map[string]any{})
+	dropHostEntry(t)
+	dir := t.TempDir()
+	m := New(dir)
+	m.snap.Account = summarize(referralUserJSON(t, `{"id":42,"username":"fixture","aff_code":"own-code","aff_count":0,"aff_quota":10,"aff_history_quota":30,"inviter_id":7}`), Currency{PerUnit: 1})
+	m.snap.WalletAt = time.Now().UnixMilli()
+	m.save()
+	restored := New(dir)
+	view := referralJSON(t, restored.state(t.Context()))
+	account, ok := view["account"].(map[string]any)
+	if !ok {
+		t.Fatal("saved account missing")
+	}
+	for _, key := range []string{"accountId", "affCode", "invites", "affQuota", "affHistoryQuota", "inviterId", "referralSource"} {
+		value, exists := account[key]
+		if !exists || view[key] != value {
+			t.Errorf("view.%s = %#v, saved account = %#v (present=%v)", key, view[key], value, exists)
+		}
+	}
+}
diff --git a/internal/neartoken/site.go b/internal/neartoken/site.go
new file mode 100644
index 0000000..e9e3381
--- /dev/null
+++ b/internal/neartoken/site.go
@@ -0,0 +1,195 @@
+// Package neartoken 把 NearToken（https://neartoken.cc，一个 New API 部署）
+// 接进 magpie：设备授权登录、余额与代金券、用量看板、在线充值，以及把站点
+// 作为 magpie 自己的一个供应商挂上（模型与路由仍由 magpie 原生负责）。
+//
+// 站点只在一个地方被说起：baseURL。所有请求都从这里出，所有错误都带一个
+// 稳定的码，页面对着码给一句人话，而不是把上游的英文原样铺开。
+package neartoken
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// DefaultBaseURL 是站点根地址，不带尾斜杠。
+const DefaultBaseURL = "https://neartoken.cc"
+
+// ProviderID 是这个插件在 magpie 里挂的供应商 id：一个就好，不支持多账号。
+const ProviderID = "neartoken"
+
+// ClientName 是站点确认页上显示的这头设备的称呼。
+//
+// 它故意不是 dsh-neartoken 的「DSH 插件」：那位作者的令牌、日志与授权记录
+// 都靠 DSH 这个标识认人，我们的连接混进同一串标识里，他排查时就分不清哪一条
+// 是自己的用户。这里写 Magpie。
+const ClientName = "Magpie"
+
+// TokenName 是请求站点给这把密钥起的名字。
+//
+// 站点按 client_name 命名时它就是令牌名；站点另有实现时会忽略它——带上不会
+// 出错，但**令牌名最终由站点决定**。所以插件不把它当事实：页面显示的是站点
+// 回的 token_name，回什么显示什么。
+const TokenName = "Magpie"
+
+// UserAgent 让站点的访问日志与 New API 的请求记录分得出来源。不是标准要求，
+// 但排查时省一次猜。
+const UserAgent = "magpie-neartoken"
+
+// 页面对着这些码分支；字符串是页面与 Go 共同的语言，不要随手改。
+const (
+	CodeUnreachable    = "SITE_UNREACHABLE"
+	CodeInvalidAnswer  = "SITE_RESPONSE_INVALID"
+	CodeRefused        = "SITE_REFUSED"
+	CodeNotConnected   = "NOT_CONNECTED"
+	CodeAccountChanged = "ACCOUNT_CHANGED"
+	// CodeTokenRequired 是站点为「只有 DSH 设备授权签发的令牌才能充值」写的码，
+	// 名字里的 DSH 是站点自己的历史，不是本插件的标识；这里只按它分支，对外
+	// 一律说「这把密钥不是本插件登录签发的」。
+	CodeTokenRequired  = "DSH_TOKEN_REQUIRED"
+	CodeTopupOff       = "TOPUP_UNAVAILABLE"
+	CodeNoUsage        = "NO_USAGE"
+	CodeBadParam       = "INVALID_PARAM"
+	CodeAuthExpired    = "AUTH_EXPIRED"
+	CodeProvider       = "PROVIDER_FAILED"
+	CodeAuthInProgress = "AUTH_IN_PROGRESS"
+)
+
+// Error 是一个带码的失败：页面按码分支，Message 是给人看的那句。
+// 字段叫 Kind 而不是 Code，因为 Code() 是 internal/gui 认的那个接口。
+type Error struct {
+	Kind    string
+	Message string
+}
+
+func (e *Error) Error() string { return e.Message }
+
+// Code 让页面拿到稳定的分支码（internal/gui 的错误编码靠这个接口）。
+func (e *Error) Code() string { return e.Kind }
+
+func fail(code, format string, args ...any) *Error {
+	return &Error{Kind: code, Message: fmt.Sprintf(format, args...)}
+}
+
+// envelope 是站点所有 JSON 应答的外壳：{success, message, code, data}。
+// 设备授权的轮询把「还没决定」也放在 success:false 里，所以这里只解形状，
+// 判断留给调用者。
+type envelope struct {
+	Success *bool           `json:"success"`
+	Message string          `json:"message"`
+	Code    string          `json:"code"`
+	Data    json.RawMessage `json:"data"`
+	// GroupRefs 只在 /api/pricing 上出现：分组名 → 路由用的 #<id>。
+	GroupRefs map[string]string `json:"group_refs"`
+	// GroupRatio 也在 /api/pricing 上：分组名 → 站点给这一组算的倍率。
+	GroupRatio map[string]float64 `json:"group_ratio"`
+}
+
+// client 是本站的一次调用：地址、超时、以及给测试换掉的 http.Client。
+type client struct {
+	baseURL string
+	http    *http.Client
+}
+
+func newClient(baseURL string) *client {
+	if strings.TrimSpace(baseURL) == "" {
+		baseURL = DefaultBaseURL
+	}
+	return &client{
+		baseURL: strings.TrimRight(baseURL, "/"),
+		http:    &http.Client{Timeout: 25 * time.Second},
+	}
+}
+
+// call 发一次请求并解外面的信封。auth 为空表示匿名调用（发起授权、轮询）。
+// 只有「连不上」与「回的不是 JSON」在这里算错，站点自己的拒绝原样交回去。
+func (c *client) call(ctx context.Context, method, path string, body any, auth string) (*envelope, *Error) {
+	var reader io.Reader
+	if body != nil {
+		raw, err := json.Marshal(body)
+		if err != nil {
+			return nil, fail(CodeBadParam, "请求体序列化失败：%v", err)
+		}
+		reader = bytes.NewReader(raw)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, reader)
+	if err != nil {
+		return nil, fail(CodeBadParam, "请求地址无效：%v", err)
+	}
+	req.Header.Set("accept", "application/json")
+	// 站点日志里认得出是哪一个客户端在问，不靠猜
+	req.Header.Set("user-agent", UserAgent)
+	if body != nil {
+		req.Header.Set("content-type", "application/json")
+	}
+	if auth != "" {
+		req.Header.Set("authorization", "Bearer "+auth)
+	}
+	res, err := c.http.Do(req)
+	if err != nil {
+		if ctx.Err() != nil {
+			// 一次调用自己超时了，不是站点的问题，但页面看到的仍是"没答"。
+			return nil, fail(CodeUnreachable, "站点没有在时限内应答")
+		}
+		return nil, fail(CodeUnreachable, "连不上 %s：%v", c.baseURL, err)
+	}
+	defer res.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(res.Body, 4<<20))
+	if err != nil {
+		return nil, fail(CodeUnreachable, "读取站点应答失败：%v", err)
+	}
+	env := &envelope{}
+	if err := json.Unmarshal(raw, env); err != nil {
+		return nil, fail(CodeInvalidAnswer, "站点应答不是 JSON（HTTP %d）", res.StatusCode)
+	}
+	return env, nil
+}
+
+// ok 是 success 明确为 true。
+func (e *envelope) ok() bool { return e.Success != nil && *e.Success }
+
+// said 是站点自己给的那句话，挑一个说得出话的字段。
+func (e *envelope) said() string {
+	if strings.TrimSpace(e.Message) != "" {
+		return strings.TrimSpace(e.Message)
+	}
+	return ""
+}
+
+// refused 把一次被拒的信封翻成带码的错误：充值端点用 403 + code 说明
+// "这把 Key 不是本插件签发的"，其余按站点原话。
+func (e *envelope) refused(action string) *Error {
+	if e.Code == CodeTokenRequired {
+		return fail(CodeTokenRequired, "这把密钥不是本插件登录签发的，请重新连接")
+	}
+	if said := e.said(); said != "" {
+		return fail(CodeRefused, "%s：%s", action, said)
+	}
+	return fail(CodeRefused, "%s被站点拒绝了", action)
+}
+
+// decode 把 data 解成 v。
+func (e *envelope) decode(v any) *Error {
+	if len(e.Data) == 0 || string(e.Data) == "null" {
+		return fail(CodeInvalidAnswer, "站点应答缺少 data")
+	}
+	if err := json.Unmarshal(e.Data, v); err != nil {
+		return fail(CodeInvalidAnswer, "站点应答的 data 解不开：%v", err)
+	}
+	return nil
+}
+
+// asError 让 errors.As 找到装在包装里的 *Error。
+func asError(err error) *Error {
+	var e *Error
+	if errors.As(err, &e) {
+		return e
+	}
+	return fail(CodeRefused, "%v", err)
+}
diff --git a/internal/neartoken/state.go b/internal/neartoken/state.go
new file mode 100644
index 0000000..09277be
--- /dev/null
+++ b/internal/neartoken/state.go
@@ -0,0 +1,107 @@
+package neartoken
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/appdir"
+)
+
+// snapshot 是磁盘上留着的那一份状态：密钥在 providers.json 里，这里只放
+// 重启后还想显示的账户数字与未完成的授权。读不出来就当作没有，绝不拿一份
+// 坏文件覆盖上一次的好数字。
+type snapshot struct {
+	BaseURL    string    `json:"baseURL,omitempty"`
+	TokenName  string    `json:"tokenName,omitempty"`
+	Account    *Account  `json:"account,omitempty"`
+	Pending    *pending  `json:"pending,omitempty"`
+	Error      string    `json:"error,omitempty"`
+	GrantedAt  int64     `json:"grantedAt,omitempty"`
+	WalletAt   int64     `json:"walletAt,omitempty"`
+	Currency   *Currency `json:"currency,omitempty"`
+	CurrencyAt int64     `json:"currencyAt,omitempty"`
+	CatalogAt  int64     `json:"catalogAt,omitempty"`
+	Models     int       `json:"models,omitempty"`
+	Groups     int       `json:"groups,omitempty"`
+	// GroupList 是分组墙的那份快照：读一次目录就留一份，插件重载后页面不用等重新抓。
+	GroupList []GroupInfo `json:"groupList,omitempty"`
+}
+
+// pending 是一次进行中的授权里能给人看的部分；device_code 从不落盘。
+type pending struct {
+	UserCode                string `json:"userCode"`
+	VerificationURI         string `json:"verificationUri"`
+	VerificationURIComplete string `json:"verificationUriComplete"`
+	ExpiresAt               int64  `json:"expiresAt"`
+}
+
+// StatePath 是这份快照的位置，与 providers.json 同目录。
+func StatePath() string { return filepath.Join(appdir.Config(), "neartoken.json") }
+
+// loadSnapshot 读回上一次的状态；文件不存在或解不开都是空状态。
+func loadSnapshot(path string) snapshot {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return snapshot{}
+	}
+	var s snapshot
+	if err := json.Unmarshal(b, &s); err != nil {
+		return snapshot{}
+	}
+	return s
+}
+
+// storeSnapshot 原子地写：临时文件、落盘、改名，并留一份 .bak。
+func storeSnapshot(path string, s snapshot) error {
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	b, err := json.MarshalIndent(s, "", "  ")
+	if err != nil {
+		return err
+	}
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, b, 0o644); err != nil {
+		return err
+	}
+	if old, err := os.ReadFile(path); err == nil {
+		_ = os.WriteFile(path+".bak", old, 0o644)
+	}
+	if err := os.Rename(tmp, path); err != nil {
+		return err
+	}
+	return nil
+}
+
+// saveMu 让两次保存不会互相盖掉：一次调用的写与后台刷新撞上时，最后写完的
+// 那份仍是内存里最新的状态。
+var saveMu sync.Mutex
+
+// writeSnapshotFile 把状态写成文件；save 的落盘顺序测试会替换它。
+var writeSnapshotFile = storeSnapshot
+
+// save 把当前状态写到 disk。错误只在日志里说：写不进去不该让一次连接失败。
+// 等写锁的时候状态可能又变了，所以拿到锁之后取内存里最新的那份再落盘。
+func (m *Manager) save() {
+	saveMu.Lock()
+	defer saveMu.Unlock()
+	m.mu.Lock()
+	s := m.snap
+	m.mu.Unlock()
+	if err := writeSnapshotFile(m.path, s); err != nil && !errors.Is(err, os.ErrNotExist) {
+		m.logf("saving %s: %v", m.path, err)
+	}
+}
+
+// now 是这只表用的时钟；测试会换掉它。
+func (m *Manager) clock() time.Time {
+	if m.now != nil {
+		return m.now()
+	}
+	return time.Now()
+}
diff --git a/internal/neartoken/status.go b/internal/neartoken/status.go
new file mode 100644
index 0000000..df4cda2
--- /dev/null
+++ b/internal/neartoken/status.go
@@ -0,0 +1,103 @@
+package neartoken
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// 站点的公开状态与定价端点。
+const (
+	statusPath  = "/api/status"
+	pricingPath = "/api/pricing"
+)
+
+// Currency 是站点印钱的方式：一个原始 quota 值折算成它显示的那笔钱。
+//
+// 站点回的额度全是 quota 单位，钱包、用量、代金券都按这同一份汇率折算，
+// 三处数字才不会互相打架。
+type Currency struct {
+	// Symbol 是金额前面的符号（￥ 或 $）。
+	Symbol string `json:"symbol"`
+	// PerUnit 是一个显示单位值多少 quota。
+	PerUnit float64 `json:"perUnit"`
+	// Rate 是显示货币对美元的比价，站点要求按货币显示时才会乘。
+	Rate float64 `json:"rate"`
+	// Display 是站点是否要按它自己的货币显示金额。
+	Display bool `json:"display"`
+	// Name 是站点名（近令牌站点的 system_name）。
+	Name string `json:"name"`
+}
+
+// money 把 quota 折成站点显示的那笔钱，未取整。
+func (c Currency) money(quota float64) float64 {
+	perUnit := c.PerUnit
+	if perUnit <= 0 {
+		perUnit = 1
+	}
+	value := quota / perUnit
+	if c.Display && c.Rate > 0 {
+		value *= c.Rate
+	}
+	return value
+}
+
+// text 是一位金额：带符号、两位小数，和站点自己的面板一致。
+func (c Currency) text(quota float64) string {
+	return fmt.Sprintf("%s%.2f", c.symbol(), c.money(quota))
+}
+
+func (c Currency) symbol() string {
+	if c.Symbol != "" {
+		return c.Symbol
+	}
+	if c.Display {
+		return "￥"
+	}
+	return "$"
+}
+
+// readStatus 读站点的公开状态。/api/status 匿名可读，所以连接之前页面也
+// 拿得到站点名；读不到就退回默认口径，不因此让整张卡报错。
+func (c *client) readStatus(ctx context.Context) Currency {
+	cur := Currency{Symbol: "", PerUnit: 1, Rate: 1, Display: false, Name: "NearToken"}
+	env, err := c.call(ctx, "GET", statusPath, nil, "")
+	if err != nil || !env.ok() {
+		return cur
+	}
+	var data struct {
+		SystemName        string   `json:"system_name"`
+		QuotaPerUnit      float64  `json:"quota_per_unit"`
+		USDExchangeRate   *float64 `json:"usd_exchange_rate"`
+		DisplayInCurrency bool     `json:"display_in_currency"`
+		// 站点可选地覆盖货币符号（"¥"、"€"），有就用它
+		CustomSymbol string `json:"custom_currency_symbol"`
+	}
+	if derr := env.decode(&data); derr != nil {
+		return cur
+	}
+	if strings.TrimSpace(data.SystemName) != "" {
+		cur.Name = strings.TrimSpace(data.SystemName)
+	}
+	if data.QuotaPerUnit > 0 {
+		cur.PerUnit = data.QuotaPerUnit
+	}
+	if data.USDExchangeRate != nil && *data.USDExchangeRate > 0 {
+		cur.Rate = *data.USDExchangeRate
+	}
+	cur.Display = data.DisplayInCurrency
+	cur.Symbol = strings.TrimSpace(data.CustomSymbol)
+	return cur
+}
+
+// currencyClock 记着这份汇率读到的时间，免得每次调用都问一遍站点。
+type currencyClock struct {
+	cur Currency
+	at  time.Time
+}
+
+// fresh 是这份汇率还能用（10 分钟内）。
+func (c currencyClock) fresh(now time.Time) bool {
+	return !c.at.IsZero() && now.Sub(c.at) < 10*time.Minute
+}
diff --git a/internal/neartoken/topup.go b/internal/neartoken/topup.go
new file mode 100644
index 0000000..63d3d75
--- /dev/null
+++ b/internal/neartoken/topup.go
@@ -0,0 +1,123 @@
+package neartoken
+
+import (
+	"context"
+	"strings"
+)
+
+// 充值面：站点只给"本插件签发的密钥"下单，别的一律 403 DSH_TOKEN_REQUIRED。
+const (
+	topupInfoPath = "/api/dsh/device/topup/info"
+	topupPath     = "/api/dsh/device/topup"
+)
+
+// TopupMethod 是站点开着的收款方式之一。
+type TopupMethod struct {
+	Type string `json:"type"`
+	Name string `json:"name"`
+}
+
+// TopupInfo 是充值卡能画出来的东西。Unavailable 非空时整块收起，页面只留
+// 那一句原因，不摆一个点不动的按钮。
+type TopupInfo struct {
+	Enabled     bool          `json:"enabled"`
+	Unavailable string        `json:"unavailable,omitempty"`
+	Min         float64       `json:"min"`
+	Options     []float64     `json:"options"`
+	Methods     []TopupMethod `json:"methods"`
+	Currency    string        `json:"currency"`
+}
+
+// TopupOrder 是一次下单的结果：站点的订单号与要打开的支付页。
+type TopupOrder struct {
+	TradeNo string `json:"tradeNo"`
+	URL     string `json:"url"`
+}
+
+// topupInfo 读站点的充值档位与渠道。
+func (c *client) topupInfo(ctx context.Context, key string, cur Currency) *TopupInfo {
+	out := &TopupInfo{Options: []float64{}, Methods: []TopupMethod{}, Currency: cur.symbol()}
+	env, err := c.call(ctx, "GET", topupInfoPath, nil, key)
+	if err != nil {
+		out.Unavailable = "连不上站点，充值暂时不可用。"
+		return out
+	}
+	if !env.ok() {
+		switch env.Code {
+		case CodeTokenRequired:
+			out.Unavailable = "当前密钥不是本插件登录签发的，重新连接后即可充值。"
+		default:
+			// 老站点根本没有这个端点：不摆充值区
+			if env.said() == "" {
+				out.Unavailable = "站点未提供在线充值。"
+			} else {
+				out.Unavailable = env.said()
+			}
+		}
+		return out
+	}
+	var data struct {
+		Enable    bool      `json:"enable_online_topup"`
+		Min       float64   `json:"min_topup"`
+		Options   []float64 `json:"amount_options"`
+		PayMethod []struct {
+			Name string `json:"name"`
+			Type string `json:"type"`
+		} `json:"pay_methods"`
+	}
+	if derr := env.decode(&data); derr != nil {
+		out.Unavailable = "站点的充值信息读不出来。"
+		return out
+	}
+	out.Enabled = data.Enable
+	out.Min = data.Min
+	if data.Options != nil {
+		out.Options = data.Options
+	}
+	for _, m := range data.PayMethod {
+		if m.Type == "" || m.Name == "" {
+			continue
+		}
+		out.Methods = append(out.Methods, TopupMethod{Type: m.Type, Name: m.Name})
+	}
+	if !out.Enabled {
+		out.Unavailable = "站点当前关闭了在线充值。"
+	}
+	if out.Enabled && len(out.Methods) == 0 {
+		out.Unavailable = "站点没有开着的收款方式。"
+	}
+	return out
+}
+
+// topup 下一单，返回要交给系统浏览器打开的地址。真实校验收在站点侧，这里
+// 只挡掉明显不合法的金额。
+func (c *client) topup(ctx context.Context, key string, amount float64, method string) (*TopupOrder, *Error) {
+	if amount <= 0 || amount != float64(int64(amount)) {
+		return nil, fail(CodeBadParam, "充值金额必须是正整数")
+	}
+	if strings.TrimSpace(method) == "" {
+		return nil, fail(CodeBadParam, "请先选一个收款方式")
+	}
+	env, err := c.call(ctx, "POST", topupPath, map[string]any{"amount": amount, "payment_method": method}, key)
+	if err != nil {
+		return nil, err
+	}
+	if !env.ok() {
+		return nil, env.refused("发起充值")
+	}
+	var data struct {
+		TradeNo string `json:"trade_no"`
+		PayURL  string `json:"pay_url"`
+	}
+	if derr := env.decode(&data); derr != nil {
+		return nil, derr
+	}
+	if data.PayURL == "" {
+		return nil, fail(CodeInvalidAnswer, "站点没有给出支付地址")
+	}
+	pay := data.PayURL
+	if strings.HasPrefix(pay, "/") {
+		pay = c.baseURL + pay
+	}
+	return &TopupOrder{TradeNo: data.TradeNo, URL: pay}, nil
+}
diff --git a/internal/neartoken/usage.go b/internal/neartoken/usage.go
new file mode 100644
index 0000000..3756cc5
--- /dev/null
+++ b/internal/neartoken/usage.go
@@ -0,0 +1,200 @@
+package neartoken
+
+import (
+	"context"
+	"fmt"
+	"slices"
+)
+
+// usagePath 是插件的密钥能读的用量端点，range 取 day / week / month。
+const usagePath = "/api/dsh/device/usage"
+
+// UsageRanges 是看板能切的三个窗口。
+var UsageRanges = []string{"day", "week", "month"}
+
+// UsageModel 是一个模型在一格或整个窗口里的用量。
+type UsageModel struct {
+	Model    string  `json:"model"`
+	Tokens   float64 `json:"tokens"`
+	Cost     float64 `json:"cost"`
+	CostText string  `json:"costText"`
+}
+
+// UsageBucket 是堆叠图上的一列。
+type UsageBucket struct {
+	Timestamp int64        `json:"timestamp"`
+	Models    []UsageModel `json:"models"`
+}
+
+// UsageRow 是一条请求的流水（#33）：站点把逐条日志放在同一个窗口应答里时才
+// 有。站点没有这层数据时 Rows 是空数组而不是 nil——页面据此说“这个窗口没有
+// 逐条记录”，不会把“站点没这个功能”说成“这次查询失败”。
+type UsageRow struct {
+	Time      string `json:"time"`
+	Timestamp int64  `json:"timestamp,omitempty"`
+	Kind      string `json:"kind,omitempty"`
+	TokenName string `json:"tokenName,omitempty"`
+	Group     string `json:"group,omitempty"`
+	Model     string `json:"model,omitempty"`
+	// UpModel / RespModel 是站点上游/应答两端的模型名，有的站只在一端写
+	UpModel   string  `json:"upModel,omitempty"`
+	RespModel string  `json:"respModel,omitempty"`
+	Effort    string  `json:"effort,omitempty"`
+	TPS       float64 `json:"tps,omitempty"`
+	Input     float64 `json:"input,omitempty"`
+	Output    float64 `json:"output,omitempty"`
+	Bytes     float64 `json:"bytes,omitempty"`
+	// Cache 是命中的缓存 token；IsStream 说这次是不是流式
+	Cache    float64 `json:"cache,omitempty"`
+	IsStream bool    `json:"isStream,omitempty"`
+	Cost     float64 `json:"cost,omitempty"`
+	CostText string  `json:"costText,omitempty"`
+	TTFT     float64 `json:"ttft,omitempty"`
+	Dur      float64 `json:"dur,omitempty"`
+	Detail   string  `json:"detail,omitempty"`
+}
+
+// UsageWindow 是一个窗口的全部数字。Available 为 false 时，Reason 说明是
+// 站点没有这个端点（unsupported）还是这一轮读不到（unreachable）——两种说法
+// 在页面上是两句不同的话，不合并。
+type UsageWindow struct {
+	Available     bool          `json:"available"`
+	Reason        string        `json:"reason,omitempty"`
+	Range         string        `json:"range"`
+	Start         int64         `json:"start"`
+	End           int64         `json:"end"`
+	BucketSeconds int           `json:"bucketSeconds"`
+	Currency      string        `json:"currency"`
+	Spent         string        `json:"spent"`
+	Balance       string        `json:"balance"`
+	Tokens        float64       `json:"tokens"`
+	Models        []UsageModel  `json:"models"`
+	Buckets       []UsageBucket `json:"buckets"`
+	// Rows 是逐条流水；站点没有这层数据时是空数组（#33）。
+	Rows []UsageRow `json:"rows"`
+}
+
+// readUsage 读一个窗口。调用方给的 balance 是钱包卡片上那个数：端点只说花
+// 了多少，余额是钱包的事，不在第二个地方再问一遍。
+func (c *client) readUsage(ctx context.Context, key, balance, span string, cur Currency) (*UsageWindow, *Error) {
+	if !slices.Contains(UsageRanges, span) {
+		return nil, fail(CodeBadParam, "没有这个窗口：%s（day / week / month）", span)
+	}
+	env, cerr := c.call(ctx, "GET", usagePath+"?range="+span, nil, key)
+	if cerr != nil {
+		return &UsageWindow{Available: false, Reason: "unreachable", Range: span, Balance: balance}, nil
+	}
+	if !env.ok() {
+		// 老站点把这条路径当未知路由，回的是 JSON 但没有窗口：这是部署事实，
+		// 不是密钥坏了。
+		return &UsageWindow{Available: false, Reason: "unsupported", Range: span, Balance: balance}, nil
+	}
+	var data struct {
+		Start         float64 `json:"start_timestamp"`
+		End           float64 `json:"end_timestamp"`
+		BucketSeconds float64 `json:"bucket_seconds"`
+		Quota         float64 `json:"quota"`
+		Tokens        float64 `json:"tokens"`
+		Models        []struct {
+			Model  string  `json:"model"`
+			Quota  float64 `json:"quota"`
+			Tokens float64 `json:"tokens"`
+		} `json:"models"`
+		Buckets []struct {
+			Timestamp float64 `json:"timestamp"`
+			Models    []struct {
+				Model  string  `json:"model"`
+				Quota  float64 `json:"quota"`
+				Tokens float64 `json:"tokens"`
+			} `json:"models"`
+		} `json:"buckets"`
+		// Rows 是站点的逐条日志（#33）。字段名按站点自己的下划线写法认，
+		// 缺哪个都行——站点没有这一层，这个数组就是空的。
+		Rows []struct {
+			Timestamp float64 `json:"timestamp"`
+			Time      string  `json:"time"`
+			Kind      string  `json:"kind"`
+			TokenName string  `json:"token_name"`
+			Group     string  `json:"group"`
+			Model     string  `json:"model"`
+			UpModel   string  `json:"up_model"`
+			RespModel string  `json:"resp_model"`
+			Effort    string  `json:"effort"`
+			TPS       float64 `json:"tps"`
+			Input     float64 `json:"input"`
+			Output    float64 `json:"output"`
+			Bytes     float64 `json:"bytes"`
+			Cache     float64 `json:"cache"`
+			IsStream  bool    `json:"is_stream"`
+			Quota     float64 `json:"quota"`
+			TTFT      float64 `json:"ttft"`
+			Duration  float64 `json:"duration"`
+			Detail    string  `json:"detail"`
+		} `json:"rows"`
+	}
+	// 有逐条流水、没有分桶的站点也算“这个端点有”：两类数据各自独立。
+	if derr := env.decode(&data); derr != nil || (data.BucketSeconds <= 0 && len(data.Rows) == 0) {
+		return &UsageWindow{Available: false, Reason: "unsupported", Range: span, Balance: balance}, nil
+	}
+	row := func(model string, quota, tokens float64) UsageModel {
+		return UsageModel{Model: model, Tokens: tokens, Cost: cur.money(quota), CostText: cur.text(quota)}
+	}
+	out := &UsageWindow{
+		Available:     true,
+		Range:         span,
+		Start:         int64(data.Start),
+		End:           int64(data.End),
+		BucketSeconds: int(data.BucketSeconds),
+		Currency:      cur.symbol(),
+		Spent:         cur.text(data.Quota),
+		Balance:       balance,
+		Tokens:        data.Tokens,
+		Models:        []UsageModel{},
+		Buckets:       []UsageBucket{},
+		Rows:          []UsageRow{},
+	}
+	for _, m := range data.Models {
+		if m.Model == "" {
+			continue
+		}
+		out.Models = append(out.Models, row(m.Model, m.Quota, m.Tokens))
+	}
+	for _, b := range data.Buckets {
+		bucket := UsageBucket{Timestamp: int64(b.Timestamp), Models: []UsageModel{}}
+		for _, m := range b.Models {
+			if m.Model == "" {
+				continue
+			}
+			bucket.Models = append(bucket.Models, row(m.Model, m.Quota, m.Tokens))
+		}
+		out.Buckets = append(out.Buckets, bucket)
+	}
+	for _, r := range data.Rows {
+		if r.Model == "" && r.Detail == "" {
+			continue
+		}
+		out.Rows = append(out.Rows, UsageRow{
+			Time: r.Time, Timestamp: int64(r.Timestamp), Kind: r.Kind,
+			TokenName: r.TokenName, Group: r.Group, Model: r.Model,
+			UpModel: r.UpModel, RespModel: r.RespModel, Effort: r.Effort,
+			TPS: r.TPS, Input: r.Input, Output: r.Output, Bytes: r.Bytes,
+			Cache: r.Cache, IsStream: r.IsStream,
+			Cost: cur.money(r.Quota), CostText: cur.text(r.Quota),
+			TTFT: r.TTFT, Dur: r.Duration, Detail: r.Detail,
+		})
+	}
+	return out, nil
+}
+
+// rangeLabel 是窗口在页面上的名字，错误消息里用。
+func rangeLabel(span string) string {
+	switch span {
+	case "day":
+		return "日"
+	case "week":
+		return "周"
+	case "month":
+		return "月"
+	}
+	return fmt.Sprint(span)
+}
diff --git a/internal/neartoken/wallet.go b/internal/neartoken/wallet.go
new file mode 100644
index 0000000..b26348a
--- /dev/null
+++ b/internal/neartoken/wallet.go
@@ -0,0 +1,91 @@
+package neartoken
+
+import "context"
+
+// walletPath 用插件的密钥读用户维度的额度与分组代金券。
+const walletPath = "/api/dsh/device/wallet"
+
+// Voucher 是一张分组代金券：只能付它自己那一组，金额按站点货币印。
+type Voucher struct {
+	Group   string `json:"group"`
+	GroupID int    `json:"groupId"`
+	Amount  string `json:"amount"`
+}
+
+// Account 是账户卡要的几件事。
+type Account struct {
+	Referral
+	Username    string    `json:"username"`
+	DisplayName string    `json:"displayName"`
+	Group       string    `json:"group"`
+	Balance     string    `json:"balance"`
+	Used        string    `json:"used"`
+	Vouchers    []Voucher `json:"vouchers"`
+}
+
+// wallet 读余额、已用与分组代金券，金额按站点货币折成文字。端点不存在
+// （老站点）、读不到、令牌被停用，都只表示"这一轮没读到"，调用者保留上一次
+// 的数字，不清空。
+func (c *client) wallet(ctx context.Context, key string, cur Currency) (quota, used float64, vouchers []Voucher, err *Error) {
+	env, cerr := c.call(ctx, "GET", walletPath, nil, key)
+	if cerr != nil {
+		return 0, 0, nil, cerr
+	}
+	if !env.ok() {
+		return 0, 0, nil, env.refused("读取余额")
+	}
+	var data struct {
+		Quota     float64 `json:"quota"`
+		UsedQuota float64 `json:"used_quota"`
+		Credits   []struct {
+			Group   string  `json:"group"`
+			GroupID int     `json:"group_id"`
+			Amount  float64 `json:"amount"`
+		} `json:"group_credits"`
+	}
+	if derr := env.decode(&data); derr != nil {
+		return 0, 0, nil, derr
+	}
+	out := make([]Voucher, 0, len(data.Credits))
+	for _, g := range data.Credits {
+		// 只留还有钱的那些；站点已经滤过一遍，这里再守一次
+		if g.Amount <= 0 {
+			continue
+		}
+		out = append(out, Voucher{Group: g.Group, GroupID: g.GroupID, Amount: cur.text(g.Amount)})
+	}
+	return data.Quota, data.UsedQuota, out, nil
+}
+
+// summarize 把 grant 里那份 user 摊成账户卡。
+func summarize(user map[string]any, cur Currency) *Account {
+	if user == nil {
+		return nil
+	}
+	text := func(key string) string {
+		if v, ok := user[key].(string); ok {
+			return v
+		}
+		return ""
+	}
+	num := func(key string) float64 {
+		if v, ok := user[key].(float64); ok {
+			return v
+		}
+		return 0
+	}
+	name := text("username")
+	display := text("display_name")
+	if display == "" {
+		display = name
+	}
+	return &Account{
+		Referral:    referralFromUser(user),
+		Username:    name,
+		DisplayName: display,
+		Group:       text("group"),
+		Balance:     cur.text(num("quota")),
+		Used:        cur.text(num("used_quota")),
+		Vouchers:    []Voucher{},
+	}
+}
diff --git a/internal/neartoken/wallet_session_test.go b/internal/neartoken/wallet_session_test.go
new file mode 100644
index 0000000..4d2f860
--- /dev/null
+++ b/internal/neartoken/wallet_session_test.go
@@ -0,0 +1,122 @@
+package neartoken
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// 用被通道挂住的真实 HTTP 应答固定交错顺序，不靠 sleep 猜测请求先后。
+func TestWalletResponseStaysWithItsAuthorization(t *testing.T) {
+	for _, mode := range []string{"disconnect-after-start", "reauthorize-after-start", "disconnect-before-start"} {
+		t.Run(mode, func(t *testing.T) {
+			withPluginProvider(t)
+			withPluginAuth(t, "fixture-old")
+			dropHostEntry(t)
+			stubPluginAuth(t)
+			savePluginAuth = func(_ context.Context, auth map[string]any) error {
+				writeSettings(t, "plugin-auth.json", map[string]any{ProviderID: auth}, map[string]any{})
+				return nil
+			}
+			forgetPluginAuth = func(context.Context) error {
+				writeSettings(t, "plugin-auth.json", map[string]any{}, map[string]any{})
+				return nil
+			}
+
+			started, release := make(chan struct{}), make(chan struct{})
+			var startedOnce, releaseOnce sync.Once
+			unblock := func() { releaseOnce.Do(func() { close(release) }) }
+			var oldRequests atomic.Int32
+			mux := http.NewServeMux()
+			mux.HandleFunc("/api/status", func(w http.ResponseWriter, r *http.Request) {
+				write(w, map[string]any{"success": true, "data": map[string]any{"quota_per_unit": 1, "usd_exchange_rate": 1}})
+			})
+			mux.HandleFunc("/api/pricing", func(w http.ResponseWriter, r *http.Request) {
+				write(w, map[string]any{"success": true, "data": []any{}})
+			})
+			mux.HandleFunc("/api/dsh/device/revoke", func(w http.ResponseWriter, r *http.Request) {
+				write(w, map[string]any{"success": true})
+			})
+			mux.HandleFunc(walletPath, func(w http.ResponseWriter, r *http.Request) {
+				quota := 222
+				if r.Header.Get("Authorization") == "Bearer fixture-old" {
+					oldRequests.Add(1)
+					startedOnce.Do(func() { close(started) })
+					select {
+					case <-release:
+					case <-r.Context().Done():
+						return
+					}
+					quota = 111
+				}
+				write(w, map[string]any{"success": true, "data": map[string]any{"quota": quota, "used_quota": 0, "group_credits": []any{}}})
+			})
+			srv := httptest.NewServer(mux)
+			t.Cleanup(srv.Close)
+			t.Cleanup(unblock)
+			dir := t.TempDir()
+			m := New(dir)
+			m.baseURL, m.client = srv.URL, newClient(srv.URL)
+			cur := Currency{PerUnit: 1, Rate: 1}
+			m.snap.Currency, m.snap.CurrencyAt = &cur, time.Now().UnixMilli()
+			m.snap.WalletAt = time.Now().UnixMilli()
+			m.snap.Account = summarize(referralUserJSON(t, `{"id":1,"username":"old-owner","aff_count":9,"aff_code":"old-code"}`), cur)
+			m.save()
+
+			var readErr *Error
+			if mode == "disconnect-before-start" {
+				if _, err := m.disconnect(t.Context()); err != nil {
+					t.Fatal(err)
+				}
+				unblock()
+				readErr = m.readWallet(t.Context(), "fixture-old")
+			} else {
+				done := make(chan struct{})
+				go func() {
+					readErr = m.readWallet(t.Context(), "fixture-old")
+					close(done)
+				}()
+				t.Cleanup(func() { unblock(); <-done })
+				select {
+				case <-started:
+				case <-done:
+					t.Fatalf("old wallet request ended before the held response: %v", readErr)
+				}
+				if mode == "reauthorize-after-start" {
+					m.completeAuth(&Grant{AccessToken: "fixture-new", User: referralUserJSON(t, `{"id":2,"username":"new-owner","aff_count":20,"aff_code":"new-code"}`)})
+				} else if _, err := m.disconnect(t.Context()); err != nil {
+					t.Fatal(err)
+				}
+				unblock()
+				<-done
+			}
+			if readErr == nil || readErr.Code() != "ACCOUNT_CHANGED" {
+				t.Errorf("stale wallet response should report ACCOUNT_CHANGED, got %v", readErr)
+			}
+			if mode == "reauthorize-after-start" {
+				a := m.snap.Account
+				if a == nil || a.Username != "new-owner" || a.Balance != cur.text(222) || a.Invites == nil || *a.Invites != 20 {
+					t.Errorf("old response changed the new account: %+v", a)
+				}
+				if a := New(dir).snap.Account; a == nil || a.Balance != cur.text(222) {
+					t.Errorf("old response overwrote the new saved account: %+v", a)
+				}
+			} else {
+				if m.snap.Account != nil || New(dir).snap.Account != nil {
+					t.Errorf("wallet response recreated account state after disconnect: %+v", m.snap.Account)
+				}
+			}
+			wantRequests := int32(1)
+			if mode == "disconnect-before-start" {
+				wantRequests = 0
+			}
+			if got := oldRequests.Load(); got != wantRequests {
+				t.Errorf("old request count = %d, want %d (no replay)", got, wantRequests)
+			}
+		})
+	}
+}
diff --git a/internal/neartoken/website_fallback.go b/internal/neartoken/website_fallback.go
new file mode 100644
index 0000000..07ae591
--- /dev/null
+++ b/internal/neartoken/website_fallback.go
@@ -0,0 +1,104 @@
+package neartoken
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/yetone/magpie/internal/proc"
+)
+
+const foregroundWait = 25 * time.Second
+
+// call 把前台操作限制在一次时限内；打开网站只兜底人工操作，不重放 API。
+func (m *Manager) call(ctx context.Context, name string, params map[string]any) (any, error) {
+	page := websiteFallbackPage(name, params)
+	if page == "" {
+		return m.dispatch(ctx, name, params)
+	}
+	ctx, cancel := context.WithTimeout(ctx, foregroundWait)
+	defer cancel()
+	result, err := m.dispatch(ctx, name, params)
+	if err == nil && ctx.Err() != nil {
+		err = fail(CodeUnreachable, "站点没有在时限内应答")
+	}
+	// 自动读用量保留原有 available=false 契约；显式前台读取则可去网站处理。
+	if win, ok := result.(*UsageWindow); err == nil && ok && !win.Available {
+		err = fail(CodeNoUsage, "本次未取得用量数据")
+	}
+	if err == nil || errors.Is(ctx.Err(), context.Canceled) {
+		return result, err
+	}
+	var siteErr *Error
+	if !errors.As(err, &siteErr) || !websiteFallbackError(siteErr.Kind) {
+		return result, err
+	}
+	link := websiteAddress(m.baseURL, page)
+	if link == "" {
+		return result, err
+	}
+	open := m.openURL
+	if open == nil {
+		open = proc.OpenBrowser
+	}
+	copy := *siteErr
+	if open(link) == nil {
+		copy.Message = fmt.Sprintf("%s。原操作未完成，已打开对应网页供手动处理：%s", siteErr.Message, link)
+	} else {
+		copy.Message = fmt.Sprintf("%s。系统浏览器未打开，请手动打开：%s", siteErr.Message, link)
+	}
+	return result, &copy
+}
+
+// websiteFallbackPage 的目标来自固定映射，不接收调用方提供的任意网址。
+// 用量和充值信息也被页面自动读取，所以它们不默认触发浏览器。
+func websiteFallbackPage(name string, params map[string]any) string {
+	if background, _ := params["background"].(bool); background {
+		return ""
+	}
+	foreground, explicit := params["foreground"].(bool)
+	if explicit && !foreground {
+		return ""
+	}
+	switch name {
+	case "neartoken:connect":
+		return "/sign-in"
+	case "neartoken:refresh":
+		if page, _ := params["websitePage"].(string); page == "pricing" {
+			return "/pricing"
+		}
+		return "/wallet"
+	case "neartoken:topup":
+		if _, hasAmount := paramNumber(params, "amount"); hasAmount {
+			return "/wallet"
+		}
+	case "neartoken:usage":
+		if foreground {
+			return "/usage-logs/"
+		}
+	}
+	return ""
+}
+
+func websiteFallbackError(code string) bool {
+	switch code {
+	case CodeUnreachable, CodeInvalidAnswer, CodeRefused, CodeTokenRequired, CodeTopupOff, CodeAuthExpired, CodeNoUsage:
+		return true
+	}
+	return false
+}
+
+// websiteAddress 不把凭据、兑换码或旧查询参数带到兜底网页。
+func websiteAddress(base, page string) string {
+	u, err := url.Parse(strings.TrimSpace(base))
+	if err != nil || u.Host == "" || u.User != nil || (u.Scheme != "https" && u.Scheme != "http") {
+		return ""
+	}
+	u.Path = strings.TrimRight(u.Path, "/") + page
+	u.RawPath, u.RawQuery, u.Fragment, u.RawFragment = "", "", "", ""
+	u.ForceQuery = false
+	return u.String()
+}
diff --git a/internal/neartoken/website_fallback_test.go b/internal/neartoken/website_fallback_test.go
new file mode 100644
index 0000000..cfe8724
--- /dev/null
+++ b/internal/neartoken/website_fallback_test.go
@@ -0,0 +1,199 @@
+package neartoken
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func websiteFallbackManager(t *testing.T, answer http.HandlerFunc) (*Manager, func() []string, *[]string) {
+	t.Helper()
+	withPluginProvider(t)
+	withPluginAuth(t, "fixture-only")
+	dropHostEntry(t)
+	var mu sync.Mutex
+	var requests []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		requests = append(requests, r.Method+" "+r.URL.Path)
+		mu.Unlock()
+		answer(w, r)
+	}))
+	t.Cleanup(srv.Close)
+	m := New(t.TempDir())
+	m.baseURL, m.client = srv.URL, newClient(srv.URL)
+	m.snap.Currency = &Currency{PerUnit: 1, Rate: 1}
+	m.snap.CurrencyAt, m.snap.WalletAt = time.Now().UnixMilli(), time.Now().UnixMilli()
+	opened := new([]string)
+	m.openURL = func(link string) error { *opened = append(*opened, link); return nil }
+	return m, func() []string { mu.Lock(); defer mu.Unlock(); return append([]string(nil), requests...) }, opened
+}
+
+func TestForegroundFailureOpensOnlyItsCorrespondingWebsite(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		params map[string]any
+		page   string
+	}{
+		{"neartoken:connect", map[string]any{}, "/sign-in"},
+		{"neartoken:refresh", map[string]any{}, "/wallet"},
+		{"neartoken:refresh", map[string]any{"websitePage": "pricing"}, "/pricing"},
+		{"neartoken:topup", map[string]any{"amount": 20, "paymentMethod": "alipay", "code": "do-not-leak"}, "/wallet"},
+		{"neartoken:usage", map[string]any{"range": "day", "foreground": true}, "/usage-logs/"},
+	} {
+		t.Run(tc.name+tc.page, func(t *testing.T) {
+			m, requests, opened := websiteFallbackManager(t, func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusBadGateway)
+				_, _ = w.Write([]byte("fixture upstream unavailable"))
+			})
+			_, err := m.call(t.Context(), tc.name, tc.params)
+			if err == nil {
+				t.Fatal("website fallback must not pretend the API succeeded")
+			}
+			want := m.baseURL + tc.page
+			if len(*opened) != 1 || (*opened)[0] != want {
+				t.Errorf("opened = %v, want once: %s", *opened, want)
+			}
+			if !strings.Contains(err.Error(), want) {
+				t.Errorf("error has no website address: %v", err)
+			}
+			if len(requests()) != 1 {
+				t.Errorf("request replayed or expanded: %v", requests())
+			}
+			for _, u := range *opened {
+				if strings.Contains(u, "do-not-leak") || strings.Contains(u, "fixture-only") {
+					t.Error("secret copied into fallback URL")
+				}
+			}
+		})
+	}
+}
+
+func TestWebsiteFallbackDoesNotOpenForAutomaticReadsOrLocalValidation(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		params map[string]any
+	}{
+		{"neartoken:state", nil},
+		{"neartoken:topup", nil},
+		{"neartoken:usage", map[string]any{"range": "day"}},
+		{"neartoken:refresh", map[string]any{"foreground": false}},
+		{"neartoken:refresh", map[string]any{"background": true}},
+		{"neartoken:topup", map[string]any{"amount": 20, "paymentMethod": ""}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m, _, opened := websiteFallbackManager(t, func(w http.ResponseWriter, r *http.Request) { http.Error(w, "fixture failure", http.StatusBadGateway) })
+			_, _ = m.call(t.Context(), tc.name, tc.params)
+			if len(*opened) != 0 {
+				t.Fatalf("automatic/local operation opened pages: %v", *opened)
+			}
+		})
+	}
+}
+
+func TestWebsiteFallbackRetainsTheOriginalErrorWhenBrowserFails(t *testing.T) {
+	m, requests, opened := websiteFallbackManager(t, func(w http.ResponseWriter, r *http.Request) {
+		write(w, map[string]any{"success": false, "message": "fixture service refused"})
+	})
+	m.openURL = func(link string) error {
+		*opened = append(*opened, link)
+		return errors.New("fixture launcher unavailable")
+	}
+	_, err := m.call(t.Context(), "neartoken:refresh", nil)
+	if err == nil || asError(err).Kind != CodeRefused || !strings.Contains(err.Error(), "fixture service refused") || !strings.Contains(err.Error(), m.baseURL+"/wallet") {
+		t.Fatalf("original failure or manual website address lost: %v", err)
+	}
+	if len(*opened) != 1 || len(requests()) != 1 {
+		t.Fatalf("fallback retried: opened=%v requests=%v", *opened, requests())
+	}
+}
+
+func TestWebsiteFallbackAfterTimeoutDoesNotReplayTheOperation(t *testing.T) {
+	release := make(chan struct{})
+	m, requests, opened := websiteFallbackManager(t, func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case <-r.Context().Done():
+		case <-release:
+		}
+	})
+	// 即使服务端没观察到客户端断连，也先释放处理器，再关闭替身服务器。
+	t.Cleanup(func() { close(release) })
+	ctx, cancel := context.WithTimeout(t.Context(), 500*time.Millisecond)
+	defer cancel()
+	_, err := m.call(ctx, "neartoken:topup", map[string]any{"amount": 20, "paymentMethod": "alipay"})
+	if err == nil || len(*opened) != 1 || len(requests()) != 1 {
+		t.Fatalf("timeout result: err=%v opened=%v requests=%v", err, *opened, requests())
+	}
+	if requests()[0] != "POST /api/dsh/device/topup" {
+		t.Fatalf("unexpected replay target: %v", requests())
+	}
+}
+
+type fallbackTransport func(*http.Request) (*http.Response, error)
+
+func (f fallbackTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type foregroundContextKey struct{}
+
+func TestForegroundConnectCarriesCancellationAndOneDeadline(t *testing.T) {
+	m, _, opened := websiteFallbackManager(t, func(w http.ResponseWriter, r *http.Request) { t.Error("unexpected HTTP server request") })
+	seen := false
+	m.client.http = &http.Client{Transport: fallbackTransport(func(r *http.Request) (*http.Response, error) {
+		seen = true
+		if r.Context().Value(foregroundContextKey{}) != "caller" {
+			t.Error("authorization dropped its caller context")
+		}
+		d, ok := r.Context().Deadline()
+		if !ok || time.Until(d) > 25*time.Second || time.Until(d) <= 0 {
+			t.Error("foreground operation has no 25-second total deadline")
+		}
+		return nil, errors.New("fixture transport failure")
+	})}
+	_, err := m.call(context.WithValue(t.Context(), foregroundContextKey{}, "caller"), "neartoken:connect", nil)
+	if !seen || err == nil || len(*opened) != 1 {
+		t.Fatalf("connect fallback result: seen=%v err=%v opened=%v", seen, err, *opened)
+	}
+}
+
+func TestWebsiteFallbackAddressDropsSecretsAndRejectsOtherSchemes(t *testing.T) {
+	for _, tc := range []struct{ base, want string }{
+		{"https://example.test/proxy/?access_token=fixture-secret#fragment", "https://example.test/proxy/wallet"},
+		{"https://fixture:secret@example.test", ""},
+		{"file:///C:/fixture", ""},
+		{"javascript:alert(1)", ""},
+		{"/relative", ""},
+	} {
+		if got := websiteAddress(tc.base, "/wallet"); got != tc.want {
+			t.Errorf("website address = %q, want %q", got, tc.want)
+		}
+	}
+	if got := websiteFallbackPage("neartoken:refresh", map[string]any{"websitePage": "https://other.example/test"}); got != "/wallet" {
+		t.Errorf("caller selected an arbitrary website: %q", got)
+	}
+}
+
+func TestUserCancellationAndSuccessfulRefreshDoNotOpenFallback(t *testing.T) {
+	m, _, opened := websiteFallbackManager(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == pricingPath {
+			write(w, map[string]any{"success": true, "data": []any{}})
+			return
+		}
+		write(w, map[string]any{"success": true, "data": map[string]any{"quota": 1, "used_quota": 0, "group_credits": []any{}}})
+	})
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if _, err := m.call(ctx, "neartoken:refresh", nil); err == nil {
+		t.Error("canceled refresh claimed success")
+	}
+	if _, err := m.call(t.Context(), "neartoken:refresh", nil); err != nil {
+		t.Fatal(err)
+	}
+	if len(*opened) != 0 {
+		t.Fatalf("cancel/success opened website: %v", *opened)
+	}
+}
