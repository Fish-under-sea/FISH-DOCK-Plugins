@@ -0,0 +1,75 @@
+package plugin
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// writePlugin writes an installed plugin's package.json, its magpie section
+// as given.
+func writePlugin(t *testing.T, spec string, magpie map[string]any) {
+	t.Helper()
+	dir := Target(spec)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	body := map[string]any{"name": Name(spec), "version": "1.0.0"}
+	if magpie != nil {
+		body["magpie"] = magpie
+	}
+	b, err := json.Marshal(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "package.json"), b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// writePlugins writes plugins.json with the specs given.
+func writePlugins(t *testing.T, specs ...string) {
+	t.Helper()
+	f := List{}
+	for _, spec := range specs {
+		f.Plugins = append(f.Plugins, Entry{Spec: spec})
+	}
+	b, err := json.Marshal(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(settings.Dir(), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(settings.Dir(), "plugins.json"), b, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// A plugin that says its providers go once it can't be loaded
+// (magpie.keepListedUntilRemoved: false) leaves them out; one that says
+// nothing keeps them, as before (#41).
+func TestKeepListedUntilRemoved(t *testing.T) {
+	offSandbox(t)
+	writePlugin(t, "keep@1.0.0", nil)
+	writePlugin(t, "gone@1.0.0", map[string]any{"keepListedUntilRemoved": false})
+	writePlugins(t, "keep@1.0.0", "gone@1.0.0")
+
+	last := []Provider{{Spec: "keep@1.0.0", ID: "keep"}, {Spec: "gone@1.0.0", ID: "gone"}}
+	got := keepUnloaded(nil, last)
+	if len(got) != 1 || got[0].ID != "keep" {
+		t.Fatalf("keepUnloaded = %+v, want only the plugin that says nothing", got)
+	}
+	if !KeepListedUntilRemoved("keep@1.0.0") {
+		t.Error("a package saying nothing is not kept")
+	}
+	if KeepListedUntilRemoved("gone@1.0.0") {
+		t.Error("a package saying false is kept")
+	}
+	if !KeepListedUntilRemoved("absent@1.0.0") {
+		t.Error("an unreadable package is not kept")
+	}
+}
