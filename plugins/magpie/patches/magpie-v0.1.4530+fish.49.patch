diff --git a/internal/fishvault/vault.go b/internal/fishvault/vault.go
new file mode 100644
index 0000000..1dc8aa4
--- /dev/null
+++ b/internal/fishvault/vault.go
@@ -0,0 +1,261 @@
+// Package fishvault reads the independent knowledge vault owned by the Dock
+// plugin. Long notes stay notes; the memory package owns short structured facts.
+package fishvault
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/yetone/magpie/internal/appdir"
+)
+
+const Name = "github-capability-vault"
+const Record = ".fish-import.json"
+
+func RootAt(data string) string { return filepath.Join(data, "knowledge", Name) }
+func Root() string              { return RootAt(appdir.Config()) }
+
+// Present includes an unreadable marker: that must fail validation, never make
+// a process silently select the old empty memory root.
+func Present(data string) bool {
+	_, err := os.Lstat(filepath.Join(RootAt(data), Record))
+	return !errors.Is(err, fs.ErrNotExist)
+}
+func Validate(data string) error {
+	root := RootAt(data)
+	info, err := os.Lstat(root)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return errors.New("knowledge vault is not an independent directory")
+	}
+	real, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return err
+	}
+	if !samePath(root, real) {
+		return errors.New("knowledge vault path contains links")
+	}
+	opened, err := os.OpenRoot(root)
+	if err != nil {
+		return err
+	}
+	defer opened.Close()
+	info, err = opened.Lstat(Record)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() || info.Size() > 4<<20 {
+		return errors.New("invalid knowledge import record")
+	}
+	b, err := opened.ReadFile(Record)
+	if err != nil {
+		return err
+	}
+	var record struct {
+		Schema   int               `json:"schema"`
+		Imported *bool             `json:"imported"`
+		Files    []json.RawMessage `json:"files"`
+	}
+	if err = json.Unmarshal(b, &record); err != nil {
+		return err
+	}
+	if record.Schema != 1 || record.Imported == nil || record.Files == nil {
+		return errors.New("invalid knowledge import record")
+	}
+	return nil
+}
+func samePath(a, b string) bool { return strings.EqualFold(filepath.Clean(a), filepath.Clean(b)) }
+
+type Hit struct {
+	Type  string `json:"type"`
+	Title string `json:"title"`
+	Path  string `json:"path"`
+	Text  string `json:"text"`
+	URL   string `json:"url"`
+	score int
+}
+type Result struct {
+	Hits    []Hit `json:"hits"`
+	Skipped int   `json:"skipped"`
+}
+
+func URI(root, rel string) string {
+	// %20, not QueryEscape's '+': the protocol handler may take the value as
+	// a plain path, where a '+' is a plus sign and the vault is not found.
+	return "obsidian://open?path=" + strings.ReplaceAll(url.QueryEscape(filepath.Join(root, filepath.FromSlash(rel))), "+", "%20")
+}
+func ignored(rel string) bool {
+	for _, part := range strings.Split(filepath.ToSlash(rel), "/") {
+		if strings.HasPrefix(part, ".") {
+			return true
+		}
+		switch strings.ToLower(part) {
+		case "memories", "credentials", "keys", "tokens", "node_modules", "tmp", "backups":
+			return true
+		}
+	}
+	return false
+}
+
+// Search reads only Markdown beneath an OS-confined root, on an explicit search
+// (not a background poll). It does not send notes to a model. Limits are reported
+// as skipped notes, never disguised as a complete result.
+func Search(ctx context.Context, data, q string, limit int) (Result, error) {
+	out := Result{Hits: []Hit{}}
+	if !Present(data) {
+		return out, nil
+	}
+	if err := Validate(data); err != nil {
+		return out, err
+	}
+	words := strings.Fields(strings.ToLower(strings.TrimSpace(q)))
+	if len(words) == 0 {
+		return out, nil
+	}
+	if len([]rune(q)) > 2000 {
+		return out, errors.New("knowledge query is too long")
+	}
+	if limit <= 0 {
+		limit = 10
+	}
+	limit = min(limit, 50)
+	rootPath := RootAt(data)
+	root, err := os.OpenRoot(rootPath)
+	if err != nil {
+		return out, err
+	}
+	defer root.Close()
+	count := 0
+	var total int64
+	err = fs.WalkDir(root.FS(), ".", func(rel string, entry fs.DirEntry, walkErr error) error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if walkErr != nil {
+			return walkErr
+		}
+		if rel == "." {
+			return nil
+		}
+		if ignored(rel) {
+			if entry.IsDir() {
+				return fs.SkipDir
+			}
+			return nil
+		}
+		if entry.Type()&os.ModeSymlink != 0 {
+			if entry.IsDir() {
+				return fs.SkipDir
+			}
+			return nil
+		}
+		if entry.IsDir() {
+			return nil
+		}
+		if !strings.EqualFold(filepath.Ext(rel), ".md") {
+			return nil
+		}
+		info, err := root.Lstat(rel)
+		if err != nil {
+			return err
+		}
+		if !info.Mode().IsRegular() {
+			return nil
+		}
+		count++
+		if count > 5000 || info.Size() > 4<<20 || total+info.Size() > 64<<20 {
+			out.Skipped++
+			return nil
+		}
+		file, err := root.Open(rel)
+		if err != nil {
+			return err
+		}
+		b, readErr := io.ReadAll(io.LimitReader(file, (4<<20)+1))
+		closeErr := file.Close()
+		if readErr != nil {
+			return readErr
+		}
+		if closeErr != nil {
+			return closeErr
+		}
+		if len(b) > 4<<20 {
+			out.Skipped++
+			return nil
+		}
+		total += int64(len(b))
+		if !utf8.Valid(b) {
+			out.Skipped++
+			return nil
+		}
+		text := string(b)
+		title := strings.TrimSuffix(filepath.Base(rel), filepath.Ext(rel))
+		for line := range strings.SplitSeq(text, "\n") {
+			if strings.HasPrefix(line, "# ") {
+				title = strings.TrimSpace(strings.TrimPrefix(line, "# "))
+				break
+			}
+		}
+		searchable := strings.ToLower(rel + "\n" + title + "\n" + text)
+		score := 0
+		for _, word := range words {
+			if !strings.Contains(searchable, word) {
+				return nil
+			}
+			score += strings.Count(searchable, word)
+			if strings.Contains(strings.ToLower(title), word) {
+				score += 20
+			}
+			if strings.Contains(strings.ToLower(rel), word) {
+				score += 10
+			}
+		}
+		out.Hits = append(out.Hits, Hit{Type: "note", Title: title, Path: filepath.ToSlash(rel), Text: snippet(text, words), URL: URI(rootPath, rel), score: score})
+		return nil
+	})
+	if err != nil {
+		return out, fmt.Errorf("knowledge notes cannot be read: %w", err)
+	}
+	sort.Slice(out.Hits, func(i, j int) bool {
+		if out.Hits[i].score != out.Hits[j].score {
+			return out.Hits[i].score > out.Hits[j].score
+		}
+		return out.Hits[i].Path < out.Hits[j].Path
+	})
+	if len(out.Hits) > limit {
+		out.Hits = out.Hits[:limit]
+	}
+	return out, nil
+}
+func snippet(text string, words []string) string {
+	runes := []rune(text)
+	start := 0
+	lower := strings.ToLower(text)
+	for _, word := range words {
+		if at := strings.Index(lower, word); at >= 0 {
+			start = max(0, utf8.RuneCountInString(lower[:at])-100)
+			break
+		}
+	}
+	end := min(len(runes), start+600)
+	s := string(runes[start:end])
+	if start > 0 {
+		s = "…" + s
+	}
+	if end < len(runes) {
+		s += "…"
+	}
+	return s
+}
