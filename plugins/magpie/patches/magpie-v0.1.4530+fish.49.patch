+package plugin_test
+
+// t9 (magpie 2.2.1 repro): the real host lifecycle behind #25.
+//
+// The path under test, in the shipped code:
+//
+//	page  -> POST /api/plugin-pages/options (gui/pluginpage.go:505-520)
+//	      -> plugin.SetPageOptions          (plugin/page.go:414-441)
+//	      -> SetOptions                     (plugin/store.go:679: saves, then Restart)
+//	      -> Restart                        (host.go: current = nil, old host retired)
+//	      -> changed()                      (host.go:684 -> providers.go:279 forgetProviders, epoch++)
+//	      -> Providers()                    (providers.go:292: asks the new host, commits)
+//
+// Why the fixture has a request hook and not only a page: a page that is
+// ALL a plugin has is saved without a restart (page.go:426-440, "a plugin
+// whose page and panels are all it has is never loaded by the host"). A
+// plugin with a part in the host is restarted, and the restart is what hands
+// the saved options over (store.go -> Restart; host.js:1268 builds
+// input.magpie at load).
+//
+// The fixture is a page plus a gateway hook -- the shape a page plugin with
+// a part in the host has -- and its own provider reports, through the list
+// the window draws, what it read of its options at the start.
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/gui"
+	"github.com/yetone/magpie/internal/plugin"
+)
+
+const modelFixture = `{
+  "name": "t9-near-model-fixture",
+  "version": "0.0.1",
+  "type": "module",
+  "main": "index.js",
+  "magpie": {
+    "page": { "title": "T9", "file": "page.html", "icon": "icon.svg" },
+    "hooks": "hooks.js",
+    "calls": ["neartoken:state"]
+  }
+}
+`
+
+const hookJS = `
+// the hook file loads before the plugin entry: this is the package-level
+// proof that a page change restarts the host (a new process prints again)
+console.error("T9HOOK loaded at " + Date.now())
+export const onRequest = async (ctx, next) => next()
+`
+
+const modelFixturePage = `<!doctype html><title>T9</title>`
+
+// 修正 t9 的诊断夹具：NearToken 0.6.5 使用工厂第二参数，
+// 不是 input.magpie.option() 对应的 provider auth.options 设置。
+const modelFixtureJS = `
+const ids = ["chat-a", "chat-b", "chat-c", "image-d", "video-e"]
+export const Fixture = async (_input, options) => {
+  const disabledModels = new Set(options?.disabledModels ?? [])
+  return {
+    config: async (cfg) => {
+      cfg.provider ??= {}
+      cfg.provider.nearmodel ??= { name: "NearModel", npm: "@ai-sdk/openai-compatible", api: "http://127.0.0.1:9/v1",
+        models: Object.fromEntries(ids.map((id) => [id, { name: id }])) }
+    },
+    provider: {
+      id: "nearmodel",
+      async models(provider) {
+        return Object.fromEntries(Object.entries(provider.models ?? {}).filter(([id]) => !disabledModels.has(id)))
+      },
+    },
+    auth: {
+      provider: "nearmodel",
+      methods: [{ type: "api", label: "API key" }],
+    },
+  }
+}
+`
+
