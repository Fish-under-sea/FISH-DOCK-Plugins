+
+// Prefs 是 neartoken 设置界面自己读写的偏好：哪些模型停用、哪些分组不显示、
+// 哪些置顶。
+//
+// 它**不走插件的 options 通道**（那是 magpie 的插件设置，改一次宿主就重建插件，
+// 供应商会在列表里闪一下），而是自己落一份 JSON：写它只动这个文件与内存里的
+// 副本，插件不重建、供应商不掉（#33）。
+// PrefModel 是设置界面停用的一个模型。Groups 是插件自己的分组名（站点分组墙上
+// 的 `[低价] DeepSeek` 这种）——magpie 的模型平面上没有「分组」这一维，所以宿主
+// 侧过滤只按 Model 走；Groups 原样存下来，给插件的页面与后续按组过滤留着。
+type PrefModel struct {
+	Model  string   `json:"model"`
+	Groups []string `json:"groups,omitempty"`
+}
+
+type Prefs struct {
+	// Disabled 是用户在设置界面停掉的模型。写的是模型自己的 id
+	// （deepseek-flash 这种），不是 provider/model。
+	Disabled []PrefModel `json:"disabled,omitempty"`
+	// HiddenGroups 是分组墙里被收起的分组。
+	HiddenGroups []string `json:"hiddenGroups,omitempty"`
+	// Pinned 是置顶的模型 id。
+	Pinned []string `json:"pinned,omitempty"`
+	// UpdatedAt 是上一次写入的时间（Unix 秒），页面用它说“多久前改的”。
+	UpdatedAt int64 `json:"updatedAt,omitempty"`
+}
+
+// ModelIDs 是停用的那些模型的 id，按出现顺序去重：宿主侧过滤只认这个。
+//
+// 只看 Model、不看 Groups（#36 需求三）。宿主的模型清单没有「分组」这一维：
+// 插件给的模型表按模型去重，一个模型在哪几个分组启用，宿主看不到。所以口径
+// 落在插件的契约上——插件只在「这个模型所有分组都停用」时把条目交上来
+// （页面 hostPayload），部分分组停用只留在页面自己的明细里。条目里的 groups
+// 是给页面与将来按组过滤用的，不参与宿主这一判断。
+func (p Prefs) ModelIDs() []string {
+	out := make([]string, 0, len(p.Disabled))
+	for _, d := range p.Disabled {
+		if d.Model == "" || slices.Contains(out, d.Model) {
+			continue
+		}
+		out = append(out, d.Model)
+	}
+	return out
+}
+
+// PrefsPath 是这份偏好的位置，与 neartoken.json 同目录（config 层）。
+func PrefsPath() string { return filepath.Join(appdir.Config(), "neartoken-prefs.json") }
+
+// prefsCache 记住读出来的那份，省掉每次调用都读一遍盘；写成功才替换。
+var prefsCache struct {
+	sync.Mutex
+	at   int64 // 文件修改时间，用来发现别人改过
+	pref Prefs
+	ok   bool
+}
+
+// LoadPrefs 读回偏好；文件不存在、解不开都当作没有偏好（空值），绝不拿坏文件
+// 覆盖上一次的好数据。
+func LoadPrefs() Prefs {
+	prefsCache.Lock()
+	defer prefsCache.Unlock()
+	st, err := os.Stat(PrefsPath())
+	if err != nil {
+		return Prefs{}
+	}
+	if prefsCache.ok && prefsCache.at == st.ModTime().UnixNano() {
+		return prefsCache.pref
+	}
+	b, err := os.ReadFile(PrefsPath())
+	if err != nil {
+		return Prefs{}
+	}
+	var p Prefs
+	if json.Unmarshal(b, &p) != nil {
+		return Prefs{}
+	}
+	prefsCache.at, prefsCache.pref, prefsCache.ok = st.ModTime().UnixNano(), p, true
+	return p
+}
+
+// SavePrefs 写回偏好：先写临时文件再改名，写一半断掉也不会留下坏 JSON。
+func SavePrefs(p Prefs) error {
+	path := PrefsPath()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	b, err := json.MarshalIndent(p, "", "  ")
+	if err != nil {
+		return err
+	}
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, append(b, '\n'), 0o644); err != nil {
+		return err
+	}
+	if err := os.Rename(tmp, path); err != nil {
+		return err
+	}
+	if st, serr := os.Stat(path); serr == nil {
+		prefsCache.Lock()
+		prefsCache.at, prefsCache.pref, prefsCache.ok = st.ModTime().UnixNano(), p, true
+		prefsCache.Unlock()
+	}
+	mirrorPrefsToPage(p)
+	return nil
+}
+
+// ids 把页面给的一串 id 读成 []string：接受 []any（JSON 解出来的）与 []string，
+// 空值算清空。给的不是数组就是参数错——不猜。
+func ids(v any) ([]string, bool) {
+	switch t := v.(type) {
+	case nil:
+		return nil, true
+	case []string:
+		return t, true
+	case []any:
+		out := make([]string, 0, len(t))
+		for _, e := range t {
+			s, ok := e.(string)
+			if !ok || s == "" {
+				return nil, false
+			}
+			out = append(out, s)
+		}
+		return out, true
+	}
+	return nil, false
+}
+
+// prefModels 读页面给的 disabled：两种形状都收——
+//
+//	· `["tts-1", …]`            纯 id（早期页面 / 手写配置）；
+//	· `[{"model":"x","groups":[G]}]`  插件现在的写法（带站点分组）。
+//
+// 别的形状算参数错，不猜。
+func prefModels(v any) ([]PrefModel, bool) {
+	switch t := v.(type) {
+	case nil:
+		return nil, true
+	case []PrefModel:
+		return t, true
+	case []any:
+		out := make([]PrefModel, 0, len(t))
+		for _, e := range t {
+			switch it := e.(type) {
+			case string:
+				if it == "" {
+					return nil, false
+				}
+				out = append(out, PrefModel{Model: it})
+			case map[string]any:
+				model, _ := it["model"].(string)
+				if model == "" {
+					return nil, false
+				}
+				var groups []string
+				if g, ok := it["groups"]; ok {
+					list, good := ids(g)
+					if !good {
+						return nil, false
+					}
+					groups = list
+				}
+				out = append(out, PrefModel{Model: model, Groups: groups})
+			default:
+				return nil, false
+			}
+		}
+		return out, true
+	}
+	return nil, false
+}
+
+// prefs 是 neartoken:prefs 的实现：get 读、set 写、clear 清空。
+// 三种都只回同一个形状，页面拿到就能重画。
+func (m *Manager) prefs(ctx context.Context, params map[string]any) (any, error) {
+	_ = ctx
+	op, _ := params["op"].(string)
+	switch op {
+	case "", "get":
+		return prefsView(LoadPrefs()), nil
+	case "set":
+		cur := LoadPrefs()
+		if v, ok := params["disabled"]; ok {
+			list, good := prefModels(v)
+			if !good {
+				return nil, fail(CodeBadParam, "disabled 要一串 {model, groups} 或一串模型 id")
+			}
+			cur.Disabled = list
+		}
+		if v, ok := params["hiddenGroups"]; ok {
+			list, good := ids(v)
+			if !good {
+				return nil, fail(CodeBadParam, "hiddenGroups 要一串分组名")
+			}
+			cur.HiddenGroups = list
+		}
+		if v, ok := params["pinned"]; ok {
+			list, good := ids(v)
+			if !good {
+				return nil, fail(CodeBadParam, "pinned 要一串模型 id")
+			}
+			cur.Pinned = list
+		}
+		cur.UpdatedAt = time.Now().Unix()
+		if err := SavePrefs(cur); err != nil {
+			return nil, fail(CodeRefused, "保存偏好失败：%v", err)
+		}
+		return prefsView(cur), nil
+	case "clear":
+		gone := Prefs{UpdatedAt: time.Now().Unix()}
+		if err := SavePrefs(gone); err != nil {
+			return nil, fail(CodeRefused, "清空偏好失败：%v", err)
+		}
+		return prefsView(gone), nil
+	}
+	return nil, fail(CodeBadParam, "没有这个动作：%s（get / set / clear）", op)
+}
+
+// prefsView 是页面拿到的形状：{disabled, hiddenGroups, pinned, updatedAt, path}。
+func prefsView(p Prefs) map[string]any {
+	out := map[string]any{
+		"disabled":     p.Disabled,
+		"models":       p.ModelIDs(),
+		"hiddenGroups": p.HiddenGroups,
+		"pinned":       p.Pinned,
+		"updatedAt":    p.UpdatedAt,
+		"path":         PrefsPath(),
+	}
+	for k, v := range out {
+		if s, isList := v.([]string); isList && s == nil {
+			out[k] = []string{}
+		}
+	}
+	return out
+}
+
+// HiddenModels 是「neartoken 这个供应商现在不该出现在清单里的模型」——设置
+// 界面里被停用的那些（#33）。它被注册进 provider（见 init），只剔模型、不碰
+// 供应商本身，所以停用模型不会让 neartoken 从供应商列表里掉出去。
+func HiddenModels(providerID string) []string {
+	if providerID != ProviderID {
+		return nil
+	}
+	return LoadPrefs().ModelIDs()
+}
+
+func init() { provider.SetModelFilter(HiddenModels) }
+
+// pagePrefsName 是插件页面自己读的那一份：宿主把同一份偏好镜像进它的 `page/`
+// 目录，页面开机就能画，不必等一次 `{op:'get'}`。写不进去不算失败——调用通道
+// 还在，页面还有第二条路。
+const pagePrefsName = "prefs.json"
+
+// pluginPageDir 返回本插件页面的目录。做成变量是为了测试能换掉：真实实现要
+// 走 plugin.Listed() → plugin.Target(spec) → plugin.Window(dir)，那三级都要
+// 磁盘上的真状态。
+var pluginPageDir = func() string {
+	list, ok := plugin.Listed()
+	if !ok {
+		return ""
+	}
+	for _, pp := range list {
+		if pp.ID != ProviderID {
+			continue
+		}
+		w, _ := plugin.Window(plugin.Target(pp.Spec))
+		if w == nil || w.Page == nil {
+			return ""
+		}
+		return w.Page.Dir
+	}
+	return ""
+}
+
+// mirrorPrefsToPage 把偏好镜像进插件的 page 目录（#33）。失败静默：这是给人
+// 看的便利，不是唯一的数据来源。
+func mirrorPrefsToPage(p Prefs) {
+	dir := pluginPageDir()
+	if dir == "" {
+		return
+	}
+	b, err := json.MarshalIndent(p, "", "  ")
+	if err != nil {
+		return
+	}
+	_ = os.WriteFile(filepath.Join(dir, pagePrefsName), append(b, '\n'), 0o644)
+}
diff --git a/internal/neartoken/prefs_test.go b/internal/neartoken/prefs_test.go
