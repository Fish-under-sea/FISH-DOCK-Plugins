+// rotateMax is how large usage.jsonl may grow before it is rolled to
+// usage.jsonl.1, keeping one previous file (#46). Two of them are the most
+// the log takes; a variable for the tests, which write no 128 MB.
+var rotateMax int64 = 128 << 20
+
+// rollLog rolls path to path+".1" once it is large enough, closing the log
+// Append keeps open so the next openLog makes a new one. The .1 already
+// there goes first: Windows fails a rename onto an existing file, and a
+// roll that failed would leave the log growing as before (#46).
+func rollLog(path string) {
+	st, err := os.Stat(path)
+	if err != nil || st.Size() < rotateMax {
+		return
+	}
+	if heldLog.f != nil {
+		heldLog.f.Close()
+		heldLog.f = nil
+	}
+	if os.Rename(path, path+".1") == nil {
+		return
+	}
+	os.Remove(path + ".1")
+	_ = os.Rename(path, path+".1")
+}
+
+// visitArchive calls fn with each record of the rolled-away log,
+// usage.jsonl.1, since since (#46). The calls before the live log's first
+// record are there, so a key's spend cap counted from a start before the
+// roll still reads them. Read whole, as Load reads the live log: it has no
+// index of its own, being read only when a window reaches past the live
+// log's first record.
+func visitArchive(since time.Time, fn func(Record)) {
+	f, err := os.Open(Path() + ".1")
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	reader := bufio.NewReaderSize(f, 64<<10)
+	for {
+		b, err := reader.ReadBytes('\n')
+		if err != nil {
+			break
+		} // an unfinished line is left, as Load leaves it
+		var r Record
+		if json.Unmarshal(b, &r) == nil && !r.IsProbe() && (since.IsZero() || !r.Time.Before(since)) {
+			fn(r)
+		}
+	}
+}
