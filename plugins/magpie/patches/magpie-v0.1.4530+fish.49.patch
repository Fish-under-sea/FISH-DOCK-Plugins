+		t.Fatalf("learn: %+v ok=%v", a, ok)
+	}
+}
+
+// The version is filled in for a file written before it was kept, and one
+// from a later magpie keeps its own.
+func TestVersionFilledIn(t *testing.T) {
+	p := tempPath(t)
+	write(t, p, `{"agents":[{"id":"a","name":"x","role":"learn","model":"m"}]}`)
+	if r := mustLoad(t); r.Version != Version {
+		t.Fatalf("version: %d", r.Version)
+	}
+	write(t, p, `{"version":7,"agents":[{"id":"a","name":"x","role":"learn","model":"m"}]}`)
+	if r := mustLoad(t); r.Version != 7 {
+		t.Fatalf("a later version was rewritten: %d", r.Version)
+	}
+}
+
+// Before a change is written, the file there now is kept as the last good
+// generation, so a change cut short reads back from it.
+func TestSaveKeepsLastGood(t *testing.T) {
+	p := tempPath(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	first, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Add(Agent{ID: "second", Name: "第二个", Role: Organize, Model: "group/deepseek"}); err != nil {
+		t.Fatal(err)
+	}
+	bak, err := os.ReadFile(lastgood.Bak(p))
+	if err != nil {
+		t.Fatalf("no last good generation: %v", err)
+	}
+	if string(bak) != string(first) {
+		t.Fatalf("the .bak isn't what was there before: %s", bak)
+	}
+	// a file cut short reads back from that generation, noted once
+	cur, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	write(t, p, string(cur[:len(cur)/2]))
+	lastgood.Reset()
+	t.Cleanup(lastgood.Reset)
+	r := mustLoad(t)
+	if _, ok := r.Get("second"); ok {
+		t.Fatalf("read back the change from a cut-short file: %+v", r.Agents)
+	}
+	if len(r.Agents) != 2 {
+		t.Fatalf("read back: %+v", r.Agents)
+	}
+	if notes := lastgood.Recovered(); len(notes) != 1 || notes[0].Path != p {
+		t.Fatalf("recovery not noted: %+v", notes)
+	}
+}
+
+// A file there that doesn't read is copied aside before it is written over,
+// so what it held isn't lost: it is unknown, never empty.
+func TestBadFileKeptAsideBeforeWrite(t *testing.T) {
+	p := tempPath(t)
+	write(t, p, "{broken")
+	if err := save(Builtin()); err != nil {
+		t.Fatalf("save over a bad file: %v", err)
+	}
+	kept, err := filepath.Glob(p + ".bad-*")
+	if err != nil || len(kept) != 1 {
+		t.Fatalf("the bad file wasn't kept aside: %v %v", kept, err)
+	}
+	if b, err := os.ReadFile(kept[0]); err != nil || string(b) != "{broken" {
+		t.Fatalf("kept aside: %q %v", b, err)
