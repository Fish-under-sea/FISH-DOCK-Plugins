+const APP = 'http://127.0.0.1:19221';
+const TARGET = 'https://links.example.test/model?group=alpha&unit=M&mode=credits#details';
+const policy = dock => [
+  'sandbox allow-scripts', "default-src 'none'", `script-src ${APP}${PREFIX}`,
+  `style-src ${APP}${PREFIX} 'unsafe-inline'`, `img-src ${APP}${PREFIX} data:`,
+  `font-src ${APP}${PREFIX}`, "connect-src 'none'", `frame-src ${APP}${PREFIX}`,
+  "worker-src 'none'", "object-src 'none'", "form-action 'none'", "base-uri 'none'",
+].join('; ');
+const html = `<!doctype html><meta charset="utf-8"><script src="_magpie/bridge.js"></script><script src="fixture.js" defer></script>
+<style>body{padding:20px}a,button{display:block;margin:12px 0;padding:8px}#section{margin-top:60px}</style>
+<h1>外链回归夹具</h1><a id="blank" target="_blank" href="${TARGET.replaceAll('&','&amp;')}">普通新窗口链接</a>
+<a id="same" href="${TARGET.replaceAll('&','&amp;')}">普通同窗口外链</a>
+<div id="card"><a id="detail" target="_blank" href="${TARGET.replaceAll('&','&amp;')}">模型详情（阻止冒泡，不切换卡片）</a></div>
+<a id="hash" href="#section">页内锚点</a><a id="site" href="page2.html?kept=1#target">站内下一页</a>
+<h2 id="section">锚点目标</h2>`;
+const fixtureJS = `window.cardToggles=0;document.getElementById('card').onclick=()=>window.cardToggles++;document.getElementById('detail').onclick=e=>e.stopPropagation();`;
+
+function routeFor(mode, seen) {
+  return async route => {
+    const req=route.request(), u=new URL(req.url());
+    const json=data=>route.fulfill({json:data});
+    if(u.origin==='http://tauri.localhost') return route.fulfill({contentType:'text/html',body:`<!doctype html><meta charset=utf-8><style>body{margin:0}iframe{width:100vw;height:calc(100vh - 38px);border:0}h3{margin:0;height:38px;font:16px sans-serif}</style><h3>Dock service iframe fixture（非已安装 Dock）</h3><iframe id="magpie" name="magpie" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-downloads" referrerpolicy="no-referrer" src="${APP}/"></iframe>`});
+    if(u.origin===new URL(TARGET).origin) {seen.external.push(req.url());return route.fulfill({contentType:'text/html',body:'<h1>External fixture destination</h1>'});}
+    if(u.origin!==APP) return route.fulfill({status:404,body:''});
+    if(u.pathname==='/boot.js') return route.fulfill({contentType:'text/javascript',body:`window.bootPrefs={lang:'zh',theme:'light',web:${mode.web}};`});
+    if(u.pathname==='/wails/runtime.js') return route.fulfill({contentType:'text/javascript',body:'export const Window={};'});
+    if(u.pathname==='/api/state') return json({agents:[],profiles:[],settings:{lang:'zh',theme:'light'}});
+    if(u.pathname==='/api/providers') return json({providers:[],presets:[],excluded:[],gateway:{running:true,window:true},plugins:[]});
+    if(u.pathname==='/api/groups') return json({groups:[],pools:[]});
+    if(u.pathname==='/api/plugin-pages') return json([{spec:'/fixture/links',name:'link-fixture',key:'plugin-links',title:'外链验收',reads:[],calls:[],url:PREFIX+'index.html',icon:''}]);
+    if(u.pathname==='/api/plugin-panels') return json([]);
+    if(u.pathname==='/api/plugins') return json({bun:true,plugins:[]});
+    if(u.pathname==='/api/plugins/market') return json({listings:[],state:{bun:true,plugins:[]}});
+    if(u.pathname==='/api/plugins/listings') return json({listings:[]});
+    if(u.pathname==='/api/open') {seen.opens.push(req.postDataJSON());return route.fulfill({status:204,body:''});}
+    if(u.pathname==='/api/plugin-pages/call') {seen.calls.push(req.postDataJSON());return json({});}
+    if(u.pathname.startsWith('/api/')) return json({});
+    if(u.pathname.startsWith(PREFIX)) {
+      const rel=u.pathname.slice(PREFIX.length);
+      let body, contentType='text/html; charset=utf-8';
+      if(rel==='_magpie/bridge.js'){body=await fs.readFile(bridge);contentType='text/javascript; charset=utf-8';}
+      else if(rel==='fixture.js'){body=fixtureJS;contentType='text/javascript; charset=utf-8';}
+      else if(rel==='index.html') body=html;
+      else if(rel==='page2.html') body='<!doctype html><script src="_magpie/bridge.js"></script><h1 id="target">站内第二页</h1>';
+      else return route.fulfill({status:404,body:''});
+      return route.fulfill({body,headers:{'Content-Type':contentType,'Content-Security-Policy':policy(mode.dock),'Referrer-Policy':'no-referrer','X-Content-Type-Options':'nosniff'}});
+    }
+    const file=path.join(assets,u.pathname==='/'?'index.html':u.pathname);
+    if(!file.startsWith(assets+path.sep)) return route.fulfill({status:404,body:''});
+    const contentType={'.html':'text/html','.js':'text/javascript','.css':'text/css','.svg':'image/svg+xml','.png':'image/png','.woff2':'font/woff2'}[path.extname(file)];
+    try{return route.fulfill({body:await fs.readFile(file),contentType});}catch{return route.fulfill({status:404,body:''});}
+  };
+}
