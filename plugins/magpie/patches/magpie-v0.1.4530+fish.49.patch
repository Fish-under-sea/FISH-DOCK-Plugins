+
+// fishMediaModelIDs are ms' ids, for a list compared by what it says.
+func fishMediaModelIDs(ms []catalog.Model) []string {
+	out := make([]string, 0, len(ms))
+	for _, m := range ms {
+		out = append(out, m.ID)
+	}
+	return out
+}
+
+// pluginHome prepares a settings directory for a plugin's provider, signed
+// in, its models as given.
+func pluginHome(t *testing.T, pp plugin.Provider) {
+	t.Helper()
+	write := func(name string, v any) {
+		t.Helper()
+		b, _ := json.Marshal(v)
+		os.MkdirAll(settings.Dir(), 0o700)
+		if err := os.WriteFile(filepath.Join(settings.Dir(), name), b, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("plugins.json", map[string]any{"plugins": []map[string]any{{"spec": pp.Spec}}})
+	write("plugin-auth.json", map[string]map[string]any{pp.ID: {"type": "api", "key": "k-" + pp.ID}})
+	plugin.UseCached([]plugin.Provider{pp})
+	t.Cleanup(func() { plugin.UseCached(nil) })
+}
+
+// A plugin's model for another API reaches the speech and embedding rows: a
+// plugin's models are in no fetched list, so servingOf never saw them and
+// Settings → Images listed only what a relay's own /v1/models had (the
+// report behind #42). The kind the plugin says is what files it there.
+func TestSpeakersTakeAPluginsDeclaredKinds(t *testing.T) {
+	fresh(t)
+	pluginHome(t, plugin.Provider{ID: "neartoken", Spec: "@fish-under-sea/magpie-neartoken", Name: "NearToken",
+		Methods:  []plugin.Method{{Type: "api", Label: "API key"}},
+		Accounts: []plugin.Account{{Key: "neartoken", Type: "api"}},
+		Models: []plugin.Model{
+			{ID: "suno_music", Name: "Suno Music", Kind: "audio", Outputs: []string{"audio", "text"}, OutputsSaid: true},
+			{ID: "gemini-embedding-2", Name: "Gemini Embedding 2", Kind: "embedding", Outputs: []string{"embedding", "text"}, OutputsSaid: true},
+			{ID: "gpt-5", Name: "GPT-5", Outputs: []string{"text"}, OutputsSaid: true},
+		}})
+	p, err := provider.Find("neartoken")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := fishMediaModelIDs(Speakers(*p)); !slices.Equal(got, []string{"suno_music"}) {
+		t.Errorf("Speakers = %v, want the plugin's audio model", got)
+	}
+	if got := fishMediaModelIDs(Embedders(*p)); !slices.Equal(got, []string{"gemini-embedding-2"}) {
+		t.Errorf("Embedders = %v, want the plugin's embedding model", got)
+	}
+}
+
+// The user's word files a model too: a relay whose list says nothing of its
+// TTS leaves it a chat model, and saying it is a speech model is what puts it
+// in the row (#42). One said to draw serves no speech API, whatever its list
+// said.
+func TestSpeakersTakeTheUsersWord(t *testing.T) {
+	fresh(t)
+	if err := provider.Save(provider.Provider{ID: "relay", Name: "Relay", Chat: "http://relay.test/v1", Key: "k",
+		Models: []string{"cosyvoice-2", "suno-v5", "gpt-5"}}); err != nil {
+		t.Fatal(err)
+	}
+	p, err := provider.Find("relay")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := fishMediaModelIDs(Speakers(*p)); len(got) != 0 {
+		t.Fatalf("Speakers before the user said = %v, want none", got)
+	}
+	if err := provider.SetModelKind("relay/cosyvoice-2", provider.KindSpeech); err != nil {
+		t.Fatal(err)
+	}
+	if err := provider.SetModelKind("relay/suno-v5", provider.KindSpeech); err != nil {
+		t.Fatal(err)
+	}
+	if err := provider.SetModelKind("relay/suno-v5", provider.KindVideo); err != nil {
+		t.Fatal(err)
+	}
+	if got := fishMediaModelIDs(Speakers(*p)); !slices.Equal(got, []string{"cosyvoice-2"}) {
+		t.Errorf("Speakers = %v, want the one said to be a speech model", got)
+	}
+}
