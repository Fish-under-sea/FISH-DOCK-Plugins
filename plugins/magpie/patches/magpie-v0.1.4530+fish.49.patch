+	t.Setenv("HOME", dir)
+	t.Setenv("USERPROFILE", dir)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(dir, "config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(dir, "cache"))
+	bun := os.Getenv("T9_BUN")
+	if bun == "" {
+		if found, err := exec.LookPath("bun"); err == nil {
