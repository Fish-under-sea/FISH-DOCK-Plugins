+// A role's default naming an agent that isn't there is moved to one that
+// carries the role out, and dropped when there is none.
+func TestFillDefaultsRepairs(t *testing.T) {
+	r := Builtin()
+	r.Defaults[Learn] = "gone"
+	r.Defaults[Dream] = "memory-curator" // a learn agent, not a dream one
+	fillDefaults(&r)
+	if r.Defaults[Learn] != "memory-curator" {
+		t.Fatalf("learn: %q", r.Defaults[Learn])
