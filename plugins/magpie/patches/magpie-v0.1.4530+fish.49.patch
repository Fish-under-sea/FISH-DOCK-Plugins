 			Panels      []part   `json:"panels"`
 			Actions     []part   `json:"actions"`
 			Permissions []string `json:"permissions"`
+			Calls       []string `json:"calls"`
 		} `json:"magpie"`
 	}
 	if json.Unmarshal(b, &pkg) != nil {
@@ -229,6 +291,11 @@ func Window(target string) (w *WindowSpec, only bool) {
 			w.Reads = append(w.Reads, r)
 		}
 	}
+	// a call is what the page may ask for, so a plugin with no page and no
+	// panel has none to ask; what magpie doesn't have is left out
+	if w.Page != nil || len(w.Panels) > 0 {
+		w.Calls = callsKeeping(pkg.Magpie.Calls)
+	}
 	return w, pkg.Main == "" && len(pkg.Exports) == 0
 }
 
