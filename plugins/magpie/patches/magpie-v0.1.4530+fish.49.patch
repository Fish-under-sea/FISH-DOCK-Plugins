+async function frameMessage(frame, message, inactive = false) {
+  return frame.evaluate(async ({message, inactive}) => {
+    // 等待浏览器的真实状态，不把自动化求值可能携带的激活误当作后台状态。
+    if (inactive) {
+      const deadline = Date.now()+8000;
+      while (navigator.userActivation.isActive) {
+        if (Date.now() > deadline) throw Error('user activation did not expire');
+        await new Promise(resolve => setTimeout(resolve, 50));
+      }
+    }
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => { removeEventListener('message', receive); reject(Error('fixture message timed out')); }, 2000);
+      function receive(ev) {
+        if (ev.source !== parent || ev.data?.magpie !== 1 || ev.data?.id !== message.id) return;
+        clearTimeout(timer); removeEventListener('message', receive); resolve(ev.data);
+      }
+      addEventListener('message', receive);
+      parent.postMessage(message, '*');
+    });
+  }, {message, inactive});
+}
