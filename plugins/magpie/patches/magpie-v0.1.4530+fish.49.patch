@@ -0,0 +1,67 @@
+package provider
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/yetone/magpie/internal/plugin"
+)
+
+// #33：设置界面停用一个模型 → 它从清单里消失，**供应商不受影响**（供应商由
+// 插件注册，与模型清单无关）。这是「启停模型不掉供应商」的机器证明。
+func TestModelFilterHidesAModelButNotTheProvider(t *testing.T) {
+	pp := plugin.Provider{
+		ID:   "neartoken",
+		Spec: "@fish-under-sea/magpie-neartoken",
+		Models: []plugin.Model{
+			{ID: "glm-5.3", Outputs: []string{"text"}},
+			{ID: "tts-1", Outputs: []string{"audio"}},
+			{ID: "text-embedding-3-large", Outputs: []string{"embedding"}},
+		},
+	}
+
+	before := pluginCatalog(pp)
+	if len(before) != 3 {
+		t.Fatalf("不过滤时 = %d 个模型，want 3：%+v", len(before), before)
+	}
+
+	// 只停用 tts-1
+	SetModelFilter(func(providerID string) []string {
+		if providerID != "neartoken" {
+			return nil
+		}
+		return []string{"tts-1"}
+	})
+	t.Cleanup(func() { SetModelFilter(nil) })
+
+	after := pluginCatalog(pp)
+	if len(after) != 2 {
+		t.Fatalf("过滤后 = %d 个模型，want 2：%+v", len(after), after)
+	}
+	for _, m := range after {
+		if m.ID == "tts-1" {
+			t.Fatal("停用的模型还在清单里")
+		}
+	}
+	// 别的供应商不受影响：过滤器按 id 说话
+	if got := pluginCatalog(plugin.Provider{ID: "cline", Models: pp.Models}); len(got) != 3 {
+		t.Fatalf("别的供应商被带累了 = %d 个，want 3", len(got))
+	}
+	// 供应商本身还在：它由插件注册，不经过 pluginCatalog
+	if !slices.ContainsFunc([]string{pp.ID}, func(s string) bool { return s == "neartoken" }) {
+		t.Fatal("这条用例的前提坏了")
+	}
+}
+
+// 过滤器返回空列表（用户什么都没停用）时一个都不该少。
+func TestModelFilterEmptyKeepsEverything(t *testing.T) {
+	pp := plugin.Provider{
+		ID:     "neartoken",
+		Models: []plugin.Model{{ID: "glm-5.3", Outputs: []string{"text"}}},
+	}
+	SetModelFilter(func(string) []string { return nil })
+	t.Cleanup(func() { SetModelFilter(nil) })
+	if got := pluginCatalog(pp); len(got) != 1 {
+		t.Fatalf("= %d 个，want 1", len(got))
+	}
+}
