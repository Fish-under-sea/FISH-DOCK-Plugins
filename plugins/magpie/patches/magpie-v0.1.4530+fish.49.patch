@@ -360,10 +360,38 @@ func pluginTierOn(provider string, m plugin.Model, tier string) bool {
 	return (to == Chat || to == Responses) && slices.Contains(m.ServiceTiers, tier)
 }
 
+// modelFilter 是「某个供应商现在不该出现在清单里的模型」，由用它自己的设置
+// 界面的那一侧注册（#33：neartoken 的设置界面停用模型）。nil 表示没人管。
+//
+// 它只影响**模型清单**，不影响供应商本身：供应商由插件注册，与它的模型清单
+// 无关，所以停用一个模型不会让供应商从列表里掉出去——那正是 #33 要的。
+// 用注册函数而不是直接依赖 neartoken 包：neartoken 已经 import provider，
+// 反过来再 import 会循环。
+var modelFilter func(providerID string) []string
+
+// SetModelFilter 注册上面那个函数；传 nil 撤回。（可见性那边已有的
+// SetHiddenModels 是给 agent 用的另一件事，别混。）
+func SetModelFilter(f func(providerID string) []string) { modelFilter = f }
+
 func pluginCatalog(pp plugin.Provider) []catalog.Model {
+	return pluginCatalogWhere(pp, pluginTalks)
+}
+
+// pluginCatalogWhere is pluginCatalog of the models keep takes: the host's
+// chat list takes those a plugin says can be talked with, and PluginServing
+// takes every model, to file the ones for another API apart (#42).
+func pluginCatalogWhere(pp plugin.Provider, keep func(plugin.Model) bool) []catalog.Model {
 	out := make([]catalog.Model, 0, len(pp.Models))
+	// 一次构建取一遍，不按模型逐个问（那会把一次磁盘 stat 放大成每个模型一次）
+	var hidden []string
+	if modelFilter != nil {
+		hidden = modelFilter(pp.ID)
+	}
 	for _, m := range pp.Models {
-		if !pluginTalks(m) {
+		if !keep(m) {
+			continue
+		}
+		if len(hidden) > 0 && slices.Contains(hidden, m.ID) {
 			continue
 		}
 		c := catalog.Model{
@@ -439,19 +467,129 @@ func pluginCatalog(pp plugin.Provider) []catalog.Model {
 			c.InputModalities = m.Inputs
 		}
 		c.OutputModalities = m.Outputs
+		// #24：插件用 capabilities.output 说这一行是干什么的——image / video /
+		// audio / embedding 各归各的类。图像与视频沿用上游的 Draws / Films；
+		// 语音与向量落到上游的 Serves（speech / transcription / embedding /
+		// rerank），不再另立 Audio / Embedding 两个布尔——上游的抓取、过滤
+		// （catalog.Chat、LiveServing）与自动分组都按 Serves 走，两套字段并存
+		// 只会让同一件事有两个真相。
+		// #42：插件自己给的 kind 先说，capabilities.output 与 id 只兜底——
+		// 站点按自己的分组判，比按名字猜靠得住（NearToken 的 kindOf）。
+		pluginKind(&c, m)
 		out = append(out, c)
 	}
 	return out
 }
 
+// pluginKind files a plugin's model under what it is for (#42): the kind the
+// plugin says, else what its capabilities.output gives (#24), else what its
+// id says. An image model comes to Draws, a video one to Films, and speech,
+// transcription, embedding and rerank to the Serves value each is filed
+// under — the four the gateway's /v1/models, Settings and the editor's
+// sections take.
+func pluginKind(c *catalog.Model, m plugin.Model) {
+	switch strings.ToLower(strings.TrimSpace(m.Kind)) {
+	case "image":
+		c.Draws = true
+		return
+	case "video":
+		c.Films = true
+		return
+	case "audio":
+		c.Serves = speechKindOf(m.ID)
+		return
+	case "embedding":
+		c.Serves = embedKindOf(m.ID)
+		return
+	}
+	for _, o := range m.Outputs {
+		switch o {
+		case "image":
+			c.Draws = true
+		case "video":
+			c.Films = true
+		case "audio":
+			c.Serves = speechKindOf(m.ID)
+		case "embedding":
+			c.Serves = embedKindOf(m.ID)
+		}
+	}
+	// 插件没说输出、但 id 自己写着是干什么的（text-embedding-3-small、tts-1、
+	// whisper-1）：按上游 ServesOf 认下来。声明优先，id 只兜底。
+	if c.Serves == "" {
+		c.Serves = catalog.ServesOf(m.ID)
+	}
+}
+
+// speechKindOf is the Serves value an audio model is filed under: what its id
+// says between speech and transcription, else speech.
+func speechKindOf(id string) string {
+	switch s := catalog.ServesOf(id); s {
+	case catalog.ServesSpeech, catalog.ServesTranscription:
+		return s
+	}
+	return catalog.ServesSpeech
+}
+
+// embedKindOf is the Serves value an embedding model is filed under: what its
+// id says between embedding and rerank, else embedding.
+func embedKindOf(id string) string {
+	switch s := catalog.ServesOf(id); s {
+	case catalog.ServesEmbedding, catalog.ServesRerank:
+		return s
+	}
+	return catalog.ServesEmbedding
+}
+
+// PluginServing are the models p's plugin says serve an API other than chat
+// (Serves set), whether or not it can be talked with: the ones the gateway's
+// /v1/models, Settings' speech and embedding rows and the editor's sections
+// take (#42). A plugin's models are in no fetched list, so nothing else tells.
+func PluginServing(p Provider) []catalog.Model {
+	pp, ok := PluginOf(p.ID)
+	if !ok || !p.IsPlugin() {
+		return nil
+	}
+	var out []catalog.Model
+	for _, m := range pluginCatalogWhere(pp, func(m plugin.Model) bool { return true }) {
+		if m.Serves == "" {
+			continue
+		}
+		out = append(out, m)
+	}
+	return out
+}
+
+// PluginUnkinded are the models p's plugin says give something other than
+// chat, without saying what API they serve: they leave the chat list and land
+// in no section, so the editor lists them for the user to place (#42).
+func PluginUnkinded(p Provider) []catalog.Model {
+	pp, ok := PluginOf(p.ID)
+	if !ok || !p.IsPlugin() {
+		return nil
+	}
+	var out []catalog.Model
+	for _, m := range pluginCatalogWhere(pp, func(m plugin.Model) bool { return !pluginTalks(m) }) {
+		if m.Serves == "" && !m.Draws && !m.Films {
+			out = append(out, m)
+		}
+	}
+	return out
+}
+
 // pluginTalks is whether m is a model to talk with, as its plugin says
 // what it gives: one that gives text, or images or videos (whose place is
 // #2792's to decide, a drawing model kept where it is until then), or one
-// said nothing of. An embedding ({"text": false}) and a TTS (audio alone)
-// are not, and stay out of every chat list, as the catalog's own lists
-// leave them out (textModel), #3279. Nothing is guessed from its id: a
+// said nothing of. An embedding ({"text": false}), a TTS (audio alone) and a
+// model the plugin files under "audio" or "embedding" whatever its outputs
+// say (#42) are not, and stay out of every chat list, as the catalog's own
+// lists leave them out (textModel), #3279. Nothing is guessed from its id: a
 // plugin that says nothing of its outputs keeps every model it lists.
 func pluginTalks(m plugin.Model) bool {
+	switch strings.ToLower(strings.TrimSpace(m.Kind)) {
+	case "audio", "embedding":
+		return false
+	}
 	if !m.OutputsSaid {
 		return true
 	}
