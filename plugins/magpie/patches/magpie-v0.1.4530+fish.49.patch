+func servingOf(p provider.Provider) []catalog.Model {
+	out := append(catalog.LiveServing(p.ID, ""), p.PlanRetrieval("")...)
+	if !p.IsPlugin() {
+		return out
+	}
+	for _, m := range provider.PluginServing(p) {
