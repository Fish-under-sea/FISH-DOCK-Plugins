+    if (!["http:", "https:"].includes(u.protocol) || u.origin === new URL(location.href).origin || u.username || u.password) return;
+    e.preventDefault();
+    call("link", { url: u.href, token: linkToken }).catch(() => {
+      // 父窗口显示错误；保留原 href，仍可复制地址，不让一次导航失败弄坏整页。
+    });
+  }
+  document.addEventListener("click", followLink, true);
+  document.addEventListener("auxclick", followLink, true);
 })();
diff --git a/internal/gui/plugin_icon_local.go b/internal/gui/plugin_icon_local.go
new file mode 100644
index 0000000..54bcc15
--- /dev/null
+++ b/internal/gui/plugin_icon_local.go
@@ -0,0 +1,93 @@
+package gui
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// 插件自己的图写成包内的相对路径时（package.json 的 magpie.icon:
+// "page/icon.png"），plugin.InstalledIcon 是不认的——它只收 https 与 data:
+// 这两种页面自己加载得了的形式。窗口这边能直接读文件，所以在这里补上：
+// 按内容存成一张普通图标（file:<name>），列表里画出来就是原色。
+//
+// 这样既不必动 upstream 那个判断，也不用把一百多 KB 的 base64 写进
+// package.json。顺序是：品牌图标 > 包内文件 > 包给的 https/data 图 >
+// 前端按 kind 画的那个兜底图标。
+
+// localIcons 记住「文件没变就不用再读一遍」，key 是插件 spec。
+var localIcons struct {
+	sync.Mutex
+	kept map[string]localIcon
+}
+
+type localIcon struct {
+	at   int64 // 文件的修改时间
+	size int64
+	icon string
+}
+
+// LocalIcon 是插件 spec 的 magpie.icon 指向包内某个文件时的图标值，"" 表示
+// 它写的不是包内文件（https、data: 或者空的），或者那个文件读不出来。
+func LocalIcon(spec string) string {
+	root := plugin.Target(spec)
+	name := packageIconField(root)
+	if name == "" {
+		return ""
+	}
+	rel := filepath.Clean(filepath.FromSlash(name))
+	if rel == "." || filepath.IsAbs(rel) || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return ""
+	}
+	file := filepath.Join(root, rel)
+	st, err := os.Stat(file)
+	if err != nil || !st.Mode().IsRegular() {
+		return ""
+	}
+	localIcons.Lock()
+	defer localIcons.Unlock()
+	if got, ok := localIcons.kept[spec]; ok && got.at == st.ModTime().UnixNano() && got.size == st.Size() {
+		return got.icon
+	}
+	b, err := os.ReadFile(file)
+	if err != nil {
+		return ""
+	}
+	ic, err := provider.StoreIcon(b)
+	if err != nil {
+		return ""
+	}
+	if localIcons.kept == nil {
+		localIcons.kept = map[string]localIcon{}
+	}
+	localIcons.kept[spec] = localIcon{at: st.ModTime().UnixNano(), size: st.Size(), icon: ic}
+	return ic
+}
+
+// packageIconField 是 package.json 里 magpie.icon 的原值，只留包内的相对
+// 路径：https 与 data: 交给 plugin.InstalledIcon，这里不重复处理。
+func packageIconField(root string) string {
+	b, err := os.ReadFile(filepath.Join(root, "package.json"))
+	if err != nil {
+		return ""
+	}
+	var p struct {
+		Magpie struct {
+			Icon string `json:"icon"`
+		} `json:"magpie"`
+	}
+	if json.Unmarshal(b, &p) != nil {
+		return ""
+	}
+	said := strings.TrimSpace(p.Magpie.Icon)
+	l := strings.ToLower(said)
+	if said == "" || strings.HasPrefix(l, "https://") || strings.HasPrefix(l, "data:") {
+		return ""
+	}
+	return said
+}
diff --git a/internal/gui/plugin_icon_local_test.go b/internal/gui/plugin_icon_local_test.go
new file mode 100644
index 0000000..1e005f5
--- /dev/null
+++ b/internal/gui/plugin_icon_local_test.go
@@ -0,0 +1,95 @@
+package gui
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// pack 搭一个最小的插件目录：package.json 里写 magpie.icon，按需放一张图。
+func pack(t *testing.T, icon string, files map[string][]byte) string {
+	t.Helper()
+	dir := t.TempDir()
+	body := `{"name":"page-checkin","magpie":{"icon":` + quote(icon) + `}}`
+	if err := os.WriteFile(filepath.Join(dir, "package.json"), []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for name, b := range files {
+		p := filepath.Join(dir, filepath.FromSlash(name))
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, b, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+func quote(s string) string {
+	out := strings.ReplaceAll(s, `\`, `\\`)
+	out = strings.ReplaceAll(out, `"`, `\"`)
+	return `"` + out + `"`
+}
+
+// 包内的图（magpie.icon: "page/icon.png"）plugin.InstalledIcon 不认，
+// 列表里就退回书页图标——这里把它读出来存成一张普通图标，颜色照原样。
+func TestLocalIconReadsAPictureInsideThePackage(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(home, ".cache"))
+	t.Cleanup(func() { _ = provider.SetBrand(false) })
+
+	png := []byte("\x89PNG\r\n\x1a\n\x00\x00\x00\rIHDR")
+	dir := pack(t, "page/icon.png", map[string][]byte{"page/icon.png": png})
+
+	ic := LocalIcon(dir)
+	if !strings.HasPrefix(ic, "file:") {
+		t.Fatalf("LocalIcon = %q，应当是 file: 图标", ic)
+	}
+	name := strings.TrimPrefix(ic, "file:")
+	got, err := os.ReadFile(provider.IconFile(name))
+	if err != nil {
+		t.Fatalf("存下来的图读不出来：%v", err)
+	}
+	if string(got) != string(png) {
+		t.Error("存下来的不是那张图")
+	}
+	// 文件没变就不再读一遍
+	if again := LocalIcon(dir); again != ic {
+		t.Errorf("第二次 = %q，第一次 = %q", again, ic)
+	}
+}
+
+// 只收包内的相对路径：越界的不读，https 与 data: 交给 InstalledIcon。
+func TestLocalIconRefusesWhatIsNotAFIleInsideIt(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(home, ".config"))
+	t.Cleanup(func() { _ = provider.SetBrand(false) })
+
+	png := []byte("\x89PNG\r\n\x1a\n\x00\x00\x00\rIHDR")
+	for _, icon := range []string{
+		"../escape.png",
+		"page/../../escape.png",
+		"/etc/passwd",
+		"https://example.com/icon.png",
+		"data:image/png;base64,AAAA",
+		"",
+	} {
+		dir := pack(t, icon, map[string][]byte{"page/icon.png": png})
+		if ic := LocalIcon(dir); ic != "" {
+			t.Errorf("magpie.icon = %q 拿到了 %q", icon, ic)
+		}
+	}
+	// 写的是包内的名字，但文件不在
+	if ic := LocalIcon(pack(t, "page/none.png", nil)); ic != "" {
+		t.Errorf("文件不存在却拿到了 %q", ic)
+	}
+}
diff --git a/internal/gui/plugincall_test.go b/internal/gui/plugincall_test.go
new file mode 100644
index 0000000..222fa27
--- /dev/null
+++ b/internal/gui/plugincall_test.go
@@ -0,0 +1,138 @@
+package gui
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// 插件页的 magpie.call 是它唯一的出口（CSP connect-src 'none'）。这里钉住
+// 校验顺序与分派：没声明的名字一律拒，声明了的真的到得了执行处。
+
+func TestCallAllowedRefusesWhatThePackageDidNotDeclare(t *testing.T) {
+	if callAllowed(nil, "relay:view") {
+		t.Fatal("没有 magpie.calls 的插件被放过了")
+	}
+	if callAllowed([]string{"relay:view"}, "relay:start") {
+		t.Fatal("没声明的名字被放过了")
+	}
+	if callAllowed([]string{"relay:view"}, "") {
+		t.Fatal("空名字被放过了")
+	}
+	if !callAllowed([]string{"relay:view", "checkin:state"}, "checkin:state") {
+		t.Fatal("声明过的名字被拒了")
+	}
+}
+
+// spec 不是开着的插件页：请求被拒，且不透露有哪些插件。
+func TestPluginCallRouteRefusesUnknownSpec(t *testing.T) {
+	mux := http.NewServeMux()
+	pluginCallRoutes(mux)
+	body := `{"spec":"nope.plugin","name":"relay:view"}`
+	req := httptest.NewRequest(http.MethodPost, "/api/plugin-pages/call", strings.NewReader(body))
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, req)
+	if rec.Code == http.StatusOK {
+		t.Fatalf("未知插件被放过了: %d %s", rec.Code, rec.Body.String())
+	}
+	if strings.Contains(strings.ToLower(rec.Body.String()), "relay:view") {
+		t.Fatalf("响应泄漏了方法名: %s", rec.Body.String())
+	}
+}
+
+// 分派：relay:view 回配置与状态，Key 只有打码；checkin:state 回签到开关与厂商。
+func TestPluginCallDispatchesRelayAndCheckin(t *testing.T) {
+	value, err := pluginCall(context.Background(), "", "relay:view", nil)
+	if err != nil {
+		t.Fatalf("relay:view: %v", err)
+	}
+	view, ok := value.(map[string]any)
+	if !ok {
+		t.Fatalf("relay:view 返回 %T", value)
+	}
+	config, ok := view["config"].(map[string]any)
+	if !ok {
+		t.Fatal("relay:view 没有 config")
+	}
+	if _, ok := config["hasKey"]; !ok {
+		t.Fatal("relay:view 没有 hasKey")
+	}
+	encoded, _ := json.Marshal(view)
+	for key := range config {
+		if key == "apiKey" || key == "key" {
+			t.Fatal("relay:view 回显了 Key 字段")
+		}
+	}
+	if strings.Contains(string(encoded), "\"sealedKey\"") {
+		t.Fatal("relay:view 回显了密文 Key")
+	}
+
+	// checkin:state 回的是 provider.CheckinViewState 这个结构（插件页要的聚合
+	// 值：厂商、账号、今天的结果、积分），不是一层 map：页面按字段名读，宿主按
+	// 类型给，中间不再转换一次。
+	checkin, err := pluginCall(context.Background(), "", "checkin:state", nil)
+	if err != nil {
+		t.Fatalf("checkin:state: %v", err)
+	}
+	state, ok := checkin.(provider.CheckinViewState)
+	if !ok {
+		t.Fatalf("checkin:state 返回 %T", checkin)
+	}
+	encoded, err = json.Marshal(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, field := range []string{"providers", "accounts", "today"} {
+		if !strings.Contains(string(encoded), "\""+field+"\"") {
+			t.Fatalf("checkin:state 没有 %s: %s", field, encoded)
+		}
+	}
+}
+
+// 未知名字在分派处也拒绝（不只是 HTTP 层）。
+func TestPluginCallRefusesUnknownName(t *testing.T) {
+	if _, err := pluginCall(context.Background(), "", "relay:delete-everything", nil); err == nil {
+		t.Fatal("未知 relay 命令被接受了")
+	}
+	if _, err := pluginCall(context.Background(), "", "anything:else", nil); err == nil {
+		t.Fatal("未知命名空间被接受了")
+	}
+}
+
+// 签到开关分两层：厂商级是 settings.PluginCheckins，账号级是 settings.CheckinOff。
+// 账号级这条以前被这里拒成 ACCOUNT_LEVEL_UNSUPPORTED，可设置页一直有它
+// （/api/settings/checkin-account），插件页那个开关因此点不动。
+func TestPluginCallSetsAccountLevelCheckin(t *testing.T) {
+	t.Setenv("MAGPIE_CONFIG", t.TempDir())
+	if _, err := pluginCall(context.Background(), "", "checkin:set-account", map[string]any{"key": "workbuddy|u1", "on": false}); err != nil {
+		t.Fatalf("关掉账号: %v", err)
+	}
+	if !slices.Contains(settings.Load().CheckinOff, "workbuddy|u1") {
+		t.Fatal("关掉的账号没有记进 CheckinOff")
+	}
+	if _, err := pluginCall(context.Background(), "", "checkin:set-account", map[string]any{"key": "workbuddy|u1", "on": true}); err != nil {
+		t.Fatalf("重新打开: %v", err)
+	}
+	if slices.Contains(settings.Load().CheckinOff, "workbuddy|u1") {
+		t.Fatal("重新打开后仍留在 CheckinOff 里")
+	}
+}
+
+func TestPluginCallRefusesAccountLevelCheckinWithoutKey(t *testing.T) {
+	t.Setenv("MAGPIE_CONFIG", t.TempDir())
+	_, err := pluginCall(context.Background(), "", "checkin:set-account", map[string]any{"on": true})
+	if err == nil {
+		t.Fatal("缺少账号 key 被接受了")
+	}
+	coded, ok := err.(interface{ Code() string })
+	if !ok || coded.Code() != "NO_ACCOUNT" {
+		t.Fatalf("error = %v, want NO_ACCOUNT", err)
+	}
+}
