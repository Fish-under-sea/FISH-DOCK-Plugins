+// PruneHistory is the start's sweep (#46): a day left far past the days
+// kept by an older magpie goes, and yesterday is gzipped, without a route
+// being written first.
+func TestPruneHistoryAtStart(t *testing.T) {
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	now := historyNoon(t)
+	dir := HistoryDir()
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	old := filepath.Join(dir, now.AddDate(0, 0, -historyDays-40).Format(dayForm)+".jsonl.gz")
+	os.WriteFile(old, []byte("x"), 0o600)
+	yday := filepath.Join(dir, now.AddDate(0, 0, -1).Format(dayForm)+".jsonl")
+	os.WriteFile(yday, []byte(`{"id":1,"model":"a"}`+"\n"), 0o600)
+	PruneHistory()
+	if _, err := os.Stat(old); !os.IsNotExist(err) {
+		t.Fatal("a day older than the days kept is still there")
+	}
+	if _, err := os.Stat(yday + ".gz"); err != nil {
+		t.Fatal("yesterday isn't gzipped at start:", err)
+	}
+}
