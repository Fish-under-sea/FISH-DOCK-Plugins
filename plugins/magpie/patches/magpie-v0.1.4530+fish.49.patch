diff --git a/internal/memagent/mcp.go b/internal/memagent/mcp.go
new file mode 100644
index 0000000..934ab2e
--- /dev/null
+++ b/internal/memagent/mcp.go
@@ -0,0 +1,449 @@
+package memagent
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/proc"
+)
+
+// The MCP servers a memory agent's mcp.json adds: their tools are given to
+// a run beside its own, named `<server>__<tool>` as magpie's hub names them,
+// so a run can use what the agent was equipped with. A server is spoken to
+// as any MCP client speaks: initialize, notifications/initialized,
+// tools/list, tools/call. A server that fails to start, or a tool that
+// fails, is a tool error the model sees, never a run that ends.
+const (
+	// MaxToolResult is the most of a tool's answer that goes to the model.
+	MaxToolResult = 64 << 10
+)
+
+// mcpTimeout is how long a server has to answer one call and the handshake:
+// a variable, so a test waits a moment instead of a minute for a server
+// that never answers.
+var mcpTimeout = 60 * time.Second
+
+// MCPConn is a server a client can talk to: a line of JSON-RPC in, a line
+// out.
+type MCPConn interface {
+	Send(b []byte) error
+	Lines() <-chan []byte
+	Close() error
+}
+
+// DialServer opens a connection to one server. A variable for tests, which
+// give a fake server rather than starting a process.
+var DialServer = dialStdio
+
+// dialStdio starts the server's command and speaks to it over its pipes.
+func dialStdio(s Server) (MCPConn, error) {
+	if s.Command == "" {
+		return nil, fmt.Errorf("%q has no command", s.Name)
+	}
+	cmd := proc.Command(s.Command, s.Args...)
+	cmd.Env = os.Environ()
+	for k, v := range s.Env {
+		cmd.Env = append(cmd.Env, k+"="+v)
+	}
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		return nil, err
+	}
+	out, err := cmd.StdoutPipe()
+	if err != nil {
+		return nil, err
+	}
+	cmd.Stderr = io.Discard
+	if err := cmd.Start(); err != nil {
+		return nil, fmt.Errorf("couldn't start %s: %w", s.Command, err)
+	}
+	c := &stdioConn{in: in, lines: make(chan []byte, 16), done: make(chan struct{})}
+	go func() {
+		defer close(c.lines)
+		sc := bufio.NewScanner(out)
+		sc.Buffer(make([]byte, 64*1024), 8<<20)
+		for sc.Scan() {
+			line := bytes.Clone(sc.Bytes())
+			var m struct {
+				Method string `json:"method"`
+			}
+			// a server that logs to the wrong stream isn't speaking
+			if json.Unmarshal(line, &m) != nil {
+				continue
+			}
+			select {
+			case c.lines <- line:
+			case <-c.done:
+				return
+			}
+		}
+	}()
+	go func() { _ = cmd.Wait() }()
+	return c, nil
+}
+
+// stdioConn is a server's pipes.
+type stdioConn struct {
+	in    io.WriteCloser
+	lines chan []byte
+	done  chan struct{}
+	once  sync.Once
+	mu    sync.Mutex
+}
+
+func (c *stdioConn) Send(b []byte) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	// one line per message: the newline goes after the caller's bytes
+	if _, err := c.in.Write(append(append(make([]byte, 0, len(b)+1), b...), '\n')); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (c *stdioConn) Lines() <-chan []byte { return c.lines }
+
+func (c *stdioConn) Close() error {
+	c.once.Do(func() { close(c.done) })
+	return c.in.Close()
+}
+
+// httpConn is a server spoken to over HTTP, one request one answer.
+type httpConn struct {
+	url   string
+	lines chan []byte
+	done  chan struct{}
+	once  sync.Once
+}
+
+func (c *httpConn) Send(b []byte) error {
+	req, err := http.NewRequest("POST", c.url, bytes.NewReader(b))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json, text/event-stream")
+	resp, err := (&http.Client{Timeout: mcpTimeout}).Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 8<<20))
+	if err != nil {
+		return err
+	}
+	if resp.StatusCode != http.StatusOK && resp.StatusCode != http.StatusAccepted {
+		return fmt.Errorf("%s answered %d: %s", c.url, resp.StatusCode, firstLine(body))
+	}
+	// an answer may come as JSON or as an event stream. The lines are
+	// handed over on their own goroutine: a server that says more in one
+	// answer than the channel holds must not hold up the call waiting for
+	// its own reply.
+	var lines [][]byte
+	for _, line := range strings.Split(string(body), "\n") {
+		line = strings.TrimSpace(strings.TrimPrefix(line, "data:"))
+		if line == "" || !json.Valid([]byte(line)) {
+			continue
+		}
+		lines = append(lines, []byte(line))
+	}
+	if len(lines) == 0 {
+		return nil
+	}
+	go func() {
+		for _, l := range lines {
+			select {
+			case c.lines <- l:
+			case <-c.done:
+				return
+			}
+		}
+	}()
+	return nil
+}
+
+func (c *httpConn) Lines() <-chan []byte { return c.lines }
+
+func (c *httpConn) Close() error {
+	c.once.Do(func() { close(c.done) })
+	return nil
+}
+
+func firstLine(b []byte) string {
+	s := strings.TrimSpace(string(b))
+	if i := strings.IndexByte(s, '\n'); i >= 0 {
+		s = s[:i]
+	}
+	if len(s) > 200 {
+		s = s[:200] + "…"
+	}
+	return s
+}
+
+// mcpClient is one server, handshaken and ready to call.
+type mcpClient struct {
+	name string
+	conn MCPConn
+	mu   sync.Mutex
+	next int
+	// tools is what the server listed, by name
+	tools []mcpTool
+}
+
+// mcpTool is one tool a server listed.
+type mcpTool struct {
+	Name        string         `json:"name"`
+	Description string         `json:"description"`
+	InputSchema map[string]any `json:"inputSchema"`
+}
+
+// openMCP starts a server and asks it what it has. A server that can't be
+// started or doesn't answer is an error the run reports, not one it dies of:
+// the caller passes over it and says so.
+func openMCP(s Server) (*mcpClient, error) {
+	dial := DialServer
+	if s.URL != "" {
+		dial = func(s Server) (MCPConn, error) {
+			return &httpConn{url: s.URL, lines: make(chan []byte, 16)}, nil
+		}
+	}
+	conn, err := dial(s)
+	if err != nil {
+		return nil, err
+	}
+	c := &mcpClient{name: s.Name, conn: conn}
+	if err := c.handshake(); err != nil {
+		_ = conn.Close()
+		return nil, err
+	}
+	return c, nil
+}
+
+// handshake initializes the session and lists the server's tools.
+func (c *mcpClient) handshake() error {
+	init := map[string]any{
+		"jsonrpc": "2.0", "id": c.id(), "method": "initialize",
+		"params": map[string]any{
+			"protocolVersion": "2025-06-18",
+			"capabilities":    map[string]any{},
+			"clientInfo":      map[string]any{"name": "magpie-memory-agent", "version": "1"},
+		},
+	}
+	var res struct {
+		Result struct {
+			ProtocolVersion string `json:"protocolVersion"`
+		} `json:"result"`
+	}
+	if err := c.rpc(init, &res); err != nil {
+		return fmt.Errorf("%s: initialize: %w", c.name, err)
+	}
+	if err := c.conn.Send([]byte(`{"jsonrpc":"2.0","method":"notifications/initialized"}`)); err != nil {
+		return err
+	}
+	return c.list()
+}
+
+// list asks for the server's tools, a page at a time.
+func (c *mcpClient) list() error {
+	cursor := ""
+	for page := 0; page < 20; page++ {
+		params := map[string]any{}
+		if cursor != "" {
+			params["cursor"] = cursor
+		}
+		req := map[string]any{"jsonrpc": "2.0", "id": c.id(), "method": "tools/list", "params": params}
+		var res struct {
+			Result struct {
+				Tools      []mcpTool `json:"tools"`
+				NextCursor string    `json:"nextCursor"`
+			} `json:"result"`
+		}
+		if err := c.rpc(req, &res); err != nil {
+			return fmt.Errorf("%s: tools/list: %w", c.name, err)
+		}
+		for _, t := range res.Result.Tools {
+			if t.Name != "" {
+				c.tools = append(c.tools, t)
+			}
+		}
+		if res.Result.NextCursor == "" {
+			return nil
+		}
+		cursor = res.Result.NextCursor
+	}
+	return nil
+}
+
+// call runs one tool of the server and gives its text.
+func (c *mcpClient) call(ctx context.Context, name string, in json.RawMessage) (string, error) {
+	args := map[string]any{}
+	if len(strings.TrimSpace(string(in))) > 0 {
+		if err := json.Unmarshal(in, &args); err != nil {
+			return "", fmt.Errorf("the arguments aren't an object: %v", err)
+		}
+	}
+	req := map[string]any{"jsonrpc": "2.0", "id": c.id(), "method": "tools/call",
+		"params": map[string]any{"name": name, "arguments": args}}
+	var res struct {
+		Result struct {
+			Content []struct {
+				Type string `json:"type"`
+				Text string `json:"text"`
+			} `json:"content"`
+			IsError bool `json:"isError"`
+		} `json:"result"`
+	}
+	if err := c.rpcCtx(ctx, req, &res); err != nil {
+		return "", err
+	}
+	var b strings.Builder
+	for _, part := range res.Result.Content {
+		if part.Type == "text" && part.Text != "" {
+			if b.Len() > 0 {
+				b.WriteString("\n")
+			}
+			b.WriteString(part.Text)
+		}
+	}
+	out := b.String()
+	if out == "" {
+		out = "(the tool answered nothing)"
+	}
+	if r := []rune(out); len(r) > MaxToolResult {
+		out = string(r[:MaxToolResult]) + "\n…(cut)"
+	}
+	if res.Result.IsError {
+		return out, errors.New(out)
+	}
+	return out, nil
+}
+
+// close ends the server's session.
+func (c *mcpClient) close() {
+	_ = c.conn.Send([]byte(`{"jsonrpc":"2.0","method":"notifications/cancelled"}`))
+	_ = c.conn.Close()
+}
+
+// id is the next request id.
+func (c *mcpClient) id() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.next++
+	return c.next
+}
+
+// rpc sends a request and reads its answer, within mcpTimeout.
+func (c *mcpClient) rpc(req map[string]any, out any) error {
+	ctx, cancel := context.WithTimeout(context.Background(), mcpTimeout)
+	defer cancel()
+	return c.rpcCtx(ctx, req, out)
+}
+
+// rpcCtx is rpc under ctx: the answer's result is decoded into out.
+func (c *mcpClient) rpcCtx(ctx context.Context, req map[string]any, out any) error {
+	// one request at a time: the answer is matched by id, but a server may
+	// answer out of order, and a run asks one question at a time anyway
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		return err
+	}
+	if err := c.conn.Send(b); err != nil {
+		return err
+	}
+	want := fmt.Sprint(req["id"])
+	timer := time.NewTimer(mcpTimeout)
+	defer timer.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-timer.C:
+			return fmt.Errorf("%s didn't answer within %v", c.name, mcpTimeout)
+		case line, ok := <-c.conn.Lines():
+			if !ok {
+				return fmt.Errorf("%s ended", c.name)
+			}
+			var m struct {
+				ID     json.RawMessage `json:"id"`
+				Result json.RawMessage `json:"result"`
+				Error  *struct {
+					Message string `json:"message"`
+				} `json:"error"`
+			}
+			if err := json.Unmarshal(line, &m); err != nil {
+				continue // a line that isn't a reply: a server logging
+			}
+			if m.ID == nil || strings.TrimSpace(string(m.ID)) != want {
+				continue
+			}
+			if m.Error != nil {
+				return errors.New(m.Error.Message)
+			}
+			if out == nil {
+				return nil
+			}
+			return json.Unmarshal(line, out)
+		}
+	}
+}
+
+// mcpTools are a server's tools as a run's own: named `<server>__<tool>`,
+// so a tool of one server can't be mistaken for another's or for one of the
+// run's.
+func mcpTools(c *mcpClient) []Tool {
+	out := make([]Tool, 0, len(c.tools))
+	for _, t := range c.tools {
+		name := t.Name
+		schema := t.InputSchema
+		if schema == nil {
+			schema = map[string]any{"type": "object", "properties": map[string]any{}}
+		}
+		desc := t.Description
+		if desc == "" {
+			desc = "A tool of the " + c.name + " MCP server."
+		}
+		out = append(out, Tool{
+			Name:        c.name + "__" + name,
+			Description: desc,
+			Schema:      schema,
+			Call: func(ctx context.Context, in json.RawMessage) (string, error) {
+				return c.call(ctx, name, in)
+			},
+		})
+	}
+	return out
+}
+
+// mcpToolsFor opens the agent's servers and gives their tools. A server
+// that can't be opened is left out, and the run says which and why in its
+// transcript: a server of the user's being down is not a reason to tidy
+// nothing. The clients opened are closed when the run ends.
+func mcpToolsFor(servers []Server, log *runLog) (tools []Tool, closeAll func()) {
+	var clients []*mcpClient
+	for _, s := range servers {
+		c, err := openMCP(s)
+		if err != nil {
+			log.said("error", "mcp", s.Name+": "+err.Error())
+			continue
+		}
+		clients = append(clients, c)
+		tools = append(tools, mcpTools(c)...)
+	}
+	return tools, func() {
+		for _, c := range clients {
+			c.close()
+		}
+	}
+}
diff --git a/internal/memagent/mcp_child_test.go b/internal/memagent/mcp_child_test.go
new file mode 100644
index 0000000..3681f1d
--- /dev/null
+++ b/internal/memagent/mcp_child_test.go
@@ -0,0 +1,74 @@
+package memagent
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+)
+
+// The tests' own binary is the server: a real child process, so the pipes,
+// the handshake and the line framing are the ones a run meets, with no
+// toolchain and no network.
+const fakeServerEnv = "MAGPIE_MEMAGENT_FAKE_MCP"
+
+// fakeServerMain is the server: it answers initialize, tools/list and
+// tools/call, one line a message, and ends when its input does.
+func fakeServerMain() {
+	sc := bufio.NewScanner(os.Stdin)
+	sc.Buffer(make([]byte, 64*1024), 8<<20)
+	out := bufio.NewWriter(os.Stdout)
+	defer out.Flush()
+	for sc.Scan() {
+		var m struct {
+			ID     json.RawMessage `json:"id"`
+			Method string          `json:"method"`
+		}
+		if json.Unmarshal(sc.Bytes(), &m) != nil || m.ID == nil {
+			continue // a notification, or a line that isn't JSON-RPC
+		}
+		var result any
+		switch m.Method {
+		case "initialize":
+			result = map[string]any{"protocolVersion": "2025-06-18", "capabilities": map[string]any{},
+				"serverInfo": map[string]any{"name": "fake", "version": "1"}}
+		case "tools/list":
+			result = map[string]any{"tools": []any{map[string]any{
+				"name":        "say",
+				"description": "says what it is given",
+				"inputSchema": map[string]any{"type": "object", "properties": map[string]any{}},
+			}}}
+		case "tools/call":
+			result = map[string]any{"content": []any{map[string]any{"type": "text", "text": "hello from the child"}}}
+		default:
+			continue
+		}
+		b, _ := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": m.ID, "result": result})
+		fmt.Fprintln(out, string(b))
+		out.Flush()
+	}
+}
+
+// A server as a real child process: started, handshaken, called, and let go.
+func TestMCPOverARealChildProcess(t *testing.T) {
+	exe, err := os.Executable()
+	if err != nil {
+		t.Skip("no test binary to run:", err)
+	}
+	c, err := openMCP(Server{Name: "child", Command: exe, Args: []string{"-test.run", "^$"},
+		Env: map[string]string{fakeServerEnv: "1"}})
+	if err != nil {
+		t.Fatalf("a real child server: %v", err)
+	}
+	defer c.close()
+	if len(c.tools) != 1 || c.tools[0].Name != "say" {
+		t.Fatalf("%+v", c.tools)
+	}
+	out, err := c.call(context.Background(), "say", json.RawMessage(`{"q":"hi"}`))
+	if err != nil || !strings.Contains(out, "hello from the child") {
+		t.Fatalf("%q %v", out, err)
+	}
+}
