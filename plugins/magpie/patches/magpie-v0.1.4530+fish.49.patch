+// The log rolls at rotateMax, keeping one previous file (#46): the live log
+// starts anew, a spend cap counted from before the roll still reads the
+// calls rolled away, and the index is rebuilt for the new file.
+func TestLogRollsAndSpendCrossesTheRoll(t *testing.T) {
+	spendHome(t)
+	old := rotateMax
+	rotateMax = 64 << 10
+	t.Cleanup(func() { rotateMax = old })
+	key := provider.KeyID("sk-a")
+	now := time.Now()
+	start := now.Add(-2 * time.Hour)
+	call := func(at time.Time, in int) Record {
+		return Record{Time: at, Agent: "codex", Provider: "relay", Model: "gpt-9", ProviderKeyID: key, Input: in, Status: 200}
+	}
+	// 400 calls of $1: more than rotateMax of lines, so the log rolls once
+	const calls = 400
+	for i := range calls {
+		Append(call(now.Add(-time.Hour+time.Duration(i)*time.Second), 1e6))
+	}
+	rolled, err := os.Stat(Path() + ".1")
+	if err != nil || rolled.Size() < rotateMax {
+		t.Fatalf("log not rolled: %v %v", rolled, err)
+	}
+	if live, err := os.Stat(Path()); err != nil || live.Size() >= rotateMax {
+		t.Fatalf("live log not started anew: %v %v", live, err)
+	}
+	if got := KeySpent(key, start); math.Abs(got-calls) > 1e-9 {
+		t.Fatalf("key spent %v across the roll, want %d", got, calls)
+	}
+	// the index is the live log's, not the rolled-away one's
+	first := now.Add(-time.Hour)
+	if snap := readLogSnapshot(); snap.first.IsZero() || !snap.first.After(first) || len(snap.blocks) == 0 {
+		t.Fatalf("index not rebuilt for the new log: first %v, blocks %d", snap.first, len(snap.blocks))
+	}
+	// a second roll drops the .1 before it instead of keeping both
+	var before time.Time
+	visitArchive(time.Time{}, func(r Record) {
+		if before.IsZero() {
+			before = r.Time
+		}
+	})
+	for i := range calls {
+		Append(call(now.Add(time.Duration(i)*time.Second), 1e6))
+	}
+	var after time.Time
+	visitArchive(time.Time{}, func(r Record) {
+		if after.IsZero() {
+			after = r.Time
+		}
+	})
+	if !after.After(before) {
+		t.Fatalf("the second roll kept the older archive: first %v, was %v", after, before)
+	}
+	if _, err := os.Stat(Path() + ".2"); !os.IsNotExist(err) {
+		t.Fatalf("a second archive kept: %v", err)
+	}
