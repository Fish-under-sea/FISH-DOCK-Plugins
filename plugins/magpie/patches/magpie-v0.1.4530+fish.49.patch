+// tempPath puts memory-agents.json in a folder of the test's own.
+func tempPath(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	old := Path
+	Path = func() string { return filepath.Join(dir, "memory-agents.json") }
+	t.Cleanup(func() { Path = old })
+	return Path()
+}
+
+// write puts b at p, as a file left there by a crash or by hand would be.
+func write(t *testing.T, p, b string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte(b), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func mustLoad(t *testing.T) Registry {
+	t.Helper()
+	r, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
