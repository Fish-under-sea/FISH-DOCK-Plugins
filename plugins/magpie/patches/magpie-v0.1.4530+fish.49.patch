+	}
+	if a, ok := r.Default(Learn); !ok || a.ID != "memory-curator" || a.Agent != DefaultAgent || a.Model != "group/deepseek" {
+		t.Fatalf("learn default: %+v ok=%v", a, ok)
+	}
+	if d, ok := r.Default(Dream); !ok || d.ID != "dreamer" {
+		t.Fatalf("dream default: %+v ok=%v", d, ok)
+	}
+	if o, ok := r.Default(Organize); !ok || o.ID != "memory-curator" {
+		t.Fatalf("organize default: %+v ok=%v", o, ok)
+	}
+	// a file never written is never read: the presets are in memory only
+	if _, err := os.Stat(Path()); !os.IsNotExist(err) {
+		t.Fatalf("Load wrote the file: %v", err)
+	}
+}
