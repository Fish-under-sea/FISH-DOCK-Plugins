+}
+
+// A run asked for an agent that isn't there is a 400 and nothing starts.
+func TestAgentRunRefusesBadAgent(t *testing.T) {
+	distillAt(t)
+	mux := http.NewServeMux()
+	memoryAgentRunRoutes(mux)
+	if _, err := memagent.Restore(); err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct{ path, body string }{
+		{"/api/memory/agents/learn/run", `{"agent":"dreamer"}`},
+		{"/api/memory/agents/learn/run", `{"agent":"not-there"}`},
