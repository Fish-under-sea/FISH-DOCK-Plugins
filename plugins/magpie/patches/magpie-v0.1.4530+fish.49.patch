+
+// An agent carrying several roles out says so, in the roles' own order, and
+// one carrying a single role reads as it always did.
+func TestRolesOf(t *testing.T) {
+	for _, c := range []struct{ in, want string }{
+		{"learn", Learn},
+		{"organize", Organize},
+		{"dream", Dream},
+		{" Learn | Organize ", Learn + "|" + Organize},
+		{"organize|learn", Learn + "|" + Organize},
+		{"learn|learn", Learn},
+		{"learn||organize", Learn + "|" + Organize},
+		{"LEARN", Learn},
+	} {
+		got, err := rolesOf(c.in)
+		if err != nil || got != c.want {
+			t.Errorf("rolesOf(%q) = %q, %v; want %q", c.in, got, err, c.want)
+		}
+	}
+	for _, bad := range []string{"", "  ", "|", "nope", "learn|nope"} {
+		if _, err := rolesOf(bad); err == nil {
+			t.Errorf("rolesOf(%q) accepted", bad)
