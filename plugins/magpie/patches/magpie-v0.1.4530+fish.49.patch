+	if err := os.WriteFile(filepath.Join(root, fishvault.Record), []byte(`{"schema":1,"imported":true,"files":[]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	text := "# Shared design\nneedle " + strings.Repeat("a long note stays independent. ", 200)
+	note := filepath.Join(root, "wiki", "design.md")
+	if err := os.WriteFile(note, []byte(text), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	result, err := memorySearch(memoryCaller{}, memoryArgs{Query: "needle"})
+	if err != nil || !strings.Contains(result, "knowledge note: wiki/design.md") || !strings.Contains(result, "obsidian://open?path=") {
+		t.Fatalf("%s %v", result, err)
+	}
+	ms, _, err := memory.All()
+	if err != nil || len(ms) != 0 {
+		t.Fatalf("long note became a short memory: %+v %v", ms, err)
+	}
+	result, err = memorySearch(memoryCaller{}, memoryArgs{Query: "needle", Kind: memory.Fact})
+	if err != nil || strings.Contains(result, "knowledge note:") {
+		t.Fatalf("kind filter broadened: %s %v", result, err)
+	}
+	if err := os.WriteFile(note, []byte("updated needle from Obsidian"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	result, err = memorySearch(memoryCaller{}, memoryArgs{Query: "updated"})
+	if err != nil || !strings.Contains(result, "updated needle from Obsidian") {
+		t.Fatalf("edit stale: %s %v", result, err)
+	}
+}
