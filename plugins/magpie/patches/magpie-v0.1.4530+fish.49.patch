+}
+
+// A registry whose defaults are absent gains them, so a page reading the
+// view always has a map.
+func TestChangeFillsDefaults(t *testing.T) {
+	p := tempPath(t)
+	write(t, p, `{"version":1,"agents":[{"id":"a","name":"x","role":"learn","model":"m"}]}`)
+	r, err := SetDefault(Learn, "a")
