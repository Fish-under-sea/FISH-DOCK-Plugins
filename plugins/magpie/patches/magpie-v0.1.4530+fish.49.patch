+// The dispatch input is what the run is given: the vault, the role's scopes,
+// and what to read. Without a vault a run says so rather than reading nothing.
+func TestDispatchInputGathers(t *testing.T) {
+	distillAt(t)
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	if _, err := memagent.Restore(); err != nil {
+		t.Fatal(err)
+	}
+	in, err := dispatchInput(memagent.Learn, "", "", "")
+	if err != nil {
+		t.Fatalf("learn: %v", err)
+	}
+	if in.Role != memagent.Learn || in.Vault == "" || in.Ask == nil {
+		t.Fatalf("input: %+v", in)
+	}
+	if len(in.Scopes) != 2 || in.Scopes[0] != "global" {
+		t.Fatalf("scopes: %q", in.Scopes)
