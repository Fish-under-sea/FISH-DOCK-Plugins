+package cli
+
+import (
+	"github.com/yetone/magpie/internal/gateway"
+	"github.com/yetone/magpie/internal/maskrec"
+)
+
+// housekeeping drops what the days on disk keep past their limits, once at
+// start (#46). Each package prunes behind a write, which is enough for a
+// magpie in use; a history left by a long run of an older magpie is only
+// ever cleaned here. Neither may hold up the start: the masking record's
+// days are a few files, the routing history's gzips a busy day whole.
+func housekeeping() {
+	maskrec.Prune()
+	go gateway.PruneHistory()
+}
