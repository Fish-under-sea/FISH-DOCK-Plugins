+++ b/internal/provider/modelkind_serves_test.go
@@ -0,0 +1,95 @@
+package provider
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// kindHome prepares a settings directory for a provider the user set up by
+// its address, with the models named in ids.
+func kindHome(t *testing.T, ids ...string) *Provider {
+	t.Helper()
+	oneHome(t)
+	if err := Save(Provider{ID: "relay", Name: "Relay", Chat: "http://relay.test/v1", Key: "k", Models: ids}); err != nil {
+		t.Fatal(err)
+	}
+	p, err := Find("relay")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// The user can say a model is one of the other APIs too — speech, a
+// transcript, an embedding or a rerank — not only that it draws or makes
+// videos (#42): a relay whose own list names none of them leaves its TTS and
+// embedding models unclassified, and the editor's Makes… menu offered no way
+// to say.
+func TestSetModelKindTakesTheOtherAPIs(t *testing.T) {
+	kindHome(t, "cosyvoice-2", "qwen-audio-3.0-tts-plus", "bge-m3", "jina-reranker")
+	for _, c := range []struct{ id, kind, want string }{
+		{"cosyvoice-2", KindSpeech, KindSpeech},
+		{"qwen-audio-3.0-tts-plus", KindTranscription, KindTranscription},
+		{"bge-m3", KindEmbedding, KindEmbedding},
+		{"jina-reranker", KindRerank, KindRerank},
+	} {
+		if err := SetModelKind("relay/"+c.id, c.kind); err != nil {
+			t.Fatalf("%s: %v", c.id, err)
+		}
+		if got := settings.Load().ModelKinds["relay/"+c.id]; got != c.want {
+			t.Errorf("%s saved as %q, want %q", c.id, got, c.want)
+		}
+	}
+	// a kind magpie has no route for is still refused
+	if err := SetModelKind("relay/cosyvoice-2", "audio"); err == nil || !strings.Contains(err.Error(), "audio") {
+		t.Errorf("audio taken as a kind: %v", err)
+	}
+}
+
+// A plugin's provider can be told too: its models are not in a fetched list,
+// so nothing but the plugin's own word says what they serve, and its audio
+// and embedding models have no editor section otherwise (#42).
+func TestMarksKindsTakesAPluginsOtherAPIs(t *testing.T) {
+	t.Helper()
+	claudeHome(t)
+	t.Setenv("MAGPIE_BUN", "")
+	write := func(name string, v any) {
+		t.Helper()
+		b, _ := json.Marshal(v)
+		os.MkdirAll(settings.Dir(), 0o700)
+		if err := os.WriteFile(filepath.Join(settings.Dir(), name), b, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	spec := "@fish-under-sea/magpie-neartoken"
+	write("plugins.json", map[string]any{"plugins": []map[string]any{{"spec": spec}}})
+	write("plugin-auth.json", map[string]map[string]any{"neartoken": {"type": "api", "key": "k-neartoken"}})
+	plugin.UseCached([]plugin.Provider{{ID: "neartoken", Spec: spec, Name: "NearToken",
+		Methods:  []plugin.Method{{Type: "api", Label: "API key"}},
+		Accounts: []plugin.Account{{Key: "neartoken", Type: "api"}},
+		Models: []plugin.Model{
+			{ID: "suno_music", Name: "Suno Music", Outputs: []string{"audio", "text"}, OutputsSaid: true},
+			{ID: "gemini-embedding-2", Name: "Gemini Embedding 2", Outputs: []string{"embedding", "text"}, OutputsSaid: true},
+		}}})
+	t.Cleanup(func() { plugin.UseCached(nil) })
+
+	if err := SetModelKind("neartoken/suno_music", KindSpeech); err != nil {
+		t.Fatalf("a plugin's audio model can't be said to be one: %v", err)
+	}
+	if got := settings.Load().ModelKinds["neartoken/suno_music"]; got != KindSpeech {
+		t.Fatalf("saved %q, want %q", got, KindSpeech)
+	}
+	p, err := Find("neartoken")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := p.ModelKind("suno_music"); got != KindSpeech {
+		t.Fatalf("read back %q, want %q", got, KindSpeech)
+	}
+}
