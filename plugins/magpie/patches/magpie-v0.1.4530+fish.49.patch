+// TestTheWindowCacheFollowsAPageChange asks the list the window draws (Cached).
+func TestTheWindowCacheFollowsAPageChange(t *testing.T) {
+	modelSandbox(t)
+	spec := addFixture(t, writeModelFixture(t))
