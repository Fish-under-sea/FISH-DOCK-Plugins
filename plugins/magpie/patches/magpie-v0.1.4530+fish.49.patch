+// ?role= narrows the list to the agents that carry that role out, which is
+// how the dropdown offers an agent for the row it is on.
+func TestMemoryAgentsRouteNarrowsByRole(t *testing.T) {
+	agentsAt(t)
+	mux := agentRoutes(t)
+	for _, role := range memagent.Roles {
+		code, v := get(t, mux, "/api/memory/agents?role="+role)
+		if code != 200 || len(v.Agents) != 1 {
+			t.Fatalf("%s: %d %+v", role, code, v)
+		}
+		if !v.Agents[0].HasRole(role) {
+			t.Fatalf("%s listed %+v", role, v.Agents[0])
+		}
+	}
+	if code, _ := get(t, mux, "/api/memory/agents?role=nope"); code != 400 {
+		t.Fatalf("an unknown role: %d", code)
+	}
+}
+
+// An agent added, changed, made a role's default and removed, each answered
+// with the list as it is now, and each kept on disk.
+func TestMemoryAgentRoutesCRUD(t *testing.T) {
+	p := agentsAt(t)
+	mux := agentRoutes(t)
+	if code, _ := postAgents(t, mux, "/api/memory/agents", `{}`); code != 400 {
+		t.Fatalf("an empty agent: %d", code)
+	}
+	code, v := postAgents(t, mux, "/api/memory/agents",
+		`{"id":"night-owl","name":"夜间整理","role":"organize","model":"group/deepseek","effort":"high","schedule":"daily 23:00","scopes":["global"]}`)
+	if code != 200 || len(v.Agents) != 3 {
+		t.Fatalf("add: %d %+v", code, v.Agents)
+	}
+	a, ok := v.Agents[2], false
+	for _, got := range v.Agents {
+		if got.ID == "night-owl" {
+			a, ok = got, true
+		}
+	}
+	if !ok || a.Name != "夜间整理" || a.Role != memagent.Organize || a.Agent != memagent.DefaultAgent || a.Builtin {
+		t.Fatalf("added: %+v", a)
+	}
+	if b, err := os.ReadFile(p); err != nil || !strings.Contains(string(b), "night-owl") {
+		t.Fatalf("not kept: %s %v", b, err)
+	}
+	// a duplicate id is refused
+	if code, _ := postAgents(t, mux, "/api/memory/agents", `{"id":"night-owl","name":"x","role":"organize","model":"m"}`); code != 400 {
+		t.Fatalf("a duplicate id: %d", code)
+	}
+	// changed by its id
+	code, v = postAgents(t, mux, "/api/memory/agents/update",
+		`{"id":"night-owl","name":"夜间整理 2","role":"organize","model":"group/qwen-mp"}`)
+	if code != 200 {
+		t.Fatalf("update: %d", code)
+	}
+	if a := agentByID(v.Agents, "night-owl"); a.Name != "夜间整理 2" || a.Model != "group/qwen-mp" {
+		t.Fatalf("updated: %+v", a)
+	}
+	if code, _ := postAgents(t, mux, "/api/memory/agents/update", `{"id":"gone","name":"x","role":"dream","model":"m"}`); code != 400 {
+		t.Fatalf("an unknown id: %d", code)
+	}
+	// made organize's default
+	code, v = postAgents(t, mux, "/api/memory/agents/default", `{"role":"organize","id":"night-owl"}`)
+	if code != 200 || v.Defaults[memagent.Organize] != "night-owl" {
+		t.Fatalf("default: %d %+v", code, v.Defaults)
+	}
+	if code, _ := postAgents(t, mux, "/api/memory/agents/default", `{"role":"dream","id":"night-owl"}`); code != 400 {
+		t.Fatalf("a default bound across roles: %d", code)
+	}
+	// removed, and its default handed back to the agent that still carries
+	// organize out (memory-curator)
+	code, v = postAgents(t, mux, "/api/memory/agents/remove", `{"id":"night-owl"}`)
+	if code != 200 || len(v.Agents) != 2 {
+		t.Fatalf("remove: %d %+v", code, v.Agents)
+	}
+	if id := v.Defaults[memagent.Organize]; id != "memory-curator" {
+		t.Fatalf("organize default: %q", id)
+	}
+	if code, _ := postAgents(t, mux, "/api/memory/agents/remove", `{"id":"night-owl"}`); code != 400 {
+		t.Fatalf("removing twice: %d", code)
+	}
+}
