+// ── Liquid glass ────────────────────────────────────────────────────────────
+// Not a switch: three regions, each a pair of numbers — opacity (percent,
+// 100 solid) and backdrop blur (px, 0 none). The numbers are the truth, so a
+// preset only writes them and "Custom" is whatever the sliders say. That is
+// also why turning it off needs no second state: the solid look is a
+// coordinate, not a mode. app.js's applyGlass paints them; fish-glass.css
+// reads them; the plugin-page bridge reports data-fish-glass to open pages.
+const GLASS_FIELDS = { sidebar: "fishGlassSidebar", content: "fishGlassContent", overlay: "fishGlassOverlay", control: "fishGlassControl", header: "fishGlassHeader", bar: "fishGlassBar" };
+// the presets: magpie's own solid look first, then two quiet ones
+const GLASS_PRESETS = () => [
+  ["off", t("Off"), { sidebar: [100, 0], content: [100, 0], overlay: [100, 0], control: [100, 0], header: [100, 0], bar: [100, 0] }],
+  ["light", t("Subtle"), { sidebar: [88, 10], content: [82, 12], overlay: [84, 16], control: [86, 10], header: [92, 8], bar: [90, 8] }],
+  ["balanced", t("Balanced"), { sidebar: [78, 18], content: [60, 22], overlay: [62, 26], control: [72, 14], header: [84, 14], bar: [80, 14] }],
+  ["clear", t("See-through"), { sidebar: [0, 16], content: [0, 20], overlay: [0, 22], control: [0, 10], header: [0, 14], bar: [0, 12] }],
+];
+const GLASS_REGION_NAMES = () => [
+  ["sidebar", t("Sidebar and title bar"), t("The window's edge: the pages list, and the bar above it")],
+  ["content", t("Pages"), t("Cards, lists and fields: what the reader reads")],
+  ["overlay", t("Popovers and dialogs"), t("Menus, sheets and confirmations")],
+  ["control", t("Controls"), t("Buttons, fields and dropdowns")],
+  ["header", t("Top bar"), t("The window's title row on its own: tune it apart from the sidebar")],
+  ["bar", t("Page bars"), t("A page's own footer or tool row: Add a provider, the install bar, the settings head")],
