@@ -0,0 +1,198 @@
+// Settings › Appearance's Liquid glass, with an isolated DOM fixture: the
+// real appearance.js and prefsKeep, no browser, network or desktop config.
+//
+// The contract under test is "numbers, not a switch": a preset writes the
+// three regions' pairs, a slider writes one region, and the Custom preset is
+// whatever the numbers are. The old fishGlass boolean survives only as the
+// legacy flag Go unfolds on load (see appearance_test.go for that half).
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const { test } = require("node:test");
+const assets = path.resolve(__dirname, "../assets");
+
+const SOLID = { fill: 100, blur: 0 };
+// objects built inside the vm realm have that realm's prototypes; compare
+// their data, not their identity
+const plain = (value) => JSON.parse(JSON.stringify(value));
+
+function stub(tag, cls, text) {
+  return {
+    tag, className: cls || "", textContent: text || "",
+    children: [], dataset: {}, style: { setProperty() {} },
+    setAttribute(name, value) { this[name] = value; },
+    append(...nodes) { this.children.push(...nodes); },
+    replaceChildren(...nodes) { this.children = nodes; this.control = nodes[0]; },
+    toggleAttribute() {},
+  };
+}
+
+function fixture() {
+  const nodes = new Map();
+  for (const id of ["fishGlassSegs", "fishGlassRegions", "colorblindSegs", "reduceMotionSegs", "birdSegs"]) {
+    const node = id === "fishGlassRegions" ? { ...stub("div"), children: [] } : stub("div");
+    nodes.set(id, node);
+  }
+  const saves = [];
+  const ranges = [];
+  const context = vm.createContext({
+    window: {},
+    document: { documentElement: { style: { setProperty() {} }, toggleAttribute() {}, hasAttribute: () => false } },
+    $: (selector) => nodes.get(selector.slice(1)),
+    t: (s) => s,
+    el: (tag, cls, text) => {
+      const node = stub(tag, cls, text);
+      if (cls === "fish-glass-range") ranges.push(node);
+      return node;
+    },
+    // the segmented control: what the reader would press is control.pick
+    segs: (options, value, pick) => ({ options, value, pick }),
+    segsOO: (value, change) => ({ value, change }),
+    savePrefs: (body) => saves.push(body),
+    warmTimes: (ats, at) => Array.isArray(ats) ? ats : at ? [at] : [],
+  });
+  const app = fs.readFileSync(path.join(assets, "app.js"), "utf8");
+  const keep = app.match(/function prefsKeep\(s\) \{[\s\S]*?\n\}/);
+  assert.ok(keep, "prefsKeep must remain readable by the settings contract");
+  vm.runInContext(keep[0], context);
+  vm.runInContext(fs.readFileSync(path.join(assets, "appearance.js"), "utf8"), context);
+  return { nodes, saves, ranges, context };
+}
+
+test("an untouched profile is solid and there is no switch left to press", () => {
+  const { nodes, ranges, context } = fixture();
+  context.window.drawLook({ theme: "dark" }, context.prefsKeep({ theme: "dark" }));
+  const segsBox = nodes.get("fishGlassSegs");
+  assert.deepEqual(plain(segsBox.control.options.map(([id]) => id)), ["off", "light", "balanced", "clear", "custom"]);
+  assert.equal(segsBox.control.value, "off", "solid numbers read as Off");
+  // four regions, two numbers each: both solid, both present
+  assert.equal(ranges.length, 12, "6 regions, opacity and blur each");
+  for (const range of ranges) {
+    const blur = /Blur$/.test(range["aria-label"]);
+    assert.equal(range.value, String(blur ? SOLID.blur : SOLID.fill), range["aria-label"]);
+  }
+});
+
+test("a preset writes all four regions and keeps everything else on the page", () => {
+  const { nodes, saves, context } = fixture();
+  const s = { theme: "dark", accent: "#0d9488", noBird: true };
+  context.window.drawLook(s, context.prefsKeep(s));
+  nodes.get("fishGlassSegs").control.pick("balanced");
+  assert.equal(saves.length, 1);
+  assert.deepEqual(plain(saves[0].fishGlassSidebar), { fill: 78, blur: 18 });
+  assert.deepEqual(plain(saves[0].fishGlassContent), { fill: 60, blur: 22 });
+  assert.deepEqual(plain(saves[0].fishGlassOverlay), { fill: 62, blur: 26 });
+  assert.deepEqual(plain(saves[0].fishGlassControl), { fill: 72, blur: 14 });
+  assert.deepEqual(plain(saves[0].fishGlassHeader), { fill: 84, blur: 14 });
+  assert.deepEqual(plain(saves[0].fishGlassBar), { fill: 80, blur: 14 });
+  assert.equal(saves[0].theme, "dark");
+  assert.equal(saves[0].accent, "#0d9488");
+  assert.equal(saves[0].noBird, true);
+  // Off is a coordinate, not another mode: from Balanced it writes solid
+  // numbers. (Pressing the preset already in force is a no-op, so the page
+  // has to be drawn with the saved profile first, as a real save would.)
+  const balanced = { ...s, fishGlassSidebar: { fill: 78, blur: 18 }, fishGlassContent: { fill: 60, blur: 22 }, fishGlassOverlay: { fill: 62, blur: 26 }, fishGlassControl: { fill: 72, blur: 14 }, fishGlassHeader: { fill: 84, blur: 14 }, fishGlassBar: { fill: 80, blur: 14 } };
+  context.window.drawLook(balanced, context.prefsKeep(balanced));
+  nodes.get("fishGlassSegs").control.pick("off");
+  assert.equal(saves.length, 2);
+  assert.deepEqual(plain(saves[1].fishGlassSidebar), SOLID);
+  assert.deepEqual(plain(saves[1].fishGlassContent), SOLID);
+  assert.deepEqual(plain(saves[1].fishGlassOverlay), SOLID);
+  assert.deepEqual(plain(saves[1].fishGlassControl), SOLID);
+  assert.deepEqual(plain(saves[1].fishGlassHeader), SOLID);
+  assert.deepEqual(plain(saves[1].fishGlassBar), SOLID);
+});
+
+test("a slider saves only its own region, and a number no preset holds reads as Custom", () => {
+  const { nodes, saves, ranges, context } = fixture();
+  const s = { theme: "dark", fishGlassSidebar: { fill: 78, blur: 18 }, fishGlassContent: { fill: 60, blur: 22 }, fishGlassOverlay: { fill: 62, blur: 26 }, fishGlassControl: { fill: 72, blur: 14 }, fishGlassHeader: { fill: 84, blur: 14 }, fishGlassBar: { fill: 80, blur: 14 } };
+  context.window.drawLook(s, context.prefsKeep(s));
+  assert.equal(nodes.get("fishGlassSegs").control.value, "balanced");
+  // sidebar fill is the first range drawn for the first region
+  const first = ranges[0];
+  first.value = "70";
+  first.onchange();
+  assert.equal(saves.length, 1);
+  assert.deepEqual(plain(saves[0].fishGlassSidebar), { fill: 70, blur: 18 }, "the region keeps its other number");
+  assert.deepEqual(plain(saves[0].fishGlassContent), { fill: 60, blur: 22 }, "other regions are untouched");
+  assert.deepEqual(plain(saves[0].fishGlassOverlay), { fill: 62, blur: 26 });
+  assert.deepEqual(plain(saves[0].fishGlassControl), { fill: 72, blur: 14 });
+  // numbers that match no preset are Custom, and Custom is not a button that writes
+  const custom = { theme: "dark", fishGlassSidebar: { fill: 70, blur: 18 }, fishGlassContent: { fill: 60, blur: 22 }, fishGlassOverlay: { fill: 62, blur: 26 }, fishGlassControl: { fill: 72, blur: 14 }, fishGlassHeader: { fill: 84, blur: 14 }, fishGlassBar: { fill: 80, blur: 14 } };
+  context.window.drawLook(custom, context.prefsKeep(custom));
+  assert.equal(nodes.get("fishGlassSegs").control.value, "custom");
+  nodes.get("fishGlassSegs").control.pick("custom");
+  assert.equal(saves.length, 1, "pressing Custom saves nothing of its own");
+});
+
+test("the legacy fishGlass flag still turns the regions on for a profile saved before the numbers", () => {
+  const { nodes, context } = fixture();
+  context.window.drawLook({ theme: "dark", fishGlass: true }, context.prefsKeep({ fishGlass: true }));
