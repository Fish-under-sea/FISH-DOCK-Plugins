+package gui
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/agent"
+	"github.com/yetone/magpie/internal/appdir"
+	"github.com/yetone/magpie/internal/fishvault"
+	"github.com/yetone/magpie/internal/memagent"
+	"github.com/yetone/magpie/internal/memory"
+)
+
+func guiFishVault(t *testing.T) (string, string) {
+	t.Helper()
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	root := fishvault.Root()
+	if err := os.MkdirAll(root, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, fishvault.Record), []byte(`{"schema":1,"imported":true,"files":[]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	token := strings.Repeat("a", 64)
+	b, _ := json.Marshal(map[string]any{"token": token, "vault": root})
+	if err := os.WriteFile(filepath.Join(appdir.Config(), "fish-obsidian-connection.json"), b, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return root, token
+}
+func TestFishVaultDesktopRoutesRequirePrivateTokenNotJustAdminCookie(t *testing.T) {
+	_, token := guiFishVault(t)
+	mux := http.NewServeMux()
+	memoryRoutes(mux)
+	for _, tc := range []struct {
+		token, origin, remote string
+		want                  int
+	}{{"", "", "127.0.0.1:5", 403}, {"wrong", "", "127.0.0.1:5", 403}, {token, "null", "127.0.0.1:5", 403}, {token, "", "192.0.2.1:5", 403}, {token, "", "127.0.0.1:5", 200}} {
+		req := httptest.NewRequest("POST", "/api/fish-vault/search", strings.NewReader(`{"q":"test"}`))
+		req.RemoteAddr = tc.remote
+		req.Header.Set("X-Fish-Obsidian-Token", tc.token)
+		if tc.origin != "" {
+			req.Header.Set("Origin", tc.origin)
+		}
+		req.AddCookie(&http.Cookie{Name: "magpie_web_3425", Value: "admin-cookie"})
+		rec := httptest.NewRecorder()
+		mux.ServeHTTP(rec, req)
+		if rec.Code != tc.want {
+			t.Fatalf("%+v: %d %s", tc, rec.Code, rec.Body)
+		}
+	}
+}
+func TestFishVaultSearchSeesNativeMemoryAndLongKnowledge(t *testing.T) {
+	root, token := guiFishVault(t)
+	if err := os.MkdirAll(filepath.Join(root, "wiki"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "wiki", "long.md"), []byte("# Vault routing\nneedle "+strings.Repeat("long note ", 600)), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	text := "needle short memory"
+	if _, _, err := memory.Save(memory.Input{Text: &text}, memory.FromUser, nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	mux := http.NewServeMux()
+	memoryRoutes(mux)
+	req := httptest.NewRequest("POST", "/api/fish-vault/search", strings.NewReader(`{"q":"needle"}`))
+	req.RemoteAddr = "127.0.0.1:5"
+	req.Header.Set("X-Fish-Obsidian-Token", token)
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, req)
+	var result fishvault.Result
+	if err := json.Unmarshal(rec.Body.Bytes(), &result); err != nil {
+		t.Fatalf("%d %s", rec.Code, rec.Body)
+	}
+	if len(result.Hits) != 2 {
+		t.Fatalf("%+v", result)
+	}
+	if !fishVaultURL(fishvault.URI(root, "wiki/long.md")) || !fishVaultURL(fishvault.URI(root, "")) {
+		t.Fatal("owned links refused")
+	}
+	for _, raw := range []string{"obsidian://open?path=" + filepath.Join(t.TempDir(), "outside.md"), fishvault.URI(root, "") + "&vault=other", "obsidian://new?name=bad", "file:///etc/passwd"} {
+		if fishVaultURL(raw) {
+			t.Fatalf("unsafe link accepted: %s", raw)
+		}
+	}
+}
+
+func TestFishVaultStatusJSONAndObsidianAgentMetadata(t *testing.T) {
+	cfg := t.TempDir()
+	t.Setenv("APPDATA", cfg)
+	t.Setenv("HOME", cfg)
+	t.Setenv("USERPROFILE", cfg)
+	root, token := guiFishVault(t)
+	mux := http.NewServeMux()
+	memoryRoutes(mux)
+	obsidianPairRoute(mux)
+
+	// 403 returns structured JSON {error, paired:false}.
+	req := httptest.NewRequest("GET", "/api/fish-vault/status", nil)
+	req.RemoteAddr = "127.0.0.1:5"
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, req)
+	if rec.Code != http.StatusForbidden {
+		t.Fatalf("unpaired status = %d %s", rec.Code, rec.Body.String())
+	}
+	var errBody struct {
+		Error  string `json:"error"`
+		Paired bool   `json:"paired"`
+	}
+	if json.Unmarshal(rec.Body.Bytes(), &errBody) != nil || errBody.Error == "" || errBody.Paired {
+		t.Fatalf("expected structured JSON 403, got %s", rec.Body.String())
+	}
+
+	// Paired status returns 200 JSON {connected:true, paired:true, vault:root}.
+	req = httptest.NewRequest("GET", "/api/fish-vault/status", nil)
+	req.RemoteAddr = "127.0.0.1:5"
+	req.Header.Set("X-Fish-Obsidian-Token", token)
+	rec = httptest.NewRecorder()
+	mux.ServeHTTP(rec, req)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("paired status = %d %s", rec.Code, rec.Body.String())
+	}
+	var okBody struct {
+		Connected bool   `json:"connected"`
+		Paired    bool   `json:"paired"`
+		Vault     string `json:"vault"`
+	}
+	if json.Unmarshal(rec.Body.Bytes(), &okBody) != nil || !okBody.Connected || !okBody.Paired || filepath.Clean(okBody.Vault) != filepath.Clean(root) {
+		t.Fatalf("unexpected /status payload: %s", rec.Body.String())
+	}
+
+	// Workspace initialization + state metadata + re-pair endpoint.
+	ensureObsidianVaultWorkspace()
+	st := state()
+	var found *agentJSON
+	for i := range st.Agents {
+		if st.Agents[i].ID == memagent.ObsidianAgentID {
+			found = &st.Agents[i]
+			break
+		}
+	}
+	if found == nil || found.Origin != agent.OriginObsidianVault || found.Obsidian == nil || !found.Obsidian.Paired {
+		t.Fatalf("expected paired obsidian agent in state(): %+v", found)
+	}
+
+	// Removing pairing file flips Paired to false cleanly without crashing /api/agents/obsidian-pair/{id}.
+	_ = os.Remove(filepath.Join(appdir.Config(), "fish-obsidian-connection.json"))
+	pairReq := httptest.NewRequest("POST", "/api/agents/obsidian-pair/"+memagent.ObsidianAgentID, strings.NewReader("{}"))
+	pairRec := httptest.NewRecorder()
+	mux.ServeHTTP(pairRec, pairReq)
+	if pairRec.Code != http.StatusOK {
+		t.Fatalf("obsidian-pair = %d %s", pairRec.Code, pairRec.Body.String())
+	}
+	var refreshed stateJSON
+	if err := json.Unmarshal(pairRec.Body.Bytes(), &refreshed); err != nil {
+		t.Fatal(err)
+	}
+	var after *agentJSON
+	for i := range refreshed.Agents {
+		if refreshed.Agents[i].ID == memagent.ObsidianAgentID {
+			after = &refreshed.Agents[i]
+			break
+		}
+	}
+	if after == nil || after.Obsidian == nil || after.Obsidian.Paired || after.Obsidian.PairError == "" {
+		t.Fatalf("expected unpaired obsidian metadata after removing connection file: %+v", after)
+	}
+}
