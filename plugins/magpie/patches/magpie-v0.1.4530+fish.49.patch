+//go:build windows
+
+package memagent
+
+import (
+	"os/exec"
+)
+
+// cmdMklink makes a junction, the one kind of link Windows makes without a
+// privilege.
+func cmdMklink(link, target string) ([]byte, error) {
+	return exec.Command("cmd", "/c", "mklink", "/J", link, target).CombinedOutput()
+}
diff --git a/internal/memagent/qa_probe_gc_pressure_test.go b/internal/memagent/qa_probe_gc_pressure_test.go
new file mode 100644
index 0000000..64e5fd1
--- /dev/null
+++ b/internal/memagent/qa_probe_gc_pressure_test.go
@@ -0,0 +1,102 @@
+package memagent
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// A stress of the sweep: many runs left behind, over the cap. What it must
+// hold is the cap, the whole folders it drops, and that it finishes in a
+// time a background tick can afford.
+func TestQAGCPressure(t *testing.T) {
+	root := scratchAt(t)
+	const runs = 200
+	const each = 256 << 10 // 50 MB in all, over the 20 MB cap
+	for i := 0; i < runs; i++ {
+		dir := filepath.Join(root, "learn-"+pad(i))
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "f.bin"), make([]byte, each), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		at := time.Now().Add(-time.Duration(runs-i) * time.Minute)
+		_ = os.Chtimes(filepath.Join(dir, "f.bin"), at, at)
+		_ = os.Chtimes(dir, at, at)
+	}
+	start := time.Now()
+	dropped, freed := GC("")
+	took := time.Since(start)
+	if took > 20*time.Second {
+		t.Fatalf("the sweep took %v over %d runs", took, runs)
+	}
+	if dropped == 0 || freed == 0 {
+		t.Fatalf("dropped %d, freed %d", dropped, freed)
+	}
+	// what is left is under the cap, and every folder left is whole
+	var total int64
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, e := range entries {
+		n, _ := dirSize(filepath.Join(root, e.Name()))
+		total += n
+		if _, err := os.Lstat(filepath.Join(root, e.Name(), "f.bin")); err != nil {
+			t.Fatalf("a folder was left half-dropped: %v", err)
+		}
+	}
+	if total > Cap {
+		t.Fatalf("%d bytes left, over the cap of %d", total, Cap)
+	}
+	// and the newest runs are the ones kept: the oldest went
+	if _, err := os.Lstat(filepath.Join(root, "learn-"+pad(0))); !os.IsNotExist(err) {
+		t.Fatalf("the oldest run is still there: %v", err)
+	}
+	if _, err := os.Lstat(filepath.Join(root, "learn-"+pad(runs-1))); err != nil {
+		t.Fatalf("the newest run went: %v", err)
+	}
+}
+
+// pad names a run so the names sort as the runs were made.
+func pad(i int) string {
+	s := "000"
+	d := []byte{}
+	for n := i; n > 0; n /= 10 {
+		d = append([]byte{byte('0' + n%10)}, d...)
+	}
+	if len(d) == 0 {
+		d = []byte("0")
+	}
+	out := s[:0] + string(d)
+	for len(out) < 3 {
+		out = "0" + out
+	}
+	return out
+}
+
+// The sweep runs again and again: once the space is under the cap it drops
+// nothing, so a tick every hour costs nothing on a quiet cache.
+func TestQAGCTwiceDropsNothingMore(t *testing.T) {
+	root := scratchAt(t)
+	for i := 0; i < 3; i++ {
+		dir := filepath.Join(root, "dream-"+pad(i))
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "f.bin"), make([]byte, 8<<20), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		at := time.Now().Add(-time.Duration(3-i) * time.Hour)
+		_ = os.Chtimes(filepath.Join(dir, "f.bin"), at, at)
+		_ = os.Chtimes(dir, at, at)
+	}
+	if dropped, _ := GC(""); dropped != 1 {
+		t.Fatalf("first sweep dropped %d", dropped)
+	}
+	if dropped, _ := GC(""); dropped != 0 {
+		t.Fatalf("second sweep dropped %d", dropped)
+	}
+}
diff --git a/internal/memagent/qa_probe_gc_test.go b/internal/memagent/qa_probe_gc_test.go
new file mode 100644
index 0000000..48859fe
--- /dev/null
+++ b/internal/memagent/qa_probe_gc_test.go
@@ -0,0 +1,69 @@
+package memagent
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// A run's folder is named "<role>-<time>", so a sweep told the role alone
+// protects nothing. What the sweep is given is the folder of the run going,
+// which it never drops, even when that folder is the oldest and the space
+// is over the cap.
+func TestQAGCKeepNamesTheRunGoing(t *testing.T) {
+	root := scratchAt(t)
+	// the run going, under the name Run makes for it, and the oldest
+	runningID := Dream + "-20261116T210000"
+	dir := filepath.Join(root, runningID)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "f.bin"), make([]byte, 14<<20), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	old := time.Now().Add(-3 * time.Hour)
+	_ = os.Chtimes(filepath.Join(dir, "f.bin"), old, old)
+	_ = os.Chtimes(dir, old, old)
+	// a newer run, over the cap on its own, so a sweep has to reach it
+	other := filepath.Join(root, "learn-20261116T220000")
+	if err := os.MkdirAll(other, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(other, "f.bin"), make([]byte, 21<<20), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if dropped, _ := GC(runningID); dropped != 1 {
+		t.Fatalf("dropped %d, want the newer run's folder alone", dropped)
+	}
+	if _, err := os.Lstat(dir); err != nil {
+		t.Fatalf("GC dropped the folder of the run going: %v", err)
+	}
+	if _, err := os.Lstat(other); !os.IsNotExist(err) {
+		t.Fatalf("the newer run's folder is still there: %v", err)
+	}
+}
+
+// What a run records while it goes is the name of its folder, so the sweep
+// the scheduler runs between ticks protects it.
+func TestRunningScratchIsTheRunsFolder(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	registryAt(t)
+	var seen string
+	ask := func(ctx context.Context, req Request) (Turn, error) {
+		seen = RunningScratch()
+		return Turn{Text: "done"}, nil
+	}
+	res, err := Dispatch(t.Context(), Input{Role: Dream, Vault: dir, Ask: ask, Home: &Home{Dir: home}, RunID: "dream-fixed"})
+	if err != nil || res.Phase != PhaseDone {
+		t.Fatalf("%+v %v", res, err)
+	}
+	if seen != "dream-fixed" {
+		t.Fatalf("the sweep would have been told %q", seen)
+	}
+	if now := RunningScratch(); now != "" {
+		t.Fatalf("the run's folder is still named after it ended: %q", now)
+	}
+}
diff --git a/internal/memagent/qa_probe_gc_windows_test.go b/internal/memagent/qa_probe_gc_windows_test.go
new file mode 100644
index 0000000..711839d
--- /dev/null
+++ b/internal/memagent/qa_probe_gc_windows_test.go
@@ -0,0 +1,52 @@
+//go:build windows
+
+package memagent
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// What the sweep weighs is the scratch space's own bytes. A link inside a
+// run's folder is weighed as itself, never followed: what it points at isn't
+// this folder's to weigh, so a sweep never makes room by counting bytes that
+// aren't here.
+func TestQADirSizeDoesNotCountThroughAJunction(t *testing.T) {
+	root := scratchAt(t)
+	outside := t.TempDir()
+	if err := os.WriteFile(filepath.Join(outside, "big.bin"), make([]byte, 15<<20), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	run := filepath.Join(root, "learn-1")
+	if err := os.MkdirAll(run, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if out, err := exec.Command("cmd", "/c", "mklink", "/J", filepath.Join(run, "elsewhere"), outside).CombinedOutput(); err != nil {
+		t.Skipf("no junction here: %v %s", err, out)
+	}
+	if err := os.WriteFile(filepath.Join(run, "own.bin"), make([]byte, 1024), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	n, _ := dirSize(run)
+	if n != 1024 {
+		t.Fatalf("the run's folder weighs %d bytes, want its own 1024", n)
+	}
+	// so a sweep doesn't drop a real run to make room for bytes it never held
+	other := filepath.Join(root, "dream-1")
+	if err := os.MkdirAll(other, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(other, "f.bin"), make([]byte, 19<<20), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if dropped, _ := GC(""); dropped != 0 {
+		t.Fatalf("a sweep dropped %d folders: the space holds 19 MB of its own", dropped)
+	}
+	if _, err := os.Lstat(other); err != nil {
+		t.Fatalf("a real run's folder went: %v", err)
+	}
+	_ = time.Now()
+}
diff --git a/internal/memagent/qa_probe_loop_test.go b/internal/memagent/qa_probe_loop_test.go
new file mode 100644
index 0000000..887ac9d
--- /dev/null
+++ b/internal/memagent/qa_probe_loop_test.go
@@ -0,0 +1,218 @@
+package memagent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// A model that answers with a call that can't be decoded, or with calls that
+// name nothing, doesn't end the run: the loop says so and goes on.
+func TestQALoopSurvivesBadCalls(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	a := &asker{replies: []Turn{
+		{Calls: []Call{
+			{ID: "c1", Name: "", Input: nil},
+			{ID: "c2", Name: ToolVaultRead, Input: nil}, // no path: a tool error
+			{ID: "c3", Name: ToolVaultRead, Input: []byte(`"not an object"`)},
+		}},
+		{Text: "going on"},
+	}}
+	res, err := Run(t.Context(), Task{Role: Learn, Model: "m", Prompt: "p"},
+		Options{Ask: a.ask, Vault: dir, Home: &Home{Dir: home}})
+	if err != nil || res.Phase != PhaseDone {
+		t.Fatalf("%+v %v", res, err)
+	}
+	results := a.asked[1].Messages[2]["content"].([]any)
+	if len(results) != 3 {
+		t.Fatalf("%d results", len(results))
+	}
+	for i, r := range results {
+		block := r.(map[string]any)
+		if block["is_error"] != true {
+			t.Errorf("call %d wasn't refused: %+v", i, block)
+		}
+	}
+}
+
+// A model that fails partway leaves what it wrote, records the error, and
+// doesn't leave the process busy: the next run goes.
+func TestQALoopFailureLeavesNoState(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	var n int
+	ask := func(ctx context.Context, req Request) (Turn, error) {
+		n++
+		switch n {
+		case 1:
+			return Turn{Calls: []Call{call("c1", ToolVaultWrite, map[string]any{"path": "logs/a.md", "text": "kept"})}}, nil
+		case 2:
+			return Turn{}, errors.New("the vendor went away")
+		}
+		return Turn{Text: "done"}, nil
+	}
+	_, err := Run(t.Context(), Task{Role: Organize, Model: "m", Prompt: "p"},
+		Options{Ask: ask, Vault: dir, Home: &Home{Dir: home}})
+	if err == nil || !strings.Contains(err.Error(), "went away") {
+		t.Fatalf("err: %v", err)
+	}
+	if b, err := os.ReadFile(filepath.Join(dir, "logs", "a.md")); err != nil || string(b) != "kept" {
+		t.Fatalf("what it wrote went: %q %v", b, err)
+	}
+	if Running() || RunningScratch() != "" {
+		t.Fatal("a failed run left the process busy")
+	}
+	// the next run goes, with the same lock free
+	if _, err := Run(t.Context(), Task{Role: Organize, Model: "m", Prompt: "p"},
+		Options{Ask: ask, Vault: dir, Home: &Home{Dir: home}}); err != nil {
+		t.Fatalf("the run after a failure: %v", err)
+	}
+}
+
+// A cancellation the user asked for is not an error and is not recorded as
+// one; one the caller's own context caused is an error, with its reason.
+func TestQALoopCancellation(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	// the caller's context, cancelled from outside: a failure
+	ctx, cancel := context.WithCancel(t.Context())
+	ask := func(c context.Context, req Request) (Turn, error) {
+		cancel()
+		<-c.Done()
+		return Turn{}, c.Err()
+	}
+	_, err := Run(ctx, Task{Role: Learn, Model: "m", Prompt: "p"},
+		Options{Ask: ask, Vault: dir, Home: &Home{Dir: home}})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("a cancelled run: %v", err)
+	}
+	if st := StatusOf(Learn); st.Phase != PhaseFailed || st.Running {
+		t.Fatalf("%+v", st)
+	}
+	// Stop: not an error, and the phase says stopped
+	stopAt := func(c context.Context, req Request) (Turn, error) {
+		Stop()
+		<-c.Done()
+		return Turn{}, c.Err()
+	}
+	if _, err := Run(t.Context(), Task{Role: Learn, Model: "m", Prompt: "p"},
+		Options{Ask: stopAt, Vault: dir, Home: &Home{Dir: home}}); err != nil {
+		t.Fatalf("a stopped run: %v", err)
+	}
+	if st := StatusOf(Learn); st.Phase != PhaseStopped || st.Error != "" {
+		t.Fatalf("%+v", st)
+	}
+}
+
+// Many runs asked for at once: one goes, the rest are told so, and none of
+// them corrupts what the one going records.
+func TestQALoopConcurrentAsks(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	release := make(chan struct{})
+	going := make(chan struct{})
+	var once sync.Once
+	ask := func(c context.Context, req Request) (Turn, error) {
+		once.Do(func() { close(going) })
+		select {
+		case <-release:
+			return Turn{Text: "done"}, nil
+		case <-c.Done():
+			return Turn{}, c.Err()
+		}
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, err := Run(t.Context(), Task{Role: Dream, Model: "m", Prompt: "p"},
+			Options{Ask: ask, Vault: dir, Home: &Home{Dir: home}})
+		done <- err
+	}()
+	<-going
+	var wg sync.WaitGroup
+	errs := make([]error, 8)
+	for i := range errs {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			_, errs[i] = Run(t.Context(), Task{Role: Dream, Model: "m", Prompt: "p"},
+				Options{Ask: ask, Vault: dir, Home: &Home{Dir: home}})
+		}(i)
+	}
+	wg.Wait()
+	for i, err := range errs {
+		if !errors.Is(err, ErrRunning) {
+			t.Errorf("run %d: %v", i, err)
+		}
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatalf("the run going: %v", err)
+	}
+	if st := StatusOf(Dream); st.Phase != PhaseDone || st.Running {
+		t.Fatalf("%+v", st)
+	}
+}
+
+// A tool that takes longer than the run's own time is ended by it: the run
+// says so and doesn't hang the window's poll.
+func TestQALoopEndsAToolThatHangs(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	hang := Tool{
+		Name:        "hang",
+		Description: "waits for its context",
+		Schema:      map[string]any{"type": "object"},
+		Call: func(c context.Context, _ json.RawMessage) (string, error) {
+			<-c.Done()
+			return "", c.Err()
+		},
+	}
+	a := &asker{replies: []Turn{{Calls: []Call{call("c1", "hang", map[string]any{})}}}}
+	start := time.Now()
+	_, err := Run(t.Context(), Task{Role: Dream, Model: "m", Prompt: "p"},
+		Options{Ask: a.ask, Vault: dir, Home: &Home{Dir: home}, Tools: []Tool{hang},
+			Timeout: 60 * time.Millisecond})
+	if err == nil {
+		t.Fatal("a run whose tool hung ended without an error")
+	}
+	if took := time.Since(start); took > 10*time.Second {
+		t.Fatalf("the run took %v", took)
+	}
+	if st := StatusOf(Dream); st.Phase != PhaseFailed || st.Running {
+		t.Fatalf("%+v", st)
+	}
+}
+
+// The transcript a window polls stays bounded: a model that says a great
+// deal doesn't grow the process without end.
+func TestQALoopTranscriptIsBounded(t *testing.T) {
+	dir := runAt(t)
+	home := homeAt(t)
+	big := strings.Repeat("x", 5000)
+	replies := make([]Turn, maxMessages+40)
+	for i := range replies {
+		replies[i] = Turn{Text: big, Calls: []Call{call(fmt.Sprint("c", i), ToolVaultList, map[string]any{})}}
+	}
+	a := &asker{replies: replies}
+	if _, err := Run(t.Context(), Task{Role: Learn, Model: "m", Prompt: "p"},
+		Options{Ask: a.ask, Vault: dir, Home: &Home{Dir: home}, MaxSteps: len(replies) + 1}); err != nil {
+		t.Fatal(err)
+	}
+	msgs := StatusOf(Learn).Messages
+	if len(msgs) > maxMessages {
+		t.Fatalf("%d messages kept", len(msgs))
+	}
+	for _, m := range msgs {
+		if len([]rune(m.Text)) > 2100 {
+			t.Fatalf("a message of %d characters", len([]rune(m.Text)))
+		}
+	}
+}
