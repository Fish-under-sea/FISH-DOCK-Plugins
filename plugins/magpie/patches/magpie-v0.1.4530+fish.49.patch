+	if got, want := storedIDs(t), []string{"foo", "zap"}; !slices.Equal(got, want) {
+		t.Fatalf("after restoring, providers.json = %v, want %v", got, want)
+	}
+	if n, err := RestorePluginProviders(foo); err != nil || n != 0 {
+		t.Fatalf("asked again = %d, %v; want 0, nil", n, err)
+	}
+}
