+	}
+}
+
+// A file that can't be read at all stops a change: the last good generation
+// isn't written over what magpie couldn't open.
+func TestSaveStopsWhenTheFileCantBeRead(t *testing.T) {
+	p := tempPath(t)
+	if err := Ensure(); err != nil {
+		t.Fatal(err)
+	}
+	// a folder where the file goes: it can't be read as a file
+	if err := os.Remove(p); err != nil {
+		t.Fatal(err)
