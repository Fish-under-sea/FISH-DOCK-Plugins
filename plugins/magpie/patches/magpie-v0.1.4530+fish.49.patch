+)
+
+func TestMemoryMCPFishKnowledgeReferencesStayNotes(t *testing.T) {
+	fresh(t)
+	data := filepath.Dir(memory.Path())
+	root := fishvault.RootAt(data)
+	if err := os.MkdirAll(filepath.Join(root, "wiki"), 0o700); err != nil {
+		t.Fatal(err)
