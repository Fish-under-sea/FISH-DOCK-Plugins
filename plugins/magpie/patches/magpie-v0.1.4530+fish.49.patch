--- /dev/null
+++ b/internal/gui/openext.go
@@ -0,0 +1,48 @@
+package gui
+
+import (
+	"errors"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"github.com/yetone/magpie/internal/proc"
+)
+
+// openExternalBrowser 是受控外链共用的系统浏览器出口。
+var openExternalBrowser = proc.OpenBrowser
+
+// openExternalCall 处理已由页面调用权限放行的 HTTP(S) 外链。
+// 它不改变 iframe 的 sandbox，也不接管站内路由和页内锚点。
+func openExternalCall(params map[string]any) (any, error) {
+	raw, _ := params["url"].(string)
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return nil, errors.New("OPEN_EXTERNAL_EMPTY")
+	}
+	if len(raw) > 4096 {
+		return nil, errors.New("OPEN_EXTERNAL_TOO_LONG")
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Host == "" {
+		return nil, errors.New("OPEN_EXTERNAL_INVALID")
+	}
+	if u.Scheme != "http" && u.Scheme != "https" {
+		return nil, errors.New("OPEN_EXTERNAL_SCHEME")
+	}
+	if err := openExternalBrowser(u.String()); err != nil {
+		return nil, errors.New("OPEN_EXTERNAL_FAILED")
+	}
+	return map[string]any{"opened": true, "url": u.String()}, nil
+}
+
+// openEmbeddedExternal 是本机内嵌管理页的显式系统打开路径。
+// 远端浏览器仍在自身设备打开链接，不通过此出口启动服务端浏览器。
+func openEmbeddedExternal(r *http.Request, raw string) (any, error) {
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil || !net.ParseIP(host).IsLoopback() {
+		return nil, errors.New("OPEN_EXTERNAL_LOCAL_ONLY")
+	}
+	return openExternalCall(map[string]any{"url": raw})
+}
