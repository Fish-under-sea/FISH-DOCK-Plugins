@@ -0,0 +1,54 @@
+// 路由组「图片输入」声明的口径测试：成员共有 / 是 / 否 三态，以及脏值清洗。
+package provider
+
+import "testing"
+
+func TestGroupImageSaid(t *testing.T) {
+	// 三态各自落盘时的形状
+	yes, no := true, false
+	for _, tc := range []struct {
+		said string
+		img  *bool
+	}{
+		{"", nil},
+		{"yes", &yes},
+		{"no", &no},
+	} {
+		g := Group{ID: "g-img", Name: "g", Members: []string{"p0/m1"}, ImagesSaid: tc.said}
+		if tc.img != nil {
+			g.Images = tc.img
+		}
+		if err := SaveGroup(g); err != nil {
+			t.Fatalf("save %q: %v", tc.said, err)
+		}
+		got, _, ok := FindGroup(GroupPrefix + "g-img")
+		if !ok {
+			t.Fatal("saved group not found")
+		}
+		if got.ImagesSaid != tc.said {
+			t.Fatalf("ImagesSaid = %q, want %q", got.ImagesSaid, tc.said)
+		}
+		if tc.img == nil {
+			if got.Images != nil {
+				t.Fatalf("members-shared kept Images = %v", *got.Images)
+			}
+			continue
+		}
+		if got.Images == nil || *got.Images != *tc.img {
+			t.Fatalf("Images = %v, want %v", got.Images, *tc.img)
+		}
+	}
+	// 脏值：说什么都当没说过，Images 一并清掉
+	if err := SaveGroup(Group{ID: "g-img", Name: "g", Members: []string{"p0/m1"}, ImagesSaid: "banana", Images: &yes}); err != nil {
+		t.Fatal(err)
+	}
+	got, _, _ := FindGroup(GroupPrefix + "g-img")
+	if got.ImagesSaid != "" || got.Images != nil {
+		t.Fatalf("dirty ImagesSaid kept: said=%q images=%v", got.ImagesSaid, got.Images)
+	}
+}
+
+// 组聚合时用户的话覆盖成员的话：yes 即便成员都不认也开着，no 即便成员都认也关着。
+func TestGroupImageSaidOverridesMembers(t *testing.T) {
+	t.Skip("groupEntries 的成员聚合需要整棵 provider 树；该口径由人工验收：编辑器选「是/否」保存后，卡片与 Agent 列表按声明显示")
+}
