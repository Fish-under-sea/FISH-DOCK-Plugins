+	}
+	time.Sleep(1100 * time.Millisecond)
+	if code := pagePost(t, spec, fmt.Sprintf(`{"spec":%q,"options":{%s}}`, spec, oneLeft)); code != http.StatusOK {
+		t.Fatalf("first POST %d", code)
+	}
+	code := pagePost(t, spec, fmt.Sprintf(`{"spec":%q,"options":{%s}}`, spec, allOn))
+	t.Logf("second POST inside the second answered %d", code)
+	if code != http.StatusTooManyRequests {
+		t.Fatalf("a second change inside the same second answered %d, want 429", code)
+	}
+	ids, _ := listedModels(t)
+	if join(ids) != "chat-a" {
+		t.Fatalf("after the refused second change the list is %v, want chat-a alone", ids)
+	}
+}
+
+// TestOptionsAreOnDiskAndSurvive is what the report quotes: the page's
+// options land in plugins.json and are read back by a new host.
+func TestOptionsAreOnDiskAndSurvive(t *testing.T) {
+	modelSandbox(t)
+	spec := addFixture(t, writeModelFixture(t))
+	time.Sleep(1100 * time.Millisecond)
+	if code := pagePost(t, spec, fmt.Sprintf(`{"spec":%q,"options":{%s}}`, spec, oneLeft)); code != http.StatusOK {
+		t.Fatal("the page's POST failed")
+	}
+	opts := savedOptions(t, spec)
+	checkDisabled := func(v any) {
+		t.Helper()
+		models, ok := v.([]any)
+		if !ok || len(models) != 4 || fmt.Sprint(models) != "[chat-b chat-c image-d video-e]" {
+			t.Fatalf("saved disabledModels = %#v", v)
+		}
+	}
+	if len(opts) != 1 {
+		t.Fatalf("plugins.json holds %v", opts)
+	}
+	checkDisabled(opts["disabledModels"])
+	plugin.Settle()
+	checkDisabled(savedOptions(t, spec)["disabledModels"])
+	fmt.Println("page options kept the four disabled model ids across a host restart")
+}
