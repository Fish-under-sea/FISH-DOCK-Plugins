{
  "name": "@fish-under-sea/magpie-checkin-relay-probe",
  "version": "1.0.0",
  "description": "Magpie 的一个页面插件，页内两页切换：自动签到（厂商账号、今日积分、连签）与中转站探针（行为指纹复核）。两页的代码与图标原样保留，只多一层切换壳与桥转发。",
  "type": "module",
  "license": "MIT",
  "files": [
    "page",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-page",
    "checkin",
    "relay-probe"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fish-under-sea/magpie-checkin-relay-probe.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "magpie": {
    "icon": "page/icon.png",
    "page": {
      "title": "签到&探针",
      "titles": {
        "zh": "签到&探针",
        "zh-TW": "簽到&探針",
        "en": "Check-in & probe"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": [
      "checkin:state"
    ],
    "calls": [
      "checkin:set-provider",
      "checkin:set-account",
      "checkin:run",
      "checkin:refresh",
      "brand:status",
      "brand:set",
      "relay:view",
      "relay:save",
      "relay:start",
      "relay:status",
      "relay:stop",
      "magpie:open-external"
    ],
    "options": {
      "collapsed": true
    }
  }
}